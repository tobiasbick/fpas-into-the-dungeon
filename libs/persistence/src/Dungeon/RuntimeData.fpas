// Runtime paths plus persistent client-network and server-world configuration.
unit Dungeon.RuntimeData;

uses Dungeon.RuntimeData.Gamemaster as Gamemaster, Std.Os.Env as Env, Std.Io.Fs as Fs, Std.Io.Path as PathOps, Std.Encoding.Toml as Toml, Std.Encoding.Toml.Fields as TomlFields;

// Renders typed library failures at this unit's application-owned text boundary.
function FailureMessage<E: Error>(Cause: E): string;
begin
  return Cause.Message();
end function;

// Complete current key sets; any other key marks an obsolete configuration file.
const ClientConfigFields: array of string := [
  'host',
  'port',
  'context_panel_visible',
  'message_panel_visible'
];
const ServerConfigFields: array of string := [
  'host',
  'port',
  'world_id',
  'world_seed',
  'dungeon_region_chunks',
  'chunk_cache_limit',
  'max_view_width',
  'max_view_height', 'gamemaster_connection', 'gamemaster_model'
];

// Validated endpoint configuration shared by client and server startup.
public type NetworkConfig = record
  public Host: string;
  public Port: integer;
end record;

// Client-only presentation preferences persisted independently of gameplay state.
public type ClientPreferences = record
  public ContextPanelVisible: boolean;
  public MessagePanelVisible: boolean;
end record;

// Server-owned world selection and bounded client viewport policy.
public type ServerWorldConfig = record
  public Id: string;
  public Seed: integer;
  // Entrance region side length in chunks; applies only when a new world is created.
  public DungeonRegionChunks: integer;
  public ChunkCacheLimit: integer;
  public MaximumViewWidth: integer;
  public MaximumViewHeight: integer;
end record;

// Resolved data root and the project-owned files and directories below it.
public type RuntimePaths = record
  public Root: string;
  public Config: string;
  public ClientConfig: string;
  public ServerConfig: string;
  public Worlds: string;
  public Logs: string;
  public Cache: string;
end record;

// Bundles prepared runtime paths with effective network and server-world settings.
public type RuntimeSettings = record
  public Paths: RuntimePaths;
  public Network: NetworkConfig;
  public World: ServerWorldConfig;
  public Preferences: ClientPreferences;
  public Gamemaster: Gamemaster.Selection;
end record;

function DefaultNetworkConfig(): NetworkConfig;
begin
  return NetworkConfig(Host := '127.0.0.1', Port := 4040);
end function;

// Returns presentation defaults used when creating a current-version client configuration.
public function DefaultClientPreferences(): ClientPreferences;
begin
  return ClientPreferences(ContextPanelVisible := true, MessagePanelVisible := false);
end function;

function DefaultServerWorldConfig(): ServerWorldConfig;
begin
  return ServerWorldConfig(
    Id := 'main',
    Seed := 12345,
    DungeonRegionChunks := 4,
    ChunkCacheLimit := 64,
    MaximumViewWidth := 240,
    MaximumViewHeight := 120
  );
end function;

function NonEmpty(Value: string; Source: string): result of (string, string);
begin
  if Value.Trim().Length() = 0 then
    begin
      return Error(Source + ' must not be empty');
    end;
  end if;

  return Ok(PathOps.Normalize(Value));
end function;

function HomeDirectory(): result of (string, string);
begin
  case Env.Get('HOME') of
    when Some(const Value):
      begin
        return NonEmpty(Value, 'HOME');
      end;
    when None:
      begin
        case Env.Get('USERPROFILE') of
          when Some(const Value):
            begin
              return NonEmpty(Value, 'USERPROFILE');
            end;
          when None:
            begin
              return Error('cannot resolve the data root because HOME and USERPROFILE are not set');
            end;
        end case;
      end;
  end case;
end function;

// Resolves command-line, environment, and default data roots in precedence order.
function ResolveDataRoot(CommandLineOverride: option of string): result of (string, string);
begin
  case CommandLineOverride of
    when Some(const Value):
      begin
        return NonEmpty(Value, '--data-dir');
      end;
    when None:
      begin
        case Env.Get('INTO_THE_DUNGEON_HOME') of
          when Some(const Value):
            begin
              return NonEmpty(Value, 'INTO_THE_DUNGEON_HOME');
            end;
          when None:
            begin
              return Ok(PathOps.Join([try HomeDirectory(), '.fpas-into-the-dungeon']));
            end;
        end case;
      end;
  end case;
end function;

function RuntimePathsForRoot(Root: string): RuntimePaths;
begin
  const NormalizedRoot: string := PathOps.Normalize(Root);
  const ConfigPath: string := PathOps.Join([NormalizedRoot, 'config']);
  return RuntimePaths(
    Root := NormalizedRoot, Config := ConfigPath, ClientConfig := PathOps.Join([
      ConfigPath,
      'client.toml'
    ]), ServerConfig := PathOps.Join([
      ConfigPath,
      'server.toml'
    ]), Worlds := PathOps.Join([
      NormalizedRoot,
      'worlds'
    ]), Logs := PathOps.Join([
      NormalizedRoot,
      'logs'
    ]), Cache := PathOps.Join([
      NormalizedRoot,
      'cache'
    ])
  );
end function;

function EncodeClientConfig(Network: NetworkConfig; Preferences: ClientPreferences): string;
begin
  return Toml.Stringify(
    Toml.TomlValue.Table([
      'host': Toml.TomlValue.String(Network.Host),
      'port': Toml.TomlValue.Integer(Network.Port),
      'context_panel_visible': Toml.TomlValue.Boolean(Preferences.ContextPanelVisible),
      'message_panel_visible': Toml.TomlValue.Boolean(Preferences.MessagePanelVisible)
    ])
  );
end function;

function EncodeServerConfig(Network: NetworkConfig; World: ServerWorldConfig; Agent: Gamemaster.Selection): string;
begin
  return Toml.Stringify(
    Toml.TomlValue.Table([
      'host': Toml.TomlValue.String(Network.Host),
      'port': Toml.TomlValue.Integer(Network.Port),
      'world_id': Toml.TomlValue.String(World.Id),
      'world_seed': Toml.TomlValue.Integer(World.Seed),
      'dungeon_region_chunks': Toml.TomlValue.Integer(World.DungeonRegionChunks),
      'chunk_cache_limit': Toml.TomlValue.Integer(World.ChunkCacheLimit),
      'max_view_width': Toml.TomlValue.Integer(World.MaximumViewWidth),
      'max_view_height': Toml.TomlValue.Integer(World.MaximumViewHeight),
      'gamemaster_connection': Toml.TomlValue.String(Gamemaster.ConnectionName(Agent.Connection)),
      'gamemaster_model': Toml.TomlValue.String(Agent.ModelId)
    ])
  );
end function;

function EnsureClientConfigFile(
  Path: string;
  Network: NetworkConfig;
  Preferences: ClientPreferences
): result of (boolean, string);
begin
  if Fs.Exists(Path) then
    begin
      if Fs.IsFile(Path) then
        begin
          return Ok(true);
        end;
      end if;

      return Error('configuration path exists but is not a file: ' + Path);
    end;
  end if;

  return Fs.WriteTextAtomic(
    Path,
    EncodeClientConfig(Network, Preferences)
  ).MapError(FailureMessage);
end function;

function EnsureServerConfigFile(Path: string; Network: NetworkConfig; World: ServerWorldConfig): result of (boolean, string);
begin
  if Fs.Exists(Path) then
    begin
      if Fs.IsFile(Path) then
        begin
          return Ok(true);
        end;
      end if;

      return Error('configuration path exists but is not a file: ' + Path);
    end;
  end if;

  return Fs.WriteTextAtomic(
    Path,
    EncodeServerConfig(Network, World, Gamemaster.Selection())
  ).MapError(FailureMessage);
end function;

function PrepareShared(Paths: RuntimePaths): result of (boolean, string);
begin
  const RootReady: boolean := try Fs.CreateDirAll(Paths.Root).MapError(FailureMessage);
  const ConfigReady: boolean := try Fs.CreateDirAll(Paths.Config).MapError(FailureMessage);
  const LogsReady: boolean := try Fs.CreateDirAll(Paths.Logs).MapError(FailureMessage);
  const CacheReady: boolean := try Fs.CreateDirAll(Paths.Cache).MapError(FailureMessage);
  return Ok(true);
end function;

// Complete contents of client.toml.
type ClientFileConfig = record
  Network: NetworkConfig;
  Preferences: ClientPreferences;
end record;

// Complete contents of server.toml.
type ServerFileConfig = record
  Network: NetworkConfig;
  World: ServerWorldConfig;
  Gamemaster: Gamemaster.Selection;
end record;

// Adds the file path and recovery guidance to one configuration error.
function ConfigurationError(Path: string; Message: string): string;
begin
  return (('invalid configuration: ' + Message) + '; edit, delete or recreate it: ') + Path;
end function;

// Reads one configuration table and rejects keys outside the current schema.
function ReadConfigTable(Path: string; Allowed: array of string): result of (dict of string to Toml.TomlValue, string);
begin
  const Fields: dict of string to Toml.TomlValue := try TomlFields.ParseTable(
    try Fs.ReadText(Path).MapError(FailureMessage)
  ).MapError(FailureMessage);
  const Known: boolean := try TomlFields.RequireOnlyFields(
    Fields,
    Allowed
  ).MapError(FailureMessage);
  return Ok(Fields);
end function;

function NonEmptyString(Fields: dict of string to Toml.TomlValue; Name: string): result of (string, string);
begin
  const Value: string := try TomlFields.StringField(Fields, Name).MapError(FailureMessage);
  if Value.Trim().Length() = 0 then
    begin
      return Error(('field ' + Name) + ' must not be empty');
    end;
  end if;

  return Ok(Value);
end function;

function ReadNetworkConfig(Fields: dict of string to Toml.TomlValue): result of (NetworkConfig, string);
begin
  const Host: string := try NonEmptyString(Fields, 'host');
  const Port: integer := try TomlFields.IntegerField(Fields, 'port').MapError(FailureMessage);
  if (Port < 1) or (Port > 65535) then
    begin
      return Error('field port must be between 1 and 65535');
    end;
  end if;

  return Ok(NetworkConfig(Host := Host, Port := Port));
end function;

function ReadClientFields(Path: string): result of (ClientFileConfig, string);
begin
  const Fields: dict of string to Toml.TomlValue := try ReadConfigTable(Path, ClientConfigFields);
  return Ok(
    ClientFileConfig(
      Network := try ReadNetworkConfig(Fields),
      Preferences := ClientPreferences(
        ContextPanelVisible := try TomlFields.BooleanField(
          Fields,
          'context_panel_visible'
        ).MapError(FailureMessage),
        MessagePanelVisible := try TomlFields.BooleanField(
          Fields,
          'message_panel_visible'
        ).MapError(FailureMessage)
      )
    )
  );
end function;

// Reads and validates client.toml; every error names the file and how to recover.
function ReadClientConfig(Path: string): result of (ClientFileConfig, string);
begin
  case ReadClientFields(Path) of
    when Ok(const Value):
      begin
        return Ok(Value);
      end;
    when Error(const Message):
      begin
        return Error(ConfigurationError(Path, Message));
      end;
  end case;
end function;

// Validates current new-world defaults before parsing or publishing server settings.
public function ValidateServerDefaults(Seed: integer; RegionChunks: integer): result of (boolean, string);
begin
  if (Seed < -2147483648) or (Seed > 2147483647) then
    return Error('field world_seed must be in the signed 32-bit range');
  end if;

  if (RegionChunks < 1) or (RegionChunks > 16) then
    return Error('field dungeon_region_chunks must be 1 through 16');
  end if;

  return Ok(true);
end function;

function ReadServerFields(Path: string): result of (ServerFileConfig, string);
begin
  const Fields: dict of string to Toml.TomlValue := try ReadConfigTable(Path, ServerConfigFields);
  const World: ServerWorldConfig := ServerWorldConfig(
    Id := try NonEmptyString(Fields, 'world_id'),
    Seed := try TomlFields.IntegerField(Fields, 'world_seed').MapError(FailureMessage),
    DungeonRegionChunks := try TomlFields.IntegerField(
      Fields,
      'dungeon_region_chunks'
    ).MapError(FailureMessage),
    ChunkCacheLimit := try TomlFields.IntegerField(
      Fields,
      'chunk_cache_limit'
    ).MapError(FailureMessage),
    MaximumViewWidth := try TomlFields.IntegerField(
      Fields,
      'max_view_width'
    ).MapError(FailureMessage),
    MaximumViewHeight := try TomlFields.IntegerField(
      Fields,
      'max_view_height'
    ).MapError(FailureMessage)
  );
  const ValidDefaults: boolean := try ValidateServerDefaults(World.Seed, World.DungeonRegionChunks);
  if World.ChunkCacheLimit < 9 then
    begin
      return Error('field chunk_cache_limit must be at least 9');
    end;
  end if;

  if (World.MaximumViewWidth < 1) or (World.MaximumViewHeight < 1) then
    begin
      return Error('maximum viewport dimensions must be positive');
    end;
  end if;

  return Ok(
    ServerFileConfig(
      Network := try ReadNetworkConfig(Fields), World := World,
      Gamemaster := try Gamemaster.Decode(Fields)
    )
  );
end function;

// Reads and validates server.toml; every error names the file and how to recover.
function ReadServerConfig(Path: string): result of (ServerFileConfig, string);
begin
  case ReadServerFields(Path) of
    when Ok(const Value):
      begin
        return Ok(Value);
      end;
    when Error(const Message):
      begin
        return Error(ConfigurationError(Path, Message));
      end;
  end case;
end function;

// Prepares shared client directories and loads or creates client.toml.
public function LoadClientRuntime(DataRootOverride: option of string): result of (RuntimeSettings, string);
begin
  const Paths: RuntimePaths := RuntimePathsForRoot(try ResolveDataRoot(DataRootOverride));
  const SharedReady: boolean := try PrepareShared(Paths);
  const ConfigReady: boolean := try EnsureClientConfigFile(
    Paths.ClientConfig,
    DefaultNetworkConfig(),
    DefaultClientPreferences()
  );
  const Config: ClientFileConfig := try ReadClientConfig(Paths.ClientConfig);
  return Ok(
    RuntimeSettings(
      Paths := Paths,
      Network := Config.Network,
      World := DefaultServerWorldConfig(),
      Preferences := Config.Preferences, Gamemaster := Gamemaster.Selection()
    )
  );
end function;

// Reads current server defaults without creating configuration or world data.
public function ReadServerDefaults(Path: string): result of (ServerWorldConfig, string);
begin
  return Ok((try ReadServerConfig(Path)).World);
end function;

// Reads the global selection without creating files, querying agents or loading a world.
public function ReadGamemaster(Path: string): result of (Gamemaster.Selection, string);
begin
  return Ok((try ReadServerConfig(Path)).Gamemaster);
end function;

// Atomically replaces only the global selection, preserving all other current server settings.
public function SaveGamemaster(Path: string; Value: Gamemaster.Selection): result of (boolean, string);
begin
  discard try Gamemaster.Validate(Value);
  const Current := try ReadServerConfig(Path);
  return Fs.WriteTextAtomic(
    Path,
    EncodeServerConfig(Current.Network, Current.World, Value)
  ).MapError(FailureMessage);
end function;

// Atomically edits only new-world defaults; endpoint, selection, and viewport policy stay intact.
public function SaveServerDefaults(Path: string; Seed: integer; RegionChunks: integer): result of (boolean, string);
begin
  const Valid: boolean := try ValidateServerDefaults(Seed, RegionChunks);
  const Current: ServerFileConfig := try ReadServerConfig(Path);
  return Fs.WriteTextAtomic(
    Path,
    EncodeServerConfig(
      Current.Network,
      Current.World with Seed := Seed; DungeonRegionChunks := RegionChunks; end with,
      Current.Gamemaster
    )
  ).MapError(FailureMessage);
end function;

// Atomically updates client presentation preferences while preserving the configured endpoint.
public function SaveClientPreferences(Path: string; Preferences: ClientPreferences): result of (boolean, string);
begin
  const Current: ClientFileConfig := try ReadClientConfig(Path);
  return Fs.WriteTextAtomic(
    Path,
    EncodeClientConfig(Current.Network, Preferences)
  ).MapError(FailureMessage);
end function;

// Prepares server directories, including worlds, and loads or creates server.toml.
public function LoadServerRuntime(DataRootOverride: option of string): result of (RuntimeSettings, string);
begin
  const Paths: RuntimePaths := RuntimePathsForRoot(try ResolveDataRoot(DataRootOverride));
  const SharedReady: boolean := try PrepareShared(Paths);
  const WorldsReady: boolean := try Fs.CreateDirAll(Paths.Worlds).MapError(FailureMessage);
  const ConfigReady: boolean := try EnsureServerConfigFile(
    Paths.ServerConfig,
    DefaultNetworkConfig(),
    DefaultServerWorldConfig()
  );
  const Config: ServerFileConfig := try ReadServerConfig(Paths.ServerConfig);
  return Ok(
    RuntimeSettings(
      Paths := Paths,
      Network := Config.Network,
      World := Config.World,
      Preferences := DefaultClientPreferences(), Gamemaster := Config.Gamemaster
    )
  );
end function;
end unit;
