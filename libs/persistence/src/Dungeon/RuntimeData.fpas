// Runtime paths plus persistent client-network and server-world configuration.
unit Dungeon.RuntimeData;

uses Std.Env, Std.Fs, Std.Path, Std.Str, Std.Toml, Std.Toml.Fields;

const
  // Complete current key sets; any other key marks an obsolete configuration file.
  ClientConfigFields: array of string := [
                                           'host',
                                           'port',
                                           'context_panel_visible',
                                           'message_panel_visible'
                                         ];
  ServerConfigFields: array of string := [
                                           'host',
                                           'port',
                                           'world_id',
                                           'world_seed',
                                           'dungeon_region_chunks',
                                           'chunk_cache_limit',
                                           'max_view_width',
                                           'max_view_height'
                                         ];

public type
  // Validated endpoint configuration shared by client and server startup.
  NetworkConfig = record
    public Host: string;
    public Port: integer;
  end record;
  // Client-only presentation preferences persisted independently of gameplay state.
  ClientPreferences = record
    public ContextPanelVisible: boolean;
    public MessagePanelVisible: boolean;
  end record;
  // Server-owned world selection and bounded client viewport policy.
  ServerWorldConfig = record
    public Id: string;
    public Seed: integer;
    // Entrance region side length in chunks; applies only when a new world is created.
    public DungeonRegionChunks: integer;
    public ChunkCacheLimit: integer;
    public MaximumViewWidth: integer;
    public MaximumViewHeight: integer;
  end record;
  // Resolved data root and the project-owned files and directories below it.
  RuntimePaths = record
    public Root: string;
    public Config: string;
    public ClientConfig: string;
    public ServerConfig: string;
    public Worlds: string;
    public Logs: string;
    public Cache: string;
  end record;
  // Bundles prepared runtime paths with effective network and server-world settings.
  RuntimeSettings = record
    public Paths: RuntimePaths;
    public Network: NetworkConfig;
    public World: ServerWorldConfig;
    public Preferences: ClientPreferences;
  end record;

function DefaultNetworkConfig(): NetworkConfig;
begin
  return record
    Host := '127.0.0.1';
    Port := 4040;
  end;
end function;

// Returns presentation defaults used when creating a current-version client configuration.
public function DefaultClientPreferences(): ClientPreferences;
begin
  return record
    ContextPanelVisible := true;
    MessagePanelVisible := false;
  end;
end function;

function DefaultServerWorldConfig(): ServerWorldConfig;
begin
  return record
    Id := 'main';
    Seed := 12345;
    DungeonRegionChunks := 4;
    ChunkCacheLimit := 64;
    MaximumViewWidth := 240;
    MaximumViewHeight := 120;
  end;
end function;

function NonEmpty(Value: string; Source: string): result of string, string;
begin
  if Value.Trim().Length() = 0 then
    begin
      return Error(Source + ' must not be empty');
    end;
  end if;

  return Ok(Std.Path.Normalize(Value));
end function;

function HomeDirectory(): result of string, string;
begin
  case Std.Env.Get('HOME') of
    when Some(Value):
      begin
        return NonEmpty(Value, 'HOME');
      end;
    when None:
      begin
        case Std.Env.Get('USERPROFILE') of
          when Some(Value):
            begin
              return NonEmpty(Value, 'USERPROFILE');
            end;
          when None:
            begin
              return Error('cannot resolve the data root because HOME and USERPROFILE are not set');
            end;
        end case;
      end;
  end case;
end function;

// Resolves command-line, environment, and default data roots in precedence order.
function ResolveDataRoot(CommandLineOverride: option of string): result of string, string;
begin
  case CommandLineOverride of
    when Some(Value):
      begin
        return NonEmpty(Value, '--data-dir');
      end;
    when None:
      begin
        case Std.Env.Get('INTO_THE_DUNGEON_HOME') of
          when Some(Value):
            begin
              return NonEmpty(Value, 'INTO_THE_DUNGEON_HOME');
            end;
          when None:
            begin
              return Ok(Std.Path.Join([try HomeDirectory(), '.fpas-into-the-dungeon']));
            end;
        end case;
      end;
  end case;
end function;

function RuntimePathsForRoot(Root: string): RuntimePaths;
begin
  var NormalizedRoot: string := Std.Path.Normalize(Root);
  var ConfigPath: string := Std.Path.Join([NormalizedRoot, 'config']);
  return record
    Root := NormalizedRoot;
    Config := ConfigPath;
    ClientConfig := Std.Path.Join([ConfigPath, 'client.toml']);
    ServerConfig := Std.Path.Join([ConfigPath, 'server.toml']);
    Worlds := Std.Path.Join([NormalizedRoot, 'worlds']);
    Logs := Std.Path.Join([NormalizedRoot, 'logs']);
    Cache := Std.Path.Join([NormalizedRoot, 'cache']);
  end;
end function;

function EncodeClientConfig(Network: NetworkConfig; Preferences: ClientPreferences): string;
begin
  return Std.Toml.Stringify(TomlValue.Table(['host': TomlValue.String(Network.Host), 'port': TomlValue.Integer(Network.Port), 'context_panel_visible': TomlValue.Boolean(Preferences.ContextPanelVisible), 'message_panel_visible': TomlValue.Boolean(Preferences.MessagePanelVisible)]));
end function;

function EncodeServerConfig(Network: NetworkConfig; World: ServerWorldConfig): string;
begin
  return Std.Toml.Stringify(TomlValue.Table(['host': TomlValue.String(Network.Host), 'port': TomlValue.Integer(Network.Port), 'world_id': TomlValue.String(World.Id), 'world_seed': TomlValue.Integer(World.Seed), 'dungeon_region_chunks': TomlValue.Integer(World.DungeonRegionChunks), 'chunk_cache_limit': TomlValue.Integer(World.ChunkCacheLimit), 'max_view_width': TomlValue.Integer(World.MaximumViewWidth), 'max_view_height': TomlValue.Integer(World.MaximumViewHeight)]));
end function;

function EnsureClientConfigFile(
  Path: string;
  Network: NetworkConfig;
  Preferences: ClientPreferences
): result of boolean, string;
begin
  if Std.Fs.Exists(Path) then
    begin
      if Std.Fs.IsFile(Path) then
        begin
          return Ok(true);
        end;
      end if;

      return Error('configuration path exists but is not a file: ' + Path);
    end;
  end if;

  return Std.Fs.WriteTextAtomic(Path, EncodeClientConfig(Network, Preferences));
end function;

function EnsureServerConfigFile(Path: string; Network: NetworkConfig; World: ServerWorldConfig): result of boolean, string;
begin
  if Std.Fs.Exists(Path) then
    begin
      if Std.Fs.IsFile(Path) then
        begin
          return Ok(true);
        end;
      end if;

      return Error('configuration path exists but is not a file: ' + Path);
    end;
  end if;

  return Std.Fs.WriteTextAtomic(Path, EncodeServerConfig(Network, World));
end function;

function PrepareShared(Paths: RuntimePaths): result of boolean, string;
begin
  var RootReady: boolean := try Std.Fs.CreateDirAll(Paths.Root);
  var ConfigReady: boolean := try Std.Fs.CreateDirAll(Paths.Config);
  var LogsReady: boolean := try Std.Fs.CreateDirAll(Paths.Logs);
  var CacheReady: boolean := try Std.Fs.CreateDirAll(Paths.Cache);
  return Ok(true);
end function;

type
  // Complete contents of client.toml.
  ClientFileConfig = record
    Network: NetworkConfig;
    Preferences: ClientPreferences;
  end record;
  // Complete contents of server.toml.
  ServerFileConfig = record
    Network: NetworkConfig;
    World: ServerWorldConfig;
  end record;

// Adds the file path and recovery guidance to one configuration error.
function ConfigurationError(Path: string; Message: string): string;
begin
  return (('invalid configuration: ' + Message) + '; edit, delete or recreate it: ') + Path;
end function;

// Reads one configuration table and rejects keys outside the current schema.
function ReadConfigTable(Path: string; Allowed: array of string): result of dict of string to TomlValue, string;
begin
  var Fields: dict of string to TomlValue := try ParseTable(try Std.Fs.ReadText(Path));
  var Known: boolean := try RequireOnlyFields(Fields, Allowed);
  return Ok(Fields);
end function;

function NonEmptyString(Fields: dict of string to TomlValue; Name: string): result of string, string;
begin
  var Value: string := try StringField(Fields, Name);
  if Value.Trim().Length() = 0 then
    begin
      return Error(('field ' + Name) + ' must not be empty');
    end;
  end if;

  return Ok(Value);
end function;

function ReadNetworkConfig(Fields: dict of string to TomlValue): result of NetworkConfig, string;
begin
  var Host: string := try NonEmptyString(Fields, 'host');
  var Port: integer := try IntegerField(Fields, 'port');
  if (Port < 1) or (Port > 65535) then
    begin
      return Error('field port must be between 1 and 65535');
    end;
  end if;

  return Ok(record
    Host := Host;
    Port := Port;
  end);
end function;

function ReadClientFields(Path: string): result of ClientFileConfig, string;
begin
  var Fields: dict of string to TomlValue := try ReadConfigTable(Path, ClientConfigFields);
  return Ok(record
    Network := try ReadNetworkConfig(Fields);
    Preferences := record
      ContextPanelVisible := try BooleanField(Fields, 'context_panel_visible');
      MessagePanelVisible := try BooleanField(Fields, 'message_panel_visible');
    end;
  end);
end function;

// Reads and validates client.toml; every error names the file and how to recover.
function ReadClientConfig(Path: string): result of ClientFileConfig, string;
begin
  case ReadClientFields(Path) of
    when Ok(Value):
      begin
        return Ok(Value);
      end;
    when Error(Message):
      begin
        return Error(ConfigurationError(Path, Message));
      end;
  end case;
end function;

function ReadServerFields(Path: string): result of ServerFileConfig, string;
begin
  var Fields: dict of string to TomlValue := try ReadConfigTable(Path, ServerConfigFields);
  var World: ServerWorldConfig := record
    Id := try NonEmptyString(Fields, 'world_id');
    Seed := try IntegerField(Fields, 'world_seed');
    DungeonRegionChunks := try IntegerField(Fields, 'dungeon_region_chunks');
    ChunkCacheLimit := try IntegerField(Fields, 'chunk_cache_limit');
    MaximumViewWidth := try IntegerField(Fields, 'max_view_width');
    MaximumViewHeight := try IntegerField(Fields, 'max_view_height');
  end;

  if (World.DungeonRegionChunks < 1) or (World.DungeonRegionChunks > 16) then
    begin
      return Error('field dungeon_region_chunks must be 1 through 16');
    end;
  end if;

  if World.ChunkCacheLimit < 9 then
    begin
      return Error('field chunk_cache_limit must be at least 9');
    end;
  end if;

  if (World.MaximumViewWidth < 1) or (World.MaximumViewHeight < 1) then
    begin
      return Error('maximum viewport dimensions must be positive');
    end;
  end if;

  return Ok(record
    Network := try ReadNetworkConfig(Fields);
    World := World;
  end);
end function;

// Reads and validates server.toml; every error names the file and how to recover.
function ReadServerConfig(Path: string): result of ServerFileConfig, string;
begin
  case ReadServerFields(Path) of
    when Ok(Value):
      begin
        return Ok(Value);
      end;
    when Error(Message):
      begin
        return Error(ConfigurationError(Path, Message));
      end;
  end case;
end function;

// Prepares shared client directories and loads or creates client.toml.
public function LoadClientRuntime(DataRootOverride: option of string): result of RuntimeSettings, string;
begin
  var Paths: RuntimePaths := RuntimePathsForRoot(try ResolveDataRoot(DataRootOverride));
  var SharedReady: boolean := try PrepareShared(Paths);
  var ConfigReady: boolean := try EnsureClientConfigFile(Paths.ClientConfig, DefaultNetworkConfig(), DefaultClientPreferences());
  var Config: ClientFileConfig := try ReadClientConfig(Paths.ClientConfig);
  return Ok(record
    Paths := Paths;
    Network := Config.Network;
    World := DefaultServerWorldConfig();
    Preferences := Config.Preferences;
  end);
end function;

// Atomically updates client presentation preferences while preserving the configured endpoint.
public function SaveClientPreferences(Path: string; Preferences: ClientPreferences): result of boolean, string;
begin
  var Current: ClientFileConfig := try ReadClientConfig(Path);
  return Std.Fs.WriteTextAtomic(Path, EncodeClientConfig(Current.Network, Preferences));
end function;

// Prepares server directories, including worlds, and loads or creates server.toml.
public function LoadServerRuntime(DataRootOverride: option of string): result of RuntimeSettings, string;
begin
  var Paths: RuntimePaths := RuntimePathsForRoot(try ResolveDataRoot(DataRootOverride));
  var SharedReady: boolean := try PrepareShared(Paths);
  var WorldsReady: boolean := try Std.Fs.CreateDirAll(Paths.Worlds);
  var ConfigReady: boolean := try EnsureServerConfigFile(Paths.ServerConfig, DefaultNetworkConfig(), DefaultServerWorldConfig());
  var Config: ServerFileConfig := try ReadServerConfig(Paths.ServerConfig);
  return Ok(record
    Paths := Paths;
    Network := Config.Network;
    World := Config.World;
    Preferences := DefaultClientPreferences();
  end);
end function;
end unit;
