// Fixed role-specific village topics and prose; mutable effects belong to the dialogue rules.
unit Dungeon.Dialogue.Villages;

uses Dungeon.Dialogue.Model as Dialogue, Dungeon.Npcs as Npcs;

function Role(Kind: Npcs.NpcKind): string;
begin
  case Kind of
    when Npcs.NpcKind.Resident:
      return 'resident';
    when Npcs.NpcKind.Guard:
      return 'guard';
    when Npcs.NpcKind.Innkeeper:
      return 'innkeeper';
    when Npcs.NpcKind.Merchant:
      return 'merchant';
    when Npcs.NpcKind.Mara:
      panic('authored Mara uses her own dialogue');
  end case;
end function;

// Bounded root topics for stationary village roles; effects are validated by dialogue rules.
public function Choices(Kind: Npcs.NpcKind): array of Dialogue.Choice;
begin
  var Values := [
    Dialogue.Choice(Id := 'identity', Text := 'Who are you?'),
    Dialogue.Choice(Id := 'settlement', Text := 'Tell me about this village.')
  ];
  if Kind = Npcs.NpcKind.Merchant then
    Values.PushInPlace(Dialogue.Choice(Id := 'trade', Text := 'Show me your wares.'));
  end if;

  if Kind = Npcs.NpcKind.Innkeeper then
    Values.PushInPlace(Dialogue.Choice(Id := 'rest', Text := 'I would like a room.'));
  end if;

  Values.PushInPlace(Dialogue.Choice(Id := 'goodbye', Text := 'Goodbye.'));
  return Values;
end function;

// Meeting memory is scoped to this exact placement, not to another NPC of the same role.
public function Greeting(Npc: Npcs.NpcPlacement; Village: string; HasMet: boolean): string;
begin
  return if HasMet then Npc.DisplayName + ' recognizes you and welcomes you back to ' + Village +
    '.'
    else Npc.DisplayName + ' greets you in ' + Village + '.'
    end if;
end function;

// Deterministic answers contain no undiscovered coordinates, quests, stock or prices.
public function Answer(Npc: Npcs.NpcPlacement; Village: string; Id: string): result of (string, string);
begin
  case Id of
    when 'identity':
      return Ok('I am ' + Npc.DisplayName + ', a ' + Role(Npc.Kind) + ' of ' + Village + '.');
    when 'settlement':
      case Npc.Kind of
        when Npcs.NpcKind.Resident:
          return Ok('This is ' + Village + '. We share the square and look after our neighbors.');
        when Npcs.NpcKind.Guard:
          return Ok(
            'I keep watch over the gates of ' + Village +
            '. The paths outside can be dangerous. You are welcome here.'
          );
        when Npcs.NpcKind.Innkeeper:
          return Ok(
            'I keep the inn of ' + Village + '. Travelers can rest here for a fee.'
          );
        when Npcs.NpcKind.Mara:
          return Error('Mara uses her authored topics');
        when Npcs.NpcKind.Merchant:
          return Ok('I trade with travelers and the people of ' + Village + '.');
      end case;
    else
      return Error('this NPC does not offer that topic');
  end case;
end function;
end unit;
