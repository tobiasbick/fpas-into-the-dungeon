// Server-owned conversation nodes and frames; node payloads never enter the wire or save formats.
unit Dungeon.Dialogue.Model;

uses Dungeon.GameState as GameState, Dungeon.Quests.Model as Quests;

// Stable intention identity and its server-authored player-facing label.
public type Choice = record
  public Id: string;
  public Text: string;
end record;

// Connection-local authority: an offer retains the exact preflighted objective.
public type Node = enum
  Root;
  CompassOffer(Objective: Quests.CompassObjective);
  CompassStatus;
end enum;

// Only display fields are projected; Node is retained by the authoritative server session.
public type Frame = record
  public Node: Node;
  public NpcId: string;
  public Speaker: string;
  public Text: string;
  public Choices: array of Choice;
end record;

// Complete candidate change and refreshed frame; the server installs it only after sending.
public type Outcome = enum
  Continued(State: GameState.GameState; Dialogue: Frame; ChangesGame: boolean);
  Ended(State: GameState.GameState);
end enum;

// Tests a projected choice list without interpreting eligibility or trusting client labels.
public function Contains(Choices: array of Choice; Id: string): boolean;
begin
  for Entry: Choice in Choices do
    if Entry.Id = Id then
      return true;
    end if;
  end for;

  return false;
end function;
end unit;
