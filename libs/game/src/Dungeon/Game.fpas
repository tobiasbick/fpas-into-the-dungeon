// Authoritative coordinates, terrain, generation, and movement rules for outdoor worlds.
unit Dungeon.Game;

uses Std.Arrays, Std.Math;

public const
  // Schema version written to world metadata and chunk files.
  WorldFormatVersion: integer := 1;
  // Selects the deterministic algorithm used for chunks that do not exist yet.
  WorldGeneratorVersion: integer := 4;
  // Fixed cell width and height of every version 4 outdoor chunk.
  WorldChunkSize: integer := 128;

public type
  // Distinguishes outdoor maps from finite first-person interiors and dungeons.
  AreaKind = enum
    OutdoorRegion;
    Settlement;
    Interior;
    Dungeon;
  end;
  // Identifies one stable position in an outdoor area's unbounded coordinate space.
  WorldPosition = record
    public X: integer;
    public Y: integer;
  end;
  // Identifies one 128 by 128 storage and generation partition.
  ChunkCoordinate = record
    public X: integer;
    public Y: integer;
  end;
  // Base material retained when a feature such as a forest or path is present.
  BaseTerrainKind = enum
    Grass;
    Sand;
    Rock;
    Water;
  end;
  // Optional surface feature rendered above compatible base terrain.
  TerrainFeatureKind = enum
    NoFeature;
    Tree;
    Forest;
    Path;
    River;
  end;
  // Classifies water without requiring connectivity traversal across an unbounded world.
  WaterKind = enum
    NoWater;
    Sea;
    Lake;
    RiverWater;
  end;
  // Complete authoritative terrain value for one outdoor world coordinate.
  WorldCell = record
    public Base: BaseTerrainKind;
    public Feature: TerrainFeatureKind;
    public Water: WaterKind;
  end;
  // Diagnostic values behind one generated cell, normalized to the range 0 through 1000.
  TerrainGenerationSample = record
    // Very slowly changing field that establishes continent-scale character.
    public Continentalness: integer;
    // Combined large-, regional-, and coast-scale height field.
    public Elevation: integer;
    // Regional climate field used for deserts and forests.
    public Moisture: integer;
    // Smooth vegetation field used for forest interiors and tree-lined edges.
    public Vegetation: integer;
    // Fine smooth field used to disturb otherwise regular lake shorelines.
    public LakeShape: integer;
    // Ridge-shaped regional field used to form mountain ranges.
    public Ruggedness: integer;
    // Final land-versus-sea score after connected ridges are applied.
    public LandScore: integer;
    // Ridge strength that can lift narrow connected land bands above sea level.
    public LandBridge: integer;
  end;
  // Immutable identity and generator contract for one outdoor world.
  WorldMetadata = record
    public Id: string;
    public Seed: integer;
    public FormatVersion: integer;
    public GeneratorVersion: integer;
    public ChunkSize: integer;
    public Spawn: WorldPosition;
  end;
  // One complete outdoor chunk in row-major order.
  WorldChunk = record
    public Coordinate: ChunkCoordinate;
    public Cells: array of WorldCell;
  end;
  // Authoritative player state retained by the server for one session.
  GameState = record
    public Area: AreaKind;
    public Player: WorldPosition;
  end;

type
  NoiseGrid = record
    Scale: integer;
    MinimumX: integer;
    MinimumY: integer;
    Width: integer;
    Values: array of integer;
  end;

const
  SeaLevel: integer := 460;
  MountainRuggedness: integer := 790;
  NaturalSpawnRadius: integer := 8;
  MaximumSpawnCandidates: integer := 1024;
  VisibleSpawnRadiusX: integer := 64;
  VisibleSpawnRadiusY: integer := 24;
  NearbySpawnRadiusX: integer := 512;
  NearbySpawnRadiusY: integer := 256;
  LakePeriodX: integer := 997;
  LakePeriodY: integer := 743;

function PositiveModulo(Value: integer; Divisor: integer): integer;
begin
  mutable var Remainder: integer := Value mod Divisor;
  if Remainder < 0 then
  begin
    Remainder := Remainder + Divisor
  end;

  return Remainder
end;

// Returns mathematical floor division for signed coordinates and a positive divisor.
public function FloorDivide(Value: integer; Divisor: integer): integer;
begin
  if Divisor <= 0 then
  begin
    panic('coordinate divisor must be positive')
  end;
  mutable var Quotient: integer := Value div Divisor;
  var Remainder: integer := Value mod Divisor;
  if (Remainder <> 0) and (Value < 0) then
  begin
    Quotient := Quotient - 1
  end;

  return Quotient
end;

// Maps one world coordinate to its containing chunk coordinate.
public function ChunkForCoordinate(Value: integer): integer;
begin
  return FloorDivide(Value, WorldChunkSize)
end;

// Maps one world coordinate to its zero-based local coordinate inside a chunk.
public function LocalForCoordinate(Value: integer): integer;
begin
  return PositiveModulo(Value, WorldChunkSize)
end;

function CoordinateHash(Seed: integer; X: integer; Y: integer; Salt: integer): integer;
begin
  var Prime: integer := 2147483647;
  var XPart: integer := PositiveModulo(X, 1000003);
  var YPart: integer := PositiveModulo(Y, 1000033);
  var SeedPart: integer := PositiveModulo(Seed, 1000037);
  var SaltPart: integer := PositiveModulo(Salt, 1000039);
  mutable var Mixed: integer := PositiveModulo((XPart * 73856093) + (YPart * 19349663), Prime);
  Mixed := PositiveModulo(Mixed + (SeedPart * 83492791), Prime);
  Mixed := PositiveModulo(Mixed + (SaltPart * 265443), Prime);
  Mixed := PositiveModulo((Mixed * 48271) + 1, Prime);
  return Mixed mod 1000
end;

function CoordinateDetail(Seed: integer; X: integer; Y: integer): integer;
begin
  var Primary: integer := CoordinateHash(Seed, X, Y, 37);
  var Secondary: integer := CoordinateHash(Seed, Y, X, 53);
  return PositiveModulo(((Primary * 613) + (Secondary * 337)) + (Primary * Secondary), 1000)
end;

function SmoothWeight(Local: integer; Scale: integer): integer;
begin
  return ((Local * Local) * ((3 * Scale) - (2 * Local))) div (Scale * Scale)
end;

function Interpolate(A: integer; B: integer; Weight: integer; Scale: integer): integer;
begin
  return ((A * (Scale - Weight)) + (B * Weight)) div Scale
end;

function ValueNoise(Seed: integer; X: integer; Y: integer; Scale: integer; Salt: integer): integer;
begin
  var GridX: integer := FloorDivide(X, Scale);
  var GridY: integer := FloorDivide(Y, Scale);
  var LocalX: integer := PositiveModulo(X, Scale);
  var LocalY: integer := PositiveModulo(Y, Scale);
  var WeightX: integer := SmoothWeight(LocalX, Scale);
  var WeightY: integer := SmoothWeight(LocalY, Scale);
  var Top: integer := Interpolate(CoordinateHash(Seed, GridX, GridY, Salt), CoordinateHash(Seed, GridX +
                                                                                                 1, GridY, Salt), WeightX, Scale);
  var Bottom: integer := Interpolate(CoordinateHash(Seed, GridX, GridY + 1, Salt), CoordinateHash(Seed, GridX +
                                                                                                        1, GridY +
                                                                                                           1, Salt), WeightX, Scale);
  return Interpolate(Top, Bottom, WeightY, Scale)
end;

function RidgeValue(Value: integer): integer;
begin
  return 1000 - (Std.Math.Abs(Value - 500) * 2)
end;

function ComposeTerrainSample(
  ContinentalWide: integer;
  ContinentalRegional: integer;
  RegionalElevation: integer;
  CoastDetail: integer;
  MoistureRegional: integer;
  MoistureDetail: integer;
  VegetationRegional: integer;
  LakeShape: integer
): TerrainGenerationSample;
begin
  var Continentalness: integer := ((ContinentalWide * 2) + ContinentalRegional) div 3;
  mutable var LandScore: integer := (((Continentalness * 6) + (RegionalElevation * 3)) + CoastDetail) div
                                    10;
  var LandBridge: integer := RidgeValue(ContinentalRegional);
  if LandBridge > 900 then
  begin
    var BridgeLandScore: integer := SeaLevel + ((LandBridge - 900) * 2);
    if BridgeLandScore > LandScore then
    begin
      LandScore := BridgeLandScore
    end
  end;

  return record
    Continentalness := Continentalness;
    Elevation := (((LandScore * 5) + (RegionalElevation * 3)) + (CoastDetail * 2)) div 10;
    Moisture := ((MoistureRegional * 2) + MoistureDetail) div 3;
    Vegetation := ((((MoistureRegional * 2) + MoistureDetail) * 3) + (VegetationRegional * 2)) div 11;
    LakeShape := LakeShape;
    Ruggedness := ((RidgeValue(RegionalElevation) * 3) + (CoastDetail * 2)) div 5;
    LandScore := LandScore;
    LandBridge := LandBridge;
  end
end;

function SampleTerrainAtSeed(Seed: integer; X: integer; Y: integer): TerrainGenerationSample;
begin
  return ComposeTerrainSample(ValueNoise(Seed, X, Y, 8192, 11), ValueNoise(Seed, X, Y, 4096, 13), ValueNoise(Seed, X, Y, 1024, 17), ValueNoise(Seed, X, Y, 256, 19), ValueNoise(Seed, X, Y, 2048, 23), ValueNoise(Seed, X, Y, 384, 29), ValueNoise(Seed, X, Y, 512, 31), ValueNoise(Seed, X, Y, 48, 41))
end;

function BuildNoiseGrid(
  Seed: integer;
  OriginX: integer;
  OriginY: integer;
  Scale: integer;
  Salt: integer
): NoiseGrid;
begin
  var MinimumX: integer := FloorDivide(OriginX, Scale);
  var MinimumY: integer := FloorDivide(OriginY, Scale);
  var MaximumX: integer := FloorDivide((OriginX + WorldChunkSize) - 1, Scale) + 1;
  var MaximumY: integer := FloorDivide((OriginY + WorldChunkSize) - 1, Scale) + 1;
  mutable var Values: array of integer := [];
  for GridY: integer := MinimumY to MaximumY do
  begin
    for GridX: integer := MinimumX to MaximumX do
    begin
      Std.Arrays.Push(Values, CoordinateHash(Seed, GridX, GridY, Salt))
    end
  end;

  return record
    Scale := Scale;
    MinimumX := MinimumX;
    MinimumY := MinimumY;
    Width := (MaximumX - MinimumX) + 1;
    Values := Values;
  end
end;

function SampleNoise(Grid: NoiseGrid; X: integer; Y: integer): integer;
begin
  var GridX: integer := FloorDivide(X, Grid.Scale);
  var GridY: integer := FloorDivide(Y, Grid.Scale);
  var LocalX: integer := PositiveModulo(X, Grid.Scale);
  var LocalY: integer := PositiveModulo(Y, Grid.Scale);
  var WeightX: integer := SmoothWeight(LocalX, Grid.Scale);
  var WeightY: integer := SmoothWeight(LocalY, Grid.Scale);
  var OffsetX: integer := GridX - Grid.MinimumX;
  var OffsetY: integer := GridY - Grid.MinimumY;
  var TopIndex: integer := (OffsetY * Grid.Width) + OffsetX;
  var BottomIndex: integer := TopIndex + Grid.Width;
  var Top: integer := Interpolate(Grid.Values[TopIndex], Grid.Values[TopIndex + 1], WeightX, Grid.Scale);
  var Bottom: integer := Interpolate(Grid.Values[BottomIndex], Grid.Values[BottomIndex + 1], WeightX, Grid.Scale);
  return Interpolate(Top, Bottom, WeightY, Grid.Scale)
end;

function PeriodicDistance(Value: integer; Period: integer): integer;
begin
  var Wrapped: integer := PositiveModulo(Value, Period);
  if Wrapped > Period div 2 then
  begin
    return Period - Wrapped
  end;

  return Wrapped
end;

function PlainCell(): WorldCell;
begin
  return record
    Base := BaseTerrainKind.Grass;
    Feature := TerrainFeatureKind.NoFeature;
    Water := WaterKind.NoWater;
  end
end;

function WaterCell(Kind: WaterKind; Feature: TerrainFeatureKind): WorldCell;
begin
  return record
    Base := BaseTerrainKind.Water;
    Feature := Feature;
    Water := Kind;
  end
end;

function CellIsWalkable(Cell: WorldCell): boolean;
begin
  return (Cell.Base = BaseTerrainKind.Grass) or (Cell.Base = BaseTerrainKind.Sand)
end;

function RiverShift(Seed: integer; Y: integer): integer;
begin
  return (ValueNoise(Seed, 0, Y, 512, 71) - 500) div 2
end;

function PathShift(Seed: integer; X: integer): integer;
begin
  return (ValueNoise(Seed, X, 0, 144, 89) - 500) div 3
end;

function NearestPeriodicIndex(Value: integer; Offset: integer; Period: integer): integer;
begin
  return FloorDivide((Value + Offset) + (Period div 2), Period)
end;

function GenerateCellFromInputs(
  Seed: integer;
  X: integer;
  Y: integer;
  RiverOffset: integer;
  PathOffset: integer;
  Sample: TerrainGenerationSample
): WorldCell;
begin
  var Detail: integer := CoordinateDetail(Seed, X, Y);
  var LakeOffsetX: integer := PositiveModulo(Seed, LakePeriodX);
  var LakeOffsetY: integer := PositiveModulo(Seed, LakePeriodY);
  var LakeGridX: integer := NearestPeriodicIndex(X, LakeOffsetX, LakePeriodX);
  var LakeGridY: integer := NearestPeriodicIndex(Y, LakeOffsetY, LakePeriodY);
  var LakeX: integer := (X + LakeOffsetX) - (LakeGridX * LakePeriodX);
  var LakeY: integer := (Y + LakeOffsetY) - (LakeGridY * LakePeriodY);
  var LakeRadiusX: integer := 42 + (CoordinateHash(Seed, LakeGridX, LakeGridY, 43) mod 25);
  var LakeRadiusY: integer := 26 + (CoordinateHash(Seed, LakeGridX, LakeGridY, 47) mod 17);
  var LakeScore: integer := ((((LakeX * LakeX) * 1000) div (LakeRadiusX * LakeRadiusX)) + (((LakeY * LakeY) * 1000) div (LakeRadiusY * LakeRadiusY))) +
                            ((Sample.LakeShape - 500) div 2);
  if Sample.LandScore < SeaLevel then
  begin
    return WaterCell(WaterKind.Sea, TerrainFeatureKind.NoFeature)
  end;

  if ((LakeScore < 1000) and (Sample.LandScore > SeaLevel + 30)) and (Sample.Elevation < 740) then
  begin
    return WaterCell(WaterKind.Lake, TerrainFeatureKind.NoFeature)
  end;

  if (Sample.Elevation < 800) and (PeriodicDistance(X - RiverOffset, 1024) <= 1) then
  begin
    return WaterCell(WaterKind.RiverWater, TerrainFeatureKind.River)
  end;
  mutable var Cell: WorldCell := PlainCell();
  if (Sample.Ruggedness > MountainRuggedness) and (Sample.Elevation > 520) then
  begin
    Cell.Base := BaseTerrainKind.Rock
  end
  else
  begin
    if Sample.Moisture < 285 then
    begin
      Cell.Base := BaseTerrainKind.Sand
    end
    else
    begin
      if Sample.Vegetation >= 650 then
      begin
        Cell.Feature := TerrainFeatureKind.Forest
      end
      else
      begin
        if ((Sample.Vegetation >= 540) and (Detail > 300)) or
           ((Sample.Moisture >= 450) and (Detail > 960)) then
        begin
          Cell.Feature := TerrainFeatureKind.Tree
        end
      end
    end
  end;

  if (Cell.Base <> BaseTerrainKind.Rock) and (PeriodicDistance(Y - PathOffset, 768) <= 1) then
  begin
    Cell.Feature := TerrainFeatureKind.Path
  end;

  return Cell
end;

function GenerateCellWithShifts(
  Seed: integer;
  X: integer;
  Y: integer;
  RiverOffset: integer;
  PathOffset: integer
): WorldCell;
begin
  return GenerateCellFromInputs(Seed, X, Y, RiverOffset, PathOffset, SampleTerrainAtSeed(Seed, X, Y))
end;

function HasVisibleWoodland(Seed: integer; X: integer; Y: integer): boolean;
begin
  mutable var CandidateY: integer := Y - VisibleSpawnRadiusY;
  while CandidateY <= Y + VisibleSpawnRadiusY do
  begin
    mutable var CandidateX: integer := X - VisibleSpawnRadiusX;
    while CandidateX <= X + VisibleSpawnRadiusX do
    begin
      var Cell: WorldCell := GenerateCellWithShifts(Seed, CandidateX, CandidateY, RiverShift(Seed, CandidateY), PathShift(Seed, CandidateX));
      if (Cell.Feature = TerrainFeatureKind.Tree) or (Cell.Feature = TerrainFeatureKind.Forest) then
      begin
        return true
      end;

      CandidateX := CandidateX + 4
    end;

    CandidateY := CandidateY + 4
  end;

  return false
end;

function HasNearbyLandscapeContrast(Seed: integer; X: integer; Y: integer): boolean;
begin
  mutable var CandidateY: integer := Y - NearbySpawnRadiusY;
  while CandidateY <= Y + NearbySpawnRadiusY do
  begin
    mutable var CandidateX: integer := X - NearbySpawnRadiusX;
    while CandidateX <= X + NearbySpawnRadiusX do
    begin
      var Cell: WorldCell := GenerateCellWithShifts(Seed, CandidateX, CandidateY, RiverShift(Seed, CandidateY), PathShift(Seed, CandidateX));
      if (((Cell.Base = BaseTerrainKind.Sand) or (Cell.Base = BaseTerrainKind.Rock)) or (Cell.Water <> WaterKind.NoWater)) or
         (Cell.Feature = TerrainFeatureKind.Forest) then
      begin
        return true
      end;

      CandidateX := CandidateX + 32
    end;

    CandidateY := CandidateY + 32
  end;

  return false
end;

function IsNaturalSpawnSite(Seed: integer; X: integer; Y: integer): boolean;
begin
  var CenterSample: TerrainGenerationSample := SampleTerrainAtSeed(Seed, X, Y);
  if ((CenterSample.LandScore < 590) or (CenterSample.Ruggedness > 700)) or
     (((CenterSample.Moisture < 300) or (CenterSample.Moisture > 800)) or ((CenterSample.Vegetation < 430) or (CenterSample.Vegetation > 680))) then
  begin
    return false
  end;
  var Center: WorldCell := GenerateCellWithShifts(Seed, X, Y, RiverShift(Seed, Y), PathShift(Seed, X));
  if not CellIsWalkable(Center) or (Center.Feature <> TerrainFeatureKind.NoFeature) then
  begin
    return false
  end;

  for CandidateY: integer := Y - NaturalSpawnRadius to Y + NaturalSpawnRadius do
  begin
    for CandidateX: integer := X - NaturalSpawnRadius to X + NaturalSpawnRadius do
    begin
      if not CellIsWalkable(GenerateCellWithShifts(Seed, CandidateX, CandidateY, RiverShift(Seed, CandidateY), PathShift(Seed, CandidateX))) then
      begin
        return false
      end
    end
  end;

  return HasVisibleWoodland(Seed, X, Y) and HasNearbyLandscapeContrast(Seed, X, Y)
end;

function FindNaturalSpawn(Seed: integer): WorldPosition;
begin
  for Candidate: integer := 0 to MaximumSpawnCandidates - 1 do
  begin
    var X: integer := (CoordinateHash(Seed, Candidate, 0, 101) - 500) * 32;
    var Y: integer := (CoordinateHash(Seed, Candidate, 0, 103) - 500) * 32;
    if IsNaturalSpawnSite(Seed, X, Y) then
    begin
      return record
        X := X;
        Y := Y;
      end
    end
  end;

  panic('unable to find a natural spawn site for world seed')
end;

// Creates version 4 metadata with a deterministic spawn near varied naturally generated terrain.
public function NewWorldMetadata(Id: string; Seed: integer): WorldMetadata;
begin
  return record
    Id := Id;
    Seed := Seed;
    FormatVersion := WorldFormatVersion;
    GeneratorVersion := WorldGeneratorVersion;
    ChunkSize := WorldChunkSize;
    Spawn := FindNaturalSpawn(Seed);
  end
end;

// Samples normalized generator fields for previews, diagnostics, and distribution tests.
public function SampleWorldGeneration(Metadata: WorldMetadata; X: integer; Y: integer): TerrainGenerationSample;
begin
  if Metadata.GeneratorVersion <> WorldGeneratorVersion then
  begin
    panic('unsupported world generator version')
  end;

  return SampleTerrainAtSeed(Metadata.Seed, X, Y)
end;

// Generates one cell solely from metadata and absolute coordinates.
public function GenerateWorldCell(Metadata: WorldMetadata; X: integer; Y: integer): WorldCell;
begin
  if Metadata.GeneratorVersion <> WorldGeneratorVersion then
  begin
    panic('unsupported world generator version')
  end;

  return GenerateCellWithShifts(Metadata.Seed, X, Y, RiverShift(Metadata.Seed, Y), PathShift(Metadata.Seed, X))
end;

// Generates one complete chunk independently of load or generation order.
public function GenerateChunk(Metadata: WorldMetadata; Coordinate: ChunkCoordinate): WorldChunk;
begin
  mutable var Cells: array of WorldCell := [];
  var OriginX: integer := Coordinate.X * WorldChunkSize;
  var OriginY: integer := Coordinate.Y * WorldChunkSize;
  var ContinentalWideGrid: NoiseGrid := BuildNoiseGrid(Metadata.Seed, OriginX, OriginY, 8192, 11);
  var ContinentalRegionalGrid: NoiseGrid := BuildNoiseGrid(Metadata.Seed, OriginX, OriginY, 4096, 13);
  var RegionalElevationGrid: NoiseGrid := BuildNoiseGrid(Metadata.Seed, OriginX, OriginY, 1024, 17);
  var CoastDetailGrid: NoiseGrid := BuildNoiseGrid(Metadata.Seed, OriginX, OriginY, 256, 19);
  var MoistureRegionalGrid: NoiseGrid := BuildNoiseGrid(Metadata.Seed, OriginX, OriginY, 2048, 23);
  var MoistureDetailGrid: NoiseGrid := BuildNoiseGrid(Metadata.Seed, OriginX, OriginY, 384, 29);
  var VegetationRegionalGrid: NoiseGrid := BuildNoiseGrid(Metadata.Seed, OriginX, OriginY, 512, 31);
  var LakeShapeGrid: NoiseGrid := BuildNoiseGrid(Metadata.Seed, OriginX, OriginY, 48, 41);
  mutable var PathOffsets: array of integer := [];
  for LocalX: integer := 0 to WorldChunkSize - 1 do
  begin
    Std.Arrays.Push(PathOffsets, PathShift(Metadata.Seed, OriginX + LocalX))
  end;

  for LocalY: integer := 0 to WorldChunkSize - 1 do
  begin
    var RowRiverOffset: integer := RiverShift(Metadata.Seed, OriginY + LocalY);
    for LocalX: integer := 0 to WorldChunkSize - 1 do
    begin
      var X: integer := OriginX + LocalX;
      var Y: integer := OriginY + LocalY;
      var Sample: TerrainGenerationSample := ComposeTerrainSample(SampleNoise(ContinentalWideGrid, X, Y), SampleNoise(ContinentalRegionalGrid, X, Y), SampleNoise(RegionalElevationGrid, X, Y), SampleNoise(CoastDetailGrid, X, Y), SampleNoise(MoistureRegionalGrid, X, Y), SampleNoise(MoistureDetailGrid, X, Y), SampleNoise(VegetationRegionalGrid, X, Y), SampleNoise(LakeShapeGrid, X, Y));
      Std.Arrays.Push(Cells, GenerateCellFromInputs(Metadata.Seed, X, Y, RowRiverOffset, PathOffsets[LocalX], Sample))
    end
  end;

  return record
    Coordinate := Coordinate;
    Cells := Cells;
  end
end;

// Returns one cell after validating local coordinates and chunk shape.
public function ChunkCell(Chunk: WorldChunk; LocalX: integer; LocalY: integer): WorldCell;
begin
  if ((LocalX < 0) or (LocalX >= WorldChunkSize)) or ((LocalY < 0) or (LocalY >= WorldChunkSize)) then
  begin
    panic('local coordinate is outside the chunk')
  end;

  if Std.Arrays.Length(Chunk.Cells) <> WorldChunkSize * WorldChunkSize then
  begin
    panic('chunk cell count does not match chunk size')
  end;

  return Chunk.Cells[(LocalY * WorldChunkSize) + LocalX]
end;

// Validates a loaded chunk's shape and terrain-layer invariants.
public function ValidateChunk(Chunk: WorldChunk): result of WorldChunk, string;
begin
  if Std.Arrays.Length(Chunk.Cells) <> WorldChunkSize * WorldChunkSize then
  begin
    return Error('chunk cell count must match 128 by 128 chunk size')
  end;

  for Cell: WorldCell in Chunk.Cells do
  begin
    if Cell.Base = BaseTerrainKind.Water then
    begin
      if Cell.Water = WaterKind.NoWater then
      begin
        return Error('water terrain must have a water classification')
      end
    end
    else
    begin
      if Cell.Water <> WaterKind.NoWater then
      begin
        return Error('non-water terrain must not have a water classification')
      end;

      if Cell.Feature = TerrainFeatureKind.River then
      begin
        return Error('river feature requires water terrain')
      end
    end;

    if ((Cell.Feature = TerrainFeatureKind.Tree) or (Cell.Feature = TerrainFeatureKind.Forest)) or
       (Cell.Feature = TerrainFeatureKind.Path) then
    begin
      if Cell.Base = BaseTerrainKind.Water then
      begin
        return Error('forest and path features require land terrain')
      end
    end;

    if Cell.Feature = TerrainFeatureKind.River then
    begin
      if Cell.Water <> WaterKind.RiverWater then
      begin
        return Error('river feature requires river water classification')
      end
    end
  end;

  return Ok(Chunk)
end;

// Maps an authoritative cell to one compact client-safe presentation code.
public function VisibleCellCode(Cell: WorldCell): string;
begin
  case Cell.Feature of
    TerrainFeatureKind.Tree:
    begin
      return 't'
    end;
    TerrainFeatureKind.Forest:
    begin
      return 'f'
    end;
    TerrainFeatureKind.Path:
    begin
      return 'p'
    end;
    TerrainFeatureKind.River:
    begin
      return 'r'
    end
    else
    begin
    end
  end;

  case Cell.Water of
    WaterKind.Sea:
    begin
      return 'o'
    end;
    WaterKind.Lake:
    begin
      return 'l'
    end
    else
    begin
    end
  end;

  case Cell.Base of
    BaseTerrainKind.Grass:
    begin
      return 'g'
    end;
    BaseTerrainKind.Sand:
    begin
      return 'd'
    end;
    BaseTerrainKind.Rock:
    begin
      return 'm'
    end
    else
    begin
      return 'o'
    end
  end
end;

// Returns whether the server may place or move a player onto one cell.
public function IsWalkable(Cell: WorldCell): boolean;
begin
  return CellIsWalkable(Cell)
end;

// Creates the initial player state at the metadata-defined spawn coordinate.
public function NewGame(Metadata: WorldMetadata): GameState;
begin
  return record
    Area := AreaKind.OutdoorRegion;
    Player := Metadata.Spawn;
  end
end;

// Applies one cardinal movement intention after validating the authoritative target cell.
public function MovePlayer(State: GameState; DeltaX: integer; DeltaY: integer; Target: WorldCell): result of GameState, string;
begin
  if not (((DeltaX = 0) and ((DeltaY = -1) or (DeltaY = 1))) or ((DeltaY = 0) and ((DeltaX = -1) or (DeltaX = 1)))) then
  begin
    return Error('movement must be one cardinal step')
  end;

  if not IsWalkable(Target) then
  begin
    return Error('terrain is not traversable')
  end;

  return Ok(record
    Area := State.Area;
    Player := record
      X := State.Player.X + DeltaX;
      Y := State.Player.Y + DeltaY;
    end;
  end)
end;
