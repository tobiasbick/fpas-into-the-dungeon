// Authoritative rules for the initial game slice.
unit Dungeon.Game;

public const
  // Fixed dimensions of the initial outdoor region.
  MapWidth: integer := 13;
  MapHeight: integer := 7;

public type
  // Distinguishes outdoor maps from first-person interiors and dungeons.
  AreaKind = enum
    OutdoorRegion;
    Interior;
    Dungeon;
  end;
  // Client-safe projection of an area and the player's position within it.
  VisibleArea = record
    public Kind: AreaKind;
    public Width: integer;
    public Height: integer;
    public Rows: array of string;
    public PlayerX: integer;
    public PlayerY: integer;
  end;
  // Authoritative game state retained by the server for one session.
  GameState = record
    public Area: AreaKind;
    public PlayerX: integer;
    public PlayerY: integer;
  end;

// Creates the initial player position at the center of the map.
public function NewGame(): GameState;
begin
  return record
    Area := AreaKind.OutdoorRegion;
    PlayerX := MapWidth div 2;
    PlayerY := MapHeight div 2;
  end
end;

// Projects the fixed outdoor region into state that may be shown to a client.
public function GetVisibleArea(State: GameState): VisibleArea;
begin
  return record
    Kind := State.Area;
    Width := MapWidth;
    Height := MapHeight;
    Rows := [
              '~~~~.........',
              '~~~..^^......',
              '..==.^^......',
              '..==.......#.',
              '..=====......',
              '......^^^....',
              '.............'
            ];
    PlayerX := State.PlayerX;
    PlayerY := State.PlayerY;
  end
end;

// Applies one cardinal movement intention inside the map.
public function MovePlayer(State: GameState; DeltaX: integer; DeltaY: integer): result of GameState, string;
begin
  if not (((DeltaX = 0) and ((DeltaY = -1) or (DeltaY = 1))) or ((DeltaY = 0) and ((DeltaX = -1) or (DeltaX = 1)))) then
  begin
    return Error('movement must be one cardinal step')
  end;
  var NextX: integer := State.PlayerX + DeltaX;
  var NextY: integer := State.PlayerY + DeltaY;
  if (((NextX < 0) or (NextX >= MapWidth)) or (NextY < 0)) or (NextY >= MapHeight) then
  begin
    return Error('movement leaves the map')
  end;

  return Ok(record
    Area := State.Area;
    PlayerX := NextX;
    PlayerY := NextY;
  end)
end;
