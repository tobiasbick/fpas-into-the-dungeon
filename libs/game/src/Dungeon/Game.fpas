// Authoritative coordinates, terrain, generation, movement, interaction, and item rules.
unit Dungeon.Game;

uses Dungeon.Exploration.Model, Std.Arrays, Std.Math, Std.Results, Std.Str;

public const
  // Schema version written to world metadata and chunk files.
  WorldFormatVersion: integer := 2;
  // Selects the deterministic algorithm used for chunks that do not exist yet.
  WorldGeneratorVersion: integer := 5;
  // Fixed cell width and height of every version 5 outdoor chunk.
  WorldChunkSize: integer := 128;
  // Successful interaction text when neither the current nor forward field offers an action.
  NoInteractionMessage: string := 'There is nothing to interact with.';
  // Read-only description returned for the first wall-mounted inspectable object.
  StoneTabletDescription: string := 'The weathered inscription reads: The dungeon remembers every step.';
  // Stable identity and player-facing text of the first collectible item.
  InitialDungeonItemId: string := 'initial-dungeon:ancient-coin';
  InitialDungeonItemName: string := 'Ancient coin';
  InitialDungeonItemDescription: string := 'A heavy, tarnished coin marked with a doorway beneath a crescent moon.';

public type
  // Distinguishes outdoor maps from finite first-person interiors and dungeons.
  AreaKind = enum
    OutdoorRegion;
    Settlement;
    Interior;
    Dungeon;
  end;
  // Identifies one stable position in an outdoor area's unbounded coordinate space.
  WorldPosition = record
    public X: integer;
    public Y: integer;
  end;
  // Identifies one bounded field in a finite interior independently of world coordinates.
  InteriorPosition = record
    public X: integer;
    public Y: integer;
  end;
  // Identifies the one item kind introduced by the first inventory slice.
  ItemKind = enum
    AncientCoin;
  end;
  // Authoritative ownership or exact area-local placement of an item.
  ItemLocation = enum
    InInterior(AreaId: string; Position: InteriorPosition);
    CarriedByPlayer;
  end;
  // Stable mutable item state; identity is unique within one game state.
  GameItem = record
    public Id: string;
    public Kind: ItemKind;
    public Location: ItemLocation;
  end;
  // Cardinal orientation retained for grid-based first-person movement.
  FacingDirection = enum
    North;
    East;
    South;
    West;
  end;
  // Relative one-field translation requested in a first-person area.
  RelativeStep = enum
    Forward;
    Backward;
    Left;
    Right;
  end;
  // Relative 90-degree rotation requested in a first-person area.
  RelativeTurn = enum
    TurnLeft;
    TurnRight;
  end;
  // Authoritative field material of the fixed initial interior.
  InteriorCellKind = enum
    Wall;
    Floor;
    ExitField;
  end;
  // Complete bounded interior geometry with one connected start and exit.
  InteriorMap = record
    public Width: integer;
    public Height: integer;
    public Cells: array of InteriorCellKind;
    public Start: InteriorPosition;
    public StartFacing: FacingDirection;
    public Exit: InteriorPosition;
    // Fixed wall field occupied by the initial dungeon's inspectable stone tablet.
    public Tablet: InteriorPosition;
    // Initial floor placement of the first collectible item.
    public Item: InteriorPosition;
  end;
  // Position and facing retained while the player occupies a first-person area.
  FirstPersonPose = record
    public Position: InteriorPosition;
    public Facing: FacingDirection;
  end;
  // Area-specific player position; outdoor and interior coordinates cannot be confused.
  PlayerPosition = enum
    Outdoor(Value: WorldPosition);
    FirstPerson(Value: FirstPersonPose);
  end;
  // Identifies one 128 by 128 storage and generation partition.
  ChunkCoordinate = record
    public X: integer;
    public Y: integer;
  end;
  // Base material retained when a feature such as a forest or path is present.
  BaseTerrainKind = enum
    Grass;
    Sand;
    Rock;
    Water;
  end;
  // Optional surface feature rendered above compatible base terrain.
  TerrainFeatureKind = enum
    NoFeature;
    Tree;
    Forest;
    Path;
    River;
    Entrance;
  end;
  // Classifies water without requiring connectivity traversal across an unbounded world.
  WaterKind = enum
    NoWater;
    Sea;
    Lake;
    RiverWater;
  end;
  // Complete authoritative terrain value for one outdoor world coordinate.
  WorldCell = record
    public Base: BaseTerrainKind;
    public Feature: TerrainFeatureKind;
    public Water: WaterKind;
  end;
  // Diagnostic values behind one generated cell, normalized to the range 0 through 1000.
  TerrainGenerationSample = record
    // Very slowly changing field that establishes continent-scale character.
    public Continentalness: integer;
    // Combined large-, regional-, and coast-scale height field.
    public Elevation: integer;
    // Regional climate field used for deserts and forests.
    public Moisture: integer;
    // Smooth vegetation field used for forest interiors and tree-lined edges.
    public Vegetation: integer;
    // Fine smooth field used to disturb otherwise regular lake shorelines.
    public LakeShape: integer;
    // Ridge-shaped regional field used to form mountain ranges.
    public Ruggedness: integer;
    // Final land-versus-sea score after connected ridges are applied.
    public LandScore: integer;
    // Ridge strength that can lift narrow connected land bands above sea level.
    public LandBridge: integer;
  end;
  // Immutable identity and generator contract for one outdoor world.
  WorldMetadata = record
    public Id: string;
    public Seed: integer;
    public FormatVersion: integer;
    public GeneratorVersion: integer;
    public ChunkSize: integer;
    public Spawn: WorldPosition;
    // Stable server-owned identity and display label of the initial outdoor area.
    public OutdoorAreaId: string;
    public OutdoorAreaLabel: string;
    // Stable server-owned identity and display label of the initial dungeon.
    public DungeonAreaId: string;
    public DungeonAreaLabel: string;
    // Stable identity, source coordinate, and destination of the first area transition.
    public EntranceId: string;
    public Entrance: WorldPosition;
    public EntranceTargetAreaId: string;
  end;
  // One complete outdoor chunk in row-major order.
  WorldChunk = record
    public Coordinate: ChunkCoordinate;
    public Cells: array of WorldCell;
  end;
  // Optional exact source retained only while the player occupies an entered area.
  ReturnLocation = enum
    NoReturnLocation;
    ReturnTo(AreaId: string; Position: WorldPosition);
  end;
  // Authoritative player state retained by the server for one session.
  GameState = record
    public Area: AreaKind;
    public AreaId: string;
    public Player: PlayerPosition;
    public ReturnLocation: ReturnLocation;
    // Persistent server-owned discovery; current visibility is derived by exploration rules.
    public Exploration: ExplorationState;
    // Persistent server-owned item locations and inventory ownership.
    public Items: array of GameItem;
  end;
  // Successful server-side resolution of one interaction intention.
  InteractionOutcome = enum
    // The interaction changed the authoritative area and returns its replacement state.
    Transitioned(State: GameState);
    // The interaction changed mutable state without changing areas.
    StateChanged(State: GameState);
    // Read-only information; an empty title denotes short feedback rather than inspection content.
    Described(Title: string; Text: string);
  end;

type
  NoiseGrid = record
    Scale: integer;
    MinimumX: integer;
    MinimumY: integer;
    Width: integer;
    Values: array of integer;
  end;

const
  SeaLevel: integer := 460;
  MountainRuggedness: integer := 790;
  NaturalSpawnRadius: integer := 8;
  MaximumSpawnCandidates: integer := 1024;
  VisibleSpawnRadiusX: integer := 64;
  VisibleSpawnRadiusY: integer := 24;
  NearbySpawnRadiusX: integer := 512;
  NearbySpawnRadiusY: integer := 256;
  LakePeriodX: integer := 997;
  LakePeriodY: integer := 743;

function PositiveModulo(Value: integer; Divisor: integer): integer;
begin
  mutable var Remainder: integer := Value mod Divisor;
  if Remainder < 0 then
  begin
    Remainder := Remainder + Divisor
  end;

  return Remainder
end;

// Returns mathematical floor division for signed coordinates and a positive divisor.
public function FloorDivide(Value: integer; Divisor: integer): integer;
begin
  if Divisor <= 0 then
  begin
    panic('coordinate divisor must be positive')
  end;
  mutable var Quotient: integer := Value div Divisor;
  var Remainder: integer := Value mod Divisor;
  if (Remainder <> 0) and (Value < 0) then
  begin
    Quotient := Quotient - 1
  end;

  return Quotient
end;

// Maps one world coordinate to its containing chunk coordinate.
public function ChunkForCoordinate(Value: integer): integer;
begin
  return FloorDivide(Value, WorldChunkSize)
end;

// Maps one world coordinate to its zero-based local coordinate inside a chunk.
public function LocalForCoordinate(Value: integer): integer;
begin
  return PositiveModulo(Value, WorldChunkSize)
end;

function CoordinateHash(Seed: integer; X: integer; Y: integer; Salt: integer): integer;
begin
  var Prime: integer := 2147483647;
  var XPart: integer := PositiveModulo(X, 1000003);
  var YPart: integer := PositiveModulo(Y, 1000033);
  var SeedPart: integer := PositiveModulo(Seed, 1000037);
  var SaltPart: integer := PositiveModulo(Salt, 1000039);
  mutable var Mixed: integer := PositiveModulo((XPart * 73856093) + (YPart * 19349663), Prime);
  Mixed := PositiveModulo(Mixed + (SeedPart * 83492791), Prime);
  Mixed := PositiveModulo(Mixed + (SaltPart * 265443), Prime);
  Mixed := PositiveModulo((Mixed * 48271) + 1, Prime);
  return Mixed mod 1000
end;

function CoordinateDetail(Seed: integer; X: integer; Y: integer): integer;
begin
  var Primary: integer := CoordinateHash(Seed, X, Y, 37);
  var Secondary: integer := CoordinateHash(Seed, Y, X, 53);
  return PositiveModulo(((Primary * 613) + (Secondary * 337)) + (Primary * Secondary), 1000)
end;

function SmoothWeight(Local: integer; Scale: integer): integer;
begin
  return ((Local * Local) * ((3 * Scale) - (2 * Local))) div (Scale * Scale)
end;

function Interpolate(A: integer; B: integer; Weight: integer; Scale: integer): integer;
begin
  return ((A * (Scale - Weight)) + (B * Weight)) div Scale
end;

function ValueNoise(Seed: integer; X: integer; Y: integer; Scale: integer; Salt: integer): integer;
begin
  var GridX: integer := FloorDivide(X, Scale);
  var GridY: integer := FloorDivide(Y, Scale);
  var LocalX: integer := PositiveModulo(X, Scale);
  var LocalY: integer := PositiveModulo(Y, Scale);
  var WeightX: integer := SmoothWeight(LocalX, Scale);
  var WeightY: integer := SmoothWeight(LocalY, Scale);
  var Top: integer := Interpolate(CoordinateHash(Seed, GridX, GridY, Salt), CoordinateHash(Seed, GridX +
                                                                                                 1, GridY, Salt), WeightX, Scale);
  var Bottom: integer := Interpolate(CoordinateHash(Seed, GridX, GridY + 1, Salt), CoordinateHash(Seed, GridX +
                                                                                                        1, GridY +
                                                                                                           1, Salt), WeightX, Scale);
  return Interpolate(Top, Bottom, WeightY, Scale)
end;

function RidgeValue(Value: integer): integer;
begin
  return 1000 - (Std.Math.Abs(Value - 500) * 2)
end;

function ComposeTerrainSample(
  ContinentalWide: integer;
  ContinentalRegional: integer;
  RegionalElevation: integer;
  CoastDetail: integer;
  MoistureRegional: integer;
  MoistureDetail: integer;
  VegetationRegional: integer;
  LakeShape: integer
): TerrainGenerationSample;
begin
  var Continentalness: integer := ((ContinentalWide * 2) + ContinentalRegional) div 3;
  mutable var LandScore: integer := (((Continentalness * 6) + (RegionalElevation * 3)) + CoastDetail) div
                                    10;
  var LandBridge: integer := RidgeValue(ContinentalRegional);
  if LandBridge > 900 then
  begin
    var BridgeLandScore: integer := SeaLevel + ((LandBridge - 900) * 2);
    if BridgeLandScore > LandScore then
    begin
      LandScore := BridgeLandScore
    end
  end;

  return record
    Continentalness := Continentalness;
    Elevation := (((LandScore * 5) + (RegionalElevation * 3)) + (CoastDetail * 2)) div 10;
    Moisture := ((MoistureRegional * 2) + MoistureDetail) div 3;
    Vegetation := ((((MoistureRegional * 2) + MoistureDetail) * 3) + (VegetationRegional * 2)) div 11;
    LakeShape := LakeShape;
    Ruggedness := ((RidgeValue(RegionalElevation) * 3) + (CoastDetail * 2)) div 5;
    LandScore := LandScore;
    LandBridge := LandBridge;
  end
end;

function SampleTerrainAtSeed(Seed: integer; X: integer; Y: integer): TerrainGenerationSample;
begin
  return ComposeTerrainSample(ValueNoise(Seed, X, Y, 8192, 11), ValueNoise(Seed, X, Y, 4096, 13), ValueNoise(Seed, X, Y, 1024, 17), ValueNoise(Seed, X, Y, 256, 19), ValueNoise(Seed, X, Y, 2048, 23), ValueNoise(Seed, X, Y, 384, 29), ValueNoise(Seed, X, Y, 512, 31), ValueNoise(Seed, X, Y, 48, 41))
end;

function BuildNoiseGrid(
  Seed: integer;
  OriginX: integer;
  OriginY: integer;
  Scale: integer;
  Salt: integer
): NoiseGrid;
begin
  var MinimumX: integer := FloorDivide(OriginX, Scale);
  var MinimumY: integer := FloorDivide(OriginY, Scale);
  var MaximumX: integer := FloorDivide((OriginX + WorldChunkSize) - 1, Scale) + 1;
  var MaximumY: integer := FloorDivide((OriginY + WorldChunkSize) - 1, Scale) + 1;
  mutable var Values: array of integer := [];
  for GridY: integer := MinimumY to MaximumY do
  begin
    for GridX: integer := MinimumX to MaximumX do
    begin
      Std.Arrays.Push(Values, CoordinateHash(Seed, GridX, GridY, Salt))
    end
  end;

  return record
    Scale := Scale;
    MinimumX := MinimumX;
    MinimumY := MinimumY;
    Width := (MaximumX - MinimumX) + 1;
    Values := Values;
  end
end;

function SampleNoise(Grid: NoiseGrid; X: integer; Y: integer): integer;
begin
  var GridX: integer := FloorDivide(X, Grid.Scale);
  var GridY: integer := FloorDivide(Y, Grid.Scale);
  var LocalX: integer := PositiveModulo(X, Grid.Scale);
  var LocalY: integer := PositiveModulo(Y, Grid.Scale);
  var WeightX: integer := SmoothWeight(LocalX, Grid.Scale);
  var WeightY: integer := SmoothWeight(LocalY, Grid.Scale);
  var OffsetX: integer := GridX - Grid.MinimumX;
  var OffsetY: integer := GridY - Grid.MinimumY;
  var TopIndex: integer := (OffsetY * Grid.Width) + OffsetX;
  var BottomIndex: integer := TopIndex + Grid.Width;
  var Top: integer := Interpolate(Grid.Values[TopIndex], Grid.Values[TopIndex + 1], WeightX, Grid.Scale);
  var Bottom: integer := Interpolate(Grid.Values[BottomIndex], Grid.Values[BottomIndex + 1], WeightX, Grid.Scale);
  return Interpolate(Top, Bottom, WeightY, Grid.Scale)
end;

function PeriodicDistance(Value: integer; Period: integer): integer;
begin
  var Wrapped: integer := PositiveModulo(Value, Period);
  if Wrapped > Period div 2 then
  begin
    return Period - Wrapped
  end;

  return Wrapped
end;

function PlainCell(): WorldCell;
begin
  return record
    Base := BaseTerrainKind.Grass;
    Feature := TerrainFeatureKind.NoFeature;
    Water := WaterKind.NoWater;
  end
end;

function WaterCell(Kind: WaterKind; Feature: TerrainFeatureKind): WorldCell;
begin
  return record
    Base := BaseTerrainKind.Water;
    Feature := Feature;
    Water := Kind;
  end
end;

function CellIsWalkable(Cell: WorldCell): boolean;
begin
  return (Cell.Base = BaseTerrainKind.Grass) or (Cell.Base = BaseTerrainKind.Sand)
end;

function RiverShift(Seed: integer; Y: integer): integer;
begin
  return (ValueNoise(Seed, 0, Y, 512, 71) - 500) div 2
end;

function PathShift(Seed: integer; X: integer): integer;
begin
  return (ValueNoise(Seed, X, 0, 144, 89) - 500) div 3
end;

function NearestPeriodicIndex(Value: integer; Offset: integer; Period: integer): integer;
begin
  return FloorDivide((Value + Offset) + (Period div 2), Period)
end;

function GenerateCellFromInputs(
  Seed: integer;
  X: integer;
  Y: integer;
  RiverOffset: integer;
  PathOffset: integer;
  Sample: TerrainGenerationSample
): WorldCell;
begin
  var Detail: integer := CoordinateDetail(Seed, X, Y);
  var LakeOffsetX: integer := PositiveModulo(Seed, LakePeriodX);
  var LakeOffsetY: integer := PositiveModulo(Seed, LakePeriodY);
  var LakeGridX: integer := NearestPeriodicIndex(X, LakeOffsetX, LakePeriodX);
  var LakeGridY: integer := NearestPeriodicIndex(Y, LakeOffsetY, LakePeriodY);
  var LakeX: integer := (X + LakeOffsetX) - (LakeGridX * LakePeriodX);
  var LakeY: integer := (Y + LakeOffsetY) - (LakeGridY * LakePeriodY);
  var LakeRadiusX: integer := 42 + (CoordinateHash(Seed, LakeGridX, LakeGridY, 43) mod 25);
  var LakeRadiusY: integer := 26 + (CoordinateHash(Seed, LakeGridX, LakeGridY, 47) mod 17);
  var LakeScore: integer := ((((LakeX * LakeX) * 1000) div (LakeRadiusX * LakeRadiusX)) + (((LakeY * LakeY) * 1000) div (LakeRadiusY * LakeRadiusY))) +
                            ((Sample.LakeShape - 500) div 2);
  if Sample.LandScore < SeaLevel then
  begin
    return WaterCell(WaterKind.Sea, TerrainFeatureKind.NoFeature)
  end;

  if ((LakeScore < 1000) and (Sample.LandScore > SeaLevel + 30)) and (Sample.Elevation < 740) then
  begin
    return WaterCell(WaterKind.Lake, TerrainFeatureKind.NoFeature)
  end;

  if (Sample.Elevation < 800) and (PeriodicDistance(X - RiverOffset, 1024) <= 1) then
  begin
    return WaterCell(WaterKind.RiverWater, TerrainFeatureKind.River)
  end;
  mutable var Cell: WorldCell := PlainCell();
  if (Sample.Ruggedness > MountainRuggedness) and (Sample.Elevation > 520) then
  begin
    Cell.Base := BaseTerrainKind.Rock
  end
  else
  begin
    if Sample.Moisture < 285 then
    begin
      Cell.Base := BaseTerrainKind.Sand
    end
    else
    begin
      if Sample.Vegetation >= 650 then
      begin
        Cell.Feature := TerrainFeatureKind.Forest
      end
      else
      begin
        if ((Sample.Vegetation >= 540) and (Detail > 300)) or
           ((Sample.Moisture >= 450) and (Detail > 960)) then
        begin
          Cell.Feature := TerrainFeatureKind.Tree
        end
      end
    end
  end;

  if (Cell.Base <> BaseTerrainKind.Rock) and (PeriodicDistance(Y - PathOffset, 768) <= 1) then
  begin
    Cell.Feature := TerrainFeatureKind.Path
  end;

  return Cell
end;

function GenerateCellWithShifts(
  Seed: integer;
  X: integer;
  Y: integer;
  RiverOffset: integer;
  PathOffset: integer
): WorldCell;
begin
  return GenerateCellFromInputs(Seed, X, Y, RiverOffset, PathOffset, SampleTerrainAtSeed(Seed, X, Y))
end;

function HasVisibleWoodland(Seed: integer; X: integer; Y: integer): boolean;
begin
  mutable var CandidateY: integer := Y - VisibleSpawnRadiusY;
  while CandidateY <= Y + VisibleSpawnRadiusY do
  begin
    mutable var CandidateX: integer := X - VisibleSpawnRadiusX;
    while CandidateX <= X + VisibleSpawnRadiusX do
    begin
      var Cell: WorldCell := GenerateCellWithShifts(Seed, CandidateX, CandidateY, RiverShift(Seed, CandidateY), PathShift(Seed, CandidateX));
      if (Cell.Feature = TerrainFeatureKind.Tree) or (Cell.Feature = TerrainFeatureKind.Forest) then
      begin
        return true
      end;

      CandidateX := CandidateX + 4
    end;

    CandidateY := CandidateY + 4
  end;

  return false
end;

function HasNearbyLandscapeContrast(Seed: integer; X: integer; Y: integer): boolean;
begin
  mutable var CandidateY: integer := Y - NearbySpawnRadiusY;
  while CandidateY <= Y + NearbySpawnRadiusY do
  begin
    mutable var CandidateX: integer := X - NearbySpawnRadiusX;
    while CandidateX <= X + NearbySpawnRadiusX do
    begin
      var Cell: WorldCell := GenerateCellWithShifts(Seed, CandidateX, CandidateY, RiverShift(Seed, CandidateY), PathShift(Seed, CandidateX));
      if (((Cell.Base = BaseTerrainKind.Sand) or (Cell.Base = BaseTerrainKind.Rock)) or (Cell.Water <> WaterKind.NoWater)) or
         (Cell.Feature = TerrainFeatureKind.Forest) then
      begin
        return true
      end;

      CandidateX := CandidateX + 32
    end;

    CandidateY := CandidateY + 32
  end;

  return false
end;

function EntranceOffset(Index: integer): WorldPosition;
begin
  case Index of
    0:
    begin
      return record
        X := 3;
        Y := 0;
      end
    end;
    1:
    begin
      return record
        X := 2;
        Y := 1;
      end
    end;
    2:
    begin
      return record
        X := 1;
        Y := 2;
      end
    end;
    3:
    begin
      return record
        X := 0;
        Y := 3;
      end
    end;
    4:
    begin
      return record
        X := -1;
        Y := 2;
      end
    end;
    5:
    begin
      return record
        X := -2;
        Y := 1;
      end
    end;
    6:
    begin
      return record
        X := -3;
        Y := 0;
      end
    end;
    7:
    begin
      return record
        X := -2;
        Y := -1;
      end
    end;
    8:
    begin
      return record
        X := -1;
        Y := -2;
      end
    end;
    9:
    begin
      return record
        X := 0;
        Y := -3;
      end
    end;
    10:
    begin
      return record
        X := 1;
        Y := -2;
      end
    end
    else
    begin
      return record
        X := 2;
        Y := -1;
      end
    end
  end
end;

function NaturalCell(Seed: integer; X: integer; Y: integer): WorldCell;
begin
  return GenerateCellWithShifts(Seed, X, Y, RiverShift(Seed, Y), PathShift(Seed, X))
end;

function IsClearEntranceCell(Seed: integer; Position: WorldPosition): boolean;
begin
  var Cell: WorldCell := NaturalCell(Seed, Position.X, Position.Y);
  return (CellIsWalkable(Cell) and (Cell.Feature = TerrainFeatureKind.NoFeature)) and
         (Cell.Water = WaterKind.NoWater)
end;

function HasTraversableCardinalRoute(Seed: integer; Spawn: WorldPosition; Target: WorldPosition): boolean;
begin
  mutable var X: integer := Spawn.X;
  mutable var Y: integer := Spawn.Y;
  while X <> Target.X do
  begin
    if X < Target.X then
    begin
      X := X + 1
    end
    else
    begin
      X := X - 1
    end;

    if not CellIsWalkable(NaturalCell(Seed, X, Y)) then
    begin
      return false
    end
  end;

  while Y <> Target.Y do
  begin
    if Y < Target.Y then
    begin
      Y := Y + 1
    end
    else
    begin
      Y := Y - 1
    end;

    if not CellIsWalkable(NaturalCell(Seed, X, Y)) then
    begin
      return false
    end
  end;

  return true
end;

function FindEntrance(Seed: integer; Spawn: WorldPosition): result of WorldPosition, string;
begin
  var Start: integer := CoordinateHash(Seed, Spawn.X, Spawn.Y, 211) mod 12;
  for Candidate: integer := 0 to 11 do
  begin
    var Offset: WorldPosition := EntranceOffset((Start + Candidate) mod 12);
    var Position: WorldPosition := record
      X := Spawn.X + Offset.X;
      Y := Spawn.Y + Offset.Y;
    end;

    if IsClearEntranceCell(Seed, Position) and HasTraversableCardinalRoute(Seed, Spawn, Position) then
    begin
      return Ok(Position)
    end
  end;

  return Error('unable to place an entrance exactly three traversable steps from spawn')
end;

function IsNaturalSpawnSite(Seed: integer; X: integer; Y: integer): boolean;
begin
  var CenterSample: TerrainGenerationSample := SampleTerrainAtSeed(Seed, X, Y);
  if ((CenterSample.LandScore < 590) or (CenterSample.Ruggedness > 700)) or
     (((CenterSample.Moisture < 300) or (CenterSample.Moisture > 800)) or ((CenterSample.Vegetation < 430) or (CenterSample.Vegetation > 680))) then
  begin
    return false
  end;
  var Center: WorldCell := GenerateCellWithShifts(Seed, X, Y, RiverShift(Seed, Y), PathShift(Seed, X));
  if not CellIsWalkable(Center) or (Center.Feature <> TerrainFeatureKind.NoFeature) then
  begin
    return false
  end;

  for CandidateY: integer := Y - NaturalSpawnRadius to Y + NaturalSpawnRadius do
  begin
    for CandidateX: integer := X - NaturalSpawnRadius to X + NaturalSpawnRadius do
    begin
      if not CellIsWalkable(GenerateCellWithShifts(Seed, CandidateX, CandidateY, RiverShift(Seed, CandidateY), PathShift(Seed, CandidateX))) then
      begin
        return false
      end
    end
  end;
  var Spawn: WorldPosition := record
    X := X;
    Y := Y;
  end;

  return (HasVisibleWoodland(Seed, X, Y) and HasNearbyLandscapeContrast(Seed, X, Y)) and
         IsOk(FindEntrance(Seed, Spawn))
end;

function FindNaturalSpawn(Seed: integer): result of WorldPosition, string;
begin
  for Candidate: integer := 0 to MaximumSpawnCandidates - 1 do
  begin
    var X: integer := (CoordinateHash(Seed, Candidate, 0, 101) - 500) * 32;
    var Y: integer := (CoordinateHash(Seed, Candidate, 0, 103) - 500) * 32;
    if IsNaturalSpawnSite(Seed, X, Y) then
    begin
      return Ok(record
        X := X;
        Y := Y;
      end)
    end
  end;

  return Error('unable to find a natural spawn site with a valid entrance for world seed')
end;

// Creates current metadata with deterministic area identities, spawn, and initial entrance.
public function NewWorldMetadata(Id: string; Seed: integer): result of WorldMetadata, string;
begin
  var Spawn: WorldPosition := try FindNaturalSpawn(Seed);
  var Entrance: WorldPosition := try FindEntrance(Seed, Spawn);
  var OutdoorAreaId: string := Id + ':outdoor';
  var DungeonAreaId: string := Id + ':dungeon:initial';
  return Ok(record
    Id := Id;
    Seed := Seed;
    FormatVersion := WorldFormatVersion;
    GeneratorVersion := WorldGeneratorVersion;
    ChunkSize := WorldChunkSize;
    Spawn := Spawn;
    OutdoorAreaId := OutdoorAreaId;
    OutdoorAreaLabel := 'Outdoor region';
    DungeonAreaId := DungeonAreaId;
    DungeonAreaLabel := 'Initial dungeon';
    EntranceId := Id + ':entrance:initial-dungeon';
    Entrance := Entrance;
    EntranceTargetAreaId := DungeonAreaId;
  end)
end;

// Rejects metadata that does not exactly match the deterministic current-schema world contract.
public function ValidateWorldMetadata(Metadata: WorldMetadata): result of WorldMetadata, string;
begin
  if Metadata.FormatVersion <> WorldFormatVersion then
  begin
    return Error('unsupported world format version')
  end;

  if Metadata.GeneratorVersion <> WorldGeneratorVersion then
  begin
    return Error('unsupported world generator version')
  end;

  if Metadata.ChunkSize <> WorldChunkSize then
  begin
    return Error('world chunk size must be 128')
  end;
  var Expected: WorldMetadata := try NewWorldMetadata(Metadata.Id, Metadata.Seed);
  if (Metadata.Spawn.X <> Expected.Spawn.X) or (Metadata.Spawn.Y <> Expected.Spawn.Y) then
  begin
    return Error('world spawn position is invalid for this generator version')
  end;

  if Metadata.OutdoorAreaId <> Expected.OutdoorAreaId then
  begin
    return Error('outdoor area identity is invalid')
  end;

  if Metadata.DungeonAreaId <> Expected.DungeonAreaId then
  begin
    return Error('dungeon area identity is invalid')
  end;

  if Metadata.OutdoorAreaId = Metadata.DungeonAreaId then
  begin
    return Error('area identities must be unique')
  end;

  if Metadata.OutdoorAreaLabel = '' then
  begin
    return Error('outdoor area label must not be empty')
  end;

  if Metadata.DungeonAreaLabel = '' then
  begin
    return Error('dungeon area label must not be empty')
  end;

  if Metadata.EntranceId <> Expected.EntranceId then
  begin
    return Error('entrance identity is invalid')
  end;

  if (Metadata.EntranceId = Metadata.OutdoorAreaId) or
     (Metadata.EntranceId = Metadata.DungeonAreaId) then
  begin
    return Error('entrance identity must be unique')
  end;

  if Metadata.EntranceTargetAreaId <> Metadata.DungeonAreaId then
  begin
    return Error('entrance target must name the initial dungeon')
  end;

  if (Metadata.Entrance.X <> Expected.Entrance.X) or (Metadata.Entrance.Y <> Expected.Entrance.Y) then
  begin
    return Error('entrance coordinate is invalid for this generator version')
  end;

  if Abs(Metadata.Entrance.X - Metadata.Spawn.X) + Abs(Metadata.Entrance.Y - Metadata.Spawn.Y) <> 3 then
  begin
    return Error('entrance must be exactly three cardinal steps from spawn')
  end;

  if not IsClearEntranceCell(Metadata.Seed, Metadata.Entrance) then
  begin
    return Error('entrance conflicts with generated terrain')
  end;

  if not HasTraversableCardinalRoute(Metadata.Seed, Metadata.Spawn, Metadata.Entrance) then
  begin
    return Error('entrance has no traversable three-step route from spawn')
  end;

  return Ok(Metadata)
end;

// Samples normalized generator fields for previews, diagnostics, and distribution tests.
public function SampleWorldGeneration(Metadata: WorldMetadata; X: integer; Y: integer): TerrainGenerationSample;
begin
  if Metadata.GeneratorVersion <> WorldGeneratorVersion then
  begin
    panic('unsupported world generator version')
  end;

  return SampleTerrainAtSeed(Metadata.Seed, X, Y)
end;

// Generates one cell solely from metadata and absolute coordinates.
public function GenerateWorldCell(Metadata: WorldMetadata; X: integer; Y: integer): WorldCell;
begin
  if Metadata.GeneratorVersion <> WorldGeneratorVersion then
  begin
    panic('unsupported world generator version')
  end;
  mutable var Cell: WorldCell := NaturalCell(Metadata.Seed, X, Y);
  if (X = Metadata.Entrance.X) and (Y = Metadata.Entrance.Y) then
  begin
    Cell.Feature := TerrainFeatureKind.Entrance
  end;

  return Cell
end;

// Generates one complete chunk independently of load or generation order.
public function GenerateChunk(Metadata: WorldMetadata; Coordinate: ChunkCoordinate): WorldChunk;
begin
  mutable var Cells: array of WorldCell := [];
  var OriginX: integer := Coordinate.X * WorldChunkSize;
  var OriginY: integer := Coordinate.Y * WorldChunkSize;
  var ContinentalWideGrid: NoiseGrid := BuildNoiseGrid(Metadata.Seed, OriginX, OriginY, 8192, 11);
  var ContinentalRegionalGrid: NoiseGrid := BuildNoiseGrid(Metadata.Seed, OriginX, OriginY, 4096, 13);
  var RegionalElevationGrid: NoiseGrid := BuildNoiseGrid(Metadata.Seed, OriginX, OriginY, 1024, 17);
  var CoastDetailGrid: NoiseGrid := BuildNoiseGrid(Metadata.Seed, OriginX, OriginY, 256, 19);
  var MoistureRegionalGrid: NoiseGrid := BuildNoiseGrid(Metadata.Seed, OriginX, OriginY, 2048, 23);
  var MoistureDetailGrid: NoiseGrid := BuildNoiseGrid(Metadata.Seed, OriginX, OriginY, 384, 29);
  var VegetationRegionalGrid: NoiseGrid := BuildNoiseGrid(Metadata.Seed, OriginX, OriginY, 512, 31);
  var LakeShapeGrid: NoiseGrid := BuildNoiseGrid(Metadata.Seed, OriginX, OriginY, 48, 41);
  mutable var PathOffsets: array of integer := [];
  for LocalX: integer := 0 to WorldChunkSize - 1 do
  begin
    Std.Arrays.Push(PathOffsets, PathShift(Metadata.Seed, OriginX + LocalX))
  end;

  for LocalY: integer := 0 to WorldChunkSize - 1 do
  begin
    var RowRiverOffset: integer := RiverShift(Metadata.Seed, OriginY + LocalY);
    for LocalX: integer := 0 to WorldChunkSize - 1 do
    begin
      var X: integer := OriginX + LocalX;
      var Y: integer := OriginY + LocalY;
      var Sample: TerrainGenerationSample := ComposeTerrainSample(SampleNoise(ContinentalWideGrid, X, Y), SampleNoise(ContinentalRegionalGrid, X, Y), SampleNoise(RegionalElevationGrid, X, Y), SampleNoise(CoastDetailGrid, X, Y), SampleNoise(MoistureRegionalGrid, X, Y), SampleNoise(MoistureDetailGrid, X, Y), SampleNoise(VegetationRegionalGrid, X, Y), SampleNoise(LakeShapeGrid, X, Y));
      mutable var Cell: WorldCell := GenerateCellFromInputs(Metadata.Seed, X, Y, RowRiverOffset, PathOffsets[LocalX], Sample);
      if (X = Metadata.Entrance.X) and (Y = Metadata.Entrance.Y) then
      begin
        Cell.Feature := TerrainFeatureKind.Entrance
      end;

      Std.Arrays.Push(Cells, Cell)
    end
  end;

  return record
    Coordinate := Coordinate;
    Cells := Cells;
  end
end;

// Returns one cell after validating local coordinates and chunk shape.
public function ChunkCell(Chunk: WorldChunk; LocalX: integer; LocalY: integer): WorldCell;
begin
  if ((LocalX < 0) or (LocalX >= WorldChunkSize)) or ((LocalY < 0) or (LocalY >= WorldChunkSize)) then
  begin
    panic('local coordinate is outside the chunk')
  end;

  if Std.Arrays.Length(Chunk.Cells) <> WorldChunkSize * WorldChunkSize then
  begin
    panic('chunk cell count does not match chunk size')
  end;

  return Chunk.Cells[(LocalY * WorldChunkSize) + LocalX]
end;

// Validates a loaded chunk's shape and terrain-layer invariants.
public function ValidateChunk(Chunk: WorldChunk): result of WorldChunk, string;
begin
  if Std.Arrays.Length(Chunk.Cells) <> WorldChunkSize * WorldChunkSize then
  begin
    return Error('chunk cell count must match 128 by 128 chunk size')
  end;

  for Cell: WorldCell in Chunk.Cells do
  begin
    if Cell.Base = BaseTerrainKind.Water then
    begin
      if Cell.Water = WaterKind.NoWater then
      begin
        return Error('water terrain must have a water classification')
      end
    end
    else
    begin
      if Cell.Water <> WaterKind.NoWater then
      begin
        return Error('non-water terrain must not have a water classification')
      end;

      if Cell.Feature = TerrainFeatureKind.River then
      begin
        return Error('river feature requires water terrain')
      end
    end;

    if ((Cell.Feature = TerrainFeatureKind.Tree) or (Cell.Feature = TerrainFeatureKind.Forest)) or
       ((Cell.Feature = TerrainFeatureKind.Path) or (Cell.Feature = TerrainFeatureKind.Entrance)) then
    begin
      if Cell.Base = BaseTerrainKind.Water then
      begin
        return Error('forest and path features require land terrain')
      end
    end;

    if Cell.Feature = TerrainFeatureKind.River then
    begin
      if Cell.Water <> WaterKind.RiverWater then
      begin
        return Error('river feature requires river water classification')
      end
    end
  end;

  return Ok(Chunk)
end;

// Maps an authoritative cell to one compact client-safe presentation code.
public function VisibleCellCode(Cell: WorldCell): string;
begin
  case Cell.Feature of
    TerrainFeatureKind.Tree:
    begin
      return 't'
    end;
    TerrainFeatureKind.Forest:
    begin
      return 'f'
    end;
    TerrainFeatureKind.Path:
    begin
      return 'p'
    end;
    TerrainFeatureKind.River:
    begin
      return 'r'
    end;
    TerrainFeatureKind.Entrance:
    begin
      return 'e'
    end
    else
    begin
    end
  end;

  case Cell.Water of
    WaterKind.Sea:
    begin
      return 'o'
    end;
    WaterKind.Lake:
    begin
      return 'l'
    end
    else
    begin
    end
  end;

  case Cell.Base of
    BaseTerrainKind.Grass:
    begin
      return 'g'
    end;
    BaseTerrainKind.Sand:
    begin
      return 'd'
    end;
    BaseTerrainKind.Rock:
    begin
      return 'm'
    end
    else
    begin
      return 'o'
    end
  end
end;

// Returns whether the server may place or move a player onto one cell.
public function IsWalkable(Cell: WorldCell): boolean;
begin
  return CellIsWalkable(Cell)
end;

function InteriorCellFromCode(Code: string): result of InteriorCellKind, string;
begin
  case Code of
    '#':
    begin
      return Ok(InteriorCellKind.Wall)
    end;
    '.':
    begin
      return Ok(InteriorCellKind.Floor)
    end;
    'x':
    begin
      return Ok(InteriorCellKind.ExitField)
    end
    else
    begin
      return Error('interior row contains an unknown field code')
    end
  end
end;

// Returns the compact client-safe code for one interior field.
public function InteriorCellCode(Cell: InteriorCellKind): string;
begin
  case Cell of
    InteriorCellKind.Wall:
    begin
      return '#'
    end;
    InteriorCellKind.Floor:
    begin
      return '.'
    end;
    InteriorCellKind.ExitField:
    begin
      return 'x'
    end
  end
end;

// Returns one interior field after checking bounded area-local coordinates and map shape.
public function InteriorCellAt(Map: InteriorMap; Position: InteriorPosition): result of InteriorCellKind, string;
begin
  if (Map.Width <= 0) or (Map.Height <= 0) then
  begin
    return Error('interior dimensions must be positive')
  end;

  if Std.Arrays.Length(Map.Cells) <> Map.Width * Map.Height then
  begin
    return Error('interior field count must match its dimensions')
  end;

  if ((Position.X < 0) or (Position.X >= Map.Width)) or
     ((Position.Y < 0) or (Position.Y >= Map.Height)) then
  begin
    return Error('interior position is outside the area')
  end;

  return Ok(Map.Cells[(Position.Y * Map.Width) + Position.X])
end;

// Returns the client-safe visible code for geometry or the fixed stone tablet overlay.
public function InteriorVisibleCode(Map: InteriorMap; Position: InteriorPosition): result of string, string;
begin
  var Cell: InteriorCellKind := try InteriorCellAt(Map, Position);
  if (Position.X = Map.Tablet.X) and (Position.Y = Map.Tablet.Y) then
  begin
    return Ok('t')
  end;

  return Ok(InteriorCellCode(Cell))
end;

// Validates bounded shape, unique exit, traversable endpoints, and connected floor space.
public function ValidateInteriorMap(Map: InteriorMap): result of InteriorMap, string;
begin
  if (Map.Width <= 0) or (Map.Height <= 0) then
  begin
    return Error('interior dimensions must be positive')
  end;

  if Std.Arrays.Length(Map.Cells) <> Map.Width * Map.Height then
  begin
    return Error('interior field count must match its dimensions')
  end;
  var StartCell: InteriorCellKind := try InteriorCellAt(Map, Map.Start);
  if StartCell <> InteriorCellKind.Floor then
  begin
    return Error('interior start must be a floor field')
  end;
  var ExitCell: InteriorCellKind := try InteriorCellAt(Map, Map.Exit);
  if ExitCell <> InteriorCellKind.ExitField then
  begin
    return Error('interior exit coordinate must name the exit field')
  end;
  var TabletCell: InteriorCellKind := try InteriorCellAt(Map, Map.Tablet);
  if TabletCell <> InteriorCellKind.Wall then
  begin
    return Error('interior tablet coordinate must name a wall field')
  end;
  var ItemCell: InteriorCellKind := try InteriorCellAt(Map, Map.Item);
  if ItemCell <> InteriorCellKind.Floor then
  begin
    return Error('interior item coordinate must name a floor field')
  end;

  if ((Map.Item.X = Map.Start.X) and (Map.Item.Y = Map.Start.Y)) or
     ((Map.Item.X = Map.Exit.X) and (Map.Item.Y = Map.Exit.Y)) then
  begin
    return Error('interior item coordinate must differ from start and exit')
  end;
  mutable var ExitCount: integer := 0;
  mutable var TraversableCount: integer := 0;
  for Cell: InteriorCellKind in Map.Cells do
  begin
    if Cell <> InteriorCellKind.Wall then
    begin
      TraversableCount := TraversableCount + 1
    end;

    if Cell = InteriorCellKind.ExitField then
    begin
      ExitCount := ExitCount + 1
    end
  end;

  if ExitCount <> 1 then
  begin
    return Error('interior must contain exactly one exit field')
  end;
  mutable var Visited: array of boolean := Std.Arrays.Fill(false, Map.Width * Map.Height);
  mutable var Queue: array of InteriorPosition := [Map.Start];
  Visited[(Map.Start.Y * Map.Width) + Map.Start.X] := true;
  mutable var ReadIndex: integer := 0;
  mutable var VisitedCount: integer := 0;
  var Offsets: array of InteriorPosition := [
                                              record
                                                X := 0;
                                                Y := -1;
                                              end,
                                              record
                                                X := 1;
                                                Y := 0;
                                              end,
                                              record
                                                X := 0;
                                                Y := 1;
                                              end,
                                              record
                                                X := -1;
                                                Y := 0;
                                              end
                                            ];
  while ReadIndex < Std.Arrays.Length(Queue) do
  begin
    var Current: InteriorPosition := Queue[ReadIndex];
    ReadIndex := ReadIndex + 1;
    VisitedCount := VisitedCount + 1;
    for Offset: InteriorPosition in Offsets do
    begin
      var Candidate: InteriorPosition := record
        X := Current.X + Offset.X;
        Y := Current.Y + Offset.Y;
      end;

      if ((Candidate.X >= 0) and (Candidate.X < Map.Width)) and
         ((Candidate.Y >= 0) and (Candidate.Y < Map.Height)) then
      begin
        var CandidateIndex: integer := (Candidate.Y * Map.Width) + Candidate.X;
        if not Visited[CandidateIndex] then
        begin
          if Map.Cells[CandidateIndex] <> InteriorCellKind.Wall then
          begin
            Visited[CandidateIndex] := true;
            Std.Arrays.Push(Queue, Candidate)
          end
        end
      end
    end
  end;

  if VisitedCount <> TraversableCount then
  begin
    return Error('all traversable interior fields must be connected to the start')
  end;

  return Ok(Map)
end;

function InitialDungeonItemPosition(): InteriorPosition;
begin
  return record
    X := 8;
    Y := 1;
  end
end;

// Creates the fixed, hand-authored initial dungeon used by the first interior slice.
public function InitialDungeonMap(): result of InteriorMap, string;
begin
  var Rows: array of string := [
                                 '###########',
                                 '#.........#',
                                 '#.#####.#.#',
                                 '#.....#.#.#',
                                 '###.#.#.#.#',
                                 '#...#...#.#',
                                 '#.#####.#.#',
                                 '#x........#',
                                 '###########'
                               ];
  mutable var Cells: array of InteriorCellKind := [];
  for Row: string in Rows do
  begin
    for X: integer := 0 to Std.Str.Length(Row) - 1 do
    begin
      Std.Arrays.Push(Cells, try InteriorCellFromCode(Std.Str.CharAt(Row, X)))
    end
  end;

  return ValidateInteriorMap(record
    Width := 11;
    Height := 9;
    Cells := Cells;
    Start := record
      X := 9;
      Y := 1;
    end;
    StartFacing := FacingDirection.West;
    Exit := record
      X := 1;
      Y := 7;
    end;
    Tablet := record
      X := 9;
      Y := 0;
    end;
    Item := InitialDungeonItemPosition();
  end)
end;

function InitialDungeonItem(Metadata: WorldMetadata): GameItem;
begin
  return record
    Id := InitialDungeonItemId;
    Kind := ItemKind.AncientCoin;
    Location := ItemLocation.InInterior(Metadata.DungeonAreaId, InitialDungeonItemPosition());
  end
end;

// Returns the player-facing name of one authoritative item kind.
public function ItemDisplayName(Kind: ItemKind): string;
begin
  case Kind of
    ItemKind.AncientCoin:
    begin
      return InitialDungeonItemName
    end
  end
end;

// Returns the inspectable description of one authoritative item kind.
public function ItemDescription(Kind: ItemKind): string;
begin
  case Kind of
    ItemKind.AncientCoin:
    begin
      return InitialDungeonItemDescription
    end
  end
end;

// Returns carried items in stable game-state order without exposing placement rules.
public function InventoryItems(State: GameState): array of GameItem;
begin
  mutable var Items: array of GameItem := [];
  for Item: GameItem in State.Items do
  begin
    case Item.Location of
      ItemLocation.CarriedByPlayer:
      begin
        Std.Arrays.Push(Items, Item)
      end
      else
      begin
      end
    end
  end;

  return Items
end;

// Overlays a present item on static interior geometry for client-safe projection.
public function InteriorVisibleCodeForState(
  Map: InteriorMap;
  State: GameState;
  Position: InteriorPosition
): result of string, string;
begin
  for Item: GameItem in State.Items do
  begin
    case Item.Location of
      ItemLocation.InInterior(AreaId, ItemPosition):
      begin
        if (AreaId = State.AreaId) and
           ((ItemPosition.X = Position.X) and (ItemPosition.Y = Position.Y)) then
        begin
          return Ok('i')
        end
      end
      else
      begin
      end
    end
  end;

  return InteriorVisibleCode(Map, Position)
end;

// Returns the outdoor coordinate only when the player currently occupies an outdoor area.
public function OutdoorPlayerPosition(State: GameState): result of WorldPosition, string;
begin
  case State.Player of
    PlayerPosition.Outdoor(Value):
    begin
      return Ok(Value)
    end
    else
    begin
      return Error('player does not occupy an outdoor position')
    end
  end
end;

// Returns the interior pose only when the player currently occupies a first-person area.
public function FirstPersonPlayerPose(State: GameState): result of FirstPersonPose, string;
begin
  case State.Player of
    PlayerPosition.FirstPerson(Value):
    begin
      return Ok(Value)
    end
    else
    begin
      return Error('player does not occupy a first-person position')
    end
  end
end;

// Creates the initial player state at the metadata-defined spawn coordinate.
public function NewGame(Metadata: WorldMetadata): GameState;
begin
  return record
    Area := AreaKind.OutdoorRegion;
    AreaId := Metadata.OutdoorAreaId;
    Player := PlayerPosition.Outdoor(Metadata.Spawn);
    ReturnLocation := ReturnLocation.NoReturnLocation;
    Exploration := EmptyExploration();
    Items := [InitialDungeonItem(Metadata)];
  end
end;

function ValidateItems(
  Metadata: WorldMetadata;
  Map: InteriorMap;
  Items: array of GameItem
): result of array of GameItem, string;
begin
  if Std.Arrays.Length(Items) <> 1 then
  begin
    return Error('game state must contain exactly the initial dungeon item')
  end;
  var Item: GameItem := Items[0];
  if Item.Id <> InitialDungeonItemId then
  begin
    return Error('game state contains an unknown item identity')
  end;

  if Item.Kind <> ItemKind.AncientCoin then
  begin
    return Error('game state item identity and kind do not match')
  end;

  case Item.Location of
    ItemLocation.InInterior(AreaId, Position):
    begin
      if AreaId <> Metadata.DungeonAreaId then
      begin
        return Error('initial dungeon item names an unknown area')
      end;

      if (Position.X <> Map.Item.X) or (Position.Y <> Map.Item.Y) then
      begin
        return Error('initial dungeon item is outside its authoritative placement')
      end;

      if try InteriorCellAt(Map, Position) <> InteriorCellKind.Floor then
      begin
        return Error('initial dungeon item must occupy a floor field')
      end
    end;
    ItemLocation.CarriedByPlayer:
    begin
    end
  end;

  return Ok(Items)
end;

// Validates current-area and return-location invariants for the selected world.
public function ValidateGameState(Metadata: WorldMetadata; State: GameState): result of GameState, string;
begin
  var ValidExploration: ExplorationState := try ValidateExploration(State.Exploration, WorldChunkSize);
  var DungeonMap: InteriorMap := try InitialDungeonMap();
  var ValidItems: array of GameItem := try ValidateItems(Metadata, DungeonMap, State.Items);
  for Area: InteriorDiscoveryArea in ValidExploration.InteriorAreas do
  begin
    if Area.AreaId <> Metadata.DungeonAreaId then
    begin
      return Error('game state contains discovery for an unknown interior area')
    end;

    if (Area.Width <> DungeonMap.Width) or (Area.Height <> DungeonMap.Height) then
    begin
      return Error('interior discovery dimensions do not match the authoritative area')
    end
  end;

  if State.AreaId = Metadata.OutdoorAreaId then
  begin
    if State.Area <> AreaKind.OutdoorRegion then
    begin
      return Error('outdoor area identity requires outdoor area kind')
    end;

    case State.Player of
      PlayerPosition.Outdoor(OutdoorPosition):
      begin
        case State.ReturnLocation of
          ReturnLocation.NoReturnLocation:
          begin
            return Ok(State)
          end
          else
          begin
            return Error('outdoor state must not retain a return location')
          end
        end
      end
      else
      begin
        return Error('outdoor area requires an outdoor player position')
      end
    end
  end;

  if State.AreaId = Metadata.DungeonAreaId then
  begin
    if State.Area <> AreaKind.Dungeon then
    begin
      return Error('dungeon area identity requires dungeon area kind')
    end;

    case State.Player of
      PlayerPosition.FirstPerson(Pose):
      begin
        var Map: InteriorMap := try InitialDungeonMap();
        if try InteriorCellAt(Map, Pose.Position) = InteriorCellKind.Wall then
        begin
          return Error('first-person player position must be traversable')
        end;

        case State.ReturnLocation of
          ReturnLocation.ReturnTo(AreaId, Position):
          begin
            if AreaId <> Metadata.OutdoorAreaId then
            begin
              return Error('dungeon return location must name the outdoor area')
            end;

            if (Position.X <> Metadata.Entrance.X) or (Position.Y <> Metadata.Entrance.Y) then
            begin
              return Error('dungeon return location must name the exact outdoor entrance')
            end;

            return Ok(State)
          end
          else
          begin
            return Error('dungeon state requires a return location')
          end
        end
      end
      else
      begin
        return Error('dungeon area requires a first-person player position')
      end
    end
  end;

  return Error('game state names an unknown area identity')
end;

// Activates the single entrance or exit transition owned by the selected world.
public function ActivateAreaTransition(Metadata: WorldMetadata; State: GameState): result of GameState, string;
begin
  var Valid: GameState := try ValidateGameState(Metadata, State);
  if Valid.AreaId = Metadata.OutdoorAreaId then
  begin
    var OutdoorPosition: WorldPosition := try OutdoorPlayerPosition(Valid);
    if (OutdoorPosition.X <> Metadata.Entrance.X) or (OutdoorPosition.Y <> Metadata.Entrance.Y) then
    begin
      return Error('player is not standing on an entrance')
    end;

    if Metadata.EntranceTargetAreaId <> Metadata.DungeonAreaId then
    begin
      return Error('entrance target does not name the initial dungeon')
    end;
    var Map: InteriorMap := try InitialDungeonMap();
    return Ok(record
      Area := AreaKind.Dungeon;
      AreaId := Metadata.DungeonAreaId;
      Player := PlayerPosition.FirstPerson(record
      Position := Map.Start;
      Facing := Map.StartFacing;
    end);
      ReturnLocation := ReturnLocation.ReturnTo(Metadata.OutdoorAreaId, OutdoorPosition);
      Exploration := Valid.Exploration;
      Items := Valid.Items;
    end)
  end;
  var Pose: FirstPersonPose := try FirstPersonPlayerPose(Valid);
  var Interior: InteriorMap := try InitialDungeonMap();
  if (Pose.Position.X <> Interior.Exit.X) or (Pose.Position.Y <> Interior.Exit.Y) then
  begin
    return Error('player is not standing on the interior exit')
  end;

  case Valid.ReturnLocation of
    ReturnLocation.ReturnTo(AreaId, Position):
    begin
      return Ok(record
        Area := AreaKind.OutdoorRegion;
        AreaId := AreaId;
        Player := PlayerPosition.Outdoor(Position);
        ReturnLocation := ReturnLocation.NoReturnLocation;
        Exploration := Valid.Exploration;
        Items := Valid.Items;
      end)
    end
    else
    begin
      return Error('cannot leave an entered area without a return location')
    end
  end
end;

// Applies one cardinal movement intention after validating the authoritative target cell.
public function MovePlayer(State: GameState; DeltaX: integer; DeltaY: integer; Target: WorldCell): result of GameState, string;
begin
  if State.Area <> AreaKind.OutdoorRegion then
  begin
    return Error('movement is unavailable in the current area')
  end;

  if not (((DeltaX = 0) and ((DeltaY = -1) or (DeltaY = 1))) or ((DeltaY = 0) and ((DeltaX = -1) or (DeltaX = 1)))) then
  begin
    return Error('movement must be one cardinal step')
  end;

  if not IsWalkable(Target) then
  begin
    return Error('terrain is not traversable')
  end;
  var Position: WorldPosition := try OutdoorPlayerPosition(State);
  return Ok(record
    Area := State.Area;
    AreaId := State.AreaId;
    Player := PlayerPosition.Outdoor(record
    X := Position.X + DeltaX;
    Y := Position.Y + DeltaY;
  end);
    ReturnLocation := State.ReturnLocation;
    Exploration := State.Exploration;
    Items := State.Items;
  end)
end;

function StepOffset(Facing: FacingDirection; Step: RelativeStep): InteriorPosition;
begin
  mutable var ForwardX: integer := 0;
  mutable var ForwardY: integer := -1;
  case Facing of
    FacingDirection.North:
    begin
      ForwardX := 0;
      ForwardY := -1
    end;
    FacingDirection.East:
    begin
      ForwardX := 1;
      ForwardY := 0
    end;
    FacingDirection.South:
    begin
      ForwardX := 0;
      ForwardY := 1
    end;
    FacingDirection.West:
    begin
      ForwardX := -1;
      ForwardY := 0
    end
  end;

  case Step of
    RelativeStep.Forward:
    begin
      return record
        X := ForwardX;
        Y := ForwardY;
      end
    end;
    RelativeStep.Backward:
    begin
      return record
        X := - ForwardX;
        Y := - ForwardY;
      end
    end;
    RelativeStep.Left:
    begin
      return record
        X := ForwardY;
        Y := - ForwardX;
      end
    end;
    RelativeStep.Right:
    begin
      return record
        X := - ForwardY;
        Y := ForwardX;
      end
    end
  end
end;

// Describes the available item action for a validated interior state; empty means no item target.
public function ItemInteractionHint(State: GameState): string;
begin
  case State.Player of
    PlayerPosition.FirstPerson(Pose):
    begin
      var Offset: InteriorPosition := StepOffset(Pose.Facing, RelativeStep.Forward);
      for Item: GameItem in State.Items do
      begin
        case Item.Location of
          ItemLocation.InInterior(AreaId, Position):
          begin
            if AreaId = State.AreaId then
            begin
              if (Position.X = Pose.Position.X) and (Position.Y = Pose.Position.Y) then
              begin
                return 'At your feet: ' + ItemDisplayName(Item.Kind) + ' — Enter: Pick up'
              end;
              if (Position.X = Pose.Position.X + Offset.X) and (Position.Y = Pose.Position.Y + Offset.Y) then
              begin
                return ItemDisplayName(Item.Kind) + ' — Enter: Examine'
              end
            end
          end
          else
          begin
          end
        end
      end
    end
    else
    begin
    end
  end;
  return ''
end;

// Resolves current-field transitions or pickup, then inspection ahead, without implicit movement.
public function Interact(Metadata: WorldMetadata; State: GameState): result of InteractionOutcome, string;
begin
  var Valid: GameState := try ValidateGameState(Metadata, State);
  if Valid.Area = AreaKind.OutdoorRegion then
  begin
    var OutdoorPosition: WorldPosition := try OutdoorPlayerPosition(Valid);
    if (OutdoorPosition.X = Metadata.Entrance.X) and (OutdoorPosition.Y = Metadata.Entrance.Y) then
    begin
      return Ok(InteractionOutcome.Transitioned(try ActivateAreaTransition(Metadata, Valid)))
    end;

    return Ok(InteractionOutcome.Described('', NoInteractionMessage))
  end;
  var Map: InteriorMap := try InitialDungeonMap();
  var Pose: FirstPersonPose := try FirstPersonPlayerPose(Valid);
  if (Pose.Position.X = Map.Exit.X) and (Pose.Position.Y = Map.Exit.Y) then
  begin
    return Ok(InteractionOutcome.Transitioned(try ActivateAreaTransition(Metadata, Valid)))
  end;
  for Index: integer := 0 to Std.Arrays.Length(Valid.Items) - 1 do
  begin
    mutable var Item: GameItem := Valid.Items[Index];
    case Item.Location of
      ItemLocation.InInterior(AreaId, ItemPosition):
      begin
        if (AreaId = Valid.AreaId) and
           ((ItemPosition.X = Pose.Position.X) and (ItemPosition.Y = Pose.Position.Y)) then
        begin
          mutable var Changed: GameState := Valid;
          Item.Location := ItemLocation.CarriedByPlayer;
          Changed.Items[Index] := Item;
          return Ok(InteractionOutcome.StateChanged(try ValidateGameState(Metadata, Changed)))
        end
      end
      else
      begin
      end
    end
  end;
  var Offset: InteriorPosition := StepOffset(Pose.Facing, RelativeStep.Forward);
  var Target: InteriorPosition := record
    X := Pose.Position.X + Offset.X;
    Y := Pose.Position.Y + Offset.Y;
  end;

  if (Target.X = Map.Tablet.X) and (Target.Y = Map.Tablet.Y) then
  begin
    return Ok(InteractionOutcome.Described('Stone tablet', StoneTabletDescription))
  end;
  for Item: GameItem in Valid.Items do
  begin
    case Item.Location of
      ItemLocation.InInterior(AreaId, ItemPosition):
      begin
        if (AreaId = Valid.AreaId) and
           ((ItemPosition.X = Target.X) and (ItemPosition.Y = Target.Y)) then
        begin
          return Ok(InteractionOutcome.Described(ItemDisplayName(Item.Kind), ItemDescription(Item.Kind)))
        end
      end
      else
      begin
      end
    end
  end;

  return Ok(InteractionOutcome.Described('', NoInteractionMessage))
end;

// Applies one relative first-person step against the fixed authoritative interior map.
public function StepFirstPerson(Metadata: WorldMetadata; State: GameState; Step: RelativeStep): result of GameState, string;
begin
  var Valid: GameState := try ValidateGameState(Metadata, State);
  if Valid.Area <> AreaKind.Dungeon then
  begin
    return Error('first-person movement is unavailable in the current area')
  end;
  var Pose: FirstPersonPose := try FirstPersonPlayerPose(Valid);
  var Offset: InteriorPosition := StepOffset(Pose.Facing, Step);
  var Target: InteriorPosition := record
    X := Pose.Position.X + Offset.X;
    Y := Pose.Position.Y + Offset.Y;
  end;
  var Map: InteriorMap := try InitialDungeonMap();
  if try InteriorCellAt(Map, Target) = InteriorCellKind.Wall then
  begin
    return Error('a wall blocks the way')
  end;

  return Ok(record
    Area := Valid.Area;
    AreaId := Valid.AreaId;
    Player := PlayerPosition.FirstPerson(record
    Position := Target;
    Facing := Pose.Facing;
  end);
    ReturnLocation := Valid.ReturnLocation;
    Exploration := Valid.Exploration;
    Items := Valid.Items;
  end)
end;

function TurnedFacing(Facing: FacingDirection; Turn: RelativeTurn): FacingDirection;
begin
  case Turn of
    RelativeTurn.TurnLeft:
    begin
      case Facing of
        FacingDirection.North:
        begin
          return FacingDirection.West
        end;
        FacingDirection.East:
        begin
          return FacingDirection.North
        end;
        FacingDirection.South:
        begin
          return FacingDirection.East
        end;
        FacingDirection.West:
        begin
          return FacingDirection.South
        end
      end
    end;
    RelativeTurn.TurnRight:
    begin
      case Facing of
        FacingDirection.North:
        begin
          return FacingDirection.East
        end;
        FacingDirection.East:
        begin
          return FacingDirection.South
        end;
        FacingDirection.South:
        begin
          return FacingDirection.West
        end;
        FacingDirection.West:
        begin
          return FacingDirection.North
        end
      end
    end
  end
end;

// Applies one relative 90-degree turn without changing the occupied interior field.
public function TurnFirstPerson(Metadata: WorldMetadata; State: GameState; Turn: RelativeTurn): result of GameState, string;
begin
  var Valid: GameState := try ValidateGameState(Metadata, State);
  if Valid.Area <> AreaKind.Dungeon then
  begin
    return Error('first-person turning is unavailable in the current area')
  end;
  var Pose: FirstPersonPose := try FirstPersonPlayerPose(Valid);
  return Ok(record
    Area := Valid.Area;
    AreaId := Valid.AreaId;
    Player := PlayerPosition.FirstPerson(record
    Position := Pose.Position;
    Facing := TurnedFacing(Pose.Facing, Turn);
  end);
    ReturnLocation := Valid.ReturnLocation;
    Exploration := Valid.Exploration;
    Items := Valid.Items;
  end)
end;
