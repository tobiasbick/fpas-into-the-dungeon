// Authoritative rules for the initial game slice.
unit Dungeon.Game;

public const
  MapWidth: integer := 9;
  MapHeight: integer := 5;

public type
  GameState = record
    public PlayerX: integer;
    public PlayerY: integer;
  end;

// Creates the initial player position at the center of the map.
public function NewGame(): GameState;
begin
  return record
    PlayerX := MapWidth div 2;
    PlayerY := MapHeight div 2;
  end
end;

// Applies one cardinal movement intention inside the map.
public function MovePlayer(State: GameState; DeltaX: integer; DeltaY: integer): result of GameState, string;
begin
  if not (((DeltaX = 0) and ((DeltaY = -1) or (DeltaY = 1))) or ((DeltaY = 0) and ((DeltaX = -1) or (DeltaX = 1)))) then
  begin
    return Error('movement must be one cardinal step')
  end;
  var NextX: integer := State.PlayerX + DeltaX;
  var NextY: integer := State.PlayerY + DeltaY;
  if (((NextX < 0) or (NextX >= MapWidth)) or (NextY < 0)) or (NextY >= MapHeight) then
  begin
    return Error('movement leaves the map')
  end;

  return Ok(record
    PlayerX := NextX;
    PlayerY := NextY;
  end)
end;
