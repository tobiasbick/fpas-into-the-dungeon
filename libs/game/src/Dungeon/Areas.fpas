// Pure area views, first-visit materialization, and full placement validation.
unit Dungeon.Areas;

uses
  Dungeon.Areas.Validation, Dungeon.Coordinates, Dungeon.Exploration.Model, Dungeon.GameState,
  Dungeon.Hostiles, Dungeon.Interior, Dungeon.Items, Dungeon.Terrain, Std.Arrays;

// Requires no map outdoors and a matching validated map in a dungeon.
// Returns the supplied geometry unchanged; performs no loading or generation.
public function AreaViewFor(Metadata: WorldMetadata; State: GameState; Map: option of InteriorMap): result of AreaView, string;
begin
  if State.Area = AreaKind.OutdoorRegion then
    begin
      if State.AreaId <> Metadata.OutdoorAreaId then
        begin
          return Error('outdoor area identity does not match the selected world');
        end;
      end if;

      case Map of
        when Some(Value):
          begin
            return Error('outdoor area view must not contain an interior map');
          end;
        when None:
          begin
            return Ok(record
              Metadata := Metadata;
              Interior := None;
            end);
          end;
      end case;
    end;
  end if;

  if State.Area = AreaKind.Dungeon then
    begin
      case Map of
        when Some(Value):
          begin
            if (State.AreaId = '') or (Value.AreaId <> State.AreaId) then
              begin
                return Error('interior map identity does not match the current area');
              end;
            end if;

            return Ok(record
              Metadata := Metadata;
              Interior := Some(Value);
            end);
          end;
        when None:
          begin
            return Error('dungeon area view requires the current interior map');
          end;
      end case;
    end;
  end if;

  return Error('area view is unavailable for the current area kind');
end function;

// Adds validated placements once per game, preserving all mutable state on revisits.
// State and Map must be valid; the caller validates the resulting transition before installation.
public function MaterializeArea(State: GameState; Map: InteriorMap): GameState;
begin
  if HasVisitedArea(State, Map.AreaId) then
    begin
      return State;
    end;
  end if;
  mutable var Visited: array of string := State.VisitedAreas;
  mutable var Items: array of GameItem := State.Items;
  mutable var Hostiles: array of GameHostile := State.Hostiles;
  Std.Arrays.Push(Visited, Map.AreaId);
  for Index: integer := Std.Arrays.Length(Visited) - 1 downto 1 do
    begin
      if StringComesBefore(Visited[Index], Visited[Index - 1]) then
        begin
          var Previous: string := Visited[Index - 1];
          Visited[Index - 1] := Visited[Index];
          Visited[Index] := Previous;
        end;
      end if;
    end;
  end for;

  for Placement: ItemPlacement in Map.Items do
    begin
      Std.Arrays.Push(Items, record
        Id := Placement.ItemId;
        Kind := Placement.Kind;
        Location := ItemLocation.InInterior(Map.AreaId, Placement.Position);
      end);
    end;
  end for;

  for Placement: HostilePlacement in Map.Hostiles do
    begin
      Std.Arrays.Push(Hostiles, record
        Id := Placement.Id;
        Kind := Placement.Kind;
        AreaId := Map.AreaId;
        Position := Placement.Position;
        Health := HostileMaximumHealth(Placement.Kind);
        Alerted := false;
      end);
    end;
  end for;

  return State with VisitedAreas := Visited; Items := Items; Hostiles := Hostiles; end with;
end function;

// Validates one supplied map per visited area and all entity origins and destinations.
// Does not load or generate geometry; the current view reuses its supplied map.
public function ValidateSavedGame(Metadata: WorldMetadata; State: GameState; Maps: array of InteriorMap): result of GameState, string;
begin
  return Dungeon.Areas.Validation.ValidateSavedAreas(Metadata, State, Maps);
end function;

// Checks a decoded save without any map: state shape and canonical area and placement identities.
// This is only the first phase of loading; ValidateSavedGame performs the full check.
public function ValidateSaveShape(Metadata: WorldMetadata; State: GameState): result of GameState, string;
begin
  return Dungeon.Areas.Validation.ValidateSaveShape(Metadata, State);
end function;
end unit;
