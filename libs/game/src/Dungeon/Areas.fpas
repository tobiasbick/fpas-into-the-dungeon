// Pure area views, first-visit materialization, and full placement validation.
unit Dungeon.Areas;

uses Dungeon.Npcs as NpcRules, Dungeon.Settlements.Validation as SettlementValidation, Dungeon.Settlements as Settlements, Dungeon.Areas.Validation as Validation, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Hostiles as HostileRules, Dungeon.Interior as InteriorUnit, Dungeon.Items as ItemRules, Dungeon.Terrain as Terrain;

// Constructs a checked view from retained geometry. Only authored home geometry may be resolved from code.
// Generated settlement/dungeon definitions must already be supplied by their world-layer owner.
public function AreaViewFor(Metadata: Terrain.WorldMetadata; State: GameState.GameState; Map: option of InteriorUnit.InteriorMap): result of (GameState.AreaView, string);
begin
  if State.Area = Coordinates.AreaKind.OutdoorRegion then
    if State.AreaId <> Metadata.OutdoorAreaId then
      return Error('outdoor area identity does not match the selected world');
    end if;

    if Map is Some(_) then
      return Error('outdoor area view must not contain an interior map');
    end if;

    return Ok(GameState.AreaView(Metadata := Metadata, Interior := None));
  end if;

  case Map of
    when Some(const Supplied):
      if Supplied.AreaId <> State.AreaId then
        return Error('interior map identity does not match the current area');
      end if;

      if State.Area = Coordinates.AreaKind.Settlement then
        const Valid := try SettlementValidation.ValidateMap(Metadata, Supplied);
      else
        if State.Area <> Coordinates.AreaKind.Dungeon then
          return Error('area view is unavailable for the current area kind');
        end if;
        const Valid := try InteriorUnit.ValidateInteriorMap(Supplied);
      end if;

      return Ok(GameState.AreaView(Metadata := Metadata, Interior := Some(Supplied)));
    when None:
      if (State.Area = Coordinates.AreaKind.Settlement)
        and
        (State.AreaId = Settlements.HomeAreaId(Metadata))
      then
        return Ok(
          GameState.AreaView(Metadata := Metadata, Interior := Some(Settlements.HomeMap(Metadata)))
        );
      end if;

      return Error('finite area view requires its retained immutable definition');
  end case;
end function;

// Adds validated placements once per game, preserving all mutable state on revisits.
// State and Map must be valid; the caller validates the resulting transition before installation.
public function MaterializeArea(State: GameState.GameState; Map: InteriorUnit.InteriorMap): GameState.GameState;
begin
  if GameState.HasVisitedArea(State, Map.AreaId) then
    begin
      return State;
    end;
  end if;
  const Visited := State.VisitedAreas.Push(Map.AreaId).Sort();
  var Items: array of ItemRules.GameItem := State.Items;
  var Hostiles: array of HostileRules.GameHostile := State.Hostiles;
  for Placement: ItemRules.ItemPlacement in Map.Items do
    begin
      Items.PushInPlace(
        ItemRules.GameItem(
          Id := Placement.ItemId,
          Kind := Placement.Kind,
          Location := ItemRules.ItemLocation.InInterior(Map.AreaId, Placement.Position)
        )
      );
    end;
  end for;

  for Placement: HostileRules.HostilePlacement in Map.Hostiles do
    begin
      Hostiles.PushInPlace(
        HostileRules.GameHostile(
          Id := Placement.Id,
          Kind := Placement.Kind,
          AreaId := Map.AreaId,
          Position := Placement.Position,
          Health := HostileRules.HostileMaximumHealth(Placement.Kind),
          Alerted := false
        )
      );
    end;
  end for;
  var NpcValues := State.Npcs;
  for Placement: NpcRules.NpcPlacement in Map.Npcs do
    if NpcRules.IndexOf(NpcValues, Placement.Id) < 0 then
      NpcValues.PushInPlace(
        NpcRules.GameNpc(
          Id := Placement.Id, Kind := Placement.Kind,
          AreaId := Map.AreaId, HasMetPlayer := false
        )
      );
    end if;
  end for;

  NpcValues.SortByInPlace(
    function(Value: NpcRules.GameNpc): string begin
      return Value.Id;
    end function
  );

  return State with VisitedAreas := Visited; Items := Items; Hostiles := Hostiles; Npcs := NpcValues; end with;
end function;

// Validates one supplied map per visited area and all entity origins and destinations.
// Does not load or generate geometry; the current view reuses its supplied map.
public function ValidateSavedGame(Metadata: Terrain.WorldMetadata; State: GameState.GameState; Maps: array of InteriorUnit.InteriorMap): result of (GameState.GameState, string);
begin
  return Validation.ValidateSavedAreas(Metadata, State, Maps);
end function;

// Checks a decoded save without any map: state shape and canonical area and placement identities.
// This is only the first phase of loading; ValidateSavedGame performs the full check.
public function ValidateSaveShape(Metadata: Terrain.WorldMetadata; State: GameState.GameState): result of (GameState.GameState, string);
begin
  return Validation.ValidateSaveShape(Metadata, State);
end function;
end unit;
