// Server-formatted journal text for the authored quest; no hidden map positions enter the projection.
unit Dungeon.Quests.Journal;

uses Dungeon.GameState as GameState, Dungeon.Quests as Quests, Dungeon.Quests.Model as Model;

// Bounded English lines for the current phase; readiness follows carried ownership, never a client counter.
public function Lines(State: GameState.GameState): array of string;
begin
  case State.Quest of
    when Model.QuestState.NotAccepted:
      return ['No accepted quests.'];
    when Model.QuestState.Active(_):
      if Quests.ReadyToReturn(State) then
        return [
          'Mara''s lost compass', 'Status: Ready to return',
          'Progress: Compass carried.', 'Return to Mara in Hearthmoor to hand it in.',
          'Reward: Two Healing potions.'
        ];
      end if;

      return [
        'Mara''s lost compass', 'Status: Active',
        'Goal: Recover Mara''s compass from the deepest level of the dungeon near the spawn.',
        'Progress: Compass not carried.', 'Return to Mara in Hearthmoor.',
        'Reward: Two Healing potions.'
      ];
    when Model.QuestState.Rewarded(_):
      return [
        'Mara''s lost compass', 'Status: Completed', 'Mara has her compass back.',
        'Reward claimed: Two Healing potions.', 'Hearthmoor remembers your help.'
      ];
  end case;
end function;
end unit;
