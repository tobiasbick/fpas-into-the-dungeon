// Pure proof of the compass objective over a complete supplied spawn-dungeon route.
unit Dungeon.Quests.Reachability;

uses Dungeon.Areas.Identities as Identities, Dungeon.Interior as InteriorUnit, Dungeon.Interior.Generation.Levels as Levels, Dungeon.Interior.Generation.Validation as Validation, Dungeon.Quests.Model as Model, Dungeon.Terrain as Terrain, Dungeon.Terrain.Entrances as Entrances, Dungeon.Terrain.Placement as Placement;

// Validates the outdoor access and every connected level, paired transition and unique target.
// Maps may be authoritative stored levels or transient previews; no discovery or random state changes.
public function ProveCompassRoute(Metadata: Terrain.WorldMetadata; Maps: array of InteriorUnit.InteriorMap): result of (Model.CompassObjective, string);
begin
  const ValidMetadata := try Placement.ValidateWorldMetadata(Metadata);
  if (Maps.Length() < 1) or (Maps.Length() > InteriorUnit.MaxDungeonDepth) then
    return Error('compass route requires every level of one supported dungeon');
  end if;
  const Region := Entrances.RegionOf(Metadata, Metadata.Spawn);
  const Objective := Model.CompassTarget(Metadata, Maps.Length());
  for Level: integer := 0 to Maps.Length() - 1 do
    const Map := Maps[Level];
    if (Map.AreaId <> Identities.DungeonAreaId(Metadata, Region, Level)) or (Map.Level <> Level)
      or
      (Map.Depth <> Maps.Length()) or (Map.DisplayName <> Maps[0].DisplayName)
    then
      return Error('compass route levels must agree on identity, stored depth and name');
    end if;
    // Shared validation proves all traversable fields connected, including arrival,
    // descent landing and target placement. Up/down identities pair by adjacent level.
    const Valid := try Validation.ValidateGeneratedDungeon(
      Map,
      Levels.CompassExpected(Metadata, Region.X, Region.Y, Level, Maps.Length())
    );
    const Target := try Model.ValidateQuestMap(Metadata, Model.QuestState.Active(Objective), Map);
  end for;

  return Ok(Objective);
end function;
end unit;
