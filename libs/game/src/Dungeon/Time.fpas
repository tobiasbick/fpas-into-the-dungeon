// Pure bounded world-clock arithmetic and fixed action durations, independent of wall-clock time.
unit Dungeon.Time;

// Canonical minutes since day 1 at midnight; new games start at 08:00.
public const InitialMinutes: integer := 480;
// Keeps clock arithmetic and serialized values bounded before any addition.
public const MaximumMinutes: integer := 1000000000;
// Ordinary turns and explicit area transitions each take one game minute.
public const TurnMinutes: integer := 1;
// Outdoor travel covers more distance than a local dungeon or village step.
public const OutdoorStepMinutes: integer := 5;
// Every inn offers the same eight-hour rest.
public const RestMinutes: integer := 480;

// Presentation phase; it has no effect on visibility or combat rules.
public type DayPhase = enum
  Day;
  Night;
end enum;

// Checks external or restored clock values without clamping or wrapping them.
public function Validate(Minutes: integer): result of (integer, string);
begin
  if (Minutes < 0) or (Minutes > MaximumMinutes) then
    return Error('world minutes are outside the supported range');
  end if;

  return Ok(Minutes);
end function;

// Advances only when the entire non-negative duration fits; failure leaves callers unchanged.
public function Advance(Minutes: integer; Duration: integer): result of (integer, string);
ensures (Returned): case Returned of
  when Ok(const Next): (Next >= Minutes) and (Next <= MaximumMinutes)
    and
    (Next = Minutes + Duration);
  when Error(_): true;
end case;
begin
  const Checked := try Validate(Minutes);
  if (Duration < 0) or (Duration > MaximumMinutes - Checked) then
    return Error('world clock cannot advance by this duration');
  end if;

  return Ok(Checked + Duration);
end function;

// One-based day number derived from a previously validated canonical clock.
public function DayNumber(Minutes: integer): integer;
requires (Minutes >= 0) and (Minutes <= MaximumMinutes);
ensures (Day): (Day >= 1) and (Day <= 694445);
begin
  return Minutes div 1440 + 1;
end function;

// Zero-based minute within a day, used for display and phase derivation.
public function MinuteOfDay(Minutes: integer): integer;
requires (Minutes >= 0) and (Minutes <= MaximumMinutes);
ensures (Minute): (Minute >= 0) and (Minute < 1440);
begin
  return Minutes mod 1440;
end function;

// Daylight lasts from 06:00 through 19:59; all other minutes are night.
public function Phase(Minutes: integer): DayPhase;
requires (Minutes >= 0) and (Minutes <= MaximumMinutes);
begin
  const Minute := MinuteOfDay(Minutes);
  return if (Minute >= 360) and (Minute < 1200) then DayPhase.Day else DayPhase.Night end if;
end function;
end unit;
