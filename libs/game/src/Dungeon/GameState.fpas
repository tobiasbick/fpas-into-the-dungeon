// The authoritative game state: creation, validation, and read-only queries of its parts.
unit Dungeon.GameState;

uses Dungeon.Quests.Items as QuestItems, Dungeon.Quests.Model as QuestModel, Dungeon.Npcs as NpcRules, Dungeon.Areas.Identities as Identities, Dungeon.Exploration.Model as Model, Dungeon.Coordinates as Coordinates, Dungeon.Hostiles as HostileRules, Dungeon.Interior as InteriorUnit, Dungeon.Items as ItemRules, Dungeon.Progression as Progression, Dungeon.Random as Random, Dungeon.Settlements as Settlements, Dungeon.Terrain as Terrain, Dungeon.Terrain.Entrances as Entrances;

// Full health of a new player character; health never exceeds it.
public const PlayerMaximumHealth: integer := 20;
// Most items the player can carry and wear together.
public const MaximumInventoryItems: integer := 64;

// Selected world and supplied finite geometry for a dungeon or settlement; absent outdoors.
// The caller retains validated geometry; pure rules never load or generate it.
public type AreaView = record
  public Metadata: Terrain.WorldMetadata;
  public Interior: option of InteriorUnit.InteriorMap;
end record;

// Authoritative player state retained by the server for one session.
public type GameState = record
  public Area: Coordinates.AreaKind;
  public AreaId: string;
  public Player: Coordinates.PlayerPosition;
  public ReturnLocation: Coordinates.ReturnLocation;
  // Visited dungeon and settlement identities, strictly sorted without duplicates.
  public VisitedAreas: array of string;
  // Persistent server-owned discovery; current visibility is derived by exploration rules.
  public Exploration: Model.ExplorationState;
  // Persistent server-owned item locations and inventory ownership.
  public Items: array of ItemRules.GameItem;
  // Current player health, from 1 through PlayerMaximumHealth while a game is active.
  public Health: integer;
  // Every opponent of the world, including destroyed ones.
  public Hostiles: array of HostileRules.GameHostile;
  // Stable world NPC records, including the home settlement before its first visit.
  public Npcs: array of NpcRules.GameNpc;
  // Accepted compass objective and claimed outcome; readiness follows authoritative item ownership.
  public Quest: QuestModel.QuestState;
  // Dice generator state in 0 until RandomStateModulus; advancing it makes fights reproducible.
  public RandomState: integer;
  // Cumulative skill experience; levels and bonuses are derived, never stored.
  public Progression: Progression.ProgressionState;
end record;

// Derives the first dice generator state of a new game from the world seed.
public function InitialRandomState(Seed: integer): integer;
begin
  return Coordinates.PositiveModulo(
    (Coordinates.PositiveModulo(Seed, Random.RandomStateModulus) * 7919) + 17,
    Random.RandomStateModulus
  );
end function;

// Returns the index of the standing opponent occupying one field of an area, or -1.
public function StandingHostileAt(State: GameState; AreaId: string; Position: Coordinates.InteriorPosition): integer;
begin
  for Index: integer := 0 to State.Hostiles.Length() - 1 do
    begin
      const Hostile: HostileRules.GameHostile := State.Hostiles[Index];
      if ((Hostile.Health > 0) and (Hostile.AreaId = AreaId))
        and
        Coordinates.SamePosition(Hostile.Position, Position)
      then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

// Returns carried and worn items in stable game-state order without exposing placement rules.
public function InventoryItems(State: GameState): array of ItemRules.GameItem;
begin
  var Items: array of ItemRules.GameItem := [];
  for Item: ItemRules.GameItem in State.Items do
    begin
      case Item.Location of
        when ItemRules.ItemLocation.InInterior(_, _), ItemRules.ItemLocation.Consumed, ItemRules.ItemLocation.ReturnedToMara(_):
          null;
        when ItemRules.ItemLocation.CarriedByPlayer, ItemRules.ItemLocation.EquippedByPlayer(_):
          Items.PushInPlace(Item);
      end case;
    end;
  end for;

  return Items;
end function;

// Returns whether the player carries and wears as many items as the inventory holds.
public function InventoryIsFull(State: GameState): boolean;
begin
  return InventoryItems(State).Length() >= MaximumInventoryItems;
end function;

// Returns the item worn in one slot, if any.
public function EquippedItem(State: GameState; Slot: ItemRules.EquipmentSlot): option of ItemRules.GameItem;
begin
  for Item: ItemRules.GameItem in State.Items do
    begin
      case Item.Location of
        when ItemRules.ItemLocation.EquippedByPlayer(const Worn):
          if Worn = Slot then
            begin
              return Some(Item);
            end;
          end if;
        when ItemRules.ItemLocation.InInterior(_, _), ItemRules.ItemLocation.CarriedByPlayer, ItemRules.ItemLocation.Consumed, ItemRules.ItemLocation.ReturnedToMara(_):
          null;
      end case;
    end;
  end for;

  return None;
end function;

// Overlays currently present dynamic objects on static interior geometry.
public function InteriorVisibleCodeForState(Map: InteriorUnit.InteriorMap; State: GameState; Position: Coordinates.InteriorPosition): result of (string, string);
begin
  const HostileIndex: integer := StandingHostileAt(State, State.AreaId, Position);
  if HostileIndex >= 0 then
    begin
      return Ok(HostileRules.HostileVisibleCode(State.Hostiles[HostileIndex].Kind));
    end;
  end if;

  for Item: ItemRules.GameItem in State.Items do
    begin
      case Item.Location of
        when ItemRules.ItemLocation.InInterior(const AreaId, const ItemPosition):
          if (AreaId = State.AreaId)
            and
            ((ItemPosition.X = Position.X) and (ItemPosition.Y = Position.Y))
          then
            begin
              return Ok(ItemRules.ItemVisibleCode(Item.Kind));
            end;
          end if;
        when ItemRules.ItemLocation.CarriedByPlayer, ItemRules.ItemLocation.EquippedByPlayer(_), ItemRules.ItemLocation.Consumed, ItemRules.ItemLocation.ReturnedToMara(_):
          null;
      end case;
    end;
  end for;

  return InteriorUnit.InteriorVisibleCode(Map, Position);
end function;

// Returns the outdoor coordinate only when the player currently occupies an outdoor area.
public function OutdoorPlayerPosition(State: GameState): result of (Coordinates.WorldPosition, string);
begin
  case State.Player of
    when Coordinates.PlayerPosition.Outdoor(const Value):
      return Ok(Value);
    when Coordinates.PlayerPosition.FirstPerson(_), Coordinates.PlayerPosition.Settlement(_):
      return Error('player does not occupy an outdoor position');
  end case;
end function;

// Returns the interior pose only when the player currently occupies a first-person area.
public function FirstPersonPlayerPose(State: GameState): result of (Coordinates.FirstPersonPose, string);
begin
  case State.Player of
    when Coordinates.PlayerPosition.FirstPerson(const Value):
      return Ok(Value);
    when Coordinates.PlayerPosition.Outdoor(_), Coordinates.PlayerPosition.Settlement(_):
      return Error('player does not occupy a first-person position');
  end case;
end function;

// Returns the bounded local field only for a settlement player position.
public function SettlementPlayerPosition(State: GameState): result of (Coordinates.InteriorPosition, string);
begin
  case State.Player of
    when Coordinates.PlayerPosition.Settlement(const Position):
      return Ok(Position);
    when Coordinates.PlayerPosition.Outdoor(_), Coordinates.PlayerPosition.FirstPerson(_):
      return Error('player does not occupy a settlement position');
  end case;
end function;

// Creates the player at spawn; bounded area entities are materialized only on first entry.
public function NewGame(Metadata: Terrain.WorldMetadata): GameState;
begin
  return GameState(
    Area := Coordinates.AreaKind.OutdoorRegion,
    AreaId := Metadata.OutdoorAreaId,
    Player := Coordinates.PlayerPosition.Outdoor(Metadata.Spawn),
    ReturnLocation := Coordinates.ReturnLocation.NoReturnLocation,
    VisitedAreas := [],
    Exploration := Model.EmptyExploration(),
    Items := [],
    Health := PlayerMaximumHealth,
    Hostiles := [],
    Npcs := NpcRules.NewNpcs(Metadata),
    Quest := QuestModel.QuestState.NotAccepted,
    RandomState := InitialRandomState(Metadata.Seed),
    Progression := Progression.NewProgression()
  );
end function;

// Returns whether this game has materialized the named dungeon.
public function HasVisitedArea(State: GameState; AreaId: string): boolean;
begin
  for Visited: string in State.VisitedAreas do
    begin
      if Visited = AreaId then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

// Returns the supplied current finite map, rejecting absent or mismatched geometry.
// Geometry must already be validated by its owner; this helper performs no loading.
public function CurrentInterior(View: AreaView; State: GameState): result of (InteriorUnit.InteriorMap, string);
begin
  if (State.Area <> Coordinates.AreaKind.Dungeon)
    and
    (State.Area <> Coordinates.AreaKind.Settlement)
  then
    begin
      return Error('current area does not have bounded geometry');
    end;
  end if;

  case View.Interior of
    when Some(const Map):
      begin
        if (State.AreaId = '') or (Map.AreaId <> State.AreaId) then
          begin
            return Error('interior map identity does not match the current area');
          end;
        end if;

        return Ok(Map);
      end;
    when None:
      begin
        return Error('dungeon state requires the current interior map');
      end;
  end case;
end function;

// Checks every self-contained state rule without any map: scalar ranges, visited areas, identities,
// skill experience, inventory and slots, area kinds, poses, and return locations. Not a full validation; geometry
// of the current area is checked by ValidateGameState and placements by ValidateSavedGame.
public function ValidateStateShape(Metadata: Terrain.WorldMetadata; State: GameState): result of (GameState, string);
begin
  const ValidNpcs := try NpcRules.ValidateNpcs(Metadata, State.Npcs);
  const ValidQuest := try QuestModel.ValidateQuest(Metadata, State.Quest);
  var TargetVisited := false;
  case QuestModel.ObjectiveOf(State.Quest) of
    when Some(const Objective):
      TargetVisited := HasVisitedArea(State, Objective.AreaId);
    when None:
      null;
  end case;
  const QuestInventory := try QuestItems.ValidateQuestItems(
    Metadata,
    State.Quest,
    State.Items,
    TargetVisited
  );
  if not (State.Quest is QuestModel.QuestState.NotAccepted) and not State.Npcs[0].HasMetPlayer then
    return Error('an accepted quest requires meeting Mara');
  end if;

  if State.Npcs[0].HasMetPlayer and not HasVisitedArea(State, Settlements.HomeAreaId(Metadata)) then
    return Error('a met NPC requires its settlement to have been visited');
  end if;
  const ValidExploration: Model.ExplorationState := try Model.ValidateExploration(
    State.Exploration,
    Coordinates.WorldChunkSize
  );
  if (State.Health < 1) or (State.Health > PlayerMaximumHealth) then
    begin
      return Error('player health is outside its range');
    end;
  end if;

  if (State.RandomState < 0) or (State.RandomState >= Random.RandomStateModulus) then
    begin
      return Error('dice generator state is outside its range');
    end;
  end if;

  case Progression.ValidateProgression(State.Progression) of
    when Error(const Reason):
      return Error(Reason);
    when Ok(_):
      null;
  end case;

  for Index: integer := 0 to State.VisitedAreas.Length() - 1 do
    begin
      if State.VisitedAreas[Index] = '' then
        begin
          return Error('visited area identity must not be empty');
        end;
      end if;

      if Index > 0 then
        begin
          if not Model.StringComesBefore(State.VisitedAreas[Index - 1], State.VisitedAreas[Index]) then
            begin
              return Error('visited areas must be strictly sorted without duplicates');
            end;
          end if;
        end;
      end if;
    end;
  end for;

  if InventoryItems(State).Length() > MaximumInventoryItems then
    begin
      return Error('carried and worn items exceed the inventory capacity');
    end;
  end if;
  var WeaponWorn: boolean := false;
  var BodyWorn: boolean := false;
  for Index: integer := 0 to State.Items.Length() - 1 do
    begin
      const Item: ItemRules.GameItem := State.Items[Index];
      if Item.Id = '' then
        begin
          return Error('item identity must not be empty');
        end;
      end if;

      for Other: integer := 0 to Index - 1 do
        begin
          if State.Items[Other].Id = Item.Id then
            begin
              return Error('game state contains a duplicate item identity');
            end;
          end if;
        end;
      end for;

      case Item.Location of
        when ItemRules.ItemLocation.InInterior(const AreaId, const Position):
          begin
            if not HasVisitedArea(State, AreaId) then
              begin
                return Error('item names an unknown interior area');
              end;
            end if;

            for Other: integer := 0 to Index - 1 do
              begin
                case State.Items[Other].Location of
                  when ItemRules.ItemLocation.InInterior(const OtherArea, const OtherPosition):
                    if (AreaId = OtherArea) and Coordinates.SamePosition(Position, OtherPosition) then
                      begin
                        return Error('interior items must occupy distinct fields');
                      end;
                    end if;
                  when ItemRules.ItemLocation.CarriedByPlayer, ItemRules.ItemLocation.EquippedByPlayer(_), ItemRules.ItemLocation.Consumed, ItemRules.ItemLocation.ReturnedToMara(_):
                    null;
                end case;
              end;
            end for;
          end;
        when ItemRules.ItemLocation.EquippedByPlayer(const Slot):
          begin
            case ItemRules.ItemSlot(Item.Kind) of
              when Some(const Fitting):
                begin
                  if Fitting <> Slot then
                    begin
                      return Error('worn item does not fit its slot');
                    end;
                  end if;
                end;
              when None:
                begin
                  return Error('game state wears an item that cannot be worn');
                end;
            end case;

            if Slot = ItemRules.EquipmentSlot.Weapon then
              begin
                if WeaponWorn then
                  begin
                    return Error('only one item can be worn in each slot');
                  end;
                end if;

                WeaponWorn := true;
              end;
            else
              begin
                if BodyWorn then
                  begin
                    return Error('only one item can be worn in each slot');
                  end;
                end if;

                BodyWorn := true;
              end;
            end if;
          end;
        when ItemRules.ItemLocation.ReturnedToMara(_):
          null;
        when ItemRules.ItemLocation.Consumed:
          if Item.Kind <> ItemRules.ItemKind.HealingPotion then
            return Error('only a healing potion can be consumed');
          end if;
        when ItemRules.ItemLocation.CarriedByPlayer:
          begin
            null;
          end;
      end case;
    end;
  end for;

  for Index: integer := 0 to State.Hostiles.Length() - 1 do
    begin
      const Hostile: HostileRules.GameHostile := State.Hostiles[Index];
      if (Hostile.Id = '') or not HasVisitedArea(State, Hostile.AreaId) then
        begin
          return Error('opponent identity or area is invalid');
        end;
      end if;

      if (Hostile.Health < 0) or (Hostile.Health > HostileRules.HostileMaximumHealth(Hostile.Kind)) then
        begin
          return Error('opponent health is outside its range');
        end;
      end if;

      for Item: ItemRules.GameItem in State.Items do
        begin
          if Item.Id = Hostile.Id then
            begin
              return Error('item and opponent identities must be distinct');
            end;
          end if;
        end;
      end for;

      for Other: integer := 0 to Index - 1 do
        begin
          if State.Hostiles[Other].Id = Hostile.Id then
            begin
              return Error('game state contains a duplicate opponent identity');
            end;
          end if;

          if (
            (State.Hostiles[Other].AreaId = Hostile.AreaId)
            and
            ((State.Hostiles[Other].Health > 0) and (Hostile.Health > 0))
          )
            and
            Coordinates.SamePosition(State.Hostiles[Other].Position, Hostile.Position)
          then
            begin
              return Error('standing opponents must occupy distinct fields');
            end;
          end if;
        end;
      end for;
    end;
  end for;

  for Area: Model.InteriorDiscoveryArea in ValidExploration.InteriorAreas do
    begin
      if not HasVisitedArea(State, Area.AreaId) then
        begin
          return Error('game state contains discovery for an unknown interior area');
        end;
      end if;
    end;
  end for;

  if State.AreaId = Metadata.OutdoorAreaId then
    begin
      if State.Area <> Coordinates.AreaKind.OutdoorRegion then
        begin
          return Error('outdoor area identity requires outdoor area kind');
        end;
      end if;
      const Position: Coordinates.WorldPosition := try OutdoorPlayerPosition(State);
      if State.ReturnLocation is Coordinates.ReturnLocation.NoReturnLocation then
        begin
          return Ok(State);
        end;
      else
        begin
          return Error('outdoor state must not retain a return location');
        end;
      end if;
    end;
  end if;

  if State.Area = Coordinates.AreaKind.Settlement then
    if State.AreaId <> Settlements.HomeAreaId(Metadata) then
      return Error('unknown settlement identity');
    end if;
    const Position := try SettlementPlayerPosition(State);
    if NpcRules.At(State.Npcs, State.AreaId, Position) >= 0 then
      return Error('settlement player position must not overlap an NPC');
    end if;

    if not HasVisitedArea(State, State.AreaId) then
      return Error('current settlement must be visited');
    end if;

    if State.ReturnLocation <>
      Coordinates.ReturnLocation.ReturnTo(Metadata.OutdoorAreaId, Metadata.SettlementGate)
    then
      return Error('settlement return location must name its outdoor gate');
    end if;

    return Ok(State);
  end if;

  if State.Area = Coordinates.AreaKind.Dungeon then
    begin
      if not HasVisitedArea(State, State.AreaId) then
        begin
          return Error('current dungeon must be visited');
        end;
      end if;
      const Pose: Coordinates.FirstPersonPose := try FirstPersonPlayerPose(State);
      if StandingHostileAt(State, State.AreaId, Pose.Position) >= 0 then
        begin
          return Error('first-person player position must not overlap a standing opponent');
        end;
      end if;

      case State.ReturnLocation of
        when Coordinates.ReturnLocation.ReturnTo(const AreaId, const Position):
          if AreaId <> Metadata.OutdoorAreaId then
            begin
              return Error('dungeon return location must name the outdoor area');
            end;
          end if;
          const Region: Entrances.RegionCoordinate := try Identities.ParseDungeonAreaId(
            Metadata,
            State.AreaId
          );
          case Entrances.EntranceSite(Metadata, Region) of
            when Some(const Site):
              begin
                if (Position.X <> Site.X) or (Position.Y <> Site.Y) then
                  begin
                    return Error(
                      'dungeon return location must name the entrance site of its region'
                    );
                  end;
                end if;
              end;
            when None:
              begin
                return Error('dungeon region has no entrance site');
              end;
          end case;

          return Ok(State);
        when Coordinates.ReturnLocation.NoReturnLocation:
          return Error('dungeon state requires a return location');
      end case;
    end;
  end if;

  return Error('game state names an unknown area identity');
end function;

function ValidateMapDiscovery(Areas: array of Model.InteriorDiscoveryArea; Map: InteriorUnit.InteriorMap): result of (boolean, string);
begin
  for Area: Model.InteriorDiscoveryArea in Areas do
    if (Area.AreaId = Map.AreaId) and ((Area.Width <> Map.Width) or (Area.Height <> Map.Height)) then
      return Error('discovery dimensions do not match the authoritative area');
    end if;
  end for;

  return Ok(true);
end function;

// Performs per-intention state checks: the self-contained shape plus the current area's geometry
// from the supplied view. Placement completeness and non-current geometry are checked by ValidateSavedGame.
public function ValidateGameState(View: AreaView; State: GameState): result of (GameState, string);
begin
  const Shaped: GameState := try ValidateStateShape(View.Metadata, State);
  if State.Area = Coordinates.AreaKind.Settlement then
    const Map := try CurrentInterior(View, State);
    const ValidMap := try Settlements.ValidateHomeMap(View.Metadata, Map);
    const DiscoveryValid := try ValidateMapDiscovery(State.Exploration.InteriorAreas, Map);
    if (try InteriorUnit.InteriorCellAt(Map, try SettlementPlayerPosition(State))) =
      InteriorUnit.InteriorCellKind.Wall
    then
      return Error('settlement player position must be traversable');
    end if;

    for Item: ItemRules.GameItem in State.Items do
      case Item.Location of
        when ItemRules.ItemLocation.InInterior(const AreaId, _):
          if AreaId = State.AreaId then
            return Error('settlement cannot contain floor items');
          end if;
        when ItemRules.ItemLocation.CarriedByPlayer, ItemRules.ItemLocation.EquippedByPlayer(_), ItemRules.ItemLocation.Consumed, ItemRules.ItemLocation.ReturnedToMara(_):
          null;
      end case;
    end for;

    for Hostile: HostileRules.GameHostile in State.Hostiles do
      if Hostile.AreaId = State.AreaId then
        return Error('settlement cannot contain opponents');
      end if;
    end for;

    return Ok(State);
  end if;

  if State.Area <> Coordinates.AreaKind.Dungeon then
    begin
      case View.Interior of
        when Some(const Map):
          begin
            return Error('outdoor area view must not contain an interior map');
          end;
        when None:
          begin
            return Ok(State);
          end;
      end case;
    end;
  end if;
  const Map: InteriorUnit.InteriorMap := try CurrentInterior(View, State);
  const QuestMap := try QuestModel.ValidateQuestMap(View.Metadata, State.Quest, Map);
  const Pose: Coordinates.FirstPersonPose := try FirstPersonPlayerPose(State);
  if try InteriorUnit.InteriorCellAt(Map, Pose.Position) = InteriorUnit.InteriorCellKind.Wall then
    begin
      return Error('first-person player position must be traversable');
    end;
  end if;

  for Item: ItemRules.GameItem in State.Items do
    begin
      case Item.Location of
        when ItemRules.ItemLocation.InInterior(const AreaId, const Position):
          if AreaId = State.AreaId then
            begin
              if try InteriorUnit.InteriorCellAt(Map, Position) <>
                InteriorUnit.InteriorCellKind.Floor
              then
                begin
                  return Error('interior item must occupy an ordinary floor field');
                end;
              end if;
            end;
          end if;
        when ItemRules.ItemLocation.CarriedByPlayer, ItemRules.ItemLocation.EquippedByPlayer(_), ItemRules.ItemLocation.Consumed, ItemRules.ItemLocation.ReturnedToMara(_):
          null;
      end case;
    end;
  end for;

  for Hostile: HostileRules.GameHostile in State.Hostiles do
    begin
      if Hostile.AreaId = State.AreaId then
        begin
          if try InteriorUnit.InteriorCellAt(Map, Hostile.Position) =
            InteriorUnit.InteriorCellKind.Wall
          then
            begin
              return Error('opponent must occupy a traversable field');
            end;
          end if;
        end;
      end if;
    end;
  end for;

  const DiscoveryValid := try ValidateMapDiscovery(State.Exploration.InteriorAreas, Map);

  return Ok(State);
end function;
end unit;
