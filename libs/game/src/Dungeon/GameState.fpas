// The authoritative game state: creation, validation, and read-only queries of its parts.
unit Dungeon.GameState;

uses
  Dungeon.Areas.Identities, Dungeon.Exploration.Model, Dungeon.Coordinates, Dungeon.Hostiles,
  Dungeon.Interior, Dungeon.Items, Dungeon.Random, Dungeon.Terrain, Dungeon.Terrain.Entrances,
  Std.Arrays;

public const
  // Full health of a new player character; health never exceeds it.
  PlayerMaximumHealth: integer := 20;
  // Most items the player can carry and wear together.
  MaximumInventoryItems: integer := 64;

public type
  // Selected world and caller-supplied current interior; absent outdoors.
  // The caller retains validated geometry; pure rules never load or generate it.
  AreaView = record
    public Metadata: WorldMetadata;
    public Interior: option of InteriorMap;
  end record;
  // Authoritative player state retained by the server for one session.
  GameState = record
    public Area: AreaKind;
    public AreaId: string;
    public Player: PlayerPosition;
    public ReturnLocation: ReturnLocation;
    // Materialized dungeon identities, strictly sorted without duplicates.
    public VisitedAreas: array of string;
    // Persistent server-owned discovery; current visibility is derived by exploration rules.
    public Exploration: ExplorationState;
    // Persistent server-owned item locations and inventory ownership.
    public Items: array of GameItem;
    // Current player health, from 1 through PlayerMaximumHealth while a game is active.
    public Health: integer;
    // Every opponent of the world, including destroyed ones.
    public Hostiles: array of GameHostile;
    // Dice generator state in 0 until RandomStateModulus; advancing it makes fights reproducible.
    public RandomState: integer;
  end record;

// Derives the first dice generator state of a new game from the world seed.
public function InitialRandomState(Seed: integer): integer;
begin
  return PositiveModulo((PositiveModulo(Seed, RandomStateModulus) * 7919) + 17, RandomStateModulus);
end function;

// Returns the index of the standing opponent occupying one field of an area, or -1.
public function StandingHostileAt(State: GameState; AreaId: string; Position: InteriorPosition): integer;
begin
  for Index: integer := 0 to Std.Arrays.Length(State.Hostiles) - 1 do
    begin
      var Hostile: GameHostile := State.Hostiles[Index];
      if ((Hostile.Health > 0) and (Hostile.AreaId = AreaId)) and
         SamePosition(Hostile.Position, Position) then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

// Returns carried and worn items in stable game-state order without exposing placement rules.
public function InventoryItems(State: GameState): array of GameItem;
begin
  mutable var Items: array of GameItem := [];
  for Item: GameItem in State.Items do
    begin
      case Item.Location of
        when ItemLocation.InInterior(AreaId, Position):
          begin
            null;
          end;
        else
          begin
            Std.Arrays.Push(Items, Item);
          end;
      end case;
    end;
  end for;

  return Items;
end function;

// Returns whether the player carries and wears as many items as the inventory holds.
public function InventoryIsFull(State: GameState): boolean;
begin
  return Std.Arrays.Length(InventoryItems(State)) >= MaximumInventoryItems;
end function;

// Returns the item worn in one slot, if any.
public function EquippedItem(State: GameState; Slot: EquipmentSlot): option of GameItem;
begin
  for Item: GameItem in State.Items do
    begin
      case Item.Location of
        when ItemLocation.EquippedByPlayer(Worn):
          begin
            if Worn = Slot then
              begin
                return Some(Item);
              end;
            end if;
          end;
        else
          begin
            null;
          end;
      end case;
    end;
  end for;

  return None;
end function;

// Overlays currently present dynamic objects on static interior geometry.
public function InteriorVisibleCodeForState(Map: InteriorMap; State: GameState; Position: InteriorPosition): result of string, string;
begin
  if StandingHostileAt(State, State.AreaId, Position) >= 0 then
    begin
      return Ok('h');
    end;
  end if;

  for Item: GameItem in State.Items do
    begin
      case Item.Location of
        when ItemLocation.InInterior(AreaId, ItemPosition):
          begin
            if (AreaId = State.AreaId) and
               ((ItemPosition.X = Position.X) and (ItemPosition.Y = Position.Y)) then
              begin
                return Ok(ItemVisibleCode(Item.Kind));
              end;
            end if;
          end;
        else
          begin
            null;
          end;
      end case;
    end;
  end for;

  return InteriorVisibleCode(Map, Position);
end function;

// Returns the outdoor coordinate only when the player currently occupies an outdoor area.
public function OutdoorPlayerPosition(State: GameState): result of WorldPosition, string;
begin
  case State.Player of
    when PlayerPosition.Outdoor(Value):
      begin
        return Ok(Value);
      end;
    else
      begin
        return Error('player does not occupy an outdoor position');
      end;
  end case;
end function;

// Returns the interior pose only when the player currently occupies a first-person area.
public function FirstPersonPlayerPose(State: GameState): result of FirstPersonPose, string;
begin
  case State.Player of
    when PlayerPosition.FirstPerson(Value):
      begin
        return Ok(Value);
      end;
    else
      begin
        return Error('player does not occupy a first-person position');
      end;
  end case;
end function;

// Creates the player at spawn; dungeon entities are materialized only on first entry.
public function NewGame(Metadata: WorldMetadata): GameState;
begin
  return record
    Area := AreaKind.OutdoorRegion;
    AreaId := Metadata.OutdoorAreaId;
    Player := PlayerPosition.Outdoor(Metadata.Spawn);
    ReturnLocation := ReturnLocation.NoReturnLocation;
    VisitedAreas := [];
    Exploration := EmptyExploration();
    Items := [];
    Health := PlayerMaximumHealth;
    Hostiles := [];
    RandomState := InitialRandomState(Metadata.Seed);
  end;
end function;

// Returns whether this game has materialized the named dungeon.
public function HasVisitedArea(State: GameState; AreaId: string): boolean;
begin
  for Visited: string in State.VisitedAreas do
    begin
      if Visited = AreaId then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

// Returns the supplied current dungeon map, rejecting absent or mismatched geometry.
// Geometry must already be validated by its owner; this helper performs no loading.
public function CurrentInterior(View: AreaView; State: GameState): result of InteriorMap, string;
begin
  if State.Area <> AreaKind.Dungeon then
    begin
      return Error('current area does not have dungeon geometry');
    end;
  end if;

  case View.Interior of
    when Some(Map):
      begin
        if (State.AreaId = '') or (Map.AreaId <> State.AreaId) then
          begin
            return Error('interior map identity does not match the current area');
          end;
        end if;

        return Ok(Map);
      end;
    when None:
      begin
        return Error('dungeon state requires the current interior map');
      end;
  end case;
end function;

// Checks every self-contained state rule without any map: scalar ranges, visited areas, identities,
// inventory and slots, area kinds, poses, and return locations. Not a full validation; geometry
// of the current area is checked by ValidateGameState and placements by ValidateSavedGame.
public function ValidateStateShape(Metadata: WorldMetadata; State: GameState): result of GameState, string;
begin
  var ValidExploration: ExplorationState := try ValidateExploration(State.Exploration, WorldChunkSize);
  if (State.Health < 1) or (State.Health > PlayerMaximumHealth) then
    begin
      return Error('player health is outside its range');
    end;
  end if;

  if (State.RandomState < 0) or (State.RandomState >= RandomStateModulus) then
    begin
      return Error('dice generator state is outside its range');
    end;
  end if;

  for Index: integer := 0 to Std.Arrays.Length(State.VisitedAreas) - 1 do
    begin
      if State.VisitedAreas[Index] = '' then
        begin
          return Error('visited area identity must not be empty');
        end;
      end if;

      if Index > 0 then
        begin
          if not StringComesBefore(State.VisitedAreas[Index - 1], State.VisitedAreas[Index]) then
            begin
              return Error('visited areas must be strictly sorted without duplicates');
            end;
          end if;
        end;
      end if;
    end;
  end for;

  if Std.Arrays.Length(InventoryItems(State)) > MaximumInventoryItems then
    begin
      return Error('carried and worn items exceed the inventory capacity');
    end;
  end if;
  mutable var WeaponWorn: boolean := false;
  mutable var BodyWorn: boolean := false;
  for Index: integer := 0 to Std.Arrays.Length(State.Items) - 1 do
    begin
      var Item: GameItem := State.Items[Index];
      if Item.Id = '' then
        begin
          return Error('item identity must not be empty');
        end;
      end if;

      for Other: integer := 0 to Index - 1 do
        begin
          if State.Items[Other].Id = Item.Id then
            begin
              return Error('game state contains a duplicate item identity');
            end;
          end if;
        end;
      end for;

      case Item.Location of
        when ItemLocation.InInterior(AreaId, Position):
          begin
            if not HasVisitedArea(State, AreaId) then
              begin
                return Error('item names an unknown interior area');
              end;
            end if;

            for Other: integer := 0 to Index - 1 do
              begin
                case State.Items[Other].Location of
                  when ItemLocation.InInterior(OtherArea, OtherPosition):
                    begin
                      if (AreaId = OtherArea) and SamePosition(Position, OtherPosition) then
                        begin
                          return Error('interior items must occupy distinct fields');
                        end;
                      end if;
                    end;
                  else
                    begin
                      null;
                    end;
                end case;
              end;
            end for;
          end;
        when ItemLocation.EquippedByPlayer(Slot):
          begin
            case ItemSlot(Item.Kind) of
              when Some(Fitting):
                begin
                  if Fitting <> Slot then
                    begin
                      return Error('worn item does not fit its slot');
                    end;
                  end if;
                end;
              when None:
                begin
                  return Error('game state wears an item that cannot be worn');
                end;
            end case;

            if Slot = EquipmentSlot.Weapon then
              begin
                if WeaponWorn then
                  begin
                    return Error('only one item can be worn in each slot');
                  end;
                end if;

                WeaponWorn := true;
              end;
            else
              begin
                if BodyWorn then
                  begin
                    return Error('only one item can be worn in each slot');
                  end;
                end if;

                BodyWorn := true;
              end;
            end if;
          end;
        else
          begin
            null;
          end;
      end case;
    end;
  end for;

  for Index: integer := 0 to Std.Arrays.Length(State.Hostiles) - 1 do
    begin
      var Hostile: GameHostile := State.Hostiles[Index];
      if (Hostile.Id = '') or not HasVisitedArea(State, Hostile.AreaId) then
        begin
          return Error('opponent identity or area is invalid');
        end;
      end if;

      if (Hostile.Health < 0) or (Hostile.Health > HostileMaximumHealth(Hostile.Kind)) then
        begin
          return Error('opponent health is outside its range');
        end;
      end if;

      for Item: GameItem in State.Items do
        begin
          if Item.Id = Hostile.Id then
            begin
              return Error('item and opponent identities must be distinct');
            end;
          end if;
        end;
      end for;

      for Other: integer := 0 to Index - 1 do
        begin
          if State.Hostiles[Other].Id = Hostile.Id then
            begin
              return Error('game state contains a duplicate opponent identity');
            end;
          end if;

          if ((State.Hostiles[Other].AreaId = Hostile.AreaId) and ((State.Hostiles[Other].Health > 0) and (Hostile.Health > 0))) and
             SamePosition(State.Hostiles[Other].Position, Hostile.Position) then
            begin
              return Error('standing opponents must occupy distinct fields');
            end;
          end if;
        end;
      end for;
    end;
  end for;

  for Area: InteriorDiscoveryArea in ValidExploration.InteriorAreas do
    begin
      if not HasVisitedArea(State, Area.AreaId) then
        begin
          return Error('game state contains discovery for an unknown interior area');
        end;
      end if;
    end;
  end for;

  if State.AreaId = Metadata.OutdoorAreaId then
    begin
      if State.Area <> AreaKind.OutdoorRegion then
        begin
          return Error('outdoor area identity requires outdoor area kind');
        end;
      end if;
      var Position: WorldPosition := try OutdoorPlayerPosition(State);
      case State.ReturnLocation of
        when ReturnLocation.NoReturnLocation:
          begin
            return Ok(State);
          end;
        else
          begin
            return Error('outdoor state must not retain a return location');
          end;
      end case;
    end;
  end if;

  if State.Area = AreaKind.Dungeon then
    begin
      if not HasVisitedArea(State, State.AreaId) then
        begin
          return Error('current dungeon must be visited');
        end;
      end if;
      var Pose: FirstPersonPose := try FirstPersonPlayerPose(State);
      if StandingHostileAt(State, State.AreaId, Pose.Position) >= 0 then
        begin
          return Error('first-person player position must not overlap a standing opponent');
        end;
      end if;

      case State.ReturnLocation of
        when ReturnLocation.ReturnTo(AreaId, Position):
          begin
            if AreaId <> Metadata.OutdoorAreaId then
              begin
                return Error('dungeon return location must name the outdoor area');
              end;
            end if;
            var Region: RegionCoordinate := try ParseDungeonAreaId(Metadata, State.AreaId);
            case EntranceSite(Metadata, Region) of
              when Some(Site):
                begin
                  if (Position.X <> Site.X) or (Position.Y <> Site.Y) then
                    begin
                      return Error('dungeon return location must name the entrance site of its region');
                    end;
                  end if;
                end;
              when None:
                begin
                  return Error('dungeon region has no entrance site');
                end;
            end case;

            return Ok(State);
          end;
        else
          begin
            return Error('dungeon state requires a return location');
          end;
      end case;
    end;
  end if;

  return Error('game state names an unknown area identity');
end function;

// Performs per-intention state checks: the self-contained shape plus the current area's geometry
// from the supplied view. Placement completeness and non-current geometry are checked by ValidateSavedGame.
public function ValidateGameState(View: AreaView; State: GameState): result of GameState, string;
begin
  var Shaped: GameState := try ValidateStateShape(View.Metadata, State);
  if State.Area <> AreaKind.Dungeon then
    begin
      case View.Interior of
        when Some(Map):
          begin
            return Error('outdoor area view must not contain an interior map');
          end;
        when None:
          begin
            return Ok(State);
          end;
      end case;
    end;
  end if;
  var Map: InteriorMap := try CurrentInterior(View, State);
  var Pose: FirstPersonPose := try FirstPersonPlayerPose(State);
  if try InteriorCellAt(Map, Pose.Position) = InteriorCellKind.Wall then
    begin
      return Error('first-person player position must be traversable');
    end;
  end if;

  for Item: GameItem in State.Items do
    begin
      case Item.Location of
        when ItemLocation.InInterior(AreaId, Position):
          begin
            if AreaId = State.AreaId then
              begin
                if try InteriorCellAt(Map, Position) <> InteriorCellKind.Floor then
                  begin
                    return Error('interior item must occupy an ordinary floor field');
                  end;
                end if;
              end;
            end if;
          end;
        else
          begin
            null;
          end;
      end case;
    end;
  end for;

  for Hostile: GameHostile in State.Hostiles do
    begin
      if Hostile.AreaId = State.AreaId then
        begin
          if try InteriorCellAt(Map, Hostile.Position) = InteriorCellKind.Wall then
            begin
              return Error('opponent must occupy a traversable field');
            end;
          end if;
        end;
      end if;
    end;
  end for;

  for Area: InteriorDiscoveryArea in State.Exploration.InteriorAreas do
    begin
      if Area.AreaId = State.AreaId then
        begin
          if (Area.Width <> Map.Width) or (Area.Height <> Map.Height) then
            begin
              return Error('interior discovery dimensions do not match the authoritative area');
            end;
          end if;
        end;
      end if;
    end;
  end for;

  return Ok(State);
end function;
end unit;
