// Opponent kinds, identities, persistent state, names, and full health.
unit Dungeon.Hostiles;

uses Dungeon.Coordinates as Coordinates, Std.Text.Format as Conv;

// Player-facing name and full health of the restless skeleton.
public const RestlessSkeletonName: string := 'Restless skeleton';
public const RestlessSkeletonMaximumHealth: integer := 12;
// Largest distance in fields at which a dormant opponent notices the player.
public const HostileSightRange: integer := 6;

// Identifies the supported opponents; their rules remain server-owned.
public type HostileKind = enum
  RestlessSkeleton;
  GiantRat;
end enum;

// Immutable initial opponent placement; mutable health and alert state are stored separately.
public type HostilePlacement = record
  public Id: string;
  public Kind: HostileKind;
  public Position: Coordinates.InteriorPosition;
end record;

// Persistent opponent state; zero health marks a destroyed opponent that stays recorded.
public type GameHostile = record
  public Id: string;
  public Kind: HostileKind;
  public AreaId: string;
  public Position: Coordinates.InteriorPosition;
  public Health: integer;
  // Set once the opponent has seen the player; alerted opponents chase and attack.
  public Alerted: boolean;
end record;

// Returns the canonical identity of the opponent placed at one index of an area's placement list.
public function HostilePlacementId(AreaId: string; Index: integer): string;
begin
  return (AreaId + ':hostile:') + Conv.IntToStr(Index);
end function;

// Returns the player-facing name of one authoritative opponent kind.
public function HostileDisplayName(Kind: HostileKind): string;
begin
  case Kind of
    when HostileKind.RestlessSkeleton:
      begin
        return RestlessSkeletonName;
      end;
    when HostileKind.GiantRat:
      return 'Giant rat';
  end case;
end function;

// Returns the full health of one opponent kind.
public function HostileMaximumHealth(Kind: HostileKind): integer;
begin
  case Kind of
    when HostileKind.RestlessSkeleton:
      begin
        return RestlessSkeletonMaximumHealth;
      end;
    when HostileKind.GiantRat:
      return 6;
  end case;
end function;

// Lowest d20 roll that hits an unarmored player; armor is added by combat.
public function HostileHitThreshold(Kind: HostileKind): integer;
begin
  case Kind of
    when HostileKind.RestlessSkeleton:
      return 9;
    when HostileKind.GiantRat:
      return 12;
  end case;
end function;

// Number of sides of the opponent's damage die.
public function HostileDamageSides(Kind: HostileKind): integer;
begin
  case Kind of
    when HostileKind.RestlessSkeleton:
      return 4;
    when HostileKind.GiantRat:
      return 2;
  end case;
end function;

// Current-visibility-only marker; the protocol independently checks this alphabet.
public function HostileVisibleCode(Kind: HostileKind): string;
begin
  case Kind of
    when HostileKind.RestlessSkeleton:
      return 'h';
    when HostileKind.GiantRat:
      return 'r';
  end case;
end function;

// Describes the defeated opponent without borrowing another kind's anatomy.
public function HostileDeathMessage(Kind: HostileKind): string;
begin
  case Kind of
    when HostileKind.RestlessSkeleton:
      return 'The Restless skeleton collapses into a heap of bones.';
    when HostileKind.GiantRat:
      return 'The Giant rat falls lifeless to the floor.';
  end case;
end function;

// Read-only inspection feedback for an opponent directly ahead.
public function HostileInspection(Kind: HostileKind): string;
begin
  case Kind of
    when HostileKind.RestlessSkeleton:
      return 'The restless skeleton rattles its bones at you. Press Space to attack.';
    when HostileKind.GiantRat:
      return 'The giant rat bares its teeth at you. Press Space to attack.';
  end case;
end function;
end unit;
