// Pure use of a carried healing potion; its identity remains recorded after consumption.
unit Dungeon.Consumables;

uses Dungeon.Equipment as Equipment, Dungeon.GameState as GameState, Dungeon.Items as Items, Std.Text.Format as Conv, Std.Math as Math;

// Accepted item-use state and the actual healing message for the turn log.
public type ItemUseChange = record
  public State: GameState.GameState;
  public Message: string;
end record;

// Uses one carried potion in a validated state, healing at most six up to derived maximum health.
// Errors leave the input unchanged; this rule advances neither dice nor opponents.
public function UseItem(State: GameState.GameState; ItemId: string): result of (ItemUseChange, string);
begin
  for Index: integer := 0 to State.Items.Length() - 1 do
    const Item := State.Items[Index];
    if Item.Id = ItemId then
      if Item.Kind <> Items.ItemKind.HealingPotion then
        return Error('this item cannot be consumed');
      end if;

      if not (Item.Location is Items.ItemLocation.CarriedByPlayer) then
        return Error('you do not carry this potion');
      end if;
      const Maximum := Equipment.DeriveCharacterValues(State).MaximumHealth;
      if State.Health >= Maximum then
        return Error('you are already at full health');
      end if;
      const Restored := Math.Min(6, Maximum - State.Health);
      var ChangedItems := State.Items;
      ChangedItems[Index] := Item with Location := Items.ItemLocation.Consumed; end with;

      return Ok(
        ItemUseChange(
          State := State with Items := ChangedItems; Health := State.Health + Restored; end with,
          Message := 'You drink the healing potion and recover ' + Conv.IntToStr(Restored) +
          ' health.'
        )
      );
    end if;
  end for;

  return Error('unknown item');
end function;
end unit;
