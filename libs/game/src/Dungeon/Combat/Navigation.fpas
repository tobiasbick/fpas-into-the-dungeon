// Hostile pathfinding: blocked fields and the first step of a deterministic shortest path.
unit Dungeon.Combat.Navigation;

uses Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Interior as InteriorUnit;

// Walls, fields outside the map and standing opponents of the current area block movement.
function Blocked(Map: InteriorUnit.InteriorMap; State: GameState.GameState; Position: Coordinates.InteriorPosition): boolean;
begin
  case InteriorUnit.InteriorCellAt(Map, Position) of
    when Ok(const Cell):
      begin
        if Cell = InteriorUnit.InteriorCellKind.Wall then
          begin
            return true;
          end;
        end if;
      end;
    when Error(const Message):
      begin
        return true;
      end;
  end case;

  return GameState.StandingHostileAt(State, State.AreaId, Position) >= 0;
end function;

// Returns the first field of a shortest path from Start to Goal, or Start when no path exists.
// Neighbors are explored north, east, south, west, so equal paths resolve deterministically.
public function NextStepToward(
  Map: InteriorUnit.InteriorMap;
  State: GameState.GameState;
  Start: Coordinates.InteriorPosition;
  Goal: Coordinates.InteriorPosition
): Coordinates.InteriorPosition;
begin
  const Offsets: array of Coordinates.InteriorPosition := [
    Coordinates.InteriorPosition(X := 0, Y := -1),
    Coordinates.InteriorPosition(X := 1, Y := 0),
    Coordinates.InteriorPosition(X := 0, Y := 1),
    Coordinates.InteriorPosition(X := -1, Y := 0)
  ];
  const FieldCount: integer := Map.Width * Map.Height;
  // Each visited field remembers the first step taken from Start to reach it.
  var FirstStep: array of integer := array.Fill(-1, FieldCount);
  var Queue: array of Coordinates.InteriorPosition := [];
  for Offset: Coordinates.InteriorPosition in Offsets do
    begin
      const Candidate: Coordinates.InteriorPosition := Coordinates.InteriorPosition(
        X := Start.X + Offset.X, Y := Start.Y +
        Offset.Y
      );
      if Coordinates.SamePosition(Candidate, Goal) then
        begin
          return Candidate;
        end;
      end if;

      if not Blocked(Map, State, Candidate) then
        begin
          const Index: integer := (Candidate.Y * Map.Width) + Candidate.X;
          if FirstStep[Index] < 0 then
            begin
              FirstStep[Index] := Index;
              Queue.PushInPlace(Candidate);
            end;
          end if;
        end;
      end if;
    end;
  end for;
  var ReadIndex: integer := 0;
  while ReadIndex < Queue.Length() do
    begin
      const Current: Coordinates.InteriorPosition := Queue[ReadIndex];
      const CurrentFirst: integer := FirstStep[(Current.Y * Map.Width) + Current.X];
      ReadIndex := ReadIndex + 1;
      for Offset: Coordinates.InteriorPosition in Offsets do
        begin
          const Candidate: Coordinates.InteriorPosition := Coordinates.InteriorPosition(
            X := Current.X + Offset.X, Y := Current.Y +
            Offset.Y
          );
          if Coordinates.SamePosition(Candidate, Goal) then
            begin
              return Coordinates.InteriorPosition(
                X := CurrentFirst mod Map.Width, Y := CurrentFirst div
                Map.Width
              );
            end;
          end if;

          if not Blocked(Map, State, Candidate) and not Coordinates.SamePosition(Candidate, Start) then
            begin
              const Index: integer := (Candidate.Y * Map.Width) + Candidate.X;
              if FirstStep[Index] < 0 then
                begin
                  FirstStep[Index] := CurrentFirst;
                  Queue.PushInPlace(Candidate);
                end;
              end if;
            end;
          end if;
        end;
      end for;
    end;
  end while;

  return Start;
end function;
end unit;
