// Authoritative outdoor sight and persistent discovery rules for outdoor and interior areas.
unit Dungeon.Exploration;

uses Dungeon.Exploration.Sight as Sight, Dungeon.Coordinates as Coordinates, Dungeon.Exploration.Model as Model, Dungeon.GameState as GameState, Dungeon.Interior as Interior, Dungeon.Terrain as Terrain, Std.Math as Math;

// Circular outdoor sight radius in world fields.
public const OutdoorSightRadius: integer := 8;

function FindOutdoorChunk(Chunks: array of Model.OutdoorDiscoveryChunk; ChunkX: integer; ChunkY: integer): integer;
begin
  for Index: integer := 0 to Chunks.Length() - 1 do
    begin
      if (Chunks[Index].ChunkX = ChunkX) and (Chunks[Index].ChunkY = ChunkY) then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

function FindInteriorArea(Areas: array of Model.InteriorDiscoveryArea; AreaId: string): integer;
begin
  for Index: integer := 0 to Areas.Length() - 1 do
    begin
      if Areas[Index].AreaId = AreaId then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

function SortedOutdoorChunks(Values: array of Model.OutdoorDiscoveryChunk): array of Model.OutdoorDiscoveryChunk;
begin
  var Sorted: array of Model.OutdoorDiscoveryChunk := Values;
  for Right: integer := 1 to Sorted.Length() - 1 do
    begin
      var Index: integer := Right;
      var Moving: boolean := true;
      while (Index > 0) and Moving do
        begin
          if Model.OutdoorChunkComesBefore(Sorted[Index], Sorted[Index - 1]) then
            begin
              const Previous: Model.OutdoorDiscoveryChunk := Sorted[Index - 1];
              Sorted[Index - 1] := Sorted[Index];
              Sorted[Index] := Previous;
              Index := Index - 1;
            end;
          else
            begin
              Moving := false;
            end;
          end if;
        end;
      end while;
    end;
  end for;

  return Sorted;
end function;

function SortedInteriorAreas(Values: array of Model.InteriorDiscoveryArea): array of Model.InteriorDiscoveryArea;
begin
  var Sorted: array of Model.InteriorDiscoveryArea := Values;
  for Right: integer := 1 to Sorted.Length() - 1 do
    begin
      var Index: integer := Right;
      var Moving: boolean := true;
      while (Index > 0) and Moving do
        begin
          if Model.StringComesBefore(Sorted[Index].AreaId, Sorted[Index - 1].AreaId) then
            begin
              const Previous: Model.InteriorDiscoveryArea := Sorted[Index - 1];
              Sorted[Index - 1] := Sorted[Index];
              Sorted[Index] := Previous;
              Index := Index - 1;
            end;
          else
            begin
              Moving := false;
            end;
          end if;
        end;
      end while;
    end;
  end for;

  return Sorted;
end function;

// Returns whether one signed outdoor world coordinate was discovered earlier.
public function OutdoorIsDiscovered(State: Model.ExplorationState; X: integer; Y: integer): boolean;
begin
  const Index: integer := FindOutdoorChunk(
    State.OutdoorChunks,
    Coordinates.ChunkForCoordinate(X),
    Coordinates.ChunkForCoordinate(Y)
  );
  if Index < 0 then
    begin
      return false;
    end;
  end if;

  return State.OutdoorChunks[Index].Fields[
    (Coordinates.LocalForCoordinate(Y) * Coordinates.WorldChunkSize) +
    Coordinates.LocalForCoordinate(X)
  ];
end function;

// Derives current outdoor sight as a row-major Euclidean circle; negative dimensions yield no fields.
public function OutdoorVisibility(
  OriginX: integer;
  OriginY: integer;
  Width: integer;
  Height: integer;
  Player: Coordinates.WorldPosition
): array of boolean;
begin
  if (Width < 0) or (Height < 0) then
    begin
      return [];
    end;
  end if;
  var VisibleFields: array of boolean := array.Fill(false, Width * Height);
  for LocalY: integer := 0 to Height - 1 do
    begin
      for LocalX: integer := 0 to Width - 1 do
        begin
          const DeltaX: integer := (OriginX + LocalX) - Player.X;
          const DeltaY: integer := (OriginY + LocalY) - Player.Y;
          VisibleFields[(LocalY * Width) + LocalX] := (DeltaX * DeltaX) + (DeltaY * DeltaY) <=
            OutdoorSightRadius * OutdoorSightRadius;
        end;
      end for;
    end;
  end for;

  return VisibleFields;
end function;

// Merges the current outdoor sight circle into persistent discovery memory.
public function RevealOutdoor(State: Model.ExplorationState; Player: Coordinates.WorldPosition): Model.ExplorationState;
begin
  var Chunks: array of Model.OutdoorDiscoveryChunk := State.OutdoorChunks;
  const MinimumChunkX: integer := Coordinates.ChunkForCoordinate(Player.X - OutdoorSightRadius);
  const MaximumChunkX: integer := Coordinates.ChunkForCoordinate(Player.X + OutdoorSightRadius);
  const MinimumChunkY: integer := Coordinates.ChunkForCoordinate(Player.Y - OutdoorSightRadius);
  const MaximumChunkY: integer := Coordinates.ChunkForCoordinate(Player.Y + OutdoorSightRadius);
  for ChunkY: integer := MinimumChunkY to MaximumChunkY do
    begin
      for ChunkX: integer := MinimumChunkX to MaximumChunkX do
        begin
          // Skip bounding-square corners that do not intersect the circular sight field.
          const NearestX: integer := Math.Clamp(
            Player.X, ChunkX * Coordinates.WorldChunkSize,
            (ChunkX + 1) * Coordinates.WorldChunkSize -
            1
          );
          const NearestY: integer := Math.Clamp(
            Player.Y, ChunkY * Coordinates.WorldChunkSize,
            (ChunkY + 1) * Coordinates.WorldChunkSize -
            1
          );
          const DistanceX: integer := NearestX - Player.X;
          const DistanceY: integer := NearestY - Player.Y;
          if DistanceX * DistanceX + DistanceY * DistanceY <=
            OutdoorSightRadius * OutdoorSightRadius
          then
            begin
              var ChunkIndex: integer := FindOutdoorChunk(Chunks, ChunkX, ChunkY);
              if ChunkIndex < 0 then
                begin
                  Chunks.PushInPlace(
                    Model.OutdoorDiscoveryChunk(
                      ChunkX := ChunkX, ChunkY := ChunkY, Fields := array.Fill(
                        false, Coordinates.WorldChunkSize *
                        Coordinates.WorldChunkSize
                      )
                    )
                  );
                  ChunkIndex := Chunks.Length() - 1;
                end;
              end if;
              var Chunk: Model.OutdoorDiscoveryChunk := Chunks[ChunkIndex];
              var Fields: array of boolean := Chunk.Fields;
              for DeltaY: integer := - OutdoorSightRadius to OutdoorSightRadius do
                begin
                  for DeltaX: integer := - OutdoorSightRadius to OutdoorSightRadius do
                    begin
                      const WorldX: integer := Player.X + DeltaX;
                      const WorldY: integer := Player.Y + DeltaY;
                      if (
                        (
                          (DeltaX * DeltaX) + (DeltaY * DeltaY) <=
                          OutdoorSightRadius * OutdoorSightRadius
                        ) and (Coordinates.ChunkForCoordinate(WorldX) = ChunkX)
                      )
                        and
                        (Coordinates.ChunkForCoordinate(WorldY) = ChunkY)
                      then
                        begin
                          Fields[
                            (Coordinates.LocalForCoordinate(WorldY) * Coordinates.WorldChunkSize) +
                            Coordinates.LocalForCoordinate(WorldX)
                          ] := true;
                        end;
                      end if;
                    end;
                  end for;
                end;
              end for;

              Chunk.Fields := Fields;
              Chunks[ChunkIndex] := Chunk;
            end;
          end if;
        end;
      end for;
    end;
  end for;

  return Model.ExplorationState(
    OutdoorChunks := SortedOutdoorChunks(Chunks),
    InteriorAreas := State.InteriorAreas
  );
end function;

// Returns whether one bounded field in a stable area was discovered earlier.
public function InteriorIsDiscovered(
  State: Model.ExplorationState;
  AreaId: string;
  Width: integer;
  X: integer;
  Y: integer
): boolean;
begin
  const Index: integer := FindInteriorArea(State.InteriorAreas, AreaId);
  if (((Index < 0) or (X < 0)) or (Y < 0)) or (X >= Width) then
    begin
      return false;
    end;
  end if;
  const Area: Model.InteriorDiscoveryArea := State.InteriorAreas[Index];
  if (Area.Width <> Width) or (Y >= Area.Height) then
    begin
      return false;
    end;
  end if;

  return Area.Fields[(Y * Width) + X];
end function;

// Merges facing-aware interior visibility, rejecting an existing mask with different dimensions.
public function RevealInterior(
  State: Model.ExplorationState;
  AreaId: string;
  Map: Interior.InteriorMap;
  Pose: Coordinates.FirstPersonPose
): result of (Model.ExplorationState, string);
begin
  var Areas: array of Model.InteriorDiscoveryArea := State.InteriorAreas;
  var Index: integer := FindInteriorArea(Areas, AreaId);
  if Index < 0 then
    begin
      Areas.PushInPlace(
        Model.InteriorDiscoveryArea(
          AreaId := AreaId, Width := Map.Width, Height := Map.Height, Fields := array.Fill(
            false, Map.Width *
            Map.Height
          )
        )
      );
      Areas := SortedInteriorAreas(Areas);
      Index := FindInteriorArea(Areas, AreaId);
    end;
  end if;
  var Area: Model.InteriorDiscoveryArea := Areas[Index];
  if (Area.Width <> Map.Width) or (Area.Height <> Map.Height) then
    begin
      return Error('interior discovery dimensions do not match the authoritative area');
    end;
  end if;
  var Fields: array of boolean := Area.Fields;
  const Visible: array of boolean := Sight.InteriorVisibility(Map, Pose);
  for FieldIndex: integer := 0 to Fields.Length() - 1 do
    begin
      Fields[FieldIndex] := Fields[FieldIndex] or Visible[FieldIndex];
    end;
  end for;

  Area.Fields := Fields;
  Areas[Index] := Area;
  return Ok(Model.ExplorationState(OutdoorChunks := State.OutdoorChunks, InteriorAreas := Areas));
end function;

// Classifies one field without retaining derived current visibility.
public function ClassifyField(Discovered: boolean; Visible: boolean): Model.FieldKnowledge;
begin
  if Visible then
    begin
      return Model.FieldKnowledge.Visible;
    end;
  end if;

  if Discovered then
    begin
      return Model.FieldKnowledge.Remembered;
    end;
  end if;

  return Model.FieldKnowledge.Undiscovered;
end function;

// Reveals exactly the current authoritative sight field after an accepted game event.
public function RevealCurrentArea(View: GameState.AreaView; State: GameState.GameState): result of (GameState.GameState, string);
begin
  var RevealedState: GameState.GameState := try GameState.ValidateGameState(View, State);
  if RevealedState.Area = Coordinates.AreaKind.OutdoorRegion then
    begin
      RevealedState.Exploration := RevealOutdoor(
        RevealedState.Exploration,
        try GameState.OutdoorPlayerPosition(RevealedState)
      );
      return Ok(RevealedState);
    end;
  end if;

  if RevealedState.Area = Coordinates.AreaKind.Dungeon then
    begin
      const Map: Interior.InteriorMap := try GameState.CurrentInterior(View, State);
      RevealedState.Exploration := try RevealInterior(
        RevealedState.Exploration,
        RevealedState.AreaId,
        Map,
        try GameState.FirstPersonPlayerPose(RevealedState)
      );
      return Ok(RevealedState);
    end;
  end if;

  return Error('exploration is unavailable for the current area kind');
end function;
end unit;
