// Authoritative outdoor sight and persistent discovery rules for outdoor and interior areas.
unit Dungeon.Exploration;

uses
  Dungeon.Exploration.Sight, Dungeon.Coordinates, Dungeon.Exploration.Model, Dungeon.GameState,
  Dungeon.Interior, Dungeon.Terrain, Std.Math;

// Circular outdoor sight radius in world fields.
public const OutdoorSightRadius: integer := 8;

function FindOutdoorChunk(Chunks: array of OutdoorDiscoveryChunk; ChunkX: integer; ChunkY: integer): integer;
begin
  for Index: integer := 0 to Chunks.Length() - 1 do
    begin
      if (Chunks[Index].ChunkX = ChunkX) and (Chunks[Index].ChunkY = ChunkY) then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

function FindInteriorArea(Areas: array of InteriorDiscoveryArea; AreaId: string): integer;
begin
  for Index: integer := 0 to Areas.Length() - 1 do
    begin
      if Areas[Index].AreaId = AreaId then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

function SortedOutdoorChunks(Values: array of OutdoorDiscoveryChunk): array of OutdoorDiscoveryChunk;
begin
  var Sorted: array of OutdoorDiscoveryChunk := Values;
  for Right: integer := 1 to Sorted.Length() - 1 do
    begin
      var Index: integer := Right;
      var Moving: boolean := true;
      while (Index > 0) and Moving do
        begin
          if OutdoorChunkComesBefore(Sorted[Index], Sorted[Index - 1]) then
            begin
              const Previous: OutdoorDiscoveryChunk := Sorted[Index - 1];
              Sorted[Index - 1] := Sorted[Index];
              Sorted[Index] := Previous;
              Index := Index - 1;
            end;
          else
            begin
              Moving := false;
            end;
          end if;
        end;
      end while;
    end;
  end for;

  return Sorted;
end function;

function SortedInteriorAreas(Values: array of InteriorDiscoveryArea): array of InteriorDiscoveryArea;
begin
  var Sorted: array of InteriorDiscoveryArea := Values;
  for Right: integer := 1 to Sorted.Length() - 1 do
    begin
      var Index: integer := Right;
      var Moving: boolean := true;
      while (Index > 0) and Moving do
        begin
          if StringComesBefore(Sorted[Index].AreaId, Sorted[Index - 1].AreaId) then
            begin
              const Previous: InteriorDiscoveryArea := Sorted[Index - 1];
              Sorted[Index - 1] := Sorted[Index];
              Sorted[Index] := Previous;
              Index := Index - 1;
            end;
          else
            begin
              Moving := false;
            end;
          end if;
        end;
      end while;
    end;
  end for;

  return Sorted;
end function;

// Returns whether one signed outdoor world coordinate was discovered earlier.
public function OutdoorIsDiscovered(State: ExplorationState; X: integer; Y: integer): boolean;
begin
  const Index: integer := FindOutdoorChunk(State.OutdoorChunks, ChunkForCoordinate(X), ChunkForCoordinate(Y));
  if Index < 0 then
    begin
      return false;
    end;
  end if;

  return State.OutdoorChunks[Index].Fields[(LocalForCoordinate(Y) * WorldChunkSize) +
                                           LocalForCoordinate(X)];
end function;

// Derives current outdoor sight as a row-major Euclidean circle; negative dimensions yield no fields.
public function OutdoorVisibility(
  OriginX: integer;
  OriginY: integer;
  Width: integer;
  Height: integer;
  Player: WorldPosition
): array of boolean;
begin
  if (Width < 0) or (Height < 0) then
    begin
      return [];
    end;
  end if;
  var VisibleFields: array of boolean := array.Fill(false, Width * Height);
  for LocalY: integer := 0 to Height - 1 do
    begin
      for LocalX: integer := 0 to Width - 1 do
        begin
          const DeltaX: integer := (OriginX + LocalX) - Player.X;
          const DeltaY: integer := (OriginY + LocalY) - Player.Y;
          VisibleFields[(LocalY * Width) + LocalX] := (DeltaX * DeltaX) + (DeltaY * DeltaY) <=
                                                      OutdoorSightRadius * OutdoorSightRadius;
        end;
      end for;
    end;
  end for;

  return VisibleFields;
end function;

// Merges the current outdoor sight circle into persistent discovery memory.
public function RevealOutdoor(State: ExplorationState; Player: WorldPosition): ExplorationState;
begin
  var Chunks: array of OutdoorDiscoveryChunk := State.OutdoorChunks;
  const MinimumChunkX: integer := ChunkForCoordinate(Player.X - OutdoorSightRadius);
  const MaximumChunkX: integer := ChunkForCoordinate(Player.X + OutdoorSightRadius);
  const MinimumChunkY: integer := ChunkForCoordinate(Player.Y - OutdoorSightRadius);
  const MaximumChunkY: integer := ChunkForCoordinate(Player.Y + OutdoorSightRadius);
  for ChunkY: integer := MinimumChunkY to MaximumChunkY do
    begin
      for ChunkX: integer := MinimumChunkX to MaximumChunkX do
        begin
          // Skip bounding-square corners that do not intersect the circular sight field.
          const NearestX: integer := Std.Math.Clamp(Player.X, ChunkX * WorldChunkSize, (ChunkX + 1) * WorldChunkSize -
                                                                                       1);
          const NearestY: integer := Std.Math.Clamp(Player.Y, ChunkY * WorldChunkSize, (ChunkY + 1) * WorldChunkSize -
                                                                                       1);
          const DistanceX: integer := NearestX - Player.X;
          const DistanceY: integer := NearestY - Player.Y;
          if DistanceX * DistanceX + DistanceY * DistanceY <=
             OutdoorSightRadius * OutdoorSightRadius then
            begin
              var ChunkIndex: integer := FindOutdoorChunk(Chunks, ChunkX, ChunkY);
              if ChunkIndex < 0 then
                begin
                  Chunks.Push(OutdoorDiscoveryChunk(ChunkX := ChunkX, ChunkY := ChunkY, Fields := array.Fill(false, WorldChunkSize *
                                                                                                                    WorldChunkSize)));
                  ChunkIndex := Chunks.Length() - 1;
                end;
              end if;
              var Chunk: OutdoorDiscoveryChunk := Chunks[ChunkIndex];
              var Fields: array of boolean := Chunk.Fields;
              for DeltaY: integer := - OutdoorSightRadius to OutdoorSightRadius do
                begin
                  for DeltaX: integer := - OutdoorSightRadius to OutdoorSightRadius do
                    begin
                      const WorldX: integer := Player.X + DeltaX;
                      const WorldY: integer := Player.Y + DeltaY;
                      if (((DeltaX * DeltaX) + (DeltaY * DeltaY) <= OutdoorSightRadius * OutdoorSightRadius) and (ChunkForCoordinate(WorldX) = ChunkX)) and
                         (ChunkForCoordinate(WorldY) = ChunkY) then
                        begin
                          Fields[(LocalForCoordinate(WorldY) * WorldChunkSize) +
                                 LocalForCoordinate(WorldX)] := true;
                        end;
                      end if;
                    end;
                  end for;
                end;
              end for;

              Chunk.Fields := Fields;
              Chunks[ChunkIndex] := Chunk;
            end;
          end if;
        end;
      end for;
    end;
  end for;

  return ExplorationState(OutdoorChunks := SortedOutdoorChunks(Chunks), InteriorAreas := State.InteriorAreas);
end function;

// Returns whether one bounded field in a stable area was discovered earlier.
public function InteriorIsDiscovered(
  State: ExplorationState;
  AreaId: string;
  Width: integer;
  X: integer;
  Y: integer
): boolean;
begin
  const Index: integer := FindInteriorArea(State.InteriorAreas, AreaId);
  if (((Index < 0) or (X < 0)) or (Y < 0)) or (X >= Width) then
    begin
      return false;
    end;
  end if;
  const Area: InteriorDiscoveryArea := State.InteriorAreas[Index];
  if (Area.Width <> Width) or (Y >= Area.Height) then
    begin
      return false;
    end;
  end if;

  return Area.Fields[(Y * Width) + X];
end function;

// Merges facing-aware interior visibility, rejecting an existing mask with different dimensions.
public function RevealInterior(
  State: ExplorationState;
  AreaId: string;
  Map: InteriorMap;
  Pose: FirstPersonPose
): result of (ExplorationState, string);
begin
  var Areas: array of InteriorDiscoveryArea := State.InteriorAreas;
  var Index: integer := FindInteriorArea(Areas, AreaId);
  if Index < 0 then
    begin
      Areas.Push(InteriorDiscoveryArea(AreaId := AreaId, Width := Map.Width, Height := Map.Height, Fields := array.Fill(false, Map.Width *
                                                                                                                               Map.Height)));
      Areas := SortedInteriorAreas(Areas);
      Index := FindInteriorArea(Areas, AreaId);
    end;
  end if;
  var Area: InteriorDiscoveryArea := Areas[Index];
  if (Area.Width <> Map.Width) or (Area.Height <> Map.Height) then
    begin
      return Error('interior discovery dimensions do not match the authoritative area');
    end;
  end if;
  var Fields: array of boolean := Area.Fields;
  const Visible: array of boolean := InteriorVisibility(Map, Pose);
  for FieldIndex: integer := 0 to Fields.Length() - 1 do
    begin
      Fields[FieldIndex] := Fields[FieldIndex] or Visible[FieldIndex];
    end;
  end for;

  Area.Fields := Fields;
  Areas[Index] := Area;
  return Ok(ExplorationState(OutdoorChunks := State.OutdoorChunks, InteriorAreas := Areas));
end function;

// Classifies one field without retaining derived current visibility.
public function ClassifyField(Discovered: boolean; Visible: boolean): FieldKnowledge;
begin
  if Visible then
    begin
      return FieldKnowledge.Visible;
    end;
  end if;

  if Discovered then
    begin
      return FieldKnowledge.Remembered;
    end;
  end if;

  return FieldKnowledge.Undiscovered;
end function;

// Reveals exactly the current authoritative sight field after an accepted game event.
public function RevealCurrentArea(View: AreaView; State: GameState): result of (GameState, string);
begin
  var RevealedState: GameState := try ValidateGameState(View, State);
  if RevealedState.Area = AreaKind.OutdoorRegion then
    begin
      RevealedState.Exploration := RevealOutdoor(RevealedState.Exploration, try OutdoorPlayerPosition(RevealedState));
      return Ok(RevealedState);
    end;
  end if;

  if RevealedState.Area = AreaKind.Dungeon then
    begin
      const Map: InteriorMap := try CurrentInterior(View, State);
      RevealedState.Exploration := try RevealInterior(RevealedState.Exploration, RevealedState.AreaId, Map, try FirstPersonPlayerPose(RevealedState));
      return Ok(RevealedState);
    end;
  end if;

  return Error('exploration is unavailable for the current area kind');
end function;
end unit;
