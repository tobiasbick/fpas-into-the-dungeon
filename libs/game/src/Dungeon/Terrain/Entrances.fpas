// Entrance regions and sites: where generated dungeons connect to the outdoor world.
unit Dungeon.Terrain.Entrances;

uses
  Dungeon.Coordinates, Dungeon.Terrain, Dungeon.Terrain.Generation, Dungeon.Terrain.Noise,
  Std.Arrays;

public type
  // Signed coordinate of one square entrance region of DungeonRegionChunks by DungeonRegionChunks chunks.
  RegionCoordinate = record
    public X: integer;
    public Y: integer;
  end record;

function RegionFields(Metadata: WorldMetadata): integer;
begin
  return Metadata.DungeonRegionChunks * WorldChunkSize;
end function;

function SameRegion(Left: RegionCoordinate; Right: RegionCoordinate): boolean;
begin
  return (Left.X = Right.X) and (Left.Y = Right.Y);
end function;

function SameWorldPosition(Left: WorldPosition; Right: WorldPosition): boolean;
begin
  return (Left.X = Right.X) and (Left.Y = Right.Y);
end function;

// Returns the entrance region containing one world field.
public function RegionOf(Metadata: WorldMetadata; Position: WorldPosition): RegionCoordinate;
begin
  return record
    X := FloorDivide(Position.X, RegionFields(Metadata));
    Y := FloorDivide(Position.Y, RegionFields(Metadata));
  end;
end function;

// Returns whether a natural cell can hold an entrance: walkable land without water or a feature.
public function CellIsClearEntrance(Cell: WorldCell): boolean;
begin
  return (CellIsWalkable(Cell) and (Cell.Feature = TerrainFeatureKind.NoFeature)) and
         (Cell.Water = WaterKind.NoWater);
end function;

// Returns the seeded candidate field of an ordinary region, at least 16 fields from its border.
public function EntranceCandidate(Metadata: WorldMetadata; Region: RegionCoordinate): WorldPosition;
begin
  var Fields: integer := RegionFields(Metadata);
  var HashX1: integer := CoordinateHash(Metadata.Seed, Region.X, Region.Y, 307);
  var HashX2: integer := CoordinateHash(Metadata.Seed, Region.X, Region.Y, 311);
  var HashY1: integer := CoordinateHash(Metadata.Seed, Region.X, Region.Y, 313);
  var HashY2: integer := CoordinateHash(Metadata.Seed, Region.X, Region.Y, 317);
  return record
    X := (Region.X * Fields) + (16 + (((HashX1 * 1000) + HashX2) mod (Fields - 32)));
    Y := (Region.Y * Fields) + (16 + (((HashY1 * 1000) + HashY2) mod (Fields - 32)));
  end;
end function;

// Returns the region whose dungeon the spawn entrance leads to, even across a region border.
function SpawnRegion(Metadata: WorldMetadata): RegionCoordinate;
begin
  return RegionOf(Metadata, Metadata.Spawn);
end function;

// Returns the entrance site of one region: the spawn entrance for the spawn region,
// otherwise the candidate when its natural cell is clear and differs from the spawn entrance.
public function EntranceSite(Metadata: WorldMetadata; Region: RegionCoordinate): option of WorldPosition;
begin
  if SameRegion(Region, SpawnRegion(Metadata)) then
    begin
      return Some(Metadata.SpawnEntrance);
    end;
  end if;
  var Candidate: WorldPosition := EntranceCandidate(Metadata, Region);
  if SameWorldPosition(Candidate, Metadata.SpawnEntrance) then
    begin
      return None;
    end;
  end if;

  if not CellIsClearEntrance(NaturalCell(Metadata.Seed, Candidate.X, Candidate.Y)) then
    begin
      return None;
    end;
  end if;

  return Some(Candidate);
end function;

// Returns the region whose entrance site is exactly this field, computing at most one natural cell.
// The spawn entrance is checked first and always belongs to the spawn region.
public function EntranceRegionAt(Metadata: WorldMetadata; Position: WorldPosition): option of RegionCoordinate;
begin
  if SameWorldPosition(Position, Metadata.SpawnEntrance) then
    begin
      return Some(SpawnRegion(Metadata));
    end;
  end if;
  var Region: RegionCoordinate := RegionOf(Metadata, Position);
  if SameRegion(Region, SpawnRegion(Metadata)) then
    begin
      return None;
    end;
  end if;

  if not SameWorldPosition(Position, EntranceCandidate(Metadata, Region)) then
    begin
      return None;
    end;
  end if;

  if not CellIsClearEntrance(NaturalCell(Metadata.Seed, Position.X, Position.Y)) then
    begin
      return None;
    end;
  end if;

  return Some(Region);
end function;

function InsideChunk(Position: WorldPosition; Coordinate: ChunkCoordinate): boolean;
begin
  return (ChunkForCoordinate(Position.X) = Coordinate.X) and
         (ChunkForCoordinate(Position.Y) = Coordinate.Y);
end function;

// Returns the fields of one chunk that may hold an entrance: the spawn entrance when inside,
// plus the chunk region's candidate when inside and the region is not the spawn region.
// Callers mark a returned field only when its generated or stored cell is clear.
public function EntranceFieldsInChunk(Metadata: WorldMetadata; Coordinate: ChunkCoordinate): array of WorldPosition;
begin
  mutable var Fields: array of WorldPosition := [];
  if InsideChunk(Metadata.SpawnEntrance, Coordinate) then
    begin
      Fields := [Metadata.SpawnEntrance];
    end;
  end if;
  var Region: RegionCoordinate := RegionOf(Metadata, record
    X := Coordinate.X * WorldChunkSize;
    Y := Coordinate.Y * WorldChunkSize;
  end);
  if not SameRegion(Region, SpawnRegion(Metadata)) then
    begin
      var Candidate: WorldPosition := EntranceCandidate(Metadata, Region);
      if InsideChunk(Candidate, Coordinate) and
         not SameWorldPosition(Candidate, Metadata.SpawnEntrance) then
        begin
          Std.Arrays.Push(Fields, Candidate);
        end;
      end if;
    end;
  end if;

  return Fields;
end function;
end unit;
