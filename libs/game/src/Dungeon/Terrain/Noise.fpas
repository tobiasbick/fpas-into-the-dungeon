// Deterministic coordinate hashing and value noise, sampled pointwise or from precomputed grids.
unit Dungeon.Terrain.Noise;

uses Dungeon.Coordinates, Std.Math;

// Precomputed noise lattice of one scale and salt covering one chunk.
public type NoiseGrid = record
  Scale: integer;
  MinimumX: integer;
  MinimumY: integer;
  Width: integer;
  Values: array of integer;
end record;

// Grid offsets and smooth weights of one noise grid for every column and row of one chunk.
// Grid position and weights change only per column or row, so cells skip recomputing them.
public type NoiseGridAxes = record
  ColumnOffsets: array of integer;
  ColumnWeights: array of integer;
  RowIndexes: array of integer;
  RowWeights: array of integer;
end record;

// Hashes a seeded coordinate and salt into a stable non-negative value.
public function CoordinateHash(Seed: integer; X: integer; Y: integer; Salt: integer): integer;
begin
  const Prime: integer := 2147483647;
  const XPart: integer := PositiveModulo(X, 1000003);
  const YPart: integer := PositiveModulo(Y, 1000033);
  const SeedPart: integer := PositiveModulo(Seed, 1000037);
  const SaltPart: integer := PositiveModulo(Salt, 1000039);
  var Mixed: integer := PositiveModulo((XPart * 73856093) + (YPart * 19349663), Prime);
  Mixed := PositiveModulo(Mixed + (SeedPart * 83492791), Prime);
  Mixed := PositiveModulo(Mixed + (SaltPart * 265443), Prime);
  Mixed := PositiveModulo((Mixed * 48271) + 1, Prime);
  return Mixed mod 1000;
end function;

// Returns small-scale per-cell detail for a seeded coordinate.
public function CoordinateDetail(Seed: integer; X: integer; Y: integer): integer;
begin
  const Primary: integer := CoordinateHash(Seed, X, Y, 37);
  const Secondary: integer := CoordinateHash(Seed, Y, X, 53);
  return PositiveModulo(((Primary * 613) + (Secondary * 337)) + (Primary * Secondary), 1000);
end function;

function SmoothWeight(Local: integer; Scale: integer): integer;
begin
  return ((Local * Local) * ((3 * Scale) - (2 * Local))) div (Scale * Scale);
end function;

function Interpolate(A: integer; B: integer; Weight: integer; Scale: integer): integer;
begin
  return ((A * (Scale - Weight)) + (B * Weight)) div Scale;
end function;

// Samples smoothed value noise at one coordinate for one scale and salt.
public function ValueNoise(Seed: integer; X: integer; Y: integer; Scale: integer; Salt: integer): integer;
begin
  const GridX: integer := FloorDivide(X, Scale);
  const GridY: integer := FloorDivide(Y, Scale);
  const LocalX: integer := PositiveModulo(X, Scale);
  const LocalY: integer := PositiveModulo(Y, Scale);
  const WeightX: integer := SmoothWeight(LocalX, Scale);
  const WeightY: integer := SmoothWeight(LocalY, Scale);
  const Top: integer := Interpolate(CoordinateHash(Seed, GridX, GridY, Salt), CoordinateHash(Seed, GridX +
                                                                                                   1, GridY, Salt), WeightX, Scale);
  const Bottom: integer := Interpolate(CoordinateHash(Seed, GridX, GridY + 1, Salt), CoordinateHash(Seed, GridX +
                                                                                                          1, GridY +
                                                                                                             1, Salt), WeightX, Scale);
  return Interpolate(Top, Bottom, WeightY, Scale);
end function;

// Folds a noise value into a ridge shape that peaks at the middle of the range.
public function RidgeValue(Value: integer): integer;
begin
  return 1000 - (Std.Math.Abs(Value - 500) * 2);
end function;

// Precomputes the noise lattice covering one chunk so its cells can be sampled cheaply.
public function BuildNoiseGrid(
  Seed: integer;
  OriginX: integer;
  OriginY: integer;
  Scale: integer;
  Salt: integer
): NoiseGrid;
begin
  const MinimumX: integer := FloorDivide(OriginX, Scale);
  const MinimumY: integer := FloorDivide(OriginY, Scale);
  const MaximumX: integer := FloorDivide((OriginX + WorldChunkSize) - 1, Scale) + 1;
  const MaximumY: integer := FloorDivide((OriginY + WorldChunkSize) - 1, Scale) + 1;
  var Values: array of integer := [];
  for GridY: integer := MinimumY to MaximumY do
    begin
      for GridX: integer := MinimumX to MaximumX do
        begin
          Values.Push(CoordinateHash(Seed, GridX, GridY, Salt));
        end;
      end for;
    end;
  end for;

  return NoiseGrid(Scale := Scale, MinimumX := MinimumX, MinimumY := MinimumY, Width := (MaximumX - MinimumX) +
                                                                                        1, Values := Values);
end function;

function SampleNoise(Grid: NoiseGrid; X: integer; Y: integer): integer;
begin
  const GridX: integer := FloorDivide(X, Grid.Scale);
  const GridY: integer := FloorDivide(Y, Grid.Scale);
  const LocalX: integer := PositiveModulo(X, Grid.Scale);
  const LocalY: integer := PositiveModulo(Y, Grid.Scale);
  const WeightX: integer := SmoothWeight(LocalX, Grid.Scale);
  const WeightY: integer := SmoothWeight(LocalY, Grid.Scale);
  const OffsetX: integer := GridX - Grid.MinimumX;
  const OffsetY: integer := GridY - Grid.MinimumY;
  const TopIndex: integer := (OffsetY * Grid.Width) + OffsetX;
  const BottomIndex: integer := TopIndex + Grid.Width;
  const Top: integer := Interpolate(Grid.Values[TopIndex], Grid.Values[TopIndex + 1], WeightX, Grid.Scale);
  const Bottom: integer := Interpolate(Grid.Values[BottomIndex], Grid.Values[BottomIndex + 1], WeightX, Grid.Scale);
  return Interpolate(Top, Bottom, WeightY, Grid.Scale);
end function;

// Precomputes the per-column and per-row lattice offsets and weights of one chunk.
public function BuildNoiseGridAxes(Grid: NoiseGrid; OriginX: integer; OriginY: integer): NoiseGridAxes;
begin
  var ColumnOffsets: array of integer := [];
  var ColumnWeights: array of integer := [];
  var RowIndexes: array of integer := [];
  var RowWeights: array of integer := [];
  for Local: integer := 0 to WorldChunkSize - 1 do
    begin
      const X: integer := OriginX + Local;
      const Y: integer := OriginY + Local;
      ColumnOffsets.Push(FloorDivide(X, Grid.Scale) - Grid.MinimumX);
      ColumnWeights.Push(SmoothWeight(PositiveModulo(X, Grid.Scale), Grid.Scale));
      RowIndexes.Push((FloorDivide(Y, Grid.Scale) - Grid.MinimumY) * Grid.Width);
      RowWeights.Push(SmoothWeight(PositiveModulo(Y, Grid.Scale), Grid.Scale));
    end;
  end for;

  return NoiseGridAxes(ColumnOffsets := ColumnOffsets, ColumnWeights := ColumnWeights, RowIndexes := RowIndexes, RowWeights := RowWeights);
end function;

// Returns exactly SampleNoise(Grid, OriginX + LocalX, OriginY + LocalY) for the axes' chunk origin.
public function SampleNoiseAt(Grid: NoiseGrid; Axes: NoiseGridAxes; LocalX: integer; LocalY: integer): integer;
begin
  const TopIndex: integer := Axes.RowIndexes[LocalY] + Axes.ColumnOffsets[LocalX];
  const BottomIndex: integer := TopIndex + Grid.Width;
  const WeightX: integer := Axes.ColumnWeights[LocalX];
  const Top: integer := Interpolate(Grid.Values[TopIndex], Grid.Values[TopIndex + 1], WeightX, Grid.Scale);
  const Bottom: integer := Interpolate(Grid.Values[BottomIndex], Grid.Values[BottomIndex + 1], WeightX, Grid.Scale);
  return Interpolate(Top, Bottom, Axes.RowWeights[LocalY], Grid.Scale);
end function;

// Returns the distance of Value to the nearest multiple of Period.
public function PeriodicDistance(Value: integer; Period: integer): integer;
begin
  const Wrapped: integer := PositiveModulo(Value, Period);
  if Wrapped > Period div 2 then
    begin
      return Period - Wrapped;
    end;
  end if;

  return Wrapped;
end function;

// Returns the index of the periodic site nearest to Value.
public function NearestPeriodicIndex(Value: integer; Offset: integer; Period: integer): integer;
begin
  return FloorDivide((Value + Offset) + (Period div 2), Period);
end function;
end unit;
