// World metadata creation and validation: natural spawn, nearby dungeon entrance, and settlement gate.
unit Dungeon.Terrain.Placement;

uses Dungeon.Coordinates as Coordinates, Dungeon.Terrain as Terrain, Dungeon.Terrain.Entrances as Entrances, Dungeon.Terrain.Generation as TerrainGeneration, Dungeon.Terrain.Noise as Noise, Std.Math as Math;

// Inclusive bounds of the entrance region side length in chunks.
public const MinimumDungeonRegionChunks: integer := 1;
public const MaximumDungeonRegionChunks: integer := 16;

const NaturalSpawnRadius: integer := 8;
const MaximumSpawnCandidates: integer := 1024;
const VisibleSpawnRadiusX: integer := 64;
const VisibleSpawnRadiusY: integer := 24;
const NearbySpawnRadiusX: integer := 512;
const NearbySpawnRadiusY: integer := 256;

function HasVisibleWoodland(Seed: integer; X: integer; Y: integer): boolean;
begin
  var CandidateY: integer := Y - VisibleSpawnRadiusY;
  while CandidateY <= Y + VisibleSpawnRadiusY do
    begin
      var CandidateX: integer := X - VisibleSpawnRadiusX;
      while CandidateX <= X + VisibleSpawnRadiusX do
        begin
          const Cell: Terrain.WorldCell := TerrainGeneration.GenerateCellWithShifts(
            Seed,
            CandidateX,
            CandidateY,
            TerrainGeneration.RiverShift(Seed, CandidateY),
            TerrainGeneration.PathShift(Seed, CandidateX)
          );
          if (Cell.Feature = Terrain.TerrainFeatureKind.Tree)
            or
            (Cell.Feature = Terrain.TerrainFeatureKind.Forest)
          then
            begin
              return true;
            end;
          end if;

          CandidateX := CandidateX + 4;
        end;
      end while;

      CandidateY := CandidateY + 4;
    end;
  end while;

  return false;
end function;

function HasNearbyLandscapeContrast(Seed: integer; X: integer; Y: integer): boolean;
begin
  var CandidateY: integer := Y - NearbySpawnRadiusY;
  while CandidateY <= Y + NearbySpawnRadiusY do
    begin
      var CandidateX: integer := X - NearbySpawnRadiusX;
      while CandidateX <= X + NearbySpawnRadiusX do
        begin
          const Cell: Terrain.WorldCell := TerrainGeneration.GenerateCellWithShifts(
            Seed,
            CandidateX,
            CandidateY,
            TerrainGeneration.RiverShift(Seed, CandidateY),
            TerrainGeneration.PathShift(Seed, CandidateX)
          );
          if (
            (
              (Cell.Base = Terrain.BaseTerrainKind.Sand)
              or
              (Cell.Base = Terrain.BaseTerrainKind.Rock)
            ) or (Cell.Water <> Terrain.WaterKind.NoWater)
          )
            or
            (Cell.Feature = Terrain.TerrainFeatureKind.Forest)
          then
            begin
              return true;
            end;
          end if;

          CandidateX := CandidateX + 32;
        end;
      end while;

      CandidateY := CandidateY + 32;
    end;
  end while;

  return false;
end function;

function CardinalOffset(Index: integer; Distance: integer): Coordinates.WorldPosition;
begin
  const Along: integer := Index mod Distance;
  case Index div Distance of
    when 0:
      return Coordinates.WorldPosition(X := Distance - Along, Y := Along);
    when 1:
      return Coordinates.WorldPosition(X := - Along, Y := Distance - Along);
    when 2:
      return Coordinates.WorldPosition(X := Along - Distance, Y := - Along);
    else
      return Coordinates.WorldPosition(X := Along, Y := Along - Distance);
  end case;
end function;

function IsClearEntranceCell(Seed: integer; Position: Coordinates.WorldPosition): boolean;
begin
  return Entrances.CellIsClearEntrance(TerrainGeneration.NaturalCell(Seed, Position.X, Position.Y));
end function;

function HasTraversableCardinalRoute(Seed: integer; Spawn: Coordinates.WorldPosition; Target: Coordinates.WorldPosition): boolean;
begin
  var X: integer := Spawn.X;
  var Y: integer := Spawn.Y;
  while X <> Target.X do
    begin
      if X < Target.X then
        begin
          X := X + 1;
        end;
      else
        begin
          X := X - 1;
        end;
      end if;

      if not Terrain.CellIsWalkable(TerrainGeneration.NaturalCell(Seed, X, Y)) then
        begin
          return false;
        end;
      end if;
    end;
  end while;

  while Y <> Target.Y do
    begin
      if Y < Target.Y then
        begin
          Y := Y + 1;
        end;
      else
        begin
          Y := Y - 1;
        end;
      end if;

      if not Terrain.CellIsWalkable(TerrainGeneration.NaturalCell(Seed, X, Y)) then
        begin
          return false;
        end;
      end if;
    end;
  end while;

  return true;
end function;

function FindEntrance(Seed: integer; Spawn: Coordinates.WorldPosition): result of (Coordinates.WorldPosition, string);
begin
  const Start: integer := Noise.CoordinateHash(Seed, Spawn.X, Spawn.Y, 211) mod 12;
  for Candidate: integer := 0 to 11 do
    begin
      const Offset: Coordinates.WorldPosition := CardinalOffset((Start + Candidate) mod 12, 3);
      const Position: Coordinates.WorldPosition := Coordinates.WorldPosition(
        X := Spawn.X + Offset.X, Y := Spawn.Y +
        Offset.Y
      );
      if IsClearEntranceCell(Seed, Position) and HasTraversableCardinalRoute(Seed, Spawn, Position) then
        begin
          return Ok(Position);
        end;
      end if;
    end;
  end for;

  return Error('unable to place an entrance exactly three traversable steps from spawn');
end function;

function IsNaturalSpawnSite(Seed: integer; X: integer; Y: integer): boolean;
begin
  const CenterSample: Terrain.TerrainGenerationSample := TerrainGeneration.SampleTerrainAtSeed(
    Seed,
    X,
    Y
  );
  if ((CenterSample.LandScore < 590) or (CenterSample.Ruggedness > 700))
    or
    (
      ((CenterSample.Moisture < 300) or (CenterSample.Moisture > 800))
      or
      ((CenterSample.Vegetation < 430) or (CenterSample.Vegetation > 680))
    )
  then
    begin
      return false;
    end;
  end if;
  const Center: Terrain.WorldCell := TerrainGeneration.GenerateCellWithShifts(
    Seed,
    X,
    Y,
    TerrainGeneration.RiverShift(Seed, Y),
    TerrainGeneration.PathShift(Seed, X)
  );
  if not Terrain.CellIsWalkable(Center) or (Center.Feature <> Terrain.TerrainFeatureKind.NoFeature) then
    begin
      return false;
    end;
  end if;

  for CandidateY: integer := Y - NaturalSpawnRadius to Y + NaturalSpawnRadius do
    begin
      for CandidateX: integer := X - NaturalSpawnRadius to X + NaturalSpawnRadius do
        begin
          if not Terrain.CellIsWalkable(
            TerrainGeneration.GenerateCellWithShifts(
              Seed,
              CandidateX,
              CandidateY,
              TerrainGeneration.RiverShift(Seed, CandidateY),
              TerrainGeneration.PathShift(Seed, CandidateX)
            )
          )
          then
            begin
              return false;
            end;
          end if;
        end;
      end for;
    end;
  end for;
  const Spawn: Coordinates.WorldPosition := Coordinates.WorldPosition(X := X, Y := Y);
  return (HasVisibleWoodland(Seed, X, Y) and HasNearbyLandscapeContrast(Seed, X, Y))
    and
    (FindEntrance(Seed, Spawn) is Ok(_));
end function;

function FindNaturalSpawn(Seed: integer): result of (Coordinates.WorldPosition, string);
begin
  for Candidate: integer := 0 to MaximumSpawnCandidates - 1 do
    begin
      const X: integer := (Noise.CoordinateHash(Seed, Candidate, 0, 101) - 500) * 32;
      const Y: integer := (Noise.CoordinateHash(Seed, Candidate, 0, 103) - 500) * 32;
      if IsNaturalSpawnSite(Seed, X, Y) then
        begin
          return Ok(Coordinates.WorldPosition(X := X, Y := Y));
        end;
      end if;
    end;
  end for;

  return Error('unable to find a natural spawn site with a valid entrance for world seed');
end function;

function FindSettlementGate(Metadata: Terrain.WorldMetadata): result of (Coordinates.WorldPosition, string);
begin
  const Start: integer := Noise.CoordinateHash(
    Metadata.Seed,
    Metadata.Spawn.X,
    Metadata.Spawn.Y,
    223
  ) mod 24;
  for Candidate: integer := 0 to 23 do
    const Offset: Coordinates.WorldPosition := CardinalOffset((Start + Candidate) mod 24, 6);
    const Position: Coordinates.WorldPosition := Coordinates.WorldPosition(
      X := Metadata.Spawn.X + Offset.X, Y := Metadata.Spawn.Y + Offset.Y
    );
    if (
      Math.Abs(Position.X - Metadata.SpawnEntrance.X) +
      Math.Abs(Position.Y - Metadata.SpawnEntrance.Y) > 1
    )
      and
      (Entrances.EntranceRegionAt(Metadata, Position) is None)
      and
      IsClearEntranceCell(Metadata.Seed, Position)
      and
      HasTraversableCardinalRoute(Metadata.Seed, Metadata.Spawn, Position)
    then
      return Ok(Position);
    end if;
  end for;

  return Error('unable to place a settlement gate exactly six traversable steps from spawn');
end function;

// Creates current metadata with deterministic spawn, dungeon entrance, settlement gate, and region size.
// Rejects region sizes outside MinimumDungeonRegionChunks through MaximumDungeonRegionChunks.
public function NewWorldMetadata(Id: string; Seed: integer; DungeonRegionChunks: integer): result of (Terrain.WorldMetadata, string);
begin
  if (DungeonRegionChunks < MinimumDungeonRegionChunks)
    or
    (DungeonRegionChunks > MaximumDungeonRegionChunks)
  then
    begin
      return Error('dungeon region size must be 1 through 16 chunks');
    end;
  end if;
  const Spawn: Coordinates.WorldPosition := try FindNaturalSpawn(Seed);
  var Metadata: Terrain.WorldMetadata := Terrain.WorldMetadata(
    Id := Id, Seed := Seed, FormatVersion := Terrain.WorldFormatVersion,
    GeneratorVersion := Terrain.WorldGeneratorVersion, ChunkSize := Coordinates.WorldChunkSize,
    Spawn := Spawn, OutdoorAreaId := Id +
    ':outdoor', OutdoorAreaLabel := 'Outdoor region',
    SpawnEntrance := try FindEntrance(Seed, Spawn), SettlementGate := Spawn,
    DungeonRegionChunks := DungeonRegionChunks
  );
  Metadata.SettlementGate := try FindSettlementGate(Metadata);
  return Ok(Metadata);
end function;

// Rejects metadata that does not exactly match the deterministic current-schema world contract.
public function ValidateWorldMetadata(Metadata: Terrain.WorldMetadata): result of (Terrain.WorldMetadata, string);
begin
  if Metadata.FormatVersion <> Terrain.WorldFormatVersion then
    begin
      return Error('unsupported world format version');
    end;
  end if;

  if Metadata.GeneratorVersion <> Terrain.WorldGeneratorVersion then
    begin
      return Error('unsupported world generator version');
    end;
  end if;

  if Metadata.ChunkSize <> Coordinates.WorldChunkSize then
    begin
      return Error('world chunk size must be 128');
    end;
  end if;
  const Expected: Terrain.WorldMetadata := try NewWorldMetadata(
    Metadata.Id,
    Metadata.Seed,
    Metadata.DungeonRegionChunks
  );
  if Metadata.SettlementGate <> Expected.SettlementGate then
    return Error('settlement gate coordinate is invalid for this generator version');
  end if;

  if (Metadata.Spawn.X <> Expected.Spawn.X) or (Metadata.Spawn.Y <> Expected.Spawn.Y) then
    begin
      return Error('world spawn position is invalid for this generator version');
    end;
  end if;

  if Metadata.OutdoorAreaId <> Expected.OutdoorAreaId then
    begin
      return Error('outdoor area identity is invalid');
    end;
  end if;

  if Metadata.OutdoorAreaLabel = '' then
    begin
      return Error('outdoor area label must not be empty');
    end;
  end if;

  if (Metadata.SpawnEntrance.X <> Expected.SpawnEntrance.X)
    or
    (Metadata.SpawnEntrance.Y <> Expected.SpawnEntrance.Y)
  then
    begin
      return Error('spawn entrance coordinate is invalid for this generator version');
    end;
  end if;

  if Math.Abs(Metadata.SpawnEntrance.X - Metadata.Spawn.X) +
    Math.Abs(
      Metadata.SpawnEntrance.Y -
      Metadata.Spawn.Y
    ) <>
    3
  then
    begin
      return Error('spawn entrance must be exactly three cardinal steps from spawn');
    end;
  end if;

  if not IsClearEntranceCell(Metadata.Seed, Metadata.SpawnEntrance) then
    begin
      return Error('spawn entrance conflicts with generated terrain');
    end;
  end if;

  if not HasTraversableCardinalRoute(Metadata.Seed, Metadata.Spawn, Metadata.SpawnEntrance) then
    begin
      return Error('spawn entrance has no traversable three-step route from spawn');
    end;
  end if;

  return Ok(Metadata);
end function;
end unit;
