// Complete outdoor world generation: natural terrain, dungeon entrances, and the home settlement gate.
unit Dungeon.Terrain.Chunks;

uses Dungeon.Coordinates as Coordinates, Dungeon.Terrain as Terrain, Dungeon.Terrain.Entrances as Entrances, Dungeon.Terrain.Generation as TerrainGeneration;

// Generates one cell solely from metadata and absolute coordinates.
public function GenerateWorldCell(Metadata: Terrain.WorldMetadata; X: integer; Y: integer): Terrain.WorldCell;
begin
  if Metadata.GeneratorVersion <> Terrain.WorldGeneratorVersion then
    begin
      panic('unsupported world generator version');
    end;
  end if;
  var Cell: Terrain.WorldCell := TerrainGeneration.NaturalCell(Metadata.Seed, X, Y);
  if Entrances.EntranceRegionAt(Metadata, Coordinates.WorldPosition(X := X, Y := Y)) is Some(_) then
    begin
      Cell.Feature := Terrain.TerrainFeatureKind.Entrance;
    end;
  end if;

  if (X = Metadata.SettlementGate.X) and (Y = Metadata.SettlementGate.Y) then
    Cell.Feature := Terrain.TerrainFeatureKind.SettlementGate;
  end if;

  return Cell;
end function;

// Generates one complete chunk independently of load or generation order.
// An entrance field is marked only when its generated cell is clear.
public function GenerateChunk(Metadata: Terrain.WorldMetadata; Coordinate: Coordinates.ChunkCoordinate): Terrain.WorldChunk;
begin
  var Chunk: Terrain.WorldChunk := TerrainGeneration.GenerateNaturalChunk(
    Metadata.Seed,
    Coordinate
  );
  for Field: Coordinates.WorldPosition in Entrances.EntranceFieldsInChunk(Metadata, Coordinate) do
    begin
      const Index: integer := (
        Coordinates.LocalForCoordinate(Field.Y) * Coordinates.WorldChunkSize
      ) +
        Coordinates.LocalForCoordinate(Field.X);
      if Entrances.CellIsClearEntrance(Chunk.Cells[Index]) then
        begin
          Chunk.Cells[Index].Feature := Terrain.TerrainFeatureKind.Entrance;
        end;
      end if;
    end;
  end for;

  if (Coordinates.ChunkForCoordinate(Metadata.SettlementGate.X) = Coordinate.X)
    and
    (Coordinates.ChunkForCoordinate(Metadata.SettlementGate.Y) = Coordinate.Y)
  then
    Chunk.Cells[
      (Coordinates.LocalForCoordinate(Metadata.SettlementGate.Y) * Coordinates.WorldChunkSize) +
      Coordinates.LocalForCoordinate(Metadata.SettlementGate.X)
    ].Feature := Terrain.TerrainFeatureKind.SettlementGate;
  end if;

  return Chunk;
end function;
end unit;
