// Complete outdoor world generation: natural terrain plus the entrance features of each world.
unit Dungeon.Terrain.Chunks;

uses
  Dungeon.Coordinates, Dungeon.Terrain, Dungeon.Terrain.Entrances, Dungeon.Terrain.Generation,
  Std.Arrays, Std.Options;

// Generates one cell solely from metadata and absolute coordinates.
public function GenerateWorldCell(Metadata: WorldMetadata; X: integer; Y: integer): WorldCell;
begin
  if Metadata.GeneratorVersion <> WorldGeneratorVersion then
    begin
      panic('unsupported world generator version');
    end;
  end if;
  mutable var Cell: WorldCell := NaturalCell(Metadata.Seed, X, Y);
  if IsSome(EntranceRegionAt(Metadata, record
    X := X;
    Y := Y;
  end)) then
    begin
      Cell.Feature := TerrainFeatureKind.Entrance;
    end;
  end if;

  return Cell;
end function;

// Generates one complete chunk independently of load or generation order.
// An entrance field is marked only when its generated cell is clear.
public function GenerateChunk(Metadata: WorldMetadata; Coordinate: ChunkCoordinate): WorldChunk;
begin
  mutable var Chunk: WorldChunk := GenerateNaturalChunk(Metadata.Seed, Coordinate);
  for Field: WorldPosition in EntranceFieldsInChunk(Metadata, Coordinate) do
    begin
      var Index: integer := (LocalForCoordinate(Field.Y) * WorldChunkSize) +
                            LocalForCoordinate(Field.X);
      if CellIsClearEntrance(Chunk.Cells[Index]) then
        begin
          Chunk.Cells[Index].Feature := TerrainFeatureKind.Entrance;
        end;
      end if;
    end;
  end for;

  return Chunk;
end function;
end unit;
