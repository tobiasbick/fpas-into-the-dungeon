// Deterministic natural outdoor terrain: layers, rivers, paths, lakes, and natural chunks without entrances.
unit Dungeon.Terrain.Generation;

uses Dungeon.Coordinates, Dungeon.Terrain, Dungeon.Terrain.Noise, Std.Arrays;

type
  // Position of one cell relative to its nearest periodic lake center, and that lake's radii.
  LakeSite = record
    OffsetX: integer;
    OffsetY: integer;
    RadiusX: integer;
    RadiusY: integer;
  end record;

const
  SeaLevel: integer := 460;
  MountainRuggedness: integer := 790;
  LakePeriodX: integer := 997;
  LakePeriodY: integer := 743;

function ComposeTerrainSample(
  ContinentalWide: integer;
  ContinentalRegional: integer;
  RegionalElevation: integer;
  CoastDetail: integer;
  MoistureRegional: integer;
  MoistureDetail: integer;
  VegetationRegional: integer;
  LakeShape: integer
): TerrainGenerationSample;
begin
  var Continentalness: integer := ((ContinentalWide * 2) + ContinentalRegional) div 3;
  mutable var LandScore: integer := (((Continentalness * 6) + (RegionalElevation * 3)) + CoastDetail) div
                                    10;
  var LandBridge: integer := RidgeValue(ContinentalRegional);
  if LandBridge > 900 then
    begin
      var BridgeLandScore: integer := SeaLevel + ((LandBridge - 900) * 2);
      if BridgeLandScore > LandScore then
        begin
          LandScore := BridgeLandScore;
        end;
      end if;
    end;
  end if;

  return record
    Continentalness := Continentalness;
    Elevation := (((LandScore * 5) + (RegionalElevation * 3)) + (CoastDetail * 2)) div 10;
    Moisture := ((MoistureRegional * 2) + MoistureDetail) div 3;
    Vegetation := ((((MoistureRegional * 2) + MoistureDetail) * 3) + (VegetationRegional * 2)) div 11;
    LakeShape := LakeShape;
    Ruggedness := ((RidgeValue(RegionalElevation) * 3) + (CoastDetail * 2)) div 5;
    LandScore := LandScore;
    LandBridge := LandBridge;
  end;
end function;

// Samples every terrain layer at one coordinate without precomputed grids.
public function SampleTerrainAtSeed(Seed: integer; X: integer; Y: integer): TerrainGenerationSample;
begin
  return ComposeTerrainSample(ValueNoise(Seed, X, Y, 8192, 11), ValueNoise(Seed, X, Y, 4096, 13), ValueNoise(Seed, X, Y, 1024, 17), ValueNoise(Seed, X, Y, 256, 19), ValueNoise(Seed, X, Y, 2048, 23), ValueNoise(Seed, X, Y, 384, 29), ValueNoise(Seed, X, Y, 512, 31), ValueNoise(Seed, X, Y, 48, 41));
end function;

// Returns the seeded lateral offset of the river course in one row.
public function RiverShift(Seed: integer; Y: integer): integer;
begin
  return (ValueNoise(Seed, 0, Y, 512, 71) - 500) div 2;
end function;

// Returns the seeded lateral offset of the path course in one column.
public function PathShift(Seed: integer; X: integer): integer;
begin
  return (ValueNoise(Seed, X, 0, 144, 89) - 500) div 3;
end function;

function LakeGridX(Seed: integer; X: integer): integer;
begin
  return NearestPeriodicIndex(X, PositiveModulo(Seed, LakePeriodX), LakePeriodX);
end function;

function LakeGridY(Seed: integer; Y: integer): integer;
begin
  return NearestPeriodicIndex(Y, PositiveModulo(Seed, LakePeriodY), LakePeriodY);
end function;

function LakeOffsetX(Seed: integer; X: integer; GridX: integer): integer;
begin
  return (X + PositiveModulo(Seed, LakePeriodX)) - (GridX * LakePeriodX);
end function;

function LakeOffsetY(Seed: integer; Y: integer; GridY: integer): integer;
begin
  return (Y + PositiveModulo(Seed, LakePeriodY)) - (GridY * LakePeriodY);
end function;

function LakeRadiusX(Seed: integer; GridX: integer; GridY: integer): integer;
begin
  return 42 + (CoordinateHash(Seed, GridX, GridY, 43) mod 25);
end function;

function LakeRadiusY(Seed: integer; GridX: integer; GridY: integer): integer;
begin
  return 26 + (CoordinateHash(Seed, GridX, GridY, 47) mod 17);
end function;

// Computes the complete lake site of one cell without chunk-level reuse.
function LakeSiteAt(Seed: integer; X: integer; Y: integer): LakeSite;
begin
  var GridX: integer := LakeGridX(Seed, X);
  var GridY: integer := LakeGridY(Seed, Y);
  return record
    OffsetX := LakeOffsetX(Seed, X, GridX);
    OffsetY := LakeOffsetY(Seed, Y, GridY);
    RadiusX := LakeRadiusX(Seed, GridX, GridY);
    RadiusY := LakeRadiusY(Seed, GridX, GridY);
  end;
end function;

function GenerateCellFromInputs(
  Seed: integer;
  X: integer;
  Y: integer;
  RiverOffset: integer;
  PathOffset: integer;
  Sample: TerrainGenerationSample;
  Lake: LakeSite
): WorldCell;
begin
  var LakeScore: integer := ((((Lake.OffsetX * Lake.OffsetX) * 1000) div (Lake.RadiusX * Lake.RadiusX)) + (((Lake.OffsetY * Lake.OffsetY) * 1000) div (Lake.RadiusY * Lake.RadiusY))) +
                            ((Sample.LakeShape - 500) div 2);
  if Sample.LandScore < SeaLevel then
    begin
      return WaterCell(WaterKind.Sea, TerrainFeatureKind.NoFeature);
    end;
  end if;

  if ((LakeScore < 1000) and (Sample.LandScore > SeaLevel + 30)) and (Sample.Elevation < 740) then
    begin
      return WaterCell(WaterKind.Lake, TerrainFeatureKind.NoFeature);
    end;
  end if;

  if (Sample.Elevation < 800) and (PeriodicDistance(X - RiverOffset, 1024) <= 1) then
    begin
      return WaterCell(WaterKind.RiverWater, TerrainFeatureKind.River);
    end;
  end if;
  mutable var Cell: WorldCell := PlainCell();
  if (Sample.Ruggedness > MountainRuggedness) and (Sample.Elevation > 520) then
    begin
      Cell.Base := BaseTerrainKind.Rock;
    end;
  else
    begin
      if Sample.Moisture < 285 then
        begin
          Cell.Base := BaseTerrainKind.Sand;
        end;
      else
        begin
          if Sample.Vegetation >= 650 then
            begin
              Cell.Feature := TerrainFeatureKind.Forest;
            end;
          else
            begin
              // Only single trees need the per-coordinate detail hash.
              var Detail: integer := CoordinateDetail(Seed, X, Y);
              if ((Sample.Vegetation >= 540) and (Detail > 300)) or
                 ((Sample.Moisture >= 450) and (Detail > 960)) then
                begin
                  Cell.Feature := TerrainFeatureKind.Tree;
                end;
              end if;
            end;
          end if;
        end;
      end if;
    end;
  end if;

  if (Cell.Base <> BaseTerrainKind.Rock) and (PeriodicDistance(Y - PathOffset, 768) <= 1) then
    begin
      Cell.Feature := TerrainFeatureKind.Path;
    end;
  end if;

  return Cell;
end function;

// Generates one cell from precomputed river and path offsets.
public function GenerateCellWithShifts(
  Seed: integer;
  X: integer;
  Y: integer;
  RiverOffset: integer;
  PathOffset: integer
): WorldCell;
begin
  return GenerateCellFromInputs(Seed, X, Y, RiverOffset, PathOffset, SampleTerrainAtSeed(Seed, X, Y), LakeSiteAt(Seed, X, Y));
end function;

// Generates one outdoor cell from the seed alone.
public function NaturalCell(Seed: integer; X: integer; Y: integer): WorldCell;
begin
  return GenerateCellWithShifts(Seed, X, Y, RiverShift(Seed, Y), PathShift(Seed, X));
end function;

// Samples normalized generator fields for previews, diagnostics, and distribution tests.
public function SampleWorldGeneration(Metadata: WorldMetadata; X: integer; Y: integer): TerrainGenerationSample;
begin
  if Metadata.GeneratorVersion <> WorldGeneratorVersion then
    begin
      panic('unsupported world generator version');
    end;
  end if;

  return SampleTerrainAtSeed(Metadata.Seed, X, Y);
end function;

// Generates one complete chunk of natural terrain, without entrances, independently of order.
public function GenerateNaturalChunk(Seed: integer; Coordinate: ChunkCoordinate): WorldChunk;
begin
  mutable var Cells: array of WorldCell := [];
  var OriginX: integer := Coordinate.X * WorldChunkSize;
  var OriginY: integer := Coordinate.Y * WorldChunkSize;
  var ContinentalWideGrid: NoiseGrid := BuildNoiseGrid(Seed, OriginX, OriginY, 8192, 11);
  var ContinentalRegionalGrid: NoiseGrid := BuildNoiseGrid(Seed, OriginX, OriginY, 4096, 13);
  var RegionalElevationGrid: NoiseGrid := BuildNoiseGrid(Seed, OriginX, OriginY, 1024, 17);
  var CoastDetailGrid: NoiseGrid := BuildNoiseGrid(Seed, OriginX, OriginY, 256, 19);
  var MoistureRegionalGrid: NoiseGrid := BuildNoiseGrid(Seed, OriginX, OriginY, 2048, 23);
  var MoistureDetailGrid: NoiseGrid := BuildNoiseGrid(Seed, OriginX, OriginY, 384, 29);
  var VegetationRegionalGrid: NoiseGrid := BuildNoiseGrid(Seed, OriginX, OriginY, 512, 31);
  var LakeShapeGrid: NoiseGrid := BuildNoiseGrid(Seed, OriginX, OriginY, 48, 41);
  var ContinentalWideAxes: NoiseGridAxes := BuildNoiseGridAxes(ContinentalWideGrid, OriginX, OriginY);
  var ContinentalRegionalAxes: NoiseGridAxes := BuildNoiseGridAxes(ContinentalRegionalGrid, OriginX, OriginY);
  var RegionalElevationAxes: NoiseGridAxes := BuildNoiseGridAxes(RegionalElevationGrid, OriginX, OriginY);
  var CoastDetailAxes: NoiseGridAxes := BuildNoiseGridAxes(CoastDetailGrid, OriginX, OriginY);
  var MoistureRegionalAxes: NoiseGridAxes := BuildNoiseGridAxes(MoistureRegionalGrid, OriginX, OriginY);
  var MoistureDetailAxes: NoiseGridAxes := BuildNoiseGridAxes(MoistureDetailGrid, OriginX, OriginY);
  var VegetationRegionalAxes: NoiseGridAxes := BuildNoiseGridAxes(VegetationRegionalGrid, OriginX, OriginY);
  var LakeShapeAxes: NoiseGridAxes := BuildNoiseGridAxes(LakeShapeGrid, OriginX, OriginY);
  mutable var PathOffsets: array of integer := [];
  mutable var LakeColumnGrids: array of integer := [];
  mutable var LakeColumnOffsets: array of integer := [];
  mutable var LakeRowGrids: array of integer := [];
  mutable var LakeRowOffsets: array of integer := [];
  for Local: integer := 0 to WorldChunkSize - 1 do
    begin
      var X: integer := OriginX + Local;
      var Y: integer := OriginY + Local;
      Std.Arrays.Push(PathOffsets, PathShift(Seed, X));
      var GridX: integer := LakeGridX(Seed, X);
      var GridY: integer := LakeGridY(Seed, Y);
      Std.Arrays.Push(LakeColumnGrids, GridX);
      Std.Arrays.Push(LakeColumnOffsets, LakeOffsetX(Seed, X, GridX));
      Std.Arrays.Push(LakeRowGrids, GridY);
      Std.Arrays.Push(LakeRowOffsets, LakeOffsetY(Seed, Y, GridY));
    end;
  end for;
  // Lake radii depend only on the lake grid cell, which changes about every thousand fields.
  mutable var RadiusGridX: integer := LakeColumnGrids[0];
  mutable var RadiusGridY: integer := LakeRowGrids[0];
  mutable var RadiusX: integer := LakeRadiusX(Seed, RadiusGridX, RadiusGridY);
  mutable var RadiusY: integer := LakeRadiusY(Seed, RadiusGridX, RadiusGridY);
  for LocalY: integer := 0 to WorldChunkSize - 1 do
    begin
      var Y: integer := OriginY + LocalY;
      var RowRiverOffset: integer := RiverShift(Seed, Y);
      for LocalX: integer := 0 to WorldChunkSize - 1 do
        begin
          var X: integer := OriginX + LocalX;
          if (LakeColumnGrids[LocalX] <> RadiusGridX) or (LakeRowGrids[LocalY] <> RadiusGridY) then
            begin
              RadiusGridX := LakeColumnGrids[LocalX];
              RadiusGridY := LakeRowGrids[LocalY];
              RadiusX := LakeRadiusX(Seed, RadiusGridX, RadiusGridY);
              RadiusY := LakeRadiusY(Seed, RadiusGridX, RadiusGridY);
            end;
          end if;
          var Sample: TerrainGenerationSample := ComposeTerrainSample(SampleNoiseAt(ContinentalWideGrid, ContinentalWideAxes, LocalX, LocalY), SampleNoiseAt(ContinentalRegionalGrid, ContinentalRegionalAxes, LocalX, LocalY), SampleNoiseAt(RegionalElevationGrid, RegionalElevationAxes, LocalX, LocalY), SampleNoiseAt(CoastDetailGrid, CoastDetailAxes, LocalX, LocalY), SampleNoiseAt(MoistureRegionalGrid, MoistureRegionalAxes, LocalX, LocalY), SampleNoiseAt(MoistureDetailGrid, MoistureDetailAxes, LocalX, LocalY), SampleNoiseAt(VegetationRegionalGrid, VegetationRegionalAxes, LocalX, LocalY), SampleNoiseAt(LakeShapeGrid, LakeShapeAxes, LocalX, LocalY));
          var Lake: LakeSite := record
            OffsetX := LakeColumnOffsets[LocalX];
            OffsetY := LakeRowOffsets[LocalY];
            RadiusX := RadiusX;
            RadiusY := RadiusY;
          end;

          Std.Arrays.Push(Cells, GenerateCellFromInputs(Seed, X, Y, RowRiverOffset, PathOffsets[LocalX], Sample, Lake));
        end;
      end for;
    end;
  end for;

  return record
    Coordinate := Coordinate;
    Cells := Cells;
  end;
end function;

// Validates a loaded chunk's shape and terrain-layer invariants.
public function ValidateChunk(Chunk: WorldChunk): result of WorldChunk, string;
begin
  if Std.Arrays.Length(Chunk.Cells) <> WorldChunkSize * WorldChunkSize then
    begin
      return Error('chunk cell count must match 128 by 128 chunk size');
    end;
  end if;

  for Cell: WorldCell in Chunk.Cells do
    begin
      if Cell.Base = BaseTerrainKind.Water then
        begin
          if Cell.Water = WaterKind.NoWater then
            begin
              return Error('water terrain must have a water classification');
            end;
          end if;
        end;
      else
        begin
          if Cell.Water <> WaterKind.NoWater then
            begin
              return Error('non-water terrain must not have a water classification');
            end;
          end if;

          if Cell.Feature = TerrainFeatureKind.River then
            begin
              return Error('river feature requires water terrain');
            end;
          end if;
        end;
      end if;

      if ((Cell.Feature = TerrainFeatureKind.Tree) or (Cell.Feature = TerrainFeatureKind.Forest)) or
         ((Cell.Feature = TerrainFeatureKind.Path) or (Cell.Feature = TerrainFeatureKind.Entrance)) then
        begin
          if Cell.Base = BaseTerrainKind.Water then
            begin
              return Error('forest and path features require land terrain');
            end;
          end if;
        end;
      end if;

      if Cell.Feature = TerrainFeatureKind.River then
        begin
          if Cell.Water <> WaterKind.RiverWater then
            begin
              return Error('river feature requires river water classification');
            end;
          end if;
        end;
      end if;
    end;
  end for;

  return Ok(Chunk);
end function;
end unit;
