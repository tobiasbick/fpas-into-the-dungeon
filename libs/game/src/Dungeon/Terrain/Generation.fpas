// Deterministic natural outdoor terrain: layers, rivers, paths, lakes, and natural chunks without entrances.
unit Dungeon.Terrain.Generation;

uses Dungeon.Coordinates as Coordinates, Dungeon.Terrain as Terrain, Dungeon.Terrain.Noise as Noise;

// Position of one cell relative to its nearest periodic lake center, and that lake's radii.
type LakeSite = record
  OffsetX: integer;
  OffsetY: integer;
  RadiusX: integer;
  RadiusY: integer;
end record;

const SeaLevel: integer := 460;
const MountainRuggedness: integer := 790;
const LakePeriodX: integer := 997;
const LakePeriodY: integer := 743;

function ComposeTerrainSample(
  ContinentalWide: integer;
  ContinentalRegional: integer;
  RegionalElevation: integer;
  CoastDetail: integer;
  MoistureRegional: integer;
  MoistureDetail: integer;
  VegetationRegional: integer;
  LakeShape: integer
): Terrain.TerrainGenerationSample;
begin
  const Continentalness: integer := ((ContinentalWide * 2) + ContinentalRegional) div 3;
  var LandScore: integer := (((Continentalness * 6) + (RegionalElevation * 3)) + CoastDetail) div
    10;
  const LandBridge: integer := Noise.RidgeValue(ContinentalRegional);
  if LandBridge > 900 then
    begin
      const BridgeLandScore: integer := SeaLevel + ((LandBridge - 900) * 2);
      if BridgeLandScore > LandScore then
        begin
          LandScore := BridgeLandScore;
        end;
      end if;
    end;
  end if;

  return Terrain.TerrainGenerationSample(
    Continentalness := Continentalness,
    Elevation := (((LandScore * 5) + (RegionalElevation * 3)) + (CoastDetail * 2)) div
    10, Moisture := ((MoistureRegional * 2) + MoistureDetail) div
    3,
    Vegetation := ((((MoistureRegional * 2) + MoistureDetail) * 3) + (VegetationRegional * 2)) div
    11, LakeShape := LakeShape,
    Ruggedness := ((Noise.RidgeValue(RegionalElevation) * 3) + (CoastDetail * 2)) div
    5, LandScore := LandScore, LandBridge := LandBridge
  );
end function;

// Samples every terrain layer at one coordinate without precomputed grids.
public function SampleTerrainAtSeed(Seed: integer; X: integer; Y: integer): Terrain.TerrainGenerationSample;
begin
  return ComposeTerrainSample(
    Noise.ValueNoise(Seed, X, Y, 8192, 11),
    Noise.ValueNoise(Seed, X, Y, 4096, 13),
    Noise.ValueNoise(Seed, X, Y, 1024, 17),
    Noise.ValueNoise(Seed, X, Y, 256, 19),
    Noise.ValueNoise(Seed, X, Y, 2048, 23),
    Noise.ValueNoise(Seed, X, Y, 384, 29),
    Noise.ValueNoise(Seed, X, Y, 512, 31),
    Noise.ValueNoise(Seed, X, Y, 48, 41)
  );
end function;

// Returns the seeded lateral offset of the river course in one row.
public function RiverShift(Seed: integer; Y: integer): integer;
begin
  return (Noise.ValueNoise(Seed, 0, Y, 512, 71) - 500) div 2;
end function;

// Returns the seeded lateral offset of the path course in one column.
public function PathShift(Seed: integer; X: integer): integer;
begin
  return (Noise.ValueNoise(Seed, X, 0, 144, 89) - 500) div 3;
end function;

function LakeGridX(Seed: integer; X: integer): integer;
begin
  return Noise.NearestPeriodicIndex(X, Coordinates.PositiveModulo(Seed, LakePeriodX), LakePeriodX);
end function;

function LakeGridY(Seed: integer; Y: integer): integer;
begin
  return Noise.NearestPeriodicIndex(Y, Coordinates.PositiveModulo(Seed, LakePeriodY), LakePeriodY);
end function;

function LakeOffsetX(Seed: integer; X: integer; GridX: integer): integer;
begin
  return (X + Coordinates.PositiveModulo(Seed, LakePeriodX)) - (GridX * LakePeriodX);
end function;

function LakeOffsetY(Seed: integer; Y: integer; GridY: integer): integer;
begin
  return (Y + Coordinates.PositiveModulo(Seed, LakePeriodY)) - (GridY * LakePeriodY);
end function;

function LakeRadiusX(Seed: integer; GridX: integer; GridY: integer): integer;
begin
  return 42 + (Noise.CoordinateHash(Seed, GridX, GridY, 43) mod 25);
end function;

function LakeRadiusY(Seed: integer; GridX: integer; GridY: integer): integer;
begin
  return 26 + (Noise.CoordinateHash(Seed, GridX, GridY, 47) mod 17);
end function;

// Computes the complete lake site of one cell without chunk-level reuse.
function LakeSiteAt(Seed: integer; X: integer; Y: integer): LakeSite;
begin
  const GridX: integer := LakeGridX(Seed, X);
  const GridY: integer := LakeGridY(Seed, Y);
  return LakeSite(
    OffsetX := LakeOffsetX(Seed, X, GridX),
    OffsetY := LakeOffsetY(Seed, Y, GridY),
    RadiusX := LakeRadiusX(Seed, GridX, GridY),
    RadiusY := LakeRadiusY(Seed, GridX, GridY)
  );
end function;

function GenerateCellFromInputs(
  Seed: integer;
  X: integer;
  Y: integer;
  RiverOffset: integer;
  PathOffset: integer;
  Sample: Terrain.TerrainGenerationSample;
  Lake: LakeSite
): Terrain.WorldCell;
begin
  const LakeScore: integer := (
    (((Lake.OffsetX * Lake.OffsetX) * 1000) div (Lake.RadiusX * Lake.RadiusX)) +
    (((Lake.OffsetY * Lake.OffsetY) * 1000) div (Lake.RadiusY * Lake.RadiusY))
  ) +
    ((Sample.LakeShape - 500) div 2);
  if Sample.LandScore < SeaLevel then
    begin
      return Terrain.WaterCell(Terrain.WaterKind.Sea, Terrain.TerrainFeatureKind.NoFeature);
    end;
  end if;

  if ((LakeScore < 1000) and (Sample.LandScore > SeaLevel + 30)) and (Sample.Elevation < 740) then
    begin
      return Terrain.WaterCell(Terrain.WaterKind.Lake, Terrain.TerrainFeatureKind.NoFeature);
    end;
  end if;

  if (Sample.Elevation < 800) and (Noise.PeriodicDistance(X - RiverOffset, 1024) <= 1) then
    begin
      return Terrain.WaterCell(Terrain.WaterKind.RiverWater, Terrain.TerrainFeatureKind.River);
    end;
  end if;
  var Cell: Terrain.WorldCell := Terrain.PlainCell();
  if (Sample.Ruggedness > MountainRuggedness) and (Sample.Elevation > 520) then
    begin
      Cell.Base := Terrain.BaseTerrainKind.Rock;
    end;
  else
    begin
      if Sample.Moisture < 285 then
        begin
          Cell.Base := Terrain.BaseTerrainKind.Sand;
        end;
      else
        begin
          if Sample.Vegetation >= 650 then
            begin
              Cell.Feature := Terrain.TerrainFeatureKind.Forest;
            end;
          else
            begin
              // Only single trees need the per-coordinate detail hash.
              const Detail: integer := Noise.CoordinateDetail(Seed, X, Y);
              if ((Sample.Vegetation >= 540) and (Detail > 300))
                or
                ((Sample.Moisture >= 450) and (Detail > 960))
              then
                begin
                  Cell.Feature := Terrain.TerrainFeatureKind.Tree;
                end;
              end if;
            end;
          end if;
        end;
      end if;
    end;
  end if;

  if (Cell.Base <> Terrain.BaseTerrainKind.Rock)
    and
    (Noise.PeriodicDistance(Y - PathOffset, 768) <= 1)
  then
    begin
      Cell.Feature := Terrain.TerrainFeatureKind.Path;
    end;
  end if;

  return Cell;
end function;

// Generates one cell from precomputed river and path offsets.
public function GenerateCellWithShifts(
  Seed: integer;
  X: integer;
  Y: integer;
  RiverOffset: integer;
  PathOffset: integer
): Terrain.WorldCell;
begin
  return GenerateCellFromInputs(
    Seed,
    X,
    Y,
    RiverOffset,
    PathOffset,
    SampleTerrainAtSeed(Seed, X, Y),
    LakeSiteAt(Seed, X, Y)
  );
end function;

// Generates one outdoor cell from the seed alone.
public function NaturalCell(Seed: integer; X: integer; Y: integer): Terrain.WorldCell;
begin
  return GenerateCellWithShifts(Seed, X, Y, RiverShift(Seed, Y), PathShift(Seed, X));
end function;

// Samples normalized generator fields for previews, diagnostics, and distribution tests.
public function SampleWorldGeneration(Metadata: Terrain.WorldMetadata; X: integer; Y: integer): Terrain.TerrainGenerationSample;
begin
  if Metadata.GeneratorVersion <> Terrain.WorldGeneratorVersion then
    begin
      panic('unsupported world generator version');
    end;
  end if;

  return SampleTerrainAtSeed(Metadata.Seed, X, Y);
end function;

// Generates one complete chunk of natural terrain, without entrances, independently of order.
public function GenerateNaturalChunk(Seed: integer; Coordinate: Coordinates.ChunkCoordinate): Terrain.WorldChunk;
begin
  var Cells: array of Terrain.WorldCell := [];
  const OriginX: integer := Coordinate.X * Coordinates.WorldChunkSize;
  const OriginY: integer := Coordinate.Y * Coordinates.WorldChunkSize;
  const ContinentalWideGrid: Noise.NoiseGrid := Noise.BuildNoiseGrid(
    Seed,
    OriginX,
    OriginY,
    8192,
    11
  );
  const ContinentalRegionalGrid: Noise.NoiseGrid := Noise.BuildNoiseGrid(
    Seed,
    OriginX,
    OriginY,
    4096,
    13
  );
  const RegionalElevationGrid: Noise.NoiseGrid := Noise.BuildNoiseGrid(
    Seed,
    OriginX,
    OriginY,
    1024,
    17
  );
  const CoastDetailGrid: Noise.NoiseGrid := Noise.BuildNoiseGrid(Seed, OriginX, OriginY, 256, 19);
  const MoistureRegionalGrid: Noise.NoiseGrid := Noise.BuildNoiseGrid(
    Seed,
    OriginX,
    OriginY,
    2048,
    23
  );
  const MoistureDetailGrid: Noise.NoiseGrid := Noise.BuildNoiseGrid(
    Seed,
    OriginX,
    OriginY,
    384,
    29
  );
  const VegetationRegionalGrid: Noise.NoiseGrid := Noise.BuildNoiseGrid(
    Seed,
    OriginX,
    OriginY,
    512,
    31
  );
  const LakeShapeGrid: Noise.NoiseGrid := Noise.BuildNoiseGrid(Seed, OriginX, OriginY, 48, 41);
  const ContinentalWideAxes: Noise.NoiseGridAxes := Noise.BuildNoiseGridAxes(
    ContinentalWideGrid,
    OriginX,
    OriginY
  );
  const ContinentalRegionalAxes: Noise.NoiseGridAxes := Noise.BuildNoiseGridAxes(
    ContinentalRegionalGrid,
    OriginX,
    OriginY
  );
  const RegionalElevationAxes: Noise.NoiseGridAxes := Noise.BuildNoiseGridAxes(
    RegionalElevationGrid,
    OriginX,
    OriginY
  );
  const CoastDetailAxes: Noise.NoiseGridAxes := Noise.BuildNoiseGridAxes(
    CoastDetailGrid,
    OriginX,
    OriginY
  );
  const MoistureRegionalAxes: Noise.NoiseGridAxes := Noise.BuildNoiseGridAxes(
    MoistureRegionalGrid,
    OriginX,
    OriginY
  );
  const MoistureDetailAxes: Noise.NoiseGridAxes := Noise.BuildNoiseGridAxes(
    MoistureDetailGrid,
    OriginX,
    OriginY
  );
  const VegetationRegionalAxes: Noise.NoiseGridAxes := Noise.BuildNoiseGridAxes(
    VegetationRegionalGrid,
    OriginX,
    OriginY
  );
  const LakeShapeAxes: Noise.NoiseGridAxes := Noise.BuildNoiseGridAxes(
    LakeShapeGrid,
    OriginX,
    OriginY
  );
  var PathOffsets: array of integer := [];
  var LakeColumnGrids: array of integer := [];
  var LakeColumnOffsets: array of integer := [];
  var LakeRowGrids: array of integer := [];
  var LakeRowOffsets: array of integer := [];
  for Local: integer := 0 to Coordinates.WorldChunkSize - 1 do
    begin
      const X: integer := OriginX + Local;
      const Y: integer := OriginY + Local;
      PathOffsets.PushInPlace(PathShift(Seed, X));
      const GridX: integer := LakeGridX(Seed, X);
      const GridY: integer := LakeGridY(Seed, Y);
      LakeColumnGrids.PushInPlace(GridX);
      LakeColumnOffsets.PushInPlace(LakeOffsetX(Seed, X, GridX));
      LakeRowGrids.PushInPlace(GridY);
      LakeRowOffsets.PushInPlace(LakeOffsetY(Seed, Y, GridY));
    end;
  end for;
  // Lake radii depend only on the lake grid cell, which changes about every thousand fields.
  var RadiusGridX: integer := LakeColumnGrids[0];
  var RadiusGridY: integer := LakeRowGrids[0];
  var RadiusX: integer := LakeRadiusX(Seed, RadiusGridX, RadiusGridY);
  var RadiusY: integer := LakeRadiusY(Seed, RadiusGridX, RadiusGridY);
  for LocalY: integer := 0 to Coordinates.WorldChunkSize - 1 do
    begin
      const Y: integer := OriginY + LocalY;
      const RowRiverOffset: integer := RiverShift(Seed, Y);
      for LocalX: integer := 0 to Coordinates.WorldChunkSize - 1 do
        begin
          const X: integer := OriginX + LocalX;
          if (LakeColumnGrids[LocalX] <> RadiusGridX) or (LakeRowGrids[LocalY] <> RadiusGridY) then
            begin
              RadiusGridX := LakeColumnGrids[LocalX];
              RadiusGridY := LakeRowGrids[LocalY];
              RadiusX := LakeRadiusX(Seed, RadiusGridX, RadiusGridY);
              RadiusY := LakeRadiusY(Seed, RadiusGridX, RadiusGridY);
            end;
          end if;
          const Sample: Terrain.TerrainGenerationSample := ComposeTerrainSample(
            Noise.SampleNoiseAt(ContinentalWideGrid, ContinentalWideAxes, LocalX, LocalY),
            Noise.SampleNoiseAt(ContinentalRegionalGrid, ContinentalRegionalAxes, LocalX, LocalY),
            Noise.SampleNoiseAt(RegionalElevationGrid, RegionalElevationAxes, LocalX, LocalY),
            Noise.SampleNoiseAt(CoastDetailGrid, CoastDetailAxes, LocalX, LocalY),
            Noise.SampleNoiseAt(MoistureRegionalGrid, MoistureRegionalAxes, LocalX, LocalY),
            Noise.SampleNoiseAt(MoistureDetailGrid, MoistureDetailAxes, LocalX, LocalY),
            Noise.SampleNoiseAt(VegetationRegionalGrid, VegetationRegionalAxes, LocalX, LocalY),
            Noise.SampleNoiseAt(LakeShapeGrid, LakeShapeAxes, LocalX, LocalY)
          );
          const Lake: LakeSite := LakeSite(
            OffsetX := LakeColumnOffsets[LocalX],
            OffsetY := LakeRowOffsets[LocalY],
            RadiusX := RadiusX,
            RadiusY := RadiusY
          );
          Cells.PushInPlace(
            GenerateCellFromInputs(Seed, X, Y, RowRiverOffset, PathOffsets[LocalX], Sample, Lake)
          );
        end;
      end for;
    end;
  end for;

  return Terrain.WorldChunk(Coordinate := Coordinate, Cells := Cells);
end function;

// Validates a loaded chunk's shape and terrain-layer invariants.
public function ValidateChunk(Chunk: Terrain.WorldChunk): result of (Terrain.WorldChunk, string);
begin
  if Chunk.Cells.Length() <> Coordinates.WorldChunkSize * Coordinates.WorldChunkSize then
    begin
      return Error('chunk cell count must match 128 by 128 chunk size');
    end;
  end if;

  for Cell: Terrain.WorldCell in Chunk.Cells do
    begin
      if Cell.Base = Terrain.BaseTerrainKind.Water then
        begin
          if Cell.Water = Terrain.WaterKind.NoWater then
            begin
              return Error('water terrain must have a water classification');
            end;
          end if;
        end;
      else
        begin
          if Cell.Water <> Terrain.WaterKind.NoWater then
            begin
              return Error('non-water terrain must not have a water classification');
            end;
          end if;

          if Cell.Feature = Terrain.TerrainFeatureKind.River then
            begin
              return Error('river feature requires water terrain');
            end;
          end if;
        end;
      end if;

      if (
        (Cell.Feature = Terrain.TerrainFeatureKind.Tree)
        or
        (Cell.Feature = Terrain.TerrainFeatureKind.Forest)
      )
        or
        (
          (Cell.Feature = Terrain.TerrainFeatureKind.Path)
          or
          (Cell.Feature = Terrain.TerrainFeatureKind.Entrance)
        )
      then
        begin
          if Cell.Base = Terrain.BaseTerrainKind.Water then
            begin
              return Error('forest and path features require land terrain');
            end;
          end if;
        end;
      end if;

      if Cell.Feature = Terrain.TerrainFeatureKind.River then
        begin
          if Cell.Water <> Terrain.WaterKind.RiverWater then
            begin
              return Error('river feature requires river water classification');
            end;
          end if;
        end;
      end if;
    end;
  end for;

  return Ok(Chunk);
end function;
end unit;
