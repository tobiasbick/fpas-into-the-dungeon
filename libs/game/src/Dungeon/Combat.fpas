// Turn-based combat: player actions, dice, opponent perception, pathfinding, attacks, and defeat.
unit Dungeon.Combat;

uses
  Dungeon.Coordinates, Dungeon.Equipment, Dungeon.Exploration.Sight, Dungeon.GameState,
  Dungeon.Hostiles, Dungeon.Interaction, Dungeon.Interior, Dungeon.Movement, Dungeon.Random,
  Dungeon.Terrain, Std.Conv, Std.Math;

// Upper bound of messages and of structured events reported for one resolved turn.
public const MaximumTurnLogEntries: integer := 8;
// Lowest d20 roll with which the restless skeleton hits an unarmored player.
public const RestlessSkeletonHitThreshold: integer := 9;
// Damage die of the restless skeleton's blow.
public const RestlessSkeletonDamageSides: integer := 4;

// One time-consuming player intention; turning and interaction never consume a turn.
public type TurnAction = enum
  Step(Direction: RelativeStep);
  Attack;
  Wait;
  // Wears a carried item; an item already worn in its slot returns to the inventory.
  Equip(ItemId: string);
  // Returns a worn item to the inventory.
  Unequip(ItemId: string);
  // Lays a carried item on the occupied dungeon floor field.
  Drop(ItemId: string);
end enum;

// Kind of one structured fact of a resolved turn; presentation animates these.
public type CombatEventKind = enum
  PlayerHit;
  PlayerMiss;
  HostileHit;
  HostileMiss;
  HostileDefeated;
end enum;

// One structured fact of a resolved turn; Amount is the damage dealt, otherwise zero.
public type CombatEvent = record
  public Kind: CombatEventKind;
  public Amount: integer;
end record;

// Result of one accepted turn. Defeated ends the game session and carries no state.
public type TurnOutcome = enum
  Continued(State: GameState; Log: array of string; Events: array of CombatEvent);
  Defeated(Log: array of string);
end enum;

type DiceRoll = record
  State: GameState;
  Value: integer;
end record;

type TurnProgress = record
  State: GameState;
  Log: array of string;
  Events: array of CombatEvent;
  PlayerDefeated: boolean;
end record;

// Advances the persisted linear congruential generator and returns 1 through Sides.
function Roll(State: GameState; Sides: integer): DiceRoll;
begin
  const Draw: RandomDraw := DrawBelow(State.RandomState, Sides);
  return DiceRoll(State := State with RandomState := Draw.State; end with, Value := Draw.Value + 1);
end function;

function Logged(Progress: TurnProgress; Message: string): TurnProgress;
begin
  var Log: array of string := Progress.Log;
  if Log.Length() < MaximumTurnLogEntries then
    begin
      Log.Push(Message);
    end;
  end if;

  return Progress with Log := Log; end with;
end function;

function Happened(Progress: TurnProgress; Kind: CombatEventKind; Amount: integer): TurnProgress;
begin
  var Events: array of CombatEvent := Progress.Events;
  if Events.Length() < MaximumTurnLogEntries then
    begin
      Events.Push(CombatEvent(Kind := Kind, Amount := Amount));
    end;
  end if;

  return Progress with Events := Events; end with;
end function;

function WithHostile(State: GameState; Index: integer; Hostile: GameHostile): GameState;
begin
  var Hostiles: array of GameHostile := State.Hostiles;
  Hostiles[Index] := Hostile;
  return State with Hostiles := Hostiles; end with;
end function;

function Distance(Left: InteriorPosition; Right: InteriorPosition): integer;
begin
  return Std.Math.Max(Std.Math.Abs(Left.X - Right.X), Std.Math.Abs(Left.Y - Right.Y));
end function;

function IsOrthogonallyAdjacent(Left: InteriorPosition; Right: InteriorPosition): boolean;
begin
  return (Std.Math.Abs(Left.X - Right.X) + Std.Math.Abs(Left.Y - Right.Y)) = 1;
end function;

// Either direction of the Bresenham line suffices, so perception is symmetric.
function CanSee(Map: InteriorMap; Hostile: InteriorPosition; Player: InteriorPosition): boolean;
begin
  if Distance(Hostile, Player) > HostileSightRange then
    begin
      return false;
    end;
  end if;

  return HasLineOfSight(Map, Hostile, Player) or HasLineOfSight(Map, Player, Hostile);
end function;

function Blocked(Map: InteriorMap; State: GameState; Position: InteriorPosition): boolean;
begin
  case InteriorCellAt(Map, Position) of
    when Ok(const Cell):
      begin
        if Cell = InteriorCellKind.Wall then
          begin
            return true;
          end;
        end if;
      end;
    when Error(const Message):
      begin
        return true;
      end;
  end case;

  return StandingHostileAt(State, State.AreaId, Position) >= 0;
end function;

// Returns the first field of a shortest path from Start to Goal, or Start when no path exists.
// Neighbors are explored north, east, south, west, so equal paths resolve deterministically.
function NextStepToward(
  Map: InteriorMap;
  State: GameState;
  Start: InteriorPosition;
  Goal: InteriorPosition
): InteriorPosition;
begin
  const Offsets: array of InteriorPosition := [
                                                InteriorPosition(X := 0, Y := -1),
                                                InteriorPosition(X := 1, Y := 0),
                                                InteriorPosition(X := 0, Y := 1),
                                                InteriorPosition(X := -1, Y := 0)
                                              ];
  const FieldCount: integer := Map.Width * Map.Height;
  // Each visited field remembers the first step taken from Start to reach it.
  var FirstStep: array of integer := array.Fill(-1, FieldCount);
  var Queue: array of InteriorPosition := [];
  for Offset: InteriorPosition in Offsets do
    begin
      const Candidate: InteriorPosition := InteriorPosition(X := Start.X + Offset.X, Y := Start.Y +
                                                                                          Offset.Y);
      if SamePosition(Candidate, Goal) then
        begin
          return Candidate;
        end;
      end if;

      if not Blocked(Map, State, Candidate) then
        begin
          const Index: integer := (Candidate.Y * Map.Width) + Candidate.X;
          if FirstStep[Index] < 0 then
            begin
              FirstStep[Index] := Index;
              Queue.Push(Candidate);
            end;
          end if;
        end;
      end if;
    end;
  end for;
  var ReadIndex: integer := 0;
  while ReadIndex < Queue.Length() do
    begin
      const Current: InteriorPosition := Queue[ReadIndex];
      const CurrentFirst: integer := FirstStep[(Current.Y * Map.Width) + Current.X];
      ReadIndex := ReadIndex + 1;
      for Offset: InteriorPosition in Offsets do
        begin
          const Candidate: InteriorPosition := InteriorPosition(X := Current.X + Offset.X, Y := Current.Y +
                                                                                                Offset.Y);
          if SamePosition(Candidate, Goal) then
            begin
              return InteriorPosition(X := CurrentFirst mod Map.Width, Y := CurrentFirst div
                                                                            Map.Width);
            end;
          end if;

          if not Blocked(Map, State, Candidate) and not SamePosition(Candidate, Start) then
            begin
              const Index: integer := (Candidate.Y * Map.Width) + Candidate.X;
              if FirstStep[Index] < 0 then
                begin
                  FirstStep[Index] := CurrentFirst;
                  Queue.Push(Candidate);
                end;
              end if;
            end;
          end if;
        end;
      end for;
    end;
  end while;

  return Start;
end function;

// Lets one standing opponent in the player's area notice, approach, or attack the player.
function HostileTurn(
  Progress: TurnProgress;
  Index: integer;
  Map: InteriorMap;
  Player: InteriorPosition
): TurnProgress;
begin
  const Hostile: GameHostile := Progress.State.Hostiles[Index];
  const Name: string := HostileDisplayName(Hostile.Kind);
  if not Hostile.Alerted then
    begin
      if not CanSee(Map, Hostile.Position, Player) then
        begin
          return Progress;
        end;
      end if;

      return Logged(Progress with State := WithHostile(Progress.State, Index, Hostile with Alerted := true; end with); end with, ('The ' + Name) +
                                                                                                                                 ' notices you.');
    end;
  end if;

  if IsOrthogonallyAdjacent(Hostile.Position, Player) then
    begin
      const HitRoll: DiceRoll := Roll(Progress.State, 20);
      // Armor raises the roll the opponent needs.
      if HitRoll.Value < RestlessSkeletonHitThreshold + DeriveCharacterValues(Progress.State).Armor then
        begin
          return Happened(Logged(Progress with State := HitRoll.State; end with, ('The ' + Name) +
                                                                                 ' misses you.'), CombatEventKind.HostileMiss, 0);
        end;
      end if;
      const DamageRoll: DiceRoll := Roll(HitRoll.State, RestlessSkeletonDamageSides);
      const Health: integer := Std.Math.Max(0, DamageRoll.State.Health - DamageRoll.Value);
      const Hurt: TurnProgress := Happened(Logged(Progress with State := (DamageRoll.State with Health := Std.Math.Max(1, Health); end with); end with, ((('The ' + Name) + ' strikes you for ') + IntToStr(DamageRoll.Value)) +
                                                                                                                                                        '.'), CombatEventKind.HostileHit, DamageRoll.Value);
      if Health = 0 then
        begin
          return Logged(Hurt with PlayerDefeated := true; end with, 'You have fallen.');
        end;
      end if;

      return Hurt;
    end;
  end if;
  const Next: InteriorPosition := NextStepToward(Map, Progress.State, Hostile.Position, Player);
  if SamePosition(Next, Player) then
    begin
      return Progress;
    end;
  end if;

  return Progress with State := WithHostile(Progress.State, Index, Hostile with Position := Next; end with); end with;
end function;

// Resolves the opponents' part of a turn after the player's accepted action.
function HostilePhase(View: AreaView; Progress: TurnProgress): result of (TurnProgress, string);
begin
  const Pose: FirstPersonPose := try FirstPersonPlayerPose(Progress.State);
  const Map: InteriorMap := try CurrentInterior(View, Progress.State);
  var Current: TurnProgress := Progress;
  for Index: integer := 0 to Current.State.Hostiles.Length() - 1 do
    begin
      const Hostile: GameHostile := Current.State.Hostiles[Index];
      if ((Hostile.Health > 0) and (Hostile.AreaId = Current.State.AreaId)) and
         not Current.PlayerDefeated then
        begin
          Current := HostileTurn(Current, Index, Map, Pose.Position);
        end;
      end if;
    end;
  end for;

  return Ok(Current);
end function;

function PlayerAttack(Valid: GameState): result of (TurnProgress, string);
begin
  const Index: integer := HostileAhead(Valid);
  if Index < 0 then
    begin
      return Error('there is nothing to attack');
    end;
  end if;
  const Hostile: GameHostile := Valid.Hostiles[Index];
  const Name: string := HostileDisplayName(Hostile.Kind);
  const Start: TurnProgress := TurnProgress(State := Valid, Log := [], Events := [], PlayerDefeated := false);
  const Values: CharacterValues := DeriveCharacterValues(Valid);
  const HitRoll: DiceRoll := Roll(Valid, 20);
  // Being attacked always alerts the opponent, even when the blow misses.
  const Alerted: GameHostile := Hostile with Alerted := true; end with;

  if HitRoll.Value < Values.HitThreshold then
    begin
      return Ok(Happened(Logged(Start with State := WithHostile(HitRoll.State, Index, Alerted); end with, ('You miss the ' + Name) +
                                                                                                          '.'), CombatEventKind.PlayerMiss, 0));
    end;
  end if;
  const DamageRoll: DiceRoll := Roll(HitRoll.State, Values.DamageSides);
  const Damage: integer := DamageRoll.Value + Values.DamageBonus;
  const Remaining: integer := Std.Math.Max(0, Hostile.Health - Damage);
  const Struck: TurnProgress := Happened(Logged(Start with State := WithHostile(DamageRoll.State, Index, Alerted with Health := Remaining; end with); end with, ((('You hit the ' + Name) + ' for ') + IntToStr(Damage)) +
                                                                                                                                                                '.'), CombatEventKind.PlayerHit, Damage);
  if Remaining = 0 then
    begin
      return Ok(Happened(Logged(Struck, ('The ' + Name) + ' collapses into a heap of bones.'), CombatEventKind.HostileDefeated, 0));
    end;
  end if;

  return Ok(Struck);
end function;

// Resolves one time-consuming player action followed by the opponents' turn.
// Rejected actions return Error and leave time and the dice untouched.
public function ResolveTurn(View: AreaView; State: GameState; Action: TurnAction): result of (TurnOutcome, string);
begin
  const Valid: GameState := try ValidateGameState(View, State);
  var Progress: TurnProgress := TurnProgress(State := Valid, Log := [], Events := [], PlayerDefeated := false);
  case Action of
    when TurnAction.Step(const Direction):
      begin
        Progress.State := try StepFirstPerson(View, Valid, Direction);
      end;
    when TurnAction.Attack:
      begin
        if Valid.Area <> AreaKind.Dungeon then
          begin
            return Error('there is nothing to attack');
          end;
        end if;

        Progress := try PlayerAttack(Valid);
      end;
    when TurnAction.Wait:
      begin
        Progress := Logged(Progress, 'You wait.');
      end;
    when TurnAction.Equip(const ItemId):
      begin
        const Change: EquipmentChange := try EquipItem(Valid, ItemId);
        Progress := Logged(Progress with State := Change.State; end with, Change.Message);
      end;
    when TurnAction.Unequip(const ItemId):
      begin
        const Change: EquipmentChange := try UnequipItem(Valid, ItemId);
        Progress := Logged(Progress with State := Change.State; end with, Change.Message);
      end;
    when TurnAction.Drop(const ItemId):
      begin
        const Change: EquipmentChange := try DropItem(View, Valid, ItemId);
        Progress := Logged(Progress with State := Change.State; end with, Change.Message);
      end;
  end case;

  if Progress.State.Area = AreaKind.Dungeon then
    begin
      Progress := try HostilePhase(View, Progress);
    end;
  end if;

  if Progress.PlayerDefeated then
    begin
      return Ok(TurnOutcome.Defeated(Progress.Log));
    end;
  end if;

  return Ok(TurnOutcome.Continued(try ValidateGameState(View, Progress.State), Progress.Log, Progress.Events));
end function;
end unit;
