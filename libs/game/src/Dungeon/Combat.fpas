// Turn-based combat: player actions, dice, opponent perception, attacks, skill practice, and defeat.
unit Dungeon.Combat;

uses Dungeon.Combat.Navigation as Navigation, Dungeon.Consumables as Consumables, Dungeon.Coordinates as Coordinates, Dungeon.Equipment as Equipment, Dungeon.Exploration.Sight as Sight, Dungeon.GameState as GameState, Dungeon.Hostiles as HostileRules, Dungeon.Interaction as Interaction, Dungeon.Interior as InteriorUnit, Dungeon.Movement as Movement, Dungeon.Progression as Progression, Dungeon.Random as Random, Dungeon.Terrain as Terrain, Std.Conv as Conv, Std.Math as Math;

// Upper bound of messages and of structured events reported for one resolved turn.
public const MaximumTurnLogEntries: integer := 8;

// One time-consuming player intention; turning and interaction never consume a turn.
public type TurnAction = enum
  Step(Direction: Coordinates.RelativeStep);
  Attack;
  Wait;
  // Wears a carried item; an item already worn in its slot returns to the inventory.
  Equip(ItemId: string);
  // Returns a worn item to the inventory.
  Unequip(ItemId: string);
  // Lays a carried item on the occupied dungeon floor field.
  Drop(ItemId: string);
  // Consumes one carried healing potion before the opponents act.
  UseItem(ItemId: string);
end enum;

// Kind of one structured fact of a resolved turn; presentation animates these.
public type CombatEventKind = enum
  PlayerHit;
  PlayerMiss;
  HostileHit;
  HostileMiss;
  HostileDefeated;
end enum;

// One structured fact of a resolved turn; Amount is the damage dealt, otherwise zero.
public type CombatEvent = record
  public Kind: CombatEventKind;
  public Amount: integer;
  // Target for player events, actor for hostile events, retained after death.
  public HostileKind: HostileRules.HostileKind;
end record;

// Result of one accepted turn. Defeated ends the game session and carries no state.
public type TurnOutcome = enum
  Continued(State: GameState.GameState; Log: array of string; Events: array of CombatEvent);
  Defeated(Log: array of string);
end enum;

type DiceRoll = record
  State: GameState.GameState;
  Value: integer;
end record;

type TurnProgress = record
  State: GameState.GameState;
  Log: array of string;
  Events: array of CombatEvent;
  PlayerDefeated: boolean;
end record;

// Advances the persisted linear congruential generator and returns 1 through Sides.
function Roll(State: GameState.GameState; Sides: integer): DiceRoll;
begin
  const Draw: Random.RandomDraw := Random.DrawBelow(State.RandomState, Sides);
  return DiceRoll(State := State with RandomState := Draw.State; end with, Value := Draw.Value + 1);
end function;

function Logged(Progress: TurnProgress; Message: string): TurnProgress;
begin
  var Log: array of string := Progress.Log;
  if Log.Length() < MaximumTurnLogEntries then
    begin
      Log.PushInPlace(Message);
    end;
  end if;

  return Progress with Log := Log; end with;
end function;

function Happened(Progress: TurnProgress; Kind: CombatEventKind; Amount: integer; HostileKind: HostileRules.HostileKind): TurnProgress;
begin
  var Events: array of CombatEvent := Progress.Events;
  if Events.Length() < MaximumTurnLogEntries then
    begin
      Events.PushInPlace(CombatEvent(Kind := Kind, Amount := Amount, HostileKind := HostileKind));
    end;
  end if;

  return Progress with Events := Events; end with;
end function;

function WithHostile(State: GameState.GameState; Index: integer; Hostile: HostileRules.GameHostile): GameState.GameState;
begin
  var Hostiles: array of HostileRules.GameHostile := State.Hostiles;
  Hostiles[Index] := Hostile;
  return State with Hostiles := Hostiles; end with;
end function;

function Distance(Left: Coordinates.InteriorPosition; Right: Coordinates.InteriorPosition): integer;
begin
  return Math.Max(Math.Abs(Left.X - Right.X), Math.Abs(Left.Y - Right.Y));
end function;

function IsOrthogonallyAdjacent(Left: Coordinates.InteriorPosition; Right: Coordinates.InteriorPosition): boolean;
begin
  return (Math.Abs(Left.X - Right.X) + Math.Abs(Left.Y - Right.Y)) = 1;
end function;

// Either direction of the Bresenham line suffices, so perception is symmetric.
function CanSee(Map: InteriorUnit.InteriorMap; Hostile: Coordinates.InteriorPosition; Player: Coordinates.InteriorPosition): boolean;
begin
  if Distance(Hostile, Player) > HostileRules.HostileSightRange then
    begin
      return false;
    end;
  end if;

  return Sight.HasLineOfSight(Map, Hostile, Player) or Sight.HasLineOfSight(Map, Player, Hostile);
end function;

// Lets one standing opponent in the player's area notice, approach, or attack the player.
function HostileTurn(
  Progress: TurnProgress;
  Index: integer;
  Map: InteriorUnit.InteriorMap;
  Player: Coordinates.InteriorPosition
): TurnProgress;
begin
  const Hostile: HostileRules.GameHostile := Progress.State.Hostiles[Index];
  const Name: string := HostileRules.HostileDisplayName(Hostile.Kind);
  if not Hostile.Alerted then
    begin
      if not CanSee(Map, Hostile.Position, Player) then
        begin
          return Progress;
        end;
      end if;

      return Logged(
        Progress with State := WithHostile(
          Progress.State,
          Index,
          Hostile with Alerted := true; end with
        ); end with, ('The ' + Name) +
        ' notices you.'
      );
    end;
  end if;

  if IsOrthogonallyAdjacent(Hostile.Position, Player) then
    begin
      const HitRoll: DiceRoll := Roll(Progress.State, 20);
      // Armor raises the roll the opponent needs.
      if HitRoll.Value <
        HostileRules.HostileHitThreshold(Hostile.Kind) +
        Equipment.DeriveCharacterValues(Progress.State).Armor
      then
        begin
          return Happened(
            Logged(
              Progress with State := HitRoll.State; end with, ('The ' + Name) +
              ' misses you.'
            ), CombatEventKind.HostileMiss, 0, Hostile.Kind
          );
        end;
      end if;
      const DamageRoll: DiceRoll := Roll(
        HitRoll.State,
        HostileRules.HostileDamageSides(Hostile.Kind)
      );
      const Health: integer := Math.Max(0, DamageRoll.State.Health - DamageRoll.Value);
      const Hurt: TurnProgress := Happened(
        Logged(
          Progress with State := (DamageRoll.State with Health := Math.Max(1, Health); end with); end with,
          ((('The ' + Name) + ' strikes you for ') + Conv.IntToStr(DamageRoll.Value)) +
          '.'
        ), CombatEventKind.HostileHit, DamageRoll.Value, Hostile.Kind
      );
      if Health = 0 then
        begin
          return Logged(Hurt with PlayerDefeated := true; end with, 'You have fallen.');
        end;
      end if;

      return Hurt;
    end;
  end if;
  const Next: Coordinates.InteriorPosition := Navigation.NextStepToward(
    Map,
    Progress.State,
    Hostile.Position,
    Player
  );
  if Coordinates.SamePosition(Next, Player) then
    begin
      return Progress;
    end;
  end if;

  return Progress with State := WithHostile(
    Progress.State,
    Index,
    Hostile with Position := Next; end with
  ); end with;
end function;

// Resolves the opponents' part of a turn after the player's accepted action.
function HostilePhase(View: GameState.AreaView; Progress: TurnProgress): result of (TurnProgress, string);
begin
  const Pose: Coordinates.FirstPersonPose := try GameState.FirstPersonPlayerPose(Progress.State);
  const Map: InteriorUnit.InteriorMap := try GameState.CurrentInterior(View, Progress.State);
  var Current: TurnProgress := Progress;
  for Index: integer := 0 to Current.State.Hostiles.Length() - 1 do
    begin
      const Hostile: HostileRules.GameHostile := Current.State.Hostiles[Index];
      if ((Hostile.Health > 0) and (Hostile.AreaId = Current.State.AreaId))
        and
        not Current.PlayerDefeated
      then
        begin
          Current := HostileTurn(Current, Index, Map, Pose.Position);
        end;
      end if;
    end;
  end for;

  return Ok(Current);
end function;

function PlayerAttack(Valid: GameState.GameState): result of (TurnProgress, string);
begin
  const Index: integer := Interaction.HostileAhead(Valid);
  if Index < 0 then
    begin
      return Error('there is nothing to attack');
    end;
  end if;
  const Hostile: HostileRules.GameHostile := Valid.Hostiles[Index];
  const Name: string := HostileRules.HostileDisplayName(Hostile.Kind);
  const Start: TurnProgress := TurnProgress(
    State := Valid,
    Log := [],
    Events := [],
    PlayerDefeated := false
  );
  const Values: Equipment.CharacterValues := Equipment.DeriveCharacterValues(Valid);
  // The skill is captured before the attack; it decides damage and receives the practice.
  const Skill: Progression.SkillKind := Equipment.ActiveSkill(Valid);
  const HitRoll: DiceRoll := Roll(Valid, 20);
  // Being attacked always alerts the opponent, even when the blow misses.
  const Alerted: HostileRules.GameHostile := Hostile with Alerted := true; end with;

  if HitRoll.Value < Values.HitThreshold then
    begin
      return Ok(
        Happened(
          Logged(
            Start with State := WithHostile(HitRoll.State, Index, Alerted); end with,
            ('You miss the ' + Name) +
            '.'
          ), CombatEventKind.PlayerMiss, 0, Hostile.Kind
        )
      );
    end;
  end if;
  const DamageRoll: DiceRoll := Roll(HitRoll.State, Values.DamageSides);
  const Damage: integer := DamageRoll.Value + Values.DamageBonus;
  const Remaining: integer := Math.Max(0, Hostile.Health - Damage);
  // Only health actually removed counts, so overkill cannot inflate the award.
  const Trained: Progression.ProgressionState := try Progression.AwardDamage(
    Valid.Progression,
    Skill,
    Hostile.Health,
    Remaining
  );
  var Struck: TurnProgress := Happened(
    Logged(
      Start with State := WithHostile(
        DamageRoll.State with Progression := Trained; end with,
        Index,
        Alerted with Health := Remaining; end with
      ); end with, ((('You hit the ' + Name) + ' for ') + Conv.IntToStr(Damage)) +
      '.'
    ), CombatEventKind.PlayerHit, Damage, Hostile.Kind
  );
  if Remaining = 0 then
    Struck := Happened(
      Logged(Struck, HostileRules.HostileDeathMessage(Hostile.Kind)),
      CombatEventKind.HostileDefeated,
      0, Hostile.Kind
    );
  end if;
  const Level: integer := Progression.SkillBenefitsOf(Trained, Skill).Level;
  if Level > Progression.SkillBenefitsOf(Valid.Progression, Skill).Level then
    Struck := Logged(
      Struck,
      Progression.SkillName(Skill) + ' reached level ' + Conv.IntToStr(Level) + '.'
    );
  end if;

  return Ok(Struck);
end function;

// Resolves one time-consuming player action followed by the opponents' turn.
// Rejected actions return Error and leave time and the dice untouched.
public function ResolveTurn(View: GameState.AreaView; State: GameState.GameState; Action: TurnAction): result of (TurnOutcome, string);
begin
  const Valid: GameState.GameState := try GameState.ValidateGameState(View, State);
  var Progress: TurnProgress := TurnProgress(
    State := Valid,
    Log := [],
    Events := [],
    PlayerDefeated := false
  );
  case Action of
    when TurnAction.Step(const Direction):
      begin
        Progress.State := try Movement.StepFirstPerson(View, Valid, Direction);
      end;
    when TurnAction.Attack:
      begin
        if Valid.Area <> Coordinates.AreaKind.Dungeon then
          begin
            return Error('there is nothing to attack');
          end;
        end if;

        Progress := try PlayerAttack(Valid);
      end;
    when TurnAction.Wait:
      begin
        Progress := Logged(Progress, 'You wait.');
      end;
    when TurnAction.Equip(const ItemId):
      begin
        const Change: Equipment.EquipmentChange := try Equipment.EquipItem(Valid, ItemId);
        Progress := Logged(Progress with State := Change.State; end with, Change.Message);
      end;
    when TurnAction.Unequip(const ItemId):
      begin
        const Change: Equipment.EquipmentChange := try Equipment.UnequipItem(Valid, ItemId);
        Progress := Logged(Progress with State := Change.State; end with, Change.Message);
      end;
    when TurnAction.Drop(const ItemId):
      begin
        const Change: Equipment.EquipmentChange := try Equipment.DropItem(View, Valid, ItemId);
        Progress := Logged(Progress with State := Change.State; end with, Change.Message);
      end;
    when TurnAction.UseItem(const ItemId):
      const Change := try Consumables.UseItem(Valid, ItemId);
      Progress := Logged(Progress with State := Change.State; end with, Change.Message);
  end case;

  if Progress.State.Area = Coordinates.AreaKind.Dungeon then
    begin
      Progress := try HostilePhase(View, Progress);
    end;
  end if;

  if Progress.PlayerDefeated then
    begin
      return Ok(TurnOutcome.Defeated(Progress.Log));
    end;
  end if;

  return Ok(
    TurnOutcome.Continued(
      try GameState.ValidateGameState(View, Progress.State),
      Progress.Log,
      Progress.Events
    )
  );
end function;
end unit;
