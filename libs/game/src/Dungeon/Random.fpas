// Shared deterministic random draws for combat and generated game content.
unit Dungeon.Random;

public const
  // Exclusive upper bound of the persisted generator state.
  RandomStateModulus: integer := 2147483648;

public type
  // One draw and its successor state; callers decide how to use the value.
  RandomDraw = record
    public State: integer;
    public Value: integer;
  end;

// Advances the persisted generator once and returns a value from 0 to Bound - 1.
// Bound must be positive and the caller owns state validation.
public function DrawBelow(State: integer; Bound: integer): RandomDraw;
begin
  var Next: integer := ((State * 1103515245) + 12345) mod RandomStateModulus;
  return record
    State := Next;
    Value := (Next div 65536) mod Bound;
  end
end;
