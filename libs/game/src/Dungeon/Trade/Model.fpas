// Versioned economy constants and one authoritative catalogue, independent of mutable game state.
unit Dungeon.Trade.Model;

uses Dungeon.Items as Items;

// Wallet arithmetic remains bounded before addition or subtraction.
public const MaximumCoins: integer := 1000000000;
// Finite storage includes initial goods and all items bought from players.
public const MerchantCapacity: integer := 64;
// Each visited merchant contributes five permanent item origins, never replenished.
public const InitialStockSize: integer := 5;

// Prices are named from the player's perspective and are uniform across merchants.
public type Prices = record
  public Buy: integer;
  public Sell: integer;
end record;

// One individual transfer, named from the player's perspective.
public type Side = enum
  Buy;
  Sell;
end enum;

// Domain failures remain distinct from transport, storage and session failures.
public type Failure = enum
  InvalidContext(Reason: string);
  UnknownItem;
  WrongOwner;
  NotTradable;
  Worn;
  InsufficientFunds;
  InventoryFull;
  StockFull;
  WalletFull;
end enum;

// One exact item and its currently available action; no grouping by display name.
public type Offer = record
  public Id: string;
  public Name: string;
  public Price: option of integer;
  public Enabled: boolean;
  public Reason: string;
end record;

// Complete bounded lists, sorted by identity; connection-local paging/revisions belong to the server.
public type Quote = record
  public NpcId: string;
  public Speaker: string;
  public BuyItems: array of Offer;
  public SellItems: array of Offer;
end record;

// Fixed player-facing refusals shared by quotes and transfers; context has no I/O diagnostics.
public function FailureMessage(Value: Failure): string;
begin
  case Value of
    when Failure.InvalidContext(const Reason):
      return Reason;
    when Failure.UnknownItem:
      return 'This item no longer exists.';
    when Failure.WrongOwner:
      return 'This item does not belong to the selected side.';
    when Failure.NotTradable:
      return 'Quest items cannot be traded.';
    when Failure.Worn:
      return 'Remove this item before selling it.';
    when Failure.InsufficientFunds:
      return 'Not enough coins.';
    when Failure.InventoryFull:
      return 'Your inventory is full.';
    when Failure.StockFull:
      return 'The merchant stock is full.';
    when Failure.WalletFull:
      return 'Your coin balance cannot hold the proceeds.';
  end case;
end function;

// Quest objects have no price and can never enter merchant ownership.
public function Price(Kind: Items.ItemKind): option of Prices;
begin
  case Kind of
    when Items.ItemKind.AncientCoin:
      return Some(Prices(Buy := 20, Sell := 10));
    when Items.ItemKind.HealingPotion:
      return Some(Prices(Buy := 8, Sell := 3));
    when Items.ItemKind.RustyShortSword, Items.ItemKind.LeatherJerkin:
      return Some(Prices(Buy := 12, Sell := 5));
    when Items.ItemKind.MarasCompass:
      return None;
  end case;
end function;
end unit;
