// NPC reach against retained immutable placements, shared by dialogue and quest rules.
unit Dungeon.Npcs.Interaction;

uses Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Npcs as Npcs, Std.Math as Math;

// Finds the adjacent stationary NPC in the current settlement; the occupied exit takes precedence.
// Validated maps guarantee unambiguous talk fields. No I/O or meeting mutation is performed.
public function InReach(View: GameState.AreaView; State: GameState.GameState): option of string;
begin
  if State.Area <> Coordinates.AreaKind.Settlement then
    return None;
  end if;

  case GameState.SettlementPlayerPosition(State) of
    when Error(_):
      return None;
    when Ok(const Position):
      case View.Interior of
        when None:
          return None;
        when Some(const Map):
          if (Map.AreaId <> State.AreaId) or (Position = Map.Arrival) then
            return None;
          end if;

          for Npc: Npcs.NpcPlacement in Map.Npcs do
            if (Npcs.IndexOf(State.Npcs, Npc.Id) >= 0)
              and
              (Math.Abs(Npc.Position.X - Position.X) + Math.Abs(Npc.Position.Y - Position.Y) = 1)
            then
              return Some(Npc.Id);
            end if;
          end for;
      end case;
  end case;

  return None;
end function;

// The compass interaction remains restricted to Mara's exact home identity.
public function MaraInReach(View: GameState.AreaView; State: GameState.GameState): boolean;
begin
  case InReach(View, State) of
    when Some(const Id):
      return Id = Npcs.MaraId(View.Metadata);
    when None:
      return false;
  end case;
end function;
end unit;
