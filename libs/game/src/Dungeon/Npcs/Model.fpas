// NPC roles, immutable map placements and independently persisted meeting records.
unit Dungeon.Npcs.Model;

uses Dungeon.Coordinates as Coordinates;

// Authored quest character and the three stationary generated-village roles.
public type NpcKind = enum
  Mara;
  Resident;
  Guard;
  Healer;
end enum;

// Immutable identity, presentation and occupied field of one validated area map.
public type NpcPlacement = record
  public Id: string;
  public Kind: NpcKind;
  public DisplayName: string;
  public Position: Coordinates.InteriorPosition;
end record;

// Mutable meeting fact; name and position remain in the immutable placement.
public type GameNpc = record
  public Id: string;
  public Kind: NpcKind;
  public AreaId: string;
  public HasMetPlayer: boolean;
end record;

// Original generated-village slots 0, 1 and 2 retain resident, guard and healer roles respectively.
// Other slots are caller errors, never a default role.
public function RoleForSlot(Slot: integer): NpcKind;
begin
  case Slot of
    when 0:
      return NpcKind.Resident;
    when 1:
      return NpcKind.Guard;
    when 2:
      return NpcKind.Healer;
    else
      panic('village slot must be 0 through 2');
  end case;
end function;
end unit;
