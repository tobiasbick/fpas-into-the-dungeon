// Independent seeded display names for villages and their four distinct NPC roles.
unit Dungeon.Settlements.Names;

uses Dungeon.Coordinates as Coordinates, Dungeon.Terrain.Noise as Noise;

// Names are labels only; equal seeds/regions produce equal names across allocated world IDs.
public function VillageName(Seed: integer; Region: Coordinates.ChunkCoordinate): string;
begin
  const Prefixes := ['Alder', 'Bracken', 'Cedar', 'Fern', 'Moss', 'Raven', 'Stone', 'Willow'];
  const Suffixes := ['brook', 'ford', 'haven', 'hollow', 'meadow', 'stead', 'vale', 'watch'];
  return Prefixes[Noise.CoordinateHash(Seed, Region.X, Region.Y, 1619) mod 8] +
    Suffixes[Noise.CoordinateHash(Seed, Region.X, Region.Y, 1716) mod 8];
end function;

// Disjoint name sets distinguish all four roles in one village.
public function NpcName(Seed: integer; Region: Coordinates.ChunkCoordinate; Slot: integer): string;
begin
  const Index := Noise.CoordinateHash(Seed, Region.X, Region.Y, 1621 + Slot * 73) mod 4;
  case Slot of
    when 0:
      const Names := ['Ada', 'Nell', 'Owen', 'Tess'];
      return Names[Index];
    when 1:
      const Names := ['Bram', 'Cole', 'Edda', 'Hugh'];
      return Names[Index];
    when 2:
      const Names := ['Iona', 'Lina', 'Orin', 'Rhea'];
      return Names[Index];
    when 3:
      const Names := ['Darin', 'Esme', 'Finn', 'Vera'];
      return Names[Index];
    else
      panic('generated village NPC slot is outside 0 through 3');
  end case;
end function;
end unit;
