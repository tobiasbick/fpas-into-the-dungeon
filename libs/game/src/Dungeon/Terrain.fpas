// Outdoor terrain cells, chunks, world metadata, and their client-safe codes.
unit Dungeon.Terrain;

uses Dungeon.Coordinates as Coordinates;

// Schema version written to world metadata and chunk files.
public const WorldFormatVersion: integer := 3;
// Selects deterministic world content, including chunk terrain and first-visit dungeon names.
public const WorldGeneratorVersion: integer := 7;

// Base material retained when a feature such as a forest or path is present.
public type BaseTerrainKind = enum
  Grass;
  Sand;
  Rock;
  Water;
end enum;

// Optional surface feature rendered above compatible base terrain.
public type TerrainFeatureKind = enum
  NoFeature;
  Tree;
  Forest;
  Path;
  River;
  Entrance;
end enum;

// Classifies water without requiring connectivity traversal across an unbounded world.
public type WaterKind = enum
  NoWater;
  Sea;
  Lake;
  RiverWater;
end enum;

// Complete authoritative terrain value for one outdoor world coordinate.
public type WorldCell = record
  public Base: BaseTerrainKind;
  public Feature: TerrainFeatureKind;
  public Water: WaterKind;
end record;

// Diagnostic values behind one generated cell, normalized to the range 0 through 1000.
public type TerrainGenerationSample = record
  // Very slowly changing field that establishes continent-scale character.
  public Continentalness: integer;
  // Combined large-, regional-, and coast-scale height field.
  public Elevation: integer;
  // Regional climate field used for deserts and forests.
  public Moisture: integer;
  // Smooth vegetation field used for forest interiors and tree-lined edges.
  public Vegetation: integer;
  // Fine smooth field used to disturb otherwise regular lake shorelines.
  public LakeShape: integer;
  // Ridge-shaped regional field used to form mountain ranges.
  public Ruggedness: integer;
  // Final land-versus-sea score after connected ridges are applied.
  public LandScore: integer;
  // Ridge strength that can lift narrow connected land bands above sea level.
  public LandBridge: integer;
end record;

// Immutable identity and generator contract for one outdoor world.
public type WorldMetadata = record
  public Id: string;
  public Seed: integer;
  public FormatVersion: integer;
  public GeneratorVersion: integer;
  public ChunkSize: integer;
  public Spawn: Coordinates.WorldPosition;
  // Stable server-owned identity and display label of the initial outdoor area.
  public OutdoorAreaId: string;
  public OutdoorAreaLabel: string;
  // Entrance three traversable steps from the spawn; it belongs to the spawn's region.
  public SpawnEntrance: Coordinates.WorldPosition;
  // Side length of square entrance regions in chunks, fixed when the world is created (1 to 16).
  public DungeonRegionChunks: integer;
end record;

// One complete outdoor chunk in row-major order.
public type WorldChunk = record
  public Coordinate: Coordinates.ChunkCoordinate;
  public Cells: array of WorldCell;
end record;

// Returns an open grass cell without features.
public function PlainCell(): WorldCell;
begin
  return WorldCell(
    Base := BaseTerrainKind.Grass,
    Feature := TerrainFeatureKind.NoFeature,
    Water := WaterKind.NoWater
  );
end function;

// Returns a water cell of one kind with its feature.
public function WaterCell(Kind: WaterKind; Feature: TerrainFeatureKind): WorldCell;
begin
  return WorldCell(Base := BaseTerrainKind.Water, Feature := Feature, Water := Kind);
end function;

// Returns whether the player may enter a generated cell.
public function CellIsWalkable(Cell: WorldCell): boolean;
begin
  return (Cell.Base = BaseTerrainKind.Grass) or (Cell.Base = BaseTerrainKind.Sand);
end function;

// Returns one cell after validating local coordinates and chunk shape.
public function ChunkCell(Chunk: WorldChunk; LocalX: integer; LocalY: integer): WorldCell;
begin
  if ((LocalX < 0) or (LocalX >= Coordinates.WorldChunkSize))
    or
    ((LocalY < 0) or (LocalY >= Coordinates.WorldChunkSize))
  then
    begin
      panic('local coordinate is outside the chunk');
    end;
  end if;

  if Chunk.Cells.Length() <> Coordinates.WorldChunkSize * Coordinates.WorldChunkSize then
    begin
      panic('chunk cell count does not match chunk size');
    end;
  end if;

  return Chunk.Cells[(LocalY * Coordinates.WorldChunkSize) + LocalX];
end function;

// Maps an authoritative cell to one compact client-safe presentation code.
public function VisibleCellCode(Cell: WorldCell): string;
begin
  case Cell.Feature of
    when TerrainFeatureKind.Tree:
      begin
        return 't';
      end;
    when TerrainFeatureKind.Forest:
      begin
        return 'f';
      end;
    when TerrainFeatureKind.Path:
      begin
        return 'p';
      end;
    when TerrainFeatureKind.River:
      begin
        return 'r';
      end;
    when TerrainFeatureKind.Entrance:
      begin
        return 'e';
      end;
    when TerrainFeatureKind.NoFeature:
      begin
        null;
      end;
  end case;

  case Cell.Water of
    when WaterKind.Sea:
      begin
        return 'o';
      end;
    when WaterKind.Lake:
      begin
        return 'l';
      end;
    when WaterKind.NoWater, WaterKind.RiverWater:
      begin
        null;
      end;
  end case;

  case Cell.Base of
    when BaseTerrainKind.Grass:
      begin
        return 'g';
      end;
    when BaseTerrainKind.Sand:
      begin
        return 'd';
      end;
    when BaseTerrainKind.Rock:
      begin
        return 'm';
      end;
    when BaseTerrainKind.Water:
      begin
        return 'o';
      end;
  end case;
end function;

// Returns whether the server may place or move a player onto one cell.
public function IsWalkable(Cell: WorldCell): boolean;
begin
  return CellIsWalkable(Cell);
end function;
end unit;
