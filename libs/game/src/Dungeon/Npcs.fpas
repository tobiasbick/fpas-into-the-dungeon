// Persistent NPC identity and meeting state, with fixed placement, collision, and visible map markers.
unit Dungeon.Npcs;

uses Dungeon.Coordinates as Coordinates, Dungeon.Settlements as Settlements, Dungeon.Terrain as Terrain;

// Supported authored NPC roles; positions and names belong to the kind, never to a save file.
public type NpcKind = enum
  Mara;
end enum;

// Mutable meeting state for one stable NPC in the selected world. Placement is derived from Kind.
public type GameNpc = record
  public Id: string;
  public Kind: NpcKind;
  public AreaId: string;
  public HasMetPlayer: boolean;
end record;

// Fixed local position of the stationary NPC; it is distinct from gate and player arrival.
public function Position(Kind: NpcKind): Coordinates.InteriorPosition;
begin
  case Kind of
    when NpcKind.Mara:
      return Coordinates.InteriorPosition(X := 11, Y := 7);
  end case;
end function;

// Player-facing name of a known NPC kind.
public function DisplayName(Kind: NpcKind): string;
begin
  case Kind of
    when NpcKind.Mara:
      return 'Mara';
  end case;
end function;

// Creates the world's one NPC, even before the settlement is visited; Start over uses this fresh record.
public function NewNpcs(Metadata: Terrain.WorldMetadata): array of GameNpc;
begin
  return [
    GameNpc(
      Id := Settlements.HomeAreaId(Metadata) + ':npc:mara', Kind := NpcKind.Mara,
      AreaId := Settlements.HomeAreaId(Metadata), HasMetPlayer := false
    )
  ];
end function;

// Rejects missing, duplicate, foreign or extra NPCs; the met flag is the sole mutable property in 15a.
public function ValidateNpcs(Metadata: Terrain.WorldMetadata; Values: array of GameNpc): result of (array of GameNpc, string);
begin
  if Values.Length() <> 1 then
    return Error('game state requires exactly one Mara NPC record');
  end if;
  const Expected := NewNpcs(Metadata)[0];
  const Npc := Values[0];
  if (Npc.Id <> Expected.Id) or (Npc.Kind <> Expected.Kind) or (Npc.AreaId <> Expected.AreaId) then
    return Error('NPC identity, kind and area must match the home settlement');
  end if;

  return Ok(Values);
end function;

// Returns the blocking NPC at a local field, or -1. Callers validate records before applying rules.
public function At(Values: array of GameNpc; AreaId: string; Field: Coordinates.InteriorPosition): integer;
begin
  for Index: integer := 0 to Values.Length() - 1 do
    if (Values[Index].AreaId = AreaId) and (Position(Values[Index].Kind) = Field) then
      return Index;
    end if;
  end for;

  return -1;
end function;

// Overlays an NPC only on currently visible fields; remembered fields keep their supplied static code.
public function MapCellCode(
  Values: array of GameNpc; AreaId: string; Field: Coordinates.InteriorPosition;
  CurrentlyVisible: boolean; StaticCode: string
): string;
begin
  if CurrentlyVisible and (At(Values, AreaId, Field) >= 0) then
    return 'n';
  end if;

  return StaticCode;
end function;
end unit;
