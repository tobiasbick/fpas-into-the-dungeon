// Non-player character kinds, identities, persistent state, and dialogue frame types.
unit Dungeon.Npcs;

public const
  // Stable identity and player-facing name of the first non-player character.
  InitialDungeonNpcId: string := 'initial-dungeon:old-adventurer';
  InitialDungeonNpcName: string := 'Mara, the old adventurer';
  // Stable choice identities understood by the initial deterministic dialogue.
  DialogueChoiceIdentity: string := 'identity';
  DialogueChoiceDungeon: string := 'dungeon';
  DialogueChoiceCoin: string := 'coin';
  DialogueChoiceGoodbye: string := 'goodbye';
  // Offered only while the player is hurt; Mara restores full health.
  DialogueChoiceWounds: string := 'wounds';

public type
  // Identifies the one NPC kind introduced by the first dialogue slice.
  NpcKind = enum
    OldAdventurer;
  end;
  // Persistent state of the fixed initial NPC; location remains part of the area definition.
  GameNpc = record
    public Id: string;
    public Kind: NpcKind;
    public HasMetPlayer: boolean;
  end;
  // One stable server-owned response offered by a dialogue frame.
  NpcDialogueChoice = record
    public Id: string;
    public Text: string;
  end;
  // Client-safe dialogue content derived from authoritative game state.
  NpcDialogue = record
    public NpcId: string;
    public Speaker: string;
    public Text: string;
    public Choices: array of NpcDialogueChoice;
  end;

// Returns the player-facing name of one authoritative NPC kind.
public function NpcDisplayName(Kind: NpcKind): string;
begin
  case Kind of
    NpcKind.OldAdventurer:
    begin
      return InitialDungeonNpcName
    end
  end
end;
