// The generic Enter interaction: environment hints, pickup, inspection, and exits.
unit Dungeon.Interaction;

uses Dungeon.Settlements.Sites as Sites, Dungeon.Npcs.Interaction as NpcInteraction, Dungeon.Npcs as NpcRules, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Hostiles as HostileRules, Dungeon.Interior as InteriorUnit, Dungeon.Items as ItemRules, Dungeon.Movement as Movement, Dungeon.Settlements as Settlements, Dungeon.Terrain as Terrain, Dungeon.Terrain.Entrances as Entrances, Std.Conv as Conv;

// Successful interaction text when neither the current nor forward field offers an action.
public const NoInteractionMessage: string := 'There is nothing to interact with.';

// Successful server-side resolution of one interaction intention.
public type InteractionOutcome = enum
  // Requests a server-owned transition target without changing the state.
  TransitionRequested(TargetAreaId: string);
  // The interaction changed mutable state without changing areas.
  StateChanged(State: GameState.GameState);
  // Read-only information; an empty title denotes short feedback rather than inspection content.
  Described(Title: string; Text: string);
end enum;

// Describes the available item action for a validated interior state; empty means no item target.
public function ItemInteractionHint(State: GameState.GameState): string;
begin
  case State.Player of
    when Coordinates.PlayerPosition.FirstPerson(const Pose):
      const Offset: Coordinates.InteriorPosition := Coordinates.StepOffset(
        Pose.Facing,
        Coordinates.RelativeStep.Forward
      );
      for Item: ItemRules.GameItem in State.Items do
        begin
          case Item.Location of
            when ItemRules.ItemLocation.InInterior(const AreaId, const Position):
              if AreaId = State.AreaId then
                begin
                  if (Position.X = Pose.Position.X) and (Position.Y = Pose.Position.Y) then
                    begin
                      if GameState.InventoryIsFull(State) then
                        begin
                          return ('At your feet: ' + ItemRules.ItemDisplayName(Item.Kind)) +
                            ' — inventory full';
                        end;
                      end if;

                      return ('At your feet: ' + ItemRules.ItemDisplayName(Item.Kind)) +
                        ' — Enter: Pick up';
                    end;
                  end if;

                  if (Position.X = Pose.Position.X + Offset.X)
                    and
                    (Position.Y = Pose.Position.Y + Offset.Y)
                  then
                    begin
                      return ItemRules.ItemDisplayName(Item.Kind) + ' — Enter: Examine';
                    end;
                  end if;
                end;
              end if;
            when ItemRules.ItemLocation.CarriedByPlayer, ItemRules.ItemLocation.EquippedByPlayer(_), ItemRules.ItemLocation.Consumed, ItemRules.ItemLocation.ReturnedToMara(_):
              null;
          end case;
        end;
      end for;
    when Coordinates.PlayerPosition.Outdoor(_), Coordinates.PlayerPosition.Settlement(_):
      null;
  end case;

  return '';
end function;

// Returns the standing opponent directly ahead of a first-person player, or -1.
public function HostileAhead(State: GameState.GameState): integer;
begin
  case State.Player of
    when Coordinates.PlayerPosition.FirstPerson(const Pose):
      const Offset: Coordinates.InteriorPosition := Coordinates.StepOffset(
        Pose.Facing,
        Coordinates.RelativeStep.Forward
      );
      return GameState.StandingHostileAt(
        State, State.AreaId, Coordinates.InteriorPosition(
          X := Pose.Position.X + Offset.X, Y := Pose.Position.Y +
          Offset.Y
        )
      );
    when Coordinates.PlayerPosition.Outdoor(_), Coordinates.PlayerPosition.Settlement(_):
      return -1;
  end case;
end function;

// Describes the opponent directly ahead with its health; empty means no opponent ahead.
public function HostileInteractionHint(State: GameState.GameState): string;
begin
  const Index: integer := HostileAhead(State);
  if Index < 0 then
    begin
      return '';
    end;
  end if;
  const Hostile: HostileRules.GameHostile := State.Hostiles[Index];
  return (
    (((HostileRules.HostileDisplayName(Hostile.Kind) + ' ') + Conv.IntToStr(Hostile.Health)) + '/') +
    Conv.IntToStr(HostileRules.HostileMaximumHealth(Hostile.Kind))
  ) +
    ' — Space: Attack';
end function;

// Returns the highest-priority interaction hint for the current field and facing.
public function InteractionHint(State: GameState.GameState): string;
begin
  const HostileHint: string := HostileInteractionHint(State);
  if HostileHint <> '' then
    begin
      return HostileHint;
    end;
  end if;

  return ItemInteractionHint(State);
end function;

// Projects authoritative map interaction hints for an outdoor gate or an adjacent settlement NPC.
public function MapInteractionHint(View: GameState.AreaView; State: GameState.GameState): string;
begin
  if State.Area = Coordinates.AreaKind.OutdoorRegion then
    case GameState.OutdoorPlayerPosition(State) of
      when Error(_):
        return '';
      when Ok(const Position):
        if Position = View.Metadata.SettlementGate then
          return 'Press Enter to enter ' + Settlements.HomeName + '.';
        end if;

        if Sites.RegionAt(View.Metadata, Position) is Some(_) then
          return 'Press Enter to enter the village.';
        end if;

        if Entrances.EntranceRegionAt(View.Metadata, Position) is Some(_) then
          return 'Press Enter to enter the dungeon.';
        end if;
    end case;
  end if;

  if State.Area = Coordinates.AreaKind.Settlement then
    case GameState.SettlementPlayerPosition(State) of
      when Error(_):
        return '';
      when Ok(const Position):
        case View.Interior of
          when Some(const Map):
            if Position = Map.Arrival then
              return 'Press Enter to leave ' + Map.DisplayName + '.';
            end if;

            case NpcInteraction.InReach(View, State) of
              when Some(const Id):
                const Npc := NpcRules.FindPlacement(Map.Npcs, Id).Unwrap();
                return Npc.DisplayName + ' — Enter: Talk';
              when None:
                null;
            end case;
          when None:
            return '';
        end case;
    end case;
  end if;

  return '';
end function;

// Returns the status text for standing on the exit or stairs of Map, or '' elsewhere.
public function TransitionHint(Map: InteriorUnit.InteriorMap; Position: Coordinates.InteriorPosition): string;
begin
  if Coordinates.SamePosition(Position, Map.Arrival) then
    if Map.Level = 0 then
      return 'Press Enter to return to the outdoor region.';
    end if;

    return 'Stairs up — Enter: Go up';
  end if;

  if Movement.OnTransitionField(Map, Position) then
    return 'Stairs down — Enter: Go down';
  end if;

  return '';
end function;

// Returns the player-facing title of one level: its dungeon name, followed by
// `— Level n of d` with a one-based level when the dungeon has more than one level.
public function LevelTitle(Map: InteriorUnit.InteriorMap): string;
begin
  if Map.Depth <= 1 then
    return Map.DisplayName;
  end if;

  return Map.DisplayName + ' — Level ' + Conv.IntToStr(Map.Level + 1) + ' of ' +
    Conv.IntToStr(Map.Depth);
end function;

// Resolves current-field transitions or pickup, then inspection ahead, without implicit movement.
public function Interact(View: GameState.AreaView; State: GameState.GameState): result of (InteractionOutcome, string);
begin
  const Metadata: Terrain.WorldMetadata := View.Metadata;
  const Valid: GameState.GameState := try GameState.ValidateGameState(View, State);
  if Valid.Area = Coordinates.AreaKind.OutdoorRegion then
    begin
      const OutdoorPosition: Coordinates.WorldPosition := try GameState.OutdoorPlayerPosition(
        Valid
      );
      if (OutdoorPosition = Metadata.SettlementGate)
        or
        (Sites.RegionAt(Metadata, OutdoorPosition) is Some(_))
        or
        (Entrances.EntranceRegionAt(Metadata, OutdoorPosition) is Some(_))
      then
        begin
          return Ok(
            InteractionOutcome.TransitionRequested(try Movement.AreaTransitionTarget(View, Valid))
          );
        end;
      end if;

      return Ok(InteractionOutcome.Described('', NoInteractionMessage));
    end;
  end if;

  if Valid.Area = Coordinates.AreaKind.Settlement then
    const Map := try GameState.CurrentInterior(View, Valid);
    if (try GameState.SettlementPlayerPosition(Valid)) = Map.Arrival then
      return Ok(InteractionOutcome.TransitionRequested(Metadata.OutdoorAreaId));
    end if;

    return Ok(InteractionOutcome.Described('', NoInteractionMessage));
  end if;
  const Map: InteriorUnit.InteriorMap := try GameState.CurrentInterior(View, State);
  const Pose: Coordinates.FirstPersonPose := try GameState.FirstPersonPlayerPose(Valid);
  if Movement.OnTransitionField(Map, Pose.Position) then
    begin
      return Ok(
        InteractionOutcome.TransitionRequested(try Movement.AreaTransitionTarget(View, Valid))
      );
    end;
  end if;

  for Index: integer := 0 to Valid.Items.Length() - 1 do
    begin
      var Item: ItemRules.GameItem := Valid.Items[Index];
      case Item.Location of
        when ItemRules.ItemLocation.InInterior(const AreaId, const ItemPosition):
          if (AreaId = Valid.AreaId)
            and
            ((ItemPosition.X = Pose.Position.X) and (ItemPosition.Y = Pose.Position.Y))
          then
            begin
              if GameState.InventoryIsFull(Valid) then
                begin
                  return Error('your inventory is full');
                end;
              end if;
              var Changed: GameState.GameState := Valid;
              Item.Location := ItemRules.ItemLocation.CarriedByPlayer;
              Changed.Items[Index] := Item;
              return Ok(
                InteractionOutcome.StateChanged(try GameState.ValidateGameState(View, Changed))
              );
            end;
          end if;
        when ItemRules.ItemLocation.CarriedByPlayer, ItemRules.ItemLocation.EquippedByPlayer(_), ItemRules.ItemLocation.Consumed, ItemRules.ItemLocation.ReturnedToMara(_):
          null;
      end case;
    end;
  end for;
  const Offset: Coordinates.InteriorPosition := Coordinates.StepOffset(
    Pose.Facing,
    Coordinates.RelativeStep.Forward
  );
  const Target: Coordinates.InteriorPosition := Coordinates.InteriorPosition(
    X := Pose.Position.X + Offset.X, Y := Pose.Position.Y +
    Offset.Y
  );
  const Opponent: integer := GameState.StandingHostileAt(Valid, Valid.AreaId, Target);
  if Opponent >= 0 then
    begin
      return Ok(
        InteractionOutcome.Described(
          '',
          HostileRules.HostileInspection(Valid.Hostiles[Opponent].Kind)
        )
      );
    end;
  end if;

  for Item: ItemRules.GameItem in Valid.Items do
    begin
      case Item.Location of
        when ItemRules.ItemLocation.InInterior(const AreaId, const ItemPosition):
          if (AreaId = Valid.AreaId)
            and
            ((ItemPosition.X = Target.X) and (ItemPosition.Y = Target.Y))
          then
            begin
              return Ok(
                InteractionOutcome.Described(
                  ItemRules.ItemDisplayName(Item.Kind),
                  ItemRules.ItemDescription(Item.Kind)
                )
              );
            end;
          end if;
        when ItemRules.ItemLocation.CarriedByPlayer, ItemRules.ItemLocation.EquippedByPlayer(_), ItemRules.ItemLocation.Consumed, ItemRules.ItemLocation.ReturnedToMara(_):
          null;
      end case;
    end;
  end for;

  return Ok(InteractionOutcome.Described('', NoInteractionMessage));
end function;
end unit;
