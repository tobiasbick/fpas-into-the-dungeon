// The generic Enter interaction: environment hints, pickup, inspection, and exits.
unit Dungeon.Interaction;

uses Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Hostiles as Hostiles, Dungeon.Interior as Interior, Dungeon.Items as Items, Dungeon.Movement as Movement, Dungeon.Terrain as Terrain, Dungeon.Terrain.Entrances as Entrances, Std.Conv as Conv;

// Successful interaction text when neither the current nor forward field offers an action.
public const NoInteractionMessage: string := 'There is nothing to interact with.';

// Successful server-side resolution of one interaction intention.
public type InteractionOutcome = enum
  // Requests a server-owned transition target without changing the state.
  TransitionRequested(TargetAreaId: string);
  // The interaction changed mutable state without changing areas.
  StateChanged(State: GameState.GameState);
  // Read-only information; an empty title denotes short feedback rather than inspection content.
  Described(Title: string; Text: string);
end enum;

// Describes the available item action for a validated interior state; empty means no item target.
public function ItemInteractionHint(State: GameState.GameState): string;
begin
  case State.Player of
    when Coordinates.PlayerPosition.FirstPerson(const Pose):
      const Offset: Coordinates.InteriorPosition := Coordinates.StepOffset(
        Pose.Facing,
        Coordinates.RelativeStep.Forward
      );
      for Item: Items.GameItem in State.Items do
        begin
          case Item.Location of
            when Items.ItemLocation.InInterior(const AreaId, const Position):
              if AreaId = State.AreaId then
                begin
                  if (Position.X = Pose.Position.X) and (Position.Y = Pose.Position.Y) then
                    begin
                      if GameState.InventoryIsFull(State) then
                        begin
                          return ('At your feet: ' + Items.ItemDisplayName(Item.Kind)) +
                            ' — inventory full';
                        end;
                      end if;

                      return ('At your feet: ' + Items.ItemDisplayName(Item.Kind)) +
                        ' — Enter: Pick up';
                    end;
                  end if;

                  if (Position.X = Pose.Position.X + Offset.X)
                    and
                    (Position.Y = Pose.Position.Y + Offset.Y)
                  then
                    begin
                      return Items.ItemDisplayName(Item.Kind) + ' — Enter: Examine';
                    end;
                  end if;
                end;
              end if;
            when Items.ItemLocation.CarriedByPlayer, Items.ItemLocation.EquippedByPlayer(_):
              null;
          end case;
        end;
      end for;
    when Coordinates.PlayerPosition.Outdoor(_):
      null;
  end case;

  return '';
end function;

// Returns the standing opponent directly ahead of a first-person player, or -1.
public function HostileAhead(State: GameState.GameState): integer;
begin
  case State.Player of
    when Coordinates.PlayerPosition.FirstPerson(const Pose):
      const Offset: Coordinates.InteriorPosition := Coordinates.StepOffset(
        Pose.Facing,
        Coordinates.RelativeStep.Forward
      );
      return GameState.StandingHostileAt(
        State, State.AreaId, Coordinates.InteriorPosition(
          X := Pose.Position.X + Offset.X, Y := Pose.Position.Y +
          Offset.Y
        )
      );
    when Coordinates.PlayerPosition.Outdoor(_):
      return -1;
  end case;
end function;

// Describes the opponent directly ahead with its health; empty means no opponent ahead.
public function HostileInteractionHint(State: GameState.GameState): string;
begin
  const Index: integer := HostileAhead(State);
  if Index < 0 then
    begin
      return '';
    end;
  end if;
  const Hostile: Hostiles.GameHostile := State.Hostiles[Index];
  return (
    (((Hostiles.HostileDisplayName(Hostile.Kind) + ' ') + Conv.IntToStr(Hostile.Health)) + '/') +
    Conv.IntToStr(Hostiles.HostileMaximumHealth(Hostile.Kind))
  ) +
    ' — Space: Attack';
end function;

// Returns the highest-priority interaction hint for the current field and facing.
public function InteractionHint(State: GameState.GameState): string;
begin
  const HostileHint: string := HostileInteractionHint(State);
  if HostileHint <> '' then
    begin
      return HostileHint;
    end;
  end if;

  return ItemInteractionHint(State);
end function;

// Resolves current-field transitions or pickup, then inspection ahead, without implicit movement.
public function Interact(View: GameState.AreaView; State: GameState.GameState): result of (InteractionOutcome, string);
begin
  const Metadata: Terrain.WorldMetadata := View.Metadata;
  const Valid: GameState.GameState := try GameState.ValidateGameState(View, State);
  if Valid.Area = Coordinates.AreaKind.OutdoorRegion then
    begin
      const OutdoorPosition: Coordinates.WorldPosition := try GameState.OutdoorPlayerPosition(
        Valid
      );
      if (Entrances.EntranceRegionAt(Metadata, OutdoorPosition) is Some(_)) then
        begin
          return Ok(
            InteractionOutcome.TransitionRequested(try Movement.AreaTransitionTarget(View, Valid))
          );
        end;
      end if;

      return Ok(InteractionOutcome.Described('', NoInteractionMessage));
    end;
  end if;
  const Map: Interior.InteriorMap := try GameState.CurrentInterior(View, State);
  const Pose: Coordinates.FirstPersonPose := try GameState.FirstPersonPlayerPose(Valid);
  if (Pose.Position.X = Map.Exit.X) and (Pose.Position.Y = Map.Exit.Y) then
    begin
      return Ok(
        InteractionOutcome.TransitionRequested(try Movement.AreaTransitionTarget(View, Valid))
      );
    end;
  end if;

  for Index: integer := 0 to Valid.Items.Length() - 1 do
    begin
      var Item: Items.GameItem := Valid.Items[Index];
      case Item.Location of
        when Items.ItemLocation.InInterior(const AreaId, const ItemPosition):
          if (AreaId = Valid.AreaId)
            and
            ((ItemPosition.X = Pose.Position.X) and (ItemPosition.Y = Pose.Position.Y))
          then
            begin
              if GameState.InventoryIsFull(Valid) then
                begin
                  return Error('your inventory is full');
                end;
              end if;
              var Changed: GameState.GameState := Valid;
              Item.Location := Items.ItemLocation.CarriedByPlayer;
              Changed.Items[Index] := Item;
              return Ok(
                InteractionOutcome.StateChanged(try GameState.ValidateGameState(View, Changed))
              );
            end;
          end if;
        when Items.ItemLocation.CarriedByPlayer, Items.ItemLocation.EquippedByPlayer(_):
          null;
      end case;
    end;
  end for;
  const Offset: Coordinates.InteriorPosition := Coordinates.StepOffset(
    Pose.Facing,
    Coordinates.RelativeStep.Forward
  );
  const Target: Coordinates.InteriorPosition := Coordinates.InteriorPosition(
    X := Pose.Position.X + Offset.X, Y := Pose.Position.Y +
    Offset.Y
  );
  if GameState.StandingHostileAt(Valid, Valid.AreaId, Target) >= 0 then
    begin
      return Ok(
        InteractionOutcome.Described(
          '',
          'The restless skeleton rattles its bones at you. Press Space to attack.'
        )
      );
    end;
  end if;

  for Item: Items.GameItem in Valid.Items do
    begin
      case Item.Location of
        when Items.ItemLocation.InInterior(const AreaId, const ItemPosition):
          if (AreaId = Valid.AreaId)
            and
            ((ItemPosition.X = Target.X) and (ItemPosition.Y = Target.Y))
          then
            begin
              return Ok(
                InteractionOutcome.Described(
                  Items.ItemDisplayName(Item.Kind),
                  Items.ItemDescription(Item.Kind)
                )
              );
            end;
          end if;
        when Items.ItemLocation.CarriedByPlayer, Items.ItemLocation.EquippedByPlayer(_):
          null;
      end case;
    end;
  end for;

  return Ok(InteractionOutcome.Described('', NoInteractionMessage));
end function;
end unit;
