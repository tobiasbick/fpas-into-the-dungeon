// Identity-bound stationary NPC dialogue, meeting memory and atomic healing/quest outcomes.
unit Dungeon.Dialogue;

uses
  Dungeon.Dialogue.Model as Model, Dungeon.Dialogue.Quests as QuestDialogue,
  Dungeon.Dialogue.Villages as Villages, Dungeon.Quests.Model as QuestModel,
  Dungeon.Npcs.Interaction as NpcInteraction, Dungeon.GameState as GameState,
  Dungeon.Interior.Generation.Content as Content, Dungeon.Interior.Generation.Levels as Levels,
  Dungeon.Items as Items, Dungeon.Npcs as Npcs, Dungeon.Terrain.Entrances as Entrances, Std.Conv as Conv;

// Shared stable choice projection; availability belongs to the current authoritative NPC and node.
public type Choice = Model.Choice;

// Server-only conversation node; compass offers retain their preflighted objective.
public type Node = Model.Node;

// Connection-local authoritative frame; only display fields enter the protocol.
public type Frame = Model.Frame;

// Atomic replacement state/frame and actual unsaved-progress effect.
public type Outcome = Model.Outcome;

// Shared exact-identity reach check retained for Mara's authored compass rules.
public function MaraInReach(View: GameState.AreaView; State: GameState.GameState): boolean;
begin
  return NpcInteraction.MaraInReach(View, State);
end function;

function ChoicesFor(State: GameState.GameState; Npc: Npcs.NpcPlacement): array of Choice;
begin
  if Npc.Kind <> Npcs.NpcKind.Mara then
    return Villages.Choices(Npc.Kind, State.Health < GameState.PlayerMaximumHealth);
  end if;
  var Choices := [
    Choice(Id := 'identity', Text := 'Who are you?'),
    Choice(Id := 'dungeon', Text := 'What lies beneath the hills?')
  ];
  var CarriesCoin := false;
  for Item: Items.GameItem in State.Items do
    if (Item.Kind = Items.ItemKind.AncientCoin)
      and
      (Item.Location is Items.ItemLocation.CarriedByPlayer)
    then
      CarriesCoin := true;
    end if;
  end for;

  if CarriesCoin then
    Choices.PushInPlace(Choice(Id := 'coin', Text := 'What do you know about this coin?'));
  end if;

  if State.Health < GameState.PlayerMaximumHealth then
    Choices.PushInPlace(Choice(Id := 'wounds', Text := 'Could you tend my wounds?'));
  end if;

  Choices.PushInPlace(Choice(Id := 'quest', Text := 'About your lost compass...'));
  Choices.PushInPlace(Choice(Id := 'goodbye', Text := 'Goodbye.'));
  return Choices;
end function;

function RootFrame(State: GameState.GameState; Npc: Npcs.NpcPlacement; Text: string): Frame;
begin
  return Frame(
    Node := Node.Root, NpcId := Npc.Id, Speaker := Npc.DisplayName,
    Text := Text, Choices := ChoicesFor(State, Npc)
  );
end function;

// Starts next to the selected placement; first meeting changes only that NPC's flag.
// Repeated greetings and quest remembrance consume no turn or random draw.
public function Start(View: GameState.AreaView; State: GameState.GameState): result of (Outcome, string);
begin
  const Valid := try GameState.ValidateGameState(View, State);
  var Id := '';
  case NpcInteraction.InReach(View, Valid) of
    when None:
      return Error('no NPC is in interaction reach');
    when Some(const Reached):
      Id := Reached;
  end case;
  const Map := try GameState.CurrentInterior(View, Valid);
  const Npc := try Npcs.FindPlacement(Map.Npcs, Id);
  const Index := Npcs.IndexOf(Valid.Npcs, Id);
  if Index < 0 then
    return Error('NPC meeting record is absent');
  end if;
  var Text := '';
  if Npc.Id = Npcs.MaraId(View.Metadata) then
    Text := if Valid.Quest is QuestModel.QuestState.Rewarded(_) then 'Mara recognizes you and thanks you again for returning her compass.'
      else if Valid.Quest is QuestModel.QuestState.Active(_) then 'Mara recognizes you and remembers that you promised to find her compass.'
        else if Valid.Npcs[Index].HasMetPlayer then 'Mara recognizes you and rests both hands on her worn walking staff.'
          else 'A weathered adventurer lowers her lantern. She introduces herself as Mara and invites your questions.'
          end if
        end if
      end if;
  else
    Text := Villages.Greeting(Npc, Map.DisplayName, Valid.Npcs[Index].HasMetPlayer);
  end if;
  var Changed := Valid;
  Changed.Npcs[Index].HasMetPlayer := true;
  return Ok(
    Outcome.Continued(Changed, RootFrame(Changed, Npc, Text), not Valid.Npcs[Index].HasMetPlayer)
  );
end function;

function ValidateConversation(View: GameState.AreaView; State: GameState.GameState; Current: Frame): result of (GameState.GameState, string);
begin
  const Valid := try GameState.ValidateGameState(View, State);
  case NpcInteraction.InReach(View, Valid) of
    when None:
      return Error('dialogue NPC is not in reach');
    when Some(const Id):
      if Id <> Current.NpcId then
        return Error('dialogue does not match the current NPC');
      end if;
  end case;
  const Index := Npcs.IndexOf(Valid.Npcs, Current.NpcId);
  if (Index < 0) or not Valid.Npcs[Index].HasMetPlayer then
    return Error('dialogue NPC has not been met');
  end if;

  if not (Current.Node is Node.Root) and (Current.NpcId <> Npcs.MaraId(View.Metadata)) then
    return Error('only Mara can own a compass quest node');
  end if;

  return Ok(Valid);
end function;

// Read-only eligibility gate for world-layer preflight; generic NPCs can never cause that read.
public function MayOfferCompass(View: GameState.AreaView; State: GameState.GameState; Current: Frame): boolean;
begin
  if ValidateConversation(View, State, Current) is Error(_) then
    return false;
  end if;

  return (Current.NpcId = Npcs.MaraId(View.Metadata)) and (Current.Node is Node.Root)
    and
    MaraInReach(View, State) and (State.Quest is QuestModel.QuestState.NotAccepted)
    and
    Model.Contains(Current.Choices, 'quest');
end function;

// Trade is eligible only on a current merchant root frame that actually offered the topic.
public function MayTrade(View: GameState.AreaView; State: GameState.GameState; Current: Frame): boolean;
begin
  if ValidateConversation(View, State, Current) is Error(_) then
    return false;
  end if;

  if not (Current.Node is Node.Root) or not Model.Contains(Current.Choices, 'trade') then
    return false;
  end if;
  const Index := Npcs.IndexOf(State.Npcs, Current.NpcId);
  return (Index >= 0) and (State.Npcs[Index].Kind = Npcs.NpcKind.Merchant);
end function;

// Ends only the matching conversation, without changing items, time, health or dice.
public function EndConversation(View: GameState.AreaView; State: GameState.GameState; Current: Frame): result of (Outcome, string);
begin
  return Ok(Outcome.Ended(try ValidateConversation(View, State, Current)));
end function;

// Retains the exact preflighted objective only for Mara's eligible current root frame.
public function OfferCompass(View: GameState.AreaView; State: GameState.GameState; Current: Frame; Objective: QuestModel.CompassObjective): result of (Outcome, string);
begin
  const Valid := try ValidateConversation(View, State, Current);
  if not MayOfferCompass(View, Valid, Current) then
    return Error('quest offer requires Mara''s current root topic');
  end if;
  const Target := try QuestModel.ValidateObjective(View.Metadata, Objective);
  return Ok(
    Outcome.Continued(
      Valid,
      QuestDialogue.QuestFrame(View.Metadata, Valid, Node.CompassOffer(Target)),
      false
    )
  );
end function;

// Checks both retained and freshly available choices before any effect. Healing and quest effects
// change only their explicit candidate state; callers retain prepare/send/install reply ordering.
public function Choose(View: GameState.AreaView; State: GameState.GameState; Current: Frame; ChoiceId: string): result of (Outcome, string);
begin
  const Valid := try ValidateConversation(View, State, Current);
  const Map := try GameState.CurrentInterior(View, Valid);
  const Npc := try Npcs.FindPlacement(Map.Npcs, Current.NpcId);
  if not (Current.Node is Node.Root) then
    if ChoiceId = 'quest_back' then
      if not Model.Contains(Current.Choices, ChoiceId) then
        return Error('back is not available in this frame');
      end if;

      return Ok(
        Outcome.Continued(
          Valid,
          RootFrame(Valid, Npc, 'Mara waits for your next question.'),
          false
        )
      );
    end if;

    return QuestDialogue.Choose(View, Valid, Current, ChoiceId);
  end if;

  if not Model.Contains(Current.Choices, ChoiceId)
    or
    not Model.Contains(ChoicesFor(Valid, Npc), ChoiceId)
  then
    return Error('dialogue choice is not currently available');
  end if;

  if ChoiceId = 'goodbye' then
    return Ok(Outcome.Ended(Valid));
  end if;
  var Changed := Valid;
  var Text := '';
  if Npc.Kind <> Npcs.NpcKind.Mara then
    Text := try Villages.Answer(Npc, Map.DisplayName, ChoiceId);
    if ChoiceId = 'wounds' then
      Changed.Health := GameState.PlayerMaximumHealth;
    end if;

    return Ok(Outcome.Continued(Changed, RootFrame(Changed, Npc, Text), ChoiceId = 'wounds'));
  end if;

  case ChoiceId of
    when 'quest':
      if Valid.Quest is QuestModel.QuestState.NotAccepted then
        return Error('quest offer requires server reachability preflight');
      end if;

      return Ok(
        Outcome.Continued(
          Valid,
          QuestDialogue.QuestFrame(View.Metadata, Valid, Node.CompassStatus),
          false
        )
      );
    when 'identity':
      Text := 'Mara once mapped the nearby halls. She now lives in Hearthmoor and warns travelers who follow the same path.';
    when 'dungeon':
      const Region := Entrances.RegionOf(View.Metadata, View.Metadata.Spawn);
      Text := 'The nearby dungeon is ' +
        Content.DungeonName(View.Metadata.Seed, Region.X, Region.Y) +
        '. It has ' + Conv.IntToStr(Levels.DungeonDepth(View.Metadata.Seed, Region.X, Region.Y)) +
        ' levels. Mark each turn and look for the way back. Something restless still walks the inner passages.';
    when 'coin':
      Text := 'Mara studies the crescent-marked coin. She has seen the doorway symbol before, but not who minted it.';
    when 'wounds':
      Changed.Health := GameState.PlayerMaximumHealth;
      Text := 'Mara cleans and binds your wounds with practiced hands. You feel whole again.';
    else
      return Error('unknown dialogue choice');
  end case;

  return Ok(Outcome.Continued(Changed, RootFrame(Changed, Npc, Text), ChoiceId = 'wounds'));
end function;
end unit;
