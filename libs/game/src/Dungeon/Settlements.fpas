// Authored home-settlement geometry and identity, independent of mutable state and persistence.
unit Dungeon.Settlements;

uses Dungeon.Coordinates as Coordinates, Dungeon.Interior as InteriorUnit, Dungeon.Terrain as Terrain;

// Player-facing label of the sole authored home settlement.
public const HomeName: string := 'Hearthmoor';

// Stable identity of the world's sole authored settlement; other settlement identities are unsupported.
public function HomeAreaId(Metadata: Terrain.WorldMetadata): string;
begin
  return Metadata.Id + ':settlement:home';
end function;

// Constructs the immutable Hearthmoor grid. The interior geometry type is reused for bounded
// cells and validation only; the settlement is navigated and projected as a map without facing.
public function HomeMap(Metadata: Terrain.WorldMetadata): InteriorUnit.InteriorMap;
begin
  var Cells: array of InteriorUnit.InteriorCellKind := [];
  for Y: integer := 0 to 14 do
    for X: integer := 0 to 22 do
      const Border: boolean := (X = 0) or (X = 22) or (Y = 0) or (Y = 14);
      const House: boolean := (((X >= 3) and (X <= 7)) or ((X >= 15) and (X <= 19)))
        and
        (((Y >= 3) and (Y <= 5)) or ((Y >= 9) and (Y <= 11)));
      if (X = 11) and (Y = 13) then
        Cells.PushInPlace(InteriorUnit.InteriorCellKind.ExitField);
      else
        Cells.PushInPlace(
          if Border or House then InteriorUnit.InteriorCellKind.Wall
            else InteriorUnit.InteriorCellKind.Floor
            end if
        );
      end if;
    end for;
  end for;

  return InteriorUnit.InteriorMap(
    AreaId := HomeAreaId(Metadata), DisplayName := HomeName,
    Level := 0, Depth := 1, Width := 23, Height := 15, Cells := Cells,
    Start := Coordinates.InteriorPosition(X := 11, Y := 12),
    StartFacing := Coordinates.FacingDirection.North,
    Arrival := Coordinates.InteriorPosition(X := 11, Y := 13), Items := [], Hostiles := []
  );
end function;

// Rejects foreign identities or altered authored geometry; settlement maps never come from world files.
public function ValidateHomeMap(Metadata: Terrain.WorldMetadata; Map: InteriorUnit.InteriorMap): result of (InteriorUnit.InteriorMap, string);
begin
  const Expected := HomeMap(Metadata);
  if (Map.AreaId <> Expected.AreaId) or (Map.DisplayName <> Expected.DisplayName)
    or
    (Map.Level <> 0) or (Map.Depth <> 1) or (Map.Width <> 23) or (Map.Height <> 15)
    or
    (Map.Start <> Expected.Start) or (Map.StartFacing <> Expected.StartFacing)
    or
    (Map.Arrival <> Expected.Arrival) or (Map.Cells.Length() <> Expected.Cells.Length())
    or
    (Map.Items.Length() <> 0) or (Map.Hostiles.Length() <> 0)
  then
    return Error('settlement map must match the authored home settlement');
  end if;

  for Index: integer := 0 to Map.Cells.Length() - 1 do
    if Map.Cells[Index] <> Expected.Cells[Index] then
      return Error('settlement geometry must match the authored home settlement');
    end if;
  end for;

  return InteriorUnit.ValidateInteriorMap(Map);
end function;
end unit;
