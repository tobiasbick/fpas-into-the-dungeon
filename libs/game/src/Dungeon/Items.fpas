// Item kinds, identities, slots, locations, and their player-facing texts and codes.
unit Dungeon.Items;

uses Dungeon.Coordinates, Std.Conv;

public const
  // Player-facing texts of the known item kinds.
  AncientCoinName: string := 'Ancient coin';
  AncientCoinDescription: string := 'A heavy, tarnished coin marked with a doorway beneath a crescent moon.';
  RustyShortSwordName: string := 'Rusty short sword';
  RustyShortSwordDescription: string := 'A short blade pitted with rust. Its edge still bites.';
  LeatherJerkinName: string := 'Leather jerkin';
  LeatherJerkinDescription: string := 'A stiff jerkin of boiled leather, scuffed but whole.';

public type
  // Identifies every known item kind; the kind decides name, description, and slot.
  ItemKind = enum
    AncientCoin;
    RustyShortSword;
    LeatherJerkin;
  end enum;
  // Body location in which the player can wear one item at a time.
  EquipmentSlot = enum
    Weapon;
    Body;
  end enum;
  // Authoritative ownership or exact area-local placement of an item.
  ItemLocation = enum
    InInterior(AreaId: string; Position: InteriorPosition);
    CarriedByPlayer;
    // Worn by the player; the slot always fits the item kind.
    EquippedByPlayer(Slot: EquipmentSlot);
  end enum;
  // Initial floor placement of one item identity in an interior.
  ItemPlacement = record
    public ItemId: string;
    public Kind: ItemKind;
    public Position: InteriorPosition;
  end record;
  // Stable mutable item state; identity is unique within one game state.
  GameItem = record
    public Id: string;
    public Kind: ItemKind;
    public Location: ItemLocation;
  end record;

// Returns the canonical identity of the item placed at one index of an area's placement list.
public function ItemPlacementId(AreaId: string; Index: integer): string;
begin
  return (AreaId + ':item:') + IntToStr(Index);
end function;

// Returns the player-facing name of one authoritative item kind.
public function ItemDisplayName(Kind: ItemKind): string;
begin
  case Kind of
    when ItemKind.AncientCoin:
      begin
        return AncientCoinName;
      end;
    when ItemKind.RustyShortSword:
      begin
        return RustyShortSwordName;
      end;
    when ItemKind.LeatherJerkin:
      begin
        return LeatherJerkinName;
      end;
  end case;
end function;

// Returns the inspectable description of one authoritative item kind.
public function ItemDescription(Kind: ItemKind): string;
begin
  case Kind of
    when ItemKind.AncientCoin:
      begin
        return AncientCoinDescription;
      end;
    when ItemKind.RustyShortSword:
      begin
        return RustyShortSwordDescription;
      end;
    when ItemKind.LeatherJerkin:
      begin
        return LeatherJerkinDescription;
      end;
  end case;
end function;

// Returns the slot an item kind can be worn in; None means the item cannot be worn.
public function ItemSlot(Kind: ItemKind): option of EquipmentSlot;
begin
  case Kind of
    when ItemKind.AncientCoin:
      begin
        return None;
      end;
    when ItemKind.RustyShortSword:
      begin
        return Some(EquipmentSlot.Weapon);
      end;
    when ItemKind.LeatherJerkin:
      begin
        return Some(EquipmentSlot.Body);
      end;
  end case;
end function;

// Returns the client-safe interior code of an item lying on a visible field.
public function ItemVisibleCode(Kind: ItemKind): string;
begin
  case Kind of
    when ItemKind.RustyShortSword:
      begin
        return 'w';
      end;
    when ItemKind.LeatherJerkin:
      begin
        return 'a';
      end;
    else
      begin
        return 'i';
      end;
  end case;
end function;
end unit;
