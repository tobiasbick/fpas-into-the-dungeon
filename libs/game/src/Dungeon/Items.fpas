// Item kinds, identities, slots, locations, and their player-facing texts and codes.
unit Dungeon.Items;

uses Dungeon.Coordinates as Coordinates, Std.Conv as Conv;

// Player-facing texts of the known item kinds.
public const AncientCoinName: string := 'Ancient coin';
public const AncientCoinDescription: string := 'A heavy, tarnished coin marked with a doorway beneath a crescent moon.';
public const RustyShortSwordName: string := 'Rusty short sword';
public const RustyShortSwordDescription: string := 'A short blade pitted with rust. Its edge still bites.';
public const LeatherJerkinName: string := 'Leather jerkin';
public const LeatherJerkinDescription: string := 'A stiff jerkin of boiled leather, scuffed but whole.';
public const HealingPotionName: string := 'Healing potion';
public const HealingPotionDescription: string := 'A small glass flask filled with a glowing crimson draught.';
// The unique recoverable object of Mara's authored quest.
public const MarasCompassName: string := 'Mara''s compass';
public const MarasCompassDescription: string := 'A brass compass with a cracked lid and Mara''s initials engraved inside.';

// Identifies every known item kind; the kind decides name, description, and slot.
public type ItemKind = enum
  AncientCoin;
  RustyShortSword;
  LeatherJerkin;
  HealingPotion;
  MarasCompass;
end enum;

// Body location in which the player can wear one item at a time.
public type EquipmentSlot = enum
  Weapon;
  Body;
end enum;

// Authoritative ownership or exact area-local placement of an item.
public type ItemLocation = enum
  InInterior(AreaId: string; Position: Coordinates.InteriorPosition);
  CarriedByPlayer;
  // Owned stock; immutable origin remains encoded in the unchanged item identity.
  HeldByMerchant(MerchantId: string);
  // Worn by the player; the slot always fits the item kind.
  EquippedByPlayer(Slot: EquipmentSlot);
  // Terminal state for a healing potion; identity and kind remain for origin validation.
  Consumed;
  // Terminal hand-in of the unique compass, bound to the rewarded quest identity.
  ReturnedToMara(QuestId: string);
end enum;

// Initial floor placement of one item identity in an interior.
public type ItemPlacement = record
  public ItemId: string;
  public Kind: ItemKind;
  public Position: Coordinates.InteriorPosition;
end record;

// Stable mutable item state; identity is unique within one game state.
public type GameItem = record
  public Id: string;
  public Kind: ItemKind;
  public Location: ItemLocation;
end record;

// Returns an original-slot identity; omitted optional slots never renumber later finds.
public function ItemPlacementId(AreaId: string; Index: integer): string;
begin
  return (AreaId + ':item:') + Conv.IntToStr(Index);
end function;

// Returns the player-facing name of one authoritative item kind.
public function ItemDisplayName(Kind: ItemKind): string;
begin
  case Kind of
    when ItemKind.AncientCoin:
      begin
        return AncientCoinName;
      end;
    when ItemKind.RustyShortSword:
      begin
        return RustyShortSwordName;
      end;
    when ItemKind.LeatherJerkin:
      begin
        return LeatherJerkinName;
      end;
    when ItemKind.HealingPotion:
      return HealingPotionName;
    when ItemKind.MarasCompass:
      return MarasCompassName;
  end case;
end function;

// Returns the inspectable description of one authoritative item kind.
public function ItemDescription(Kind: ItemKind): string;
begin
  case Kind of
    when ItemKind.AncientCoin:
      begin
        return AncientCoinDescription;
      end;
    when ItemKind.RustyShortSword:
      begin
        return RustyShortSwordDescription;
      end;
    when ItemKind.LeatherJerkin:
      begin
        return LeatherJerkinDescription;
      end;
    when ItemKind.HealingPotion:
      return HealingPotionDescription;
    when ItemKind.MarasCompass:
      return MarasCompassDescription;
  end case;
end function;

// Returns the slot an item kind can be worn in; None means the item cannot be worn.
public function ItemSlot(Kind: ItemKind): option of EquipmentSlot;
begin
  case Kind of
    when ItemKind.AncientCoin, ItemKind.HealingPotion, ItemKind.MarasCompass:
      begin
        return None;
      end;
    when ItemKind.RustyShortSword:
      begin
        return Some(EquipmentSlot.Weapon);
      end;
    when ItemKind.LeatherJerkin:
      begin
        return Some(EquipmentSlot.Body);
      end;
  end case;
end function;

// Returns the client-safe interior code of an item lying on a visible field.
public function ItemVisibleCode(Kind: ItemKind): string;
begin
  case Kind of
    when ItemKind.RustyShortSword:
      begin
        return 'w';
      end;
    when ItemKind.LeatherJerkin:
      begin
        return 'a';
      end;
    when ItemKind.AncientCoin, ItemKind.MarasCompass:
      begin
        return 'i';
      end;
    when ItemKind.HealingPotion:
      return 'p';
  end case;
end function;
end unit;
