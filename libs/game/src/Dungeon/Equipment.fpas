// Derived character values from base values plus worn items, and the rules for wearing and dropping items.
unit Dungeon.Equipment;

uses Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Interior as InteriorUnit, Dungeon.Items as ItemRules, Std.Conv as Conv;

// Lowest d20 roll with which the player hits before any modifier.
public const BaseHitThreshold: integer := 6;
// Damage die of an unarmed blow; low on purpose so that a weapon matters.
public const UnarmedDamageSides: integer := 3;
// Armor of the unprotected character.
public const BaseArmor: integer := 0;

// The character's values as the rules read them; always derived, never persisted.
public type CharacterValues = record
  public MaximumHealth: integer;
  // Lowest d20 roll that hits an opponent.
  public HitThreshold: integer;
  // Damage of a hit is one roll of 1 through DamageSides plus DamageBonus.
  public DamageSides: integer;
  public DamageBonus: integer;
  // Added to an opponent's hit threshold.
  public Armor: integer;
end record;

// One player-facing line of the character sheet, formatted by the server.
public type CharacterValueLine = record
  public Label: string;
  public Value: string;
  // What the value comes from, such as `Base` or the name of a worn item.
  public Source: string;
end record;

// Accepted item change (wearing, removing, or dropping) and its turn log message.
public type EquipmentChange = record
  public State: GameState.GameState;
  public Message: string;
end record;

// Formats damage dice such as `d3` or `d6+1`.
public function DamageText(Sides: integer; Bonus: integer): string;
begin
  if Bonus = 0 then
    begin
      return 'd' + Conv.IntToStr(Sides);
    end;
  end if;

  return (('d' + Conv.IntToStr(Sides)) + '+') + Conv.IntToStr(Bonus);
end function;

// Derives the character's values from base values and the items worn in the given state.
public function DeriveCharacterValues(State: GameState.GameState): CharacterValues;
begin
  var Values: CharacterValues := CharacterValues(
    MaximumHealth := GameState.PlayerMaximumHealth,
    HitThreshold := BaseHitThreshold,
    DamageSides := UnarmedDamageSides,
    DamageBonus := 0,
    Armor := BaseArmor
  );
  case GameState.EquippedItem(State, ItemRules.EquipmentSlot.Weapon) of
    when Some(const Weapon):
      begin
        if Weapon.Kind = ItemRules.ItemKind.RustyShortSword then
          begin
            Values.DamageSides := 6;
            Values.DamageBonus := 1;
          end;
        end if;
      end;
    when None:
      begin
        null;
      end;
  end case;

  case GameState.EquippedItem(State, ItemRules.EquipmentSlot.Body) of
    when Some(const Armor):
      begin
        if Armor.Kind = ItemRules.ItemKind.LeatherJerkin then
          begin
            Values.Armor := Values.Armor + 2;
          end;
        end if;
      end;
    when None:
      begin
        null;
      end;
  end case;

  return Values;
end function;

function WornSource(State: GameState.GameState; Slot: ItemRules.EquipmentSlot; Fallback: string): string;
begin
  case GameState.EquippedItem(State, Slot) of
    when Some(const Item):
      begin
        return ItemRules.ItemDisplayName(Item.Kind);
      end;
    when None:
      begin
        return Fallback;
      end;
  end case;
end function;

// Returns the character sheet lines in a fixed order: health, hit chance, damage, armor.
public function CharacterValueLines(State: GameState.GameState): array of CharacterValueLine;
begin
  const Values: CharacterValues := DeriveCharacterValues(State);
  const HitPercent: integer := ((21 - Values.HitThreshold) * 100) div 20;
  return [
    CharacterValueLine(
      Label := 'Maximum health',
      Value := Conv.IntToStr(Values.MaximumHealth),
      Source := 'Base'
    ),
    CharacterValueLine(
      Label := 'Hit chance',
      Value := ((Conv.IntToStr(HitPercent) + '% (d20 ≥ ') + Conv.IntToStr(Values.HitThreshold)) +
      ')', Source := 'Base'
    ),
    CharacterValueLine(
      Label := 'Damage',
      Value := DamageText(Values.DamageSides, Values.DamageBonus),
      Source := WornSource(State, ItemRules.EquipmentSlot.Weapon, 'Unarmed')
    ),
    CharacterValueLine(
      Label := 'Armor',
      Value := Conv.IntToStr(Values.Armor),
      Source := WornSource(State, ItemRules.EquipmentSlot.Body, 'None')
    )
  ];
end function;

function ItemIndex(State: GameState.GameState; ItemId: string): result of (integer, string);
begin
  for Index: integer := 0 to State.Items.Length() - 1 do
    begin
      if State.Items[Index].Id = ItemId then
        begin
          return Ok(Index);
        end;
      end if;
    end;
  end for;

  return Error('unknown item');
end function;

function WornMessage(Kind: ItemRules.ItemKind; Slot: ItemRules.EquipmentSlot): string;
begin
  const Name: string := ItemRules.ItemDisplayName(Kind).ToLower();
  if Slot = ItemRules.EquipmentSlot.Weapon then
    begin
      return ('You wield the ' + Name) + '.';
    end;
  end if;

  return ('You put on the ' + Name) + '.';
end function;

function RemovedMessage(Kind: ItemRules.ItemKind; Slot: ItemRules.EquipmentSlot): string;
begin
  const Name: string := ItemRules.ItemDisplayName(Kind).ToLower();
  if Slot = ItemRules.EquipmentSlot.Weapon then
    begin
      return ('You put away the ' + Name) + '.';
    end;
  end if;

  return ('You take off the ' + Name) + '.';
end function;

// Wears a carried item in its slot; an item already worn there returns to the inventory.
// Errors name items that are unknown, not carried, already worn, or cannot be worn.
public function EquipItem(State: GameState.GameState; ItemId: string): result of (EquipmentChange, string);
begin
  const Index: integer := try ItemIndex(State, ItemId);
  const Item: ItemRules.GameItem := State.Items[Index];
  var Slot: ItemRules.EquipmentSlot := ItemRules.EquipmentSlot.Weapon;
  case ItemRules.ItemSlot(Item.Kind) of
    when Some(const Fitting):
      begin
        Slot := Fitting;
      end;
    when None:
      begin
        return Error('this item cannot be worn');
      end;
  end case;

  case Item.Location of
    when ItemRules.ItemLocation.CarriedByPlayer:
      begin
        null;
      end;
    when ItemRules.ItemLocation.EquippedByPlayer(const Worn):
      begin
        return Error('this item is already worn');
      end;
    when ItemRules.ItemLocation.InInterior(_, _), ItemRules.ItemLocation.Consumed:
      begin
        return Error('you do not carry this item');
      end;
  end case;
  var Items: array of ItemRules.GameItem := State.Items;
  for Other: integer := 0 to Items.Length() - 1 do
    begin
      case Items[Other].Location of
        when ItemRules.ItemLocation.EquippedByPlayer(const Worn):
          if Worn = Slot then
            begin
              Items[Other] := Items[Other] with Location := ItemRules.ItemLocation.CarriedByPlayer; end with;
            end;
          end if;
        when ItemRules.ItemLocation.InInterior(_, _), ItemRules.ItemLocation.CarriedByPlayer, ItemRules.ItemLocation.Consumed:
          null;
      end case;
    end;
  end for;

  Items[Index] := Item with Location := ItemRules.ItemLocation.EquippedByPlayer(Slot); end with;

  return Ok(
    EquipmentChange(
      State := State with Items := Items; end with,
      Message := WornMessage(Item.Kind, Slot)
    )
  );
end function;

// Returns a worn item to the inventory; errors name items that are unknown or not worn.
public function UnequipItem(State: GameState.GameState; ItemId: string): result of (EquipmentChange, string);
begin
  const Index: integer := try ItemIndex(State, ItemId);
  const Item: ItemRules.GameItem := State.Items[Index];
  case Item.Location of
    when ItemRules.ItemLocation.EquippedByPlayer(const Worn):
      var Items: array of ItemRules.GameItem := State.Items;
      Items[Index] := Item with Location := ItemRules.ItemLocation.CarriedByPlayer; end with;

      return Ok(
        EquipmentChange(
          State := State with Items := Items; end with,
          Message := RemovedMessage(Item.Kind, Worn)
        )
      );
    when ItemRules.ItemLocation.InInterior(_, _), ItemRules.ItemLocation.CarriedByPlayer, ItemRules.ItemLocation.Consumed:
      return Error('this item is not worn');
  end case;
end function;

// Lays a carried item on the occupied ordinary floor field of the current dungeon.
// Errors name items that are unknown, worn, or not carried, and fields that are the exit or hold an item.
public function DropItem(View: GameState.AreaView; State: GameState.GameState; ItemId: string): result of (EquipmentChange, string);
begin
  const Index: integer := try ItemIndex(State, ItemId);
  const Item: ItemRules.GameItem := State.Items[Index];
  case Item.Location of
    when ItemRules.ItemLocation.CarriedByPlayer:
      begin
        null;
      end;
    when ItemRules.ItemLocation.EquippedByPlayer(const Worn):
      begin
        return Error('take the item off before dropping it');
      end;
    when ItemRules.ItemLocation.InInterior(_, _), ItemRules.ItemLocation.Consumed:
      begin
        return Error('you do not carry this item');
      end;
  end case;

  if State.Area <> Coordinates.AreaKind.Dungeon then
    begin
      return Error('items can only be dropped inside a dungeon');
    end;
  end if;
  const Map: InteriorUnit.InteriorMap := try GameState.CurrentInterior(View, State);
  const Pose: Coordinates.FirstPersonPose := try GameState.FirstPersonPlayerPose(State);
  if try InteriorUnit.InteriorCellAt(Map, Pose.Position) <> InteriorUnit.InteriorCellKind.Floor then
    begin
      return Error('items cannot be dropped on the exit');
    end;
  end if;

  for Other: ItemRules.GameItem in State.Items do
    begin
      case Other.Location of
        when ItemRules.ItemLocation.InInterior(const AreaId, const Position):
          if (AreaId = State.AreaId) and Coordinates.SamePosition(Position, Pose.Position) then
            begin
              return Error('there is already an item here');
            end;
          end if;
        when ItemRules.ItemLocation.CarriedByPlayer, ItemRules.ItemLocation.EquippedByPlayer(_), ItemRules.ItemLocation.Consumed:
          null;
      end case;
    end;
  end for;
  var Items: array of ItemRules.GameItem := State.Items;
  Items[Index] := Item with Location := ItemRules.ItemLocation.InInterior(
    State.AreaId,
    Pose.Position
  ); end with;

  return Ok(
    EquipmentChange(
      State := State with Items := Items; end with,
      Message := ('You drop the ' + ItemRules.ItemDisplayName(Item.Kind).ToLower()) +
      '.'
    )
  );
end function;
end unit;
