// Derived character values from base values plus worn items, and the rules for wearing and dropping items.
unit Dungeon.Equipment;

uses
  Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interior, Dungeon.Items, Std.Arrays, Std.Conv,
  Std.Options, Std.Results, Std.Str;

public const
  // Lowest d20 roll with which the player hits before any modifier.
  BaseHitThreshold: integer := 6;
  // Damage die of an unarmed blow; low on purpose so that a weapon matters.
  UnarmedDamageSides: integer := 3;
  // Armor of the unprotected character.
  BaseArmor: integer := 0;

public type
  // The character's values as the rules read them; always derived, never persisted.
  CharacterValues = record
    public MaximumHealth: integer;
    // Lowest d20 roll that hits an opponent.
    public HitThreshold: integer;
    // Damage of a hit is one roll of 1 through DamageSides plus DamageBonus.
    public DamageSides: integer;
    public DamageBonus: integer;
    // Added to an opponent's hit threshold.
    public Armor: integer;
  end record;
  // One player-facing line of the character sheet, formatted by the server.
  CharacterValueLine = record
    public Label: string;
    public Value: string;
    // What the value comes from, such as `Base` or the name of a worn item.
    public Source: string;
  end record;
  // Accepted item change (wearing, removing, or dropping) and its turn log message.
  EquipmentChange = record
    public State: GameState;
    public Message: string;
  end record;

// Formats damage dice such as `d3` or `d6+1`.
public function DamageText(Sides: integer; Bonus: integer): string;
begin
  if Bonus = 0 then
    begin
      return 'd' + IntToStr(Sides);
    end;
  end if;

  return (('d' + IntToStr(Sides)) + '+') + IntToStr(Bonus);
end function;

// Derives the character's values from base values and the items worn in the given state.
public function DeriveCharacterValues(State: GameState): CharacterValues;
begin
  mutable var Values: CharacterValues := record
    MaximumHealth := PlayerMaximumHealth;
    HitThreshold := BaseHitThreshold;
    DamageSides := UnarmedDamageSides;
    DamageBonus := 0;
    Armor := BaseArmor;
  end;

  case EquippedItem(State, EquipmentSlot.Weapon) of
    when Some(Weapon):
      begin
        if Weapon.Kind = ItemKind.RustyShortSword then
          begin
            Values.DamageSides := 6;
            Values.DamageBonus := 1;
          end;
        end if;
      end;
    when None:
      begin
        null;
      end;
  end case;

  case EquippedItem(State, EquipmentSlot.Body) of
    when Some(Armor):
      begin
        if Armor.Kind = ItemKind.LeatherJerkin then
          begin
            Values.Armor := Values.Armor + 2;
          end;
        end if;
      end;
    when None:
      begin
        null;
      end;
  end case;

  return Values;
end function;

function WornSource(State: GameState; Slot: EquipmentSlot; Fallback: string): string;
begin
  case EquippedItem(State, Slot) of
    when Some(Item):
      begin
        return ItemDisplayName(Item.Kind);
      end;
    when None:
      begin
        return Fallback;
      end;
  end case;
end function;

// Returns the character sheet lines in a fixed order: health, hit chance, damage, armor.
public function CharacterValueLines(State: GameState): array of CharacterValueLine;
begin
  var Values: CharacterValues := DeriveCharacterValues(State);
  var HitPercent: integer := ((21 - Values.HitThreshold) * 100) div 20;
  return [record
    Label := 'Maximum health';
    Value := IntToStr(Values.MaximumHealth);
    Source := 'Base';
  end, record
    Label := 'Hit chance';
    Value := ((IntToStr(HitPercent) + '% (d20 ≥ ') + IntToStr(Values.HitThreshold)) + ')';
    Source := 'Base';
  end, record
    Label := 'Damage';
    Value := DamageText(Values.DamageSides, Values.DamageBonus);
    Source := WornSource(State, EquipmentSlot.Weapon, 'Unarmed');
  end, record
    Label := 'Armor';
    Value := IntToStr(Values.Armor);
    Source := WornSource(State, EquipmentSlot.Body, 'None');
  end];
end function;

function ItemIndex(State: GameState; ItemId: string): result of integer, string;
begin
  for Index: integer := 0 to Std.Arrays.Length(State.Items) - 1 do
    begin
      if State.Items[Index].Id = ItemId then
        begin
          return Ok(Index);
        end;
      end if;
    end;
  end for;

  return Error('unknown item');
end function;

function WornMessage(Kind: ItemKind; Slot: EquipmentSlot): string;
begin
  var Name: string := Std.Str.ToLower(ItemDisplayName(Kind));
  if Slot = EquipmentSlot.Weapon then
    begin
      return ('You wield the ' + Name) + '.';
    end;
  end if;

  return ('You put on the ' + Name) + '.';
end function;

function RemovedMessage(Kind: ItemKind; Slot: EquipmentSlot): string;
begin
  var Name: string := Std.Str.ToLower(ItemDisplayName(Kind));
  if Slot = EquipmentSlot.Weapon then
    begin
      return ('You put away the ' + Name) + '.';
    end;
  end if;

  return ('You take off the ' + Name) + '.';
end function;

// Wears a carried item in its slot; an item already worn there returns to the inventory.
// Errors name items that are unknown, not carried, already worn, or cannot be worn.
public function EquipItem(State: GameState; ItemId: string): result of EquipmentChange, string;
begin
  var Index: integer := try ItemIndex(State, ItemId);
  var Item: GameItem := State.Items[Index];
  mutable var Slot: EquipmentSlot := EquipmentSlot.Weapon;
  case ItemSlot(Item.Kind) of
    when Some(Fitting):
      begin
        Slot := Fitting;
      end;
    when None:
      begin
        return Error('this item cannot be worn');
      end;
  end case;

  case Item.Location of
    when ItemLocation.CarriedByPlayer:
      begin
        null;
      end;
    when ItemLocation.EquippedByPlayer(Worn):
      begin
        return Error('this item is already worn');
      end;
    when ItemLocation.InInterior(AreaId, Position):
      begin
        return Error('you do not carry this item');
      end;
  end case;
  mutable var Items: array of GameItem := State.Items;
  for Other: integer := 0 to Std.Arrays.Length(Items) - 1 do
    begin
      case Items[Other].Location of
        when ItemLocation.EquippedByPlayer(Worn):
          begin
            if Worn = Slot then
              begin
                Items[Other] := Items[Other] with Location := ItemLocation.CarriedByPlayer; end with;
              end;
            end if;
          end;
        else
          begin
            null;
          end;
      end case;
    end;
  end for;

  Items[Index] := Item with Location := ItemLocation.EquippedByPlayer(Slot); end with;

  return Ok(record
    State := State with Items := Items; end with;
    Message := WornMessage(Item.Kind, Slot);
  end);
end function;

// Returns a worn item to the inventory; errors name items that are unknown or not worn.
public function UnequipItem(State: GameState; ItemId: string): result of EquipmentChange, string;
begin
  var Index: integer := try ItemIndex(State, ItemId);
  var Item: GameItem := State.Items[Index];
  case Item.Location of
    when ItemLocation.EquippedByPlayer(Worn):
      begin
        mutable var Items: array of GameItem := State.Items;
        Items[Index] := Item with Location := ItemLocation.CarriedByPlayer; end with;

        return Ok(record
          State := State with Items := Items; end with;
          Message := RemovedMessage(Item.Kind, Worn);
        end);
      end;
    else
      begin
        return Error('this item is not worn');
      end;
  end case;
end function;

// Lays a carried item on the occupied ordinary floor field of the current dungeon.
// Errors name items that are unknown, worn, or not carried, and fields that are the exit or hold an item.
public function DropItem(View: AreaView; State: GameState; ItemId: string): result of EquipmentChange, string;
begin
  var Index: integer := try ItemIndex(State, ItemId);
  var Item: GameItem := State.Items[Index];
  case Item.Location of
    when ItemLocation.CarriedByPlayer:
      begin
        null;
      end;
    when ItemLocation.EquippedByPlayer(Worn):
      begin
        return Error('take the item off before dropping it');
      end;
    when ItemLocation.InInterior(AreaId, Position):
      begin
        return Error('you do not carry this item');
      end;
  end case;

  if State.Area <> AreaKind.Dungeon then
    begin
      return Error('items can only be dropped inside a dungeon');
    end;
  end if;
  var Map: InteriorMap := try CurrentInterior(View, State);
  var Pose: FirstPersonPose := try FirstPersonPlayerPose(State);
  if try InteriorCellAt(Map, Pose.Position) <> InteriorCellKind.Floor then
    begin
      return Error('items cannot be dropped on the exit');
    end;
  end if;

  for Other: GameItem in State.Items do
    begin
      case Other.Location of
        when ItemLocation.InInterior(AreaId, Position):
          begin
            if (AreaId = State.AreaId) and SamePosition(Position, Pose.Position) then
              begin
                return Error('there is already an item here');
              end;
            end if;
          end;
        else
          begin
            null;
          end;
      end case;
    end;
  end for;
  mutable var Items: array of GameItem := State.Items;
  Items[Index] := Item with Location := ItemLocation.InInterior(State.AreaId, Pose.Position); end with;

  return Ok(record
    State := State with Items := Items; end with;
    Message := ('You drop the ' + Std.Str.ToLower(ItemDisplayName(Item.Kind))) + '.';
  end);
end function;
end unit;
