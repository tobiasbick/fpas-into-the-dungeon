// The hand-authored initial dungeon: geometry, item placements, Mara, and the restless skeleton.
unit Dungeon.Interior.InitialDungeon;

uses
  Dungeon.Coordinates, Dungeon.Hostiles, Dungeon.Interior, Dungeon.Items, Dungeon.Npcs,
  Dungeon.Terrain, Std.Arrays, Std.Results, Std.Str;

// The coin lies on the upper corridor; sword and jerkin lie off the main route
// and outside the skeleton's line of sight, rewarding exploration before a fight.
function InitialDungeonItemPlacements(): array of ItemPlacement;
begin
  return [record
    ItemId := InitialDungeonItemId;
    Position := record
      X := 8;
      Y := 1;
    end;
  end, record
    ItemId := RustyShortSwordId;
    Position := record
      X := 7;
      Y := 4;
    end;
  end, record
    ItemId := LeatherJerkinId;
    Position := record
      X := 1;
      Y := 6;
    end;
  end]
end;

// Returns Mara's fixed field in the initial dungeon.
public function InitialDungeonNpcPosition(): InteriorPosition;
begin
  return record
    X := 1;
    Y := 1;
  end
end;

// The skeleton rests in the inner passages, hidden from the main corridors by walls.
function InitialDungeonHostilePosition(): InteriorPosition;
begin
  return record
    X := 3;
    Y := 3;
  end
end;

// Creates the fixed, hand-authored initial dungeon used by the first interior slice.
public function InitialDungeonMap(): result of InteriorMap, string;
begin
  var Rows: array of string := [
                                 '###########',
                                 '#.........#',
                                 '#.#####.#.#',
                                 '#.....#.#.#',
                                 '###.#.#.#.#',
                                 '#...#...#.#',
                                 '#.#####.#.#',
                                 '#x........#',
                                 '###########'
                               ];
  mutable var Cells: array of InteriorCellKind := [];
  for Row: string in Rows do
  begin
    for X: integer := 0 to Std.Str.Length(Row) - 1 do
    begin
      Std.Arrays.Push(Cells, try InteriorCellFromCode(Std.Str.CharAt(Row, X)))
    end
  end;

  return ValidateInteriorMap(record
    Width := 11;
    Height := 9;
    Cells := Cells;
    Start := record
      X := 9;
      Y := 1;
    end;
    StartFacing := FacingDirection.West;
    Exit := record
      X := 1;
      Y := 7;
    end;
    Tablet := record
      X := 9;
      Y := 0;
    end;
    Items := InitialDungeonItemPlacements();
    Npc := InitialDungeonNpcPosition();
    Hostile := InitialDungeonHostilePosition();
  end)
end;

// Returns the items of a new game at their initial dungeon placements.
public function InitialDungeonItems(Metadata: WorldMetadata): array of GameItem;
begin
  mutable var Items: array of GameItem := [];
  for Placement: ItemPlacement in InitialDungeonItemPlacements() do
  begin
    Std.Arrays.Push(Items, record
      Id := Placement.ItemId;
      Kind := Std.Results.Unwrap(KnownItemKind(Placement.ItemId));
      Location := ItemLocation.InInterior(Metadata.DungeonAreaId, Placement.Position);
    end)
  end;

  return Items
end;

// Returns the restless skeleton of a new game, dormant and at full health.
public function InitialDungeonHostile(Metadata: WorldMetadata): GameHostile;
begin
  return record
    Id := RestlessSkeletonId;
    Kind := HostileKind.RestlessSkeleton;
    AreaId := Metadata.DungeonAreaId;
    Position := InitialDungeonHostilePosition();
    Health := RestlessSkeletonMaximumHealth;
    Alerted := false;
  end
end;

// Returns Mara before she has met the player.
public function InitialDungeonNpc(): GameNpc;
begin
  return record
    Id := InitialDungeonNpcId;
    Kind := NpcKind.OldAdventurer;
    HasMetPlayer := false;
  end
end;
