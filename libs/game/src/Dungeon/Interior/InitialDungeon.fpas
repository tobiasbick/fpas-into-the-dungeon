// The hand-authored initial dungeon: geometry, item placements, and the restless skeleton.
unit Dungeon.Interior.InitialDungeon;

uses
  Dungeon.Coordinates, Dungeon.Hostiles, Dungeon.Interior, Dungeon.Items, Dungeon.Terrain,
  Std.Arrays, Std.Str;

// The coin lies on the upper corridor; sword and jerkin lie off the main route
// and outside the skeleton's line of sight, rewarding exploration before a fight.
function InitialDungeonItemPlacements(AreaId: string): array of ItemPlacement;
begin
  return [record
    ItemId := ItemPlacementId(AreaId, 0);
    Kind := ItemKind.AncientCoin;
    Position := record
      X := 8;
      Y := 1;
    end;
  end, record
    ItemId := ItemPlacementId(AreaId, 1);
    Kind := ItemKind.RustyShortSword;
    Position := record
      X := 7;
      Y := 4;
    end;
  end, record
    ItemId := ItemPlacementId(AreaId, 2);
    Kind := ItemKind.LeatherJerkin;
    Position := record
      X := 1;
      Y := 6;
    end;
  end]
end;

// The skeleton rests in the inner passages, hidden from the main corridors by walls.
function InitialDungeonHostilePlacements(AreaId: string): array of HostilePlacement;
begin
  return [record
    Id := HostilePlacementId(AreaId, 0);
    Kind := HostileKind.RestlessSkeleton;
    Position := record
      X := 3;
      Y := 3;
    end;
  end]
end;

// Creates the fixed initial geometry with the selected world's dungeon identity.
public function InitialDungeonMap(Metadata: WorldMetadata): result of InteriorMap, string;
begin
  var Rows: array of string := [
                                 '###########',
                                 '#.........#',
                                 '#.#####.#.#',
                                 '#.....#.#.#',
                                 '###.#.#.#.#',
                                 '#...#...#.#',
                                 '#.#####.#.#',
                                 '#x........#',
                                 '###########'
                               ];
  mutable var Cells: array of InteriorCellKind := [];
  for Row: string in Rows do
  begin
    for X: integer := 0 to Std.Str.Length(Row) - 1 do
    begin
      Std.Arrays.Push(Cells, try InteriorCellFromCode(Std.Str.CharAt(Row, X)))
    end
  end;

  return ValidateInteriorMap(record
    AreaId := Metadata.DungeonAreaId;
    Width := 11;
    Height := 9;
    Cells := Cells;
    Start := record
      X := 9;
      Y := 1;
    end;
    StartFacing := FacingDirection.West;
    Exit := record
      X := 1;
      Y := 7;
    end;
    Items := InitialDungeonItemPlacements(Metadata.DungeonAreaId);
    Hostiles := InitialDungeonHostilePlacements(Metadata.DungeonAreaId);
  end)
end;
