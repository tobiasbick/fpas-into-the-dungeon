// Per-level dungeon content and authored compass rules: dungeon depth, opponent slots, and original item slots.
unit Dungeon.Interior.Generation.Levels;

uses Dungeon.Terrain as Terrain, Dungeon.Terrain.Entrances as Entrances, Dungeon.Hostiles as HostileRules, Dungeon.Interior.Generation.Content as Content, Dungeon.Items as ItemRules, Std.Math as Math;

// Largest number of opponents on one generated level.
public const MaximumLevelHostiles: integer := 5;
// Reserved original slot of the unique compass; existing required and optional slots never move.
public const CompassSlot: integer := 6;

// Selects the compass only for the deepest level of the spawn's owning region.
public function CompassExpected(Metadata: Terrain.WorldMetadata; RegionX: integer; RegionY: integer; Level: integer; Depth: integer): boolean;
begin
  const SpawnRegion := Entrances.RegionOf(Metadata, Metadata.Spawn);
  return (SpawnRegion.X = RegionX) and (SpawnRegion.Y = RegionY) and (Level = Depth - 1);
end function;

// Returns the number of levels of one region's dungeon, 1..MaxDungeonDepth.
// Every dungeon currently has three levels; the result is stored with each level and never recomputed on read.
public function DungeonDepth(Seed: integer; RegionX: integer; RegionY: integer): integer;
begin
  return 3;
end function;

// Returns the opponent kinds of one level in slot order: skeletons first, then rats.
// Count is min(2 + (Level + 1) div 2, 5); skeletons are min(1 + Level div 2, count - 1), so at least one rat remains.
// Requires Level >= 0.
public function LevelHostileKinds(Level: integer): array of HostileRules.HostileKind;
begin
  const Count: integer := Math.Min(2 + ((Level + 1) div 2), MaximumLevelHostiles);
  const Skeletons: integer := Math.Min(1 + (Level div 2), Count - 1);
  var Kinds: array of HostileRules.HostileKind := [];
  for Index: integer := 0 to Count - 1 do
    if Index < Skeletons then
      Kinds.PushInPlace(HostileRules.HostileKind.RestlessSkeleton);
    else
      Kinds.PushInPlace(HostileRules.HostileKind.GiantRat);
    end if;
  end for;

  return Kinds;
end function;

// Returns the base guaranteed item kinds of one level, occupying original slots 0.. in order.
// Level 0 places coin, sword, jerkin and potion; deeper levels only a healing potion.
public function RequiredItemKinds(Level: integer): array of ItemRules.ItemKind;
begin
  if Level = 0 then
    return [
      ItemRules.ItemKind.AncientCoin, ItemRules.ItemKind.RustyShortSword,
      ItemRules.ItemKind.LeatherJerkin, ItemRules.ItemKind.HealingPotion
    ];
  end if;

  return [ItemRules.ItemKind.HealingPotion];
end function;

// Returns the optional original slots following the required ones: 4 and 5 on level 0, else 1 and 2.
public function OptionalItemSlots(Level: integer): array of integer;
begin
  if Level = 0 then
    return [4, 5];
  end if;

  return [1, 2];
end function;

// Selects every original item slot of one level; None marks an empty optional slot.
// WithCompass adds reserved slot 6, preserving empty gaps and existing identities.
// These content draws never consume geometry or combat state. Requires 0 <= Level <= 999.
public function SelectedItems(Seed: integer; RegionX: integer; RegionY: integer; Level: integer; WithCompass: boolean): array of option of ItemRules.ItemKind;
begin
  var Selected: array of option of ItemRules.ItemKind := [];
  for Kind: ItemRules.ItemKind in RequiredItemKinds(Level) do
    Selected.PushInPlace(Some(Kind));
  end for;

  for Slot: integer in OptionalItemSlots(Level) do
    if Level = 0 then
      Selected.PushInPlace(Content.OptionalLoot(Seed, RegionX, RegionY, Slot).Unwrap());
    else
      Selected.PushInPlace(Content.DeepOptionalLoot(Seed, RegionX, RegionY, Level, Slot).Unwrap());
    end if;
  end for;

  if WithCompass then
    while Selected.Length() < CompassSlot do
      Selected.PushInPlace(None);
    end while;

    Selected.PushInPlace(Some(ItemRules.ItemKind.MarasCompass));
  end if;

  return Selected;
end function;
end unit;
