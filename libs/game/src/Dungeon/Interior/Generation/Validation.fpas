// Structural rules of generated dungeons, shared by the generator and stored level validation.
unit Dungeon.Interior.Generation.Validation;

uses Dungeon.Coordinates as Coordinates, Dungeon.Exploration.Sight as Sight, Dungeon.Hostiles as HostileRules, Dungeon.Interior as InteriorUnit, Dungeon.Interior.Generation.Levels as Levels, Dungeon.Items as ItemRules, Std.Math as Math;

// Fixed field dimensions of every generated dungeon, including the outer wall.
public const GeneratedDungeonWidth: integer := 31;
public const GeneratedDungeonHeight: integer := 21;
// Longest accepted placement identity; equals the protocol's visible inventory text bound.
public const MaximumPlacementIdLength: integer := 128;

function FloorShareAccepted(Cells: array of InteriorUnit.InteriorCellKind): boolean;
begin
  var Open: integer := 0;
  for Cell: InteriorUnit.InteriorCellKind in Cells do
    begin
      if Cell <> InteriorUnit.InteriorCellKind.Wall then
        begin
          Open := Open + 1;
        end;
      end if;
    end;
  end for;

  return ((Open * 100) >= (Cells.Length() * 25)) and ((Open * 100) <= (Cells.Length() * 60));
end function;

// Mirrors combat perception: Chebyshev range and a clear line in either direction.
public function HostileSeesStart(Map: InteriorUnit.InteriorMap; Hostile: HostileRules.HostilePlacement): boolean;
begin
  const DeltaX: integer := Math.Abs(Hostile.Position.X - Map.Start.X);
  const DeltaY: integer := Math.Abs(Hostile.Position.Y - Map.Start.Y);
  if Math.Max(DeltaX, DeltaY) > HostileRules.HostileSightRange then
    begin
      return false;
    end;
  end if;

  return Sight.HasLineOfSight(Map, Hostile.Position, Map.Start)
    or
    Sight.HasLineOfSight(Map, Map.Start, Hostile.Position);
end function;

function OuterWallIntact(Map: InteriorUnit.InteriorMap): boolean;
begin
  for Y: integer := 0 to Map.Height - 1 do
    begin
      for X: integer := 0 to Map.Width - 1 do
        begin
          const OnBorder: boolean := ((X = 0) or (X = Map.Width - 1))
            or
            ((Y = 0) or (Y = Map.Height - 1));
          if OnBorder and (Map.Cells[(Y * Map.Width) + X] <> InteriorUnit.InteriorCellKind.Wall) then
            begin
              return false;
            end;
          end if;
        end;
      end for;
    end;
  end for;

  return true;
end function;

function PlacementsAccepted(Map: InteriorUnit.InteriorMap; WithCompass: boolean): result of (boolean, string);
begin
  const Required: array of ItemRules.ItemKind := Levels.RequiredItemKinds(Map.Level);
  const Optional: array of integer := Levels.OptionalItemSlots(Map.Level);
  const CompassCount := if WithCompass then 1 else 0 end if;
  if (Map.Items.Length() < Required.Length() + CompassCount)
    or
    (Map.Items.Length() > Required.Length() + Optional.Length() + CompassCount)
  then
    begin
      return Error(
        'generated dungeon level must place its required items and at most two optional finds'
      );
    end;
  end if;
  var PreviousSlot := -1;
  for Index: integer := 0 to Map.Items.Length() - 1 do
    begin
      const Item: ItemRules.ItemPlacement := Map.Items[Index];
      var Slot := -1;
      if Index < Required.Length() then
        if Item.Kind <> Required[Index] then
          return Error('generated dungeon level required slots have unexpected item kinds');
        end if;

        Slot := Index;
      else
        if WithCompass and (Index = Map.Items.Length() - 1) then
          if Item.Kind <> ItemRules.ItemKind.MarasCompass then
            return Error('deepest spawn level must contain Mara''s compass');
          end if;

          Slot := Levels.CompassSlot;
        else
          if Item.Kind = ItemRules.ItemKind.MarasCompass then
            return Error('compass cannot occupy an optional loot slot');
          end if;

          for Candidate: integer in Optional do
            if Item.ItemId = ItemRules.ItemPlacementId(Map.AreaId, Candidate) then
              Slot := Candidate;
            end if;
          end for;

          if Slot < 0 then
            return Error('generated dungeon optional finds must use an original optional slot');
          end if;
        end if;
      end if;

      if (Slot <= PreviousSlot) or (Item.ItemId <> ItemRules.ItemPlacementId(Map.AreaId, Slot)) then
        return Error(
          'generated dungeon items must have canonical identities in ascending original slot order'
        );
      end if;

      PreviousSlot := Slot;

      if Item.ItemId.Length() > MaximumPlacementIdLength then
        begin
          return Error('generated dungeon placement identity is too long');
        end;
      end if;
    end;
  end for;
  const HostileKinds := Levels.LevelHostileKinds(Map.Level);
  if Map.Hostiles.Length() <> HostileKinds.Length() then
    begin
      return Error('generated dungeon level has an unexpected number of opponents');
    end;
  end if;

  for Index: integer := 0 to Map.Hostiles.Length() - 1 do
    begin
      const Hostile: HostileRules.HostilePlacement := Map.Hostiles[Index];
      if (Hostile.Id <> HostileRules.HostilePlacementId(Map.AreaId, Index))
        or
        (Hostile.Kind <> HostileKinds[Index])
      then
        begin
          return Error(
            'generated dungeon opponents must follow the level slot kinds with canonical identities'
          );
        end;
      end if;

      if Hostile.Id.Length() > MaximumPlacementIdLength then
        begin
          return Error('generated dungeon placement identity is too long');
        end;
      end if;
    end;
  end for;

  return Ok(true);
end function;

// Checks every structural rule a stored or freshly generated dungeon must satisfy without
// rerunning the generator: dimensions, outer wall, start east of the arrival endpoint facing
// east, map validity including level endpoints, per-level ordered placements, floor share, and
// no opponent that could see the start.
// Room count is a generation-time rule only and is not checked here.
public function ValidateGeneratedDungeon(Map: InteriorUnit.InteriorMap; WithCompass: boolean): result of (InteriorUnit.InteriorMap, string);
begin
  if Map.Npcs.Length() <> 0 then
    return Error('dungeon levels cannot contain settlement NPC placements');
  end if;

  if (Map.Width <> GeneratedDungeonWidth) or (Map.Height <> GeneratedDungeonHeight) then
    begin
      return Error('generated dungeon must be 31 by 21 fields');
    end;
  end if;
  const Valid: InteriorUnit.InteriorMap := try InteriorUnit.ValidateInteriorMap(Map);
  if not OuterWallIntact(Valid) then
    begin
      return Error('generated dungeon outer wall must be intact');
    end;
  end if;

  if (
    (Valid.StartFacing <> Coordinates.FacingDirection.East)
    or
    (Valid.Start.X <> Valid.Arrival.X + 1)
  )
    or
    (Valid.Start.Y <> Valid.Arrival.Y)
  then
    begin
      return Error('generated dungeon start must face east one field east of the arrival endpoint');
    end;
  end if;

  if WithCompass and (Map.Level <> Map.Depth - 1) then
    return Error('compass must be on the deepest level');
  end if;
  const Placements: boolean := try PlacementsAccepted(Valid, WithCompass);
  if not FloorShareAccepted(Valid.Cells) then
    begin
      return Error('generated dungeon floor share is outside 25 to 60 percent');
    end;
  end if;

  for Hostile: HostileRules.HostilePlacement in Valid.Hostiles do
    begin
      if HostileSeesStart(Valid, Hostile) then
        begin
          return Error('generated dungeon opponent can see the start');
        end;
      end if;
    end;
  end for;

  return Ok(Valid);
end function;
end unit;
