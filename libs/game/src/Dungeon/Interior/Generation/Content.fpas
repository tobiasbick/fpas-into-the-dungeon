// Pure dungeon content selection with independent seeds; names never consume geometry or combat draws.
unit Dungeon.Interior.Generation.Content;

uses Dungeon.Coordinates as Coordinates, Dungeon.Random as Random;

// Returns the stable display name of one entrance region, independent of world identity and visit order.
// Normalize before multiplying so even signed-64-bit inputs keep intermediate values in range.
public function DungeonName(Seed: integer; RegionX: integer; RegionY: integer): string;
begin
  const Adjectives: array of string := [
    'Ashen', 'Silent', 'Forgotten', 'Sunken', 'Broken', 'Moonlit', 'Hollow', 'Shrouded'
  ];
  const Nouns: array of string := [
    'Vault', 'Crypt', 'Halls', 'Sanctum', 'Catacombs', 'Keep', 'Depths', 'Tomb'
  ];
  const NameSeed: integer := Coordinates.PositiveModulo(
    Coordinates.PositiveModulo(Seed, Random.RandomStateModulus) * 7919 +
    Coordinates.PositiveModulo(RegionX, Random.RandomStateModulus) * 104729 +
    Coordinates.PositiveModulo(RegionY, Random.RandomStateModulus) * 1299709 +
    1009, Random.RandomStateModulus
  );
  const Adjective := Random.DrawBelow(NameSeed, 8);
  const Noun := Random.DrawBelow(Adjective.State, 8);
  return Adjectives[Adjective.Value] + ' ' + Nouns[Noun.Value];
end function;
end unit;
