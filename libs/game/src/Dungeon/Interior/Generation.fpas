// Deterministic generated dungeon layouts: rooms, corridors, endpoints, opponents, and items.
unit Dungeon.Interior.Generation;

uses
  Dungeon.Coordinates, Dungeon.Hostiles, Dungeon.Interior, Dungeon.Interior.Generation.Validation,
  Dungeon.Items, Dungeon.Random, Std.Math;

const RoomPlacementTries: integer := 40;
const MaximumRooms: integer := 8;
const MinimumRooms: integer := 4;
const GenerationAttempts: integer := 16;

// Rectangular floor area of one placed room; X and Y name its top-left field.
type GeneratedRoom = record
  X: integer;
  Y: integer;
  Width: integer;
  Height: integer;
end record;

// Layout under construction and the generator state that produced it.
type Layout = record
  State: integer;
  Cells: array of InteriorCellKind;
  Rooms: array of GeneratedRoom;
end record;

function FieldIndex(Position: InteriorPosition): integer;
begin
  return (Position.Y * GeneratedDungeonWidth) + Position.X;
end function;

function RoomCenter(Room: GeneratedRoom): InteriorPosition;
begin
  return InteriorPosition(X := Room.X + (Room.Width div 2), Y := Room.Y + (Room.Height div 2));
end function;

// Rooms keep at least one wall between them: the candidate grown by one field must not overlap.
function RoomsTouch(Candidate: GeneratedRoom; Other: GeneratedRoom): boolean;
begin
  return ((Candidate.X - 1 < Other.X + Other.Width) and (Other.X < (Candidate.X + Candidate.Width) + 1)) and
         ((Candidate.Y - 1 < Other.Y + Other.Height) and (Other.Y < (Candidate.Y + Candidate.Height) + 1));
end function;

function PlaceRooms(Start: Layout): Layout;
begin
  var State: integer := Start.State;
  var Cells: array of InteriorCellKind := Start.Cells;
  var Rooms: array of GeneratedRoom := Start.Rooms;
  var Tries: integer := 0;
  while (Tries < RoomPlacementTries) and (Rooms.Length() < MaximumRooms) do
    begin
      Tries := Tries + 1;
      const WidthDraw: RandomDraw := DrawBelow(State, 5);
      const HeightDraw: RandomDraw := DrawBelow(WidthDraw.State, 3);
      const RoomWidth: integer := 3 + WidthDraw.Value;
      const RoomHeight: integer := 3 + HeightDraw.Value;
      // The room spans X .. X + RoomWidth - 1 and must leave the outer wall intact.
      const XDraw: RandomDraw := DrawBelow(HeightDraw.State, (GeneratedDungeonWidth - 1) - RoomWidth);
      const YDraw: RandomDraw := DrawBelow(XDraw.State, (GeneratedDungeonHeight - 1) - RoomHeight);
      State := YDraw.State;
      const Candidate: GeneratedRoom := GeneratedRoom(X := 1 + XDraw.Value, Y := 1 + YDraw.Value, Width := RoomWidth, Height := RoomHeight);
      var Free: boolean := true;
      for Other: GeneratedRoom in Rooms do
        begin
          if RoomsTouch(Candidate, Other) then
            begin
              Free := false;
            end;
          end if;
        end;
      end for;

      if Free then
        begin
          for Y: integer := Candidate.Y to (Candidate.Y + Candidate.Height) - 1 do
            begin
              for X: integer := Candidate.X to (Candidate.X + Candidate.Width) - 1 do
                begin
                  Cells[(Y * GeneratedDungeonWidth) + X] := InteriorCellKind.Floor;
                end;
              end for;
            end;
          end for;

          Rooms.Push(Candidate);
        end;
      end if;
    end;
  end while;

  return Layout(State := State, Cells := Cells, Rooms := Rooms);
end function;

function CarveHorizontal(Cells: array of InteriorCellKind; FromX: integer; ToX: integer; Y: integer): array of InteriorCellKind;
begin
  var Carved: array of InteriorCellKind := Cells;
  for X: integer := Std.Math.Min(FromX, ToX) to Std.Math.Max(FromX, ToX) do
    begin
      Carved[(Y * GeneratedDungeonWidth) + X] := InteriorCellKind.Floor;
    end;
  end for;

  return Carved;
end function;

function CarveVertical(Cells: array of InteriorCellKind; X: integer; FromY: integer; ToY: integer): array of InteriorCellKind;
begin
  var Carved: array of InteriorCellKind := Cells;
  for Y: integer := Std.Math.Min(FromY, ToY) to Std.Math.Max(FromY, ToY) do
    begin
      Carved[(Y * GeneratedDungeonWidth) + X] := InteriorCellKind.Floor;
    end;
  end for;

  return Carved;
end function;

// Carves an L-shaped corridor between two room centers; one draw selects the first leg.
function ConnectRooms(Start: Layout; FromRoom: integer; ToRoom: integer): Layout;
begin
  const From: InteriorPosition := RoomCenter(Start.Rooms[FromRoom]);
  const Target: InteriorPosition := RoomCenter(Start.Rooms[ToRoom]);
  const Orientation: RandomDraw := DrawBelow(Start.State, 2);
  var Current: Layout := Start;
  Current.State := Orientation.State;
  if Orientation.Value = 0 then
    begin
      Current.Cells := CarveHorizontal(Current.Cells, From.X, Target.X, From.Y);
      Current.Cells := CarveVertical(Current.Cells, Target.X, From.Y, Target.Y);
    end;
  else
    begin
      Current.Cells := CarveVertical(Current.Cells, From.X, From.Y, Target.Y);
      Current.Cells := CarveHorizontal(Current.Cells, From.X, Target.X, Target.Y);
    end;
  end if;

  return Current;
end function;

function ConnectAllRooms(Start: Layout): Layout;
begin
  var Current: Layout := Start;
  for Index: integer := 1 to Current.Rooms.Length() - 1 do
    begin
      Current := ConnectRooms(Current, Index - 1, Index);
    end;
  end for;
  const CountDraw: RandomDraw := DrawBelow(Current.State, 2);
  Current.State := CountDraw.State;
  for Extra: integer := 1 to 1 + CountDraw.Value do
    begin
      const FirstDraw: RandomDraw := DrawBelow(Current.State, Current.Rooms.Length());
      const SecondDraw: RandomDraw := DrawBelow(FirstDraw.State, Current.Rooms.Length());
      Current.State := SecondDraw.State;
      if FirstDraw.Value <> SecondDraw.Value then
        begin
          Current := ConnectRooms(Current, FirstDraw.Value, SecondDraw.Value);
        end;
      end if;
    end;
  end for;

  return Current;
end function;

// Breadth-first walking distance from Start to every field; walls and unreachable fields stay -1.
function WalkingDistances(Cells: array of InteriorCellKind; Start: InteriorPosition): array of integer;
begin
  var Distances: array of integer := array.Fill(-1, Cells.Length());
  var Queue: array of InteriorPosition := [Start];
  Distances[FieldIndex(Start)] := 0;
  var ReadIndex: integer := 0;
  const Offsets: array of InteriorPosition := [
                                                InteriorPosition(X := 0, Y := -1),
                                                InteriorPosition(X := 1, Y := 0),
                                                InteriorPosition(X := 0, Y := 1),
                                                InteriorPosition(X := -1, Y := 0)
                                              ];
  while ReadIndex < Queue.Length() do
    begin
      const Current: InteriorPosition := Queue[ReadIndex];
      ReadIndex := ReadIndex + 1;
      for Offset: InteriorPosition in Offsets do
        begin
          const Candidate: InteriorPosition := InteriorPosition(X := Current.X + Offset.X, Y := Current.Y +
                                                                                                Offset.Y);
          // Generated rooms and corridors never touch the outer wall, so neighbors stay inside.
          const Index: integer := FieldIndex(Candidate);
          if (Cells[Index] <> InteriorCellKind.Wall) and (Distances[Index] < 0) then
            begin
              Distances[Index] := Distances[FieldIndex(Current)] + 1;
              Queue.Push(Candidate);
            end;
          end if;
        end;
      end for;
    end;
  end while;

  return Distances;
end function;

// Orders the rooms except the exit room by center walking distance, farthest first, ties by index.
function RoomsFarthestFirst(Rooms: array of GeneratedRoom; Distances: array of integer): array of integer;
begin
  var Order: array of integer := [];
  for Index: integer := 1 to Rooms.Length() - 1 do
    begin
      const Distance: integer := Distances[FieldIndex(RoomCenter(Rooms[Index]))];
      var Sorted: array of integer := [];
      var Inserted: boolean := false;
      for Existing: integer in Order do
        begin
          if not Inserted and (Distances[FieldIndex(RoomCenter(Rooms[Existing]))] < Distance) then
            begin
              Sorted.Push(Index);
              Inserted := true;
            end;
          end if;

          Sorted.Push(Existing);
        end;
      end for;

      if not Inserted then
        begin
          Sorted.Push(Index);
        end;
      end if;

      Order := Sorted;
    end;
  end for;

  return Order;
end function;

function HostilePlacements(
  AreaId: string;
  Rooms: array of GeneratedRoom;
  Order: array of integer;
  Count: integer
): array of HostilePlacement;
begin
  var Placements: array of HostilePlacement := [];
  for Index: integer := 0 to Std.Math.Min(Count, Order.Length()) - 1 do
    begin
      Placements.Push(HostilePlacement(Id := HostilePlacementId(AreaId, Index), Kind := HostileKind.RestlessSkeleton, Position := RoomCenter(Rooms[Order[Index]])));
    end;
  end for;

  return Placements;
end function;

function HoldsHostile(Room: GeneratedRoom; Hostiles: array of HostilePlacement): boolean;
begin
  for Hostile: HostilePlacement in Hostiles do
    begin
      if SamePosition(Hostile.Position, RoomCenter(Room)) then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

function CornerIsFree(Corner: InteriorPosition; Map: InteriorMap; Items: array of ItemPlacement): boolean;
begin
  if SamePosition(Corner, Map.Exit) or SamePosition(Corner, Map.Start) then
    begin
      return false;
    end;
  end if;

  for Hostile: HostilePlacement in Map.Hostiles do
    begin
      if SamePosition(Corner, Hostile.Position) then
        begin
          return false;
        end;
      end if;
    end;
  end for;

  for Item: ItemPlacement in Items do
    begin
      if SamePosition(Corner, Item.Position) then
        begin
          return false;
        end;
      end if;
    end;
  end for;

  return true;
end function;

// Places coin, sword, and jerkin on free room corners, preferring rooms without exit or opponent.
function ItemPlacements(Map: InteriorMap; Rooms: array of GeneratedRoom): array of ItemPlacement;
begin
  const Kinds: array of ItemKind := [
                                      ItemKind.AncientCoin,
                                      ItemKind.RustyShortSword,
                                      ItemKind.LeatherJerkin
                                    ];
  var Preferred: array of GeneratedRoom := [];
  var Others: array of GeneratedRoom := [Rooms[0]];
  for Index: integer := 1 to Rooms.Length() - 1 do
    begin
      if HoldsHostile(Rooms[Index], Map.Hostiles) then
        begin
          Others.Push(Rooms[Index]);
        end;
      else
        begin
          Preferred.Push(Rooms[Index]);
        end;
      end if;
    end;
  end for;
  var Corners: array of InteriorPosition := [];
  for Room: GeneratedRoom in Preferred.Concat(Others) do
    begin
      const Left: integer := Room.X;
      const Right: integer := (Room.X + Room.Width) - 1;
      const Top: integer := Room.Y;
      const Bottom: integer := (Room.Y + Room.Height) - 1;
      Corners.Push(InteriorPosition(X := Left, Y := Top));
      Corners.Push(InteriorPosition(X := Right, Y := Top));
      Corners.Push(InteriorPosition(X := Left, Y := Bottom));
      Corners.Push(InteriorPosition(X := Right, Y := Bottom));
    end;
  end for;
  var Items: array of ItemPlacement := [];
  for Corner: InteriorPosition in Corners do
    begin
      if (Items.Length() < Kinds.Length()) and CornerIsFree(Corner, Map, Items) then
        begin
          const Index: integer := Items.Length();
          Items.Push(ItemPlacement(ItemId := ItemPlacementId(Map.AreaId, Index), Kind := Kinds[Index], Position := Corner));
        end;
      end if;
    end;
  end for;

  return Items;
end function;

// Builds one candidate layout from an attempt seed and applies every acceptance rule.
function GenerateAttempt(AttemptSeed: integer; AreaId: string): result of (InteriorMap, string);
begin
  const Empty: Layout := Layout(State := AttemptSeed, Cells := array.Fill(InteriorCellKind.Wall, GeneratedDungeonWidth *
                                                                                                 GeneratedDungeonHeight), Rooms := []);
  const Placed: Layout := PlaceRooms(Empty);
  if Placed.Rooms.Length() < MinimumRooms then
    begin
      return Error('generated dungeon has too few rooms');
    end;
  end if;
  const Connected: Layout := ConnectAllRooms(Placed);
  const FirstRoom: GeneratedRoom := Connected.Rooms[0];
  const Exit: InteriorPosition := InteriorPosition(X := FirstRoom.X, Y := FirstRoom.Y);
  const Start: InteriorPosition := InteriorPosition(X := FirstRoom.X + 1, Y := FirstRoom.Y);
  var Cells: array of InteriorCellKind := Connected.Cells;
  Cells[FieldIndex(Exit)] := InteriorCellKind.ExitField;
  const CountDraw: RandomDraw := DrawBelow(Connected.State, 2);
  const Order: array of integer := RoomsFarthestFirst(Connected.Rooms, WalkingDistances(Cells, Start));
  var Map: InteriorMap := InteriorMap(AreaId := AreaId, Width := GeneratedDungeonWidth, Height := GeneratedDungeonHeight, Cells := Cells, Start := Start, StartFacing := FacingDirection.East, Exit := Exit, Items := [], Hostiles := HostilePlacements(AreaId, Connected.Rooms, Order, 1 +
                                                                                                                                                                                                                                                                                        CountDraw.Value));
  Map.Items := ItemPlacements(Map, Connected.Rooms);
  return ValidateGeneratedDungeon(Map);
end function;

// Generates the dungeon of one entrance region as a pure function of seed and region.
// Up to 16 attempts with derived seeds run in order; the first accepted layout wins.
// An error after all attempts is a generator defect, not a player-facing condition.
public function GenerateDungeon(Seed: integer; RegionX: integer; RegionY: integer; AreaId: string): result of (InteriorMap, string);
begin
  var LastError: string := 'generated dungeon was not attempted';
  for Attempt: integer := 0 to GenerationAttempts - 1 do
    begin
      const AttemptSeed: integer := PositiveModulo((((Seed * 7919) + (RegionX * 104729)) + (RegionY * 1299709)) +
                                                   (Attempt * 15485863), RandomStateModulus);
      case GenerateAttempt(AttemptSeed, AreaId) of
        when Ok(const Map):
          begin
            return Ok(Map);
          end;
        when Error(const Message):
          begin
            LastError := Message;
          end;
      end case;
    end;
  end for;

  return Error('dungeon generation failed after 16 attempts: ' + LastError);
end function;
end unit;
