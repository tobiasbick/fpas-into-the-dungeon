// Canonical generated dungeon area identities and their entrance regions.
unit Dungeon.Areas.Identities;

uses Dungeon.Coordinates as Coordinates, Dungeon.Terrain as Terrain, Dungeon.Terrain.Entrances as Entrances, Std.Conv as Conv, Std.Parse as Parse;

// Builds the canonical identity `<world>:dungeon:<rx>:<ry>` of one region's dungeon.
public function DungeonAreaId(Metadata: Terrain.WorldMetadata; Region: Entrances.RegionCoordinate): string;
begin
  return (
    (((Metadata.Id + ':dungeon:') + Conv.IntToStr(Region.X)) + ':') + Conv.IntToStr(Region.Y)
  );
end function;

function CanonicalInteger(Text: string): result of (integer, string);
begin
  const Value: integer := try Parse.Int(Text);
  if Conv.IntToStr(Value) <> Text then
    begin
      return Error('dungeon area identity must use canonical region coordinates');
    end;
  end if;

  return Ok(Value);
end function;

// Parses a canonical dungeon identity of the selected world back into its region.
// Rejects other worlds, extra segments, non-canonical integers, and regions without an entrance site.
public function ParseDungeonAreaId(Metadata: Terrain.WorldMetadata; AreaId: string): result of (Entrances.RegionCoordinate, string);
begin
  const Prefix: string := Metadata.Id + ':dungeon:';
  if not AreaId.StartsWith(Prefix) then
    begin
      return Error('dungeon area identity does not name a dungeon of the selected world');
    end;
  end if;
  const PrefixLength: integer := Prefix.Length();
  const CoordinateText: string := AreaId.Slice(PrefixLength, AreaId.Length() - PrefixLength);
  const Segments: array of string := CoordinateText.Split(':');
  if Segments.Length() <> 2 then
    begin
      return Error('dungeon area identity must name exactly one region');
    end;
  end if;
  const Region: Entrances.RegionCoordinate := Entrances.RegionCoordinate(
    X := try CanonicalInteger(Segments[0]),
    Y := try CanonicalInteger(Segments[1])
  );
  if Entrances.EntranceSite(Metadata, Region) is None then
    begin
      return Error('dungeon area identity names a region without an entrance');
    end;
  end if;

  return Ok(Region);
end function;
end unit;
