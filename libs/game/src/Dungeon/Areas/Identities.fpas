// Canonical generated dungeon area identities and their entrance regions.
unit Dungeon.Areas.Identities;

uses
  Dungeon.Coordinates, Dungeon.Terrain, Dungeon.Terrain.Entrances, Std.Arrays, Std.Conv, Std.Options,
  Std.Parse, Std.Str;

public const
  // Player-facing title of every generated dungeon until dungeons receive names.
  GeneratedDungeonLabel: string := 'Forgotten dungeon';

// Builds the canonical identity `<world>:dungeon:<rx>:<ry>` of one region's dungeon.
public function DungeonAreaId(Metadata: WorldMetadata; Region: RegionCoordinate): string;
begin
  return ((((Metadata.Id + ':dungeon:') + IntToStr(Region.X)) + ':') + IntToStr(Region.Y));
end function;

function CanonicalInteger(Text: string): result of integer, string;
begin
  var Value: integer := try Std.Parse.TryInt(Text);
  if IntToStr(Value) <> Text then
    begin
      return Error('dungeon area identity must use canonical region coordinates');
    end;
  end if;

  return Ok(Value);
end function;

// Parses a canonical dungeon identity of the selected world back into its region.
// Rejects other worlds, extra segments, non-canonical integers, and regions without an entrance site.
public function ParseDungeonAreaId(Metadata: WorldMetadata; AreaId: string): result of RegionCoordinate, string;
begin
  var Prefix: string := Metadata.Id + ':dungeon:';
  if not Std.Str.StartsWith(AreaId, Prefix) then
    begin
      return Error('dungeon area identity does not name a dungeon of the selected world');
    end;
  end if;
  var PrefixLength: integer := Std.Str.Length(Prefix);
  var Coordinates: string := Std.Str.Substring(AreaId, PrefixLength, Std.Str.Length(AreaId) -
                                                                     PrefixLength);
  var Segments: array of string := Std.Str.Split(Coordinates, ':');
  if Std.Arrays.Length(Segments) <> 2 then
    begin
      return Error('dungeon area identity must name exactly one region');
    end;
  end if;
  var Region: RegionCoordinate := record
    X := try CanonicalInteger(Segments[0]);
    Y := try CanonicalInteger(Segments[1]);
  end;

  if IsNone(EntranceSite(Metadata, Region)) then
    begin
      return Error('dungeon area identity names a region without an entrance');
    end;
  end if;

  return Ok(Region);
end function;
end unit;
