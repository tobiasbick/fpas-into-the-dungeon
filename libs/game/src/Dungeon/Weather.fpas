// Pure seed/day weather: one six-hour rainy window per day, without mutable weather or random draws.
unit Dungeon.Weather;

uses Dungeon.Time as Clock, Dungeon.Terrain.Noise as Noise;

// Open-air weather; sheltered locations omit this value in their projection.
public type WeatherKind = enum
  Clear;
  Rain;
end enum;

// Derives the condition at a validated canonical minute; jumps do not simulate intermediate windows.
public function At(Seed: integer; WorldMinutes: integer): WeatherKind;
requires (WorldMinutes >= 0) and (WorldMinutes <= Clock.MaximumMinutes);
begin
  const Day := Clock.DayNumber(WorldMinutes) - 1;
  const RainWindow := Noise.CoordinateHash(Seed, Day, 0, 2203) mod 4;
  const Window := Clock.MinuteOfDay(WorldMinutes) div 360;
  return if Window = RainWindow then WeatherKind.Rain else WeatherKind.Clear end if;
end function;
end unit;
