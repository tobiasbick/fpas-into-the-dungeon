// Bounded interior geometry: field kinds, codes, lookups, item placements, and map validation.
unit Dungeon.Interior;

uses Dungeon.Coordinates as Coordinates, Dungeon.Hostiles as HostileRules, Dungeon.Items as ItemRules;

// Largest stored display name, in printable ASCII characters.
public const MaximumInteriorNameLength: integer := 64;

// Authoritative field material of the fixed initial interior.
public type InteriorCellKind = enum
  Wall;
  Floor;
  ExitField;
end enum;

// Complete bounded interior geometry with one connected start and exit.
public type InteriorMap = record
  // Stable server-owned identity of the area represented by this geometry.
  public AreaId: string;
  // Immutable player-facing name; nonempty printable ASCII without leading/trailing spaces.
  public DisplayName: string;
  public Width: integer;
  public Height: integer;
  public Cells: array of InteriorCellKind;
  public Start: Coordinates.InteriorPosition;
  public StartFacing: Coordinates.FacingDirection;
  public Exit: Coordinates.InteriorPosition;
  // Initial floor placements of the area's items, each on a distinct floor field.
  public Items: array of ItemRules.ItemPlacement;
  // Initial opponent placements, on distinct floor fields away from items and endpoints.
  public Hostiles: array of HostileRules.HostilePlacement;
end record;

// Parses one authored interior field code.
public function InteriorCellFromCode(Code: string): result of (InteriorCellKind, string);
begin
  case Code of
    when '#':
      begin
        return Ok(InteriorCellKind.Wall);
      end;
    when '.':
      begin
        return Ok(InteriorCellKind.Floor);
      end;
    when 'x':
      begin
        return Ok(InteriorCellKind.ExitField);
      end;
    else
      begin
        return Error('interior row contains an unknown field code');
      end;
  end case;
end function;

// Returns the compact client-safe code for one interior field.
public function InteriorCellCode(Cell: InteriorCellKind): string;
begin
  case Cell of
    when InteriorCellKind.Wall:
      begin
        return '#';
      end;
    when InteriorCellKind.Floor:
      begin
        return '.';
      end;
    when InteriorCellKind.ExitField:
      begin
        return 'x';
      end;
  end case;
end function;

// Returns one interior field after checking bounded area-local coordinates and map shape.
public function InteriorCellAt(Map: InteriorMap; Position: Coordinates.InteriorPosition): result of (InteriorCellKind, string);
begin
  if (Map.Width <= 0) or (Map.Height <= 0) then
    begin
      return Error('interior dimensions must be positive');
    end;
  end if;

  if Map.Cells.Length() <> Map.Width * Map.Height then
    begin
      return Error('interior field count must match its dimensions');
    end;
  end if;

  if ((Position.X < 0) or (Position.X >= Map.Width))
    or
    ((Position.Y < 0) or (Position.Y >= Map.Height))
  then
    begin
      return Error('interior position is outside the area');
    end;
  end if;

  return Ok(Map.Cells[(Position.Y * Map.Width) + Position.X]);
end function;

// Returns the client-safe visible code for one interior field.
public function InteriorVisibleCode(Map: InteriorMap; Position: Coordinates.InteriorPosition): result of (string, string);
begin
  const Cell: InteriorCellKind := try InteriorCellAt(Map, Position);
  return Ok(InteriorCellCode(Cell));
end function;

// Validates the stored name, bounded shape, unique exit, traversable endpoints, and connected floor space.
public function ValidateInteriorMap(Map: InteriorMap): result of (InteriorMap, string);
begin
  if (Map.DisplayName.Length() = 0) or (Map.DisplayName.Length() > MaximumInteriorNameLength) then
    return Error('interior name must contain 1 through 64 printable ASCII characters');
  end if;

  for Index: integer := 0 to Map.DisplayName.Length() - 1 do
    if (Map.DisplayName[Index].Ord() < 32) or (Map.DisplayName[Index].Ord() > 126) then
      return Error('interior name must use printable ASCII');
    end if;
  end for;

  if Map.DisplayName.StartsWith(' ') or Map.DisplayName.EndsWith(' ') then
    return Error('interior name must not start or end with a space');
  end if;

  if Map.AreaId = '' then
    begin
      return Error('interior area identity must not be empty');
    end;
  end if;

  if (Map.Width <= 0) or (Map.Height <= 0) then
    begin
      return Error('interior dimensions must be positive');
    end;
  end if;

  if Map.Cells.Length() <> Map.Width * Map.Height then
    begin
      return Error('interior field count must match its dimensions');
    end;
  end if;
  const StartCell: InteriorCellKind := try InteriorCellAt(Map, Map.Start);
  if StartCell <> InteriorCellKind.Floor then
    begin
      return Error('interior start must be a floor field');
    end;
  end if;
  const ExitCell: InteriorCellKind := try InteriorCellAt(Map, Map.Exit);
  if ExitCell <> InteriorCellKind.ExitField then
    begin
      return Error('interior exit coordinate must name the exit field');
    end;
  end if;

  for Index: integer := 0 to Map.Hostiles.Length() - 1 do
    begin
      const Placement: HostileRules.HostilePlacement := Map.Hostiles[Index];
      if try InteriorCellAt(Map, Placement.Position) <> InteriorCellKind.Floor then
        begin
          return Error('interior opponent coordinate must name a floor field');
        end;
      end if;

      if Coordinates.SamePosition(Placement.Position, Map.Start)
        or
        Coordinates.SamePosition(Placement.Position, Map.Exit)
      then
        begin
          return Error('interior opponent coordinate must differ from start and exit');
        end;
      end if;

      for Other: integer := 0 to Index - 1 do
        begin
          if Map.Hostiles[Other].Id = Placement.Id then
            begin
              return Error('interior opponent placements must name distinct opponents');
            end;
          end if;

          if Coordinates.SamePosition(Map.Hostiles[Other].Position, Placement.Position) then
            begin
              return Error('interior opponent placements must occupy distinct fields');
            end;
          end if;
        end;
      end for;
    end;
  end for;

  for Index: integer := 0 to Map.Items.Length() - 1 do
    begin
      const Placement: ItemRules.ItemPlacement := Map.Items[Index];
      if try InteriorCellAt(Map, Placement.Position) <> InteriorCellKind.Floor then
        begin
          return Error('interior item coordinate must name a floor field');
        end;
      end if;

      if Coordinates.SamePosition(Placement.Position, Map.Start)
        or
        Coordinates.SamePosition(Placement.Position, Map.Exit)
      then
        begin
          return Error('interior item coordinate must differ from start and exit');
        end;
      end if;

      for Hostile: HostileRules.HostilePlacement in Map.Hostiles do
        begin
          if Coordinates.SamePosition(Placement.Position, Hostile.Position) then
            begin
              return Error('interior items and opponents must occupy distinct fields');
            end;
          end if;

          if Placement.ItemId = Hostile.Id then
            begin
              return Error('interior placement identities must be distinct');
            end;
          end if;
        end;
      end for;

      for Other: integer := 0 to Index - 1 do
        begin
          if Map.Items[Other].ItemId = Placement.ItemId then
            begin
              return Error('interior item placements must name distinct items');
            end;
          end if;

          if Coordinates.SamePosition(Map.Items[Other].Position, Placement.Position) then
            begin
              return Error('interior item placements must occupy distinct fields');
            end;
          end if;
        end;
      end for;
    end;
  end for;
  var ExitCount: integer := 0;
  var TraversableCount: integer := 0;
  for Cell: InteriorCellKind in Map.Cells do
    begin
      if Cell <> InteriorCellKind.Wall then
        begin
          TraversableCount := TraversableCount + 1;
        end;
      end if;

      if Cell = InteriorCellKind.ExitField then
        begin
          ExitCount := ExitCount + 1;
        end;
      end if;
    end;
  end for;

  if ExitCount <> 1 then
    begin
      return Error('interior must contain exactly one exit field');
    end;
  end if;
  var Visited: array of boolean := array.Fill(false, Map.Width * Map.Height);
  var Queue: array of Coordinates.InteriorPosition := [Map.Start];
  Visited[(Map.Start.Y * Map.Width) + Map.Start.X] := true;
  var ReadIndex: integer := 0;
  var VisitedCount: integer := 0;
  const Offsets: array of Coordinates.InteriorPosition := [
    Coordinates.InteriorPosition(X := 0, Y := -1),
    Coordinates.InteriorPosition(X := 1, Y := 0),
    Coordinates.InteriorPosition(X := 0, Y := 1),
    Coordinates.InteriorPosition(X := -1, Y := 0)
  ];
  while ReadIndex < Queue.Length() do
    begin
      const Current: Coordinates.InteriorPosition := Queue[ReadIndex];
      ReadIndex := ReadIndex + 1;
      VisitedCount := VisitedCount + 1;
      for Offset: Coordinates.InteriorPosition in Offsets do
        begin
          const Candidate: Coordinates.InteriorPosition := Coordinates.InteriorPosition(
            X := Current.X + Offset.X, Y := Current.Y +
            Offset.Y
          );
          if ((Candidate.X >= 0) and (Candidate.X < Map.Width))
            and
            ((Candidate.Y >= 0) and (Candidate.Y < Map.Height))
          then
            begin
              const CandidateIndex: integer := (Candidate.Y * Map.Width) + Candidate.X;
              if not Visited[CandidateIndex] then
                begin
                  if Map.Cells[CandidateIndex] <> InteriorCellKind.Wall then
                    begin
                      Visited[CandidateIndex] := true;
                      Queue.PushInPlace(Candidate);
                    end;
                  end if;
                end;
              end if;
            end;
          end if;
        end;
      end for;
    end;
  end while;

  if VisitedCount <> TraversableCount then
    begin
      return Error('all traversable interior fields must be connected to the start');
    end;
  end if;

  return Ok(Map);
end function;
end unit;
