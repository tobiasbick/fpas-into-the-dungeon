// Bounded interior geometry: field kinds, codes, lookups, item placements, and map validation.
unit Dungeon.Interior;

uses Dungeon.Coordinates, Dungeon.Items, Std.Arrays;

public type
  // Authoritative field material of the fixed initial interior.
  InteriorCellKind = enum
    Wall;
    Floor;
    ExitField;
  end;
  // Complete bounded interior geometry with one connected start and exit.
  InteriorMap = record
    public Width: integer;
    public Height: integer;
    public Cells: array of InteriorCellKind;
    public Start: InteriorPosition;
    public StartFacing: FacingDirection;
    public Exit: InteriorPosition;
    // Fixed wall field occupied by the initial dungeon's inspectable stone tablet.
    public Tablet: InteriorPosition;
    // Initial floor placements of the area's items, each on a distinct floor field.
    public Items: array of ItemPlacement;
    // Fixed blocking floor placement of the first non-player character.
    public Npc: InteriorPosition;
    // Initial floor placement of the first opponent.
    public Hostile: InteriorPosition;
  end;

// Parses one authored interior field code.
public function InteriorCellFromCode(Code: string): result of InteriorCellKind, string;
begin
  case Code of
    '#':
    begin
      return Ok(InteriorCellKind.Wall)
    end;
    '.':
    begin
      return Ok(InteriorCellKind.Floor)
    end;
    'x':
    begin
      return Ok(InteriorCellKind.ExitField)
    end
    else
    begin
      return Error('interior row contains an unknown field code')
    end
  end
end;

// Returns the compact client-safe code for one interior field.
public function InteriorCellCode(Cell: InteriorCellKind): string;
begin
  case Cell of
    InteriorCellKind.Wall:
    begin
      return '#'
    end;
    InteriorCellKind.Floor:
    begin
      return '.'
    end;
    InteriorCellKind.ExitField:
    begin
      return 'x'
    end
  end
end;

// Returns one interior field after checking bounded area-local coordinates and map shape.
public function InteriorCellAt(Map: InteriorMap; Position: InteriorPosition): result of InteriorCellKind, string;
begin
  if (Map.Width <= 0) or (Map.Height <= 0) then
  begin
    return Error('interior dimensions must be positive')
  end;

  if Std.Arrays.Length(Map.Cells) <> Map.Width * Map.Height then
  begin
    return Error('interior field count must match its dimensions')
  end;

  if ((Position.X < 0) or (Position.X >= Map.Width)) or
     ((Position.Y < 0) or (Position.Y >= Map.Height)) then
  begin
    return Error('interior position is outside the area')
  end;

  return Ok(Map.Cells[(Position.Y * Map.Width) + Position.X])
end;

// Returns the client-safe visible code for geometry or the fixed stone tablet overlay.
public function InteriorVisibleCode(Map: InteriorMap; Position: InteriorPosition): result of string, string;
begin
  var Cell: InteriorCellKind := try InteriorCellAt(Map, Position);
  if (Position.X = Map.Tablet.X) and (Position.Y = Map.Tablet.Y) then
  begin
    return Ok('t')
  end;

  return Ok(InteriorCellCode(Cell))
end;

// Validates bounded shape, unique exit, traversable endpoints, and connected floor space.
public function ValidateInteriorMap(Map: InteriorMap): result of InteriorMap, string;
begin
  if (Map.Width <= 0) or (Map.Height <= 0) then
  begin
    return Error('interior dimensions must be positive')
  end;

  if Std.Arrays.Length(Map.Cells) <> Map.Width * Map.Height then
  begin
    return Error('interior field count must match its dimensions')
  end;
  var StartCell: InteriorCellKind := try InteriorCellAt(Map, Map.Start);
  if StartCell <> InteriorCellKind.Floor then
  begin
    return Error('interior start must be a floor field')
  end;
  var ExitCell: InteriorCellKind := try InteriorCellAt(Map, Map.Exit);
  if ExitCell <> InteriorCellKind.ExitField then
  begin
    return Error('interior exit coordinate must name the exit field')
  end;
  var TabletCell: InteriorCellKind := try InteriorCellAt(Map, Map.Tablet);
  if TabletCell <> InteriorCellKind.Wall then
  begin
    return Error('interior tablet coordinate must name a wall field')
  end;
  var NpcCell: InteriorCellKind := try InteriorCellAt(Map, Map.Npc);
  if NpcCell <> InteriorCellKind.Floor then
  begin
    return Error('interior NPC coordinate must name a floor field')
  end;

  if SamePosition(Map.Npc, Map.Start) or SamePosition(Map.Npc, Map.Exit) then
  begin
    return Error('interior NPC coordinate must differ from start and exit')
  end;
  var HostileCell: InteriorCellKind := try InteriorCellAt(Map, Map.Hostile);
  if HostileCell <> InteriorCellKind.Floor then
  begin
    return Error('interior opponent coordinate must name a floor field')
  end;

  if (SamePosition(Map.Hostile, Map.Start) or SamePosition(Map.Hostile, Map.Exit)) or
     SamePosition(Map.Hostile, Map.Npc) then
  begin
    return Error('interior opponent coordinate must differ from start, exit, and NPC')
  end;

  for Index: integer := 0 to Std.Arrays.Length(Map.Items) - 1 do
  begin
    var Placement: ItemPlacement := Map.Items[Index];
    if try InteriorCellAt(Map, Placement.Position) <> InteriorCellKind.Floor then
    begin
      return Error('interior item coordinate must name a floor field')
    end;

    if ((SamePosition(Placement.Position, Map.Start) or SamePosition(Placement.Position, Map.Exit)) or SamePosition(Placement.Position, Map.Npc)) or
       SamePosition(Placement.Position, Map.Hostile) then
    begin
      return Error('interior item coordinate must differ from start, exit, NPC, and opponent')
    end;

    for Other: integer := 0 to Index - 1 do
    begin
      if Map.Items[Other].ItemId = Placement.ItemId then
      begin
        return Error('interior item placements must name distinct items')
      end;

      if SamePosition(Map.Items[Other].Position, Placement.Position) then
      begin
        return Error('interior item placements must occupy distinct fields')
      end
    end
  end;
  mutable var ExitCount: integer := 0;
  mutable var TraversableCount: integer := 0;
  for Cell: InteriorCellKind in Map.Cells do
  begin
    if Cell <> InteriorCellKind.Wall then
    begin
      TraversableCount := TraversableCount + 1
    end;

    if Cell = InteriorCellKind.ExitField then
    begin
      ExitCount := ExitCount + 1
    end
  end;

  if ExitCount <> 1 then
  begin
    return Error('interior must contain exactly one exit field')
  end;
  mutable var Visited: array of boolean := Std.Arrays.Fill(false, Map.Width * Map.Height);
  mutable var Queue: array of InteriorPosition := [Map.Start];
  Visited[(Map.Start.Y * Map.Width) + Map.Start.X] := true;
  mutable var ReadIndex: integer := 0;
  mutable var VisitedCount: integer := 0;
  var Offsets: array of InteriorPosition := [record
    X := 0;
    Y := -1;
  end, record
    X := 1;
    Y := 0;
  end, record
    X := 0;
    Y := 1;
  end, record
    X := -1;
    Y := 0;
  end];
  while ReadIndex < Std.Arrays.Length(Queue) do
  begin
    var Current: InteriorPosition := Queue[ReadIndex];
    ReadIndex := ReadIndex + 1;
    VisitedCount := VisitedCount + 1;
    for Offset: InteriorPosition in Offsets do
    begin
      var Candidate: InteriorPosition := record
        X := Current.X + Offset.X;
        Y := Current.Y + Offset.Y;
      end;

      if ((Candidate.X >= 0) and (Candidate.X < Map.Width)) and
         ((Candidate.Y >= 0) and (Candidate.Y < Map.Height)) then
      begin
        var CandidateIndex: integer := (Candidate.Y * Map.Width) + Candidate.X;
        if not Visited[CandidateIndex] then
        begin
          if Map.Cells[CandidateIndex] <> InteriorCellKind.Wall then
          begin
            Visited[CandidateIndex] := true;
            Std.Arrays.Push(Queue, Candidate)
          end
        end
      end
    end
  end;

  if VisitedCount <> TraversableCount then
  begin
    return Error('all traversable interior fields must be connected to the start')
  end;

  return Ok(Map)
end;

// Returns the initial field of one item in an interior map.
public function InitialItemPosition(Map: InteriorMap; ItemId: string): result of InteriorPosition, string;
begin
  for Placement: ItemPlacement in Map.Items do
  begin
    if Placement.ItemId = ItemId then
    begin
      return Ok(Placement.Position)
    end
  end;

  return Error('item has no placement in this area')
end;
