// Bounded interior geometry: field kinds, codes, lookups, item placements, and map validation.
unit Dungeon.Interior;

uses Dungeon.Coordinates as Coordinates, Dungeon.Hostiles as HostileRules, Dungeon.Items as ItemRules, Dungeon.Npcs.Model as NpcModel;

// Largest stored display name, in printable ASCII characters.
public const MaximumInteriorNameLength: integer := 64;
// Safety bound on the number of levels of one dungeon; not a gameplay value.
public const MaxDungeonDepth: integer := 16;

// Authoritative field material of an interior. Stairs are walkable endpoints like the exit.
public type InteriorCellKind = enum
  Wall;
  Floor;
  ExitField;
  StairsUp;
  StairsDown;
end enum;

// Complete bounded interior geometry of one dungeon level with a connected start and arrival endpoint.
// Level 0 has the exit as arrival; deeper levels arrive on stairs up. Every level except the
// deepest (Level = Depth - 1) has exactly one stairs down, whose east neighbor is the descent landing.
public type InteriorMap = record
  // Stable server-owned identity of the area represented by this geometry.
  public AreaId: string;
  // Immutable player-facing name; nonempty printable ASCII without leading/trailing spaces.
  public DisplayName: string;
  // Zero-based level index within its dungeon, below Depth.
  public Level: integer;
  // Number of levels of the dungeon, 1..MaxDungeonDepth; stored, never recomputed on read.
  public Depth: integer;
  public Width: integer;
  public Height: integer;
  public Cells: array of InteriorCellKind;
  public Start: Coordinates.InteriorPosition;
  public StartFacing: Coordinates.FacingDirection;
  // Exit field on level 0, stairs up on deeper levels.
  public Arrival: Coordinates.InteriorPosition;
  // Initial floor placements of the area's items, each on a distinct floor field.
  public Items: array of ItemRules.ItemPlacement;
  // Initial opponent placements, on distinct floor fields away from items and endpoints.
  public Hostiles: array of HostileRules.HostilePlacement;
  // Immutable stationary NPC placements; empty in dungeon levels.
  public Npcs: array of NpcModel.NpcPlacement;
end record;

// Parses one authored interior field code.
public function InteriorCellFromCode(Code: string): result of (InteriorCellKind, string);
begin
  case Code of
    when '#':
      begin
        return Ok(InteriorCellKind.Wall);
      end;
    when '.':
      begin
        return Ok(InteriorCellKind.Floor);
      end;
    when 'x':
      begin
        return Ok(InteriorCellKind.ExitField);
      end;
    when '<':
      return Ok(InteriorCellKind.StairsUp);
    when '>':
      return Ok(InteriorCellKind.StairsDown);
    else
      begin
        return Error('interior row contains an unknown field code');
      end;
  end case;
end function;

// Returns the compact client-safe code for one interior field.
public function InteriorCellCode(Cell: InteriorCellKind): string;
begin
  case Cell of
    when InteriorCellKind.Wall:
      begin
        return '#';
      end;
    when InteriorCellKind.Floor:
      begin
        return '.';
      end;
    when InteriorCellKind.ExitField:
      begin
        return 'x';
      end;
    when InteriorCellKind.StairsUp:
      return '<';
    when InteriorCellKind.StairsDown:
      return '>';
  end case;
end function;

// Returns one interior field after checking bounded area-local coordinates and map shape.
public function InteriorCellAt(Map: InteriorMap; Position: Coordinates.InteriorPosition): result of (InteriorCellKind, string);
begin
  if (Map.Width <= 0) or (Map.Height <= 0) then
    begin
      return Error('interior dimensions must be positive');
    end;
  end if;

  if Map.Cells.Length() <> Map.Width * Map.Height then
    begin
      return Error('interior field count must match its dimensions');
    end;
  end if;

  if ((Position.X < 0) or (Position.X >= Map.Width))
    or
    ((Position.Y < 0) or (Position.Y >= Map.Height))
  then
    begin
      return Error('interior position is outside the area');
    end;
  end if;

  return Ok(Map.Cells[(Position.Y * Map.Width) + Position.X]);
end function;

// Returns the client-safe visible code for one interior field.
public function InteriorVisibleCode(Map: InteriorMap; Position: Coordinates.InteriorPosition): result of (string, string);
begin
  const Cell: InteriorCellKind := try InteriorCellAt(Map, Position);
  return Ok(InteriorCellCode(Cell));
end function;

// Returns the endpoint kind the player arrives on: the exit on level 0, stairs up below it.
public function ArrivalCellKind(Level: integer): InteriorCellKind;
begin
  if Level = 0 then
    return InteriorCellKind.ExitField;
  end if;

  return InteriorCellKind.StairsUp;
end function;

// Returns whether a level of the given dungeon depth leads further down.
public function LeadsDeeper(Level: integer; Depth: integer): boolean;
begin
  return Level < Depth - 1;
end function;

// Returns the first field of the given kind in row order, if any.
function FirstCellOfKind(Map: InteriorMap; Kind: InteriorCellKind): option of Coordinates.InteriorPosition;
begin
  for Index: integer := 0 to Map.Cells.Length() - 1 do
    if Map.Cells[Index] = Kind then
      return Some(
        Coordinates.InteriorPosition(X := Index mod Map.Width, Y := Index div Map.Width)
      );
    end if;
  end for;

  return None;
end function;

// Returns the stairs down of a validated map, or None on the deepest level.
public function StairsDownPosition(Map: InteriorMap): option of Coordinates.InteriorPosition;
begin
  return FirstCellOfKind(Map, InteriorCellKind.StairsDown);
end function;

// Returns the pose of a player climbing up onto this validated level: one field east of its
// stairs down, facing east. None on the deepest level.
public function DescentLanding(Map: InteriorMap): option of Coordinates.FirstPersonPose;
begin
  case StairsDownPosition(Map) of
    when Some(const Stairs):
      return Some(
        Coordinates.FirstPersonPose(
          Position := Coordinates.InteriorPosition(X := Stairs.X + 1, Y := Stairs.Y),
          Facing := Coordinates.FacingDirection.East
        )
      );
    when None:
      return None;
  end case;
end function;

// Derives the arrival endpoint of a level from its cells; errors unless exactly one exists.
public function ArrivalFromCells(Cells: array of InteriorCellKind; Width: integer; Level: integer): result of (Coordinates.InteriorPosition, string);
begin
  const Kind: InteriorCellKind := ArrivalCellKind(Level);
  var Found: option of Coordinates.InteriorPosition := None;
  for Index: integer := 0 to Cells.Length() - 1 do
    if Cells[Index] = Kind then
      if Found is Some(_) then
        return Error('interior must contain exactly one arrival endpoint');
      end if;

      Found := Some(Coordinates.InteriorPosition(X := Index mod Width, Y := Index div Width));
    end if;
  end for;

  case Found of
    when Some(const Position):
      return Ok(Position);
    when None:
      return Error('interior must contain exactly one arrival endpoint');
  end case;
end function;

// Validates the stored name, level within depth, bounded shape, endpoint counts for the level,
// a floor descent landing, traversable endpoints, and connected floor space.
public function ValidateInteriorMap(Map: InteriorMap): result of (InteriorMap, string);
begin
  if (Map.DisplayName.Length() = 0) or (Map.DisplayName.Length() > MaximumInteriorNameLength) then
    return Error('interior name must contain 1 through 64 printable ASCII characters');
  end if;

  for Index: integer := 0 to Map.DisplayName.Length() - 1 do
    if (Map.DisplayName[Index].Ord() < 32) or (Map.DisplayName[Index].Ord() > 126) then
      return Error('interior name must use printable ASCII');
    end if;
  end for;

  if Map.DisplayName.StartsWith(' ') or Map.DisplayName.EndsWith(' ') then
    return Error('interior name must not start or end with a space');
  end if;

  if (Map.Depth < 1) or (Map.Depth > MaxDungeonDepth) then
    return Error('interior depth must be from 1 through 16 levels');
  end if;

  if (Map.Level < 0) or (Map.Level >= Map.Depth) then
    return Error('interior level must be below its dungeon depth');
  end if;

  if Map.AreaId = '' then
    begin
      return Error('interior area identity must not be empty');
    end;
  end if;

  if (Map.Width <= 0) or (Map.Height <= 0) then
    begin
      return Error('interior dimensions must be positive');
    end;
  end if;

  if Map.Cells.Length() <> Map.Width * Map.Height then
    begin
      return Error('interior field count must match its dimensions');
    end;
  end if;
  const StartCell: InteriorCellKind := try InteriorCellAt(Map, Map.Start);
  if StartCell <> InteriorCellKind.Floor then
    begin
      return Error('interior start must be a floor field');
    end;
  end if;
  const ArrivalCell: InteriorCellKind := try InteriorCellAt(Map, Map.Arrival);
  if ArrivalCell <> ArrivalCellKind(Map.Level) then
    begin
      return Error('interior arrival coordinate must name the exit or stairs up of its level');
    end;
  end if;
  var Landing: Coordinates.InteriorPosition := Map.Arrival;
  case DescentLanding(Map) of
    when Some(const Pose):
      if try InteriorCellAt(Map, Pose.Position) <> InteriorCellKind.Floor then
        return Error('interior descent landing east of the stairs down must be a floor field');
      end if;

      Landing := Pose.Position;
    when None:
      null;
  end case;

  for Index: integer := 0 to Map.Hostiles.Length() - 1 do
    begin
      const Placement: HostileRules.HostilePlacement := Map.Hostiles[Index];
      if try InteriorCellAt(Map, Placement.Position) <> InteriorCellKind.Floor then
        begin
          return Error('interior opponent coordinate must name a floor field');
        end;
      end if;

      if Coordinates.SamePosition(Placement.Position, Map.Start)
        or
        Coordinates.SamePosition(Placement.Position, Landing)
      then
        begin
          return Error('interior opponent coordinate must differ from start and descent landing');
        end;
      end if;

      for Other: integer := 0 to Index - 1 do
        begin
          if Map.Hostiles[Other].Id = Placement.Id then
            begin
              return Error('interior opponent placements must name distinct opponents');
            end;
          end if;

          if Coordinates.SamePosition(Map.Hostiles[Other].Position, Placement.Position) then
            begin
              return Error('interior opponent placements must occupy distinct fields');
            end;
          end if;
        end;
      end for;
    end;
  end for;

  for Index: integer := 0 to Map.Items.Length() - 1 do
    begin
      const Placement: ItemRules.ItemPlacement := Map.Items[Index];
      if try InteriorCellAt(Map, Placement.Position) <> InteriorCellKind.Floor then
        begin
          return Error('interior item coordinate must name a floor field');
        end;
      end if;

      if Coordinates.SamePosition(Placement.Position, Map.Start)
        or
        Coordinates.SamePosition(Placement.Position, Landing)
      then
        begin
          return Error('interior item coordinate must differ from start and descent landing');
        end;
      end if;

      for Hostile: HostileRules.HostilePlacement in Map.Hostiles do
        begin
          if Coordinates.SamePosition(Placement.Position, Hostile.Position) then
            begin
              return Error('interior items and opponents must occupy distinct fields');
            end;
          end if;

          if Placement.ItemId = Hostile.Id then
            begin
              return Error('interior placement identities must be distinct');
            end;
          end if;
        end;
      end for;

      for Other: integer := 0 to Index - 1 do
        begin
          if Map.Items[Other].ItemId = Placement.ItemId then
            begin
              return Error('interior item placements must name distinct items');
            end;
          end if;

          if Coordinates.SamePosition(Map.Items[Other].Position, Placement.Position) then
            begin
              return Error('interior item placements must occupy distinct fields');
            end;
          end if;
        end;
      end for;
    end;
  end for;
  var ExitCount: integer := 0;
  var UpCount: integer := 0;
  var DownCount: integer := 0;
  var TraversableCount: integer := 0;
  for Cell: InteriorCellKind in Map.Cells do
    begin
      if Cell <> InteriorCellKind.Wall then
        begin
          TraversableCount := TraversableCount + 1;
        end;
      end if;

      if Cell = InteriorCellKind.ExitField then
        begin
          ExitCount := ExitCount + 1;
        end;
      end if;

      if Cell = InteriorCellKind.StairsUp then
        UpCount := UpCount + 1;
      end if;

      if Cell = InteriorCellKind.StairsDown then
        DownCount := DownCount + 1;
      end if;
    end;
  end for;
  var ExpectedExits: integer := 0;
  var ExpectedUps: integer := 1;
  if Map.Level = 0 then
    ExpectedExits := 1;
    ExpectedUps := 0;
  end if;
  var ExpectedDowns: integer := 0;
  if LeadsDeeper(Map.Level, Map.Depth) then
    ExpectedDowns := 1;
  end if;

  if ExitCount <> ExpectedExits then
    begin
      return Error('interior must contain exactly one exit field on level 0 and none below');
    end;
  end if;

  if UpCount <> ExpectedUps then
    return Error('interior must contain exactly one stairs up below level 0 and none on it');
  end if;

  if DownCount <> ExpectedDowns then
    return Error(
      'interior must contain exactly one stairs down above the deepest level and none on it'
    );
  end if;
  var Visited: array of boolean := array.Fill(false, Map.Width * Map.Height);
  var Queue: array of Coordinates.InteriorPosition := [Map.Start];
  Visited[(Map.Start.Y * Map.Width) + Map.Start.X] := true;
  var ReadIndex: integer := 0;
  var VisitedCount: integer := 0;
  const Offsets: array of Coordinates.InteriorPosition := [
    Coordinates.InteriorPosition(X := 0, Y := -1),
    Coordinates.InteriorPosition(X := 1, Y := 0),
    Coordinates.InteriorPosition(X := 0, Y := 1),
    Coordinates.InteriorPosition(X := -1, Y := 0)
  ];
  while ReadIndex < Queue.Length() do
    begin
      const Current: Coordinates.InteriorPosition := Queue[ReadIndex];
      ReadIndex := ReadIndex + 1;
      VisitedCount := VisitedCount + 1;
      for Offset: Coordinates.InteriorPosition in Offsets do
        begin
          const Candidate: Coordinates.InteriorPosition := Coordinates.InteriorPosition(
            X := Current.X + Offset.X, Y := Current.Y +
            Offset.Y
          );
          if ((Candidate.X >= 0) and (Candidate.X < Map.Width))
            and
            ((Candidate.Y >= 0) and (Candidate.Y < Map.Height))
          then
            begin
              const CandidateIndex: integer := (Candidate.Y * Map.Width) + Candidate.X;
              if not Visited[CandidateIndex] then
                begin
                  if Map.Cells[CandidateIndex] <> InteriorCellKind.Wall then
                    begin
                      Visited[CandidateIndex] := true;
                      Queue.PushInPlace(Candidate);
                    end;
                  end if;
                end;
              end if;
            end;
          end if;
        end;
      end for;
    end;
  end while;

  if VisitedCount <> TraversableCount then
    begin
      return Error('all traversable interior fields must be connected to the start');
    end;
  end if;

  return Ok(Map);
end function;
end unit;
