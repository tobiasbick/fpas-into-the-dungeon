// Player movement: outdoor steps, first-person steps and turns, and area transitions.
unit Dungeon.Movement;

uses Dungeon.Areas as Areas, Dungeon.Areas.Identities as Identities, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Hostiles as HostileRules, Dungeon.Interior as InteriorUnit, Dungeon.Terrain as Terrain, Dungeon.Terrain.Entrances as Entrances, Std.Math as Math;

// Atomic pure transition result: replacement player state and its matching current view.
public type AreaTransition = record
  public State: GameState.GameState;
  public View: GameState.AreaView;
end record;

// Returns the transition target of a state that the caller already validated against View,
// without validating it again; see AreaTransitionTarget for the targets.
public function TransitionTargetOfValid(View: GameState.AreaView; Valid: GameState.GameState): result of (string, string);
begin
  const Metadata: Terrain.WorldMetadata := View.Metadata;
  if Valid.Area = Coordinates.AreaKind.OutdoorRegion then
    begin
      const Position: Coordinates.WorldPosition := try GameState.OutdoorPlayerPosition(Valid);
      case Entrances.EntranceRegionAt(Metadata, Position) of
        when Some(const Region):
          begin
            return Ok(Identities.DungeonAreaId(Metadata, Region, 0));
          end;
        when None:
          begin
            return Error('player is not standing on an entrance');
          end;
      end case;
    end;
  end if;
  const Map: InteriorUnit.InteriorMap := try GameState.CurrentInterior(View, Valid);
  const Pose: Coordinates.FirstPersonPose := try GameState.FirstPersonPlayerPose(Valid);
  const Current: Identities.DungeonLevelId := try Identities.ParseDungeonLevelId(
    Metadata,
    Map.AreaId
  );
  if Coordinates.SamePosition(Pose.Position, Map.Arrival) then
    if Map.Level = 0 then
      return Ok(Metadata.OutdoorAreaId);
    end if;

    return Ok(Identities.DungeonAreaId(Metadata, Current.Region, Map.Level - 1));
  end if;

  case InteriorUnit.StairsDownPosition(Map) of
    when Some(const Stairs):
      if Coordinates.SamePosition(Pose.Position, Stairs) then
        return Ok(Identities.DungeonAreaId(Metadata, Current.Region, Map.Level + 1));
      end if;
    when None:
      null;
  end case;

  return Error('player is not standing on the interior exit or stairs');
end function;

// Validates entrance, exit or stairs eligibility and returns the server-owned target identity:
// level 0 of the entrance's dungeon outdoors, the outdoor area from the level-0 exit, the level
// above from stairs up, and the level below from stairs down. Does not load geometry or change state.
public function AreaTransitionTarget(View: GameState.AreaView; State: GameState.GameState): result of (string, string);
begin
  return TransitionTargetOfValid(View, try GameState.ValidateGameState(View, State));
end function;

// Returns whether a validated first-person pose stands on an exit or stairs field of Map.
public function OnTransitionField(Map: InteriorUnit.InteriorMap; Position: Coordinates.InteriorPosition): boolean;
begin
  if Coordinates.SamePosition(Position, Map.Arrival) then
    return true;
  end if;

  case InteriorUnit.StairsDownPosition(Map) of
    when Some(const Stairs):
      return Coordinates.SamePosition(Position, Stairs);
    when None:
      return false;
  end case;
end function;

// Returns Pose, or the first floor field free of standing opponents in breadth-first order
// north, east, south, west from it when an opponent occupies Pose, keeping the facing. Opponents
// on a level without the player never move, so an occupied arrival field must not block travel.
function FreeArrival(Map: InteriorUnit.InteriorMap; State: GameState.GameState; Pose: Coordinates.FirstPersonPose): result of (Coordinates.FirstPersonPose, string);
begin
  if GameState.StandingHostileAt(State, Map.AreaId, Pose.Position) < 0 then
    return Ok(Pose);
  end if;
  const Offsets: array of Coordinates.InteriorPosition := [
    Coordinates.InteriorPosition(X := 0, Y := -1),
    Coordinates.InteriorPosition(X := 1, Y := 0),
    Coordinates.InteriorPosition(X := 0, Y := 1),
    Coordinates.InteriorPosition(X := -1, Y := 0)
  ];
  var Visited: array of boolean := array.Fill(false, Map.Width * Map.Height);
  var Queue: array of Coordinates.InteriorPosition := [Pose.Position];
  Visited[(Pose.Position.Y * Map.Width) + Pose.Position.X] := true;
  var ReadIndex: integer := 0;
  while ReadIndex < Queue.Length() do
    const Current: Coordinates.InteriorPosition := Queue[ReadIndex];
    ReadIndex := ReadIndex + 1;
    if (try InteriorUnit.InteriorCellAt(Map, Current) = InteriorUnit.InteriorCellKind.Floor)
      and
      (GameState.StandingHostileAt(State, Map.AreaId, Current) < 0)
    then
      return Ok(Pose with Position := Current; end with);
    end if;

    for Offset: Coordinates.InteriorPosition in Offsets do
      const Next := Coordinates.InteriorPosition(
        X := Current.X + Offset.X,
        Y := Current.Y + Offset.Y
      );
      if (Next.X >= 0) and (Next.X < Map.Width) and (Next.Y >= 0) and (Next.Y < Map.Height) then
        const Index: integer := (Next.Y * Map.Width) + Next.X;
        if not Visited[Index] and (Map.Cells[Index] <> InteriorUnit.InteriorCellKind.Wall) then
          Visited[Index] := true;
          Queue.PushInPlace(Next);
        end if;
      end if;
    end for;
  end while;

  return Error('no free arrival field on the target level');
end function;

// Applies an eligible transition using validated target geometry supplied by its owner.
// Entry and stair travel require the target map and materialize its placements once; leaving
// requires None. Stairs keep the outdoor return location, arrive at the start pose going down
// and at the descent landing going up, and require the same stored depth and name. A standing
// opponent on the arrival field moves the arrival to the nearest free floor field.
public function ActivateAreaTransition(View: GameState.AreaView; State: GameState.GameState; TargetMap: option of InteriorUnit.InteriorMap): result of (AreaTransition, string);
begin
  const Target: string := try AreaTransitionTarget(View, State);
  var Changed: GameState.GameState := State;
  if State.Area = Coordinates.AreaKind.OutdoorRegion then
    begin
      case TargetMap of
        when Some(const Map):
          begin
            const ValidMap: InteriorUnit.InteriorMap := try InteriorUnit.ValidateInteriorMap(Map);
            if ValidMap.AreaId <> Target then
              begin
                return Error('target map identity does not match the transition target');
              end;
            end if;

            const Materialized := Areas.MaterializeArea(State, ValidMap);
            const EntryPose := try FreeArrival(
              ValidMap,
              Materialized,
              Coordinates.FirstPersonPose(
                Position := ValidMap.Start,
                Facing := ValidMap.StartFacing
              )
            );
            Changed := Materialized with Area := Coordinates.AreaKind.Dungeon; AreaId := Target; Player := Coordinates.PlayerPosition.FirstPerson(
              EntryPose
            ); ReturnLocation := Coordinates.ReturnLocation.ReturnTo(
              View.Metadata.OutdoorAreaId,
              try GameState.OutdoorPlayerPosition(State)
            ); end with;
          end;
        when None:
          begin
            return Error('entering a dungeon requires its target map');
          end;
      end case;
    end;
  else
    if Target <> View.Metadata.OutdoorAreaId then
      const CurrentMap: InteriorUnit.InteriorMap := try GameState.CurrentInterior(View, State);
      case TargetMap of
        when Some(const Map):
          const ValidMap: InteriorUnit.InteriorMap := try InteriorUnit.ValidateInteriorMap(Map);
          if ValidMap.AreaId <> Target then
            return Error('target map identity does not match the transition target');
          end if;

          if (ValidMap.Depth <> CurrentMap.Depth)
            or
            (ValidMap.DisplayName <> CurrentMap.DisplayName)
          then
            return Error('target level depth and name must match the current dungeon');
          end if;
          var Pose: Coordinates.FirstPersonPose := Coordinates.FirstPersonPose(
            Position := ValidMap.Start, Facing := ValidMap.StartFacing
          );
          if ValidMap.Level < CurrentMap.Level then
            case InteriorUnit.DescentLanding(ValidMap) of
              when Some(const Landing):
                Pose := Landing;
              when None:
                return Error('target level above has no stairs down');
            end case;
          end if;

          const Materialized := Areas.MaterializeArea(State, ValidMap);
          Changed := Materialized with AreaId := Target; Player := Coordinates.PlayerPosition.FirstPerson(
            try FreeArrival(ValidMap, Materialized, Pose)
          ); end with;
        when None:
          return Error('taking stairs requires the target level map');
      end case;
      const StairsView: GameState.AreaView := GameState.AreaView(
        Metadata := View.Metadata,
        Interior := TargetMap
      );
      return Ok(
        AreaTransition(
          State := try GameState.ValidateGameState(StairsView, Changed), View := StairsView
        )
      );
    end if;

    begin
      case TargetMap of
        when Some(const Map):
          begin
            return Error('leaving a dungeon must not supply an interior target map');
          end;
        when None:
          begin
            null;
          end;
      end case;

      case State.ReturnLocation of
        when Coordinates.ReturnLocation.ReturnTo(const AreaId, const Position):
          Changed := State with Area := Coordinates.AreaKind.OutdoorRegion; AreaId := AreaId; Player := Coordinates.PlayerPosition.Outdoor(
            Position
          ); ReturnLocation := Coordinates.ReturnLocation.NoReturnLocation; end with;
        when Coordinates.ReturnLocation.NoReturnLocation:
          return Error('cannot leave an entered area without a return location');
      end case;
    end;
  end if;
  const NextView: GameState.AreaView := GameState.AreaView(
    Metadata := View.Metadata,
    Interior := TargetMap
  );
  return Ok(
    AreaTransition(State := try GameState.ValidateGameState(NextView, Changed), View := NextView)
  );
end function;

// Applies one cardinal outdoor step, healing one point only after an accepted move.
public function MovePlayer(State: GameState.GameState; DeltaX: integer; DeltaY: integer; Target: Terrain.WorldCell): result of (GameState.GameState, string);
begin
  if State.Area <> Coordinates.AreaKind.OutdoorRegion then
    begin
      return Error('movement is unavailable in the current area');
    end;
  end if;

  if not (
    ((DeltaX = 0) and ((DeltaY = -1) or (DeltaY = 1)))
    or
    ((DeltaY = 0) and ((DeltaX = -1) or (DeltaX = 1)))
  )
  then
    begin
      return Error('movement must be one cardinal step');
    end;
  end if;

  if not Terrain.IsWalkable(Target) then
    begin
      return Error('terrain is not traversable');
    end;
  end if;
  const Position: Coordinates.WorldPosition := try GameState.OutdoorPlayerPosition(State);
  return Ok(
    State with Player := Coordinates.PlayerPosition.Outdoor(
      Coordinates.WorldPosition(
        X := Position.X + DeltaX, Y := Position.Y +
        DeltaY
      )
    ); Health := Math.Min(
      State.Health +
      1, GameState.PlayerMaximumHealth
    ); end with
  );
end function;

// Applies one relative first-person step against caller-supplied authoritative geometry.
public function StepFirstPerson(View: GameState.AreaView; State: GameState.GameState; Step: Coordinates.RelativeStep): result of (GameState.GameState, string);
begin
  const Valid: GameState.GameState := try GameState.ValidateGameState(View, State);
  if Valid.Area <> Coordinates.AreaKind.Dungeon then
    begin
      return Error('first-person movement is unavailable in the current area');
    end;
  end if;
  const Pose: Coordinates.FirstPersonPose := try GameState.FirstPersonPlayerPose(Valid);
  const Offset: Coordinates.InteriorPosition := Coordinates.StepOffset(Pose.Facing, Step);
  const Target: Coordinates.InteriorPosition := Coordinates.InteriorPosition(
    X := Pose.Position.X + Offset.X, Y := Pose.Position.Y +
    Offset.Y
  );
  const Map: InteriorUnit.InteriorMap := try GameState.CurrentInterior(View, State);
  const BlockingHostile: integer := GameState.StandingHostileAt(Valid, Valid.AreaId, Target);
  if BlockingHostile >= 0 then
    begin
      return Error(
        'The ' + HostileRules.HostileDisplayName(Valid.Hostiles[BlockingHostile].Kind) +
        ' blocks the way'
      );
    end;
  end if;

  if try InteriorUnit.InteriorCellAt(Map, Target) = InteriorUnit.InteriorCellKind.Wall then
    begin
      return Error('a wall blocks the way');
    end;
  end if;

  return Ok(
    Valid with Player := Coordinates.PlayerPosition.FirstPerson(
      Pose with Position := Target; end with
    ); end with
  );
end function;

// Applies one relative 90-degree turn without changing the occupied interior field.
public function TurnFirstPerson(View: GameState.AreaView; State: GameState.GameState; Turn: Coordinates.RelativeTurn): result of (GameState.GameState, string);
begin
  const Valid: GameState.GameState := try GameState.ValidateGameState(View, State);
  if Valid.Area <> Coordinates.AreaKind.Dungeon then
    begin
      return Error('first-person turning is unavailable in the current area');
    end;
  end if;
  const Pose: Coordinates.FirstPersonPose := try GameState.FirstPersonPlayerPose(Valid);
  return Ok(
    Valid with Player := Coordinates.PlayerPosition.FirstPerson(
      Pose with Facing := Coordinates.TurnedFacing(Pose.Facing, Turn); end with
    ); end with
  );
end function;
end unit;
