// Player movement: outdoor steps, first-person steps and turns, and area transitions.
unit Dungeon.Movement;

uses
  Dungeon.Areas, Dungeon.Areas.Identities, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interior,
  Dungeon.Terrain, Dungeon.Terrain.Entrances, Std.Math;

public type
  // Atomic pure transition result: replacement player state and its matching current view.
  AreaTransition = record
    public State: GameState;
    public View: AreaView;
  end;

// Validates entrance or exit eligibility and returns the server-owned target identity.
// Does not load geometry or change player state.
public function AreaTransitionTarget(View: AreaView; State: GameState): result of string, string;
begin
  var Valid: GameState := try ValidateGameState(View, State);
  var Metadata: WorldMetadata := View.Metadata;
  if Valid.Area = AreaKind.OutdoorRegion then
  begin
    var Position: WorldPosition := try OutdoorPlayerPosition(Valid);
    case EntranceRegionAt(Metadata, Position) of
      Some(Region):
      begin
        return Ok(DungeonAreaId(Metadata, Region))
      end;
      None:
      begin
        return Error('player is not standing on an entrance')
      end
    end
  end;
  var Map: InteriorMap := try CurrentInterior(View, Valid);
  var Pose: FirstPersonPose := try FirstPersonPlayerPose(Valid);
  if not SamePosition(Pose.Position, Map.Exit) then
  begin
    return Error('player is not standing on the interior exit')
  end;

  return Ok(Metadata.OutdoorAreaId)
end;

// Applies an eligible transition using validated target geometry supplied by its owner.
// Entry materializes validated target placements once; exit requires None and retains them.
public function ActivateAreaTransition(View: AreaView; State: GameState; TargetMap: option of InteriorMap): result of AreaTransition, string;
begin
  var Target: string := try AreaTransitionTarget(View, State);
  mutable var Changed: GameState := State;
  if State.Area = AreaKind.OutdoorRegion then
  begin
    case TargetMap of
      Some(Map):
      begin
        var ValidMap: InteriorMap := try ValidateInteriorMap(Map);
        if ValidMap.AreaId <> Target then
        begin
          return Error('target map identity does not match the transition target')
        end;

        Changed := MaterializeArea(State, ValidMap) with Area := AreaKind.Dungeon; AreaId := Target; Player := PlayerPosition.FirstPerson(record
          Position := Map.Start;
          Facing := Map.StartFacing;
        end); ReturnLocation := ReturnLocation.ReturnTo(View.Metadata.OutdoorAreaId, try OutdoorPlayerPosition(State)); end
      end;
      None:
      begin
        return Error('entering a dungeon requires its target map')
      end
    end
  end
  else
  begin
    case TargetMap of
      Some(Map):
      begin
        return Error('leaving a dungeon must not supply an interior target map')
      end;
      None:
      begin
      end
    end;

    case State.ReturnLocation of
      ReturnLocation.ReturnTo(AreaId, Position):
      begin
        Changed := State with Area := AreaKind.OutdoorRegion; AreaId := AreaId; Player := PlayerPosition.Outdoor(Position); ReturnLocation := ReturnLocation.NoReturnLocation; end
      end
      else
      begin
        return Error('cannot leave an entered area without a return location')
      end
    end
  end;
  var NextView: AreaView := record
    Metadata := View.Metadata;
    Interior := TargetMap;
  end;

  return Ok(record
    State := try ValidateGameState(NextView, Changed);
    View := NextView;
  end)
end;

// Applies one cardinal outdoor step, healing one point only after an accepted move.
public function MovePlayer(State: GameState; DeltaX: integer; DeltaY: integer; Target: WorldCell): result of GameState, string;
begin
  if State.Area <> AreaKind.OutdoorRegion then
  begin
    return Error('movement is unavailable in the current area')
  end;

  if not (((DeltaX = 0) and ((DeltaY = -1) or (DeltaY = 1))) or ((DeltaY = 0) and ((DeltaX = -1) or (DeltaX = 1)))) then
  begin
    return Error('movement must be one cardinal step')
  end;

  if not IsWalkable(Target) then
  begin
    return Error('terrain is not traversable')
  end;
  var Position: WorldPosition := try OutdoorPlayerPosition(State);
  return Ok(State with Player := PlayerPosition.Outdoor(record
    X := Position.X + DeltaX;
    Y := Position.Y + DeltaY;
  end); Health := Std.Math.Min(State.Health + 1, PlayerMaximumHealth); end)
end;

// Applies one relative first-person step against caller-supplied authoritative geometry.
public function StepFirstPerson(View: AreaView; State: GameState; Step: RelativeStep): result of GameState, string;
begin
  var Valid: GameState := try ValidateGameState(View, State);
  if Valid.Area <> AreaKind.Dungeon then
  begin
    return Error('first-person movement is unavailable in the current area')
  end;
  var Pose: FirstPersonPose := try FirstPersonPlayerPose(Valid);
  var Offset: InteriorPosition := StepOffset(Pose.Facing, Step);
  var Target: InteriorPosition := record
    X := Pose.Position.X + Offset.X;
    Y := Pose.Position.Y + Offset.Y;
  end;
  var Map: InteriorMap := try CurrentInterior(View, State);
  if StandingHostileAt(Valid, Valid.AreaId, Target) >= 0 then
  begin
    return Error('the restless skeleton blocks the way')
  end;

  if try InteriorCellAt(Map, Target) = InteriorCellKind.Wall then
  begin
    return Error('a wall blocks the way')
  end;

  return Ok(Valid with Player := PlayerPosition.FirstPerson(Pose with Position := Target; end); end)
end;

// Applies one relative 90-degree turn without changing the occupied interior field.
public function TurnFirstPerson(View: AreaView; State: GameState; Turn: RelativeTurn): result of GameState, string;
begin
  var Valid: GameState := try ValidateGameState(View, State);
  if Valid.Area <> AreaKind.Dungeon then
  begin
    return Error('first-person turning is unavailable in the current area')
  end;
  var Pose: FirstPersonPose := try FirstPersonPlayerPose(Valid);
  return Ok(Valid with Player := PlayerPosition.FirstPerson(Pose with Facing := TurnedFacing(Pose.Facing, Turn); end); end)
end;
