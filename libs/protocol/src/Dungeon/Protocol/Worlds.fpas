// Strict bounded catalog codec and shared client-safe world selection predicates.
unit Dungeon.Protocol.Worlds;

uses Dungeon.Protocol as Protocol, Std.Conv as Conv, Std.Json as Json, Std.Json.Fields as JsonFields, Std.Net.Utf8 as Utf8, Std.Parse as Parse;

// Renders typed library failures at this unit's application-owned text boundary.
function FailureMessage<E: Error>(Cause: E): string;
begin
  return Cause.Message();
end function;

// Parses integer input without panicking on invalid or overflowing text.
public function ParseWorldInteger(Text: string): result of (integer, string);
begin
  return Parse.Int(Text).MapError(FailureMessage);
end function;

// Rejects traversal and malformed identities before they can reach storage.
public function ValidateWorldIdentity(Id: string): result of (string, string);
begin
  if (Id.Length() < 1) or (Id.Length() > 64) then
    begin
      return Error('world id length must be 1 through 64');
    end;
  end if;

  for Index: integer := 0 to Id.Length() - 1 do
    begin
      if not Id[Index] in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_' then
        begin
          return Error('invalid world id character');
        end;
      end if;
    end;
  end for;

  return Ok(Id);
end function;

// Valid empty menu before the server supplies its catalog; no selected world is assumed.
public function EmptyWorldCatalog(Seed: integer; RegionChunks: integer): Protocol.WorldCatalog;
begin
  return Protocol.WorldCatalog(
    Worlds := [],
    SelectedId := '',
    SelectionReason := '',
    Offset := 0,
    Total := 0,
    DefaultSeed := Seed,
    MinimumSeed := -2147483648,
    MaximumSeed := 2147483647,
    DefaultRegionChunks := RegionChunks,
    MinimumRegionChunks := 1,
    MaximumRegionChunks := 16
  );
end function;

// Finds the selected entry on this page; a missing selection has no world actions.
public function SelectedWorld(Catalog: Protocol.WorldCatalog): option of Protocol.WorldSummary;
begin
  for World: Protocol.WorldSummary in Catalog.Worlds do
    begin
      if World.Id = Catalog.SelectedId then
        begin
          return Some(World);
        end;
      end if;
    end;
  end for;

  return None;
end function;

// Continue starts at spawn only when the selected compatible world has no save.
public function CanContinueWorld(Catalog: Protocol.WorldCatalog): boolean;
begin
  case SelectedWorld(Catalog) of
    when Some(const World):
      begin
        return (World.Status = 'ready')
          and
          ((World.SaveStatus = 'missing') or (World.SaveStatus = 'available'));
      end;
    when None:
      begin
        return false;
      end;
  end case;
end function;

// Any existing or unreadable save requires confirmation before explicit replacement.
public function CatalogHasSave(Catalog: Protocol.WorldCatalog): boolean;
begin
  case SelectedWorld(Catalog) of
    when Some(const World):
      begin
        return (World.Status = 'ready') and (World.SaveStatus <> 'missing');
      end;
    when None:
      begin
        return false;
      end;
  end case;
end function;

// Encodes seeds as decimal text to retain every bit of existing 64-bit world seeds.
public function EncodeWorldCatalog(Catalog: Protocol.WorldCatalog): Json.JsonValue;
begin
  var Entries: array of Json.JsonValue := [];
  for World: Protocol.WorldSummary in Catalog.Worlds do
    begin
      Entries.PushInPlace(
        Json.JsonValue.Object([
          'id': Json.JsonValue.String(World.Id),
          'seed': Json.JsonValue.String(Conv.IntToStr(World.Seed)),
          'region_chunks': Json.JsonValue.Number(Conv.IntToReal(World.RegionChunks)),
          'status': Json.JsonValue.String(World.Status),
          'save_status': Json.JsonValue.String(World.SaveStatus),
          'reason': Json.JsonValue.String(World.Reason)
        ])
      );
    end;
  end for;

  return Json.JsonValue.Object([
    'worlds': Json.JsonValue.ArrayValue(Entries),
    'selected_id': Json.JsonValue.String(Catalog.SelectedId),
    'selection_reason': Json.JsonValue.String(Catalog.SelectionReason),
    'offset': Json.JsonValue.Number(Conv.IntToReal(Catalog.Offset)),
    'total': Json.JsonValue.Number(Conv.IntToReal(Catalog.Total)),
    'default_seed': Json.JsonValue.Number(Conv.IntToReal(Catalog.DefaultSeed)),
    'minimum_seed': Json.JsonValue.Number(Conv.IntToReal(Catalog.MinimumSeed)),
    'maximum_seed': Json.JsonValue.Number(Conv.IntToReal(Catalog.MaximumSeed)),
    'default_region_chunks': Json.JsonValue.Number(Conv.IntToReal(Catalog.DefaultRegionChunks)),
    'minimum_region_chunks': Json.JsonValue.Number(Conv.IntToReal(Catalog.MinimumRegionChunks)),
    'maximum_region_chunks': Json.JsonValue.Number(Conv.IntToReal(Catalog.MaximumRegionChunks))
  ]);
end function;

// Bounds page arithmetic, text, unique identities, and classified statuses.
public function ValidateWorldCatalog(Catalog: Protocol.WorldCatalog): result of (Protocol.WorldCatalog, string);
begin
  const Count: integer := Catalog.Worlds.Length();
  if (Count > Protocol.MaximumWorldsPerPage) or (Catalog.Offset < 0)
    or
    (Catalog.Total < Catalog.Offset) or (Count > Catalog.Total - Catalog.Offset)
    or
    ((Count = 0) and (Catalog.Offset <> Catalog.Total))
  then
    begin
      return Error('invalid world catalog page');
    end;
  end if;

  if Catalog.SelectedId <> '' then
    const Valid: string := try ValidateWorldIdentity(Catalog.SelectedId);
  end if;

  if (Catalog.MinimumSeed <> -2147483648) or (Catalog.MaximumSeed <> 2147483647)
    or
    (Catalog.DefaultSeed < Catalog.MinimumSeed) or (Catalog.DefaultSeed > Catalog.MaximumSeed)
    or
    (Catalog.MinimumRegionChunks <> 1) or (Catalog.MaximumRegionChunks <> 16)
    or
    (Catalog.DefaultRegionChunks < 1) or (Catalog.DefaultRegionChunks > 16)
    or
    (Catalog.SelectionReason.Length() > Protocol.MaximumWorldReasonLength)
  then
    begin
      return Error('invalid world parameter policy');
    end;
  end if;
  var Ids: array of string := [];
  for World: Protocol.WorldSummary in Catalog.Worlds do
    begin
      const Valid: string := try ValidateWorldIdentity(World.Id);
      if World.Id in Ids or (World.Reason.Length() > Protocol.MaximumWorldReasonLength)
        or
        not World.Status in [
          'ready',
          'incompatible',
          'storage_error'
        ]
        or
        not World.SaveStatus in
        [
          'missing',
          'available',
          'incompatible',
          'storage_error',
          'world_data_error',
          'unknown'
        ]
      then
        begin
          return Error('invalid world catalog entry');
        end;
      end if;

      if (World.Status = 'ready')
        and
        ((World.RegionChunks < 1) or (World.RegionChunks > 16) or (World.SaveStatus = 'unknown'))
      then
        begin
          return Error('invalid compatible world parameters');
        end;
      end if;

      if (World.Status <> 'ready') and (World.SaveStatus <> 'unknown') then
        begin
          return Error('incompatible world cannot advertise a save');
        end;
      end if;

      Ids.PushInPlace(World.Id);
    end;
  end for;

  if Utf8.Encode(Json.Stringify(EncodeWorldCatalog(Catalog))).Length() >
    Protocol.MaximumLineBytes - 64
  then
    return Error('world catalog exceeds the transport frame budget');
  end if;

  return Ok(Catalog);
end function;

// Decodes exact nested fields and validates the whole catalog before installation.
public function WorldCatalogField(Fields: dict of string to Json.JsonValue): result of (Protocol.WorldCatalog, string);
begin
  case try JsonFields.Field(Fields, 'catalog').MapError(FailureMessage) of
    when Json.JsonValue.Object(const Values):
      if Values.Length() <> 11 then
        begin
          return Error('catalog has unexpected fields');
        end;
      end if;
      var Catalog: Protocol.WorldCatalog := Protocol.WorldCatalog(
        Worlds := [],
        SelectedId := try JsonFields.StringField(Values, 'selected_id').MapError(FailureMessage),
        SelectionReason := try JsonFields.StringField(
          Values,
          'selection_reason'
        ).MapError(FailureMessage),
        Offset := try JsonFields.IntegerField(Values, 'offset').MapError(FailureMessage),
        Total := try JsonFields.IntegerField(Values, 'total').MapError(FailureMessage),
        DefaultSeed := try JsonFields.IntegerField(Values, 'default_seed').MapError(FailureMessage),
        MinimumSeed := try JsonFields.IntegerField(Values, 'minimum_seed').MapError(FailureMessage),
        MaximumSeed := try JsonFields.IntegerField(Values, 'maximum_seed').MapError(FailureMessage),
        DefaultRegionChunks := try JsonFields.IntegerField(
          Values,
          'default_region_chunks'
        ).MapError(FailureMessage),
        MinimumRegionChunks := try JsonFields.IntegerField(
          Values,
          'minimum_region_chunks'
        ).MapError(FailureMessage),
        MaximumRegionChunks := try JsonFields.IntegerField(
          Values,
          'maximum_region_chunks'
        ).MapError(FailureMessage)
      );
      var Worlds: array of Protocol.WorldSummary := [];
      case try JsonFields.Field(Values, 'worlds').MapError(FailureMessage) of
        when Json.JsonValue.ArrayValue(const Entries):
          if Entries.Length() > Protocol.MaximumWorldsPerPage then
            begin
              return Error('too many catalog entries');
            end;
          end if;

          for Entry: Json.JsonValue in Entries do
            begin
              case Entry of
                when Json.JsonValue.Object(const Item):
                  if Item.Length() <> 6 then
                    begin
                      return Error('world entry has unexpected fields');
                    end;
                  end if;
                  const SeedText: string := try JsonFields.StringField(
                    Item,
                    'seed'
                  ).MapError(FailureMessage);
                  const Seed: integer := try ParseWorldInteger(SeedText);
                  if Conv.IntToStr(Seed) <> SeedText then
                    return Error('world seed must be canonical decimal text');
                  end if;

                  Worlds.PushInPlace(
                    Protocol.WorldSummary(
                      Id := try JsonFields.StringField(Item, 'id').MapError(FailureMessage),
                      Seed := Seed,
                      RegionChunks := try JsonFields.IntegerField(
                        Item,
                        'region_chunks'
                      ).MapError(FailureMessage),
                      Status := try JsonFields.StringField(Item, 'status').MapError(FailureMessage),
                      SaveStatus := try JsonFields.StringField(
                        Item,
                        'save_status'
                      ).MapError(FailureMessage),
                      Reason := try JsonFields.StringField(Item, 'reason').MapError(FailureMessage)
                    )
                  );
                when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
                  return Error('world entry must be an object');
              end case;
            end;
          end for;
        when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.Object(_):
          return Error('worlds must be an array');
      end case;

      Catalog.Worlds := Worlds;
      return ValidateWorldCatalog(Catalog);
    when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
      return Error('catalog must be an object');
  end case;
end function;
end unit;
