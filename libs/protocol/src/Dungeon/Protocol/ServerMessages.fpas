// Encoding and strict decoding of server-to-client messages.
unit Dungeon.Protocol.ServerMessages;

uses Dungeon.Protocol as Protocol, Dungeon.Protocol.Worlds as Worlds, Dungeon.Protocol.Fields as ProtocolFields, Dungeon.Protocol.Names as Names, Dungeon.Protocol.Validation as Validation, Std.Conv as Conv, Std.Json as Json, Std.Json.Fields as JsonFields;

// Encodes one server message as a compact JSON object for line transport.
public function EncodeServer(Message: Protocol.ServerMessage): string;
begin
  case Message of
    when Protocol.ServerMessage.Welcome(const Version, const Catalog):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('welcome'),
            'version': Json.JsonValue.Number(Conv.IntToReal(Version)),
            'catalog': Worlds.EncodeWorldCatalog(Catalog)
          ])
        );
      end;
    when Protocol.ServerMessage.Worlds(const Catalog):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('worlds'),
            'catalog': Worlds.EncodeWorldCatalog(Catalog)
          ])
        );
      end;
    when Protocol.ServerMessage.State(const Value):
      begin
        case Value of
          when Protocol.VisibleState.MapState(const MapValue):
            begin
              return Json.Stringify(
                Json.JsonValue.Object([
                  'type': Json.JsonValue.String('state'),
                  'view': Json.JsonValue.String(Names.ViewName(Protocol.ViewKind.Map)),
                  'origin_x': Json.JsonValue.Number(Conv.IntToReal(MapValue.OriginX)),
                  'origin_y': Json.JsonValue.Number(Conv.IntToReal(MapValue.OriginY)),
                  'width': Json.JsonValue.Number(Conv.IntToReal(MapValue.Width)),
                  'height': Json.JsonValue.Number(Conv.IntToReal(MapValue.Height)),
                  'rows': Json.JsonValue.ArrayValue(ProtocolFields.EncodeRows(MapValue.Rows)),
                  'knowledge_rows': Json.JsonValue.ArrayValue(
                    ProtocolFields.EncodeRows(MapValue.KnowledgeRows)
                  ),
                  'x': Json.JsonValue.Number(Conv.IntToReal(MapValue.PlayerX)),
                  'y': Json.JsonValue.Number(Conv.IntToReal(MapValue.PlayerY)),
                  'world_x': Json.JsonValue.Number(Conv.IntToReal(MapValue.WorldX)),
                  'world_y': Json.JsonValue.Number(Conv.IntToReal(MapValue.WorldY)),
                  'inventory': Json.JsonValue.ArrayValue(
                    ProtocolFields.EncodeInventory(MapValue.Inventory)
                  ),
                  'health': Json.JsonValue.Number(Conv.IntToReal(MapValue.Health)),
                  'max_health': Json.JsonValue.Number(Conv.IntToReal(MapValue.MaxHealth)),
                  'character': Json.JsonValue.ArrayValue(
                    ProtocolFields.EncodeCharacter(MapValue.Character)
                  )
                ])
              );
            end;
          when Protocol.VisibleState.FirstPersonState(const FirstPersonValue):
            begin
              return Json.Stringify(
                Json.JsonValue.Object([
                  'type': Json.JsonValue.String('state'),
                  'view': Json.JsonValue.String(Names.ViewName(Protocol.ViewKind.FirstPerson)),
                  'title': Json.JsonValue.String(FirstPersonValue.Title),
                  'status': Json.JsonValue.String(FirstPersonValue.Status),
                  'width': Json.JsonValue.Number(Conv.IntToReal(FirstPersonValue.Width)),
                  'height': Json.JsonValue.Number(Conv.IntToReal(FirstPersonValue.Height)),
                  'rows': Json.JsonValue.ArrayValue(
                    ProtocolFields.EncodeRows(FirstPersonValue.Rows)
                  ),
                  'knowledge_rows': Json.JsonValue.ArrayValue(
                    ProtocolFields.EncodeRows(FirstPersonValue.KnowledgeRows)
                  ),
                  'x': Json.JsonValue.Number(Conv.IntToReal(FirstPersonValue.PlayerX)),
                  'y': Json.JsonValue.Number(Conv.IntToReal(FirstPersonValue.PlayerY)),
                  'facing': Json.JsonValue.String(
                    Names.FirstPersonFacingName(FirstPersonValue.Facing)
                  ),
                  'inventory': Json.JsonValue.ArrayValue(
                    ProtocolFields.EncodeInventory(FirstPersonValue.Inventory)
                  ),
                  'health': Json.JsonValue.Number(Conv.IntToReal(FirstPersonValue.Health)),
                  'max_health': Json.JsonValue.Number(Conv.IntToReal(FirstPersonValue.MaxHealth)),
                  'character': Json.JsonValue.ArrayValue(
                    ProtocolFields.EncodeCharacter(FirstPersonValue.Character)
                  ),
                  'combat_log': Json.JsonValue.ArrayValue(
                    ProtocolFields.EncodeRows(FirstPersonValue.CombatLog)
                  ),
                  'combat_events': Json.JsonValue.ArrayValue(
                    ProtocolFields.EncodeCombatEvents(FirstPersonValue.CombatEvents)
                  )
                ])
              );
            end;
        end case;
      end;
    when Protocol.ServerMessage.ExplorationMap(const Value):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('exploration_map'),
            'view': Json.JsonValue.String(Names.ViewName(Value.View)),
            'label': Json.JsonValue.String(Value.LabelText),
            'origin_x': Json.JsonValue.Number(Conv.IntToReal(Value.OriginX)),
            'origin_y': Json.JsonValue.Number(Conv.IntToReal(Value.OriginY)),
            'width': Json.JsonValue.Number(Conv.IntToReal(Value.Width)),
            'height': Json.JsonValue.Number(Conv.IntToReal(Value.Height)),
            'rows': Json.JsonValue.ArrayValue(ProtocolFields.EncodeRows(Value.Rows)),
            'knowledge_rows': Json.JsonValue.ArrayValue(
              ProtocolFields.EncodeRows(Value.KnowledgeRows)
            ),
            'player_world_x': Json.JsonValue.Number(Conv.IntToReal(Value.PlayerWorldX)),
            'player_world_y': Json.JsonValue.Number(Conv.IntToReal(Value.PlayerWorldY)),
            'player_in_window': Json.JsonValue.Bool(Value.PlayerInWindow)
          ])
        );
      end;
    when Protocol.ServerMessage.Interaction(const Title, const MessageText):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('interaction'),
            'title': Json.JsonValue.String(Title),
            'message': Json.JsonValue.String(MessageText)
          ])
        );
      end;
    when Protocol.ServerMessage.SaveCompleted:
      begin
        return Json.Stringify(
          Json.JsonValue.Object(['type': Json.JsonValue.String('save_completed')])
        );
      end;
    when Protocol.ServerMessage.Defeated(const MessageText):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('defeated'),
            'message': Json.JsonValue.String(MessageText)
          ])
        );
      end;
    when Protocol.ServerMessage.Rejected(const Code, const MessageText):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('rejected'),
            'code': Json.JsonValue.String(Code),
            'message': Json.JsonValue.String(MessageText)
          ])
        );
      end;
    when Protocol.ServerMessage.ErrorMessage(const Code, const MessageText):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('error'),
            'code': Json.JsonValue.String(Code),
            'message': Json.JsonValue.String(MessageText)
          ])
        );
      end;
  end case;
end function;

// Decodes one server message and validates visible-state dimensions and coordinates.
public function DecodeServer(Text: string): result of (Protocol.ServerMessage, string);
begin
  const Fields: dict of string to Json.JsonValue := try JsonFields.ParseObject(Text);
  case try JsonFields.StringField(Fields, 'type') of
    when 'welcome':
      begin
        if Fields.Length() <> 3 then
          begin
            return Error('welcome has unexpected fields');
          end;
        end if;

        return Ok(
          Protocol.ServerMessage.Welcome(
            try JsonFields.IntegerField(Fields, 'version'),
            try Worlds.WorldCatalogField(Fields)
          )
        );
      end;
    when 'worlds':
      begin
        if Fields.Length() <> 2 then
          begin
            return Error('worlds has unexpected fields');
          end;
        end if;

        return Ok(Protocol.ServerMessage.Worlds(try Worlds.WorldCatalogField(Fields)));
      end;
    when 'save_completed':
      begin
        if Fields.Length() <> 1 then
          begin
            return Error('save_completed must not contain additional fields');
          end;
        end if;

        return Ok(Protocol.ServerMessage.SaveCompleted);
      end;
    when 'state':
      begin
        case try Names.DecodeView(try JsonFields.StringField(Fields, 'view')) of
          when Protocol.ViewKind.Map:
            begin
              if Fields.Length() <> 16 then
                begin
                  return Error('map state has an unexpected field set');
                end;
              end if;
              const MapValue: Protocol.MapVisibleState := Protocol.MapVisibleState(
                OriginX := try JsonFields.IntegerField(Fields, 'origin_x'),
                OriginY := try JsonFields.IntegerField(Fields, 'origin_y'),
                Width := try JsonFields.IntegerField(Fields, 'width'),
                Height := try JsonFields.IntegerField(Fields, 'height'),
                Rows := try JsonFields.StringArrayField(Fields, 'rows'),
                KnowledgeRows := try JsonFields.StringArrayField(Fields, 'knowledge_rows'),
                PlayerX := try JsonFields.IntegerField(Fields, 'x'),
                PlayerY := try JsonFields.IntegerField(Fields, 'y'),
                WorldX := try JsonFields.IntegerField(Fields, 'world_x'),
                WorldY := try JsonFields.IntegerField(Fields, 'world_y'),
                Inventory := try ProtocolFields.InventoryField(Fields, 'inventory'),
                Health := try JsonFields.IntegerField(Fields, 'health'),
                MaxHealth := try JsonFields.IntegerField(Fields, 'max_health'),
                Character := try ProtocolFields.CharacterField(Fields)
              );
              return Ok(
                Protocol.ServerMessage.State(
                  Protocol.VisibleState.MapState(try Validation.ValidateMapVisibleState(MapValue))
                )
              );
            end;
          when Protocol.ViewKind.FirstPerson:
            begin
              if Fields.Length() <> 17 then
                begin
                  return Error('first-person state has an unexpected field set');
                end;
              end if;
              const FirstPersonValue: Protocol.FirstPersonVisibleState := Protocol.FirstPersonVisibleState(
                Title := try JsonFields.StringField(Fields, 'title'),
                Status := try JsonFields.StringField(Fields, 'status'),
                Width := try JsonFields.IntegerField(Fields, 'width'),
                Height := try JsonFields.IntegerField(Fields, 'height'),
                Rows := try JsonFields.StringArrayField(Fields, 'rows'),
                KnowledgeRows := try JsonFields.StringArrayField(Fields, 'knowledge_rows'),
                PlayerX := try JsonFields.IntegerField(Fields, 'x'),
                PlayerY := try JsonFields.IntegerField(Fields, 'y'),
                Facing := try Names.DecodeFirstPersonFacing(
                  try JsonFields.StringField(Fields, 'facing')
                ),
                Inventory := try ProtocolFields.InventoryField(Fields, 'inventory'),
                Health := try JsonFields.IntegerField(Fields, 'health'),
                MaxHealth := try JsonFields.IntegerField(Fields, 'max_health'),
                Character := try ProtocolFields.CharacterField(Fields),
                CombatLog := try JsonFields.StringArrayField(Fields, 'combat_log'),
                CombatEvents := try ProtocolFields.CombatEventsField(Fields)
              );
              return Ok(
                Protocol.ServerMessage.State(
                  Protocol.VisibleState.FirstPersonState(
                    try Validation.ValidateFirstPersonVisibleState(FirstPersonValue)
                  )
                )
              );
            end;
        end case;
      end;
    when 'exploration_map':
      begin
        if Fields.Length() <> 12 then
          begin
            return Error('exploration map has an unexpected field set');
          end;
        end if;
        const Value: Protocol.ExplorationMapState := Protocol.ExplorationMapState(
          View := try Names.DecodeView(try JsonFields.StringField(Fields, 'view')),
          LabelText := try JsonFields.StringField(Fields, 'label'),
          OriginX := try JsonFields.IntegerField(Fields, 'origin_x'),
          OriginY := try JsonFields.IntegerField(Fields, 'origin_y'),
          Width := try JsonFields.IntegerField(Fields, 'width'),
          Height := try JsonFields.IntegerField(Fields, 'height'),
          Rows := try JsonFields.StringArrayField(Fields, 'rows'),
          KnowledgeRows := try JsonFields.StringArrayField(Fields, 'knowledge_rows'),
          PlayerWorldX := try JsonFields.IntegerField(Fields, 'player_world_x'),
          PlayerWorldY := try JsonFields.IntegerField(Fields, 'player_world_y'),
          PlayerInWindow := try JsonFields.BooleanField(Fields, 'player_in_window')
        );
        return Ok(
          Protocol.ServerMessage.ExplorationMap(try Validation.ValidateExplorationMapState(Value))
        );
      end;
    when 'interaction':
      begin
        if Fields.Length() <> 3 then
          begin
            return Error('interaction must contain only type, title, and message');
          end;
        end if;
        const MessageText: string := try JsonFields.StringField(Fields, 'message');
        if MessageText.Length() = 0 then
          begin
            return Error('interaction message must not be empty');
          end;
        end if;

        return Ok(
          Protocol.ServerMessage.Interaction(
            try JsonFields.StringField(Fields, 'title'),
            MessageText
          )
        );
      end;
    when 'defeated':
      begin
        if Fields.Length() <> 2 then
          begin
            return Error('defeated must contain only type and message');
          end;
        end if;
        const DefeatText: string := try JsonFields.StringField(Fields, 'message');
        if (DefeatText.Length() = 0) or (DefeatText.Length() > Protocol.MaximumCombatLogTextLength) then
          begin
            return Error('defeat message has an invalid length');
          end;
        end if;

        return Ok(Protocol.ServerMessage.Defeated(DefeatText));
      end;
    when 'rejected':
      begin
        if Fields.Length() <> 3 then
          begin
            return Error('rejected must contain only type, code, and message');
          end;
        end if;

        return Ok(
          Protocol.ServerMessage.Rejected(
            try JsonFields.StringField(Fields, 'code'),
            try JsonFields.StringField(Fields, 'message')
          )
        );
      end;
    when 'error':
      begin
        if Fields.Length() <> 3 then
          begin
            return Error('error must contain only type, code, and message');
          end;
        end if;

        return Ok(
          Protocol.ServerMessage.ErrorMessage(
            try JsonFields.StringField(Fields, 'code'),
            try JsonFields.StringField(Fields, 'message')
          )
        );
      end;
    else
      begin
        return Error('unknown server message type');
      end;
  end case;
end function;
end unit;
