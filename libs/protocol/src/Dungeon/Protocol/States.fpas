// Shared visible-state JSON for ordinary replies and atomic dialogue response envelopes.
unit Dungeon.Protocol.States;

uses
  Dungeon.Protocol as Protocol, Dungeon.Protocol.Fields as ProtocolFields, Dungeon.Protocol.Names as Names,
  Dungeon.Protocol.Validation as Validation, Std.Conv as Conv, Std.Json as Json, Std.Json.Fields as JsonFields;

// Renders typed library failures at this unit's application-owned text boundary.
function FailureMessage<E: Error>(Cause: E): string;
begin
  return Cause.Message();
end function;

// Encodes one complete state object, including its type, for reuse inside an atomic reply.
public function EncodeState(Value: Protocol.VisibleState): Json.JsonValue;
begin
  case Value of
    when Protocol.VisibleState.MapState(const MapValue):
      begin
        return (
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('state'),
            'journal': Json.JsonValue.ArrayValue(ProtocolFields.EncodeRows(MapValue.Journal)),
            'view': Json.JsonValue.String(Names.ViewName(Protocol.ViewKind.Map)),
            'title': Json.JsonValue.String(MapValue.Title),
            'status': Json.JsonValue.String(MapValue.Status),
            'origin_x': Json.JsonValue.Number(Conv.IntToReal(MapValue.OriginX)),
            'origin_y': Json.JsonValue.Number(Conv.IntToReal(MapValue.OriginY)),
            'width': Json.JsonValue.Number(Conv.IntToReal(MapValue.Width)),
            'height': Json.JsonValue.Number(Conv.IntToReal(MapValue.Height)),
            'rows': Json.JsonValue.ArrayValue(ProtocolFields.EncodeRows(MapValue.Rows)),
            'knowledge_rows': Json.JsonValue.ArrayValue(
              ProtocolFields.EncodeRows(MapValue.KnowledgeRows)
            ),
            'x': Json.JsonValue.Number(Conv.IntToReal(MapValue.PlayerX)),
            'y': Json.JsonValue.Number(Conv.IntToReal(MapValue.PlayerY)),
            'world_x': Json.JsonValue.Number(Conv.IntToReal(MapValue.WorldX)),
            'world_y': Json.JsonValue.Number(Conv.IntToReal(MapValue.WorldY)),
            'inventory': Json.JsonValue.ArrayValue(
              ProtocolFields.EncodeInventory(MapValue.Inventory)
            ),
            'health': Json.JsonValue.Number(Conv.IntToReal(MapValue.Health)),
            'max_health': Json.JsonValue.Number(Conv.IntToReal(MapValue.MaxHealth)),
            'character': Json.JsonValue.ArrayValue(
              ProtocolFields.EncodeCharacter(MapValue.Character)
            )
          ])
        );
      end;
    when Protocol.VisibleState.FirstPersonState(const FirstPersonValue):
      begin
        return (
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('state'),
            'journal': Json.JsonValue.ArrayValue(
              ProtocolFields.EncodeRows(FirstPersonValue.Journal)
            ),
            'view': Json.JsonValue.String(Names.ViewName(Protocol.ViewKind.FirstPerson)),
            'title': Json.JsonValue.String(FirstPersonValue.Title),
            'status': Json.JsonValue.String(FirstPersonValue.Status),
            'level': Json.JsonValue.Number(Conv.IntToReal(FirstPersonValue.Level)),
            'depth': Json.JsonValue.Number(Conv.IntToReal(FirstPersonValue.Depth)),
            'width': Json.JsonValue.Number(Conv.IntToReal(FirstPersonValue.Width)),
            'height': Json.JsonValue.Number(Conv.IntToReal(FirstPersonValue.Height)),
            'rows': Json.JsonValue.ArrayValue(
              ProtocolFields.EncodeRows(FirstPersonValue.Rows)
            ),
            'knowledge_rows': Json.JsonValue.ArrayValue(
              ProtocolFields.EncodeRows(FirstPersonValue.KnowledgeRows)
            ),
            'x': Json.JsonValue.Number(Conv.IntToReal(FirstPersonValue.PlayerX)),
            'y': Json.JsonValue.Number(Conv.IntToReal(FirstPersonValue.PlayerY)),
            'facing': Json.JsonValue.String(
              Names.FirstPersonFacingName(FirstPersonValue.Facing)
            ),
            'inventory': Json.JsonValue.ArrayValue(
              ProtocolFields.EncodeInventory(FirstPersonValue.Inventory)
            ),
            'health': Json.JsonValue.Number(Conv.IntToReal(FirstPersonValue.Health)),
            'max_health': Json.JsonValue.Number(Conv.IntToReal(FirstPersonValue.MaxHealth)),
            'character': Json.JsonValue.ArrayValue(
              ProtocolFields.EncodeCharacter(FirstPersonValue.Character)
            ),
            'combat_log': Json.JsonValue.ArrayValue(
              ProtocolFields.EncodeRows(FirstPersonValue.CombatLog)
            ),
            'combat_events': Json.JsonValue.ArrayValue(
              ProtocolFields.EncodeCombatEvents(FirstPersonValue.CombatEvents)
            )
          ])
        );
      end;
  end case;
end function;

// Decodes an exact typed state object and validates all dimensions, codes, knowledge and payload bounds.
public function DecodeState(Fields: dict of string to Json.JsonValue): result of (Protocol.VisibleState, string);
begin
  if (try JsonFields.StringField(Fields, 'type').MapError(FailureMessage)) <> 'state' then
    return Error('expected a visible state object');
  end if;

  case try Names.DecodeView(try JsonFields.StringField(Fields, 'view').MapError(FailureMessage)) of
    when Protocol.ViewKind.Map:
      begin
        if Fields.Length() <> 19 then
          begin
            return Error('map state has an unexpected field set');
          end;
        end if;
        const MapValue: Protocol.MapVisibleState := Protocol.MapVisibleState(
          Title := try JsonFields.StringField(Fields, 'title').MapError(FailureMessage),
          Status := try JsonFields.StringField(Fields, 'status').MapError(FailureMessage),
          OriginX := try JsonFields.IntegerField(Fields, 'origin_x').MapError(FailureMessage),
          OriginY := try JsonFields.IntegerField(Fields, 'origin_y').MapError(FailureMessage),
          Width := try JsonFields.IntegerField(Fields, 'width').MapError(FailureMessage),
          Height := try JsonFields.IntegerField(Fields, 'height').MapError(FailureMessage),
          Rows := try JsonFields.StringArrayField(Fields, 'rows').MapError(FailureMessage),
          KnowledgeRows := try JsonFields.StringArrayField(
            Fields,
            'knowledge_rows'
          ).MapError(FailureMessage),
          PlayerX := try JsonFields.IntegerField(Fields, 'x').MapError(FailureMessage),
          PlayerY := try JsonFields.IntegerField(Fields, 'y').MapError(FailureMessage),
          WorldX := try JsonFields.IntegerField(Fields, 'world_x').MapError(FailureMessage),
          WorldY := try JsonFields.IntegerField(Fields, 'world_y').MapError(FailureMessage),
          Inventory := try ProtocolFields.InventoryField(Fields, 'inventory'),
          Health := try JsonFields.IntegerField(Fields, 'health').MapError(FailureMessage),
          MaxHealth := try JsonFields.IntegerField(Fields, 'max_health').MapError(FailureMessage),
          Character := try ProtocolFields.CharacterField(Fields),
          Journal := try JsonFields.StringArrayField(Fields, 'journal').MapError(FailureMessage)
        );
        return Ok(Protocol.VisibleState.MapState(try Validation.ValidateMapVisibleState(MapValue)));
      end;
    when Protocol.ViewKind.FirstPerson:
      begin
        if Fields.Length() <> 20 then
          begin
            return Error('first-person state has an unexpected field set');
          end;
        end if;
        const FirstPersonValue: Protocol.FirstPersonVisibleState := Protocol.FirstPersonVisibleState(
          Title := try JsonFields.StringField(Fields, 'title').MapError(FailureMessage),
          Status := try JsonFields.StringField(Fields, 'status').MapError(FailureMessage),
          Level := try JsonFields.IntegerField(Fields, 'level').MapError(FailureMessage),
          Depth := try JsonFields.IntegerField(Fields, 'depth').MapError(FailureMessage),
          Width := try JsonFields.IntegerField(Fields, 'width').MapError(FailureMessage),
          Height := try JsonFields.IntegerField(Fields, 'height').MapError(FailureMessage),
          Rows := try JsonFields.StringArrayField(Fields, 'rows').MapError(FailureMessage),
          KnowledgeRows := try JsonFields.StringArrayField(
            Fields,
            'knowledge_rows'
          ).MapError(FailureMessage),
          PlayerX := try JsonFields.IntegerField(Fields, 'x').MapError(FailureMessage),
          PlayerY := try JsonFields.IntegerField(Fields, 'y').MapError(FailureMessage),
          Facing := try Names.DecodeFirstPersonFacing(
            try JsonFields.StringField(Fields, 'facing').MapError(FailureMessage)
          ),
          Inventory := try ProtocolFields.InventoryField(Fields, 'inventory'),
          Health := try JsonFields.IntegerField(Fields, 'health').MapError(FailureMessage),
          MaxHealth := try JsonFields.IntegerField(Fields, 'max_health').MapError(FailureMessage),
          Character := try ProtocolFields.CharacterField(Fields),
          CombatLog := try JsonFields.StringArrayField(
            Fields,
            'combat_log'
          ).MapError(FailureMessage),
          CombatEvents := try ProtocolFields.CombatEventsField(Fields),
          Journal := try JsonFields.StringArrayField(Fields, 'journal').MapError(FailureMessage)
        );
        return Ok(
          Protocol.VisibleState.FirstPersonState(
            try Validation.ValidateFirstPersonVisibleState(FirstPersonValue)
          )
        );
      end;
  end case;
end function;
end unit;
