// Bounds and consistency checks applied to every decoded or encoded visible state.
unit Dungeon.Protocol.Validation;

uses Dungeon.Protocol as Protocol;

function IsKnowledgeCode(Value: string): boolean;
begin
  return Value in
    [
      Protocol.KnowledgeUndiscoveredCode,
      Protocol.KnowledgeRememberedCode,
      Protocol.KnowledgeVisibleCode
    ];
end function;

function ValidateKnowledgeRows(
  Rows: array of string;
  KnowledgeRows: array of string;
  Width: integer;
  Height: integer
): result of (boolean, string);
begin
  if KnowledgeRows.Length() <> Height then
    begin
      return Error('knowledge row count must match height');
    end;
  end if;

  for Y: integer := 0 to Height - 1 do
    begin
      if KnowledgeRows[Y].Length() <> Width then
        begin
          return Error('knowledge row width must match width');
        end;
      end if;

      for X: integer := 0 to Width - 1 do
        begin
          const KnowledgeCode: string := KnowledgeRows[Y][X];
          const TerrainCode: string := Rows[Y][X];
          if (TerrainCode = Protocol.MapNpcCode)
            and
            (KnowledgeCode <> Protocol.KnowledgeVisibleCode)
          then
            return Error('NPC map fields must be currently visible');
          end if;

          if not IsKnowledgeCode(KnowledgeCode) then
            begin
              return Error('knowledge row contains an unknown field code');
            end;
          end if;

          if (KnowledgeCode = Protocol.KnowledgeUndiscoveredCode)
            and
            (TerrainCode <> Protocol.UnknownFieldCode)
          then
            begin
              return Error('undiscovered field must not expose terrain');
            end;
          end if;

          if (KnowledgeCode <> Protocol.KnowledgeUndiscoveredCode)
            and
            (TerrainCode = Protocol.UnknownFieldCode)
          then
            begin
              return Error('known field must include terrain');
            end;
          end if;
        end;
      end for;
    end;
  end for;

  return Ok(true);
end function;

// Checks inventory bounds, unique identities, and that only slotted items are worn, one per slot.
public function ValidateInventory(Items: array of Protocol.VisibleInventoryItem): result of (array of Protocol.VisibleInventoryItem, string);
begin
  if Items.Length() > Protocol.MaximumVisibleInventoryItems then
    begin
      return Error('visible inventory exceeds the protocol item limit');
    end;
  end if;

  for Index: integer := 0 to Items.Length() - 1 do
    begin
      const Item: Protocol.VisibleInventoryItem := Items[Index];
      if (Item.Id.Length() = 0) or (Item.Id.Length() > Protocol.MaximumVisibleInventoryTextLength) then
        begin
          return Error('visible inventory item id has an invalid length');
        end;
      end if;

      if (Item.Name.Length() = 0)
        or
        (Item.Name.Length() > Protocol.MaximumVisibleInventoryTextLength)
      then
        begin
          return Error('visible inventory item name has an invalid length');
        end;
      end if;

      if Item.Usable and (Item.Equipped or (Item.Slot <> Protocol.VisibleItemSlot.NoSlot)) then
        return Error('usable inventory item must have no slot and cannot be worn');
      end if;

      if Item.Equipped and (Item.Slot = Protocol.VisibleItemSlot.NoSlot) then
        begin
          return Error('visible inventory item without a slot cannot be worn');
        end;
      end if;

      for Earlier: integer := 0 to Index - 1 do
        begin
          if ((Item.Equipped and Items[Earlier].Equipped) and (Item.Slot = Items[Earlier].Slot)) then
            begin
              return Error('visible inventory wears two items in one slot');
            end;
          end if;
        end;
      end for;

      for Earlier: integer := 0 to Index - 1 do
        begin
          if Items[Earlier].Id = Item.Id then
            begin
              return Error('visible inventory contains a duplicate item id');
            end;
          end if;
        end;
      end for;
    end;
  end for;

  return Ok(Items);
end function;

function ValidateHealth(Health: integer; MaxHealth: integer): result of (boolean, string);
begin
  if ((MaxHealth < 1) or (MaxHealth > Protocol.MaximumVisibleHealth))
    or
    ((Health < 1) or (Health > MaxHealth))
  then
    begin
      return Error('visible health is outside protocol limits');
    end;
  end if;

  return Ok(true);
end function;

function ValidateCombatLog(Log: array of string): result of (boolean, string);
begin
  if Log.Length() > Protocol.MaximumCombatLogEntries then
    begin
      return Error('combat log exceeds the protocol entry limit');
    end;
  end if;

  for Entry: string in Log do
    begin
      if (Entry.Length() = 0) or (Entry.Length() > Protocol.MaximumCombatLogTextLength) then
        begin
          return Error('combat log entry has an invalid length');
        end;
      end if;
    end;
  end for;

  return Ok(true);
end function;

// Rejects oversized journals, empty entries and control/non-ASCII characters before rendering.
public function ValidateJournal(Lines: array of string): result of (boolean, string);
begin
  if Lines.Length() > Protocol.MaximumJournalLines then
    return Error('journal exceeds the protocol line limit');
  end if;

  for Line: string in Lines do
    if (Line.Length() < 1) or (Line.Length() > Protocol.MaximumJournalTextLength) then
      return Error('journal line has invalid length');
    end if;

    for Index: integer := 0 to Line.Length() - 1 do
      if (Line[Index].Ord() < 32) or (Line[Index].Ord() > 126) then
        return Error('journal text must be printable ASCII');
      end if;
    end for;
  end for;

  return Ok(true);
end function;

// Checks the character sheet line count and text bounds.
public function ValidateCharacter(Lines: array of Protocol.VisibleCharacterValue): result of (boolean, string);
begin
  if Lines.Length() > Protocol.MaximumCharacterValues then
    begin
      return Error('character sheet exceeds the protocol line limit');
    end;
  end if;

  for Line: Protocol.VisibleCharacterValue in Lines do
    begin
      if (
        ((Line.Label.Length() = 0) or (Line.Label.Length() > Protocol.MaximumCharacterTextLength))
        or
        ((Line.Value.Length() = 0) or (Line.Value.Length() > Protocol.MaximumCharacterTextLength))
      )
        or
        (
          (Line.Source.Length() = 0)
          or
          (Line.Source.Length() > Protocol.MaximumCharacterTextLength)
        )
      then
        begin
          return Error('character sheet line has an invalid length');
        end;
      end if;
    end;
  end for;

  return Ok(true);
end function;

// Checks the combat event count and amount bounds.
public function ValidateCombatEvents(Events: array of Protocol.VisibleCombatEvent): result of (boolean, string);
begin
  if Events.Length() > Protocol.MaximumCombatEvents then
    begin
      return Error('combat events exceed the protocol entry limit');
    end;
  end if;

  for Entry: Protocol.VisibleCombatEvent in Events do
    begin
      if not Protocol.IsHostileCode(Entry.HostileCode) then
        return Error('combat event hostile_code must be h or r');
      end if;

      if (Entry.Amount < 0) or (Entry.Amount > Protocol.MaximumCombatEventAmount) then
        begin
          return Error('combat event amount is outside protocol limits');
        end;
      end if;

      case Entry.Kind of
        when Protocol.VisibleCombatEventKind.PlayerHit, Protocol.VisibleCombatEventKind.HostileHit:
          if Entry.Amount = 0 then
            return Error('combat hit amount must be positive');
          end if;
        when Protocol.VisibleCombatEventKind.PlayerMiss, Protocol.VisibleCombatEventKind.HostileMiss, Protocol.VisibleCombatEventKind.HostileDefeated:
          if Entry.Amount <> 0 then
            return Error('combat miss or defeat amount must be zero');
          end if;
      end case;
    end;
  end for;

  return Ok(true);
end function;

// Checks a map state: dimensions, alphabet, knowledge rows, player position, inventory, health.
public function ValidateMapVisibleState(Value: Protocol.MapVisibleState): result of (Protocol.MapVisibleState, string);
begin
  if (Value.Title.Length() > Protocol.MaximumMapTitleLength)
    or
    (Value.Status.Length() > Protocol.MaximumMapStatusLength)
  then
    return Error('map title or status exceeds its bound');
  end if;
  const ValidInventory: array of Protocol.VisibleInventoryItem := try ValidateInventory(
    Value.Inventory
  );
  const ValidHealth: boolean := try ValidateHealth(Value.Health, Value.MaxHealth);
  const ValidCharacter: boolean := try ValidateCharacter(Value.Character);
  const ValidJournal := try ValidateJournal(Value.Journal);
  if (Value.Width <= 0) or (Value.Height <= 0) then
    begin
      return Error('visible-state dimensions must be positive');
    end;
  end if;

  if Value.Rows.Length() <> Value.Height then
    begin
      return Error('visible-state row count must match height');
    end;
  end if;

  for Row: string in Value.Rows do
    begin
      if Row.Length() <> Value.Width then
        begin
          return Error('visible-state row width must match width');
        end;
      end if;

      for Index: integer := 0 to Row.Length() - 1 do
        begin
          const Code: string := Row[Index];
          if not Protocol.IsMapCellCode(Code) then
            begin
              return Error('visible-state row contains an unknown cell code');
            end;
          end if;
        end;
      end for;
    end;
  end for;
  const KnowledgeValid: boolean := try ValidateKnowledgeRows(
    Value.Rows,
    Value.KnowledgeRows,
    Value.Width,
    Value.Height
  );
  if (((Value.PlayerX < 0) or (Value.PlayerX >= Value.Width)) or (Value.PlayerY < 0))
    or
    (Value.PlayerY >= Value.Height)
  then
    begin
      return Error('visible-state player position is outside the area');
    end;
  end if;

  if (Value.OriginX + Value.PlayerX <> Value.WorldX)
    or
    (Value.OriginY + Value.PlayerY <> Value.WorldY)
  then
    begin
      return Error('visible-state local and world player positions disagree');
    end;
  end if;

  if Value.KnowledgeRows[Value.PlayerY][Value.PlayerX] <> Protocol.KnowledgeVisibleCode then
    begin
      return Error('visible-state player field must be currently visible');
    end;
  end if;

  return Ok(Value);
end function;

// Checks a first-person state: geometry, alphabet, single exit, traversable player field, and bounded extras.
public function ValidateFirstPersonVisibleState(Value: Protocol.FirstPersonVisibleState): result of (Protocol.FirstPersonVisibleState, string);
begin
  const ValidInventory: array of Protocol.VisibleInventoryItem := try ValidateInventory(
    Value.Inventory
  );
  const ValidHealth: boolean := try ValidateHealth(Value.Health, Value.MaxHealth);
  const ValidLog: boolean := try ValidateCombatLog(Value.CombatLog);
  const ValidCharacter: boolean := try ValidateCharacter(Value.Character);
  const ValidJournal := try ValidateJournal(Value.Journal);
  const ValidEvents: boolean := try ValidateCombatEvents(Value.CombatEvents);
  if Value.Title.Length() = 0 then
    begin
      return Error('first-person state title must not be empty');
    end;
  end if;

  if Value.Status.Length() = 0 then
    begin
      return Error('first-person state status must not be empty');
    end;
  end if;

  if (Value.Width <= 0) or (Value.Height <= 0) then
    begin
      return Error('first-person dimensions must be positive');
    end;
  end if;

  if Value.Rows.Length() <> Value.Height then
    begin
      return Error('first-person row count must match height');
    end;
  end if;

  if (Value.Depth < 1) or (Value.Depth > Protocol.MaximumDungeonDepth) then
    return Error('first-person depth must be from 1 through 16');
  end if;

  if (Value.Level < 0) or (Value.Level >= Value.Depth) then
    return Error('first-person level must be below the depth');
  end if;
  var ExitCount: integer := 0;
  var UpCount: integer := 0;
  var DownCount: integer := 0;
  for Row: string in Value.Rows do
    begin
      if Row.Length() <> Value.Width then
        begin
          return Error('first-person row width must match width');
        end;
      end if;

      for Index: integer := 0 to Row.Length() - 1 do
        begin
          const Code: string := Row[Index];
          if not Protocol.IsInteriorCellCode(Code) then
            begin
              return Error('first-person row contains an unknown field code');
            end;
          end if;

          if Code = Protocol.InteriorExitCode then
            begin
              ExitCount := ExitCount + 1;
            end;
          end if;

          if Code = Protocol.InteriorStairsUpCode then
            UpCount := UpCount + 1;
          end if;

          if Code = Protocol.InteriorStairsDownCode then
            DownCount := DownCount + 1;
          end if;
        end;
      end for;
    end;
  end for;
  const KnowledgeValid: boolean := try ValidateKnowledgeRows(
    Value.Rows,
    Value.KnowledgeRows,
    Value.Width,
    Value.Height
  );
  if ExitCount > 1 then
    begin
      return Error('first-person state must not contain duplicate exit fields');
    end;
  end if;

  if (UpCount > 1) or (DownCount > 1) then
    return Error('first-person state must not contain duplicate stairs');
  end if;

  if (((Value.PlayerX < 0) or (Value.PlayerX >= Value.Width)) or (Value.PlayerY < 0))
    or
    (Value.PlayerY >= Value.Height)
  then
    begin
      return Error('first-person player position is outside the area');
    end;
  end if;
  const PlayerCode: string := Value.Rows[Value.PlayerY][Value.PlayerX];
  if PlayerCode in
    [
      Protocol.InteriorWallCode,
      Protocol.InteriorHostileCode,
      Protocol.InteriorRatCode,
      Protocol.UnknownFieldCode
    ]
  then
    begin
      return Error('first-person player position must be traversable');
    end;
  end if;

  if Value.KnowledgeRows[Value.PlayerY][Value.PlayerX] <> Protocol.KnowledgeVisibleCode then
    begin
      return Error('first-person player field must be currently visible');
    end;
  end if;

  return Ok(Value);
end function;

// Checks an exploration-map window: dimensions, alphabet, knowledge, origin bounds, and player marker.
public function ValidateExplorationMapState(Value: Protocol.ExplorationMapState): result of (Protocol.ExplorationMapState, string);
begin
  if Value.LabelText.Length() = 0 then
    begin
      return Error('exploration map label must not be empty');
    end;
  end if;

  if (Value.Width <= 0) or (Value.Height <= 0) then
    begin
      return Error('exploration map dimensions must be positive');
    end;
  end if;

  if (Value.Width > Protocol.MaximumExplorationMapWidth)
    or
    (Value.Height > Protocol.MaximumExplorationMapHeight)
  then
    begin
      return Error('exploration map dimensions exceed protocol limits');
    end;
  end if;

  if (
    (
      (Value.OriginX < - Protocol.MaximumExplorationMapOriginMagnitude)
      or
      (Value.OriginX > Protocol.MaximumExplorationMapOriginMagnitude)
    ) or (Value.OriginY < - Protocol.MaximumExplorationMapOriginMagnitude)
  )
    or
    (Value.OriginY > Protocol.MaximumExplorationMapOriginMagnitude)
  then
    begin
      return Error('exploration map origin exceeds protocol limits');
    end;
  end if;

  if Value.Rows.Length() <> Value.Height then
    begin
      return Error('exploration map row count must match height');
    end;
  end if;

  for Row: string in Value.Rows do
    begin
      if Row.Length() <> Value.Width then
        begin
          return Error('exploration map row width must match width');
        end;
      end if;

      for X: integer := 0 to Value.Width - 1 do
        begin
          const Code: string := Row[X];
          if Value.View = Protocol.ViewKind.Map then
            begin
              if not Protocol.IsMapCellCode(Code) then
                begin
                  return Error('exploration map contains an unknown outdoor field code');
                end;
              end if;
            end;
          else
            begin
              if not Protocol.IsInteriorCellCode(Code) then
                begin
                  return Error('exploration map contains an unknown interior field code');
                end;
              end if;
            end;
          end if;
        end;
      end for;
    end;
  end for;
  const KnowledgeValid: boolean := try ValidateKnowledgeRows(
    Value.Rows,
    Value.KnowledgeRows,
    Value.Width,
    Value.Height
  );
  const ContainsPlayer: boolean := (
    ((Value.PlayerWorldX >= Value.OriginX) and (Value.PlayerWorldX < Value.OriginX + Value.Width))
    and
    (Value.PlayerWorldY >= Value.OriginY)
  )
    and
    (Value.PlayerWorldY < Value.OriginY + Value.Height);
  if ContainsPlayer <> Value.PlayerInWindow then
    begin
      return Error('exploration map player-in-window flag is inconsistent');
    end;
  end if;

  if Value.PlayerInWindow then
    begin
      const PlayerLocalX: integer := Value.PlayerWorldX - Value.OriginX;
      const PlayerLocalY: integer := Value.PlayerWorldY - Value.OriginY;
      if Value.KnowledgeRows[PlayerLocalY][PlayerLocalX] <> Protocol.KnowledgeVisibleCode then
        begin
          return Error('exploration map player field must be currently visible');
        end;
      end if;
    end;
  end if;

  return Ok(Value);
end function;
end unit;
