// LF-delimited UTF-8 framing over a Functional Pascal TCP connection.
unit Dungeon.Protocol.Transport;

uses Dungeon.Protocol, Std.Net, Std.Net.Utf8, Std.Tasks;

// Exact error returned when a frame exceeds MaximumLineBytes; servers answer it with line_too_long.
public const LineTooLongError: string := 'protocol line exceeds 64 KiB';

// Carries a connection and unread bytes across immutable framing calls.
public type LineReader = record
  public ConnectionValue: Connection;
  public Buffer: array of integer;
end record;

// Couples a decoded line with the reader state required for the next read.
public type LineRead = record
  public Line: string;
  public Reader: LineReader;
end record;

// Starts line framing with no retained bytes.
public function NewLineReader(ConnectionValue: Connection): LineReader;
begin
  return LineReader(ConnectionValue := ConnectionValue, Buffer := []);
end function;

function LineFeedIndex(Bytes: array of integer): integer;
begin
  for Index: integer := 0 to Bytes.Length() - 1 do
    begin
      if Bytes[Index] = 10 then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

// Reads one complete line while retaining bytes belonging to the next line.
public function ReadLine(Reader: LineReader; Token: CancellationToken): result of (LineRead, string);
begin
  var Next: LineReader := Reader;
  var LineEnd: integer := LineFeedIndex(Next.Buffer);
  while LineEnd < 0 do
    begin
      if Next.Buffer.Length() > MaximumLineBytes then
        begin
          return Error(LineTooLongError);
        end;
      end if;
      const Part: array of integer := try ReceiveBytesWithCancellation(Next.ConnectionValue, 4096, Token);
      if Part.Length() = 0 then
        begin
          return Error('connection closed');
        end;
      end if;

      Next.Buffer := Next.Buffer.Concat(Part);
      LineEnd := LineFeedIndex(Next.Buffer);
    end;
  end while;

  if LineEnd > MaximumLineBytes then
    begin
      return Error(LineTooLongError);
    end;
  end if;
  const LineBytes: array of integer := Next.Buffer.Slice(0, LineEnd);
  const RemainingStart: integer := LineEnd + 1;
  Next.Buffer := Next.Buffer.Slice(RemainingStart, Next.Buffer.Length() - RemainingStart);
  return Ok(LineRead(Line := try Std.Net.Utf8.Decode(LineBytes), Reader := Next));
end function;

// Writes one complete LF-delimited line, including partial-write handling.
public function WriteLine(ConnectionValue: Connection; Text: string; Token: CancellationToken): result of (boolean, string);
begin
  const Bytes: array of integer := Std.Net.Utf8.Encode(Text + #10);
  if Bytes.Length() - 1 > MaximumLineBytes then
    begin
      return Error(LineTooLongError);
    end;
  end if;
  var Offset: integer := 0;
  while Offset < Bytes.Length() do
    begin
      const Remaining: array of integer := Bytes.Slice(Offset, Bytes.Length() - Offset);
      const Written: integer := try SendBytesWithCancellation(ConnectionValue, Remaining, Token);
      if Written <= 0 then
        begin
          return Error('connection stopped while writing');
        end;
      end if;

      Offset := Offset + Written;
    end;
  end while;

  return Ok(true);
end function;
end unit;
