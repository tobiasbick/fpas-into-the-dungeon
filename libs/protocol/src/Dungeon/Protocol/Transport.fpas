// LF-delimited UTF-8 framing over a Functional Pascal TCP connection.
unit Dungeon.Protocol.Transport;

uses Dungeon.Protocol as Protocol, Std.Bytes as Bytes, Std.Net.Sockets as Net, Std.Text.Utf8 as Utf8, Std.Tasks as Tasks;

// Renders typed library failures at this unit's application-owned text boundary.
function FailureMessage<E: Error>(Cause: E): string;
begin
  return Cause.Message();
end function;

// Exact error returned when a frame exceeds MaximumLineBytes; servers answer it with line_too_long.
public const LineTooLongError: string := 'protocol line exceeds 64 KiB';

// Carries a connection and unread bytes across immutable framing calls.
public type LineReader = record
  public ConnectionValue: Net.Connection;
  public Buffer: Bytes.ByteBuffer;
end record;

// Couples a decoded line with the reader state required for the next read.
public type LineRead = record
  public Line: string;
  public Reader: LineReader;
end record;

// Starts line framing with no retained bytes.
public function NewLineReader(ConnectionValue: Net.Connection): LineReader;
begin
  return LineReader(ConnectionValue := ConnectionValue, Buffer := Bytes.Create(0).Unwrap());
end function;

function LineFeedIndex(Data: Bytes.ByteBuffer): integer;
begin
  for Index: integer := 0 to Data.Length() - 1 do
    begin
      if Data[Index] = 10 then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

// Reads one complete line while retaining bytes belonging to the next line.
public function ReadLine(Reader: LineReader; Token: Tasks.CancellationToken): result of (LineRead, string);
begin
  var Next: LineReader := Reader;
  var LineEnd: integer := LineFeedIndex(Next.Buffer);
  while LineEnd < 0 do
    begin
      if Next.Buffer.Length() > Protocol.MaximumLineBytes then
        begin
          return Error(LineTooLongError);
        end;
      end if;
      const Part := try Net.ReceiveBytesWithCancellation(
        Next.ConnectionValue,
        4096,
        Token
      ).MapError(FailureMessage);
      if Part.Length() = 0 then
        begin
          return Error('connection closed');
        end;
      end if;

      discard try Next.Buffer.ConcatInPlace(Part).MapError(FailureMessage);
      LineEnd := LineFeedIndex(Next.Buffer);
    end;
  end while;

  if LineEnd > Protocol.MaximumLineBytes then
    begin
      return Error(LineTooLongError);
    end;
  end if;
  const LineBytes := try Next.Buffer.Slice(0, LineEnd).MapError(FailureMessage);
  const RemainingStart: integer := LineEnd + 1;
  Next.Buffer := try Next.Buffer.Slice(
    RemainingStart,
    Next.Buffer.Length() - RemainingStart
  ).MapError(FailureMessage);
  return Ok(LineRead(Line := try Utf8.Decode(LineBytes).MapError(FailureMessage), Reader := Next));
end function;

// Writes one complete LF-delimited line, including partial-write handling.
public function WriteLine(ConnectionValue: Net.Connection; Text: string; Token: Tasks.CancellationToken): result of (boolean, string);
begin
  const Data := try Utf8.Encode(Text + #10).MapError(FailureMessage);
  if Data.Length() - 1 > Protocol.MaximumLineBytes then
    begin
      return Error(LineTooLongError);
    end;
  end if;
  var Offset: integer := 0;
  while Offset < Data.Length() do
    begin
      const Remaining := try Data.Slice(Offset, Data.Length() - Offset).MapError(FailureMessage);
      const Written: integer := try Net.SendBytesWithCancellation(
        ConnectionValue,
        Remaining,
        Token
      ).MapError(FailureMessage);
      if Written <= 0 then
        begin
          return Error('connection stopped while writing');
        end;
      end if;

      Offset := Offset + Written;
    end;
  end while;

  return Ok(true);
end function;
end unit;
