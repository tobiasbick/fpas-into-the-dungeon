// JSON encoding and strict field decoding of nested protocol values.
unit Dungeon.Protocol.Fields;

uses Dungeon.Protocol as Protocol, Dungeon.Protocol.Names as Names, Dungeon.Protocol.Validation as Validation, Std.Math as Math, Std.Encoding.Json as Json, Std.Encoding.Json.Fields as JsonFields;

// Renders typed library failures at this unit's application-owned text boundary.
function FailureMessage<E: Error>(Cause: E): string;
begin
  return Cause.Message();
end function;

// Encodes row strings as a JSON array.
public function EncodeRows(Rows: array of string): array of Json.JsonValue;
begin
  return Rows.Map(
    function(Row: string): Json.JsonValue begin
      return Json.JsonValue.String(Row);
    end function
  );
end function;

// Encodes visible inventory identity, name, slot, worn flag and use capability.
public function EncodeInventory(Items: array of Protocol.VisibleInventoryItem): array of Json.JsonValue;
begin
  var Values: array of Json.JsonValue := [];
  for Item: Protocol.VisibleInventoryItem in Items do
    begin
      Values.PushInPlace(
        Json.JsonValue.Object([
          'id': Json.JsonValue.String(Item.Id),
          'name': Json.JsonValue.String(Item.Name),
          'slot': Json.JsonValue.String(Names.ItemSlotName(Item.Slot)),
          'equipped': Json.JsonValue.Bool(Item.Equipped),
          'usable': Json.JsonValue.Bool(Item.Usable)
        ])
      );
    end;
  end for;

  return Values;
end function;

// Encodes character sheet lines with label, value, and source.
public function EncodeCharacter(Lines: array of Protocol.VisibleCharacterValue): array of Json.JsonValue;
begin
  var Values: array of Json.JsonValue := [];
  for Line: Protocol.VisibleCharacterValue in Lines do
    begin
      Values.PushInPlace(
        Json.JsonValue.Object([
          'label': Json.JsonValue.String(Line.Label),
          'value': Json.JsonValue.String(Line.Value),
          'source': Json.JsonValue.String(Line.Source)
        ])
      );
    end;
  end for;

  return Values;
end function;

// Encodes combat events with kind, amount, and the mandatory opponent marker.
public function EncodeCombatEvents(Events: array of Protocol.VisibleCombatEvent): array of Json.JsonValue;
begin
  var Values: array of Json.JsonValue := [];
  for Entry: Protocol.VisibleCombatEvent in Events do
    begin
      Values.PushInPlace(
        Json.JsonValue.Object([
          'kind': Json.JsonValue.String(Names.CombatEventName(Entry.Kind)),
          'amount': Json.JsonValue.Number(Math.IntToReal(Entry.Amount)),
          'hostile_code': Json.JsonValue.String(Entry.HostileCode)
        ])
      );
    end;
  end for;

  return Values;
end function;

// Decodes and validates one inventory array field; entries must have exactly five fields.
public function InventoryField(Fields: dict of string to Json.JsonValue; Name: string): result of (array of Protocol.VisibleInventoryItem, string);
begin
  case try JsonFields.Field(Fields, Name).MapError(FailureMessage) of
    when Json.JsonValue.ArrayValue(const Values):
      var Items: array of Protocol.VisibleInventoryItem := [];
      for Value: Json.JsonValue in Values do
        begin
          case Value of
            when Json.JsonValue.Object(const ItemFields):
              if ItemFields.Length() <> 5 then
                begin
                  return Error(
                    'visible inventory item must contain only id, name, slot, equipped, and usable'
                  );
                end;
              end if;

              Items.PushInPlace(
                Protocol.VisibleInventoryItem(
                  Id := try JsonFields.StringField(ItemFields, 'id').MapError(FailureMessage),
                  Name := try JsonFields.StringField(ItemFields, 'name').MapError(FailureMessage),
                  Slot := try Names.DecodeItemSlot(
                    try JsonFields.StringField(ItemFields, 'slot').MapError(FailureMessage)
                  ),
                  Equipped := try JsonFields.BooleanField(
                    ItemFields,
                    'equipped'
                  ).MapError(FailureMessage),
                  Usable := try JsonFields.BooleanField(
                    ItemFields,
                    'usable'
                  ).MapError(FailureMessage)
                )
              );
            when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
              return Error('visible inventory must contain only objects');
          end case;
        end;
      end for;

      return Validation.ValidateInventory(Items);
    when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.Object(_):
      return Error('message field inventory must be an array');
  end case;
end function;

// Decodes the bounded, non-empty item_id field.
public function ItemIdField(Fields: dict of string to Json.JsonValue): result of (string, string);
begin
  const ItemId: string := try JsonFields.StringField(Fields, 'item_id').MapError(FailureMessage);
  if (ItemId.Length() = 0) or (ItemId.Length() > Protocol.MaximumVisibleInventoryTextLength) then
    begin
      return Error('item id has an invalid length');
    end;
  end if;

  return Ok(ItemId);
end function;

// Decodes and validates the character field.
public function CharacterField(Fields: dict of string to Json.JsonValue): result of (array of Protocol.VisibleCharacterValue, string);
begin
  case try JsonFields.Field(Fields, 'character').MapError(FailureMessage) of
    when Json.JsonValue.ArrayValue(const Values):
      var Lines: array of Protocol.VisibleCharacterValue := [];
      for Value: Json.JsonValue in Values do
        begin
          case Value of
            when Json.JsonValue.Object(const LineFields):
              if LineFields.Length() <> 3 then
                begin
                  return Error('character line must contain only label, value, and source');
                end;
              end if;

              Lines.PushInPlace(
                Protocol.VisibleCharacterValue(
                  Label := try JsonFields.StringField(LineFields, 'label').MapError(FailureMessage),
                  Value := try JsonFields.StringField(LineFields, 'value').MapError(FailureMessage),
                  Source := try JsonFields.StringField(
                    LineFields,
                    'source'
                  ).MapError(FailureMessage)
                )
              );
            when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
              return Error('character must contain only objects');
          end case;
        end;
      end for;
      const Valid: boolean := try Validation.ValidateCharacter(Lines);
      return Ok(Lines);
    when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.Object(_):
      return Error('message field character must be an array');
  end case;
end function;

// Decodes and validates the combat_events field.
public function CombatEventsField(Fields: dict of string to Json.JsonValue): result of (array of Protocol.VisibleCombatEvent, string);
begin
  case try JsonFields.Field(Fields, 'combat_events').MapError(FailureMessage) of
    when Json.JsonValue.ArrayValue(const Values):
      var Events: array of Protocol.VisibleCombatEvent := [];
      for Value: Json.JsonValue in Values do
        begin
          case Value of
            when Json.JsonValue.Object(const EventFields):
              if EventFields.Length() <> 3 then
                begin
                  return Error('combat event must contain only kind, amount, and hostile_code');
                end;
              end if;

              Events.PushInPlace(
                Protocol.VisibleCombatEvent(
                  Kind := try Names.DecodeCombatEventKind(
                    try JsonFields.StringField(EventFields, 'kind').MapError(FailureMessage)
                  ),
                  Amount := try JsonFields.IntegerField(
                    EventFields,
                    'amount'
                  ).MapError(FailureMessage),
                  HostileCode := try JsonFields.StringField(
                    EventFields,
                    'hostile_code'
                  ).MapError(FailureMessage)
                )
              );
            when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
              return Error('combat events must contain only objects');
          end case;
        end;
      end for;
      const Valid: boolean := try Validation.ValidateCombatEvents(Events);
      return Ok(Events);
    when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.Object(_):
      return Error('message field combat_events must be an array');
  end case;
end function;
end unit;
