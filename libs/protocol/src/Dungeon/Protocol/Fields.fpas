// JSON encoding and strict field decoding of nested protocol values.
unit Dungeon.Protocol.Fields;

uses
  Dungeon.Protocol, Dungeon.Protocol.Names, Dungeon.Protocol.Validation, Std.Conv, Std.Json,
  Std.Json.Fields;

// Encodes row strings as a JSON array.
public function EncodeRows(Rows: array of string): array of JsonValue;
begin
  return Rows.Map(function(Row: string): JsonValue begin
    return JsonValue.String(Row);
  end function);
end function;

// Encodes visible inventory entries with id, name, slot, and worn flag.
public function EncodeInventory(Items: array of VisibleInventoryItem): array of JsonValue;
begin
  var Values: array of JsonValue := [];
  for Item: VisibleInventoryItem in Items do
    begin
      Values.Push(JsonValue.Object(['id': JsonValue.String(Item.Id), 'name': JsonValue.String(Item.Name), 'slot': JsonValue.String(ItemSlotName(Item.Slot)), 'equipped': JsonValue.Bool(Item.Equipped)]));
    end;
  end for;

  return Values;
end function;

// Encodes character sheet lines with label, value, and source.
public function EncodeCharacter(Lines: array of VisibleCharacterValue): array of JsonValue;
begin
  var Values: array of JsonValue := [];
  for Line: VisibleCharacterValue in Lines do
    begin
      Values.Push(JsonValue.Object(['label': JsonValue.String(Line.Label), 'value': JsonValue.String(Line.Value), 'source': JsonValue.String(Line.Source)]));
    end;
  end for;

  return Values;
end function;

// Encodes combat events with kind and amount.
public function EncodeCombatEvents(Events: array of VisibleCombatEvent): array of JsonValue;
begin
  var Values: array of JsonValue := [];
  for Entry: VisibleCombatEvent in Events do
    begin
      Values.Push(JsonValue.Object(['kind': JsonValue.String(CombatEventName(Entry.Kind)), 'amount': JsonValue.Number(IntToReal(Entry.Amount))]));
    end;
  end for;

  return Values;
end function;

// Decodes and validates one inventory array field; entries must have exactly four fields.
public function InventoryField(Fields: dict of string to JsonValue; Name: string): result of (array of VisibleInventoryItem, string);
begin
  if try Field(Fields, Name) is JsonValue.ArrayValue(const Values) then
    begin
      var Items: array of VisibleInventoryItem := [];
      for Value: JsonValue in Values do
        begin
          if Value is JsonValue.Object(const ItemFields) then
            begin
              if ItemFields.Length() <> 4 then
                begin
                  return Error('visible inventory item must contain only id, name, slot, and equipped');
                end;
              end if;

              Items.Push(VisibleInventoryItem(Id := try StringField(ItemFields, 'id'), Name := try StringField(ItemFields, 'name'), Slot := try DecodeItemSlot(try StringField(ItemFields, 'slot')), Equipped := try BooleanField(ItemFields, 'equipped')));
            end;
          else
            begin
              return Error('visible inventory must contain only objects');
            end;
          end if;
        end;
      end for;

      return ValidateInventory(Items);
    end;
  else
    begin
      return Error('message field inventory must be an array');
    end;
  end if;
end function;

// Decodes the bounded, non-empty item_id field.
public function ItemIdField(Fields: dict of string to JsonValue): result of (string, string);
begin
  const ItemId: string := try StringField(Fields, 'item_id');
  if (ItemId.Length() = 0) or (ItemId.Length() > MaximumVisibleInventoryTextLength) then
    begin
      return Error('item id has an invalid length');
    end;
  end if;

  return Ok(ItemId);
end function;

// Decodes and validates the character field.
public function CharacterField(Fields: dict of string to JsonValue): result of (array of VisibleCharacterValue, string);
begin
  if try Field(Fields, 'character') is JsonValue.ArrayValue(const Values) then
    begin
      var Lines: array of VisibleCharacterValue := [];
      for Value: JsonValue in Values do
        begin
          if Value is JsonValue.Object(const LineFields) then
            begin
              if LineFields.Length() <> 3 then
                begin
                  return Error('character line must contain only label, value, and source');
                end;
              end if;

              Lines.Push(VisibleCharacterValue(Label := try StringField(LineFields, 'label'), Value := try StringField(LineFields, 'value'), Source := try StringField(LineFields, 'source')));
            end;
          else
            begin
              return Error('character must contain only objects');
            end;
          end if;
        end;
      end for;
      const Valid: boolean := try ValidateCharacter(Lines);
      return Ok(Lines);
    end;
  else
    begin
      return Error('message field character must be an array');
    end;
  end if;
end function;

// Decodes and validates the combat_events field.
public function CombatEventsField(Fields: dict of string to JsonValue): result of (array of VisibleCombatEvent, string);
begin
  if try Field(Fields, 'combat_events') is JsonValue.ArrayValue(const Values) then
    begin
      var Events: array of VisibleCombatEvent := [];
      for Value: JsonValue in Values do
        begin
          if Value is JsonValue.Object(const EventFields) then
            begin
              if EventFields.Length() <> 2 then
                begin
                  return Error('combat event must contain only kind and amount');
                end;
              end if;

              Events.Push(VisibleCombatEvent(Kind := try DecodeCombatEventKind(try StringField(EventFields, 'kind')), Amount := try IntegerField(EventFields, 'amount')));
            end;
          else
            begin
              return Error('combat events must contain only objects');
            end;
          end if;
        end;
      end for;
      const Valid: boolean := try ValidateCombatEvents(Events);
      return Ok(Events);
    end;
  else
    begin
      return Error('message field combat_events must be an array');
    end;
  end if;
end function;
end unit;
