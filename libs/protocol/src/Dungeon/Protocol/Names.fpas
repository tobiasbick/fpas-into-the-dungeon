      begin
        return 'player_miss';
      end;
    when Protocol.VisibleCombatEventKind.HostileHit:
      begin
        return 'hostile_hit';
      end;
    when Protocol.VisibleCombatEventKind.HostileMiss:
      begin
        return 'hostile_miss';
      end;
    when Protocol.VisibleCombatEventKind.HostileDefeated:
      begin
        return 'hostile_defeated';
      end;
  end case;
end function;

// Decodes a combat event kind wire name; unknown names are an error.
public function DecodeCombatEventKind(Value: string): result of (Protocol.VisibleCombatEventKind, string);
begin
  case Value of
    when 'player_hit':
      begin
        return Ok(Protocol.VisibleCombatEventKind.PlayerHit);
      end;
    when 'player_miss':
      begin
        return Ok(Protocol.VisibleCombatEventKind.PlayerMiss);
      end;
    when 'hostile_hit':
      begin
        return Ok(Protocol.VisibleCombatEventKind.HostileHit);
      end;
    when 'hostile_miss':
      begin
        return Ok(Protocol.VisibleCombatEventKind.HostileMiss);
      end;
    when 'hostile_defeated':
      begin
        return Ok(Protocol.VisibleCombatEventKind.HostileDefeated);
      end;
    else
      begin
        return Error('combat event has an unknown kind');
      end;
  end case;
end function;
end unit;
