// Returns the wire name of an item slot; items without a slot use the empty string.
public function ItemSlotName(Value: VisibleItemSlot): string;
begin
  case Value of
    VisibleItemSlot.NoSlot:
    begin
      return ''
    end;
    VisibleItemSlot.Weapon:
    begin
      return 'weapon'
    end;
    VisibleItemSlot.Body:
    begin
      return 'body'
    end
  end
end;

// Decodes an item slot wire name; unknown names are an error.
public function DecodeItemSlot(Value: string): result of VisibleItemSlot, string;
begin
  case Value of
    '':
    begin
      return Ok(VisibleItemSlot.NoSlot)
    end;
    'weapon':
    begin
      return Ok(VisibleItemSlot.Weapon)
    end;
    'body':
    begin
      return Ok(VisibleItemSlot.Body)
    end
    else
    begin
      return Error('visible inventory item has an unknown slot')
    end
  end
end;

