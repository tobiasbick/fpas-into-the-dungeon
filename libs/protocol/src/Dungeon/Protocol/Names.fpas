// Wire names of protocol enumerations and their strict decoding.
unit Dungeon.Protocol.Names;

uses Dungeon.Protocol;

// Returns the wire name of a view.
public function ViewName(Value: ViewKind): string;
begin
  case Value of
    ViewKind.Map:
    begin
      return 'map'
    end;
    ViewKind.FirstPerson:
    begin
      return 'first_person'
    end
  end
end;

// Decodes a view wire name; unknown names are an error.
public function DecodeView(Value: string): result of ViewKind, string;
begin
  case Value of
    'map':
    begin
      return Ok(ViewKind.Map)
    end;
    'first_person':
    begin
      return Ok(ViewKind.FirstPerson)
    end
    else
    begin
      return Error('unknown visible-state view')
    end
  end
end;

// Returns the wire name of a facing.
public function FirstPersonFacingName(Value: FirstPersonFacing): string;
begin
  case Value of
    FirstPersonFacing.North:
    begin
      return 'north'
    end;
    FirstPersonFacing.East:
    begin
      return 'east'
    end;
    FirstPersonFacing.South:
    begin
      return 'south'
    end;
    FirstPersonFacing.West:
    begin
      return 'west'
    end
  end
end;

// Decodes a facing wire name; unknown names are an error.
public function DecodeFirstPersonFacing(Value: string): result of FirstPersonFacing, string;
begin
  case Value of
    'north':
    begin
      return Ok(FirstPersonFacing.North)
    end;
    'east':
    begin
      return Ok(FirstPersonFacing.East)
    end;
    'south':
    begin
      return Ok(FirstPersonFacing.South)
    end;
    'west':
    begin
      return Ok(FirstPersonFacing.West)
    end
    else
    begin
      return Error('unknown first-person facing direction')
    end
  end
end;

