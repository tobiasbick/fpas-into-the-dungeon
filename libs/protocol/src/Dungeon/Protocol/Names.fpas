// Returns the wire name of an item slot; items without a slot use the empty string.
public function ItemSlotName(Value: VisibleItemSlot): string;
begin
  case Value of
    when VisibleItemSlot.NoSlot:
      begin
        return '';
      end;
    when VisibleItemSlot.Weapon:
      begin
        return 'weapon';
      end;
    when VisibleItemSlot.Body:
      begin
        return 'body';
      end;
  end case;
end function;

// Decodes an item slot wire name; unknown names are an error.
public function DecodeItemSlot(Value: string): result of VisibleItemSlot, string;
begin
  case Value of
    when '':
      begin
        return Ok(VisibleItemSlot.NoSlot);
      end;
    when 'weapon':
      begin
        return Ok(VisibleItemSlot.Weapon);
      end;
    when 'body':
      begin
        return Ok(VisibleItemSlot.Body);
      end;
    else
      begin
        return Error('visible inventory item has an unknown slot');
      end;
  end case;
end function;

// Returns the wire name of a combat event kind.
public function CombatEventName(Value: VisibleCombatEventKind): string;
begin
  case Value of
    when VisibleCombatEventKind.PlayerHit:
      begin
        return 'player_hit';
      end;
    when VisibleCombatEventKind.PlayerMiss:
      begin
        return 'player_miss';
      end;
    when VisibleCombatEventKind.HostileHit:
      begin
        return 'hostile_hit';
      end;
    when VisibleCombatEventKind.HostileMiss:
      begin
        return 'hostile_miss';
      end;
    when VisibleCombatEventKind.HostileDefeated:
      begin
        return 'hostile_defeated';
      end;
  end case;
end function;

// Decodes a combat event kind wire name; unknown names are an error.
public function DecodeCombatEventKind(Value: string): result of VisibleCombatEventKind, string;
begin
  case Value of
    when 'player_hit':
      begin
        return Ok(VisibleCombatEventKind.PlayerHit);
      end;
    when 'player_miss':
      begin
        return Ok(VisibleCombatEventKind.PlayerMiss);
      end;
    when 'hostile_hit':
      begin
        return Ok(VisibleCombatEventKind.HostileHit);
      end;
    when 'hostile_miss':
      begin
        return Ok(VisibleCombatEventKind.HostileMiss);
      end;
    when 'hostile_defeated':
      begin
        return Ok(VisibleCombatEventKind.HostileDefeated);
      end;
    else
      begin
        return Error('combat event has an unknown kind');
      end;
  end case;
end function;
end unit;
