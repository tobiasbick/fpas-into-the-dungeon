// Wire names of protocol enumerations and their strict decoding.
unit Dungeon.Protocol.Names;

uses Dungeon.Protocol as Protocol;

// Returns the wire name of a view.
public function ViewName(Value: Protocol.ViewKind): string;
begin
  case Value of
    when Protocol.ViewKind.Map:
      begin
        return 'map';
      end;
    when Protocol.ViewKind.FirstPerson:
      begin
        return 'first_person';
      end;
  end case;
end function;

// Decodes a view wire name; unknown names are an error.
public function DecodeView(Value: string): result of (Protocol.ViewKind, string);
begin
  case Value of
    when 'map':
      begin
        return Ok(Protocol.ViewKind.Map);
      end;
    when 'first_person':
      begin
        return Ok(Protocol.ViewKind.FirstPerson);
      end;
    else
      begin
        return Error('unknown visible-state view');
      end;
  end case;
end function;

// Returns the wire name of a facing.
public function FirstPersonFacingName(Value: Protocol.FirstPersonFacing): string;
begin
  case Value of
    when Protocol.FirstPersonFacing.North:
      begin
        return 'north';
      end;
    when Protocol.FirstPersonFacing.East:
      begin
        return 'east';
      end;
    when Protocol.FirstPersonFacing.South:
      begin
        return 'south';
      end;
    when Protocol.FirstPersonFacing.West:
      begin
        return 'west';
      end;
  end case;
end function;

// Decodes a facing wire name; unknown names are an error.
public function DecodeFirstPersonFacing(Value: string): result of (Protocol.FirstPersonFacing, string);
begin
  case Value of
    when 'north':
      begin
        return Ok(Protocol.FirstPersonFacing.North);
      end;
    when 'east':
      begin
        return Ok(Protocol.FirstPersonFacing.East);
      end;
    when 'south':
      begin
        return Ok(Protocol.FirstPersonFacing.South);
      end;
    when 'west':
      begin
        return Ok(Protocol.FirstPersonFacing.West);
      end;
    else
      begin
        return Error('unknown first-person facing direction');
      end;
  end case;
end function;

