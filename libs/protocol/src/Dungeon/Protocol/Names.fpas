// Returns the wire name of an item slot; items without a slot use the empty string.
public function ItemSlotName(Value: Protocol.VisibleItemSlot): string;
begin
  case Value of
    when Protocol.VisibleItemSlot.NoSlot:
      begin
        return '';
      end;
    when Protocol.VisibleItemSlot.Weapon:
      begin
        return 'weapon';
      end;
    when Protocol.VisibleItemSlot.Body:
      begin
        return 'body';
      end;
  end case;
end function;

// Decodes an item slot wire name; unknown names are an error.
public function DecodeItemSlot(Value: string): result of (Protocol.VisibleItemSlot, string);
begin
  case Value of
    when '':
      begin
        return Ok(Protocol.VisibleItemSlot.NoSlot);
      end;
    when 'weapon':
      begin
        return Ok(Protocol.VisibleItemSlot.Weapon);
      end;
    when 'body':
      begin
        return Ok(Protocol.VisibleItemSlot.Body);
      end;
    else
      begin
        return Error('visible inventory item has an unknown slot');
      end;
  end case;
end function;

