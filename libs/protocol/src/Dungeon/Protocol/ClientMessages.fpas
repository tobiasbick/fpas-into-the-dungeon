// Encoding and strict decoding of client-to-server messages.
unit Dungeon.Protocol.ClientMessages;

uses Dungeon.Protocol as Protocol, Dungeon.Protocol.Worlds as WorldsUnit, Dungeon.Protocol.Fields as ProtocolFields, Dungeon.Protocol.Names as Names, Std.Conv as Conv, Std.Json as Json, Std.Json.Fields as JsonFields;

// Encodes one client message as a compact JSON object for line transport.
public function EncodeClient(Message: Protocol.ClientMessage): string;
begin
  case Message of
    when Protocol.ClientMessage.Hello(const Version, const ViewWidth, const ViewHeight):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('hello'),
            'version': Json.JsonValue.Number(Conv.IntToReal(Version)),
            'width': Json.JsonValue.Number(Conv.IntToReal(ViewWidth)),
            'height': Json.JsonValue.Number(Conv.IntToReal(ViewHeight))
          ])
        );
      end;
    when Protocol.ClientMessage.StartNewGame:
      begin
        return Json.Stringify(Json.JsonValue.Object(['type': Json.JsonValue.String('new_game')]));
      end;
    when Protocol.ClientMessage.LoadGame:
      begin
        return Json.Stringify(Json.JsonValue.Object(['type': Json.JsonValue.String('load_game')]));
      end;
    when Protocol.ClientMessage.SaveGame:
      begin
        return Json.Stringify(Json.JsonValue.Object(['type': Json.JsonValue.String('save_game')]));
      end;
    when Protocol.ClientMessage.OverwriteSaveGame:
      begin
        return Json.Stringify(
          Json.JsonValue.Object(['type': Json.JsonValue.String('overwrite_save')])
        );
      end;
    when Protocol.ClientMessage.ListWorlds(const Offset, const DiscardProgress):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('list_worlds'),
            'offset': Json.JsonValue.Number(Conv.IntToReal(Offset)),
            'discard': Json.JsonValue.Bool(DiscardProgress)
          ])
        );
      end;
    when Protocol.ClientMessage.SelectWorld(const Id):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('select_world'),
            'id': Json.JsonValue.String(Id)
          ])
        );
      end;
    when Protocol.ClientMessage.CreateWorld(const Seed, const RegionChunks):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('create_world'),
            'seed': Json.JsonValue.Number(Conv.IntToReal(Seed)),
            'region_chunks': Json.JsonValue.Number(Conv.IntToReal(RegionChunks))
          ])
        );
      end;
    when Protocol.ClientMessage.Viewport(const Width, const Height):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('viewport'),
            'width': Json.JsonValue.Number(Conv.IntToReal(Width)),
            'height': Json.JsonValue.Number(Conv.IntToReal(Height))
          ])
        );
      end;
    when Protocol.ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('exploration_map'),
            'origin_x': Json.JsonValue.Number(Conv.IntToReal(OriginX)),
            'origin_y': Json.JsonValue.Number(Conv.IntToReal(OriginY)),
            'width': Json.JsonValue.Number(Conv.IntToReal(Width)),
            'height': Json.JsonValue.Number(Conv.IntToReal(Height))
          ])
        );
      end;
    when Protocol.ClientMessage.Move(const DeltaX, const DeltaY):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('move'),
            'dx': Json.JsonValue.Number(Conv.IntToReal(DeltaX)),
            'dy': Json.JsonValue.Number(Conv.IntToReal(DeltaY))
          ])
        );
      end;
    when Protocol.ClientMessage.StepFirstPerson(const Direction):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('first_person_step'),
            'direction': Json.JsonValue.String(Names.FirstPersonStepName(Direction))
          ])
        );
      end;
    when Protocol.ClientMessage.TurnFirstPerson(const Direction):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('first_person_turn'),
            'direction': Json.JsonValue.String(Names.FirstPersonTurnName(Direction))
          ])
        );
      end;
    when Protocol.ClientMessage.Interact:
      begin
        return Json.Stringify(Json.JsonValue.Object(['type': Json.JsonValue.String('interact')]));
      end;
    when Protocol.ClientMessage.Attack:
      begin
        return Json.Stringify(Json.JsonValue.Object(['type': Json.JsonValue.String('attack')]));
      end;
    when Protocol.ClientMessage.Wait:
      begin
        return Json.Stringify(Json.JsonValue.Object(['type': Json.JsonValue.String('wait')]));
      end;
    when Protocol.ClientMessage.Equip(const ItemId):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('equip'),
            'item_id': Json.JsonValue.String(ItemId)
          ])
        );
      end;
    when Protocol.ClientMessage.Unequip(const ItemId):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('unequip'),
            'item_id': Json.JsonValue.String(ItemId)
          ])
        );
      end;
    when Protocol.ClientMessage.DropItem(const ItemId):
      begin
        return Json.Stringify(
          Json.JsonValue.Object([
            'type': Json.JsonValue.String('drop_item'),
            'item_id': Json.JsonValue.String(ItemId)
          ])
        );
      end;
    when Protocol.ClientMessage.Disconnect:
      begin
        return Json.Stringify(Json.JsonValue.Object(['type': Json.JsonValue.String('disconnect')]));
      end;
  end case;
end function;

// Decodes one client message and rejects missing, mistyped, or unknown fields.
public function DecodeClient(Text: string): result of (Protocol.ClientMessage, string);
begin
  const Fields: dict of string to Json.JsonValue := try JsonFields.ParseObject(Text);
  case try JsonFields.StringField(Fields, 'type') of
    when 'hello':
      begin
        if Fields.Length() <> 4 then
          begin
            return Error('hello must contain only type, version, width, and height');
          end;
        end if;

        return Ok(
          Protocol.ClientMessage.Hello(
            try JsonFields.IntegerField(Fields, 'version'),
            try JsonFields.IntegerField(Fields, 'width'),
            try JsonFields.IntegerField(Fields, 'height')
          )
        );
      end;
    when 'new_game':
      begin
        if Fields.Length() <> 1 then
          begin
            return Error('new_game must not contain additional fields');
          end;
        end if;

        return Ok(Protocol.ClientMessage.StartNewGame);
      end;
    when 'load_game':
      begin
        if Fields.Length() <> 1 then
          begin
            return Error('load_game must not contain additional fields');
          end;
        end if;

        return Ok(Protocol.ClientMessage.LoadGame);
      end;
    when 'save_game':
      begin
        if Fields.Length() <> 1 then
          begin
            return Error('save_game must not contain additional fields');
          end;
        end if;

        return Ok(Protocol.ClientMessage.SaveGame);
      end;
    when 'overwrite_save':
      begin
        if Fields.Length() <> 1 then
          begin
            return Error('overwrite_save has unexpected fields');
          end;
        end if;

        return Ok(Protocol.ClientMessage.OverwriteSaveGame);
      end;
    when 'list_worlds':
      begin
        if Fields.Length() <> 3 then
          begin
            return Error('list_worlds has unexpected fields');
          end;
        end if;
        const Offset: integer := try JsonFields.IntegerField(Fields, 'offset');
        if (Offset < 0) or (Offset > 1000000) then
          begin
            return Error('invalid catalog offset');
          end;
        end if;

        return Ok(
          Protocol.ClientMessage.ListWorlds(Offset, try JsonFields.BooleanField(Fields, 'discard'))
        );
      end;
    when 'select_world':
      begin
        if Fields.Length() <> 2 then
          begin
            return Error('select_world has unexpected fields');
          end;
        end if;

        return Ok(
          Protocol.ClientMessage.SelectWorld(
            try WorldsUnit.ValidateWorldIdentity(try JsonFields.StringField(Fields, 'id'))
          )
        );
      end;
    when 'create_world':
      begin
        if Fields.Length() <> 3 then
          begin
            return Error('create_world has unexpected fields');
          end;
        end if;
        const Seed: integer := try JsonFields.IntegerField(Fields, 'seed');
        const Region: integer := try JsonFields.IntegerField(Fields, 'region_chunks');
        if (Seed < -2147483648) or (Seed > 2147483647) or (Region < 1) or (Region > 16) then
          begin
            return Error('world parameters exceed protocol limits');
          end;
        end if;

        return Ok(Protocol.ClientMessage.CreateWorld(Seed, Region));
      end;
    when 'viewport':
      begin
        if Fields.Length() <> 3 then
          begin
            return Error('viewport must contain only type, width, and height');
          end;
        end if;

        return Ok(
          Protocol.ClientMessage.Viewport(
            try JsonFields.IntegerField(Fields, 'width'),
            try JsonFields.IntegerField(Fields, 'height')
          )
        );
      end;
    when 'exploration_map':
      begin
        if Fields.Length() <> 5 then
          begin
            return Error(
              'exploration_map must contain only type, origin_x, origin_y, width, and height'
            );
          end;
        end if;
        const Width: integer := try JsonFields.IntegerField(Fields, 'width');
        const Height: integer := try JsonFields.IntegerField(Fields, 'height');
        if (((Width < 1) or (Height < 1)) or (Width > Protocol.MaximumExplorationMapWidth))
          or
          (Height > Protocol.MaximumExplorationMapHeight)
        then
          begin
            return Error('exploration_map dimensions are outside protocol limits');
          end;
        end if;
        const OriginX: integer := try JsonFields.IntegerField(Fields, 'origin_x');
        const OriginY: integer := try JsonFields.IntegerField(Fields, 'origin_y');
        if (
          (
            (OriginX < - Protocol.MaximumExplorationMapOriginMagnitude)
            or
            (OriginX > Protocol.MaximumExplorationMapOriginMagnitude)
          ) or (OriginY < - Protocol.MaximumExplorationMapOriginMagnitude)
        )
          or
          (OriginY > Protocol.MaximumExplorationMapOriginMagnitude)
        then
          begin
            return Error('exploration_map origin is outside protocol limits');
          end;
        end if;

        return Ok(Protocol.ClientMessage.ExplorationMap(OriginX, OriginY, Width, Height));
      end;
    when 'move':
      begin
        if Fields.Length() <> 3 then
          begin
            return Error('move must contain only type, dx, and dy');
          end;
        end if;

        return Ok(
          Protocol.ClientMessage.Move(
            try JsonFields.IntegerField(Fields, 'dx'),
            try JsonFields.IntegerField(Fields, 'dy')
          )
        );
      end;
    when 'first_person_step':
      begin
        if Fields.Length() <> 2 then
          begin
            return Error('first_person_step must contain only type and direction');
          end;
        end if;

        return Ok(
          Protocol.ClientMessage.StepFirstPerson(
            try Names.DecodeFirstPersonStep(try JsonFields.StringField(Fields, 'direction'))
          )
        );
      end;
    when 'first_person_turn':
      begin
        if Fields.Length() <> 2 then
          begin
            return Error('first_person_turn must contain only type and direction');
          end;
        end if;

        return Ok(
          Protocol.ClientMessage.TurnFirstPerson(
            try Names.DecodeFirstPersonTurn(try JsonFields.StringField(Fields, 'direction'))
          )
        );
      end;
    when 'interact':
      begin
        if Fields.Length() <> 1 then
          begin
            return Error('interact must not contain additional fields');
          end;
        end if;

        return Ok(Protocol.ClientMessage.Interact);
      end;
    when 'attack':
      begin
        if Fields.Length() <> 1 then
          begin
            return Error('attack must not contain additional fields');
          end;
        end if;

        return Ok(Protocol.ClientMessage.Attack);
      end;
    when 'wait':
      begin
        if Fields.Length() <> 1 then
          begin
            return Error('wait must not contain additional fields');
          end;
        end if;

        return Ok(Protocol.ClientMessage.Wait);
      end;
    when 'equip':
      begin
        if Fields.Length() <> 2 then
          begin
            return Error('equip must contain only type and item_id');
          end;
        end if;

        return Ok(Protocol.ClientMessage.Equip(try ProtocolFields.ItemIdField(Fields)));
      end;
    when 'unequip':
      begin
        if Fields.Length() <> 2 then
          begin
            return Error('unequip must contain only type and item_id');
          end;
        end if;

        return Ok(Protocol.ClientMessage.Unequip(try ProtocolFields.ItemIdField(Fields)));
      end;
    when 'drop_item':
      begin
        if Fields.Length() <> 2 then
          begin
            return Error('drop_item must contain only type and item_id');
          end;
        end if;

        return Ok(Protocol.ClientMessage.DropItem(try ProtocolFields.ItemIdField(Fields)));
      end;
    when 'disconnect':
      begin
        if Fields.Length() <> 1 then
          begin
            return Error('disconnect must not contain additional fields');
          end;
        end if;

        return Ok(Protocol.ClientMessage.Disconnect);
      end;
    else
      begin
        return Error('unknown client message type');
      end;
  end case;
end function;
end unit;
