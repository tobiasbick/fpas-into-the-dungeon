// Versioned wire contract shared by client and server: limits, cell codes, and message types.
unit Dungeon.Protocol;

// Wire compatibility version required during the hello/welcome handshake.
public const ProtocolVersion: integer := 20;
// Economy wire bounds; arithmetic and catalogue ownership remain game rules.
public const MaximumCoins: integer := 1000000000;
// Quote identities increase within one connection and never wrap.
public const MaximumTradeRevision: integer := 1000000000;
// Total individual rows permitted on either side, including worn inventory entries.
public const MaximumTradeItems: integer := 64;
// A quote carries only this many rows per side; the server retains page indexes.
public const TradePageSize: integer := 16;
// Wire prices are positive catalogue amounts; null represents an unpriced item.
public const MaximumTradePrice: integer := 20;
// Printable single-line refusal text remains bounded independently of names.
public const MaximumTradeReasonLength: integer := 160;
// Catalog pages and text are bounded to fit one transport line.
public const MaximumWorldsPerPage: integer := 64;
public const MaximumWorldReasonLength: integer := 256;
// Maximum UTF-8 payload before the terminating line feed.
public const MaximumLineBytes: integer := 65536;
// Largest exploration-map window that remains below the line-size limit with two row planes.
public const MaximumExplorationMapWidth: integer := 240;
public const MaximumExplorationMapHeight: integer := 120;
// Symmetric wire bound that keeps origin-plus-dimension arithmetic inside the integer domain.
public const MaximumExplorationMapOriginMagnitude: integer := 1000000000;
// Defensive bounds for client-safe inventory summaries in visible-state messages.
public const MaximumVisibleInventoryItems: integer := 64;
public const MaximumVisibleInventoryTextLength: integer := 128;
// Defensive bounds for the character's health and one turn's combat messages.
public const MaximumVisibleHealth: integer := 999;
public const MaximumCombatLogEntries: integer := 8;
public const MaximumCombatLogTextLength: integer := 160;
// Defensive bounds for one turn's structured combat events and their damage amounts.
public const MaximumCombatEvents: integer := 8;
public const MaximumCombatEventAmount: integer := 999;
// Defensive bound on the levels of one dungeon; equals the server's map validation bound.
public const MaximumDungeonDepth: integer := 16;
// Defensive bounds for the server-formatted character sheet lines.
public const MaximumCharacterValues: integer := 8;
public const MaximumCharacterTextLength: integer := 64;
// Maximum server-authored journal lines and printable ASCII characters per line.
public const MaximumJournalLines: integer := 8;
public const MaximumJournalTextLength: integer := 160;
// Bounded conversation payloads and map labels; response envelopes retain one reply per request.
public const MaximumDialogueChoices: integer := 6;
public const MaximumDialogueIdLength: integer := 160;
public const MaximumDialogueTextLength: integer := 4096;
public const MaximumDialogueChoiceTextLength: integer := 160;
public const MaximumDialogueSpeakerLength: integer := 64;
public const MaximumMapTitleLength: integer := 64;
public const MaximumMapStatusLength: integer := 256;
// One-character wire alphabet for visible-state and exploration-map rows. Dungeon.Terrain
// and Dungeon.Interior produce these codes; the server contract test keeps both aligned.
// Field whose content is undiscovered in both map and interior rows.
public const UnknownFieldCode: string := '?';
// Outdoor map rows.
public const MapGrassCode: string := 'g';
public const MapTreeCode: string := 't';
public const MapForestCode: string := 'f';
public const MapDesertCode: string := 'd';
public const MapMountainCode: string := 'm';
public const MapSeaCode: string := 'o';
public const MapRiverCode: string := 'r';
public const MapLakeCode: string := 'l';
public const MapPathCode: string := 'p';
public const MapEntranceCode: string := 'e';
// Walkable outdoor gate leading to its authored or generated settlement.
public const MapSettlementGateCode: string := 's';
// A currently visible settlement NPC; never a remembered map field.
public const MapNpcCode: string := 'n';
// First-person and interior map rows; item codes appear only in currently visible fields.
public const InteriorWallCode: string := '#';
public const InteriorFloorCode: string := '.';
public const InteriorExitCode: string := 'x';
// Walkable stairs between dungeon levels.
public const InteriorStairsUpCode: string := '<';
public const InteriorStairsDownCode: string := '>';
public const InteriorItemCode: string := 'i';
// Weapon and armor lying on a visible interior field.
public const InteriorWeaponCode: string := 'w';
public const InteriorArmorCode: string := 'a';
// A healing potion lying on a currently visible interior floor field.
public const InteriorPotionCode: string := 'p';
// A standing opponent appears only in currently visible fields.
public const InteriorHostileCode: string := 'h';
// A currently visible giant rat; outdoor river codes are a separate alphabet.
public const InteriorRatCode: string := 'r';
// Knowledge rows: undiscovered, remembered, or currently visible.
public const KnowledgeUndiscoveredCode: string := 'u';
public const KnowledgeRememberedCode: string := 'r';
public const KnowledgeVisibleCode: string := 'v';

// Selects the renderer the client must use for a visible state.
public type ViewKind = enum
  Map;
  FirstPerson;
end enum;

// Cardinal player orientation carried by a first-person visible state.
public type FirstPersonFacing = enum
  North;
  East;
  South;
  West;
end enum;

// Relative one-field first-person translation requested by the client.
public type FirstPersonStepDirection = enum
  Forward;
  Backward;
  Left;
  Right;
end enum;

// Relative 90-degree first-person rotation requested by the client.
public type FirstPersonTurnDirection = enum
  Left;
  Right;
end enum;

// Slot in which an inventory item can be worn; NoSlot marks items that cannot be worn.
public type VisibleItemSlot = enum
  NoSlot;
  Weapon;
  Body;
end enum;

// Client-safe identity, display name, wear state and use capability of one inventory item.
public type VisibleInventoryItem = record
  public Id: string;
  public Name: string;
  public Slot: VisibleItemSlot;
  // True while the item is worn; only items with a slot can be worn.
  public Equipped: boolean;
  // Kind capability, independent of current health; a usable item has no slot and is not worn.
  public Usable: boolean;
end record;

// One server-formatted character sheet line such as `Damage`, `d6+1`, `Rusty short sword`.
public type VisibleCharacterValue = record
  public Label: string;
  public Value: string;
  public Source: string;
end record;

// Kind of one structured fact of the resolved turn.
public type VisibleCombatEventKind = enum
  PlayerHit;
  PlayerMiss;
  HostileHit;
  HostileMiss;
  HostileDefeated;
end enum;

// One structured fact of the resolved turn; Amount is the damage of a hit, otherwise zero.
public type VisibleCombatEvent = record
  public Kind: VisibleCombatEventKind;
  public Amount: integer;
  // Target for player hit/miss/defeat, actor for hostile hit/miss; h or r only.
  public HostileCode: string;
end record;

// Client-safe map projection; dimensions, rows, and player coordinates must agree.
public type MapVisibleState = record
  // Server-projected area label and interaction hint; empty is valid when no label or action is supplied.
  public Title: string := '';
  public Status: string := '';
  public OriginX: integer;
  public OriginY: integer;
  public Width: integer;
  public Height: integer;
  public Rows: array of string;
  // One u, r, or v code per terrain field: undiscovered, remembered, or visible.
  public KnowledgeRows: array of string;
  public PlayerX: integer;
  public PlayerY: integer;
  public WorldX: integer;
  public WorldY: integer;
  // Bounded carried-item summaries; IDs are unique and names are display-only.
  public Inventory: array of VisibleInventoryItem;
  // Current and full character health; 1 <= Health <= MaxHealth <= MaximumVisibleHealth.
  public Health: integer;
  public MaxHealth: integer;
  // Separate currency; no inventory entry duplicates this balance.
  public Coins: integer;
  // Character sheet lines in display order.
  public Character: array of VisibleCharacterValue;
  // Complete read-only journal, formatted by the server without hidden map coordinates.
  public Journal: array of string;
end record;

// Client-safe bounded interior geometry and pose used by the first-person renderer.
public type FirstPersonVisibleState = record
  public Title: string;
  public Status: string;
  // Zero-based current level and the dungeon depth; 0 <= Level < Depth <= MaximumDungeonDepth.
  public Level: integer;
  public Depth: integer;
  public Width: integer;
  public Height: integer;
  public Rows: array of string;
  // One u, r, or v code per geometry field: undiscovered, remembered, or visible.
  public KnowledgeRows: array of string;
  public PlayerX: integer;
  public PlayerY: integer;
  public Facing: FirstPersonFacing;
  // Bounded carried-item summaries; IDs are unique and names are display-only.
  public Inventory: array of VisibleInventoryItem;
  // Current and full character health; 1 <= Health <= MaxHealth <= MaximumVisibleHealth.
  public Health: integer;
  public MaxHealth: integer;
  // Separate currency; no inventory entry duplicates this balance.
  public Coins: integer;
  // Character sheet lines in display order.
  public Character: array of VisibleCharacterValue;
  // Complete read-only journal, formatted by the server without hidden map coordinates.
  public Journal: array of string;
  // Messages of the turn that produced this state, oldest first; empty without combat.
  public CombatLog: array of string;
  // Structured facts of the same turn in order; presentation only.
  public CombatEvents: array of VisibleCombatEvent;
end record;

// View-specific server projection; map-only fields cannot occur in a first-person state.
public type VisibleState = enum
  MapState(Value: MapVisibleState);
  FirstPersonState(Value: FirstPersonVisibleState);
end enum;

// Ordered server-authored dialogue choice; the client displays it and returns its identity unchanged.
public type DialogueChoice = record
  public Id: string;
  public Text: string;
end record;

// Bounded conversation projection; no choice availability or game rules are evaluated by the client.
public type DialogueFrame = record
  public NpcId: string;
  public Speaker: string;
  public Text: string;
  public Choices: array of DialogueChoice;
end record;

// One independently paged list in a trade window.
public type TradeSide = enum
  Buy;
  Sell;
end enum;

// Bounded exact item capability; absent prices are allowed only on disabled rows.
public type TradeItem = record
  public Id: string;
  public Name: string;
  public Price: option of integer;
  public Enabled: boolean;
  public Reason: string;
end record;

// One authoritative quote revision; wallet is supplied only by the accompanying visible state.
public type TradeQuote = record
  public NpcId: string;
  public Speaker: string;
  public Revision: integer;
  public MerchantCapacity: integer;
  public BuyPage: integer;
  public SellPage: integer;
  public BuyTotal: integer;
  public SellTotal: integer;
  public BuyItems: array of TradeItem;
  public SellItems: array of TradeItem;
end record;

// Client-safe current-area map window; u fields must contain ? and dimensions match both row planes.
public type ExplorationMapState = record
  public View: ViewKind;
  public LabelText: string;
  public OriginX: integer;
  public OriginY: integer;
  public Width: integer;
  public Height: integer;
  public Rows: array of string;
  public KnowledgeRows: array of string;
  public PlayerWorldX: integer;
  public PlayerWorldY: integer;
  public PlayerInWindow: boolean;
end record;

// Client-safe world metadata and classified save availability; no geometry is exposed.
public type WorldSummary = record
  public Id: string;
  public Seed: integer;
  public RegionChunks: integer;
  public Status: string;
  public SaveStatus: string;
  public Reason: string;
end record;

// One stable page plus current defaults/ranges and server-selected identity.
public type WorldCatalog = record
  public Worlds: array of WorldSummary;
  public SelectedId: string;
  public SelectionReason: string;
  public Offset: integer;
  public Total: integer;
  public DefaultSeed: integer;
  public MinimumSeed: integer;
  public MaximumSeed: integer;
  public DefaultRegionChunks: integer;
  public MinimumRegionChunks: integer;
  public MaximumRegionChunks: integer;
end record;

// Session setup, player intentions, and lifecycle messages accepted by the server.
public type ClientMessage = enum
  Hello(Version: integer; ViewWidth: integer; ViewHeight: integer);
  StartNewGame;
  LoadGame;
  SaveGame;
  // Explicit permission to replace the selected world's existing save.
  OverwriteSaveGame;
  // Return to selection; Discard authorizes abandoning unsaved state.
  ListWorlds(Offset: integer; DiscardProgress: boolean);
  // Prepares an existing world before installing it; allowed only outside active play.
  SelectWorld(Id: string);
  // Server allocates the identity and starts fresh play using validated parameters.
  CreateWorld(Seed: integer; RegionChunks: integer);
  Viewport(Width: integer; Height: integer);
  // Requests a read-only current-area map window; this never changes discovery or player state.
  ExplorationMap(OriginX: integer; OriginY: integer; Width: integer; Height: integer);
  Move(DeltaX: integer; DeltaY: integer);
  StepFirstPerson(Direction: FirstPersonStepDirection);
  TurnFirstPerson(Direction: FirstPersonTurnDirection);
  // Requests server-side interaction with the current field or field directly ahead.
  Interact;
  // Selects one choice from the current authoritative conversation frame.
  DialogueChoice(NpcId: string; ChoiceId: string);
  // Explicitly closes the active conversation without saving it.
  EndDialogue;
  // Exact one-item intentions bound to the current merchant, page and quote revision.
  TradeBuy(NpcId: string; ItemId: string; Revision: integer);
  TradeSell(NpcId: string; ItemId: string; Revision: integer);
  // Read-only page/refresh; the response issues a fresh revision.
  TradePage(NpcId: string; Side: TradeSide; Page: integer);
  // Returns to the merchant's root conversation.
  EndTrade(NpcId: string);
  // Attacks the field directly ahead; consumes one combat turn.
  Attack;
  // Passes one combat turn without acting.
  Wait;
  // Wears one carried item; consumes one turn.
  Equip(ItemId: string);
  // Returns one worn item to the inventory; consumes one turn.
  Unequip(ItemId: string);
  // Lays one carried item on the occupied dungeon floor field; consumes one turn.
  DropItem(ItemId: string);
  // Uses one carried consumable by identity; the server determines healing and the resulting turn.
  UseItem(ItemId: string);
  Disconnect;
end enum;

// Handshake, including save availability/removal, visible state, and structured outcomes.
public type ServerMessage = enum
  Welcome(Version: integer; Catalog: WorldCatalog);
  Worlds(Catalog: WorldCatalog);
  State(Value: VisibleState);
  ExplorationMap(Value: ExplorationMapState);
  // Read-only result; nonempty title opens a description, empty title denotes status feedback.
  Interaction(Title: string; Message: string);
  // Atomic response with the current state and the replacement conversation frame.
  Dialogue(State: VisibleState; Frame: DialogueFrame; Dirty: boolean);
  // Atomic end acknowledgement with the current state, including any completed healing.
  DialogueEnded(State: VisibleState; Dirty: boolean);
  // Complete state, current quote and actual unsaved-progress status are installed atomically.
  Trade(State: VisibleState; Quote: TradeQuote; Dirty: boolean);
  SaveCompleted;
  // Replaces the state response of the turn in which the character fell; the session has ended.
  Defeated(Message: string);
  Rejected(Code: string; Message: string);
  ErrorMessage(Code: string; Message: string);
end enum;

// Returns whether one character belongs to the outdoor map-row alphabet, including UnknownFieldCode.
public function IsMapCellCode(Value: string): boolean;
begin
  return Value in
    [
      UnknownFieldCode,
      MapGrassCode,
      MapTreeCode,
      MapForestCode,
      MapDesertCode,
      MapMountainCode,
      MapSeaCode,
      MapRiverCode,
      MapLakeCode,
      MapPathCode,
      MapEntranceCode,
      MapSettlementGateCode, MapNpcCode, InteriorWallCode, InteriorFloorCode, InteriorExitCode
    ];
end function;

// Returns whether one character belongs to the interior-row alphabet, including UnknownFieldCode.
public function IsInteriorCellCode(Value: string): boolean;
begin
  return Value in
    [
      UnknownFieldCode,
      InteriorWallCode,
      InteriorFloorCode,
      InteriorExitCode,
      InteriorStairsUpCode,
      InteriorStairsDownCode,
      InteriorItemCode,
      InteriorWeaponCode,
      InteriorArmorCode,
      InteriorPotionCode,
      InteriorHostileCode,
      InteriorRatCode
    ];
end function;

// Returns whether a current interior marker represents an item on the floor.
public function IsInteriorItemCode(Value: string): boolean;
begin
  return Value in [InteriorItemCode, InteriorWeaponCode, InteriorArmorCode, InteriorPotionCode];
end function;

// Returns whether a current interior marker represents a supported opponent.
public function IsHostileCode(Value: string): boolean;
begin
  return Value in [InteriorHostileCode, InteriorRatCode];
end function;

// Returns the renderer family selected by a view-specific visible state.
public function ViewForVisibleState(Value: VisibleState): ViewKind;
begin
  case Value of
    when VisibleState.MapState(const MapValue):
      begin
        return ViewKind.Map;
      end;
    when VisibleState.FirstPersonState(const FirstPersonValue):
      begin
        return ViewKind.FirstPerson;
      end;
  end case;
end function;
end unit;
