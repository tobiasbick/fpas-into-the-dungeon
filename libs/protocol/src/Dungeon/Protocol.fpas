      return 'east'
    end;
    FirstPersonFacing.South:
    begin
      return 'south'
    end;
    FirstPersonFacing.West:
    begin
      return 'west'
    end
  end
end;

function DecodeFirstPersonFacing(Value: string): result of FirstPersonFacing, string;
begin
  case Value of
    'north':
    begin
      return Ok(FirstPersonFacing.North)
    end;
    'east':
    begin
      return Ok(FirstPersonFacing.East)
    end;
    'south':
    begin
      return Ok(FirstPersonFacing.South)
    end;
    'west':
    begin
      return Ok(FirstPersonFacing.West)
    end
    else
    begin
      return Error('unknown first-person facing direction')
    end
  end
end;

