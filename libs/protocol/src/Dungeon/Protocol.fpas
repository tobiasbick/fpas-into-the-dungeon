// Versioned JSON message contract shared by the client and server.
unit Dungeon.Protocol;

uses Std.Arrays, Std.Conv, Std.Dictionaries, Std.Json, Std.Math, Std.Options, Std.Str;

public const
  // Wire compatibility version required during the hello/welcome handshake.
  ProtocolVersion: integer := 5;
  // Maximum UTF-8 payload before the terminating line feed.
  MaximumLineBytes: integer := 65536;

public type
  // Selects the renderer the client must use for a visible state.
  ViewKind = enum
    Map;
    FirstPerson;
  end;
  // Cardinal player orientation carried by a first-person visible state.
  FirstPersonFacing = enum
    North;
    East;
    South;
    West;
  end;
  // Relative one-field first-person translation requested by the client.
  FirstPersonStepDirection = enum
    Forward;
    Backward;
    Left;
    Right;
  end;
  // Relative 90-degree first-person rotation requested by the client.
  FirstPersonTurnDirection = enum
    Left;
    Right;
  end;
  // Client-safe map projection; dimensions, rows, and player coordinates must agree.
  MapVisibleState = record
    public OriginX: integer;
    public OriginY: integer;
    public Width: integer;
    public Height: integer;
    public Rows: array of string;
    public PlayerX: integer;
    public PlayerY: integer;
    public WorldX: integer;
    public WorldY: integer;
  end;
  // Client-safe bounded interior geometry and pose used by the first-person renderer.
  FirstPersonVisibleState = record
    public Title: string;
    public Status: string;
    public Width: integer;
    public Height: integer;
    public Rows: array of string;
    public PlayerX: integer;
    public PlayerY: integer;
    public Facing: FirstPersonFacing;
  end;
  // View-specific server projection; map-only fields cannot occur in a first-person state.
  VisibleState = enum
    MapState(Value: MapVisibleState);
    FirstPersonState(Value: FirstPersonVisibleState);
  end;
  // Session setup, player intentions, and lifecycle messages accepted by the server.
  ClientMessage = enum
    Hello(Version: integer; ViewWidth: integer; ViewHeight: integer);
    StartNewGame;
    LoadGame;
    SaveGame;
    Viewport(Width: integer; Height: integer);
    Move(DeltaX: integer; DeltaY: integer);
    StepFirstPerson(Direction: FirstPersonStepDirection);
    TurnFirstPerson(Direction: FirstPersonTurnDirection);
    ActivateAreaTransition;
    Disconnect;
  end;
  // Handshake, including save availability/removal, visible state, and structured outcomes.
  ServerMessage = enum
    Welcome(Version: integer; SaveAvailable: boolean; InvalidSaveRemoved: boolean);
    State(Value: VisibleState);
    SaveCompleted;
    Rejected(Code: string; Message: string);
    ErrorMessage(Code: string; Message: string);
  end;

function RequiredField(Fields: dict of string to JsonValue; Name: string): result of JsonValue, string;
begin
  case Std.Dictionaries.Get(Fields, Name) of
    Some(Value):
    begin
      return Ok(Value)
    end;
    None:
    begin
      return Error('message is missing field ' + Name)
    end
  end
end;

function ViewName(Value: ViewKind): string;
begin
  case Value of
    ViewKind.Map:
    begin
      return 'map'
    end;
    ViewKind.FirstPerson:
    begin
      return 'first_person'
    end
  end
end;

function DecodeView(Value: string): result of ViewKind, string;
begin
  case Value of
    'map':
    begin
      return Ok(ViewKind.Map)
    end;
    'first_person':
    begin
      return Ok(ViewKind.FirstPerson)
    end
    else
    begin
      return Error('unknown visible-state view')
    end
  end
end;

function FirstPersonFacingName(Value: FirstPersonFacing): string;
begin
  case Value of
    FirstPersonFacing.North:
    begin
      return 'north'
    end;
    FirstPersonFacing.East:
    begin
      return 'east'
    end;
    FirstPersonFacing.South:
    begin
      return 'south'
    end;
    FirstPersonFacing.West:
    begin
      return 'west'
    end
  end
end;

function DecodeFirstPersonFacing(Value: string): result of FirstPersonFacing, string;
begin
  case Value of
    'north':
    begin
      return Ok(FirstPersonFacing.North)
    end;
    'east':
    begin
      return Ok(FirstPersonFacing.East)
    end;
    'south':
    begin
      return Ok(FirstPersonFacing.South)
    end;
    'west':
    begin
      return Ok(FirstPersonFacing.West)
    end
    else
    begin
      return Error('unknown first-person facing direction')
    end
  end
end;

function FirstPersonStepName(Value: FirstPersonStepDirection): string;
begin
  case Value of
    FirstPersonStepDirection.Forward:
    begin
      return 'forward'
    end;
    FirstPersonStepDirection.Backward:
    begin
      return 'backward'
    end;
    FirstPersonStepDirection.Left:
    begin
      return 'left'
    end;
    FirstPersonStepDirection.Right:
    begin
      return 'right'
    end
  end
end;

function DecodeFirstPersonStep(Value: string): result of FirstPersonStepDirection, string;
begin
  case Value of
    'forward':
    begin
      return Ok(FirstPersonStepDirection.Forward)
    end;
    'backward':
    begin
      return Ok(FirstPersonStepDirection.Backward)
    end;
    'left':
    begin
      return Ok(FirstPersonStepDirection.Left)
    end;
    'right':
    begin
      return Ok(FirstPersonStepDirection.Right)
    end
    else
    begin
      return Error('unknown first-person step direction')
    end
  end
end;

function FirstPersonTurnName(Value: FirstPersonTurnDirection): string;
begin
  case Value of
    FirstPersonTurnDirection.Left:
    begin
      return 'left'
    end;
    FirstPersonTurnDirection.Right:
    begin
      return 'right'
    end
  end
end;

function DecodeFirstPersonTurn(Value: string): result of FirstPersonTurnDirection, string;
begin
  case Value of
    'left':
    begin
      return Ok(FirstPersonTurnDirection.Left)
    end;
    'right':
    begin
      return Ok(FirstPersonTurnDirection.Right)
    end
    else
    begin
      return Error('unknown first-person turn direction')
    end
  end
end;

function IsVisibleCellCode(Value: string): boolean;
begin
  case Value of
    'g':
    begin
      return true
    end;
    't':
    begin
      return true
    end;
    'f':
    begin
      return true
    end;
    'd':
    begin
      return true
    end;
    'm':
    begin
      return true
    end;
    'o':
    begin
      return true
    end;
    'r':
    begin
      return true
    end;
    'l':
    begin
      return true
    end;
    'p':
    begin
      return true
    end;
    'e':
    begin
      return true
    end
    else
    begin
      return false
    end
  end
end;

function IsFirstPersonCellCode(Value: string): boolean;
begin
  return (Value = '#') or ((Value = '.') or (Value = 'x'))
end;

function EncodeRows(Rows: array of string): array of JsonValue;
begin
  mutable var Values: array of JsonValue := [];
  for Row: string in Rows do
  begin
    Values := Std.Arrays.Concat(Values, [JsonValue.String(Row)])
  end;

  return Values
end;

function StringArrayField(Fields: dict of string to JsonValue; Name: string): result of array of string, string;
begin
  case try RequiredField(Fields, Name) of
    JsonValue.ArrayValue(Items):
    begin
      mutable var Values: array of string := [];
      for Item: JsonValue in Items do
      begin
        case Item of
          JsonValue.String(Value):
          begin
            Values := Std.Arrays.Concat(Values, [Value])
          end
          else
          begin
            return Error(('message field ' + Name) + ' must contain only strings')
          end
        end
      end;

      return Ok(Values)
    end
    else
    begin
      return Error(('message field ' + Name) + ' must be an array')
    end
  end
end;

function ValidateMapVisibleState(Value: MapVisibleState): result of MapVisibleState, string;
begin
  if (Value.Width <= 0) or (Value.Height <= 0) then
  begin
    return Error('visible-state dimensions must be positive')
  end;

  if Std.Arrays.Length(Value.Rows) <> Value.Height then
  begin
    return Error('visible-state row count must match height')
  end;

  for Row: string in Value.Rows do
  begin
    if Std.Str.Length(Row) <> Value.Width then
    begin
      return Error('visible-state row width must match width')
    end;

    for Index: integer := 0 to Std.Str.Length(Row) - 1 do
    begin
      var Code: string := Std.Str.CharAt(Row, Index);
      if not IsVisibleCellCode(Code) then
      begin
        return Error('visible-state row contains an unknown cell code')
      end
    end
  end;

  if (((Value.PlayerX < 0) or (Value.PlayerX >= Value.Width)) or (Value.PlayerY < 0)) or
     (Value.PlayerY >= Value.Height) then
  begin
    return Error('visible-state player position is outside the area')
  end;

  if (Value.OriginX + Value.PlayerX <> Value.WorldX) or
     (Value.OriginY + Value.PlayerY <> Value.WorldY) then
  begin
    return Error('visible-state local and world player positions disagree')
  end;

  return Ok(Value)
end;

function ValidateFirstPersonVisibleState(Value: FirstPersonVisibleState): result of FirstPersonVisibleState, string;
begin
  if Std.Str.Length(Value.Title) = 0 then
  begin
    return Error('first-person state title must not be empty')
  end;

  if Std.Str.Length(Value.Status) = 0 then
  begin
    return Error('first-person state status must not be empty')
  end;

  if (Value.Width <= 0) or (Value.Height <= 0) then
  begin
    return Error('first-person dimensions must be positive')
  end;

  if Std.Arrays.Length(Value.Rows) <> Value.Height then
  begin
    return Error('first-person row count must match height')
  end;
  mutable var ExitCount: integer := 0;
  for Row: string in Value.Rows do
  begin
    if Std.Str.Length(Row) <> Value.Width then
    begin
      return Error('first-person row width must match width')
    end;

    for Index: integer := 0 to Std.Str.Length(Row) - 1 do
    begin
      var Code: string := Std.Str.CharAt(Row, Index);
      if not IsFirstPersonCellCode(Code) then
      begin
        return Error('first-person row contains an unknown field code')
      end;

      if Code = 'x' then
      begin
        ExitCount := ExitCount + 1
      end
    end
  end;

  if ExitCount <> 1 then
  begin
    return Error('first-person state must contain exactly one exit field')
  end;

  if (((Value.PlayerX < 0) or (Value.PlayerX >= Value.Width)) or (Value.PlayerY < 0)) or
     (Value.PlayerY >= Value.Height) then
  begin
    return Error('first-person player position is outside the area')
  end;

  if Std.Str.CharAt(Value.Rows[Value.PlayerY], Value.PlayerX) = '#' then
  begin
    return Error('first-person player position must be traversable')
  end;

  return Ok(Value)
end;

// Returns the renderer family selected by a view-specific visible state.
public function ViewForVisibleState(Value: VisibleState): ViewKind;
begin
  case Value of
    VisibleState.MapState(MapValue):
    begin
      return ViewKind.Map
    end;
    VisibleState.FirstPersonState(FirstPersonValue):
    begin
      return ViewKind.FirstPerson
    end
  end
end;

function StringField(Fields: dict of string to JsonValue; Name: string): result of string, string;
begin
  case try RequiredField(Fields, Name) of
    JsonValue.String(Value):
    begin
      return Ok(Value)
    end
    else
    begin
      return Error(('message field ' + Name) + ' must be a string')
    end
  end
end;

function IntegerField(Fields: dict of string to JsonValue; Name: string): result of integer, string;
begin
  case try RequiredField(Fields, Name) of
    JsonValue.Number(Value):
    begin
      var IntegerValue: integer := Trunc(Value);
      if IntToReal(IntegerValue) <> Value then
      begin
        return Error(('message field ' + Name) + ' must be an integer')
      end;

      return Ok(IntegerValue)
    end
    else
    begin
      return Error(('message field ' + Name) + ' must be a number')
    end
  end
end;

function BooleanField(Fields: dict of string to JsonValue; Name: string): result of boolean, string;
begin
  case try RequiredField(Fields, Name) of
    JsonValue.Bool(Value):
    begin
      return Ok(Value)
    end
    else
    begin
      return Error(('message field ' + Name) + ' must be a boolean')
    end
  end
end;

function ObjectFields(Text: string): result of dict of string to JsonValue, string;
begin
  case try Std.Json.Parse(Text) of
    JsonValue.Object(Fields):
    begin
      return Ok(Fields)
    end
    else
    begin
      return Error('message root must be an object')
    end
  end
end;

// Encodes one client message as a compact JSON object for line transport.
public function EncodeClient(Message: ClientMessage): string;
begin
  case Message of
    ClientMessage.Hello(Version, ViewWidth, ViewHeight):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('hello'), 'version': JsonValue.Number(IntToReal(Version)), 'width': JsonValue.Number(IntToReal(ViewWidth)), 'height': JsonValue.Number(IntToReal(ViewHeight))]))
    end;
    ClientMessage.StartNewGame:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('new_game')]))
    end;
    ClientMessage.LoadGame:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('load_game')]))
    end;
    ClientMessage.SaveGame:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('save_game')]))
    end;
    ClientMessage.Viewport(Width, Height):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('viewport'), 'width': JsonValue.Number(IntToReal(Width)), 'height': JsonValue.Number(IntToReal(Height))]))
    end;
    ClientMessage.Move(DeltaX, DeltaY):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('move'), 'dx': JsonValue.Number(IntToReal(DeltaX)), 'dy': JsonValue.Number(IntToReal(DeltaY))]))
    end;
    ClientMessage.StepFirstPerson(Direction):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('first_person_step'), 'direction': JsonValue.String(FirstPersonStepName(Direction))]))
    end;
    ClientMessage.TurnFirstPerson(Direction):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('first_person_turn'), 'direction': JsonValue.String(FirstPersonTurnName(Direction))]))
    end;
    ClientMessage.ActivateAreaTransition:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('activate_area_transition')]))
    end;
    ClientMessage.Disconnect:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('disconnect')]))
    end
  end
end;

// Decodes one client message and rejects missing, mistyped, or unknown fields.
public function DecodeClient(Text: string): result of ClientMessage, string;
begin
  var Fields: dict of string to JsonValue := try ObjectFields(Text);
  case try StringField(Fields, 'type') of
    'hello':
    begin
      if Std.Dictionaries.Length(Fields) <> 4 then
      begin
        return Error('hello must contain only type, version, width, and height')
      end;

      return Ok(ClientMessage.Hello(try IntegerField(Fields, 'version'), try IntegerField(Fields, 'width'), try IntegerField(Fields, 'height')))
    end;
    'new_game':
    begin
      if Std.Dictionaries.Length(Fields) <> 1 then
      begin
        return Error('new_game must not contain additional fields')
      end;

      return Ok(ClientMessage.StartNewGame)
    end;
    'load_game':
    begin
      if Std.Dictionaries.Length(Fields) <> 1 then
      begin
        return Error('load_game must not contain additional fields')
      end;

      return Ok(ClientMessage.LoadGame)
    end;
    'save_game':
    begin
      if Std.Dictionaries.Length(Fields) <> 1 then
      begin
        return Error('save_game must not contain additional fields')
      end;

      return Ok(ClientMessage.SaveGame)
    end;
    'viewport':
    begin
      if Std.Dictionaries.Length(Fields) <> 3 then
      begin
        return Error('viewport must contain only type, width, and height')
      end;

      return Ok(ClientMessage.Viewport(try IntegerField(Fields, 'width'), try IntegerField(Fields, 'height')))
    end;
    'move':
    begin
      if Std.Dictionaries.Length(Fields) <> 3 then
      begin
        return Error('move must contain only type, dx, and dy')
      end;

      return Ok(ClientMessage.Move(try IntegerField(Fields, 'dx'), try IntegerField(Fields, 'dy')))
    end;
    'first_person_step':
    begin
      if Std.Dictionaries.Length(Fields) <> 2 then
      begin
        return Error('first_person_step must contain only type and direction')
      end;

      return Ok(ClientMessage.StepFirstPerson(try DecodeFirstPersonStep(try StringField(Fields, 'direction'))))
    end;
    'first_person_turn':
    begin
      if Std.Dictionaries.Length(Fields) <> 2 then
      begin
        return Error('first_person_turn must contain only type and direction')
      end;

      return Ok(ClientMessage.TurnFirstPerson(try DecodeFirstPersonTurn(try StringField(Fields, 'direction'))))
    end;
    'activate_area_transition':
    begin
      if Std.Dictionaries.Length(Fields) <> 1 then
      begin
        return Error('activate_area_transition must not contain additional fields')
      end;

      return Ok(ClientMessage.ActivateAreaTransition)
    end;
    'disconnect':
    begin
      if Std.Dictionaries.Length(Fields) <> 1 then
      begin
        return Error('disconnect must not contain additional fields')
      end;

      return Ok(ClientMessage.Disconnect)
    end
    else
    begin
      return Error('unknown client message type')
    end
  end
end;

// Encodes one server message as a compact JSON object for line transport.
public function EncodeServer(Message: ServerMessage): string;
begin
  case Message of
    ServerMessage.Welcome(Version, SaveAvailable, InvalidSaveRemoved):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('welcome'), 'version': JsonValue.Number(IntToReal(Version)), 'save_available': JsonValue.Bool(SaveAvailable), 'invalid_save_removed': JsonValue.Bool(InvalidSaveRemoved)]))
    end;
    ServerMessage.State(Value):
    begin
      case Value of
        VisibleState.MapState(MapValue):
        begin
          return Stringify(JsonValue.Object(['type': JsonValue.String('state'), 'view': JsonValue.String(ViewName(ViewKind.Map)), 'origin_x': JsonValue.Number(IntToReal(MapValue.OriginX)), 'origin_y': JsonValue.Number(IntToReal(MapValue.OriginY)), 'width': JsonValue.Number(IntToReal(MapValue.Width)), 'height': JsonValue.Number(IntToReal(MapValue.Height)), 'rows': JsonValue.ArrayValue(EncodeRows(MapValue.Rows)), 'x': JsonValue.Number(IntToReal(MapValue.PlayerX)), 'y': JsonValue.Number(IntToReal(MapValue.PlayerY)), 'world_x': JsonValue.Number(IntToReal(MapValue.WorldX)), 'world_y': JsonValue.Number(IntToReal(MapValue.WorldY))]))
        end;
        VisibleState.FirstPersonState(FirstPersonValue):
        begin
          return Stringify(JsonValue.Object(['type': JsonValue.String('state'), 'view': JsonValue.String(ViewName(ViewKind.FirstPerson)), 'title': JsonValue.String(FirstPersonValue.Title), 'status': JsonValue.String(FirstPersonValue.Status), 'width': JsonValue.Number(IntToReal(FirstPersonValue.Width)), 'height': JsonValue.Number(IntToReal(FirstPersonValue.Height)), 'rows': JsonValue.ArrayValue(EncodeRows(FirstPersonValue.Rows)), 'x': JsonValue.Number(IntToReal(FirstPersonValue.PlayerX)), 'y': JsonValue.Number(IntToReal(FirstPersonValue.PlayerY)), 'facing': JsonValue.String(FirstPersonFacingName(FirstPersonValue.Facing))]))
        end
      end
    end;
    ServerMessage.SaveCompleted:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('save_completed')]))
    end;
    ServerMessage.Rejected(Code, MessageText):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('rejected'), 'code': JsonValue.String(Code), 'message': JsonValue.String(MessageText)]))
    end;
    ServerMessage.ErrorMessage(Code, MessageText):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('error'), 'code': JsonValue.String(Code), 'message': JsonValue.String(MessageText)]))
    end
  end
end;

// Decodes one server message and validates visible-state dimensions and coordinates.
public function DecodeServer(Text: string): result of ServerMessage, string;
begin
  var Fields: dict of string to JsonValue := try ObjectFields(Text);
  case try StringField(Fields, 'type') of
    'welcome':
    begin
      if Std.Dictionaries.Length(Fields) <> 4 then
      begin
        return Error('welcome must contain only type, version, save_available, and invalid_save_removed')
      end;

      return Ok(ServerMessage.Welcome(try IntegerField(Fields, 'version'), try BooleanField(Fields, 'save_available'), try BooleanField(Fields, 'invalid_save_removed')))
    end;
    'save_completed':
    begin
      if Std.Dictionaries.Length(Fields) <> 1 then
      begin
        return Error('save_completed must not contain additional fields')
      end;

      return Ok(ServerMessage.SaveCompleted)
    end;
    'state':
    begin
      case try DecodeView(try StringField(Fields, 'view')) of
        ViewKind.Map:
        begin
          var MapValue: MapVisibleState := record
            OriginX := try IntegerField(Fields, 'origin_x');
            OriginY := try IntegerField(Fields, 'origin_y');
            Width := try IntegerField(Fields, 'width');
            Height := try IntegerField(Fields, 'height');
            Rows := try StringArrayField(Fields, 'rows');
            PlayerX := try IntegerField(Fields, 'x');
            PlayerY := try IntegerField(Fields, 'y');
            WorldX := try IntegerField(Fields, 'world_x');
            WorldY := try IntegerField(Fields, 'world_y');
          end;

          return Ok(ServerMessage.State(VisibleState.MapState(try ValidateMapVisibleState(MapValue))))
        end;
        ViewKind.FirstPerson:
        begin
          if Std.Dictionaries.Length(Fields) <> 10 then
          begin
            return Error('first-person state has an unexpected field set')
          end;
          var FirstPersonValue: FirstPersonVisibleState := record
            Title := try StringField(Fields, 'title');
            Status := try StringField(Fields, 'status');
            Width := try IntegerField(Fields, 'width');
            Height := try IntegerField(Fields, 'height');
            Rows := try StringArrayField(Fields, 'rows');
            PlayerX := try IntegerField(Fields, 'x');
            PlayerY := try IntegerField(Fields, 'y');
            Facing := try DecodeFirstPersonFacing(try StringField(Fields, 'facing'));
          end;

          return Ok(ServerMessage.State(VisibleState.FirstPersonState(try ValidateFirstPersonVisibleState(FirstPersonValue))))
        end
      end
    end;
    'rejected':
    begin
      if Std.Dictionaries.Length(Fields) <> 3 then
      begin
        return Error('rejected must contain only type, code, and message')
      end;

      return Ok(ServerMessage.Rejected(try StringField(Fields, 'code'), try StringField(Fields, 'message')))
    end;
    'error':
    begin
      if Std.Dictionaries.Length(Fields) <> 3 then
      begin
        return Error('error must contain only type, code, and message')
      end;

      return Ok(ServerMessage.ErrorMessage(try StringField(Fields, 'code'), try StringField(Fields, 'message')))
    end
    else
    begin
      return Error('unknown server message type')
    end
  end
end;
