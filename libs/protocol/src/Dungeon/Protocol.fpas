    VisibleCombatEventKind.PlayerMiss:
    begin
      return 'player_miss'
    end;
    VisibleCombatEventKind.HostileHit:
    begin
      return 'hostile_hit'
    end;
    VisibleCombatEventKind.HostileMiss:
    begin
      return 'hostile_miss'
    end;
    VisibleCombatEventKind.HostileDefeated:
    begin
      return 'hostile_defeated'
    end
  end
end;

function DecodeCombatEventKind(Value: string): result of VisibleCombatEventKind, string;
begin
  case Value of
    'player_hit':
    begin
      return Ok(VisibleCombatEventKind.PlayerHit)
    end;
    'player_miss':
    begin
      return Ok(VisibleCombatEventKind.PlayerMiss)
    end;
    'hostile_hit':
    begin
      return Ok(VisibleCombatEventKind.HostileHit)
    end;
    'hostile_miss':
    begin
      return Ok(VisibleCombatEventKind.HostileMiss)
    end;
    'hostile_defeated':
    begin
      return Ok(VisibleCombatEventKind.HostileDefeated)
    end
    else
    begin
      return Error('combat event has an unknown kind')
    end
  end
end;

function EncodeInventory(Items: array of VisibleInventoryItem): array of JsonValue;
begin
  mutable var Values: array of JsonValue := [];
  for Item: VisibleInventoryItem in Items do
  begin
    Std.Arrays.Push(Values, JsonValue.Object(['id': JsonValue.String(Item.Id), 'name': JsonValue.String(Item.Name), 'slot': JsonValue.String(ItemSlotName(Item.Slot)), 'equipped': JsonValue.Bool(Item.Equipped)]))
  end;

  return Values
end;

function EncodeCharacter(Lines: array of VisibleCharacterValue): array of JsonValue;
begin
  mutable var Values: array of JsonValue := [];
  for Line: VisibleCharacterValue in Lines do
  begin
    Std.Arrays.Push(Values, JsonValue.Object(['label': JsonValue.String(Line.Label), 'value': JsonValue.String(Line.Value), 'source': JsonValue.String(Line.Source)]))
  end;

  return Values
end;

function EncodeCombatEvents(Events: array of VisibleCombatEvent): array of JsonValue;
begin
  mutable var Values: array of JsonValue := [];
  for Entry: VisibleCombatEvent in Events do
  begin
    Std.Arrays.Push(Values, JsonValue.Object(['kind': JsonValue.String(CombatEventName(Entry.Kind)), 'amount': JsonValue.Number(IntToReal(Entry.Amount))]))
  end;

  return Values
end;

function EncodeDialogueChoices(Choices: array of VisibleDialogueChoice): array of JsonValue;
begin
  mutable var Values: array of JsonValue := [];
  for Choice: VisibleDialogueChoice in Choices do
  begin
    Std.Arrays.Push(Values, JsonValue.Object(['id': JsonValue.String(Choice.Id), 'text': JsonValue.String(Choice.Text)]))
  end;

  return Values
end;

function ValidateDialogue(Value: VisibleDialogue): result of VisibleDialogue, string;
begin
  if (Std.Str.Length(Value.NpcId) = 0) or (Std.Str.Length(Value.NpcId) > MaximumDialogueIdLength) then
  begin
    return Error('dialogue NPC id has an invalid length')
  end;

  if (Std.Str.Length(Value.Speaker) = 0) or
     (Std.Str.Length(Value.Speaker) > MaximumDialogueLabelLength) then
  begin
    return Error('dialogue speaker has an invalid length')
  end;

  if (Std.Str.Length(Value.Text) = 0) or (Std.Str.Length(Value.Text) > MaximumDialogueTextLength) then
  begin
    return Error('dialogue text has an invalid length')
  end;

  if (Std.Arrays.Length(Value.Choices) = 0) or
     (Std.Arrays.Length(Value.Choices) > MaximumDialogueChoices) then
  begin
    return Error('dialogue choice count is outside protocol limits')
  end;

  for Index: integer := 0 to Std.Arrays.Length(Value.Choices) - 1 do
  begin
    var Choice: VisibleDialogueChoice := Value.Choices[Index];
    if (Std.Str.Length(Choice.Id) = 0) or (Std.Str.Length(Choice.Id) > MaximumDialogueIdLength) then
    begin
      return Error('dialogue choice id has an invalid length')
    end;

    if (Std.Str.Length(Choice.Text) = 0) or
       (Std.Str.Length(Choice.Text) > MaximumDialogueLabelLength) then
    begin
      return Error('dialogue choice text has an invalid length')
    end;

    for Earlier: integer := 0 to Index - 1 do
    begin
      if Value.Choices[Earlier].Id = Choice.Id then
      begin
        return Error('dialogue contains a duplicate choice id')
      end
    end
  end;

  return Ok(Value)
end;

function ValidateInventory(Items: array of VisibleInventoryItem): result of array of VisibleInventoryItem, string;
begin
  if Std.Arrays.Length(Items) > MaximumVisibleInventoryItems then
  begin
    return Error('visible inventory exceeds the protocol item limit')
  end;

  for Index: integer := 0 to Std.Arrays.Length(Items) - 1 do
  begin
    var Item: VisibleInventoryItem := Items[Index];
    if (Std.Str.Length(Item.Id) = 0) or
       (Std.Str.Length(Item.Id) > MaximumVisibleInventoryTextLength) then
    begin
      return Error('visible inventory item id has an invalid length')
    end;

    if (Std.Str.Length(Item.Name) = 0) or
       (Std.Str.Length(Item.Name) > MaximumVisibleInventoryTextLength) then
    begin
      return Error('visible inventory item name has an invalid length')
    end;

    if Item.Equipped and (Item.Slot = VisibleItemSlot.NoSlot) then
    begin
      return Error('visible inventory item without a slot cannot be worn')
    end;

    for Earlier: integer := 0 to Index - 1 do
    begin
      if ((Item.Equipped and Items[Earlier].Equipped) and (Item.Slot = Items[Earlier].Slot)) then
      begin
        return Error('visible inventory wears two items in one slot')
      end
    end;

    for Earlier: integer := 0 to Index - 1 do
    begin
      if Items[Earlier].Id = Item.Id then
      begin
        return Error('visible inventory contains a duplicate item id')
      end
    end
  end;

  return Ok(Items)
end;

function ValidateHealth(Health: integer; MaxHealth: integer): result of boolean, string;
begin
  if ((MaxHealth < 1) or (MaxHealth > MaximumVisibleHealth)) or
     ((Health < 1) or (Health > MaxHealth)) then
  begin
    return Error('visible health is outside protocol limits')
  end;

  return Ok(true)
end;

function ValidateCombatLog(Log: array of string): result of boolean, string;
begin
  if Std.Arrays.Length(Log) > MaximumCombatLogEntries then
  begin
    return Error('combat log exceeds the protocol entry limit')
  end;

  for Entry: string in Log do
  begin
    if (Std.Str.Length(Entry) = 0) or (Std.Str.Length(Entry) > MaximumCombatLogTextLength) then
    begin
      return Error('combat log entry has an invalid length')
    end
  end;

  return Ok(true)
end;

function ValidateCharacter(Lines: array of VisibleCharacterValue): result of boolean, string;
begin
  if Std.Arrays.Length(Lines) > MaximumCharacterValues then
  begin
    return Error('character sheet exceeds the protocol line limit')
  end;

  for Line: VisibleCharacterValue in Lines do
  begin
    if (((Std.Str.Length(Line.Label) = 0) or (Std.Str.Length(Line.Label) > MaximumCharacterTextLength)) or ((Std.Str.Length(Line.Value) = 0) or (Std.Str.Length(Line.Value) > MaximumCharacterTextLength))) or
       ((Std.Str.Length(Line.Source) = 0) or (Std.Str.Length(Line.Source) > MaximumCharacterTextLength)) then
    begin
      return Error('character sheet line has an invalid length')
    end
  end;

  return Ok(true)
end;

function ValidateCombatEvents(Events: array of VisibleCombatEvent): result of boolean, string;
begin
  if Std.Arrays.Length(Events) > MaximumCombatEvents then
  begin
    return Error('combat events exceed the protocol entry limit')
  end;

  for Entry: VisibleCombatEvent in Events do
  begin
    if (Entry.Amount < 0) or (Entry.Amount > MaximumCombatEventAmount) then
    begin
      return Error('combat event amount is outside protocol limits')
    end
  end;

  return Ok(true)
end;

function ValidateMapVisibleState(Value: MapVisibleState): result of MapVisibleState, string;
begin
  var ValidInventory: array of VisibleInventoryItem := try ValidateInventory(Value.Inventory);
  var ValidHealth: boolean := try ValidateHealth(Value.Health, Value.MaxHealth);
  var ValidCharacter: boolean := try ValidateCharacter(Value.Character);
  if (Value.Width <= 0) or (Value.Height <= 0) then
  begin
    return Error('visible-state dimensions must be positive')
  end;

  if Std.Arrays.Length(Value.Rows) <> Value.Height then
  begin
    return Error('visible-state row count must match height')
  end;

  for Row: string in Value.Rows do
  begin
    if Std.Str.Length(Row) <> Value.Width then
    begin
      return Error('visible-state row width must match width')
    end;

    for Index: integer := 0 to Std.Str.Length(Row) - 1 do
    begin
      var Code: string := Std.Str.CharAt(Row, Index);
      if not IsMapCellCode(Code) then
      begin
        return Error('visible-state row contains an unknown cell code')
      end
    end
  end;
  var KnowledgeValid: boolean := try ValidateKnowledgeRows(Value.Rows, Value.KnowledgeRows, Value.Width, Value.Height);
  if (((Value.PlayerX < 0) or (Value.PlayerX >= Value.Width)) or (Value.PlayerY < 0)) or
     (Value.PlayerY >= Value.Height) then
  begin
    return Error('visible-state player position is outside the area')
  end;

  if (Value.OriginX + Value.PlayerX <> Value.WorldX) or
     (Value.OriginY + Value.PlayerY <> Value.WorldY) then
  begin
    return Error('visible-state local and world player positions disagree')
  end;

  if Std.Str.CharAt(Value.KnowledgeRows[Value.PlayerY], Value.PlayerX) <> KnowledgeVisibleCode then
  begin
    return Error('visible-state player field must be currently visible')
  end;

  return Ok(Value)
end;

function ValidateFirstPersonVisibleState(Value: FirstPersonVisibleState): result of FirstPersonVisibleState, string;
begin
  var ValidInventory: array of VisibleInventoryItem := try ValidateInventory(Value.Inventory);
  var ValidHealth: boolean := try ValidateHealth(Value.Health, Value.MaxHealth);
  var ValidLog: boolean := try ValidateCombatLog(Value.CombatLog);
  var ValidCharacter: boolean := try ValidateCharacter(Value.Character);
  var ValidEvents: boolean := try ValidateCombatEvents(Value.CombatEvents);
  if Std.Str.Length(Value.Title) = 0 then
  begin
    return Error('first-person state title must not be empty')
  end;

  if Std.Str.Length(Value.Status) = 0 then
  begin
    return Error('first-person state status must not be empty')
  end;

  if (Value.Width <= 0) or (Value.Height <= 0) then
  begin
    return Error('first-person dimensions must be positive')
  end;

  if Std.Arrays.Length(Value.Rows) <> Value.Height then
  begin
    return Error('first-person row count must match height')
  end;
  mutable var ExitCount: integer := 0;
  for Row: string in Value.Rows do
  begin
    if Std.Str.Length(Row) <> Value.Width then
    begin
      return Error('first-person row width must match width')
    end;

    for Index: integer := 0 to Std.Str.Length(Row) - 1 do
    begin
      var Code: string := Std.Str.CharAt(Row, Index);
      if not IsInteriorCellCode(Code) then
      begin
        return Error('first-person row contains an unknown field code')
      end;

      if Code = InteriorExitCode then
      begin
        ExitCount := ExitCount + 1
      end
    end
  end;
  var KnowledgeValid: boolean := try ValidateKnowledgeRows(Value.Rows, Value.KnowledgeRows, Value.Width, Value.Height);
  if ExitCount > 1 then
  begin
    return Error('first-person state must not contain duplicate exit fields')
  end;

  if (((Value.PlayerX < 0) or (Value.PlayerX >= Value.Width)) or (Value.PlayerY < 0)) or
     (Value.PlayerY >= Value.Height) then
  begin
    return Error('first-person player position is outside the area')
  end;
  var PlayerCode: string := Std.Str.CharAt(Value.Rows[Value.PlayerY], Value.PlayerX);
  if Std.Arrays.Contains([
                           InteriorWallCode,
                           InteriorTabletCode,
                           InteriorNpcCode,
                           InteriorHostileCode,
                           UnknownFieldCode
                         ], PlayerCode) then
  begin
    return Error('first-person player position must be traversable')
  end;

  if Std.Str.CharAt(Value.KnowledgeRows[Value.PlayerY], Value.PlayerX) <> KnowledgeVisibleCode then
  begin
    return Error('first-person player field must be currently visible')
  end;

  return Ok(Value)
end;

function ValidateExplorationMapState(Value: ExplorationMapState): result of ExplorationMapState, string;
begin
  if Std.Str.Length(Value.LabelText) = 0 then
  begin
    return Error('exploration map label must not be empty')
  end;

  if (Value.Width <= 0) or (Value.Height <= 0) then
  begin
    return Error('exploration map dimensions must be positive')
  end;

  if (Value.Width > MaximumExplorationMapWidth) or (Value.Height > MaximumExplorationMapHeight) then
  begin
    return Error('exploration map dimensions exceed protocol limits')
  end;

  if (((Value.OriginX < - MaximumExplorationMapOriginMagnitude) or (Value.OriginX > MaximumExplorationMapOriginMagnitude)) or (Value.OriginY < - MaximumExplorationMapOriginMagnitude)) or
     (Value.OriginY > MaximumExplorationMapOriginMagnitude) then
  begin
    return Error('exploration map origin exceeds protocol limits')
  end;

  if Std.Arrays.Length(Value.Rows) <> Value.Height then
  begin
    return Error('exploration map row count must match height')
  end;

  for Row: string in Value.Rows do
  begin
    if Std.Str.Length(Row) <> Value.Width then
    begin
      return Error('exploration map row width must match width')
    end;

    for X: integer := 0 to Value.Width - 1 do
    begin
      var Code: string := Std.Str.CharAt(Row, X);
      if Value.View = ViewKind.Map then
      begin
        if not IsMapCellCode(Code) then
        begin
          return Error('exploration map contains an unknown outdoor field code')
        end
      end
      else
      begin
        if not IsInteriorCellCode(Code) then
        begin
          return Error('exploration map contains an unknown interior field code')
        end
      end
    end
  end;
  var KnowledgeValid: boolean := try ValidateKnowledgeRows(Value.Rows, Value.KnowledgeRows, Value.Width, Value.Height);
  var ContainsPlayer: boolean := (((Value.PlayerWorldX >= Value.OriginX) and (Value.PlayerWorldX < Value.OriginX + Value.Width)) and (Value.PlayerWorldY >= Value.OriginY)) and
                                 (Value.PlayerWorldY < Value.OriginY + Value.Height);
  if ContainsPlayer <> Value.PlayerInWindow then
  begin
    return Error('exploration map player-in-window flag is inconsistent')
  end;

  if Value.PlayerInWindow then
  begin
    var PlayerLocalX: integer := Value.PlayerWorldX - Value.OriginX;
    var PlayerLocalY: integer := Value.PlayerWorldY - Value.OriginY;
    if Std.Str.CharAt(Value.KnowledgeRows[PlayerLocalY], PlayerLocalX) <> KnowledgeVisibleCode then
    begin
      return Error('exploration map player field must be currently visible')
    end
  end;

  return Ok(Value)
end;

// Returns the renderer family selected by a view-specific visible state.
public function ViewForVisibleState(Value: VisibleState): ViewKind;
begin
  case Value of
    VisibleState.MapState(MapValue):
    begin
      return ViewKind.Map
    end;
    VisibleState.FirstPersonState(FirstPersonValue):
    begin
      return ViewKind.FirstPerson
    end
  end
end;

function InventoryField(Fields: dict of string to JsonValue; Name: string): result of array of VisibleInventoryItem, string;
begin
  case try Field(Fields, Name) of
    JsonValue.ArrayValue(Values):
    begin
      mutable var Items: array of VisibleInventoryItem := [];
      for Value: JsonValue in Values do
      begin
        case Value of
          JsonValue.Object(ItemFields):
          begin
            if Std.Dictionaries.Length(ItemFields) <> 4 then
            begin
              return Error('visible inventory item must contain only id, name, slot, and equipped')
            end;

            Std.Arrays.Push(Items, record
              Id := try StringField(ItemFields, 'id');
              Name := try StringField(ItemFields, 'name');
              Slot := try DecodeItemSlot(try StringField(ItemFields, 'slot'));
              Equipped := try BooleanField(ItemFields, 'equipped');
            end)
          end
          else
          begin
            return Error('visible inventory must contain only objects')
          end
        end
      end;

      return ValidateInventory(Items)
    end
    else
    begin
      return Error('message field inventory must be an array')
    end
  end
end;

function ItemIdField(Fields: dict of string to JsonValue): result of string, string;
begin
  var ItemId: string := try StringField(Fields, 'item_id');
  if (Std.Str.Length(ItemId) = 0) or (Std.Str.Length(ItemId) > MaximumVisibleInventoryTextLength) then
  begin
    return Error('item id has an invalid length')
  end;

  return Ok(ItemId)
end;

function CharacterField(Fields: dict of string to JsonValue): result of array of VisibleCharacterValue, string;
begin
  case try Field(Fields, 'character') of
    JsonValue.ArrayValue(Values):
    begin
      mutable var Lines: array of VisibleCharacterValue := [];
      for Value: JsonValue in Values do
      begin
        case Value of
          JsonValue.Object(LineFields):
          begin
            if Std.Dictionaries.Length(LineFields) <> 3 then
            begin
              return Error('character line must contain only label, value, and source')
            end;

            Std.Arrays.Push(Lines, record
              Label := try StringField(LineFields, 'label');
              Value := try StringField(LineFields, 'value');
              Source := try StringField(LineFields, 'source');
            end)
          end
          else
          begin
            return Error('character must contain only objects')
          end
        end
      end;
      var Valid: boolean := try ValidateCharacter(Lines);
      return Ok(Lines)
    end
    else
    begin
      return Error('message field character must be an array')
    end
  end
end;

function CombatEventsField(Fields: dict of string to JsonValue): result of array of VisibleCombatEvent, string;
begin
  case try Field(Fields, 'combat_events') of
    JsonValue.ArrayValue(Values):
    begin
      mutable var Events: array of VisibleCombatEvent := [];
      for Value: JsonValue in Values do
      begin
        case Value of
          JsonValue.Object(EventFields):
          begin
            if Std.Dictionaries.Length(EventFields) <> 2 then
            begin
              return Error('combat event must contain only kind and amount')
            end;

            Std.Arrays.Push(Events, record
              Kind := try DecodeCombatEventKind(try StringField(EventFields, 'kind'));
              Amount := try IntegerField(EventFields, 'amount');
            end)
          end
          else
          begin
            return Error('combat events must contain only objects')
          end
        end
      end;
      var Valid: boolean := try ValidateCombatEvents(Events);
      return Ok(Events)
    end
    else
    begin
      return Error('message field combat_events must be an array')
    end
  end
end;

function DialogueChoicesField(Fields: dict of string to JsonValue; Name: string): result of array of VisibleDialogueChoice, string;
begin
  case try Field(Fields, Name) of
    JsonValue.ArrayValue(Values):
    begin
      mutable var Choices: array of VisibleDialogueChoice := [];
      for Value: JsonValue in Values do
      begin
        case Value of
          JsonValue.Object(ChoiceFields):
          begin
            if Std.Dictionaries.Length(ChoiceFields) <> 2 then
            begin
              return Error('dialogue choice must contain only id and text')
            end;

            Std.Arrays.Push(Choices, record
              Id := try StringField(ChoiceFields, 'id');
              Text := try StringField(ChoiceFields, 'text');
            end)
          end
          else
          begin
            return Error('dialogue choices must contain only objects')
          end
        end
      end;

      return Ok(Choices)
    end
    else
    begin
      return Error('message field choices must be an array')
    end
  end
end;

function DecodeDialogue(Fields: dict of string to JsonValue): result of VisibleDialogue, string;
begin
  if Std.Dictionaries.Length(Fields) <> 5 then
  begin
    return Error('dialogue must contain only type, npc_id, speaker, text, and choices')
  end;

  return ValidateDialogue(record
    NpcId := try StringField(Fields, 'npc_id');
    Speaker := try StringField(Fields, 'speaker');
    Text := try StringField(Fields, 'text');
    Choices := try DialogueChoicesField(Fields, 'choices');
  end)
end;

// Encodes one client message as a compact JSON object for line transport.
public function EncodeClient(Message: ClientMessage): string;
begin
  case Message of
    ClientMessage.Hello(Version, ViewWidth, ViewHeight):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('hello'), 'version': JsonValue.Number(IntToReal(Version)), 'width': JsonValue.Number(IntToReal(ViewWidth)), 'height': JsonValue.Number(IntToReal(ViewHeight))]))
    end;
    ClientMessage.StartNewGame:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('new_game')]))
    end;
    ClientMessage.LoadGame:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('load_game')]))
    end;
    ClientMessage.SaveGame:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('save_game')]))
    end;
    ClientMessage.Viewport(Width, Height):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('viewport'), 'width': JsonValue.Number(IntToReal(Width)), 'height': JsonValue.Number(IntToReal(Height))]))
    end;
    ClientMessage.ExplorationMap(OriginX, OriginY, Width, Height):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('exploration_map'), 'origin_x': JsonValue.Number(IntToReal(OriginX)), 'origin_y': JsonValue.Number(IntToReal(OriginY)), 'width': JsonValue.Number(IntToReal(Width)), 'height': JsonValue.Number(IntToReal(Height))]))
    end;
    ClientMessage.Move(DeltaX, DeltaY):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('move'), 'dx': JsonValue.Number(IntToReal(DeltaX)), 'dy': JsonValue.Number(IntToReal(DeltaY))]))
    end;
    ClientMessage.StepFirstPerson(Direction):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('first_person_step'), 'direction': JsonValue.String(FirstPersonStepName(Direction))]))
    end;
    ClientMessage.TurnFirstPerson(Direction):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('first_person_turn'), 'direction': JsonValue.String(FirstPersonTurnName(Direction))]))
    end;
    ClientMessage.Interact:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('interact')]))
    end;
    ClientMessage.DialogueChoice(ChoiceId):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('dialogue_choice'), 'choice_id': JsonValue.String(ChoiceId)]))
    end;
    ClientMessage.EndDialogue:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('end_dialogue')]))
    end;
    ClientMessage.Attack:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('attack')]))
    end;
    ClientMessage.Wait:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('wait')]))
    end;
    ClientMessage.Equip(ItemId):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('equip'), 'item_id': JsonValue.String(ItemId)]))
    end;
    ClientMessage.Unequip(ItemId):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('unequip'), 'item_id': JsonValue.String(ItemId)]))
    end;
    ClientMessage.Disconnect:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('disconnect')]))
    end
  end
end;

// Decodes one client message and rejects missing, mistyped, or unknown fields.
public function DecodeClient(Text: string): result of ClientMessage, string;
begin
  var Fields: dict of string to JsonValue := try ParseObject(Text);
  case try StringField(Fields, 'type') of
    'hello':
    begin
      if Std.Dictionaries.Length(Fields) <> 4 then
      begin
        return Error('hello must contain only type, version, width, and height')
      end;

      return Ok(ClientMessage.Hello(try IntegerField(Fields, 'version'), try IntegerField(Fields, 'width'), try IntegerField(Fields, 'height')))
    end;
    'new_game':
    begin
      if Std.Dictionaries.Length(Fields) <> 1 then
      begin
        return Error('new_game must not contain additional fields')
      end;

      return Ok(ClientMessage.StartNewGame)
    end;
    'load_game':
    begin
      if Std.Dictionaries.Length(Fields) <> 1 then
      begin
        return Error('load_game must not contain additional fields')
      end;

      return Ok(ClientMessage.LoadGame)
    end;
    'save_game':
    begin
      if Std.Dictionaries.Length(Fields) <> 1 then
      begin
        return Error('save_game must not contain additional fields')
      end;

      return Ok(ClientMessage.SaveGame)
    end;
    'viewport':
    begin
      if Std.Dictionaries.Length(Fields) <> 3 then
      begin
        return Error('viewport must contain only type, width, and height')
      end;

      return Ok(ClientMessage.Viewport(try IntegerField(Fields, 'width'), try IntegerField(Fields, 'height')))
    end;
    'exploration_map':
    begin
      if Std.Dictionaries.Length(Fields) <> 5 then
      begin
        return Error('exploration_map must contain only type, origin_x, origin_y, width, and height')
      end;
      var Width: integer := try IntegerField(Fields, 'width');
      var Height: integer := try IntegerField(Fields, 'height');
      if (((Width < 1) or (Height < 1)) or (Width > MaximumExplorationMapWidth)) or
         (Height > MaximumExplorationMapHeight) then
      begin
        return Error('exploration_map dimensions are outside protocol limits')
      end;
      var OriginX: integer := try IntegerField(Fields, 'origin_x');
      var OriginY: integer := try IntegerField(Fields, 'origin_y');
      if (((OriginX < - MaximumExplorationMapOriginMagnitude) or (OriginX > MaximumExplorationMapOriginMagnitude)) or (OriginY < - MaximumExplorationMapOriginMagnitude)) or
         (OriginY > MaximumExplorationMapOriginMagnitude) then
      begin
        return Error('exploration_map origin is outside protocol limits')
      end;

      return Ok(ClientMessage.ExplorationMap(OriginX, OriginY, Width, Height))
    end;
    'move':
    begin
      if Std.Dictionaries.Length(Fields) <> 3 then
      begin
        return Error('move must contain only type, dx, and dy')
      end;

      return Ok(ClientMessage.Move(try IntegerField(Fields, 'dx'), try IntegerField(Fields, 'dy')))
    end;
    'first_person_step':
    begin
      if Std.Dictionaries.Length(Fields) <> 2 then
      begin
        return Error('first_person_step must contain only type and direction')
      end;

      return Ok(ClientMessage.StepFirstPerson(try DecodeFirstPersonStep(try StringField(Fields, 'direction'))))
    end;
    'first_person_turn':
    begin
      if Std.Dictionaries.Length(Fields) <> 2 then
      begin
        return Error('first_person_turn must contain only type and direction')
      end;

      return Ok(ClientMessage.TurnFirstPerson(try DecodeFirstPersonTurn(try StringField(Fields, 'direction'))))
    end;
    'interact':
    begin
      if Std.Dictionaries.Length(Fields) <> 1 then
      begin
        return Error('interact must not contain additional fields')
      end;

      return Ok(ClientMessage.Interact)
    end;
    'dialogue_choice':
    begin
      if Std.Dictionaries.Length(Fields) <> 2 then
      begin
        return Error('dialogue_choice must contain only type and choice_id')
      end;
      var ChoiceId: string := try StringField(Fields, 'choice_id');
      if (Std.Str.Length(ChoiceId) = 0) or (Std.Str.Length(ChoiceId) > MaximumDialogueIdLength) then
      begin
        return Error('dialogue choice id has an invalid length')
      end;

      return Ok(ClientMessage.DialogueChoice(ChoiceId))
    end;
    'end_dialogue':
    begin
      if Std.Dictionaries.Length(Fields) <> 1 then
      begin
        return Error('end_dialogue must not contain additional fields')
      end;

      return Ok(ClientMessage.EndDialogue)
    end;
    'attack':
    begin
      if Std.Dictionaries.Length(Fields) <> 1 then
      begin
        return Error('attack must not contain additional fields')
      end;

      return Ok(ClientMessage.Attack)
    end;
    'wait':
    begin
      if Std.Dictionaries.Length(Fields) <> 1 then
      begin
        return Error('wait must not contain additional fields')
      end;

      return Ok(ClientMessage.Wait)
    end;
    'equip':
    begin
      if Std.Dictionaries.Length(Fields) <> 2 then
      begin
        return Error('equip must contain only type and item_id')
      end;

      return Ok(ClientMessage.Equip(try ItemIdField(Fields)))
    end;
    'unequip':
    begin
      if Std.Dictionaries.Length(Fields) <> 2 then
      begin
        return Error('unequip must contain only type and item_id')
      end;

      return Ok(ClientMessage.Unequip(try ItemIdField(Fields)))
    end;
    'disconnect':
    begin
      if Std.Dictionaries.Length(Fields) <> 1 then
      begin
        return Error('disconnect must not contain additional fields')
      end;

      return Ok(ClientMessage.Disconnect)
    end
    else
    begin
      return Error('unknown client message type')
    end
  end
end;

// Encodes one server message as a compact JSON object for line transport.
public function EncodeServer(Message: ServerMessage): string;
begin
  case Message of
    ServerMessage.Welcome(Version, SaveAvailable, InvalidSaveRemoved):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('welcome'), 'version': JsonValue.Number(IntToReal(Version)), 'save_available': JsonValue.Bool(SaveAvailable), 'invalid_save_removed': JsonValue.Bool(InvalidSaveRemoved)]))
    end;
    ServerMessage.State(Value):
    begin
      case Value of
        VisibleState.MapState(MapValue):
        begin
          return Stringify(JsonValue.Object(['type': JsonValue.String('state'), 'view': JsonValue.String(ViewName(ViewKind.Map)), 'origin_x': JsonValue.Number(IntToReal(MapValue.OriginX)), 'origin_y': JsonValue.Number(IntToReal(MapValue.OriginY)), 'width': JsonValue.Number(IntToReal(MapValue.Width)), 'height': JsonValue.Number(IntToReal(MapValue.Height)), 'rows': JsonValue.ArrayValue(EncodeRows(MapValue.Rows)), 'knowledge_rows': JsonValue.ArrayValue(EncodeRows(MapValue.KnowledgeRows)), 'x': JsonValue.Number(IntToReal(MapValue.PlayerX)), 'y': JsonValue.Number(IntToReal(MapValue.PlayerY)), 'world_x': JsonValue.Number(IntToReal(MapValue.WorldX)), 'world_y': JsonValue.Number(IntToReal(MapValue.WorldY)), 'inventory': JsonValue.ArrayValue(EncodeInventory(MapValue.Inventory)), 'health': JsonValue.Number(IntToReal(MapValue.Health)), 'max_health': JsonValue.Number(IntToReal(MapValue.MaxHealth)), 'character': JsonValue.ArrayValue(EncodeCharacter(MapValue.Character))]))
        end;
        VisibleState.FirstPersonState(FirstPersonValue):
        begin
          return Stringify(JsonValue.Object(['type': JsonValue.String('state'), 'view': JsonValue.String(ViewName(ViewKind.FirstPerson)), 'title': JsonValue.String(FirstPersonValue.Title), 'status': JsonValue.String(FirstPersonValue.Status), 'width': JsonValue.Number(IntToReal(FirstPersonValue.Width)), 'height': JsonValue.Number(IntToReal(FirstPersonValue.Height)), 'rows': JsonValue.ArrayValue(EncodeRows(FirstPersonValue.Rows)), 'knowledge_rows': JsonValue.ArrayValue(EncodeRows(FirstPersonValue.KnowledgeRows)), 'x': JsonValue.Number(IntToReal(FirstPersonValue.PlayerX)), 'y': JsonValue.Number(IntToReal(FirstPersonValue.PlayerY)), 'facing': JsonValue.String(FirstPersonFacingName(FirstPersonValue.Facing)), 'inventory': JsonValue.ArrayValue(EncodeInventory(FirstPersonValue.Inventory)), 'health': JsonValue.Number(IntToReal(FirstPersonValue.Health)), 'max_health': JsonValue.Number(IntToReal(FirstPersonValue.MaxHealth)), 'character': JsonValue.ArrayValue(EncodeCharacter(FirstPersonValue.Character)), 'combat_log': JsonValue.ArrayValue(EncodeRows(FirstPersonValue.CombatLog)), 'combat_events': JsonValue.ArrayValue(EncodeCombatEvents(FirstPersonValue.CombatEvents))]))
        end
      end
    end;
    ServerMessage.ExplorationMap(Value):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('exploration_map'), 'view': JsonValue.String(ViewName(Value.View)), 'label': JsonValue.String(Value.LabelText), 'origin_x': JsonValue.Number(IntToReal(Value.OriginX)), 'origin_y': JsonValue.Number(IntToReal(Value.OriginY)), 'width': JsonValue.Number(IntToReal(Value.Width)), 'height': JsonValue.Number(IntToReal(Value.Height)), 'rows': JsonValue.ArrayValue(EncodeRows(Value.Rows)), 'knowledge_rows': JsonValue.ArrayValue(EncodeRows(Value.KnowledgeRows)), 'player_world_x': JsonValue.Number(IntToReal(Value.PlayerWorldX)), 'player_world_y': JsonValue.Number(IntToReal(Value.PlayerWorldY)), 'player_in_window': JsonValue.Bool(Value.PlayerInWindow)]))
    end;
    ServerMessage.Interaction(Title, MessageText):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('interaction'), 'title': JsonValue.String(Title), 'message': JsonValue.String(MessageText)]))
    end;
    ServerMessage.Dialogue(Value):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('dialogue'), 'npc_id': JsonValue.String(Value.NpcId), 'speaker': JsonValue.String(Value.Speaker), 'text': JsonValue.String(Value.Text), 'choices': JsonValue.ArrayValue(EncodeDialogueChoices(Value.Choices))]))
    end;
    ServerMessage.DialogueEnded:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('dialogue_ended')]))
    end;
    ServerMessage.SaveCompleted:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('save_completed')]))
    end;
    ServerMessage.Defeated(MessageText):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('defeated'), 'message': JsonValue.String(MessageText)]))
    end;
    ServerMessage.Rejected(Code, MessageText):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('rejected'), 'code': JsonValue.String(Code), 'message': JsonValue.String(MessageText)]))
    end;
    ServerMessage.ErrorMessage(Code, MessageText):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('error'), 'code': JsonValue.String(Code), 'message': JsonValue.String(MessageText)]))
    end
  end
end;

// Decodes one server message and validates visible-state dimensions and coordinates.
public function DecodeServer(Text: string): result of ServerMessage, string;
begin
  var Fields: dict of string to JsonValue := try ParseObject(Text);
  case try StringField(Fields, 'type') of
    'welcome':
    begin
      if Std.Dictionaries.Length(Fields) <> 4 then
      begin
        return Error('welcome must contain only type, version, save_available, and invalid_save_removed')
      end;

      return Ok(ServerMessage.Welcome(try IntegerField(Fields, 'version'), try BooleanField(Fields, 'save_available'), try BooleanField(Fields, 'invalid_save_removed')))
    end;
    'save_completed':
    begin
      if Std.Dictionaries.Length(Fields) <> 1 then
      begin
        return Error('save_completed must not contain additional fields')
      end;

      return Ok(ServerMessage.SaveCompleted)
    end;
    'state':
    begin
      case try DecodeView(try StringField(Fields, 'view')) of
        ViewKind.Map:
        begin
          if Std.Dictionaries.Length(Fields) <> 16 then
          begin
            return Error('map state has an unexpected field set')
          end;
          var MapValue: MapVisibleState := record
            OriginX := try IntegerField(Fields, 'origin_x');
            OriginY := try IntegerField(Fields, 'origin_y');
            Width := try IntegerField(Fields, 'width');
            Height := try IntegerField(Fields, 'height');
            Rows := try StringArrayField(Fields, 'rows');
            KnowledgeRows := try StringArrayField(Fields, 'knowledge_rows');
            PlayerX := try IntegerField(Fields, 'x');
            PlayerY := try IntegerField(Fields, 'y');
            WorldX := try IntegerField(Fields, 'world_x');
            WorldY := try IntegerField(Fields, 'world_y');
            Inventory := try InventoryField(Fields, 'inventory');
            Health := try IntegerField(Fields, 'health');
            MaxHealth := try IntegerField(Fields, 'max_health');
            Character := try CharacterField(Fields);
          end;

          return Ok(ServerMessage.State(VisibleState.MapState(try ValidateMapVisibleState(MapValue))))
        end;
        ViewKind.FirstPerson:
        begin
          if Std.Dictionaries.Length(Fields) <> 17 then
          begin
            return Error('first-person state has an unexpected field set')
          end;
          var FirstPersonValue: FirstPersonVisibleState := record
            Title := try StringField(Fields, 'title');
            Status := try StringField(Fields, 'status');
            Width := try IntegerField(Fields, 'width');
            Height := try IntegerField(Fields, 'height');
            Rows := try StringArrayField(Fields, 'rows');
            KnowledgeRows := try StringArrayField(Fields, 'knowledge_rows');
            PlayerX := try IntegerField(Fields, 'x');
            PlayerY := try IntegerField(Fields, 'y');
            Facing := try DecodeFirstPersonFacing(try StringField(Fields, 'facing'));
            Inventory := try InventoryField(Fields, 'inventory');
            Health := try IntegerField(Fields, 'health');
            MaxHealth := try IntegerField(Fields, 'max_health');
            Character := try CharacterField(Fields);
            CombatLog := try StringArrayField(Fields, 'combat_log');
            CombatEvents := try CombatEventsField(Fields);
          end;

          return Ok(ServerMessage.State(VisibleState.FirstPersonState(try ValidateFirstPersonVisibleState(FirstPersonValue))))
        end
      end
    end;
    'exploration_map':
    begin
      if Std.Dictionaries.Length(Fields) <> 12 then
      begin
        return Error('exploration map has an unexpected field set')
      end;
      var Value: ExplorationMapState := record
        View := try DecodeView(try StringField(Fields, 'view'));
        LabelText := try StringField(Fields, 'label');
        OriginX := try IntegerField(Fields, 'origin_x');
        OriginY := try IntegerField(Fields, 'origin_y');
        Width := try IntegerField(Fields, 'width');
        Height := try IntegerField(Fields, 'height');
        Rows := try StringArrayField(Fields, 'rows');
        KnowledgeRows := try StringArrayField(Fields, 'knowledge_rows');
        PlayerWorldX := try IntegerField(Fields, 'player_world_x');
        PlayerWorldY := try IntegerField(Fields, 'player_world_y');
        PlayerInWindow := try BooleanField(Fields, 'player_in_window');
      end;

      return Ok(ServerMessage.ExplorationMap(try ValidateExplorationMapState(Value)))
    end;
    'interaction':
    begin
      if Std.Dictionaries.Length(Fields) <> 3 then
      begin
        return Error('interaction must contain only type, title, and message')
      end;
      var MessageText: string := try StringField(Fields, 'message');
      if Std.Str.Length(MessageText) = 0 then
      begin
        return Error('interaction message must not be empty')
      end;

      return Ok(ServerMessage.Interaction(try StringField(Fields, 'title'), MessageText))
    end;
    'dialogue':
    begin
      return Ok(ServerMessage.Dialogue(try DecodeDialogue(Fields)))
    end;
    'defeated':
    begin
      if Std.Dictionaries.Length(Fields) <> 2 then
      begin
        return Error('defeated must contain only type and message')
      end;
      var DefeatText: string := try StringField(Fields, 'message');
      if (Std.Str.Length(DefeatText) = 0) or
         (Std.Str.Length(DefeatText) > MaximumCombatLogTextLength) then
      begin
        return Error('defeat message has an invalid length')
      end;

      return Ok(ServerMessage.Defeated(DefeatText))
    end;
    'dialogue_ended':
    begin
      if Std.Dictionaries.Length(Fields) <> 1 then
      begin
        return Error('dialogue_ended must not contain additional fields')
      end;

      return Ok(ServerMessage.DialogueEnded)
    end;
    'rejected':
    begin
      if Std.Dictionaries.Length(Fields) <> 3 then
      begin
        return Error('rejected must contain only type, code, and message')
      end;

      return Ok(ServerMessage.Rejected(try StringField(Fields, 'code'), try StringField(Fields, 'message')))
    end;
    'error':
    begin
      if Std.Dictionaries.Length(Fields) <> 3 then
      begin
        return Error('error must contain only type, code, and message')
      end;

      return Ok(ServerMessage.ErrorMessage(try StringField(Fields, 'code'), try StringField(Fields, 'message')))
    end
    else
    begin
      return Error('unknown server message type')
    end
  end
end;
