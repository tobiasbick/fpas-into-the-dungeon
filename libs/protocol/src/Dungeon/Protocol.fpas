// Versioned JSON message contract shared by the client and server.
unit Dungeon.Protocol;

uses Std.Arrays, Std.Conv, Std.Dictionaries, Std.Json, Std.Math, Std.Options, Std.Str;

public const
  // Wire compatibility version required during the hello/welcome handshake.
  ProtocolVersion: integer := 1;
  // Maximum UTF-8 payload before the terminating line feed.
  MaximumLineBytes: integer := 65536;

public type
  // Selects the renderer the client must use for a visible state.
  ViewKind = enum
    Map;
  end;
  // Client-safe map projection; dimensions, rows, and player coordinates must agree.
  VisibleState = record
    public View: ViewKind;
    public Width: integer;
    public Height: integer;
    public Rows: array of string;
    public PlayerX: integer;
    public PlayerY: integer;
  end;
  // Session setup, player intentions, and lifecycle messages accepted by the server.
  ClientMessage = enum
    Hello(Version: integer);
    Move(DeltaX: integer; DeltaY: integer);
    Disconnect;
  end;
  // Handshake, visible state, and structured outcomes returned by the server.
  ServerMessage = enum
    Welcome(Version: integer);
    State(Value: VisibleState);
    Rejected(Code: string; Message: string);
    ErrorMessage(Code: string; Message: string);
  end;

function RequiredField(Fields: dict of string to JsonValue; Name: string): result of JsonValue, string;
begin
  case Std.Dictionaries.Get(Fields, Name) of
    Some(Value):
    begin
      return Ok(Value)
    end;
    None:
    begin
      return Error('message is missing field ' + Name)
    end
  end
end;

function ViewName(Value: ViewKind): string;
begin
  case Value of
    ViewKind.Map:
    begin
      return 'map'
    end
  end
end;

function DecodeView(Value: string): result of ViewKind, string;
begin
  case Value of
    'map':
    begin
      return Ok(ViewKind.Map)
    end
    else
    begin
      return Error('unknown visible-state view')
    end
  end
end;

function EncodeRows(Rows: array of string): array of JsonValue;
begin
  mutable var Values: array of JsonValue := [];
  for Row: string in Rows do
  begin
    Values := Std.Arrays.Concat(Values, [JsonValue.String(Row)])
  end;

  return Values
end;

function StringArrayField(Fields: dict of string to JsonValue; Name: string): result of array of string, string;
begin
  case try RequiredField(Fields, Name) of
    JsonValue.ArrayValue(Items):
    begin
      mutable var Values: array of string := [];
      for Item: JsonValue in Items do
      begin
        case Item of
          JsonValue.String(Value):
          begin
            Values := Std.Arrays.Concat(Values, [Value])
          end
          else
          begin
            return Error(('message field ' + Name) + ' must contain only strings')
          end
        end
      end;

      return Ok(Values)
    end
    else
    begin
      return Error(('message field ' + Name) + ' must be an array')
    end
  end
end;

function ValidateVisibleState(Value: VisibleState): result of VisibleState, string;
begin
  if (Value.Width <= 0) or (Value.Height <= 0) then
  begin
    return Error('visible-state dimensions must be positive')
  end;

  if Std.Arrays.Length(Value.Rows) <> Value.Height then
  begin
    return Error('visible-state row count must match height')
  end;

  for Row: string in Value.Rows do
  begin
    if Std.Str.Length(Row) <> Value.Width then
    begin
      return Error('visible-state row width must match width')
    end
  end;

  if (((Value.PlayerX < 0) or (Value.PlayerX >= Value.Width)) or (Value.PlayerY < 0)) or
     (Value.PlayerY >= Value.Height) then
  begin
    return Error('visible-state player position is outside the area')
  end;

  return Ok(Value)
end;

function StringField(Fields: dict of string to JsonValue; Name: string): result of string, string;
begin
  case try RequiredField(Fields, Name) of
    JsonValue.String(Value):
    begin
      return Ok(Value)
    end
    else
    begin
      return Error(('message field ' + Name) + ' must be a string')
    end
  end
end;

function IntegerField(Fields: dict of string to JsonValue; Name: string): result of integer, string;
begin
  case try RequiredField(Fields, Name) of
    JsonValue.Number(Value):
    begin
      var IntegerValue: integer := Trunc(Value);
      if IntToReal(IntegerValue) <> Value then
      begin
        return Error(('message field ' + Name) + ' must be an integer')
      end;

      return Ok(IntegerValue)
    end
    else
    begin
      return Error(('message field ' + Name) + ' must be a number')
    end
  end
end;

function ObjectFields(Text: string): result of dict of string to JsonValue, string;
begin
  case try Std.Json.Parse(Text) of
    JsonValue.Object(Fields):
    begin
      return Ok(Fields)
    end
    else
    begin
      return Error('message root must be an object')
    end
  end
end;

// Encodes one client message as a compact JSON object for line transport.
public function EncodeClient(Message: ClientMessage): string;
begin
  case Message of
    ClientMessage.Hello(Version):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('hello'), 'version': JsonValue.Number(IntToReal(Version))]))
    end;
    ClientMessage.Move(DeltaX, DeltaY):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('move'), 'dx': JsonValue.Number(IntToReal(DeltaX)), 'dy': JsonValue.Number(IntToReal(DeltaY))]))
    end;
    ClientMessage.Disconnect:
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('disconnect')]))
    end
  end
end;

// Decodes one client message and rejects missing, mistyped, or unknown fields.
public function DecodeClient(Text: string): result of ClientMessage, string;
begin
  var Fields: dict of string to JsonValue := try ObjectFields(Text);
  case try StringField(Fields, 'type') of
    'hello':
    begin
      return Ok(ClientMessage.Hello(try IntegerField(Fields, 'version')))
    end;
    'move':
    begin
      return Ok(ClientMessage.Move(try IntegerField(Fields, 'dx'), try IntegerField(Fields, 'dy')))
    end;
    'disconnect':
    begin
      return Ok(ClientMessage.Disconnect)
    end
    else
    begin
      return Error('unknown client message type')
    end
  end
end;

// Encodes one server message as a compact JSON object for line transport.
public function EncodeServer(Message: ServerMessage): string;
begin
  case Message of
    ServerMessage.Welcome(Version):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('welcome'), 'version': JsonValue.Number(IntToReal(Version))]))
    end;
    ServerMessage.State(Value):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('state'), 'view': JsonValue.String(ViewName(Value.View)), 'width': JsonValue.Number(IntToReal(Value.Width)), 'height': JsonValue.Number(IntToReal(Value.Height)), 'rows': JsonValue.ArrayValue(EncodeRows(Value.Rows)), 'x': JsonValue.Number(IntToReal(Value.PlayerX)), 'y': JsonValue.Number(IntToReal(Value.PlayerY))]))
    end;
    ServerMessage.Rejected(Code, MessageText):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('rejected'), 'code': JsonValue.String(Code), 'message': JsonValue.String(MessageText)]))
    end;
    ServerMessage.ErrorMessage(Code, MessageText):
    begin
      return Stringify(JsonValue.Object(['type': JsonValue.String('error'), 'code': JsonValue.String(Code), 'message': JsonValue.String(MessageText)]))
    end
  end
end;

// Decodes one server message and validates visible-state dimensions and coordinates.
public function DecodeServer(Text: string): result of ServerMessage, string;
begin
  var Fields: dict of string to JsonValue := try ObjectFields(Text);
  case try StringField(Fields, 'type') of
    'welcome':
    begin
      return Ok(ServerMessage.Welcome(try IntegerField(Fields, 'version')))
    end;
    'state':
    begin
      var Value: VisibleState := record
        View := try DecodeView(try StringField(Fields, 'view'));
        Width := try IntegerField(Fields, 'width');
        Height := try IntegerField(Fields, 'height');
        Rows := try StringArrayField(Fields, 'rows');
        PlayerX := try IntegerField(Fields, 'x');
        PlayerY := try IntegerField(Fields, 'y');
      end;

      return Ok(ServerMessage.State(try ValidateVisibleState(Value)))
    end;
    'rejected':
    begin
      return Ok(ServerMessage.Rejected(try StringField(Fields, 'code'), try StringField(Fields, 'message')))
    end;
    'error':
    begin
      return Ok(ServerMessage.ErrorMessage(try StringField(Fields, 'code'), try StringField(Fields, 'message')))
    end
    else
    begin
      return Error('unknown server message type')
    end
  end
end;
