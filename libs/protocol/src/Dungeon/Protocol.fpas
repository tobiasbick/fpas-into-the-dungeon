// Returns whether one character belongs to the outdoor map-row alphabet, including UnknownFieldCode.
public function IsMapCellCode(Value: string): boolean;
begin
  return Std.Arrays.Contains([
                               UnknownFieldCode,
                               MapGrassCode,
                               MapTreeCode,
                               MapForestCode,
                               MapDesertCode,
                               MapMountainCode,
                               MapSeaCode,
                               MapRiverCode,
                               MapLakeCode,
                               MapPathCode,
                               MapEntranceCode
                             ], Value)
end;

// Returns whether one character belongs to the interior-row alphabet, including UnknownFieldCode.
public function IsInteriorCellCode(Value: string): boolean;
begin
  return Std.Arrays.Contains([
                               UnknownFieldCode,
                               InteriorWallCode,
                               InteriorFloorCode,
                               InteriorExitCode,
                               InteriorTabletCode,
                               InteriorItemCode,
                               InteriorWeaponCode,
                               InteriorArmorCode,
                               InteriorNpcCode,
                               InteriorHostileCode
                             ], Value)
end;

function IsKnowledgeCode(Value: string): boolean;
begin
  return Std.Arrays.Contains([
                               KnowledgeUndiscoveredCode,
                               KnowledgeRememberedCode,
                               KnowledgeVisibleCode
                             ], Value)
end;

function ValidateKnowledgeRows(
  Rows: array of string;
  KnowledgeRows: array of string;
  Width: integer;
  Height: integer
): result of boolean, string;
begin
  if Std.Arrays.Length(KnowledgeRows) <> Height then
  begin
    return Error('knowledge row count must match height')
  end;

  for Y: integer := 0 to Height - 1 do
  begin
    if Std.Str.Length(KnowledgeRows[Y]) <> Width then
    begin
      return Error('knowledge row width must match width')
    end;

    for X: integer := 0 to Width - 1 do
    begin
      var KnowledgeCode: string := Std.Str.CharAt(KnowledgeRows[Y], X);
      var TerrainCode: string := Std.Str.CharAt(Rows[Y], X);
      if not IsKnowledgeCode(KnowledgeCode) then
      begin
        return Error('knowledge row contains an unknown field code')
      end;

      if (KnowledgeCode = KnowledgeUndiscoveredCode) and (TerrainCode <> UnknownFieldCode) then
      begin
        return Error('undiscovered field must not expose terrain')
      end;

      if (KnowledgeCode <> KnowledgeUndiscoveredCode) and (TerrainCode = UnknownFieldCode) then
      begin
        return Error('known field must include terrain')
      end
    end
  end;

  return Ok(true)
end;

function EncodeRows(Rows: array of string): array of JsonValue;
begin
  return Std.Arrays.Map(Rows, function(Row: string): JsonValue begin
    return JsonValue.String(Row)
  end)
end;

function ItemSlotName(Value: VisibleItemSlot): string;
begin
  case Value of
    VisibleItemSlot.NoSlot:
    begin
      return ''
    end;
    VisibleItemSlot.Weapon:
    begin
      return 'weapon'
    end;
    VisibleItemSlot.Body:
    begin
      return 'body'
    end
  end
end;

function DecodeItemSlot(Value: string): result of VisibleItemSlot, string;
begin
  case Value of
    '':
    begin
      return Ok(VisibleItemSlot.NoSlot)
    end;
    'weapon':
    begin
      return Ok(VisibleItemSlot.Weapon)
    end;
    'body':
    begin
      return Ok(VisibleItemSlot.Body)
    end
    else
    begin
      return Error('visible inventory item has an unknown slot')
    end
  end
end;

