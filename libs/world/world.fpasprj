[project]
name = "dungeon-world"
kind = "library"

[dependencies]
workspace = ["dungeon-game"]

[exports]
units = [
  "Dungeon.World",
  "Dungeon.World.Catalog",
  "Dungeon.World.Areas.Errors",
  "Dungeon.World.Areas",
  "Dungeon.World.Settlements.Encoding",
  "Dungeon.World.Settlements",
  "Dungeon.World.Interiors.Encoding",
  "Dungeon.World.Interiors",
  "Dungeon.World.Quests",
  "Dungeon.World.Savegame.Errors",
  "Dungeon.World.Savegame.Progression",
  "Dungeon.World.Savegame"
]

[sources]
include = ["src/**/*.fpas"]
