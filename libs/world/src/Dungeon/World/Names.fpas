// Persisted JSON names of item kinds, opponent kinds, and facings shared by savegames and level files.
unit Dungeon.World.Names;

uses Dungeon.Coordinates as Coordinates, Dungeon.Hostiles as Hostiles, Dungeon.Items as Items;

// Returns the persisted name of an item kind.
public function ItemKindName(Value: Items.ItemKind): string;
begin
  case Value of
    when Items.ItemKind.AncientCoin:
      begin
        return 'ancient_coin';
      end;
    when Items.ItemKind.RustyShortSword:
      begin
        return 'rusty_short_sword';
      end;
    when Items.ItemKind.LeatherJerkin:
      begin
        return 'leather_jerkin';
      end;
  end case;
end function;

// Parses a persisted item kind name.
public function DecodeItemKind(Value: string): result of (Items.ItemKind, string);
begin
  case Value of
    when 'ancient_coin':
      begin
        return Ok(Items.ItemKind.AncientCoin);
      end;
    when 'rusty_short_sword':
      begin
        return Ok(Items.ItemKind.RustyShortSword);
      end;
    when 'leather_jerkin':
      begin
        return Ok(Items.ItemKind.LeatherJerkin);
      end;
    else
      begin
        return Error('unknown item kind');
      end;
  end case;
end function;

// Returns the persisted name of an opponent kind.
public function HostileKindName(Value: Hostiles.HostileKind): string;
begin
  case Value of
    when Hostiles.HostileKind.RestlessSkeleton:
      begin
        return 'restless_skeleton';
      end;
  end case;
end function;

// Parses a persisted opponent kind name.
public function DecodeHostileKind(Value: string): result of (Hostiles.HostileKind, string);
begin
  case Value of
    when 'restless_skeleton':
      begin
        return Ok(Hostiles.HostileKind.RestlessSkeleton);
      end;
    else
      begin
        return Error('unknown opponent kind');
      end;
  end case;
end function;

// Returns the persisted name of a facing direction.
public function FacingName(Value: Coordinates.FacingDirection): string;
begin
  case Value of
    when Coordinates.FacingDirection.North:
      begin
        return 'north';
      end;
    when Coordinates.FacingDirection.East:
      begin
        return 'east';
      end;
    when Coordinates.FacingDirection.South:
      begin
        return 'south';
      end;
    when Coordinates.FacingDirection.West:
      begin
        return 'west';
      end;
  end case;
end function;

// Parses a persisted facing direction name.
public function DecodeFacing(Value: string): result of (Coordinates.FacingDirection, string);
begin
  case Value of
    when 'north':
      begin
        return Ok(Coordinates.FacingDirection.North);
      end;
    when 'east':
      begin
        return Ok(Coordinates.FacingDirection.East);
      end;
    when 'south':
      begin
        return Ok(Coordinates.FacingDirection.South);
      end;
    when 'west':
      begin
        return Ok(Coordinates.FacingDirection.West);
      end;
    else
      begin
        return Error('unknown facing direction');
      end;
  end case;
end function;
end unit;
