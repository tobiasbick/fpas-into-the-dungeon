// Persisted JSON names of item kinds, opponent kinds, and facings shared by savegames and level files.
unit Dungeon.World.Names;

uses Dungeon.Coordinates as Coordinates, Dungeon.Hostiles as HostileRules, Dungeon.Items as ItemRules;

// Returns the persisted name of an item kind.
public function ItemKindName(Value: ItemRules.ItemKind): string;
begin
  case Value of
    when ItemRules.ItemKind.AncientCoin:
      begin
        return 'ancient_coin';
      end;
    when ItemRules.ItemKind.RustyShortSword:
      begin
        return 'rusty_short_sword';
      end;
    when ItemRules.ItemKind.LeatherJerkin:
      begin
        return 'leather_jerkin';
      end;
    when ItemRules.ItemKind.HealingPotion:
      return 'healing_potion';
    when ItemRules.ItemKind.MarasCompass:
      return 'maras_compass';
  end case;
end function;

// Parses a persisted item kind name.
public function DecodeItemKind(Value: string): result of (ItemRules.ItemKind, string);
begin
  case Value of
    when 'ancient_coin':
      begin
        return Ok(ItemRules.ItemKind.AncientCoin);
      end;
    when 'rusty_short_sword':
      begin
        return Ok(ItemRules.ItemKind.RustyShortSword);
      end;
    when 'leather_jerkin':
      begin
        return Ok(ItemRules.ItemKind.LeatherJerkin);
      end;
    when 'healing_potion':
      return Ok(ItemRules.ItemKind.HealingPotion);
    when 'maras_compass':
      return Ok(ItemRules.ItemKind.MarasCompass);
    else
      begin
        return Error('unknown item kind');
      end;
  end case;
end function;

// Returns the persisted name of an opponent kind.
public function HostileKindName(Value: HostileRules.HostileKind): string;
begin
  case Value of
    when HostileRules.HostileKind.RestlessSkeleton:
      begin
        return 'restless_skeleton';
      end;
    when HostileRules.HostileKind.GiantRat:
      return 'giant_rat';
  end case;
end function;

// Parses a persisted opponent kind name.
public function DecodeHostileKind(Value: string): result of (HostileRules.HostileKind, string);
begin
  case Value of
    when 'restless_skeleton':
      begin
        return Ok(HostileRules.HostileKind.RestlessSkeleton);
      end;
    when 'giant_rat':
      return Ok(HostileRules.HostileKind.GiantRat);
    else
      begin
        return Error('unknown opponent kind');
      end;
  end case;
end function;

// Returns the persisted name of a facing direction.
public function FacingName(Value: Coordinates.FacingDirection): string;
begin
  case Value of
    when Coordinates.FacingDirection.North:
      begin
        return 'north';
      end;
    when Coordinates.FacingDirection.East:
      begin
        return 'east';
      end;
    when Coordinates.FacingDirection.South:
      begin
        return 'south';
      end;
    when Coordinates.FacingDirection.West:
      begin
        return 'west';
      end;
  end case;
end function;

// Parses a persisted facing direction name.
public function DecodeFacing(Value: string): result of (Coordinates.FacingDirection, string);
begin
  case Value of
    when 'north':
      begin
        return Ok(Coordinates.FacingDirection.North);
      end;
    when 'east':
      begin
        return Ok(Coordinates.FacingDirection.East);
      end;
    when 'south':
      begin
        return Ok(Coordinates.FacingDirection.South);
      end;
    when 'west':
      begin
        return Ok(Coordinates.FacingDirection.West);
      end;
    else
      begin
        return Error('unknown facing direction');
      end;
  end case;
end function;
end unit;
