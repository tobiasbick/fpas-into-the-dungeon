// Persisted JSON names of item kinds, opponent kinds, and facings shared by savegames and level files.
unit Dungeon.World.Names;

uses Dungeon.Coordinates, Dungeon.Hostiles, Dungeon.Items;

// Returns the persisted name of an item kind.
public function ItemKindName(Value: ItemKind): string;
begin
  case Value of
    ItemKind.AncientCoin:
    begin
      return 'ancient_coin'
    end;
    ItemKind.RustyShortSword:
    begin
      return 'rusty_short_sword'
    end;
    ItemKind.LeatherJerkin:
    begin
      return 'leather_jerkin'
    end
  end
end;

// Parses a persisted item kind name.
public function DecodeItemKind(Value: string): result of ItemKind, string;
begin
  case Value of
    'ancient_coin':
    begin
      return Ok(ItemKind.AncientCoin)
    end;
    'rusty_short_sword':
    begin
      return Ok(ItemKind.RustyShortSword)
    end;
    'leather_jerkin':
    begin
      return Ok(ItemKind.LeatherJerkin)
    end
    else
    begin
      return Error('unknown item kind')
    end
  end
end;

// Returns the persisted name of an opponent kind.
public function HostileKindName(Value: HostileKind): string;
begin
  case Value of
    HostileKind.RestlessSkeleton:
    begin
      return 'restless_skeleton'
    end
  end
end;

// Parses a persisted opponent kind name.
public function DecodeHostileKind(Value: string): result of HostileKind, string;
begin
  case Value of
    'restless_skeleton':
    begin
      return Ok(HostileKind.RestlessSkeleton)
    end
    else
    begin
      return Error('unknown opponent kind')
    end
  end
end;

// Returns the persisted name of a facing direction.
public function FacingName(Value: FacingDirection): string;
begin
  case Value of
    FacingDirection.North:
    begin
      return 'north'
    end;
    FacingDirection.East:
    begin
      return 'east'
    end;
    FacingDirection.South:
    begin
      return 'south'
    end;
    FacingDirection.West:
    begin
      return 'west'
    end
  end
end;

// Parses a persisted facing direction name.
public function DecodeFacing(Value: string): result of FacingDirection, string;
begin
  case Value of
    'north':
    begin
      return Ok(FacingDirection.North)
    end;
    'east':
    begin
      return Ok(FacingDirection.East)
    end;
    'south':
    begin
      return Ok(FacingDirection.South)
    end;
    'west':
    begin
      return Ok(FacingDirection.West)
    end
    else
    begin
      return Error('unknown facing direction')
    end
  end
end;
