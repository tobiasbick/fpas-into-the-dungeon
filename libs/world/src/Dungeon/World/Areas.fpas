// Read-only resolution of all visited finite areas for complete save validation.
unit Dungeon.World.Areas;

uses
  Dungeon.GameState as GameState, Dungeon.Interior as InteriorUnit, Dungeon.World as WorldUnit,
  Dungeon.World.Interiors as Interiors, Dungeon.World.Settlements as Settlements,
  Dungeon.World.Areas.Errors as Errors;

// Resolves authored home geometry or existing immutable village/dungeon files exactly once per visit.
// Missing or invalid files remain errors, including for off-screen areas; no generation or writes occur.
public function ReadVisitedAreas(World: WorldUnit.WorldSession; State: GameState.GameState): result of (array of InteriorUnit.InteriorMap, Errors.AreaFailure);
begin
  var Maps: array of InteriorUnit.InteriorMap := [];
  for AreaId: string in State.VisitedAreas do
    if AreaId.StartsWith(World.Metadata.Id + ':settlement:') then
      Maps.PushInPlace(try Settlements.ReadMap(World, AreaId));
    else
      Maps.PushInPlace(try Interiors.ReadLevel(World, AreaId));
    end if;
  end for;

  return Ok(Maps);
end function;
end unit;
