// Typed failures of dungeon level storage, kept apart so callers never classify errors by text.
unit Dungeon.World.Interiors.Errors;

public type
  // Missing: no level file exists; Invalid: the file or requested identity is unusable;
  // Io: the filesystem failed; Generation: a first-visit level could not be generated.
  LevelFailure = enum
    Missing(AreaId: string);
    Invalid(AreaId: string; Reason: string);
    Io(Reason: string);
    Generation(AreaId: string; Reason: string);
  end;
