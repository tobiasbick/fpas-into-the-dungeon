// Savegame JSON of the area kind, player position, facing, and return location.
unit Dungeon.World.Savegame.Player;

uses
  Dungeon.Coordinates, Dungeon.World.Names, Std.Conv, Std.Dictionaries, Std.Json, Std.Json.Fields;

// Returns the savegame name of an area kind.
public function AreaKindName(Value: AreaKind): string;
begin
  case Value of
    when AreaKind.OutdoorRegion:
      begin
        return 'outdoor_region';
      end;
    when AreaKind.Settlement:
      begin
        return 'settlement';
      end;
    when AreaKind.Interior:
      begin
        return 'interior';
      end;
    when AreaKind.Dungeon:
      begin
        return 'dungeon';
      end;
  end case;
end function;

// Decodes an area kind name; unknown names are an error.
public function DecodeAreaKind(Value: string): result of AreaKind, string;
begin
  case Value of
    when 'outdoor_region':
      begin
        return Ok(AreaKind.OutdoorRegion);
      end;
    when 'settlement':
      begin
        return Ok(AreaKind.Settlement);
      end;
    when 'interior':
      begin
        return Ok(AreaKind.Interior);
      end;
    when 'dungeon':
      begin
        return Ok(AreaKind.Dungeon);
      end;
    else
      begin
        return Error('savegame contains an unknown area kind');
      end;
  end case;
end function;

// Encodes the player position with its kind, coordinates, and first-person facing.
public function EncodePlayer(Value: PlayerPosition): JsonValue;
begin
  case Value of
    when PlayerPosition.Outdoor(Position):
      begin
        return JsonValue.Object(['kind': JsonValue.String('outdoor'), 'x': JsonValue.Number(IntToReal(Position.X)), 'y': JsonValue.Number(IntToReal(Position.Y))]);
      end;
    when PlayerPosition.FirstPerson(Pose):
      begin
        return JsonValue.Object(['kind': JsonValue.String('first_person'), 'x': JsonValue.Number(IntToReal(Pose.Position.X)), 'y': JsonValue.Number(IntToReal(Pose.Position.Y)), 'facing': JsonValue.String(FacingName(Pose.Facing))]);
      end;
  end case;
end function;

// Decodes an exact player position object; extra or missing fields are an error.
public function DecodePlayer(Fields: dict of string to JsonValue): result of PlayerPosition, string;
begin
  case try StringField(Fields, 'kind') of
    when 'outdoor':
      begin
        if Std.Dictionaries.Length(Fields) <> 3 then
          begin
            return Error('outdoor player must contain only kind, x, and y');
          end;
        end if;

        return Ok(PlayerPosition.Outdoor(record
          X := try IntegerField(Fields, 'x');
          Y := try IntegerField(Fields, 'y');
        end));
      end;
    when 'first_person':
      begin
        if Std.Dictionaries.Length(Fields) <> 4 then
          begin
            return Error('first-person player must contain only kind, x, y, and facing');
          end;
        end if;

        return Ok(PlayerPosition.FirstPerson(record
          Position := record
            X := try IntegerField(Fields, 'x');
            Y := try IntegerField(Fields, 'y');
          end;
          Facing := try DecodeFacing(try StringField(Fields, 'facing'));
        end));
      end;
    else
      begin
        return Error('savegame contains an unknown player position kind');
      end;
  end case;
end function;

// Encodes the optional return location.
public function EncodeReturnLocation(Value: ReturnLocation): JsonValue;
begin
  case Value of
    when ReturnLocation.NoReturnLocation:
      begin
        return JsonValue.Object(['kind': JsonValue.String('none')]);
      end;
    when ReturnLocation.ReturnTo(AreaId, Position):
      begin
        return JsonValue.Object(['kind': JsonValue.String('outdoor'), 'area_id': JsonValue.String(AreaId), 'x': JsonValue.Number(IntToReal(Position.X)), 'y': JsonValue.Number(IntToReal(Position.Y))]);
      end;
  end case;
end function;

// Decodes an exact return location object; extra or missing fields are an error.
public function DecodeReturnLocation(Fields: dict of string to JsonValue): result of ReturnLocation, string;
begin
  case try StringField(Fields, 'kind') of
    when 'none':
      begin
        if Std.Dictionaries.Length(Fields) <> 1 then
          begin
            return Error('empty return location must contain only kind');
          end;
        end if;

        return Ok(ReturnLocation.NoReturnLocation);
      end;
    when 'outdoor':
      begin
        if Std.Dictionaries.Length(Fields) <> 4 then
          begin
            return Error('outdoor return location must contain only kind, area_id, x, and y');
          end;
        end if;

        return Ok(ReturnLocation.ReturnTo(try StringField(Fields, 'area_id'), record
          X := try IntegerField(Fields, 'x');
          Y := try IntegerField(Fields, 'y');
        end));
      end;
    else
      begin
        return Error('savegame contains an unknown return-location kind');
      end;
  end case;
end function;
end unit;
