// Savegame JSON of the area kind, player position, facing, and return location.
unit Dungeon.World.Savegame.Player;

uses Dungeon.Coordinates as Coordinates, Dungeon.World.Names as NamesUnit, Std.Math as Math, Std.Encoding.Json as Json, Std.Encoding.Json.Fields as JsonFields;

// Renders typed library failures at this unit's application-owned text boundary.
function FailureMessage<E: Error>(Cause: E): string;
begin
  return Cause.Message();
end function;

// Returns the savegame name of an area kind.
public function AreaKindName(Value: Coordinates.AreaKind): string;
begin
  case Value of
    when Coordinates.AreaKind.OutdoorRegion:
      begin
        return 'outdoor_region';
      end;
    when Coordinates.AreaKind.Settlement:
      begin
        return 'settlement';
      end;
    when Coordinates.AreaKind.Interior:
      begin
        return 'interior';
      end;
    when Coordinates.AreaKind.Dungeon:
      begin
        return 'dungeon';
      end;
  end case;
end function;

// Decodes an area kind name; unknown names are an error.
public function DecodeAreaKind(Value: string): result of (Coordinates.AreaKind, string);
begin
  case Value of
    when 'outdoor_region':
      begin
        return Ok(Coordinates.AreaKind.OutdoorRegion);
      end;
    when 'settlement':
      begin
        return Ok(Coordinates.AreaKind.Settlement);
      end;
    when 'interior':
      begin
        return Ok(Coordinates.AreaKind.Interior);
      end;
    when 'dungeon':
      begin
        return Ok(Coordinates.AreaKind.Dungeon);
      end;
    else
      begin
        return Error('savegame contains an unknown area kind');
      end;
  end case;
end function;

// Encodes the player position with its kind, coordinates, and first-person facing.
public function EncodePlayer(Value: Coordinates.PlayerPosition): Json.JsonValue;
begin
  case Value of
    when Coordinates.PlayerPosition.Outdoor(const Position):
      begin
        return Json.JsonValue.Object([
          'kind': Json.JsonValue.String('outdoor'),
          'x': Json.JsonValue.Number(Math.IntToReal(Position.X)),
          'y': Json.JsonValue.Number(Math.IntToReal(Position.Y))
        ]);
      end;
    when Coordinates.PlayerPosition.Settlement(const Position):
      return Json.JsonValue.Object([
        'kind': Json.JsonValue.String('settlement'),
        'x': Json.JsonValue.Number(Math.IntToReal(Position.X)),
        'y': Json.JsonValue.Number(Math.IntToReal(Position.Y))
      ]);
    when Coordinates.PlayerPosition.FirstPerson(const Pose):
      begin
        return Json.JsonValue.Object([
          'kind': Json.JsonValue.String('first_person'),
          'x': Json.JsonValue.Number(Math.IntToReal(Pose.Position.X)),
          'y': Json.JsonValue.Number(Math.IntToReal(Pose.Position.Y)),
          'facing': Json.JsonValue.String(NamesUnit.FacingName(Pose.Facing))
        ]);
      end;
  end case;
end function;

// Decodes an exact player position object; extra or missing fields are an error.
public function DecodePlayer(Fields: dict of string to Json.JsonValue): result of (Coordinates.PlayerPosition, string);
begin
  case try JsonFields.StringField(Fields, 'kind').MapError(FailureMessage) of
    when 'settlement':
      if Fields.Length() <> 3 then
        return Error('settlement player must contain only kind, x, and y');
      end if;

      return Ok(
        Coordinates.PlayerPosition.Settlement(
          Coordinates.InteriorPosition(
            X := try JsonFields.IntegerField(Fields, 'x').MapError(FailureMessage),
            Y := try JsonFields.IntegerField(Fields, 'y').MapError(FailureMessage)
          )
        )
      );
    when 'outdoor':
      begin
        if Fields.Length() <> 3 then
          begin
            return Error('outdoor player must contain only kind, x, and y');
          end;
        end if;

        return Ok(
          Coordinates.PlayerPosition.Outdoor(
            Coordinates.WorldPosition(
              X := try JsonFields.IntegerField(Fields, 'x').MapError(FailureMessage),
              Y := try JsonFields.IntegerField(Fields, 'y').MapError(FailureMessage)
            )
          )
        );
      end;
    when 'first_person':
      begin
        if Fields.Length() <> 4 then
          begin
            return Error('first-person player must contain only kind, x, y, and facing');
          end;
        end if;

        return Ok(
          Coordinates.PlayerPosition.FirstPerson(
            Coordinates.FirstPersonPose(
              Position := Coordinates.InteriorPosition(
                X := try JsonFields.IntegerField(Fields, 'x').MapError(FailureMessage),
                Y := try JsonFields.IntegerField(Fields, 'y').MapError(FailureMessage)
              ),
              Facing := try NamesUnit.DecodeFacing(
                try JsonFields.StringField(Fields, 'facing').MapError(FailureMessage)
              )
            )
          )
        );
      end;
    else
      begin
        return Error('savegame contains an unknown player position kind');
      end;
  end case;
end function;

// Encodes the optional return location.
public function EncodeReturnLocation(Value: Coordinates.ReturnLocation): Json.JsonValue;
begin
  case Value of
    when Coordinates.ReturnLocation.NoReturnLocation:
      begin
        return Json.JsonValue.Object(['kind': Json.JsonValue.String('none')]);
      end;
    when Coordinates.ReturnLocation.ReturnTo(const AreaId, const Position):
      begin
        return Json.JsonValue.Object([
          'kind': Json.JsonValue.String('outdoor'),
          'area_id': Json.JsonValue.String(AreaId),
          'x': Json.JsonValue.Number(Math.IntToReal(Position.X)),
          'y': Json.JsonValue.Number(Math.IntToReal(Position.Y))
        ]);
      end;
  end case;
end function;

// Decodes an exact return location object; extra or missing fields are an error.
public function DecodeReturnLocation(Fields: dict of string to Json.JsonValue): result of (Coordinates.ReturnLocation, string);
begin
  case try JsonFields.StringField(Fields, 'kind').MapError(FailureMessage) of
    when 'none':
      begin
        if Fields.Length() <> 1 then
          begin
            return Error('empty return location must contain only kind');
          end;
        end if;

        return Ok(Coordinates.ReturnLocation.NoReturnLocation);
      end;
    when 'outdoor':
      begin
        if Fields.Length() <> 4 then
          begin
            return Error('outdoor return location must contain only kind, area_id, x, and y');
          end;
        end if;

        return Ok(
          Coordinates.ReturnLocation.ReturnTo(
            try JsonFields.StringField(Fields, 'area_id').MapError(FailureMessage),
            Coordinates.WorldPosition(
              X := try JsonFields.IntegerField(Fields, 'x').MapError(FailureMessage),
              Y := try JsonFields.IntegerField(Fields, 'y').MapError(FailureMessage)
            )
          )
        );
      end;
    else
      begin
        return Error('savegame contains an unknown return-location kind');
      end;
  end case;
end function;
end unit;
