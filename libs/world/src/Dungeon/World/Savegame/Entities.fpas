// Savegame JSON of items and opponents.
unit Dungeon.World.Savegame.Entities;

uses Dungeon.Coordinates as Coordinates, Dungeon.Hostiles as HostileRules, Dungeon.Items as ItemRules, Dungeon.World.Names as Names, Std.Conv as Conv, Std.Json as Json, Std.Json.Fields as JsonFields;

function EquipmentSlotName(Value: ItemRules.EquipmentSlot): string;
begin
  case Value of
    when ItemRules.EquipmentSlot.Weapon:
      begin
        return 'weapon';
      end;
    when ItemRules.EquipmentSlot.Body:
      begin
        return 'body';
      end;
  end case;
end function;

function DecodeEquipmentSlot(Value: string): result of (ItemRules.EquipmentSlot, string);
begin
  case Value of
    when 'weapon':
      begin
        return Ok(ItemRules.EquipmentSlot.Weapon);
      end;
    when 'body':
      begin
        return Ok(ItemRules.EquipmentSlot.Body);
      end;
    else
      begin
        return Error('savegame contains an unknown equipment slot');
      end;
  end case;
end function;

function EncodeItemLocation(Value: ItemRules.ItemLocation): Json.JsonValue;
begin
  case Value of
    when ItemRules.ItemLocation.InInterior(const AreaId, const Position):
      begin
        return Json.JsonValue.Object([
          'kind': Json.JsonValue.String('interior'),
          'area_id': Json.JsonValue.String(AreaId),
          'x': Json.JsonValue.Number(Conv.IntToReal(Position.X)),
          'y': Json.JsonValue.Number(Conv.IntToReal(Position.Y))
        ]);
      end;
    when ItemRules.ItemLocation.CarriedByPlayer:
      begin
        return Json.JsonValue.Object(['kind': Json.JsonValue.String('carried')]);
      end;
    when ItemRules.ItemLocation.EquippedByPlayer(const Slot):
      begin
        return Json.JsonValue.Object([
          'kind': Json.JsonValue.String('equipped'),
          'slot': Json.JsonValue.String(EquipmentSlotName(Slot))
        ]);
      end;
  end case;
end function;

function DecodeItemLocation(Fields: dict of string to Json.JsonValue): result of (ItemRules.ItemLocation, string);
begin
  case try JsonFields.StringField(Fields, 'kind') of
    when 'interior':
      begin
        if Fields.Length() <> 4 then
          begin
            return Error('interior item location must contain only kind, area_id, x, and y');
          end;
        end if;

        return Ok(
          ItemRules.ItemLocation.InInterior(
            try JsonFields.StringField(Fields, 'area_id'),
            Coordinates.InteriorPosition(
              X := try JsonFields.IntegerField(Fields, 'x'),
              Y := try JsonFields.IntegerField(Fields, 'y')
            )
          )
        );
      end;
    when 'carried':
      begin
        if Fields.Length() <> 1 then
          begin
            return Error('carried item location must contain only kind');
          end;
        end if;

        return Ok(ItemRules.ItemLocation.CarriedByPlayer);
      end;
    when 'equipped':
      begin
        if Fields.Length() <> 2 then
          begin
            return Error('equipped item location must contain only kind and slot');
          end;
        end if;

        return Ok(
          ItemRules.ItemLocation.EquippedByPlayer(
            try DecodeEquipmentSlot(try JsonFields.StringField(Fields, 'slot'))
          )
        );
      end;
    else
      begin
        return Error('savegame contains an unknown item-location kind');
      end;
  end case;
end function;

// Encodes every item with identity, kind, and location.
public function EncodeItems(Items: array of ItemRules.GameItem): array of Json.JsonValue;
begin
  var Values: array of Json.JsonValue := [];
  for Item: ItemRules.GameItem in Items do
    begin
      Values.PushInPlace(
        Json.JsonValue.Object([
          'id': Json.JsonValue.String(Item.Id),
          'kind': Json.JsonValue.String(Names.ItemKindName(Item.Kind)),
          'location': EncodeItemLocation(Item.Location)
        ])
      );
    end;
  end for;

  return Values;
end function;

// Decodes exact item objects; the game state validates the complete set later.
public function DecodeItems(Items: array of Json.JsonValue): result of (array of ItemRules.GameItem, string);
begin
  var Values: array of ItemRules.GameItem := [];
  for Item: Json.JsonValue in Items do
    begin
      case Item of
        when Json.JsonValue.Object(const Fields):
          if Fields.Length() <> 3 then
            begin
              return Error('savegame item has an unexpected field set');
            end;
          end if;

          Values.PushInPlace(
            ItemRules.GameItem(
              Id := try JsonFields.StringField(Fields, 'id'),
              Kind := try Names.DecodeItemKind(try JsonFields.StringField(Fields, 'kind')),
              Location := try DecodeItemLocation(try JsonFields.ObjectField(Fields, 'location'))
            )
          );
        when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
          return Error('savegame items must contain only objects');
      end case;
    end;
  end for;

  return Ok(Values);
end function;

// Encodes every opponent, including destroyed ones.
public function EncodeHostiles(Hostiles: array of HostileRules.GameHostile): array of Json.JsonValue;
begin
  var Values: array of Json.JsonValue := [];
  for Hostile: HostileRules.GameHostile in Hostiles do
    begin
      Values.PushInPlace(
        Json.JsonValue.Object([
          'id': Json.JsonValue.String(Hostile.Id),
          'kind': Json.JsonValue.String(Names.HostileKindName(Hostile.Kind)),
          'area_id': Json.JsonValue.String(Hostile.AreaId),
          'x': Json.JsonValue.Number(Conv.IntToReal(Hostile.Position.X)),
          'y': Json.JsonValue.Number(Conv.IntToReal(Hostile.Position.Y)),
          'health': Json.JsonValue.Number(Conv.IntToReal(Hostile.Health)),
          'alerted': Json.JsonValue.Bool(Hostile.Alerted)
        ])
      );
    end;
  end for;

  return Values;
end function;

// Decodes exact opponent objects; the game state validates them later.
public function DecodeHostiles(Items: array of Json.JsonValue): result of (array of HostileRules.GameHostile, string);
begin
  var Hostiles: array of HostileRules.GameHostile := [];
  for Item: Json.JsonValue in Items do
    begin
      case Item of
        when Json.JsonValue.Object(const Fields):
          if Fields.Length() <> 7 then
            begin
              return Error('savegame opponent has an unexpected field set');
            end;
          end if;
          const Position: Coordinates.InteriorPosition := Coordinates.InteriorPosition(
            X := try JsonFields.IntegerField(Fields, 'x'),
            Y := try JsonFields.IntegerField(Fields, 'y')
          );
          const Hostile: HostileRules.GameHostile := HostileRules.GameHostile(
            Id := try JsonFields.StringField(Fields, 'id'),
            Kind := try Names.DecodeHostileKind(try JsonFields.StringField(Fields, 'kind')),
            AreaId := try JsonFields.StringField(Fields, 'area_id'),
            Position := Position,
            Health := try JsonFields.IntegerField(Fields, 'health'),
            Alerted := try JsonFields.BooleanField(Fields, 'alerted')
          );
          Hostiles.PushInPlace(Hostile);
        when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
          return Error('savegame opponents must be objects');
      end case;
    end;
  end for;

  return Ok(Hostiles);
end function;
end unit;
