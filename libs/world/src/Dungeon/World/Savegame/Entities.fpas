// Savegame JSON of items and opponents.
unit Dungeon.World.Savegame.Entities;

uses
  Dungeon.Coordinates, Dungeon.Hostiles, Dungeon.Items, Dungeon.World.Names, Std.Conv, Std.Json,
  Std.Json.Fields;

function EquipmentSlotName(Value: EquipmentSlot): string;
begin
  case Value of
    when EquipmentSlot.Weapon:
      begin
        return 'weapon';
      end;
    when EquipmentSlot.Body:
      begin
        return 'body';
      end;
  end case;
end function;

function DecodeEquipmentSlot(Value: string): result of (EquipmentSlot, string);
begin
  case Value of
    when 'weapon':
      begin
        return Ok(EquipmentSlot.Weapon);
      end;
    when 'body':
      begin
        return Ok(EquipmentSlot.Body);
      end;
    else
      begin
        return Error('savegame contains an unknown equipment slot');
      end;
  end case;
end function;

function EncodeItemLocation(Value: ItemLocation): JsonValue;
begin
  case Value of
    when ItemLocation.InInterior(const AreaId, const Position):
      begin
        return JsonValue.Object(['kind': JsonValue.String('interior'), 'area_id': JsonValue.String(AreaId), 'x': JsonValue.Number(IntToReal(Position.X)), 'y': JsonValue.Number(IntToReal(Position.Y))]);
      end;
    when ItemLocation.CarriedByPlayer:
      begin
        return JsonValue.Object(['kind': JsonValue.String('carried')]);
      end;
    when ItemLocation.EquippedByPlayer(const Slot):
      begin
        return JsonValue.Object(['kind': JsonValue.String('equipped'), 'slot': JsonValue.String(EquipmentSlotName(Slot))]);
      end;
  end case;
end function;

function DecodeItemLocation(Fields: dict of string to JsonValue): result of (ItemLocation, string);
begin
  case try StringField(Fields, 'kind') of
    when 'interior':
      begin
        if Fields.Length() <> 4 then
          begin
            return Error('interior item location must contain only kind, area_id, x, and y');
          end;
        end if;

        return Ok(ItemLocation.InInterior(try StringField(Fields, 'area_id'), InteriorPosition(X := try IntegerField(Fields, 'x'), Y := try IntegerField(Fields, 'y'))));
      end;
    when 'carried':
      begin
        if Fields.Length() <> 1 then
          begin
            return Error('carried item location must contain only kind');
          end;
        end if;

        return Ok(ItemLocation.CarriedByPlayer);
      end;
    when 'equipped':
      begin
        if Fields.Length() <> 2 then
          begin
            return Error('equipped item location must contain only kind and slot');
          end;
        end if;

        return Ok(ItemLocation.EquippedByPlayer(try DecodeEquipmentSlot(try StringField(Fields, 'slot'))));
      end;
    else
      begin
        return Error('savegame contains an unknown item-location kind');
      end;
  end case;
end function;

// Encodes every item with identity, kind, and location.
public function EncodeItems(Items: array of GameItem): array of JsonValue;
begin
  var Values: array of JsonValue := [];
  for Item: GameItem in Items do
    begin
      Values.Push(JsonValue.Object(['id': JsonValue.String(Item.Id), 'kind': JsonValue.String(ItemKindName(Item.Kind)), 'location': EncodeItemLocation(Item.Location)]));
    end;
  end for;

  return Values;
end function;

// Decodes exact item objects; the game state validates the complete set later.
public function DecodeItems(Items: array of JsonValue): result of (array of GameItem, string);
begin
  var Values: array of GameItem := [];
  for Item: JsonValue in Items do
    begin
      if Item is JsonValue.Object(const Fields) then
        begin
          if Fields.Length() <> 3 then
            begin
              return Error('savegame item has an unexpected field set');
            end;
          end if;

          Values.Push(GameItem(Id := try StringField(Fields, 'id'), Kind := try DecodeItemKind(try StringField(Fields, 'kind')), Location := try DecodeItemLocation(try ObjectField(Fields, 'location'))));
        end;
      else
        begin
          return Error('savegame items must contain only objects');
        end;
      end if;
    end;
  end for;

  return Ok(Values);
end function;

// Encodes every opponent, including destroyed ones.
public function EncodeHostiles(Hostiles: array of GameHostile): array of JsonValue;
begin
  var Values: array of JsonValue := [];
  for Hostile: GameHostile in Hostiles do
    begin
      Values.Push(JsonValue.Object(['id': JsonValue.String(Hostile.Id), 'kind': JsonValue.String(HostileKindName(Hostile.Kind)), 'area_id': JsonValue.String(Hostile.AreaId), 'x': JsonValue.Number(IntToReal(Hostile.Position.X)), 'y': JsonValue.Number(IntToReal(Hostile.Position.Y)), 'health': JsonValue.Number(IntToReal(Hostile.Health)), 'alerted': JsonValue.Bool(Hostile.Alerted)]));
    end;
  end for;

  return Values;
end function;

// Decodes exact opponent objects; the game state validates them later.
public function DecodeHostiles(Items: array of JsonValue): result of (array of GameHostile, string);
begin
  var Hostiles: array of GameHostile := [];
  for Item: JsonValue in Items do
    begin
      if Item is JsonValue.Object(const Fields) then
        begin
          if Fields.Length() <> 7 then
            begin
              return Error('savegame opponent has an unexpected field set');
            end;
          end if;
          const Position: InteriorPosition := InteriorPosition(X := try IntegerField(Fields, 'x'), Y := try IntegerField(Fields, 'y'));
          const Hostile: GameHostile := GameHostile(Id := try StringField(Fields, 'id'), Kind := try DecodeHostileKind(try StringField(Fields, 'kind')), AreaId := try StringField(Fields, 'area_id'), Position := Position, Health := try IntegerField(Fields, 'health'), Alerted := try BooleanField(Fields, 'alerted'));
          Hostiles.Push(Hostile);
        end;
      else
        begin
          return Error('savegame opponents must be objects');
        end;
      end if;
    end;
  end for;

  return Ok(Hostiles);
end function;
end unit;
