// Exact savegame NPC records; placement and active dialogue are never serialized.
unit Dungeon.World.Savegame.Npcs;

uses Dungeon.Npcs as NpcRules, Std.Json as Json, Std.Json.Fields as Fields;

// Encodes stable identity, kind, area and the explicit first-meeting flag in state order.
public function EncodeNpcs(Values: array of NpcRules.GameNpc): array of Json.JsonValue;
begin
  var Encoded: array of Json.JsonValue := [];
  for Npc: NpcRules.GameNpc in Values do
    Encoded.PushInPlace(
      Json.JsonValue.Object([
        'id': Json.JsonValue.String(Npc.Id), 'kind': Json.JsonValue.String('mara'),
        'area_id': Json.JsonValue.String(Npc.AreaId),
        'has_met_player': Json.JsonValue.Bool(Npc.HasMetPlayer)
      ])
    );
  end for;

  return Encoded;
end function;

// Requires exact typed objects and the known kind; game-state validation checks world identity and completeness.
public function DecodeNpcs(Values: array of Json.JsonValue): result of (array of NpcRules.GameNpc, string);
begin
  var Decoded: array of NpcRules.GameNpc := [];
  for Value: Json.JsonValue in Values do
    case Value of
      when Json.JsonValue.Object(const ObjectFields):
        const Known := try Fields.RequireOnlyFields(
          ObjectFields,
          ['id', 'kind', 'area_id', 'has_met_player']
        );
        if ObjectFields.Length() <> 4 then
          return Error('NPC record must contain id, kind, area_id and has_met_player');
        end if;

        if (try Fields.StringField(ObjectFields, 'kind')) <> 'mara' then
          return Error('unknown NPC kind');
        end if;

        Decoded.PushInPlace(
          NpcRules.GameNpc(
            Id := try Fields.StringField(ObjectFields, 'id'), Kind := NpcRules.NpcKind.Mara,
            AreaId := try Fields.StringField(ObjectFields, 'area_id'),
            HasMetPlayer := try Fields.BooleanField(ObjectFields, 'has_met_player')
          )
        );
      when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
        return Error('NPC records must be objects');
    end case;
  end for;

  return Ok(Decoded);
end function;
end unit;
