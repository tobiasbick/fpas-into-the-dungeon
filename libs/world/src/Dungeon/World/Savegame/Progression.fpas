// Savegame JSON of the two cumulative skill experience counters.
unit Dungeon.World.Savegame.Progression;

uses Dungeon.Progression as Progression, Std.Conv as Conv, Std.Json as Json, Std.Json.Fields as JsonFields;

// Encodes only the persisted counters; levels and bonuses are derived and never written.
public function EncodeProgression(Value: Progression.ProgressionState): Json.JsonValue;
begin
  return Json.JsonValue.Object([
    'unarmed_experience': Json.JsonValue.Number(Conv.IntToReal(Value.UnarmedExperience)),
    'blades_experience': Json.JsonValue.Number(Conv.IntToReal(Value.BladesExperience))
  ]);
end function;

// Decodes an exact two-field progression object with integer counters in range.
// Missing, extra or wrongly typed fields and out-of-range counters are errors.
public function DecodeProgression(Fields: dict of string to Json.JsonValue): result of (Progression.ProgressionState, string);
begin
  const OnlyKnown: boolean := try JsonFields.RequireOnlyFields(
    Fields,
    ['unarmed_experience', 'blades_experience']
  );
  if Fields.Length() <> 2 then
    return Error('progression must contain only unarmed_experience and blades_experience');
  end if;

  return Progression.ValidateProgression(
    Progression.ProgressionState(
      UnarmedExperience := try JsonFields.IntegerField(Fields, 'unarmed_experience'),
      BladesExperience := try JsonFields.IntegerField(Fields, 'blades_experience')
    )
  );
end function;
end unit;
