// Savegame JSON of outdoor and interior discovery masks.
unit Dungeon.World.Savegame.Discovery;

uses Dungeon.Coordinates as Coordinates, Dungeon.Exploration.Model as Model, Std.Math as Math, Std.Encoding.Json as Json, Std.Encoding.Json.Fields as JsonFields;

// Renders typed library failures at this unit's application-owned text boundary.
function FailureMessage<E: Error>(Cause: E): string;
begin
  return Cause.Message();
end function;

function EncodeMaskRows(Fields: array of boolean; Width: integer; Height: integer): array of Json.JsonValue;
begin
  var Rows: array of Json.JsonValue := [];
  for Y: integer := 0 to Height - 1 do
    begin
      var Row: string := '';
      for X: integer := 0 to Width - 1 do
        begin
          if Fields[(Y * Width) + X] then
            begin
              Row := Row + '1';
            end;
          else
            begin
              Row := Row + '0';
            end;
          end if;
        end;
      end for;

      Rows.PushInPlace(Json.JsonValue.String(Row));
    end;
  end for;

  return Rows;
end function;

function DecodeMaskRows(Rows: array of string; Width: integer; Height: integer): result of (array of boolean, string);
begin
  if Rows.Length() <> Height then
    begin
      return Error('savegame discovery mask has an unexpected row count');
    end;
  end if;
  var Fields: array of boolean := [];
  for Row: string in Rows do
    begin
      if Row.Length() <> Width then
        begin
          return Error('savegame discovery mask has an unexpected row width');
        end;
      end if;

      for X: integer := 0 to Width - 1 do
        begin
          case Row[X] of
            when '0':
              begin
                Fields.PushInPlace(false);
              end;
            when '1':
              begin
                Fields.PushInPlace(true);
              end;
            else
              begin
                return Error('savegame discovery mask contains an invalid field code');
              end;
          end case;
        end;
      end for;
    end;
  end for;

  return Ok(Fields);
end function;

function EncodeOutdoorDiscovery(Chunks: array of Model.OutdoorDiscoveryChunk): array of Json.JsonValue;
begin
  var Values: array of Json.JsonValue := [];
  for Chunk: Model.OutdoorDiscoveryChunk in Chunks do
    begin
      Values.PushInPlace(
        Json.JsonValue.Object([
          'chunk_x': Json.JsonValue.Number(Math.IntToReal(Chunk.ChunkX)),
          'chunk_y': Json.JsonValue.Number(Math.IntToReal(Chunk.ChunkY)),
          'rows': Json.JsonValue.ArrayValue(
            EncodeMaskRows(Chunk.Fields, Coordinates.WorldChunkSize, Coordinates.WorldChunkSize)
          )
        ])
      );
    end;
  end for;

  return Values;
end function;

function DecodeOutdoorDiscovery(Items: array of Json.JsonValue): result of (array of Model.OutdoorDiscoveryChunk, string);
begin
  var Chunks: array of Model.OutdoorDiscoveryChunk := [];
  for Item: Json.JsonValue in Items do
    begin
      case Item of
        when Json.JsonValue.Object(const Fields):
          if Fields.Length() <> 3 then
            begin
              return Error('outdoor discovery chunk has an unexpected field set');
            end;
          end if;

          Chunks.PushInPlace(
            Model.OutdoorDiscoveryChunk(
              ChunkX := try JsonFields.IntegerField(Fields, 'chunk_x').MapError(FailureMessage),
              ChunkY := try JsonFields.IntegerField(Fields, 'chunk_y').MapError(FailureMessage),
              Fields := try DecodeMaskRows(
                try JsonFields.StringArrayField(Fields, 'rows').MapError(FailureMessage),
                Coordinates.WorldChunkSize,
                Coordinates.WorldChunkSize
              )
            )
          );
        when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
          return Error('outdoor discovery must contain only objects');
      end case;
    end;
  end for;

  return Ok(Chunks);
end function;

function EncodeInteriorDiscovery(Areas: array of Model.InteriorDiscoveryArea): array of Json.JsonValue;
begin
  var Values: array of Json.JsonValue := [];
  for Area: Model.InteriorDiscoveryArea in Areas do
    begin
      Values.PushInPlace(
        Json.JsonValue.Object([
          'area_id': Json.JsonValue.String(Area.AreaId),
          'width': Json.JsonValue.Number(Math.IntToReal(Area.Width)),
          'height': Json.JsonValue.Number(Math.IntToReal(Area.Height)),
          'rows': Json.JsonValue.ArrayValue(EncodeMaskRows(Area.Fields, Area.Width, Area.Height))
        ])
      );
    end;
  end for;

  return Values;
end function;

function DecodeInteriorDiscovery(Items: array of Json.JsonValue): result of (array of Model.InteriorDiscoveryArea, string);
begin
  var Areas: array of Model.InteriorDiscoveryArea := [];
  for Item: Json.JsonValue in Items do
    begin
      case Item of
        when Json.JsonValue.Object(const Fields):
          if Fields.Length() <> 4 then
            begin
              return Error('interior discovery area has an unexpected field set');
            end;
          end if;
          const Width: integer := try JsonFields.IntegerField(
            Fields,
            'width'
          ).MapError(FailureMessage);
          const Height: integer := try JsonFields.IntegerField(
            Fields,
            'height'
          ).MapError(FailureMessage);
          if (Width < 1) or (Height < 1) then
            begin
              return Error('interior discovery dimensions must be positive');
            end;
          end if;

          Areas.PushInPlace(
            Model.InteriorDiscoveryArea(
              AreaId := try JsonFields.StringField(Fields, 'area_id').MapError(FailureMessage),
              Width := Width,
              Height := Height,
              Fields := try DecodeMaskRows(
                try JsonFields.StringArrayField(Fields, 'rows').MapError(FailureMessage),
                Width,
                Height
              )
            )
          );
        when Json.JsonValue.NullValue, Json.JsonValue.Bool(_), Json.JsonValue.Number(_), Json.JsonValue.String(_), Json.JsonValue.ArrayValue(_):
          return Error('interior discovery must contain only objects');
      end case;
    end;
  end for;

  return Ok(Areas);
end function;

// Encodes outdoor and interior discovery as mask rows.
public function EncodeExploration(State: Model.ExplorationState): Json.JsonValue;
begin
  return Json.JsonValue.Object([
    'outdoor_chunks': Json.JsonValue.ArrayValue(EncodeOutdoorDiscovery(State.OutdoorChunks)),
    'interior_areas': Json.JsonValue.ArrayValue(EncodeInteriorDiscovery(State.InteriorAreas))
  ]);
end function;

// Decodes and validates the exact discovery object.
public function DecodeExploration(Fields: dict of string to Json.JsonValue): result of (Model.ExplorationState, string);
begin
  if Fields.Length() <> 2 then
    begin
      return Error('savegame exploration has an unexpected field set');
    end;
  end if;
  const State: Model.ExplorationState := Model.ExplorationState(
    OutdoorChunks := try DecodeOutdoorDiscovery(
      try JsonFields.ArrayField(Fields, 'outdoor_chunks').MapError(FailureMessage)
    ),
    InteriorAreas := try DecodeInteriorDiscovery(
      try JsonFields.ArrayField(Fields, 'interior_areas').MapError(FailureMessage)
    )
  );
  return Model.ValidateExploration(State, Coordinates.WorldChunkSize);
end function;
end unit;
