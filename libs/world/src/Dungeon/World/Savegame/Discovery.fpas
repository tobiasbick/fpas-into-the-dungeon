// Savegame JSON of outdoor and interior discovery masks.
unit Dungeon.World.Savegame.Discovery;

uses Dungeon.Coordinates, Dungeon.Exploration.Model, Std.Conv, Std.Json, Std.Json.Fields;

function EncodeMaskRows(Fields: array of boolean; Width: integer; Height: integer): array of JsonValue;
begin
  var Rows: array of JsonValue := [];
  for Y: integer := 0 to Height - 1 do
    begin
      var Row: string := '';
      for X: integer := 0 to Width - 1 do
        begin
          if Fields[(Y * Width) + X] then
            begin
              Row := Row + '1';
            end;
          else
            begin
              Row := Row + '0';
            end;
          end if;
        end;
      end for;

      Rows.Push(JsonValue.String(Row));
    end;
  end for;

  return Rows;
end function;

function DecodeMaskRows(Rows: array of string; Width: integer; Height: integer): result of (array of boolean, string);
begin
  if Rows.Length() <> Height then
    begin
      return Error('savegame discovery mask has an unexpected row count');
    end;
  end if;
  var Fields: array of boolean := [];
  for Row: string in Rows do
    begin
      if Row.Length() <> Width then
        begin
          return Error('savegame discovery mask has an unexpected row width');
        end;
      end if;

      for X: integer := 0 to Width - 1 do
        begin
          case Row.CharAt(X) of
            when '0':
              begin
                Fields.Push(false);
              end;
            when '1':
              begin
                Fields.Push(true);
              end;
            else
              begin
                return Error('savegame discovery mask contains an invalid field code');
              end;
          end case;
        end;
      end for;
    end;
  end for;

  return Ok(Fields);
end function;

function EncodeOutdoorDiscovery(Chunks: array of OutdoorDiscoveryChunk): array of JsonValue;
begin
  var Values: array of JsonValue := [];
  for Chunk: OutdoorDiscoveryChunk in Chunks do
    begin
      Values.Push(JsonValue.Object(['chunk_x': JsonValue.Number(IntToReal(Chunk.ChunkX)), 'chunk_y': JsonValue.Number(IntToReal(Chunk.ChunkY)), 'rows': JsonValue.ArrayValue(EncodeMaskRows(Chunk.Fields, WorldChunkSize, WorldChunkSize))]));
    end;
  end for;

  return Values;
end function;

function DecodeOutdoorDiscovery(Items: array of JsonValue): result of (array of OutdoorDiscoveryChunk, string);
begin
  var Chunks: array of OutdoorDiscoveryChunk := [];
  for Item: JsonValue in Items do
    begin
      if Item is JsonValue.Object(const Fields) then
        begin
          if Fields.Length() <> 3 then
            begin
              return Error('outdoor discovery chunk has an unexpected field set');
            end;
          end if;

          Chunks.Push(OutdoorDiscoveryChunk(ChunkX := try IntegerField(Fields, 'chunk_x'), ChunkY := try IntegerField(Fields, 'chunk_y'), Fields := try DecodeMaskRows(try StringArrayField(Fields, 'rows'), WorldChunkSize, WorldChunkSize)));
        end;
      else
        begin
          return Error('outdoor discovery must contain only objects');
        end;
      end if;
    end;
  end for;

  return Ok(Chunks);
end function;

function EncodeInteriorDiscovery(Areas: array of InteriorDiscoveryArea): array of JsonValue;
begin
  var Values: array of JsonValue := [];
  for Area: InteriorDiscoveryArea in Areas do
    begin
      Values.Push(JsonValue.Object(['area_id': JsonValue.String(Area.AreaId), 'width': JsonValue.Number(IntToReal(Area.Width)), 'height': JsonValue.Number(IntToReal(Area.Height)), 'rows': JsonValue.ArrayValue(EncodeMaskRows(Area.Fields, Area.Width, Area.Height))]));
    end;
  end for;

  return Values;
end function;

function DecodeInteriorDiscovery(Items: array of JsonValue): result of (array of InteriorDiscoveryArea, string);
begin
  var Areas: array of InteriorDiscoveryArea := [];
  for Item: JsonValue in Items do
    begin
      if Item is JsonValue.Object(const Fields) then
        begin
          if Fields.Length() <> 4 then
            begin
              return Error('interior discovery area has an unexpected field set');
            end;
          end if;
          const Width: integer := try IntegerField(Fields, 'width');
          const Height: integer := try IntegerField(Fields, 'height');
          if (Width < 1) or (Height < 1) then
            begin
              return Error('interior discovery dimensions must be positive');
            end;
          end if;

          Areas.Push(InteriorDiscoveryArea(AreaId := try StringField(Fields, 'area_id'), Width := Width, Height := Height, Fields := try DecodeMaskRows(try StringArrayField(Fields, 'rows'), Width, Height)));
        end;
      else
        begin
          return Error('interior discovery must contain only objects');
        end;
      end if;
    end;
  end for;

  return Ok(Areas);
end function;

// Encodes outdoor and interior discovery as mask rows.
public function EncodeExploration(State: ExplorationState): JsonValue;
begin
  return JsonValue.Object(['outdoor_chunks': JsonValue.ArrayValue(EncodeOutdoorDiscovery(State.OutdoorChunks)), 'interior_areas': JsonValue.ArrayValue(EncodeInteriorDiscovery(State.InteriorAreas))]);
end function;

// Decodes and validates the exact discovery object.
public function DecodeExploration(Fields: dict of string to JsonValue): result of (ExplorationState, string);
begin
  if Fields.Length() <> 2 then
    begin
      return Error('savegame exploration has an unexpected field set');
    end;
  end if;
  const State: ExplorationState := ExplorationState(OutdoorChunks := try DecodeOutdoorDiscovery(try ArrayField(Fields, 'outdoor_chunks')), InteriorAreas := try DecodeInteriorDiscovery(try ArrayField(Fields, 'interior_areas')));
  return ValidateExploration(State, WorldChunkSize);
end function;
end unit;
