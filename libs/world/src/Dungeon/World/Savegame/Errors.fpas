// Typed savegame persistence failures, so callers never classify save or area-data errors by text.
unit Dungeon.World.Savegame.Errors;

uses Dungeon.World.Areas.Errors as Errors;

// InvalidState: the state or save content violates the rules; Area: a referenced area definition is
// missing, invalid, or unreadable; Io: the save file itself could not be read, written, or removed.
public type PersistenceFailure = enum
  InvalidState(Reason: string);
  Area(Failure: Errors.AreaFailure);
  Io(Reason: string);
end enum;
end unit;
