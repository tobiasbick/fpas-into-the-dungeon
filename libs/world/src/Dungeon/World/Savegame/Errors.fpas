// Typed savegame persistence failures, so callers never classify save or level errors by text.
unit Dungeon.World.Savegame.Errors;

uses Dungeon.World.Interiors.Errors;

public type
  // InvalidState: the state or save content violates the rules; Level: a referenced level file is
  // missing, invalid, or unreadable; Io: the save file itself could not be read, written, or removed.
  PersistenceFailure = enum
    InvalidState(Reason: string);
    Level(Failure: LevelFailure);
    Io(Reason: string);
  end;
