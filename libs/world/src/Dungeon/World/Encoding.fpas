// Exact JSON file formats of world metadata and chunks, including world identity validation.
unit Dungeon.World.Encoding;

uses
  Dungeon.Coordinates, Dungeon.Terrain, Dungeon.Terrain.Entrances, Dungeon.Terrain.Generation,
  Dungeon.Terrain.Placement, Std.Arrays, Std.Conv, Std.Dictionaries, Std.Json, Std.Json.Fields,
  Std.Str;

const
  AllowedWorldIdCharacters: string := 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_';

function AllWorldIdCharactersAllowed(AllAllowed: boolean; Character: string): boolean;
begin
  return AllAllowed and AllowedWorldIdCharacters.Contains(Character)
end;

// Accepts a world ID of 1 to 64 letters, digits, hyphens, and underscores.
public function ValidateWorldId(WorldId: string): result of string, string;
begin
  if (WorldId.Length() = 0) or (WorldId.Length() > 64) then
  begin
    return Error('world id must contain between 1 and 64 characters')
  end;

  if not WorldId.Reduce(true, AllWorldIdCharactersAllowed) then
  begin
    return Error('world id may contain only letters, digits, hyphen, and underscore')
  end;

  return Ok(WorldId)
end;

function EncodeRows(Rows: array of string): array of JsonValue;
begin
  return Std.Arrays.Map(Rows, function(Row: string): JsonValue begin
    return JsonValue.String(Row)
  end)
end;

// Encodes world metadata in the current world file format.
public function EncodeMetadata(Metadata: WorldMetadata): string;
begin
  return Std.Json.Stringify(JsonValue.Object(['version': JsonValue.Number(IntToReal(Metadata.FormatVersion)), 'id': JsonValue.String(Metadata.Id), 'seed': JsonValue.Number(IntToReal(Metadata.Seed)), 'generator_version': JsonValue.Number(IntToReal(Metadata.GeneratorVersion)), 'chunk_size': JsonValue.Number(IntToReal(Metadata.ChunkSize)), 'spawn_x': JsonValue.Number(IntToReal(Metadata.Spawn.X)), 'spawn_y': JsonValue.Number(IntToReal(Metadata.Spawn.Y)), 'outdoor_area_id': JsonValue.String(Metadata.OutdoorAreaId), 'outdoor_area_label': JsonValue.String(Metadata.OutdoorAreaLabel), 'spawn_entrance_x': JsonValue.Number(IntToReal(Metadata.SpawnEntrance.X)), 'spawn_entrance_y': JsonValue.Number(IntToReal(Metadata.SpawnEntrance.Y)), 'dungeon_region_chunks': JsonValue.Number(IntToReal(Metadata.DungeonRegionChunks))]))
end;

function DecodeMetadataFields(Text: string; ExpectedId: string): result of WorldMetadata, string;
begin
  var Fields: dict of string to JsonValue := try ParseObject(Text);
  if Std.Dictionaries.Length(Fields) <> 12 then
  begin
    return Error('world metadata must contain exactly the current schema fields')
  end;
  var Metadata: WorldMetadata := record
    FormatVersion := try IntegerField(Fields, 'version');
    Id := try StringField(Fields, 'id');
    Seed := try IntegerField(Fields, 'seed');
    GeneratorVersion := try IntegerField(Fields, 'generator_version');
    ChunkSize := try IntegerField(Fields, 'chunk_size');
    Spawn := record
      X := try IntegerField(Fields, 'spawn_x');
      Y := try IntegerField(Fields, 'spawn_y');
    end;
    OutdoorAreaId := try StringField(Fields, 'outdoor_area_id');
    OutdoorAreaLabel := try StringField(Fields, 'outdoor_area_label');
    SpawnEntrance := record
      X := try IntegerField(Fields, 'spawn_entrance_x');
      Y := try IntegerField(Fields, 'spawn_entrance_y');
    end;
    DungeonRegionChunks := try IntegerField(Fields, 'dungeon_region_chunks');
  end;

  if Metadata.FormatVersion <> WorldFormatVersion then
  begin
    return Error('unsupported world format version')
  end;

  if Metadata.GeneratorVersion <> WorldGeneratorVersion then
  begin
    return Error('unsupported world generator version')
  end;

  if Metadata.ChunkSize <> WorldChunkSize then
  begin
    return Error('world chunk size must be 128')
  end;

  if Metadata.Id <> ExpectedId then
  begin
    return Error('world metadata id does not match selected world')
  end;

  return ValidateWorldMetadata(Metadata)
end;

// Decodes world metadata; errors name the world metadata as their source.
public function DecodeMetadata(Text: string; ExpectedId: string): result of WorldMetadata, string;
begin
  case DecodeMetadataFields(Text, ExpectedId) of
    Ok(Value):
    begin
      return Ok(Value)
    end;
    Error(Message):
    begin
      return Error('invalid world metadata: ' + Message)
    end
  end
end;

function BaseCode(Value: BaseTerrainKind): string;
begin
  case Value of
    BaseTerrainKind.Grass:
    begin
      return 'g'
    end;
    BaseTerrainKind.Sand:
    begin
      return 's'
    end;
    BaseTerrainKind.Rock:
    begin
      return 'r'
    end;
    BaseTerrainKind.Water:
    begin
      return 'w'
    end
  end
end;

function FeatureCode(Value: TerrainFeatureKind): string;
begin
  case Value of
    TerrainFeatureKind.NoFeature:
    begin
      return '.'
    end;
    TerrainFeatureKind.Tree:
    begin
      return 't'
    end;
    TerrainFeatureKind.Forest:
    begin
      return 'f'
    end;
    TerrainFeatureKind.Path:
    begin
      return 'p'
    end;
    TerrainFeatureKind.River:
    begin
      return 'r'
    end;
    TerrainFeatureKind.Entrance:
    begin
      return 'e'
    end
  end
end;

function WaterCode(Value: WaterKind): string;
begin
  case Value of
    WaterKind.NoWater:
    begin
      return '.'
    end;
    WaterKind.Sea:
    begin
      return 's'
    end;
    WaterKind.Lake:
    begin
      return 'l'
    end;
    WaterKind.RiverWater:
    begin
      return 'r'
    end
  end
end;

function DecodeBase(Value: string): result of BaseTerrainKind, string;
begin
  case Value of
    'g':
    begin
      return Ok(BaseTerrainKind.Grass)
    end;
    's':
    begin
      return Ok(BaseTerrainKind.Sand)
    end;
    'r':
    begin
      return Ok(BaseTerrainKind.Rock)
    end;
    'w':
    begin
      return Ok(BaseTerrainKind.Water)
    end
    else
    begin
      return Error('chunk contains an unknown base terrain code')
    end
  end
end;

function DecodeFeature(Value: string): result of TerrainFeatureKind, string;
begin
  case Value of
    '.':
    begin
      return Ok(TerrainFeatureKind.NoFeature)
    end;
    't':
    begin
      return Ok(TerrainFeatureKind.Tree)
    end;
    'f':
    begin
      return Ok(TerrainFeatureKind.Forest)
    end;
    'p':
    begin
      return Ok(TerrainFeatureKind.Path)
    end;
    'r':
    begin
      return Ok(TerrainFeatureKind.River)
    end;
    'e':
    begin
      return Ok(TerrainFeatureKind.Entrance)
    end
    else
    begin
      return Error('chunk contains an unknown terrain feature code')
    end
  end
end;

function DecodeWater(Value: string): result of WaterKind, string;
begin
  case Value of
    '.':
    begin
      return Ok(WaterKind.NoWater)
    end;
    's':
    begin
      return Ok(WaterKind.Sea)
    end;
    'l':
    begin
      return Ok(WaterKind.Lake)
    end;
    'r':
    begin
      return Ok(WaterKind.RiverWater)
    end
    else
    begin
      return Error('chunk contains an unknown water classification code')
    end
  end
end;

function ChunkRows(Chunk: WorldChunk; Layer: integer): array of string;
begin
  mutable var Rows: array of string := [];
  for Y: integer := 0 to WorldChunkSize - 1 do
  begin
    mutable var Row: string := '';
    for X: integer := 0 to WorldChunkSize - 1 do
    begin
      var Cell: WorldCell := ChunkCell(Chunk, X, Y);
      case Layer of
        0:
        begin
          Row := Row + BaseCode(Cell.Base)
        end;
        1:
        begin
          Row := Row + FeatureCode(Cell.Feature)
        end
        else
        begin
          Row := Row + WaterCode(Cell.Water)
        end
      end
    end;

    Std.Arrays.Push(Rows, Row)
  end;

  return Rows
end;

// Encodes one chunk with its layer rows in the current world file format.
public function EncodeChunk(WorldId: string; Chunk: WorldChunk): string;
begin
  return Std.Json.Stringify(JsonValue.Object(['version': JsonValue.Number(IntToReal(WorldFormatVersion)), 'world_id': JsonValue.String(WorldId), 'chunk_x': JsonValue.Number(IntToReal(Chunk.Coordinate.X)), 'chunk_y': JsonValue.Number(IntToReal(Chunk.Coordinate.Y)), 'base_rows': JsonValue.ArrayValue(EncodeRows(ChunkRows(Chunk, 0))), 'feature_rows': JsonValue.ArrayValue(EncodeRows(ChunkRows(Chunk, 1))), 'water_rows': JsonValue.ArrayValue(EncodeRows(ChunkRows(Chunk, 2)))]))
end;

function ValidateLayerRows(Rows: array of string; Name: string): result of array of string, string;
begin
  if Std.Arrays.Length(Rows) <> WorldChunkSize then
  begin
    return Error((Name + ' row count must be ') + IntToStr(WorldChunkSize))
  end;

  for Row: string in Rows do
  begin
    if Std.Str.Length(Row) <> WorldChunkSize then
    begin
      return Error((Name + ' row width must be ') + IntToStr(WorldChunkSize))
    end
  end;

  return Ok(Rows)
end;

function DecodeChunkFields(
  Text: string;
  Metadata: WorldMetadata;
  ExpectedCoordinate: ChunkCoordinate
): result of WorldChunk, string;
begin
  var Fields: dict of string to JsonValue := try ParseObject(Text);
  if try IntegerField(Fields, 'version') <> WorldFormatVersion then
  begin
    return Error('unsupported chunk format version')
  end;

  if try StringField(Fields, 'world_id') <> Metadata.Id then
  begin
    return Error('chunk world id does not match selected world')
  end;

  if (try IntegerField(Fields, 'chunk_x') <> ExpectedCoordinate.X) or
     (try IntegerField(Fields, 'chunk_y') <> ExpectedCoordinate.Y) then
  begin
    return Error('chunk coordinates do not match its storage path')
  end;
  var BaseRows: array of string := try ValidateLayerRows(try StringArrayField(Fields, 'base_rows'), 'base');
  var FeatureRows: array of string := try ValidateLayerRows(try StringArrayField(Fields, 'feature_rows'), 'feature');
  var WaterRows: array of string := try ValidateLayerRows(try StringArrayField(Fields, 'water_rows'), 'water');
  mutable var Cells: array of WorldCell := [];
  for Y: integer := 0 to WorldChunkSize - 1 do
  begin
    for X: integer := 0 to WorldChunkSize - 1 do
    begin
      Std.Arrays.Push(Cells, record
        Base := try DecodeBase(Std.Str.CharAt(BaseRows[Y], X));
        Feature := try DecodeFeature(Std.Str.CharAt(FeatureRows[Y], X));
        Water := try DecodeWater(Std.Str.CharAt(WaterRows[Y], X));
      end)
    end
  end;
  var Chunk: WorldChunk := try ValidateChunk(record
    Coordinate := ExpectedCoordinate;
    Cells := Cells;
  end);
  // Entrances lie exactly on the chunk's entrance fields whose stored cell is clear walkable land.
  mutable var ExpectedEntrances: array of boolean := Std.Arrays.Fill(false, WorldChunkSize *
                                                                            WorldChunkSize);
  for Field: WorldPosition in EntranceFieldsInChunk(Metadata, ExpectedCoordinate) do
  begin
    var Index: integer := (LocalForCoordinate(Field.Y) * WorldChunkSize) +
                          LocalForCoordinate(Field.X);
    var Stored: WorldCell := Chunk.Cells[Index];
    ExpectedEntrances[Index] := ((Stored.Feature = TerrainFeatureKind.Entrance) or (Stored.Feature = TerrainFeatureKind.NoFeature)) and
                                CellIsClearEntrance(Stored with Feature := TerrainFeatureKind.NoFeature; end)
  end;

  for Index: integer := 0 to Std.Arrays.Length(Chunk.Cells) - 1 do
  begin
    if ExpectedEntrances[Index] <> (Chunk.Cells[Index].Feature = TerrainFeatureKind.Entrance) then
    begin
      return Error('chunk entrance feature does not match world metadata')
    end
  end;

  return Ok(Chunk)
end;

// Decodes one stored chunk; errors name the chunk file as their source.
public function DecodeChunk(Text: string; Metadata: WorldMetadata; ExpectedCoordinate: ChunkCoordinate): result of WorldChunk, string;
begin
  case DecodeChunkFields(Text, Metadata, ExpectedCoordinate) of
    Ok(Value):
    begin
      return Ok(Value)
    end;
    Error(Message):
    begin
      return Error('invalid chunk file: ' + Message)
    end
  end
end;
