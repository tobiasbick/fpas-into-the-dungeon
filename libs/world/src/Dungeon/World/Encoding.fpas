// Exact JSON file formats of world metadata and chunks, including world identity validation.
unit Dungeon.World.Encoding;

uses Dungeon.Settlements.Sites as Sites, Dungeon.Coordinates as Coordinates, Dungeon.Terrain as Terrain, Dungeon.Terrain.Entrances as Entrances, Dungeon.Terrain.Generation as TerrainGeneration, Dungeon.Terrain.Placement as PlacementRules, Std.Conv as Conv, Std.Json as Json, Std.Json.Fields as JsonFields;

const AllowedWorldIdCharacters: string := 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_';

function AllWorldIdCharactersAllowed(AllAllowed: boolean; Character: string): boolean;
begin
  return AllAllowed and Character in AllowedWorldIdCharacters;
end function;

// Accepts a world ID of 1 to 64 letters, digits, hyphens, and underscores.
public function ValidateWorldId(WorldId: string): result of (string, string);
begin
  if (WorldId.Length() = 0) or (WorldId.Length() > 64) then
    begin
      return Error('world id must contain between 1 and 64 characters');
    end;
  end if;

  if not WorldId.Reduce(true, AllWorldIdCharactersAllowed) then
    begin
      return Error('world id may contain only letters, digits, hyphen, and underscore');
    end;
  end if;

  return Ok(WorldId);
end function;

function EncodeRows(Rows: array of string): array of Json.JsonValue;
begin
  return Rows.Map(
    function(Row: string): Json.JsonValue begin
      return Json.JsonValue.String(Row);
    end function
  );
end function;

// Encodes world metadata in the current world file format.
public function EncodeMetadata(Metadata: Terrain.WorldMetadata): string;
begin
  return Json.Stringify(
    Json.JsonValue.Object([
      'version': Json.JsonValue.Number(Conv.IntToReal(Metadata.FormatVersion)),
      'id': Json.JsonValue.String(Metadata.Id),
      'seed': Json.JsonValue.Number(Conv.IntToReal(Metadata.Seed)),
      'generator_version': Json.JsonValue.Number(Conv.IntToReal(Metadata.GeneratorVersion)),
      'chunk_size': Json.JsonValue.Number(Conv.IntToReal(Metadata.ChunkSize)),
      'spawn_x': Json.JsonValue.Number(Conv.IntToReal(Metadata.Spawn.X)),
      'spawn_y': Json.JsonValue.Number(Conv.IntToReal(Metadata.Spawn.Y)),
      'outdoor_area_id': Json.JsonValue.String(Metadata.OutdoorAreaId),
      'outdoor_area_label': Json.JsonValue.String(Metadata.OutdoorAreaLabel),
      'spawn_entrance_x': Json.JsonValue.Number(Conv.IntToReal(Metadata.SpawnEntrance.X)),
      'spawn_entrance_y': Json.JsonValue.Number(Conv.IntToReal(Metadata.SpawnEntrance.Y)),
      'settlement_gate': Json.JsonValue.Object([
        'x': Json.JsonValue.Number(Conv.IntToReal(Metadata.SettlementGate.X)),
        'y': Json.JsonValue.Number(Conv.IntToReal(Metadata.SettlementGate.Y))
      ]),
      'dungeon_region_chunks': Json.JsonValue.Number(Conv.IntToReal(Metadata.DungeonRegionChunks))
    ])
  );
end function;

function DecodeMetadataFields(Text: string; ExpectedId: string): result of (Terrain.WorldMetadata, string);
begin
  const Fields: dict of string to Json.JsonValue := try JsonFields.ParseObject(Text);
  if (try JsonFields.IntegerField(Fields, 'version')) <> Terrain.WorldFormatVersion then
    return Error('unsupported world format version');
  end if;

  if Fields.Length() <> 13 then
    begin
      return Error('world metadata must contain exactly the current schema fields');
    end;
  end if;
  const Gate: dict of string to Json.JsonValue := try JsonFields.ObjectField(
    Fields,
    'settlement_gate'
  );
  const GateFields: boolean := try JsonFields.RequireOnlyFields(Gate, ['x', 'y']);
  const Metadata: Terrain.WorldMetadata := Terrain.WorldMetadata(
    FormatVersion := try JsonFields.IntegerField(Fields, 'version'),
    Id := try JsonFields.StringField(Fields, 'id'),
    Seed := try JsonFields.IntegerField(Fields, 'seed'),
    GeneratorVersion := try JsonFields.IntegerField(Fields, 'generator_version'),
    ChunkSize := try JsonFields.IntegerField(Fields, 'chunk_size'),
    Spawn := Coordinates.WorldPosition(
      X := try JsonFields.IntegerField(Fields, 'spawn_x'),
      Y := try JsonFields.IntegerField(Fields, 'spawn_y')
    ),
    OutdoorAreaId := try JsonFields.StringField(Fields, 'outdoor_area_id'),
    OutdoorAreaLabel := try JsonFields.StringField(Fields, 'outdoor_area_label'),
    SpawnEntrance := Coordinates.WorldPosition(
      X := try JsonFields.IntegerField(Fields, 'spawn_entrance_x'),
      Y := try JsonFields.IntegerField(Fields, 'spawn_entrance_y')
    ),
    SettlementGate := Coordinates.WorldPosition(
      X := try JsonFields.IntegerField(Gate, 'x'), Y := try JsonFields.IntegerField(Gate, 'y')
    ),
    DungeonRegionChunks := try JsonFields.IntegerField(Fields, 'dungeon_region_chunks')
  );
  if Metadata.FormatVersion <> Terrain.WorldFormatVersion then
    begin
      return Error('unsupported world format version');
    end;
  end if;

  if Metadata.GeneratorVersion <> Terrain.WorldGeneratorVersion then
    begin
      return Error('unsupported world generator version');
    end;
  end if;

  if Metadata.ChunkSize <> Coordinates.WorldChunkSize then
    begin
      return Error('world chunk size must be 128');
    end;
  end if;

  if Metadata.Id <> ExpectedId then
    begin
      return Error('world metadata id does not match selected world');
    end;
  end if;

  return PlacementRules.ValidateWorldMetadata(Metadata);
end function;

// Decodes world metadata; errors name the world metadata as their source.
public function DecodeMetadata(Text: string; ExpectedId: string): result of (Terrain.WorldMetadata, string);
begin
  case DecodeMetadataFields(Text, ExpectedId) of
    when Ok(const Value):
      begin
        return Ok(Value);
      end;
    when Error(const Message):
      begin
        return Error('invalid world metadata: ' + Message);
      end;
  end case;
end function;

function BaseCode(Value: Terrain.BaseTerrainKind): string;
begin
  case Value of
    when Terrain.BaseTerrainKind.Grass:
      begin
        return 'g';
      end;
    when Terrain.BaseTerrainKind.Sand:
      begin
        return 's';
      end;
    when Terrain.BaseTerrainKind.Rock:
      begin
        return 'r';
      end;
    when Terrain.BaseTerrainKind.Water:
      begin
        return 'w';
      end;
  end case;
end function;

function FeatureCode(Value: Terrain.TerrainFeatureKind): string;
begin
  case Value of
    when Terrain.TerrainFeatureKind.NoFeature:
      begin
        return '.';
      end;
    when Terrain.TerrainFeatureKind.Tree:
      begin
        return 't';
      end;
    when Terrain.TerrainFeatureKind.Forest:
      begin
        return 'f';
      end;
    when Terrain.TerrainFeatureKind.Path:
      begin
        return 'p';
      end;
    when Terrain.TerrainFeatureKind.River:
      begin
        return 'r';
      end;
    when Terrain.TerrainFeatureKind.Entrance:
      begin
        return 'e';
      end;
    when Terrain.TerrainFeatureKind.SettlementGate:
      return 's';
  end case;
end function;

function WaterCode(Value: Terrain.WaterKind): string;
begin
  case Value of
    when Terrain.WaterKind.NoWater:
      begin
        return '.';
      end;
    when Terrain.WaterKind.Sea:
      begin
        return 's';
      end;
    when Terrain.WaterKind.Lake:
      begin
        return 'l';
      end;
    when Terrain.WaterKind.RiverWater:
      begin
        return 'r';
      end;
  end case;
end function;

function DecodeBase(Value: string): result of (Terrain.BaseTerrainKind, string);
begin
  case Value of
    when 'g':
      begin
        return Ok(Terrain.BaseTerrainKind.Grass);
      end;
    when 's':
      begin
        return Ok(Terrain.BaseTerrainKind.Sand);
      end;
    when 'r':
      begin
        return Ok(Terrain.BaseTerrainKind.Rock);
      end;
    when 'w':
      begin
        return Ok(Terrain.BaseTerrainKind.Water);
      end;
    else
      begin
        return Error('chunk contains an unknown base terrain code');
      end;
  end case;
end function;

function DecodeFeature(Value: string): result of (Terrain.TerrainFeatureKind, string);
begin
  case Value of
    when '.':
      begin
        return Ok(Terrain.TerrainFeatureKind.NoFeature);
      end;
    when 't':
      begin
        return Ok(Terrain.TerrainFeatureKind.Tree);
      end;
    when 'f':
      begin
        return Ok(Terrain.TerrainFeatureKind.Forest);
      end;
    when 'p':
      begin
        return Ok(Terrain.TerrainFeatureKind.Path);
      end;
    when 'r':
      begin
        return Ok(Terrain.TerrainFeatureKind.River);
      end;
    when 'e':
      begin
        return Ok(Terrain.TerrainFeatureKind.Entrance);
      end;
    when 's':
      return Ok(Terrain.TerrainFeatureKind.SettlementGate);
    else
      begin
        return Error('chunk contains an unknown terrain feature code');
      end;
  end case;
end function;

function DecodeWater(Value: string): result of (Terrain.WaterKind, string);
begin
  case Value of
    when '.':
      begin
        return Ok(Terrain.WaterKind.NoWater);
      end;
    when 's':
      begin
        return Ok(Terrain.WaterKind.Sea);
      end;
    when 'l':
      begin
        return Ok(Terrain.WaterKind.Lake);
      end;
    when 'r':
      begin
        return Ok(Terrain.WaterKind.RiverWater);
      end;
    else
      begin
        return Error('chunk contains an unknown water classification code');
      end;
  end case;
end function;

function ChunkRows(Chunk: Terrain.WorldChunk; Layer: integer): array of string;
begin
  var Rows: array of string := [];
  for Y: integer := 0 to Coordinates.WorldChunkSize - 1 do
    begin
      var Row: string := '';
      for X: integer := 0 to Coordinates.WorldChunkSize - 1 do
        begin
          const Cell: Terrain.WorldCell := Terrain.ChunkCell(Chunk, X, Y);
          case Layer of
            when 0:
              begin
                Row := Row + BaseCode(Cell.Base);
              end;
            when 1:
              begin
                Row := Row + FeatureCode(Cell.Feature);
              end;
            else
              begin
                Row := Row + WaterCode(Cell.Water);
              end;
          end case;
        end;
      end for;

      Rows.PushInPlace(Row);
    end;
  end for;

  return Rows;
end function;

// Encodes one chunk with its layer rows in the current world file format.
public function EncodeChunk(WorldId: string; Chunk: Terrain.WorldChunk): string;
begin
  return Json.Stringify(
    Json.JsonValue.Object([
      'version': Json.JsonValue.Number(Conv.IntToReal(Terrain.WorldFormatVersion)),
      'world_id': Json.JsonValue.String(WorldId),
      'chunk_x': Json.JsonValue.Number(Conv.IntToReal(Chunk.Coordinate.X)),
      'chunk_y': Json.JsonValue.Number(Conv.IntToReal(Chunk.Coordinate.Y)),
      'base_rows': Json.JsonValue.ArrayValue(EncodeRows(ChunkRows(Chunk, 0))),
      'feature_rows': Json.JsonValue.ArrayValue(EncodeRows(ChunkRows(Chunk, 1))),
      'water_rows': Json.JsonValue.ArrayValue(EncodeRows(ChunkRows(Chunk, 2)))
    ])
  );
end function;

function ValidateLayerRows(Rows: array of string; Name: string): result of (array of string, string);
begin
  if Rows.Length() <> Coordinates.WorldChunkSize then
    begin
      return Error((Name + ' row count must be ') + Conv.IntToStr(Coordinates.WorldChunkSize));
    end;
  end if;

  for Row: string in Rows do
    begin
      if Row.Length() <> Coordinates.WorldChunkSize then
        begin
          return Error((Name + ' row width must be ') + Conv.IntToStr(Coordinates.WorldChunkSize));
        end;
      end if;
    end;
  end for;

  return Ok(Rows);
end function;

function DecodeChunkFields(
  Text: string;
  Metadata: Terrain.WorldMetadata;
  ExpectedCoordinate: Coordinates.ChunkCoordinate
): result of (Terrain.WorldChunk, string);
begin
  const Fields: dict of string to Json.JsonValue := try JsonFields.ParseObject(Text);
  if try JsonFields.IntegerField(Fields, 'version') <> Terrain.WorldFormatVersion then
    begin
      return Error('unsupported chunk format version');
    end;
  end if;

  if try JsonFields.StringField(Fields, 'world_id') <> Metadata.Id then
    begin
      return Error('chunk world id does not match selected world');
    end;
  end if;

  if (try JsonFields.IntegerField(Fields, 'chunk_x') <> ExpectedCoordinate.X)
    or
    (try JsonFields.IntegerField(Fields, 'chunk_y') <> ExpectedCoordinate.Y)
  then
    begin
      return Error('chunk coordinates do not match its storage path');
    end;
  end if;
  const BaseRows: array of string := try ValidateLayerRows(
    try JsonFields.StringArrayField(Fields, 'base_rows'),
    'base'
  );
  const FeatureRows: array of string := try ValidateLayerRows(
    try JsonFields.StringArrayField(Fields, 'feature_rows'),
    'feature'
  );
  const WaterRows: array of string := try ValidateLayerRows(
    try JsonFields.StringArrayField(Fields, 'water_rows'),
    'water'
  );
  var Cells: array of Terrain.WorldCell := [];
  for Y: integer := 0 to Coordinates.WorldChunkSize - 1 do
    begin
      for X: integer := 0 to Coordinates.WorldChunkSize - 1 do
        begin
          Cells.PushInPlace(
            Terrain.WorldCell(
              Base := try DecodeBase(BaseRows[Y][X]),
              Feature := try DecodeFeature(FeatureRows[Y][X]),
              Water := try DecodeWater(WaterRows[Y][X])
            )
          );
        end;
      end for;
    end;
  end for;
  const Chunk: Terrain.WorldChunk := try TerrainGeneration.ValidateChunk(
    Terrain.WorldChunk(Coordinate := ExpectedCoordinate, Cells := Cells)
  );
  // Entrances lie exactly on the chunk's entrance fields whose stored cell is clear walkable land.
  var ExpectedEntrances: array of boolean := array.Fill(
    false,
    Coordinates.WorldChunkSize * Coordinates.WorldChunkSize
  );
  for Field: Coordinates.WorldPosition in Entrances.EntranceFieldsInChunk(
    Metadata,
    ExpectedCoordinate
  ) do
    begin
      const Index: integer := (
        Coordinates.LocalForCoordinate(Field.Y) * Coordinates.WorldChunkSize
      ) +
        Coordinates.LocalForCoordinate(Field.X);
      const Stored: Terrain.WorldCell := Chunk.Cells[Index];
      ExpectedEntrances[Index] := (
        (Stored.Feature = Terrain.TerrainFeatureKind.Entrance)
        or
        (Stored.Feature = Terrain.TerrainFeatureKind.NoFeature)
      )
        and
        Entrances.CellIsClearEntrance(
          Stored with Feature := Terrain.TerrainFeatureKind.NoFeature; end with
        );
    end;
  end for;
  var GeneratedGateIndex := -1;
  case Sites.Site(Metadata, ExpectedCoordinate) of
    when Some(const Gate):
      GeneratedGateIndex := Coordinates.LocalForCoordinate(Gate.Y) * Coordinates.WorldChunkSize +
        Coordinates.LocalForCoordinate(Gate.X);
    when None:
      null;
  end case;

  for Index: integer := 0 to Chunk.Cells.Length() - 1 do
    begin
      const IsGate: boolean := (Index = GeneratedGateIndex)
        or
        (
          (
            ExpectedCoordinate.X * Coordinates.WorldChunkSize +
            (Index mod Coordinates.WorldChunkSize) =
            Metadata.SettlementGate.X
          )
          and
          (
            ExpectedCoordinate.Y * Coordinates.WorldChunkSize +
            (Index div Coordinates.WorldChunkSize) = Metadata.SettlementGate.Y
          )
        );
      if IsGate <> (Chunk.Cells[Index].Feature = Terrain.TerrainFeatureKind.SettlementGate) then
        return Error('chunk settlement gate feature does not match world metadata');
      end if;

      if IsGate
        and
        not Entrances.CellIsClearEntrance(
          Chunk.Cells[Index] with Feature := Terrain.TerrainFeatureKind.NoFeature; end with
        )
      then
        return Error('chunk settlement gate requires clear walkable land');
      end if;

      if ExpectedEntrances[Index] <>
        (Chunk.Cells[Index].Feature = Terrain.TerrainFeatureKind.Entrance)
      then
        begin
          return Error('chunk entrance feature does not match world metadata');
        end;
      end if;
    end;
  end for;

  return Ok(Chunk);
end function;

// Decodes one stored chunk; errors name the chunk file as their source.
public function DecodeChunk(Text: string; Metadata: Terrain.WorldMetadata; ExpectedCoordinate: Coordinates.ChunkCoordinate): result of (Terrain.WorldChunk, string);
begin
  case DecodeChunkFields(Text, Metadata, ExpectedCoordinate) of
    when Ok(const Value):
      begin
        return Ok(Value);
      end;
    when Error(const Message):
      begin
        return Error('invalid chunk file: ' + Message);
      end;
  end case;
end function;
end unit;
