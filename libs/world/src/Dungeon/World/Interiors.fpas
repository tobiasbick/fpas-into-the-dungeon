// Immutable dungeon level files below the world directory: reading, first-visit creation, and save support.
unit Dungeon.World.Interiors;

uses Dungeon.Areas.Identities as Identities, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Interior as InteriorUnit, Dungeon.Interior.Generation as Generation, Dungeon.Interior.Generation.Levels as Levels, Dungeon.Movement as Movement, Dungeon.Terrain as Terrain, Dungeon.Terrain.Entrances as Entrances, Dungeon.World as WorldUnit, Dungeon.World.Interiors.Encoding as Encoding, Dungeon.World.Areas.Errors as Errors, Std.Conv as Conv, Std.Fs as Fs, Std.Path as PathOps;

// Directory of one region's dungeon levels, built only from validated region coordinates.
function LevelDirectory(World: WorldUnit.WorldSession; Region: Entrances.RegionCoordinate): string;
begin
  return PathOps.Join([
    World.Directory,
    'dungeons',
    (Conv.IntToStr(Region.X) + '_') + Conv.IntToStr(Region.Y)
  ]);
end function;

function LevelPath(World: WorldUnit.WorldSession; Id: Identities.DungeonLevelId): string;
begin
  return PathOps.Join([LevelDirectory(World, Id.Region), Conv.IntToStr(Id.Level) + '.json']);
end function;

function LevelRegion(World: WorldUnit.WorldSession; AreaId: string): result of (Identities.DungeonLevelId, Errors.AreaFailure);
begin
  case Identities.ParseDungeonLevelId(World.Metadata, AreaId) of
    when Ok(const Region):
      begin
        return Ok(Region);
      end;
    when Error(const Message):
      begin
        return Error(Errors.AreaFailure.Invalid(AreaId, Message));
      end;
  end case;
end function;

// Reads and strictly validates an existing level file; never generates or writes.
// A missing file is `Missing`; unusable content is `Invalid`; filesystem errors are `Io`.
public function ReadLevel(World: WorldUnit.WorldSession; AreaId: string): result of (InteriorUnit.InteriorMap, Errors.AreaFailure);
begin
  const Id: Identities.DungeonLevelId := try LevelRegion(World, AreaId);
  const Path: string := LevelPath(World, Id);
  if not Fs.Exists(Path) then
    begin
      return Error(Errors.AreaFailure.Missing(AreaId));
    end;
  end if;

  if not Fs.IsFile(Path) then
    begin
      return Error(
        Errors.AreaFailure.Io('level path exists but is not a file for area ' + AreaId)
      );
    end;
  end if;
  var Text: string := '';
  case Fs.ReadText(Path) of
    when Ok(const Value):
      begin
        Text := Value;
      end;
    when Error(const Message):
      begin
        return Error(
          Errors.AreaFailure.Io((('cannot read level of area ' + AreaId) + ': ') + Message)
        );
      end;
  end case;

  case Encoding.DecodeLevel(Text, World.Metadata, AreaId) of
    when Ok(const Map):
      begin
        return Ok(Map);
      end;
    when Error(const Message):
      begin
        return Error(Errors.AreaFailure.Invalid(AreaId, Message));
      end;
  end case;
end function;

// Requires that AreaId is the target of the player's current transition in View. The caller has
// validated State against View; the transition itself validates the state again before installing it.
function RequireEntryTarget(View: GameState.AreaView; State: GameState.GameState; AreaId: string): result of (boolean, Errors.AreaFailure);
begin
  case Movement.TransitionTargetOfValid(View, State) of
    when Ok(const Target):
      if Target = AreaId then
        return Ok(true);
      end if;
    when Error(_):
      null;
  end case;

  return Error(
    Errors.AreaFailure.Invalid(
      AreaId,
      'entry target does not match the transition under the player'
    )
  );
end function;

function GeneratedLevel(World: WorldUnit.WorldSession; AreaId: string; Id: Identities.DungeonLevelId; Depth: integer): result of (InteriorUnit.InteriorMap, Errors.AreaFailure);
begin
  case Generation.GenerateDungeon(
    World.Metadata.Seed,
    Id.Region.X,
    Id.Region.Y,
    Id.Level,
    Depth,
    AreaId, Levels.CompassExpected(World.Metadata, Id.Region.X, Id.Region.Y, Id.Level, Depth)
  ) of
    when Ok(const Map):
      begin
        return Ok(Map);
      end;
    when Error(const Message):
      begin
        return Error(Errors.AreaFailure.Generation(AreaId, Message));
      end;
  end case;
end function;

// Generates an ephemeral candidate for a canonical level without reading or publishing files.
// The quest preflight calls this only after proving the level is missing and unvisited.
public function PreviewLevel(World: WorldUnit.WorldSession; AreaId: string; Depth: integer): result of (InteriorUnit.InteriorMap, Errors.AreaFailure);
begin
  return GeneratedLevel(World, AreaId, try LevelRegion(World, AreaId), Depth);
end function;

// Generates a missing level, checks that it round-trips through the level format, and publishes it atomically.
function CreateLevel(World: WorldUnit.WorldSession; AreaId: string; Id: Identities.DungeonLevelId; Depth: integer): result of (InteriorUnit.InteriorMap, Errors.AreaFailure);
begin
  const Map: InteriorUnit.InteriorMap := try GeneratedLevel(World, AreaId, Id, Depth);
  const Text: string := Encoding.EncodeLevel(World.Metadata, Map);
  case Encoding.DecodeLevel(Text, World.Metadata, AreaId) of
    when Ok(const Decoded):
      begin
        null;
      end;
    when Error(const Message):
      begin
        return Error(Errors.AreaFailure.Generation(AreaId, Message));
      end;
  end case;

  case Fs.CreateDirAll(LevelDirectory(World, Id.Region)) of
    when Ok(const Created):
      begin
        null;
      end;
    when Error(const Message):
      begin
        return Error(
          Errors.AreaFailure.Io(
            (('cannot create level directory of area ' + AreaId) + ': ') +
            Message
          )
        );
      end;
  end case;

  case Fs.WriteTextAtomic(LevelPath(World, Id), Text) of
    when Ok(const Written):
      begin
        return Ok(Map);
      end;
    when Error(const Message):
      begin
        return Error(
          Errors.AreaFailure.Io((('cannot store level of area ' + AreaId) + ': ') + Message)
        );
      end;
  end case;
end function;

// Returns the level for a transition from State in View into AreaId: an entrance outdoors or
// stairs indoors. Verifies the target against the player's transition first, then reads an
// existing file. Only a missing level of an area not yet visited in this game is generated and
// atomically stored; a missing visited level stays `Missing`. Existing files are never
// overwritten. Level 0 takes its depth from the generator; deeper levels take the stored depth
// of the current level, so one dungeon never mixes depths. State must already be validated
// against View; it is not validated again here.
public function OpenLevelForEntry(World: WorldUnit.WorldSession; View: GameState.AreaView; State: GameState.GameState; AreaId: string): result of (InteriorUnit.InteriorMap, Errors.AreaFailure);
begin
  const Id: Identities.DungeonLevelId := try LevelRegion(World, AreaId);
  const Eligible: boolean := try RequireEntryTarget(View, State, AreaId);
  var Depth: integer := Levels.DungeonDepth(World.Metadata.Seed, Id.Region.X, Id.Region.Y);
  case View.Interior of
    when Some(const Current):
      Depth := Current.Depth;
    when None:
      null;
  end case;

  case ReadLevel(World, AreaId) of
    when Ok(const Map):
      begin
        return Ok(Map);
      end;
    when Error(const Failure):
      begin
        case Failure of
          when Errors.AreaFailure.Missing(const MissingAreaId):
            if GameState.HasVisitedArea(State, AreaId) then
              begin
                return Error(Failure);
              end;
            end if;

            return CreateLevel(World, AreaId, Id, Depth);
          when Errors.AreaFailure.Invalid(_, _), Errors.AreaFailure.Io(_), Errors.AreaFailure.Generation(_, _):
            return Error(Failure);
        end case;
      end;
  end case;
end function;
end unit;
