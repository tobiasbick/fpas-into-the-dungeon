// Immutable dungeon level files below the world directory: reading, first-visit creation, and save support.
unit Dungeon.World.Interiors;

uses
  Dungeon.Areas.Identities, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interior,
  Dungeon.Interior.Generation, Dungeon.Terrain, Dungeon.Terrain.Entrances, Dungeon.World,
  Dungeon.World.Interiors.Encoding, Dungeon.World.Interiors.Errors, Std.Arrays, Std.Conv, Std.Fs,
  Std.Path;

// Directory of one region's dungeon levels, built only from validated region coordinates.
function LevelDirectory(World: WorldSession; Region: RegionCoordinate): string;
begin
  return Std.Path.Join([
                         World.Directory,
                         'dungeons',
                         (IntToStr(Region.X) + '_') + IntToStr(Region.Y)
                       ]);
end function;

function LevelPath(World: WorldSession; Region: RegionCoordinate): string;
begin
  return Std.Path.Join([LevelDirectory(World, Region), '0.json']);
end function;

function LevelRegion(World: WorldSession; AreaId: string): result of RegionCoordinate, LevelFailure;
begin
  case ParseDungeonAreaId(World.Metadata, AreaId) of
    when Ok(Region):
      begin
        return Ok(Region);
      end;
    when Error(Message):
      begin
        return Error(LevelFailure.Invalid(AreaId, Message));
      end;
  end case;
end function;

// Reads and strictly validates an existing level 0; never generates or writes.
// A missing file is `Missing`; unusable content is `Invalid`; filesystem errors are `Io`.
public function ReadLevel(World: WorldSession; AreaId: string): result of InteriorMap, LevelFailure;
begin
  var Region: RegionCoordinate := try LevelRegion(World, AreaId);
  var Path: string := LevelPath(World, Region);
  if not Std.Fs.Exists(Path) then
    begin
      return Error(LevelFailure.Missing(AreaId));
    end;
  end if;

  if not Std.Fs.IsFile(Path) then
    begin
      return Error(LevelFailure.Io('level path exists but is not a file for area ' + AreaId));
    end;
  end if;
  mutable var Text: string := '';
  case Std.Fs.ReadText(Path) of
    when Ok(Value):
      begin
        Text := Value;
      end;
    when Error(Message):
      begin
        return Error(LevelFailure.Io((('cannot read level of area ' + AreaId) + ': ') + Message));
      end;
  end case;

  case DecodeLevel(Text, World.Metadata, AreaId) of
    when Ok(Map):
      begin
        return Ok(Map);
      end;
    when Error(Message):
      begin
        return Error(LevelFailure.Invalid(AreaId, Message));
      end;
  end case;
end function;

// Requires that the outdoor player stands on the entrance site of exactly this area's region.
function RequireEntryTarget(
  World: WorldSession;
  State: GameState;
  AreaId: string;
  Region: RegionCoordinate
): result of boolean, LevelFailure;
begin
  case OutdoorPlayerPosition(State) of
    when Ok(Position):
      begin
        case EntranceRegionAt(World.Metadata, Position) of
          when Some(EntranceRegion):
            begin
              if (EntranceRegion.X = Region.X) and (EntranceRegion.Y = Region.Y) then
                begin
                  return Ok(true);
                end;
              end if;
            end;
          when None:
            begin
              null;
            end;
        end case;
      end;
    when Error(Message):
      begin
        null;
      end;
  end case;

  return Error(LevelFailure.Invalid(AreaId, 'entry target does not match the entrance under the player'));
end function;

function GeneratedLevel(World: WorldSession; AreaId: string; Region: RegionCoordinate): result of InteriorMap, LevelFailure;
begin
  case GenerateDungeon(World.Metadata.Seed, Region.X, Region.Y, AreaId) of
    when Ok(Map):
      begin
        return Ok(Map);
      end;
    when Error(Message):
      begin
        return Error(LevelFailure.Generation(AreaId, Message));
      end;
  end case;
end function;

// Generates a missing level, checks that it round-trips through the level format, and publishes it atomically.
function CreateLevel(World: WorldSession; AreaId: string; Region: RegionCoordinate): result of InteriorMap, LevelFailure;
begin
  var Map: InteriorMap := try GeneratedLevel(World, AreaId, Region);
  var Text: string := EncodeLevel(World.Metadata, Map);
  case DecodeLevel(Text, World.Metadata, AreaId) of
    when Ok(Decoded):
      begin
        null;
      end;
    when Error(Message):
      begin
        return Error(LevelFailure.Generation(AreaId, Message));
      end;
  end case;

  case Std.Fs.CreateDirAll(LevelDirectory(World, Region)) of
    when Ok(Created):
      begin
        null;
      end;
    when Error(Message):
      begin
        return Error(LevelFailure.Io((('cannot create level directory of area ' + AreaId) + ': ') +
                                     Message));
      end;
  end case;

  case Std.Fs.WriteTextAtomic(LevelPath(World, Region), Text) of
    when Ok(Written):
      begin
        return Ok(Map);
      end;
    when Error(Message):
      begin
        return Error(LevelFailure.Io((('cannot store level of area ' + AreaId) + ': ') + Message));
      end;
  end case;
end function;

// Returns the level for a transition from the outdoor State into AreaId. Verifies the target
// against the player's entrance first, then reads an existing file. Only a missing level of an
// area not yet visited in this game is generated and atomically stored; a missing visited level
// stays `Missing`. Existing files are never overwritten.
public function OpenLevelForEntry(World: WorldSession; State: GameState; AreaId: string): result of InteriorMap, LevelFailure;
begin
  var Region: RegionCoordinate := try LevelRegion(World, AreaId);
  var Eligible: boolean := try RequireEntryTarget(World, State, AreaId, Region);
  case ReadLevel(World, AreaId) of
    when Ok(Map):
      begin
        return Ok(Map);
      end;
    when Error(Failure):
      begin
        case Failure of
          when LevelFailure.Missing(MissingAreaId):
            begin
              if HasVisitedArea(State, AreaId) then
                begin
                  return Error(Failure);
                end;
              end if;

              return CreateLevel(World, AreaId, Region);
            end;
          else
            begin
              return Error(Failure);
            end;
        end case;
      end;
  end case;
end function;

// Reads every visited area's existing level once, in canonical visit order, for full validation.
// Never generates; the returned maps live only as long as the caller's validation.
public function ReadVisitedLevels(World: WorldSession; State: GameState): result of array of InteriorMap, LevelFailure;
begin
  mutable var Maps: array of InteriorMap := [];
  for AreaId: string in State.VisitedAreas do
    begin
      Std.Arrays.Push(Maps, try ReadLevel(World, AreaId));
    end;
  end for;

  return Ok(Maps);
end function;
end unit;
