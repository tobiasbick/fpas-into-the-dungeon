// Versioned, server-owned persistence for one authoritative savegame per world.
unit Dungeon.World.Savegame;

uses Dungeon.Areas as Areas, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Interior as InteriorUnit, Dungeon.Terrain as Terrain, Dungeon.World as WorldUnit, Dungeon.World.Interiors as Interiors, Dungeon.World.Interiors.Errors as Errors, Dungeon.World.Savegame.Discovery as Discovery, Dungeon.World.Savegame.Errors as SavegameErrors, Dungeon.World.Savegame.Entities as Entities, Dungeon.World.Savegame.Player as Player, Std.Conv as Conv, Std.Fs as Fs, Std.Json as Json, Std.Json.Fields as JsonFields, Std.Path as PathOps;

// Current-only savegame schema written below each selected world.
public const SaveGameFormatVersion: integer := 8;

// Inspection result: absent, invalid and preserved with its reason, or fully validated state.
public type SaveGameLoad = enum
  Missing;
  Invalid(Reason: string);
  // Fully checked state and the exact current geometry used during validation.
  Loaded(State: GameState.GameState; View: GameState.AreaView);
end enum;

function SaveGameDirectory(World: WorldUnit.WorldSession): string;
begin
  return PathOps.Join([World.Directory, 'saves']);
end function;

// Returns the sole savegame path owned by the selected world.
public function SaveGamePath(World: WorldUnit.WorldSession): string;
begin
  return PathOps.Join([SaveGameDirectory(World), 'default.json']);
end function;

// Deletes only the selected world's single save, returning false when it is already absent.
public function DeleteSaveGame(World: WorldUnit.WorldSession): result of (boolean, string);
begin
  const Path: string := SaveGamePath(World);
  if not Fs.Exists(Path) then
    begin
      return Ok(false);
    end;
  end if;

  if not Fs.IsFile(Path) then
    begin
      return Error('savegame path exists but is not a file: ' + Path);
    end;
  end if;

  return Fs.DeleteFile(Path);
end function;

// Encodes only authoritative resumable state using the current savegame schema.
public function EncodeSaveGame(WorldId: string; State: GameState.GameState): string;
begin
  var Visited: array of Json.JsonValue := [];
  for AreaId: string in State.VisitedAreas do
    begin
      Visited.PushInPlace(Json.JsonValue.String(AreaId));
    end;
  end for;

  return Json.Stringify(
    Json.JsonValue.Object([
      'format_version': Json.JsonValue.Number(Conv.IntToReal(SaveGameFormatVersion)),
      'world_id': Json.JsonValue.String(WorldId),
      'area_kind': Json.JsonValue.String(Player.AreaKindName(State.Area)),
      'area_id': Json.JsonValue.String(State.AreaId),
      'player': Player.EncodePlayer(State.Player),
      'return_location': Player.EncodeReturnLocation(State.ReturnLocation),
      'exploration': Discovery.EncodeExploration(State.Exploration),
      'visited_areas': Json.JsonValue.ArrayValue(Visited),
      'items': Json.JsonValue.ArrayValue(Entities.EncodeItems(State.Items)),
      'health': Json.JsonValue.Number(Conv.IntToReal(State.Health)),
      'hostiles': Json.JsonValue.ArrayValue(Entities.EncodeHostiles(State.Hostiles)),
      'random_state': Json.JsonValue.Number(Conv.IntToReal(State.RandomState))
    ])
  );
end function;

function DecodeSaveGameFields(Text: string; Metadata: Terrain.WorldMetadata): result of (GameState.GameState, string);
begin
  const Fields: dict of string to Json.JsonValue := try JsonFields.ParseObject(Text);
  if Fields.Length() <> 12 then
    begin
      return Error('savegame has an unexpected field set');
    end;
  end if;

  if try JsonFields.IntegerField(Fields, 'format_version') <> SaveGameFormatVersion then
    begin
      return Error('unsupported savegame format version');
    end;
  end if;

  if try JsonFields.StringField(Fields, 'world_id') <> Metadata.Id then
    begin
      return Error('savegame world id does not match selected world');
    end;
  end if;
  const State: GameState.GameState := GameState.GameState(
    Area := try Player.DecodeAreaKind(try JsonFields.StringField(Fields, 'area_kind')),
    AreaId := try JsonFields.StringField(Fields, 'area_id'),
    Player := try Player.DecodePlayer(try JsonFields.ObjectField(Fields, 'player')),
    ReturnLocation := try Player.DecodeReturnLocation(
      try JsonFields.ObjectField(Fields, 'return_location')
    ),
    Exploration := try Discovery.DecodeExploration(
      try JsonFields.ObjectField(Fields, 'exploration')
    ),
    VisitedAreas := try JsonFields.StringArrayField(Fields, 'visited_areas'),
    Items := try Entities.DecodeItems(try JsonFields.ArrayField(Fields, 'items')),
    Health := try JsonFields.IntegerField(Fields, 'health'),
    Hostiles := try Entities.DecodeHostiles(try JsonFields.ArrayField(Fields, 'hostiles')),
    RandomState := try JsonFields.IntegerField(Fields, 'random_state')
  );
  return Areas.ValidateSaveShape(Metadata, State);
end function;

// First load phase: decodes an exact current-version save and checks its self-contained fields
// without reading levels. Not a full validation; only states that also pass ValidateSavedGame
// against their visited levels may become active. Every error is prefixed with `invalid savegame:`.
public function DecodeSaveGameState(Text: string; Metadata: Terrain.WorldMetadata): result of (GameState.GameState, string);
begin
  case DecodeSaveGameFields(Text, Metadata) of
    when Ok(const Value):
      begin
        return Ok(Value);
      end;
    when Error(const Message):
      begin
        return Error('invalid savegame: ' + Message);
      end;
  end case;
end function;

function CurrentMap(State: GameState.GameState; Maps: array of InteriorUnit.InteriorMap): option of InteriorUnit.InteriorMap;
begin
  if State.Area = Coordinates.AreaKind.Dungeon then
    begin
      for Map: InteriorUnit.InteriorMap in Maps do
        begin
          if Map.AreaId = State.AreaId then
            begin
              return Some(Map);
            end;
          end if;
        end;
      end for;
    end;
  end if;

  return None;
end function;

// Loads the selected world's save in three phases: decode its self-contained fields, read every
// visited level once, then validate the state against those maps. A missing or invalid level is a
// world-data failure that preserves the save; invalid save content is also preserved. Never generates.
public function LoadSaveGame(World: WorldUnit.WorldSession): result of (SaveGameLoad, SavegameErrors.PersistenceFailure);
begin
  const Path: string := SaveGamePath(World);
  const Parent: string := PathOps.Join([World.Directory, 'saves']);
  if Fs.Exists(Parent) and not Fs.IsDir(Parent) then
    return Error(
      SavegameErrors.PersistenceFailure.Io('savegame directory exists but is not a directory')
    );
  end if;

  if not Fs.Exists(Path) then
    begin
      return Ok(SaveGameLoad.Missing);
    end;
  end if;

  if not Fs.IsFile(Path) then
    begin
      return Error(SavegameErrors.PersistenceFailure.Io('savegame path exists but is not a file'));
    end;
  end if;
  var Text: string := '';
  case Fs.ReadText(Path) of
    when Ok(const Value):
      begin
        Text := Value;
      end;
    when Error(const Message):
      begin
        return Error(SavegameErrors.PersistenceFailure.Io('cannot read savegame: ' + Message));
      end;
  end case;
  var Decoded: GameState.GameState := GameState.NewGame(World.Metadata);
  case DecodeSaveGameState(Text, World.Metadata) of
    when Ok(const Value):
      begin
        Decoded := Value;
      end;
    when Error(const Message):
      begin
        return Ok(SaveGameLoad.Invalid(Message));
      end;
  end case;
  var Maps: array of InteriorUnit.InteriorMap := [];
  case Interiors.ReadVisitedLevels(World, Decoded) of
    when Ok(const Value):
      begin
        Maps := Value;
      end;
    when Error(const Failure):
      begin
        return Error(SavegameErrors.PersistenceFailure.Level(Failure));
      end;
  end case;

  case Areas.ValidateSavedGame(World.Metadata, Decoded, Maps) of
    when Ok(const State):
      begin
        case Areas.AreaViewFor(World.Metadata, State, CurrentMap(State, Maps)) of
          when Ok(const View):
            begin
              return Ok(SaveGameLoad.Loaded(State, View));
            end;
          when Error(const Message):
            begin
              return Ok(SaveGameLoad.Invalid('invalid savegame: ' + Message));
            end;
        end case;
      end;
    when Error(const Message):
      begin
        return Ok(SaveGameLoad.Invalid('invalid savegame: ' + Message));
      end;
  end case;
end function;

// Validates the state against its visited levels and atomically replaces the selected world's
// single save. Failures never delete anything and leave the previous save intact.
public function WriteSaveGame(World: WorldUnit.WorldSession; State: GameState.GameState): result of (boolean, SavegameErrors.PersistenceFailure);
begin
  case Areas.ValidateSaveShape(World.Metadata, State) of
    when Error(const Message):
      return Error(SavegameErrors.PersistenceFailure.InvalidState(Message));
    when Ok(_):
      null;
  end case;
  var Maps: array of InteriorUnit.InteriorMap := [];
  case Interiors.ReadVisitedLevels(World, State) of
    when Ok(const Value):
      begin
        Maps := Value;
      end;
    when Error(const Failure):
      begin
        return Error(SavegameErrors.PersistenceFailure.Level(Failure));
      end;
  end case;

  case Areas.ValidateSavedGame(World.Metadata, State, Maps) of
    when Error(const Message):
      return Error(SavegameErrors.PersistenceFailure.InvalidState(Message));
    when Ok(_):
      null;
  end case;

  case Fs.CreateDirAll(SaveGameDirectory(World)) of
    when Error(const Message):
      return Error(
        SavegameErrors.PersistenceFailure.Io('cannot create savegame directory: ' + Message)
      );
    when Ok(_):
      null;
  end case;

  case Fs.WriteTextAtomic(SaveGamePath(World), EncodeSaveGame(World.Metadata.Id, State)) of
    when Ok(const Written):
      begin
        return Ok(true);
      end;
    when Error(const Message):
      begin
        return Error(SavegameErrors.PersistenceFailure.Io('cannot write savegame: ' + Message));
      end;
  end case;
end function;
end unit;
