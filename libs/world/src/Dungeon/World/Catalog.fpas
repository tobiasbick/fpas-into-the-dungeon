// World catalog inspection, exclusive creation and explicit complete-world deletion.
unit Dungeon.World.Catalog;

uses Dungeon.Terrain as Terrain, Dungeon.Terrain.Placement as PlacementRules, Dungeon.World as WorldUnit, Dungeon.World.Encoding as Encoding, Dungeon.World.Savegame as Savegame, Dungeon.World.Savegame.Errors as SavegameErrors, Std.Conv as Conv, Std.Fs as Fs, Std.Path as PathOps;

// New-world parameter policy; the existing generator also supports wider stored seeds.
public const MinimumWorldSeed: integer := -2147483648;
public const MaximumWorldSeed: integer := 2147483647;

// Missing selection, incompatible metadata, and storage failures remain distinct.
public type WorldAccessFailure = enum
  Missing;
  Incompatible(Reason: string);
  Io(Reason: string);
end enum;

// One existing world, including unusable entries; inspection never changes its files.
public type WorldEntry = record
  public Id: string;
  public Metadata: option of Terrain.WorldMetadata;
  // ready, incompatible, or storage_error.
  public Status: string;
  // missing, available, incompatible, storage_error, world_data_error, or unknown.
  public SaveStatus: string;
  public Reason: string;
end record;

// Deletes one canonical child directory without requiring compatible metadata or a valid save.
// Callers must exclude active sessions. Linked targets are refused; filesystem errors can leave
// partially deleted contents and must be reported. Missing targets return Ok(false).
public function DeleteWorld(Root: string; Id: string): result of (boolean, string);
begin
  const ValidId := try Encoding.ValidateWorldId(Id);
  if Root.Trim() = '' then
    return Error('worlds root must not be empty');
  end if;
  const AbsoluteRoot := PathOps.Normalize(PathOps.Join([try Fs.CurrentDir(), Root]));
  const Absolute := AbsoluteRoot.StartsWith('/') or AbsoluteRoot.StartsWith('\\')
    or
    (
      (AbsoluteRoot.Length() > 2) and (AbsoluteRoot[1] = ':')
      and
      ((AbsoluteRoot[2] = '/') or (AbsoluteRoot[2] = '\'))
    );
  if not Absolute then
    return Error('worlds root must resolve to an absolute path');
  end if;

  if not Fs.IsDir(AbsoluteRoot) then
    return Error('worlds root is not a directory');
  end if;
  const Directory := PathOps.Normalize(PathOps.Join([AbsoluteRoot, ValidId]));
  if (Directory = AbsoluteRoot) or (PathOps.DirName(Directory) <> AbsoluteRoot) then
    return Error('world directory must be a direct child of the worlds root');
  end if;

  if Fs.IsSymLink(Directory) then
    return Error('linked world directories cannot be deleted');
  end if;

  if not Fs.Exists(Directory) then
    return Ok(false);
  end if;

  if not Fs.IsDir(Directory) then
    return Error('world path is not a directory');
  end if;

  case Fs.DeleteDirAll(Directory) of
    when Ok(const Deleted):
      return Ok(Deleted);
    when Error(const Reason):
      return Error('Deletion failed; some contents may already have been removed. ' + Reason);
  end case;
end function;

// Opens only current valid metadata. It never creates directories, chunks, levels, or saves.
public function OpenExistingWorld(Root: string; Id: string; CacheLimit: integer): result of (WorldUnit.WorldSession, WorldAccessFailure);
begin
  case Encoding.ValidateWorldId(Id) of
    when Error(const Reason):
      return Error(WorldAccessFailure.Incompatible(Reason));
    when Ok(_):
      null;
  end case;

  if CacheLimit < 1 then
    begin
      return Error(WorldAccessFailure.Io('chunk cache must be positive'));
    end;
  end if;

  if not Fs.IsDir(Root) then
    begin
      return Error(WorldAccessFailure.Io('worlds root is not a directory'));
    end;
  end if;
  const Directory: string := PathOps.Join([Root, Id]);
  if not Fs.Exists(Directory) then
    begin
      return Error(WorldAccessFailure.Missing);
    end;
  end if;
  const Path: string := PathOps.Join([Directory, 'world.json']);
  if not Fs.IsDir(Directory) or (Fs.Exists(Path) and not Fs.IsFile(Path)) then
    begin
      return Error(WorldAccessFailure.Io('world storage path has the wrong type'));
    end;
  end if;

  if not Fs.Exists(Path) then
    begin
      return Error(WorldAccessFailure.Incompatible('world metadata is missing'));
    end;
  end if;

  case Fs.ReadText(Path) of
    when Error(const Reason):
      begin
        return Error(WorldAccessFailure.Io(Reason));
      end;
    when Ok(const Text):
      begin
        case Encoding.DecodeMetadata(Text, Id) of
          when Error(const Reason):
            begin
              return Error(WorldAccessFailure.Incompatible(Reason));
            end;
          when Ok(const Metadata):
            begin
              return Ok(
                WorldUnit.WorldSession(
                  Directory := Directory,
                  Metadata := Metadata,
                  Cache := [],
                  Clock := 0,
                  CacheLimit := CacheLimit
                )
              );
            end;
        end case;
      end;
  end case;
end function;

// Inspects metadata and the complete save without deleting invalid content or generating levels.
public function InspectWorld(Root: string; Id: string; CacheLimit: integer): WorldEntry;
begin
  var Entry: WorldEntry := WorldEntry(
    Id := Id,
    Metadata := None,
    Status := 'incompatible',
    SaveStatus := 'unknown',
    Reason := ''
  );
  case OpenExistingWorld(Root, Id, CacheLimit) of
    when Error(const Failure):
      begin
        case Failure of
          when WorldAccessFailure.Missing:
            begin
              Entry.Reason := 'World is missing. Create a new world.';
            end;
          when WorldAccessFailure.Incompatible(const Reason):
            begin
              Entry.Reason := Reason + '. Delete or recreate this world.';
            end;
          when WorldAccessFailure.Io(const Reason):
            begin
              Entry.Status := 'storage_error';
              Entry.Reason := 'World storage access failed. Check storage access.';
            end;
        end case;
      end;
    when Ok(const World):
      begin
        Entry.Metadata := Some(World.Metadata);
        Entry.Status := 'ready';
        case Savegame.LoadSaveGame(World) of
          when Error(const Failure):
            begin
              Entry.SaveStatus := 'storage_error';
              Entry.Reason := 'Saved game storage failed. Check storage access.';
              case Failure of
                when SavegameErrors.PersistenceFailure.Area(const Level):
                  Entry.SaveStatus := 'world_data_error';
                  Entry.Reason := 'A referenced area definition is missing, invalid, or unreadable.';
                when SavegameErrors.PersistenceFailure.InvalidState(_), SavegameErrors.PersistenceFailure.Io(_):
                  null;
              end case;
            end;
          when Ok(const Loaded):
            begin
              case Loaded of
                when Savegame.SaveGameLoad.Missing:
                  begin
                    Entry.SaveStatus := 'missing';
                  end;
                when Savegame.SaveGameLoad.Invalid(const Reason):
                  begin
                    Entry.SaveStatus := 'incompatible';
                    Entry.Reason := Reason + '. Recreate the save or start over.';
                  end;
                when Savegame.SaveGameLoad.Loaded(const State, const View):
                  begin
                    Entry.SaveStatus := 'available';
                  end;
              end case;
            end;
        end case;
      end;
  end case;

  return Entry;
end function;

// Lists canonical directory identities in stable order without opening metadata, saves or levels.
// Missing/non-directory roots and enumeration failures return Error; no storage is created.
public function ListWorldIds(Root: string): result of (array of string, string);
begin
  if not Fs.IsDir(Root) then
    begin
      return Error('worlds root is missing or not a directory');
    end;
  end if;
  const Paths: array of string := try Fs.ReadDir(Root);
  var Ids: array of string := [];
  for Path: string in Paths do
    begin
      const Id: string := PathOps.BaseName(Path);
      if Fs.IsDir(Path) then
        begin
          case Encoding.ValidateWorldId(Id) of
            when Ok(const Valid):
              Ids.PushInPlace(Valid);
            when Error(_):
              null;
          end case;
        end;
      end if;
    end;
  end for;

  return Ok(Ids);
end function;

// Inspects every canonical world in stable order; use identity listing before selecting a page.
// Every returned entry retains full metadata/save/visited-level validation without modifying files.
public function ListWorlds(Root: string; CacheLimit: integer): result of (array of WorldEntry, string);
begin
  const Ids := try ListWorldIds(Root);
  var Entries: array of WorldEntry := [];
  for Id: string in Ids do
    Entries.PushInPlace(InspectWorld(Root, Id, CacheLimit));
  end for;

  return Ok(Entries);
end function;

// Allocates a new ID with exclusive directory creation; an existing identity is never reused.
public function CreateWorld(Root: string; Seed: integer; RegionChunks: integer; CacheLimit: integer): result of (WorldUnit.WorldSession, string);
begin
  if (Seed < MinimumWorldSeed) or (Seed > MaximumWorldSeed) then
    begin
      return Error('seed is outside the signed 32-bit range');
    end;
  end if;

  if CacheLimit < 1 then
    begin
      return Error('chunk cache must be positive');
    end;
  end if;
  // Validate all generation parameters before creating any storage.
  const Prepared: Terrain.WorldMetadata := try PlacementRules.NewWorldMetadata(
    'pending',
    Seed,
    RegionChunks
  );
  const Ready: boolean := try Fs.CreateDirAll(Root);
  var Number: integer := 1;
  while Number < 1000000 do
    begin
      const Id: string := 'world-' + Conv.IntToStr(Number);
      const Directory: string := PathOps.Join([Root, Id]);
      if not Fs.Exists(Directory) then
        begin
          case Fs.CreateDir(Directory) of
            when Ok(const Created):
              begin
                const Metadata: Terrain.WorldMetadata := Prepared with Id := Id; OutdoorAreaId := Id +
                  ':outdoor'; end with;
                const Written: boolean := try Fs.WriteTextAtomic(
                  PathOps.Join([
                    Directory,
                    'world.json'
                  ]), Encoding.EncodeMetadata(Metadata)
                );
                return Ok(
                  WorldUnit.WorldSession(
                    Directory := Directory,
                    Metadata := Metadata,
                    Cache := [],
                    Clock := 0,
                    CacheLimit := CacheLimit
                  )
                );
              end;
            when Error(const Reason):
              begin
                if not Fs.Exists(Directory) then
                  begin
                    return Error(Reason);
                  end;
                end if;
              end;
          end case;
        end;
      end if;

      Number := Number + 1;
    end;
  end while;

  return Error('no free world identity is available');
end function;
end unit;
