// Typed failures shared by immutable dungeon levels and generated settlement definitions.
unit Dungeon.World.Areas.Errors;

// Missing: no definition exists; Invalid: unusable data or identity; Io: filesystem failure;
// Generation: a first-visit definition could not be created. Callers never classify error text.
public type AreaFailure = enum
  Missing(AreaId: string);
  Invalid(AreaId: string; Reason: string);
  Io(Reason: string);
  Generation(AreaId: string; Reason: string);
end enum;
end unit;
