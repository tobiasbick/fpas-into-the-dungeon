// Persistent chunk loading, creation, caching, and visible-window composition.
unit Dungeon.World;

uses Dungeon.World.Encoding as Encoding, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Movement as Movement, Dungeon.Terrain as Terrain, Dungeon.Terrain.Chunks as ChunksUnit, Dungeon.Terrain.Placement as PlacementRules, Std.Conv as Conv, Std.Fs as Fs, Std.Path as PathOps;

// Renders typed library failures at this unit's application-owned text boundary.
function FailureMessage<E: Error>(Cause: E): string;
begin
  return Cause.Message();
end function;

// Default deterministic seed used only when creating a selected world for the first time.
public const DefaultWorldSeed: integer := 12345;
// Default maximum number of complete chunks retained by one world session.
public const DefaultChunkCacheLimit: integer := 64;

// Inclusive chunk rectangle intersecting a visible world-coordinate rectangle.
public type ChunkRange = record
  public MinimumX: integer;
  public MinimumY: integer;
  public MaximumX: integer;
  public MaximumY: integer;
end record;

// One bounded client-safe projection composed from authoritative chunks.
public type VisibleWindow = record
  public OriginX: integer;
  public OriginY: integer;
  public Width: integer;
  public Height: integer;
  public Rows: array of string;
  public PlayerX: integer;
  public PlayerY: integer;
end record;

// Internal cache entry carried immutably with the world session.
public type CachedWorldChunk = record
  public Chunk: Terrain.WorldChunk;
  public LastUsed: integer;
end record;

// Open authoritative world metadata, storage location, and bounded chunk cache.
public type WorldSession = record
  public Directory: string;
  public Metadata: Terrain.WorldMetadata;
  public Cache: array of CachedWorldChunk;
  public Clock: integer;
  public CacheLimit: integer;
end record;

// Returns a loaded chunk together with the updated immutable cache state.
public type ChunkLoad = record
  public World: WorldSession;
  public Chunk: Terrain.WorldChunk;
end record;

// Returns one cell together with the updated immutable cache state.
public type CellLoad = record
  public World: WorldSession;
  public Cell: Terrain.WorldCell;
end record;

// Returns a composed visible window together with the updated immutable cache state.
public type WindowLoad = record
  public World: WorldSession;
  public Window: VisibleWindow;
end record;

// Returns an authoritative movement result together with the updated cache state.
public type WorldMove = record
  public World: WorldSession;
  public State: GameState.GameState;
end record;

// Returns the stable metadata path for an open world.
public function WorldMetadataPath(World: WorldSession): string;
begin
  return PathOps.Join([World.Directory, 'world.json']);
end function;

function ChunkColumnDirectory(World: WorldSession; Coordinate: Coordinates.ChunkCoordinate): string;
begin
  return PathOps.Join([World.Directory, 'chunks', 'x_' + Conv.IntToStr(Coordinate.X)]);
end function;

// Returns the stable file path for positive or negative chunk coordinates.
public function WorldChunkPath(World: WorldSession; Coordinate: Coordinates.ChunkCoordinate): string;
begin
  return PathOps.Join([
    ChunkColumnDirectory(World, Coordinate),
    ('y_' + Conv.IntToStr(Coordinate.Y)) + '.json'
  ]);
end function;

// Opens an existing world or atomically creates new deterministic metadata.
// Seed and DungeonRegionChunks apply only to a new world; an existing world keeps its stored values.
public function OpenWorld(
  WorldsRoot: string;
  WorldId: string;
  Seed: integer;
  DungeonRegionChunks: integer;
  CacheLimit: integer
): result of (WorldSession, string);
begin
  const ValidId: string := try Encoding.ValidateWorldId(WorldId);
  if CacheLimit < 1 then
    begin
      return Error('world chunk cache limit must be positive');
    end;
  end if;
  const RootReady: boolean := try Fs.CreateDirAll(WorldsRoot).MapError(FailureMessage);
  const Directory: string := PathOps.Join([WorldsRoot, ValidId]);
  const DirectoryReady: boolean := try Fs.CreateDirAll(Directory).MapError(FailureMessage);
  var Empty: WorldSession := WorldSession(
    Directory := Directory,
    Metadata := try PlacementRules.NewWorldMetadata(ValidId, Seed, DungeonRegionChunks),
    Cache := [],
    Clock := 0,
    CacheLimit := CacheLimit
  );
  const ChunksReady: boolean := try Fs.CreateDirAll(
    PathOps.Join([Directory, 'chunks'])
  ).MapError(FailureMessage);
  const MetadataPath: string := WorldMetadataPath(Empty);
  var Metadata: Terrain.WorldMetadata := Empty.Metadata;
  if Fs.Exists(MetadataPath) then
    begin
      if not Fs.IsFile(MetadataPath) then
        begin
          return Error('world metadata path exists but is not a file: ' + MetadataPath);
        end;
      end if;

      Metadata := try Encoding.DecodeMetadata(
        try Fs.ReadText(MetadataPath).MapError(FailureMessage),
        ValidId
      );
    end;
  else
    begin
      const Written: boolean := try Fs.WriteTextAtomic(
        MetadataPath,
        Encoding.EncodeMetadata(Metadata)
      ).MapError(FailureMessage);
    end;
  end if;

  Empty.Metadata := Metadata;
  return Ok(Empty);
end function;

function CacheIndex(World: WorldSession; Coordinate: Coordinates.ChunkCoordinate): integer;
begin
  for Index: integer := 0 to World.Cache.Length() - 1 do
    begin
      if (World.Cache[Index].Chunk.Coordinate.X = Coordinate.X)
        and
        (World.Cache[Index].Chunk.Coordinate.Y = Coordinate.Y)
      then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  return -1;
end function;

function StoreInCache(World: WorldSession; Chunk: Terrain.WorldChunk): WorldSession;
begin
  var Next: WorldSession := World;
  Next.Clock := World.Clock + 1;
  var Values: array of CachedWorldChunk := [];
  for Index: integer := 0 to World.Cache.Length() - 1 do
    begin
      if not (
        (World.Cache[Index].Chunk.Coordinate.X = Chunk.Coordinate.X)
        and
        (World.Cache[Index].Chunk.Coordinate.Y = Chunk.Coordinate.Y)
      )
      then
        begin
          Values.PushInPlace(World.Cache[Index]);
        end;
      end if;
    end;
  end for;

  if Values.Length() >= World.CacheLimit then
    begin
      var OldestIndex: integer := 0;
      for Index: integer := 1 to Values.Length() - 1 do
        begin
          if Values[Index].LastUsed < Values[OldestIndex].LastUsed then
            begin
              OldestIndex := Index;
            end;
          end if;
        end;
      end for;
      var Retained: array of CachedWorldChunk := [];
      for Index: integer := 0 to Values.Length() - 1 do
        begin
          if Index <> OldestIndex then
            begin
              Retained.PushInPlace(Values[Index]);
            end;
          end if;
        end;
      end for;

      Values := Retained;
    end;
  end if;

  Values.PushInPlace(CachedWorldChunk(Chunk := Chunk, LastUsed := Next.Clock));
  Next.Cache := Values;
  return Next;
end function;

function ReadOrCreateChunk(World: WorldSession; Coordinate: Coordinates.ChunkCoordinate): result of (Terrain.WorldChunk, string);
begin
  const ColumnReady: boolean := try Fs.CreateDirAll(
    ChunkColumnDirectory(World, Coordinate)
  ).MapError(FailureMessage);
  const Path: string := WorldChunkPath(World, Coordinate);
  if Fs.Exists(Path) then
    begin
      if not Fs.IsFile(Path) then
        begin
          return Error('chunk path exists but is not a file: ' + Path);
        end;
      end if;

      return Encoding.DecodeChunk(
        try Fs.ReadText(Path).MapError(FailureMessage),
        World.Metadata,
        Coordinate
      );
    end;
  end if;
  const Generated: Terrain.WorldChunk := ChunksUnit.GenerateChunk(World.Metadata, Coordinate);
  const Written: boolean := try Fs.WriteTextAtomic(
    Path,
    Encoding.EncodeChunk(World.Metadata.Id, Generated)
  ).MapError(FailureMessage);
  return Ok(Generated);
end function;

// Loads one cached or persisted chunk, generating and storing it when absent.
public function LoadWorldChunk(World: WorldSession; Coordinate: Coordinates.ChunkCoordinate): result of (ChunkLoad, string);
begin
  const Existing: integer := CacheIndex(World, Coordinate);
  if Existing >= 0 then
    begin
      const Chunk: Terrain.WorldChunk := World.Cache[Existing].Chunk;
      return Ok(ChunkLoad(World := StoreInCache(World, Chunk), Chunk := Chunk));
    end;
  end if;
  const Loaded: Terrain.WorldChunk := try ReadOrCreateChunk(World, Coordinate);
  return Ok(ChunkLoad(World := StoreInCache(World, Loaded), Chunk := Loaded));
end function;

// Loads one authoritative cell at signed world coordinates.
public function LoadWorldCell(World: WorldSession; X: integer; Y: integer): result of (CellLoad, string);
begin
  const Coordinate: Coordinates.ChunkCoordinate := Coordinates.ChunkCoordinate(
    X := Coordinates.ChunkForCoordinate(X),
    Y := Coordinates.ChunkForCoordinate(Y)
  );
  const Loaded: ChunkLoad := try LoadWorldChunk(World, Coordinate);
  return Ok(
    CellLoad(
      World := Loaded.World,
      Cell := Terrain.ChunkCell(
        Loaded.Chunk,
        Coordinates.LocalForCoordinate(X),
        Coordinates.LocalForCoordinate(Y)
      )
    )
  );
end function;

// Computes all chunks intersecting a positive-sized visible rectangle.
public function ChunkRangeForWindow(OriginX: integer; OriginY: integer; Width: integer; Height: integer): result of (ChunkRange, string);
begin
  if (Width <= 0) or (Height <= 0) then
    begin
      return Error('visible window dimensions must be positive');
    end;
  end if;

  return Ok(
    ChunkRange(
      MinimumX := Coordinates.ChunkForCoordinate(OriginX),
      MinimumY := Coordinates.ChunkForCoordinate(OriginY),
      MaximumX := Coordinates.ChunkForCoordinate(
        (OriginX + Width) -
        1
      ), MaximumY := Coordinates.ChunkForCoordinate(
        (OriginY + Height) -
        1
      )
    )
  );
end function;

function CachedCell(World: WorldSession; X: integer; Y: integer): result of (Terrain.WorldCell, string);
begin
  const Coordinate: Coordinates.ChunkCoordinate := Coordinates.ChunkCoordinate(
    X := Coordinates.ChunkForCoordinate(X),
    Y := Coordinates.ChunkForCoordinate(Y)
  );
  const Index: integer := CacheIndex(World, Coordinate);
  if Index < 0 then
    begin
      return Error('required chunk is absent from the prepared cache');
    end;
  end if;

  return Ok(
    Terrain.ChunkCell(
      World.Cache[Index].Chunk,
      Coordinates.LocalForCoordinate(X),
      Coordinates.LocalForCoordinate(Y)
    )
  );
end function;

function PrepareWindow(World: WorldSession; Range: ChunkRange): result of (WorldSession, string);
begin
  const CountX: integer := (Range.MaximumX - Range.MinimumX) + 3;
  const CountY: integer := (Range.MaximumY - Range.MinimumY) + 3;
  if (CountX * CountY) > World.CacheLimit then
    begin
      return Error('visible window and prefetch margin exceed the chunk cache limit');
    end;
  end if;
  var Current: WorldSession := World;
  for ChunkY: integer := Range.MinimumY - 1 to Range.MaximumY + 1 do
    begin
      for ChunkX: integer := Range.MinimumX - 1 to Range.MaximumX + 1 do
        begin
          const Loaded: ChunkLoad := try LoadWorldChunk(
            Current,
            Coordinates.ChunkCoordinate(X := ChunkX, Y := ChunkY)
          );
          Current := Loaded.World;
        end;
      end for;
    end;
  end for;

  return Ok(Current);
end function;

// Composes a centered client-safe window and preloads one surrounding chunk margin.
public function LoadVisibleWindow(World: WorldSession; State: GameState.GameState; Width: integer; Height: integer): result of (WindowLoad, string);
begin
  if State.Area <> Coordinates.AreaKind.OutdoorRegion then
    begin
      return Error('visible outdoor windows require the outdoor area');
    end;
  end if;
  const Player: Coordinates.WorldPosition := try GameState.OutdoorPlayerPosition(State);
  const OriginX: integer := Player.X - (Width div 2);
  const OriginY: integer := Player.Y - (Height div 2);
  const Range: ChunkRange := try ChunkRangeForWindow(OriginX, OriginY, Width, Height);
  const Prepared: WorldSession := try PrepareWindow(World, Range);
  var Rows: array of string := [];
  for LocalY: integer := 0 to Height - 1 do
    begin
      var Row: string := '';
      for LocalX: integer := 0 to Width - 1 do
        begin
          Row := Row +
            Terrain.VisibleCellCode(try CachedCell(Prepared, OriginX + LocalX, OriginY + LocalY));
        end;
      end for;

      Rows.PushInPlace(Row);
    end;
  end for;

  return Ok(
    WindowLoad(
      World := Prepared, Window := VisibleWindow(
        OriginX := OriginX, OriginY := OriginY, Width := Width, Height := Height, Rows := Rows,
        PlayerX := Player.X -
        OriginX, PlayerY := Player.Y -
        OriginY
      )
    )
  );
end function;

// Applies movement against the generated target terrain and returns updated world state.
public function MoveInWorld(World: WorldSession; State: GameState.GameState; DeltaX: integer; DeltaY: integer): result of (WorldMove, string);
begin
  if State.Area <> Coordinates.AreaKind.OutdoorRegion then
    begin
      return Error('movement is unavailable in the current area');
    end;
  end if;

  if not Coordinates.IsCardinalStep(DeltaX, DeltaY) then
    begin
      return Error('movement must be one cardinal step');
    end;
  end if;
  const Player: Coordinates.WorldPosition := try GameState.OutdoorPlayerPosition(State);
  const Target: CellLoad := try LoadWorldCell(World, Player.X + DeltaX, Player.Y + DeltaY);
  return Ok(
    WorldMove(
      World := Target.World,
      State := try Movement.MovePlayer(State, DeltaX, DeltaY, Target.Cell)
    )
  );
end function;

// Returns the number of complete chunks currently retained in memory.
public function CachedChunkCount(World: WorldSession): integer;
begin
  return World.Cache.Length();
end function;
end unit;
