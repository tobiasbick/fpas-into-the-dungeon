// Shared classic-retro terminal palette for the client and server console.
unit Dungeon.Ui.Theme;

uses Std.Ui.Terminal as Tui;

function ButtonColors(Normal: Tui.TuiColor; Bright: Tui.TuiColor; Surface: Tui.TuiColor; Focus: Tui.TuiColor; DefaultBackground: Tui.TuiColor; Muted: Tui.TuiColor; Dark: Tui.TuiColor): Tui.TuiButtonColors;
begin
  return Tui.TuiButtonColors.Create(
    Tui.TuiStyle.FromColors(Normal, Surface), Tui.TuiStyle.FromColors(Bright, Surface),
    Tui.TuiStyle.FromColors(Bright, Focus), Tui.TuiStyle.FromColors(Dark, Bright),
    Tui.TuiStyle.FromColors(Muted, Surface), Tui.TuiStyle.FromColors(Bright, DefaultBackground)
  );
end function;

// Returns the agreed palette for desktop, panels, overlays and controls.
public function Palette(): Tui.TuiPalette;
begin
  const Background := Tui.TuiColor.FromRgb(23, 20, 15);
  const Surface := Tui.TuiColor.FromRgb(33, 28, 21);
  const Overlay := Tui.TuiColor.FromRgb(43, 36, 26);
  const Brass := Tui.TuiColor.FromRgb(166, 138, 85);
  const Gold := Tui.TuiColor.FromRgb(226, 196, 119);
  const Text := Tui.TuiColor.FromRgb(232, 223, 199);
  const Muted := Tui.TuiColor.FromRgb(169, 157, 134);
  const Selection := Tui.TuiColor.FromRgb(112, 85, 34);
  const Success := Tui.TuiColor.FromRgb(143, 191, 120);
  const Warning := Tui.TuiColor.FromRgb(224, 168, 90);
  const ErrorColor := Tui.TuiColor.FromRgb(219, 119, 112);
  const Normal := Tui.TuiStyle.FromColors(Text, Background);
  const AreaText := Tui.TuiStyle.FromColors(Text, Surface);
  const OverlayText := Tui.TuiStyle.FromColors(Text, Overlay);
  const Selected := Tui.TuiStyle.FromColors(Text, Selection);
  const Highlight := Tui.TuiStyle.FromColors(Gold, Surface);
  var Colors := Tui.TuiPalette.Default();
  Colors.Normal := Normal;
  Colors.Disabled := Tui.TuiStyle.FromColors(Muted, Surface);
  Colors.Focused := Selected;
  Colors.Selected := Tui.TuiStyle.FromColors(Gold, Overlay);
  Colors.Shortcut := Highlight;
  Colors.Frame := Tui.TuiStyle.FromColors(Brass, Surface);
  Colors.Title := Highlight;
  Colors.PanelNormal := Some(AreaText);
  Colors.PanelTitle := Some(Tui.TuiStyle.FromColors(Gold, Surface));
  Colors.PanelFocusedFrame := Some(Tui.TuiStyle.FromColors(Gold, Surface));
  Colors.OverlayNormal := Some(OverlayText);
  Colors.OverlayFrame := Some(Tui.TuiStyle.FromColors(Brass, Overlay));
  Colors.OverlayFocusedFrame := Some(Tui.TuiStyle.FromColors(Gold, Overlay));
  Colors.OverlayTitle := Some(Tui.TuiStyle.FromColors(Gold, Overlay));
  Colors.TabNormal := Some(Tui.TuiStyle.FromColors(Muted, Overlay));
  Colors.TabSelected := Some(Tui.TuiStyle.FromColors(Gold, Overlay));
  Colors.TabSelectedFocused := Some(Selected);
  Colors.TabDisabled := Some(Tui.TuiStyle.FromColors(Muted, Surface));
  Colors.MenuNormal := AreaText;
  Colors.MenuDisabled := Tui.TuiStyle.FromColors(Muted, Surface);
  Colors.MenuShortcut := Tui.TuiStyle.FromColors(Gold, Surface);
  Colors.MenuSelected := Selected;
  Colors.MenuSelectedShortcut := Selected;
  Colors.StatusNormal := AreaText;
  Colors.StatusDisabled := Tui.TuiStyle.FromColors(Muted, Surface);
  Colors.StatusShortcut := Tui.TuiStyle.FromColors(Gold, Surface);
  Colors.StatusSelected := Selected;
  Colors.Buttons := Tui.TuiButtonPalette.Create(
    OverlayText, Tui.TuiStyle.FromColors(Gold, Overlay), Selected,
    Tui.TuiStyle.FromColors(Muted, Overlay), Tui.TuiStyle.FromColors(Gold, Overlay),
    Tui.TuiStyle.FromColors(Gold, Overlay), Selected
  );
  const ButtonBackground := Tui.TuiColor.FromRgb(56, 48, 35);
  const DefaultBackground := Tui.TuiColor.FromRgb(74, 60, 39);
  const Cancel := Tui.TuiColor.FromRgb(181, 187, 166);
  const LightCancel := Tui.TuiColor.FromRgb(218, 224, 199);
  const LightWarning := Tui.TuiColor.FromRgb(255, 201, 125);
  const LightError := Tui.TuiColor.FromRgb(255, 172, 163);
  Colors.Buttons.NormalKind := Some(
    ButtonColors(Text, Gold, ButtonBackground, Selection, DefaultBackground, Muted, Background)
  );
  Colors.Buttons.Primary := Some(
    ButtonColors(Gold, Text, ButtonBackground, Selection, DefaultBackground, Muted, Background)
  );
  Colors.Buttons.Cancel := Some(
    ButtonColors(
      Cancel,
      LightCancel,
      ButtonBackground,
      Tui.TuiColor.FromRgb(64, 70, 55),
      DefaultBackground,
      Muted,
      Background
    )
  );
  Colors.Buttons.Warning := Some(
    ButtonColors(
      Warning,
      LightWarning,
      ButtonBackground,
      Tui.TuiColor.FromRgb(95, 62, 30),
      DefaultBackground,
      Muted,
      Background
    )
  );
  Colors.Buttons.Dangerous := Some(
    ButtonColors(
      ErrorColor,
      LightError,
      ButtonBackground,
      Tui.TuiColor.FromRgb(98, 46, 39),
      DefaultBackground,
      Muted,
      Background
    )
  );
  Colors.Inputs := Tui.TuiInputPalette.Create(
    AreaText, AreaText, Tui.TuiStyle.FromColors(Muted, Surface),
    Tui.TuiStyle.FromColors(Background, Gold), Tui.TuiStyle.FromColors(Gold, Surface)
  );
  Colors.Rule := Tui.TuiStyle.FromColors(Brass, Surface);
  Colors.GaugeTrack := Tui.TuiStyle.FromColors(Brass, Surface);
  Colors.GaugeFill := Tui.TuiStyle.FromColors(Success, Surface);
  Colors.Failure := Tui.TuiStyle.FromColors(ErrorColor, Surface);
  Colors.Warning := Tui.TuiStyle.FromColors(Warning, Surface);
  Colors.Accent := Highlight;
  return Colors;
end function;
end unit;
