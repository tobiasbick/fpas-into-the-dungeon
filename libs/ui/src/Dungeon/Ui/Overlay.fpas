// Shared one-cell inset for game overlay content.
unit Dungeon.Ui.Overlay;

uses Std.Ui.Terminal as Tui;

// Insets a page on all sides while allowing it to fill the space available.
public function Inset(Content: Tui.TuiElement): Tui.TuiElement;
begin
  const Settings := Tui.TuiLayoutSettings.Default() with Margins := Tui.TuiMargins.Uniform(1); SizePolicy := Tui.TuiSizePolicy.Expanding(); Stretch := 1; end with;

  return Tui.TuiElementBuilders.MakeLayout(Settings, Content);
end function;

// Creates a content-sized overlay with an inset around its children.
public function Create(Title: string; Children: array of Tui.TuiElement): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeOverlay(
    Title,
    [Inset(Tui.TuiElementBuilders.MakeColumn(Children))]
  );
end function;

// Creates a viewport-sized overlay with the same inset.
public function Responsive(Title: string; Rule: Tui.TuiOverlaySizeRule; Children: array of Tui.TuiElement): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeResponsiveOverlay(
    Title,
    Rule,
    [Inset(Tui.TuiElementBuilders.MakeColumn(Children))]
  );
end function;
end unit;
