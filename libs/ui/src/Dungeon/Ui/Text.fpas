// Shared terminal-cell wrapping for complete client messages and console diagnostics.
unit Dungeon.Ui.Text;

uses Std.Console as Console, Std.Math as Math;

// Wraps at spaces or grapheme boundaries, preserving explicit newlines and wide characters.
public function Wrap(Text: string; Width: integer): array of string;
begin
  var Lines: array of string := [];
  var Line := '';
  const Available := Math.Max(1, Width);
  for Original: string in Console.SplitGraphemes(Text) do
    const Glyph := if Original = string.Chr(13) + string.Chr(10) then string.Chr(10)
      elsif ((Original < ' ') and (Original <> string.Chr(10)))
        or
        ((Original >= string.Chr(127)) and (Original <= string.Chr(159))) then ' '
      else Original
      end if;
    if Glyph = string.Chr(10) then
      Lines.PushInPlace(Line);
      Line := '';
    else
      if (Line <> '') and (Console.DisplayWidth(Line) + Console.GraphemeWidth(Glyph) > Available) then
        var Split := Line.Length() - 1;
        while (Split > 0) and (Line[Split] <> ' ') do
          Split := Split - 1;
        end while;

        if Split > 0 then
          Lines.PushInPlace(Line.Slice(0, Split));
          Line := Line.Slice(Split + 1, Line.Length() - Split - 1).Trim();
        else
          Lines.PushInPlace(Line);
          Line := '';
        end if;
      end if;

      if (Glyph <> ' ') or (Line <> '') then
        Line := Line + Glyph;
      end if;
    end if;
  end for;

  if Line <> '' then
    Lines.PushInPlace(Line);
  end if;

  return Lines;
end function;
end unit;
