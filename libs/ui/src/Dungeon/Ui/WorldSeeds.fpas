// Curated landscape seeds and their shared client/server presentation.
unit Dungeon.Ui.WorldSeeds;

uses Std.Text.Format as Conv, Std.Ui.Terminal as Tui;

// A known landscape for the current terrain generator; choosing it changes only the seed.
public type SeedPreset = record
  public Seed: integer;
  public Name: string;
  public Description: string;
end record;

// Recommended starts, with the default forest-edge landscape first.
public function Recommended(): array of SeedPreset;
begin
  return [
    SeedPreset(Seed := 32, Name := 'Forest edge', Description := 'Dense woodland nearby.'),
    SeedPreset(Seed := 38, Name := 'River and lake', Description := 'Meadows and trees.'),
    SeedPreset(Seed := 53, Name := 'Forest river', Description := 'Trees beside the river.'),
    SeedPreset(Seed := 24, Name := 'Meadow lake', Description := 'Lake west, trees east.')
  ];
end function;

// Describes a recognized seed without promising any particular landscape for custom values.
public function Description(SeedText: string): string;
begin
  for Preset: SeedPreset in Recommended() do
    if SeedText = Conv.IntToStr(Preset.Seed) then
      return Preset.Name + ': ' + Preset.Description;
    end if;
  end for;

  return 'Custom seed: generated landscape.';
end function;

// Four consecutive control/action IDs belong to the caller. Compact forms use one numeric row.
public function Choices(SeedText: string; FirstId: integer; Compact: boolean): Tui.TuiElement;
begin
  var Buttons: array of Tui.TuiElement := [];
  const Presets := Recommended();
  for Index: integer := 0 to Presets.Length() - 1 do
    const Preset := Presets[Index];
    const Seed := Conv.IntToStr(Preset.Seed);
    const Label := if Compact then Seed else Seed + ' ' + Preset.Name end if;
    const Id := Tui.TuiControlId.Create(FirstId + Index);
    const Action := Tui.TuiAction.Create(FirstId + Index);
    Buttons.PushInPlace(
      if SeedText = Seed then Tui.TuiElementBuilders.MakeActiveButton(Id, Label, Action)
        else Tui.TuiElementBuilders.MakeButton(Id, Label, Action)
        end if
    );
  end for;

  if Compact then
    return Tui.TuiElementBuilders.MakeRowSpaced(Buttons, 1);
  end if;

  return Tui.TuiElementBuilders.MakeColumn([
    Tui.TuiElementBuilders.MakeRowSpaced([Buttons[0], Buttons[1]], 1),
    Tui.TuiElementBuilders.MakeRowSpaced([Buttons[2], Buttons[3]], 1)
  ]);
end function;
end unit;
