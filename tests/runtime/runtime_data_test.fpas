// Verifies runtime directory creation and persistent TOML configuration loading.
program DungeonRuntimeDataTest;

uses Dungeon.RuntimeData as RuntimeData, Std.Conv as Conv, Std.Fs as Fs, Std.Test as Test, Std.Time as Time;

begin
  const Root: string := '.temp-data/runtime-data-test-' + Conv.IntToStr(Time.TimestampMillis());
  if not Fs.Exists('.temp-data') then
    begin
      Test.AssertTrue(Fs.CreateDir('.temp-data').Unwrap());
    end;
  end if;
  var Client: RuntimeData.RuntimeSettings := RuntimeData.LoadClientRuntime(Some(Root)).Unwrap();
  Test.AssertTrue(Fs.IsDir(Client.Paths.Config));
  Test.AssertTrue(Fs.IsDir(Client.Paths.Logs));
  Test.AssertTrue(Fs.IsDir(Client.Paths.Cache));
  Test.AssertTrue(Fs.IsFile(Client.Paths.ClientConfig));
  Test.AssertTrue(
    Fs.WriteTextAtomic(
      Client.Paths.ClientConfig,
      (
        (('host = ''game.example''' + string.Chr(10)) + ('port = 5050' + string.Chr(10))) +
        ('context_panel_visible = false' + string.Chr(10))
      ) +
      'message_panel_visible = true'
    ).Unwrap()
  );
  Client := RuntimeData.LoadClientRuntime(Some(Root)).Unwrap();
  Test.AssertEquals('game.example', Client.Network.Host);
  Test.AssertEquals(5050, Client.Network.Port);
  Test.AssertFalse(Client.Preferences.ContextPanelVisible);
  Test.AssertTrue(Client.Preferences.MessagePanelVisible);
  Test.AssertTrue(
    RuntimeData.SaveClientPreferences(
      Client.Paths.ClientConfig,
      RuntimeData.ClientPreferences(ContextPanelVisible := true, MessagePanelVisible := false)
    ).Unwrap()
  );
  Client := RuntimeData.LoadClientRuntime(Some(Root)).Unwrap();
  Test.AssertEquals('game.example', Client.Network.Host);
  Test.AssertEquals(5050, Client.Network.Port);
  Test.AssertTrue(Client.Preferences.ContextPanelVisible);
  Test.AssertFalse(Client.Preferences.MessagePanelVisible);
  Test.AssertTrue(
    Fs.WriteTextAtomic(
      Client.Paths.ClientConfig, ('host = ''legacy.example''' + string.Chr(10)) +
      'port = 6060'
    ).Unwrap()
  );
  case RuntimeData.LoadClientRuntime(Some(Root)) of
    when Error(const Message):
      Test.AssertTrue('delete or recreate it' in Message);
    when Ok(_):
      panic('obsolete client configuration must be rejected');
  end case;

  Test.AssertTrue(
    Fs.WriteTextAtomic(
      Client.Paths.ClientConfig,
      (
        (('host = ''game.example''' + string.Chr(10)) + ('port = 5050' + string.Chr(10))) +
        ('context_panel_visible = true' + string.Chr(10))
      ) +
      'message_panel_visible = false'
    ).Unwrap()
  );
  const Server: RuntimeData.RuntimeSettings := RuntimeData.LoadServerRuntime(Some(Root)).Unwrap();
  Test.AssertTrue(Fs.IsDir(Server.Paths.Worlds));
  Test.AssertTrue(Fs.IsFile(Server.Paths.ServerConfig));
  Test.AssertEquals('127.0.0.1', Server.Network.Host);
  Test.AssertEquals(4040, Server.Network.Port);
  Test.AssertEquals('main', Server.World.Id);
  Test.AssertEquals(12345, Server.World.Seed);
  Test.AssertEquals(4, Server.World.DungeonRegionChunks);
  Test.AssertEquals(64, Server.World.ChunkCacheLimit);
  Test.AssertEquals(240, Server.World.MaximumViewWidth);
  Test.AssertEquals(120, Server.World.MaximumViewHeight);
  // Keys outside the current server schema mark an obsolete file.
  const ServerText: string := Fs.ReadText(Server.Paths.ServerConfig).Unwrap();
  Test.AssertTrue(
    Fs.WriteTextAtomic(
      Server.Paths.ServerConfig, (ServerText + string.Chr(10)) +
      'legacy_view_radius = 8'
    ).Unwrap()
  );
  case RuntimeData.LoadServerRuntime(Some(Root)) of
    when Error(const Message):
      Test.AssertTrue('unexpected field legacy_view_radius' in Message);
      Test.AssertTrue('delete or recreate it' in Message);
    when Ok(_):
      panic('server configuration with an unknown key must be rejected');
  end case;

  // A file from before entrance regions lacks dungeon_region_chunks and is obsolete.
  Test.AssertTrue(
    Fs.WriteTextAtomic(
      Server.Paths.ServerConfig,
      ServerText.Replace('dungeon_region_chunks = 4', '')
    ).Unwrap()
  );
  case RuntimeData.LoadServerRuntime(Some(Root)) of
    when Error(const Message):
      Test.AssertTrue('delete or recreate it' in Message);
    when Ok(_):
      panic('server configuration without dungeon_region_chunks must be rejected');
  end case;

  // Region sizes outside 1 through 16 are rejected.
  Test.AssertTrue(
    Fs.WriteTextAtomic(
      Server.Paths.ServerConfig,
      ServerText.Replace('dungeon_region_chunks = 4', 'dungeon_region_chunks = 17')
    ).Unwrap()
  );
  Test.AssertTrue((RuntimeData.LoadServerRuntime(Some(Root)) is Error(_)));
  Test.AssertTrue(
    Fs.WriteTextAtomic(
      Server.Paths.ServerConfig,
      ServerText.Replace('dungeon_region_chunks = 4', 'dungeon_region_chunks = 16')
    ).Unwrap()
  );
  Test.AssertEquals(
    16,
    RuntimeData.LoadServerRuntime(Some(Root)).Unwrap().World.DungeonRegionChunks
  );
end.
