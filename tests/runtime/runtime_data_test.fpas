// Verifies runtime directory creation and persistent TOML configuration loading.
program DungeonRuntimeDataTest;

uses Dungeon.RuntimeData, Std.Conv, Std.Fs, Std.Test, Std.Time;

begin
  const Root: string := '.temp-data/runtime-data-test-' + IntToStr(TimestampMillis());
  if not Std.Fs.Exists('.temp-data') then
    begin
      AssertTrue(Std.Fs.CreateDir('.temp-data').Unwrap());
    end;
  end if;
  var Client: RuntimeSettings := LoadClientRuntime(Some(Root)).Unwrap();
  AssertTrue(Std.Fs.IsDir(Client.Paths.Config));
  AssertTrue(Std.Fs.IsDir(Client.Paths.Logs));
  AssertTrue(Std.Fs.IsDir(Client.Paths.Cache));
  AssertTrue(Std.Fs.IsFile(Client.Paths.ClientConfig));
  AssertTrue(Std.Fs.WriteTextAtomic(Client.Paths.ClientConfig, ((('host = ''game.example''' + string.Chr(10)) + ('port = 5050' + string.Chr(10))) + ('context_panel_visible = false' + string.Chr(10))) +
                                                               'message_panel_visible = true')
               .Unwrap());
  Client := LoadClientRuntime(Some(Root)).Unwrap();
  AssertEquals('game.example', Client.Network.Host);
  AssertEquals(5050, Client.Network.Port);
  AssertFalse(Client.Preferences.ContextPanelVisible);
  AssertTrue(Client.Preferences.MessagePanelVisible);
  AssertTrue(SaveClientPreferences(Client.Paths.ClientConfig, ClientPreferences(ContextPanelVisible := true, MessagePanelVisible := false))
               .Unwrap());
  Client := LoadClientRuntime(Some(Root)).Unwrap();
  AssertEquals('game.example', Client.Network.Host);
  AssertEquals(5050, Client.Network.Port);
  AssertTrue(Client.Preferences.ContextPanelVisible);
  AssertFalse(Client.Preferences.MessagePanelVisible);
  AssertTrue(Std.Fs.WriteTextAtomic(Client.Paths.ClientConfig, ('host = ''legacy.example''' + string.Chr(10)) +
                                                               'port = 6060')
               .Unwrap());
  if LoadClientRuntime(Some(Root)) is Error(const Message) then
    begin
      AssertTrue(Message.Contains('delete or recreate it'));
    end;
  else
    begin
      panic('obsolete client configuration must be rejected');
    end;
  end if;

  AssertTrue(Std.Fs.WriteTextAtomic(Client.Paths.ClientConfig, ((('host = ''game.example''' + string.Chr(10)) + ('port = 5050' + string.Chr(10))) + ('context_panel_visible = true' + string.Chr(10))) +
                                                               'message_panel_visible = false')
               .Unwrap());
  const Server: RuntimeSettings := LoadServerRuntime(Some(Root)).Unwrap();
  AssertTrue(Std.Fs.IsDir(Server.Paths.Worlds));
  AssertTrue(Std.Fs.IsFile(Server.Paths.ServerConfig));
  AssertEquals('127.0.0.1', Server.Network.Host);
  AssertEquals(4040, Server.Network.Port);
  AssertEquals('main', Server.World.Id);
  AssertEquals(12345, Server.World.Seed);
  AssertEquals(4, Server.World.DungeonRegionChunks);
  AssertEquals(64, Server.World.ChunkCacheLimit);
  AssertEquals(240, Server.World.MaximumViewWidth);
  AssertEquals(120, Server.World.MaximumViewHeight);
  // Keys outside the current server schema mark an obsolete file.
  const ServerText: string := Std.Fs.ReadText(Server.Paths.ServerConfig).Unwrap();
  AssertTrue(Std.Fs.WriteTextAtomic(Server.Paths.ServerConfig, (ServerText + string.Chr(10)) +
                                                               'legacy_view_radius = 8')
               .Unwrap());
  if LoadServerRuntime(Some(Root)) is Error(const Message) then
    begin
      AssertTrue(Message.Contains('unexpected field legacy_view_radius'));
      AssertTrue(Message.Contains('delete or recreate it'));
    end;
  else
    begin
      panic('server configuration with an unknown key must be rejected');
    end;
  end if;

  // A file from before entrance regions lacks dungeon_region_chunks and is obsolete.
  AssertTrue(Std.Fs.WriteTextAtomic(Server.Paths.ServerConfig, ServerText.Replace('dungeon_region_chunks = 4', ''))
               .Unwrap());
  if LoadServerRuntime(Some(Root)) is Error(const Message) then
    begin
      AssertTrue(Message.Contains('delete or recreate it'));
    end;
  else
    begin
      panic('server configuration without dungeon_region_chunks must be rejected');
    end;
  end if;

  // Region sizes outside 1 through 16 are rejected.
  AssertTrue(Std.Fs.WriteTextAtomic(Server.Paths.ServerConfig, ServerText.Replace('dungeon_region_chunks = 4', 'dungeon_region_chunks = 17'))
               .Unwrap());
  AssertTrue(LoadServerRuntime(Some(Root)).IsError());
  AssertTrue(Std.Fs.WriteTextAtomic(Server.Paths.ServerConfig, ServerText.Replace('dungeon_region_chunks = 4', 'dungeon_region_chunks = 16'))
               .Unwrap());
  AssertEquals(16, LoadServerRuntime(Some(Root)).Unwrap().World.DungeonRegionChunks);
end.
