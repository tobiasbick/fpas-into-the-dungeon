// Verifies runtime directory creation and persistent TOML configuration loading.
program DungeonRuntimeDataTest;

uses Dungeon.RuntimeData, Std.Conv, Std.Fs, Std.Options, Std.Results, Std.Str, Std.Test, Std.Time;

begin
  var Root: string := '.temp-data/runtime-data-test-' + IntToStr(TimestampMillis());
  if not Std.Fs.Exists('.temp-data') then
  begin
    AssertTrue(Std.Results.Unwrap(Std.Fs.CreateDir('.temp-data')))
  end;
  mutable var Client: RuntimeSettings := Std.Results.Unwrap(LoadClientRuntime(Some(Root)));
  AssertTrue(Std.Fs.IsDir(Client.Paths.Config));
  AssertTrue(Std.Fs.IsDir(Client.Paths.Logs));
  AssertTrue(Std.Fs.IsDir(Client.Paths.Cache));
  AssertTrue(Std.Fs.IsFile(Client.Paths.ClientConfig));
  AssertTrue(Std.Results.Unwrap(Std.Fs.WriteTextAtomic(Client.Paths.ClientConfig, ((('host = ''game.example''' + Std.Str.Chr(10)) + ('port = 5050' + Std.Str.Chr(10))) + ('context_panel_visible = false' + Std.Str.Chr(10))) +
                                                                                  'message_panel_visible = true')));
  Client := Std.Results.Unwrap(LoadClientRuntime(Some(Root)));
  AssertEquals('game.example', Client.Network.Host);
  AssertEquals(5050, Client.Network.Port);
  AssertFalse(Client.Preferences.ContextPanelVisible);
  AssertTrue(Client.Preferences.MessagePanelVisible);
  AssertTrue(Std.Results.Unwrap(SaveClientPreferences(Client.Paths.ClientConfig, record
    ContextPanelVisible := true;
    MessagePanelVisible := false;
  end)));
  Client := Std.Results.Unwrap(LoadClientRuntime(Some(Root)));
  AssertEquals('game.example', Client.Network.Host);
  AssertEquals(5050, Client.Network.Port);
  AssertTrue(Client.Preferences.ContextPanelVisible);
  AssertFalse(Client.Preferences.MessagePanelVisible);
  AssertTrue(Std.Results.Unwrap(Std.Fs.WriteTextAtomic(Client.Paths.ClientConfig, ('host = ''legacy.example''' + Std.Str.Chr(10)) +
                                                                                  'port = 6060')));
  case LoadClientRuntime(Some(Root)) of
    Error(Message):
    begin
      AssertTrue(Std.Str.Contains(Message, 'delete or recreate it'))
    end
    else
    begin
      panic('obsolete client configuration must be rejected')
    end
  end;

  AssertTrue(Std.Results.Unwrap(Std.Fs.WriteTextAtomic(Client.Paths.ClientConfig, ((('host = ''game.example''' + Std.Str.Chr(10)) + ('port = 5050' + Std.Str.Chr(10))) + ('context_panel_visible = true' + Std.Str.Chr(10))) +
                                                                                  'message_panel_visible = false')));
  var Server: RuntimeSettings := Std.Results.Unwrap(LoadServerRuntime(Some(Root)));
  AssertTrue(Std.Fs.IsDir(Server.Paths.Worlds));
  AssertTrue(Std.Fs.IsFile(Server.Paths.ServerConfig));
  AssertEquals('127.0.0.1', Server.Network.Host);
  AssertEquals(4040, Server.Network.Port);
  AssertEquals('main', Server.World.Id);
  AssertEquals(12345, Server.World.Seed);
  AssertEquals(64, Server.World.ChunkCacheLimit);
  AssertEquals(240, Server.World.MaximumViewWidth);
  AssertEquals(120, Server.World.MaximumViewHeight)
end.
