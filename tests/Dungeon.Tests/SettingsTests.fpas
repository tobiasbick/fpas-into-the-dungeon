// Verifies first-run initialization and preservation of user settings.
unit Dungeon.Tests.SettingsTests;

uses Dungeon.Settings as Settings, System.IO as IO, Xunit as X;

// A later launch keeps the settings file's contents.
[X.FactAttribute]
public procedure InitializesSettingsOnce();
begin
  const Temporary: IO.DirectoryInfo := IO.Directory.CreateTempSubdirectory('dungeon-settings-');
  const Path: string := IO.Path.Combine(Temporary.FullName, 'config', 'settings.json');
  try
    Settings.EnsureExists(Path);
    X.Assert.Equal<string>('{}', IO.File.ReadAllText(Path));

    const Saved: string := '{"example":true}';
    IO.File.WriteAllText(Path, Saved);
    Settings.EnsureExists(Path);
    X.Assert.Equal<string>(Saved, IO.File.ReadAllText(Path));
  finally
    Temporary.Delete(true);
  end try;
end procedure;

// A fresh load restores agent, model and thinking IDs saved to disk.
[X.FactAttribute]
public procedure ReloadsSavedSelection();
begin
  const Temporary: IO.DirectoryInfo := IO.Directory.CreateTempSubdirectory('dungeon-settings-');
  const Path: string := IO.Path.Combine(Temporary.FullName, 'settings.json');
  try
    const Initial: Settings.Choice := Settings.Load(Path);
    X.Assert.Equal<string>('codex', Initial.Agent);
    Settings.Save(Path, new Settings.Choice('antigravity', 'sample-model', 'sample-thinking'));

    const Loaded: Settings.Choice := Settings.Load(Path);
    X.Assert.Equal<string>('antigravity', Loaded.Agent);
    X.Assert.Equal<string>('sample-model', Loaded.Model);
    X.Assert.Equal<string>('sample-thinking', Loaded.ThinkingLevel);
  finally
    Temporary.Delete(true);
  end try;
end procedure;

end unit;
