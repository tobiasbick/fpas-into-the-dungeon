// Reuses the reviewed seed-25 route from spawn to Ashbrook in integration journeys.
unit Dungeon.Tests.Routes;

uses Dungeon.Tests.TcpGame as Game, System.IO as IO;

/// Walks from spawn to Ashbrook's outdoor gate without entering it.
public procedure ToAshbrook(Stream: IO.Stream);
begin
  for Leg: string in [
    'E8', 'S3', 'E14', 'S4', 'E45', 'S5', 'E1', 'S2', 'E1', 'S1',
    'E17', 'S3', 'E1', 'S2', 'E1', 'S1', 'E1', 'S1', 'E19', 'S19'
  ] do
    const Direction: string := if Leg.Substring(0, 1) = 'E' then 'east' else 'south' end if;
    discard Game.Walk(Stream, Direction, int.Parse(Leg.Substring(1)));
  end for;
end procedure;
end unit;
