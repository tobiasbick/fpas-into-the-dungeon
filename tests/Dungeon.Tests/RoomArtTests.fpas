// Exercises real illustration tool calls, partial saves and responsive cell rendering.
unit Dungeon.Tests.RoomArtTests;

uses Fpas.Ui.TerminalExtensions.CellGrids as Grids;
uses Fpas.Ui.Tui.Application as Tui;
uses Fpas.Ui.Tui.Headless as Headless;
uses Fpas.Ui.Widgets.Developer.Terminal as T;

uses Dungeon.App as App;
uses Dungeon.Game.Art as Art;
uses Dungeon.Game.ArtCanvas as Canvas;
uses Dungeon.Game.ArtRequests as Draw;
uses Dungeon.Game.Saves as Saves;
uses Dungeon.Game.Screen as Screen;
uses Dungeon.Game.TurnTools as Tools;
uses Dungeon.Game.World as World;
uses Dungeon.Mcp.Transport as Transport;
uses Dungeon.Settings as Settings;
uses Dungeon.StartMenu as Menu;
uses ModelContextProtocol as Mcp;
uses ModelContextProtocol.Client as Client;
uses ModelContextProtocol.Protocol as P;
uses System as Sys;
uses System.Collections.Generic as Lists;
uses System.IO as IO;
uses System.IO.Pipes as Pipes;
uses System.Text.Json as Json;
uses System.Threading as Threads;
uses System.Threading.Tasks as Tasks;
uses Xunit as X;

function Drawing(Width: int; Symbol: string): Art.Drawing;
begin
  const Height: int := Art.Height(Width);
  const Rows: Lists.List of string := new Lists.List of string();
  for Y: int := 0 to Height - 1 do
    Rows.Add(
      if Y = Height - 2 then
        new string(#48, Width - 2) + '1'
      else
        ''
      end if
    );
  end for;

  return new Art.Drawing(
    Width, Width - 2, Height - 2, [
      new Art.Tile(' ', '#D08040', '#342810'), new Art.Tile(Symbol, '#FFAA22', '#304080')
    ], Rows.ToArray()
  );
end function;

function DistrictDrawing(Width: int): Art.Drawing;
begin
  return Drawing(Width, '▒') with
    Palette := [new Art.Tile(' ', '#D08040', '#0d0605'), new Art.Tile('▒', '#FFAA22', '#382019')];
  end with;
end function;

async function Exercise(Path: string; Token: Threads.CancellationToken): Tasks.Task;
begin
  const State: World.State := World.NewAdventure();
  const Room: Draw.Visit := new Draw.Visit(State, 'The pump bell shakes.');
  const Requests: Draw.Registry := new Draw.Registry();
  const Name: string := 'dungeon-' + Sys.Guid.NewGuid().ToString('N');
  using const Stop: Threads.CancellationTokenSource := Threads.CancellationTokenSource.CreateLinkedTokenSource(
    Token
  );
  const Server: Tasks.Task := Transport.Listen(
    Name,
    Tools.RegisterArt(Requests),
    Stop.Token
  );
  try
    using const Pipe: Pipes.NamedPipeClientStream := new Pipes.NamedPipeClientStream(
      '.', Name,
      Pipes.PipeDirection.InOut, Pipes.PipeOptions.Asynchronous
    );
    await Pipe.ConnectAsync(Token);
    const Options: Client.McpClientOptions := new Client.McpClientOptions();
    Options.ProtocolVersion := '2025-11-25';
    await using const Peer: Client.McpClient := await Client.McpClient.CreateAsync(
      new P.StreamClientTransport(Pipe, Pipe),
      Options,
      null,
      Token
    );
    const Offered: Lists.IList of Client.McpClientTool := await Peer.ListToolsAsync(
      cancellationToken := Token
    );
    const ArtTool: Client.McpClientTool := X.Assert.Single of Client.McpClientTool(Offered);
    X.Assert.Equal of string('submit_room_art', ArtTool.Name);
    const ArtSchema: string := ArtTool.JsonSchema.GetRawText();
    X.Assert.Contains('Active requestId', ArtSchema);
    X.Assert.Contains('1 to 36 tiles', ArtSchema);
    X.Assert.Contains('#RRGGBB', ArtSchema);
    const Updated: Lists.List of Art.Pair := new Lists.List of Art.Pair();
    const Prompts: Lists.List of string := new Lists.List of string();
    var Interrupt: bool := true;
    var LastId: string := '';
    const Notify: function(Art.Pair): Tasks.Task := function(Images: Art.Pair): Tasks.Task begin
      Updated.Add(Images);
      return Tasks.Task.CompletedTask;
    end function;
    const Ask: function(string): Tasks.Task of bool := async function(
      Text: string
    ): Tasks.Task of bool begin
      Prompts.Add(Text);
      LastId := X.Assert.Single of string(Requests.Keys);
      X.Assert.Contains(LastId, Text);
      X.Assert.Contains('The pump bell shakes.', Text);
      X.Assert.Contains(
        'Use only these district colors for both foreground and background: #0D0605',
        Text
      );
      X.Assert.Contains('1 to 36 tiles', Text);
      X.Assert.Contains('Example drawing JSON shape:', Text);
      const Job: Draw.Request? := Requests[LastId];
      X.Assert.NotNull(Job);
      if Job = null then
        return false;
      end if;

      if Job.Width = Art.Large and Interrupt then
        return false;
      end if;
      const Args: Lists.Dictionary of (string, object?) := new Lists.Dictionary of (string, object?)();
      Args['requestId'] := LastId;
      const Picture: Art.Drawing := DistrictDrawing(Job.Width);
      const Web: Json.JsonSerializerOptions := new Json.JsonSerializerOptions(
        Json.JsonSerializerDefaults.Web
      );
      Args['drawing'] := Json.JsonSerializer.SerializeToElement of Art.Drawing(
        Picture with
          FocusX := -1;
        end with, Web
      );
      const Bad: P.CallToolResult := await Peer.CallToolAsync(
        'submit_room_art',
        Args,
        null,
        null,
        Token
      );
      X.Assert.True(Bad.IsError ?? false);
      X.Assert.False(Job.IsCompleted());
      for Ink: Art.Tile in [
        new Art.Tile('▒', '#B8C9CE', '#382019'), new Art.Tile('▒', '#FFAA22', '#B8C9CE')
      ] do
        Args['drawing'] := Json.JsonSerializer.SerializeToElement of Art.Drawing(
          Picture with
            Palette := [Picture.Palette[0], Ink];
          end with, Web
        );
        const ColorError: P.CallToolResult := await Peer.CallToolAsync(
          'submit_room_art', Args, null, null, Token
        );
        X.Assert.True(ColorError.IsError ?? false);
        const ErrorText: P.TextContentBlock := X.Assert.IsType of P.TextContentBlock(
          X.Assert.Single of P.ContentBlock(ColorError.Content)
        );
        X.Assert.Contains('#B8C9CE is outside the district palette.', ErrorText.Text);
        X.Assert.False(Job.IsCompleted());
      end for;

      Args['drawing'] := Json.JsonSerializer.SerializeToElement of Art.Drawing(Picture, Web);
      const Accepted: P.CallToolResult := await Peer.CallToolAsync(
        'submit_room_art',
        Args,
        null,
        null,
        Token
      );
      X.Assert.False(Accepted.IsError ?? false);
      const Retry: P.CallToolResult := await Peer.CallToolAsync(
        'submit_room_art',
        Args,
        null,
        null,
        Token
      );
      X.Assert.False(Retry.IsError ?? false);
      return true;
    end function;

    await Draw.Fill(Path, Room, Requests, Ask, Notify, Token);
    X.Assert.Equal of int(2, Prompts.Count);
    discard X.Assert.Single of Art.Pair(Updated);
    X.Assert.NotNull(Updated[0].Compact);
    X.Assert.Null(Updated[0].Full);
    X.Assert.True(Requests.IsEmpty);
    const Legacy: Art.Picture := Art.Picture.Decode(Drawing(50, '▒'), 50);
    const File: string := IO.Path.Combine(
      IO.Path.GetDirectoryName(Path) ?? '',
      'art',
      State.AdventureId,
      'pump-room-50x16-v1.json'
    );
    IO.File.WriteAllText(File, Legacy.Encode());
    const Stamp: Sys.DateTime := new Sys.DateTime(2020, 1, 1);
    IO.File.SetLastWriteTimeUtc(File, Stamp);
    Interrupt := false;
    await Draw.Fill(Path, Room, Requests, Ask, Notify, Token);
    X.Assert.Equal of int(3, Prompts.Count);
    X.Assert.Contains('65 columns and 21 rows', Prompts[2]);
    X.Assert.Contains(Legacy.Encode(), Prompts[2]);
    X.Assert.Equal of Sys.DateTime(Stamp, IO.File.GetLastWriteTimeUtc(File));
    X.Assert.True(Art.Pair.Load(Path, State, State.RoomId).Complete());
    await Draw.Fill(Path, Room, Requests, Ask, Notify, Token);
    X.Assert.Equal of int(3, Prompts.Count);
    const Other: World.State := World.NewAdventure();
    X.Assert.Null(Art.Pair.Load(Path, Other, State.RoomId).Compact);
    X.Assert.Null(Art.Pair.Load(Path, State, World.Grotto).Full);

    IO.File.WriteAllText(File, '{broken');
    await Draw.Fill(Path, Room, Requests, Ask, Notify, Token);
    X.Assert.Equal of int(4, Prompts.Count);
    X.Assert.Contains('50 columns and 16 rows', Prompts[3]);
    X.Assert.Contains(Art.Picture.Decode(DistrictDrawing(65), 65).Encode(), Prompts[3]);
    X.Assert.True(Art.Pair.Load(Path, State, State.RoomId).Complete());
    discard X.Assert.Throws of Mcp.McpException(
      procedure() begin
        discard Draw.Submit(Requests, LastId, Drawing(50, '▒'));
      end procedure
    );
  finally
    Stop.Cancel();
    await Server;
  end try;
end function;

[X.FactAttribute]
public procedure GeneratesAndRepairsOnlyMissingSizesThroughMcp();
begin
  const Dir: IO.DirectoryInfo := IO.Directory.CreateTempSubdirectory('dungeon-art-');
  try
    using const Stop: Threads.CancellationTokenSource := new Threads.CancellationTokenSource(20000);
    Exercise(IO.Path.Combine(Dir.FullName, 'adventure.json'), Stop.Token).GetAwaiter().GetResult();
  finally
    Dir.Delete(true);
  end try;
end procedure;

function Cell(Grid: Grids.Image; Column: int; Row: int): T.Cell;
begin
  const Value: T.Cell? := Grid.At(Column, Row);
  if Value = null then
    raise new Sys.IndexOutOfRangeException();
  end if;

  return Value;
end function;

[X.FactAttribute]
public procedure KeepsGlyphsColorsAndFocusAtTheirNativeSize();
begin
  const Small: Art.Picture := Art.Picture.Decode(Drawing(50, '░'), 50);
  const Large: Art.Picture := Art.Picture.Decode(Drawing(65, '▓'), 65);
  const Pair: Art.Pair := new Art.Pair(Small, Large);
  X.Assert.Same(Small, Canvas.SelectImage(Pair, 64, 21));
  X.Assert.Same(Small, Canvas.SelectImage(Pair, 65, 20));
  X.Assert.Same(Large, Canvas.SelectImage(Pair, 65, 21));
  const Cropped: Grids.Image := Canvas.Render(Small, 24, 8);
  X.Assert.Equal of string('░', Cell(Cropped, 22, 6).Text);
  X.Assert.Equal of int($FFAA22, Cell(Cropped, 22, 6).Colors.Foreground ?? 0);
  const Centered: Grids.Image := Canvas.Render(Large, 101, 31);
  X.Assert.Equal of string('▓', Cell(Centered, 18 + 63, 5 + 19).Text);
  X.Assert.NotEqual of int(
    Cell(Centered, 0, 10).Colors.Background ?? 0,
    Cell(Centered, 17, 10).Colors.Background ?? 0
  );
  for Bad: string in ['界', #27.ToString(), #10.ToString(), 'ab'] do
    discard X.Assert.Throws of IO.InvalidDataException(
      procedure() begin
        discard Art.Picture.Decode(Drawing(50, Bad), 50);
      end procedure
    );
  end for;
end procedure;

function Shows(Frame: Tui.Frame; Text: string): bool;
begin
  return Sys.Array.Exists of string(
    Frame.Lines,
    function(Line: string): bool => Line.Contains(Text)
  );
end function;

procedure Settle(Session: Tui.HeadlessSession);
begin
  for Index: int := 1 to 4 do
    discard Session.Step();
  end for;
end procedure;

[X.FactAttribute]
public procedure ResizesTheArtPaneWhileKeepingTheNarration();
begin
  const Images: Art.Pair := new Art.Pair(
    Art.Picture.Decode(Drawing(50, '░'), 50),
    Art.Picture.Decode(Drawing(65, '▓'), 65)
  );
  const Game: Screen.Model := new Screen.Model(
    [new Saves.Turn('', 'The bell rings.')],
    RoomId := World.Entrance,
    Images := Images,
    Status := ''
  );
  const Model: App.Model := new App.Model(
    '',
    new Settings.Preferences(),
    new Menu.Model(true),
    Adventure := Game
  );
  using const Session: Tui.HeadlessSession := Headless.Start of (App.Model, App.Message)(
    Model,
    App.Update,
    App.View,
    80,
    25,
    App.Theme(Model)
  );
  Settle(Session);
  X.Assert.True(Shows(Session.Snapshot(), '░'));
  discard Session.Send(Tui.Input.Resize(120, 38));
  Settle(Session);
  X.Assert.True(Shows(Session.Snapshot(), '▓'));
  discard Session.Send(Tui.Input.Resize(120, 25));
  Settle(Session);
  X.Assert.True(Shows(Session.Snapshot(), '░'));
  discard Session.Send(Tui.Input.Resize(35, 15));
  Settle(Session);
  X.Assert.False(Shows(Session.Snapshot(), '░'));
  X.Assert.True(Shows(Session.Snapshot(), 'The bell rings.'));
end procedure;

end unit;
