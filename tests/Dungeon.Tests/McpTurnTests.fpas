// Verifies room and turn rules through the production MCP server.
unit Dungeon.Tests.McpTurnTests;

uses Dungeon.Game.Saves as Saves;
uses Dungeon.Game.Session as Session;
uses Dungeon.Game.TurnTools as Tools;
uses Dungeon.Game.World as World;
uses Dungeon.Mcp.Transport as Transport;
uses ModelContextProtocol.Client as Client;
uses ModelContextProtocol.Protocol as P;
uses System as Sys;
uses System.Collections.Concurrent as Concurrent;
uses System.Collections.Generic as Lists;
uses System.Globalization as Global;
uses System.IO.Pipes as Pipes;
uses System.Threading as Threads;
uses System.Threading.Tasks as Tasks;
uses Xunit as X;

function Body(Value: P.CallToolResult): string;
begin
  X.Assert.False(Value.IsError ?? false);
  const Block: P.ContentBlock? := X.Assert.Single of P.ContentBlock(Value.Content);
  if Block <> null and Block is P.TextContentBlock then
    return (cast Block as P.TextContentBlock).Text;
  end if;

  raise new Sys.InvalidOperationException('Expected MCP text content.');
end function;

async function Exercise(): Tasks.Task;
begin
  const Name: string := 'dungeon-' + Sys.Guid.NewGuid().ToString('N');
  using const Stop: Threads.CancellationTokenSource := new Threads.CancellationTokenSource(10000);
  const Pending: Concurrent.ConcurrentDictionary of (string, Tools.Proposal?) := new Concurrent.ConcurrentDictionary of (string, Tools.Proposal?)();
  const Active: Concurrent.ConcurrentDictionary of (string, Tools.Context?) := new Concurrent.ConcurrentDictionary of (string, Tools.Context?)();
  const Initial: World.State := World.NewAdventure();
  const History: array of Saves.Turn := [
    new Saves.Turn('listen at the arch', 'You hear water.', World.Entrance),
    new Saves.Turn('look at the pump', 'The pipe drips.', World.Entrance),
    new Saves.Turn('old transcript', 'The ruins are dark.')
  ];
  discard Active.TryAdd(
    'active',
    new Tools.Context('adventure.json', Initial, History, false, Pending)
  );
  const Server: Tasks.Task := Transport.Listen(Name, Tools.Register(Active), Stop.Token);
  try
    using const Pipe: Pipes.NamedPipeClientStream := new Pipes.NamedPipeClientStream(
      '.', Name, Pipes.PipeDirection.InOut, Pipes.PipeOptions.Asynchronous
    );
    await Pipe.ConnectAsync(Stop.Token);
    const Options: Client.McpClientOptions := new Client.McpClientOptions();
    Options.ProtocolVersion := '2025-11-25';
    await using const Peer: Client.McpClient := await Client.McpClient.CreateAsync(
      new P.StreamClientTransport(Pipe, Pipe), Options, null, Stop.Token
    );
    const Offered: Lists.IList of Client.McpClientTool := await Peer.ListToolsAsync(
      cancellationToken := Stop.Token
    );
    X.Assert.Equal of int(6, Offered.Count);
    for Entry: Client.McpClientTool in Offered do
      X.Assert.NotEqual of string('submit_room_art', Entry.Name);
      const Schema: string := Entry.JsonSchema.GetRawText();
      X.Assert.Contains('Active turnId', Schema);
      if Entry.Name = 'submit_turn' then
        X.Assert.Contains('1 to 800 characters', Schema);
        X.Assert.Contains('no Markdown', Schema);
      elsif Entry.Name = 'search_memories' then
        X.Assert.Contains('Exact internal speaker ID', Schema);
      elsif Entry.Name = 'find_route' then
        X.Assert.Contains('Exact visited room ID', Schema);
      end if;
    end for;
    const Args: Lists.Dictionary of (string, object?) := new Lists.Dictionary of (string, object?)();
    Args['turnId'] := 'active';
    Args['roomId'] := World.Entrance;
    const Room: P.CallToolResult := await Peer.CallToolAsync(
      'get_room',
      Args,
      null,
      null,
      Stop.Token
    );
    const Opening: string := Body(Room);
    X.Assert.Contains('brass-key', Opening);
    X.Assert.Contains('north-grate', Opening);
    X.Assert.DoesNotContain('evacuation-roster', Opening);
    X.Assert.DoesNotContain('imageReady', Opening);
    Args['roomId'] := 'master-seat';
    const Far: P.CallToolResult := await Peer.CallToolAsync(
      'get_room',
      Args,
      null,
      null,
      Stop.Token
    );
    X.Assert.True(Far.IsError ?? false);
    Args['roomId'] := World.Entrance;

    Args['limit'] := 1;
    const Recent: P.CallToolResult := await Peer.CallToolAsync(
      'get_history',
      Args,
      null,
      null,
      Stop.Token
    );
    X.Assert.False(Recent.IsError ?? false);
    const Block: P.ContentBlock? := X.Assert.Single of P.ContentBlock(Recent.Content);
    if Block <> null and Block is P.TextContentBlock then
      const Text: string := (cast Block as P.TextContentBlock).Text;
      X.Assert.Contains('look at the pump', Text);
      X.Assert.DoesNotContain('listen at the arch', Text);
      X.Assert.DoesNotContain('old transcript', Text);
    else
      X.Assert.Fail('Expected the filtered history as text.');
    end if;

    discard Args.Remove('limit');
    discard Args.Remove('roomId');
    Args['action'] := 'move';
    Args['target'] := World.Grotto;
    Args['reply'] := 'You go north.';
    const Blocked: P.CallToolResult := await Peer.CallToolAsync(
      'submit_turn',
      Args,
      null,
      null,
      Stop.Token
    );
    X.Assert.True(Blocked.IsError ?? false);
    X.Assert.True(Pending.IsEmpty);

    Args['action'] := 'take_key';
    Args['target'] := World.BrassKey;
    Args['reply'] := 'You take the brass key.';
    const Accepted: P.CallToolResult := await Peer.CallToolAsync(
      'submit_turn',
      Args,
      null,
      null,
      Stop.Token
    );
    X.Assert.False(Accepted.IsError ?? false);
    const Replay: P.CallToolResult := await Peer.CallToolAsync(
      'submit_turn',
      Args,
      null,
      null,
      Stop.Token
    );
    X.Assert.False(Replay.IsError ?? false);
    const Proposal: Tools.Proposal? := Pending['turn'];
    X.Assert.NotNull(Proposal);
    if Proposal <> null then
      X.Assert.True(Proposal.WorldState.HasKey);
      X.Assert.False(Initial.HasKey);
    end if;

    const Opened: World.State := World.Apply(
      World.Apply(Initial, 'take_key', World.BrassKey),
      'open_grate',
      'north-grate'
    );
    const Landing: World.State := World.Apply(
      World.Apply(Opened, 'move', 'grotto'),
      'move',
      'bell-landing'
    );
    const Second: Concurrent.ConcurrentDictionary of (string, Tools.Proposal?) := new Concurrent.ConcurrentDictionary of (string, Tools.Proposal?)();
    discard Active.TryAdd(
      'at-bell',
      new Tools.Context('adventure.json', Landing, History, false, Second)
    );
    Args['turnId'] := 'at-bell';
    Args['action'] := 'talk';
    Args['target'] := 'mara';
    Args['reply'] := 'Mara recognises the signal.';
    const Heard: P.CallToolResult := await Peer.CallToolAsync(
      'submit_turn',
      Args,
      null,
      null,
      Stop.Token
    );
    X.Assert.False(Heard.IsError ?? false);
    const Reheard: P.CallToolResult := await Peer.CallToolAsync(
      'submit_turn',
      Args,
      null,
      null,
      Stop.Token
    );
    X.Assert.False(Reheard.IsError ?? false);
    const Talk: Tools.Proposal? := Second['turn'];
    X.Assert.NotNull(Talk);
    if Talk <> null then
      discard Active.TryAdd(
        'following',
        new Tools.Context(
          'adventure.json',
          Talk.WorldState,
          [Saves.Completed(Landing, 'listen to Mara', Talk.Reply, Talk.Action, Talk.Target)],
          false,
          Pending
        )
      );
    end if;

    Args.Clear();
    Args['turnId'] := 'following';
    const Notes: P.CallToolResult := await Peer.CallToolAsync(
      'get_journal',
      Args,
      null,
      null,
      Stop.Token
    );
    X.Assert.Contains('Mara', Body(Notes));
    Args['query'] := 'signal';
    Args['person'] := 'mara';
    Args['roomId'] := 'bell-landing';
    Args['beforeTurn'] := 0;
    Args['limit'] := 1;
    const Memory: string := Body(
      await Peer.CallToolAsync('search_memories', Args, null, null, Stop.Token)
    );
    X.Assert.Contains('Mara recognises the signal.', Memory);

    Args['limit'] := 21;
    const InvalidLimit: P.CallToolResult := await Peer.CallToolAsync(
      'search_memories',
      Args,
      null,
      null,
      Stop.Token
    );
    X.Assert.True(InvalidLimit.IsError ?? false);
    Args.Clear();
    Args['turnId'] := 'at-bell';
    Args['destination'] := 'Mara';
    X.Assert.Contains(
      'unknown',
      Body(await Peer.CallToolAsync('find_route', Args, null, null, Stop.Token))
    );
    Args['turnId'] := 'following';
    X.Assert.Contains(
      'here',
      Body(await Peer.CallToolAsync('find_route', Args, null, null, Stop.Token))
    );
    discard Args.Remove('destination');
    Args['roomId'] := 'bell-landing';
    const Present: P.CallToolResult := await Peer.CallToolAsync(
      'get_room',
      Args,
      null,
      null,
      Stop.Token
    );
    X.Assert.Contains('mara', Body(Present));
    X.Assert.DoesNotContain('adas-message', Body(Present));
    Args['turnId'] := 'expired';
    discard Args.Remove('roomId');
    Args['action'] := 'none';
    Args['target'] := '';
    Args['reply'] := 'The pipe ticks.';
    const Expired: P.CallToolResult := await Peer.CallToolAsync(
      'submit_turn',
      Args,
      null,
      null,
      Stop.Token
    );
    X.Assert.True(Expired.IsError ?? false);
  finally
    Stop.Cancel();
    await Server;
  end try;
end function;

[X.FactAttribute]
public procedure ValidatesAndStagesOneProposalPerTurn();
begin
  Exercise().GetAwaiter().GetResult();
end procedure;

[X.FactAttribute]
public procedure BuildsConsistentTurnPromptForOpeningAndPlay();
begin
  const Previous: Global.CultureInfo := Global.CultureInfo.CurrentUICulture;
  try
    Global.CultureInfo.CurrentUICulture := Global.CultureInfo.GetCultureInfo('de-DE');
    const Submissions: Concurrent.ConcurrentDictionary of (string, Tools.Proposal?) := new Concurrent.ConcurrentDictionary of (string, Tools.Proposal?)();
    const OpeningContext: Tools.Context := new Tools.Context(
      'adventure.json',
      World.NewAdventure(),
      [],
      true,
      Submissions
    );
    const Opening: string := Session.TurnPrompt('turn-open', OpeningContext, '');
    X.Assert.Contains('get_room(turnId, destinationRoomId)', Opening);
    X.Assert.Contains('1 to 800 characters of plain text', Opening);
    X.Assert.Contains('without Markdown', Opening);
    X.Assert.Contains('without internal IDs', Opening);
    X.Assert.Contains('ONLY the reply passed to submit_turn', Opening);
    X.Assert.Contains('outcomeOrHint with available=true', Opening);
    X.Assert.Contains('outcomeOrHint with available=false', Opening);
    X.Assert.Contains('alreadyLearned', Opening);
    X.Assert.Contains('Recorded discoveries: []', Opening);
    X.Assert.Contains('"roomId":"grotto"', Opening);
    X.Assert.Contains('"outcomeOrHint":', Opening);
    X.Assert.Contains('"alreadyLearned":false', Opening);
    X.Assert.Contains('"name":"Pumpenkammer"', Opening);
    X.Assert.DoesNotContain('Grate open:', Opening);
    X.Assert.DoesNotContain('imageReady', Opening);
    X.Assert.DoesNotContain('Recent completed turns:', Opening);
    X.Assert.Equal of int(
      Opening.IndexOf('Player language:', Sys.StringComparison.Ordinal),
      Opening.LastIndexOf('Player language:', Sys.StringComparison.Ordinal)
    );

    const Explored: World.State := World.NewAdventure() with
      RoomId := 'boot-rack';
      HasKey := true;
      GrateOpen := true;
      Discoveries := ['mara'];
    end with;
    const FollowUpContext: Tools.Context := new Tools.Context(
      'adventure.json',
      Explored,
      [new Saves.Turn('schau dich um', 'Hier stehen Stiefel.', 'boot-rack', 'none', '')],
      false,
      Submissions
    );
    const Turn: string := Session.TurnPrompt('turn-2', FollowUpContext, 'Schlüssel prüfen');
    X.Assert.Contains('Recorded discoveries: ["mara"]', Turn);
    X.Assert.Contains('"name":"Stiefelregal"', Turn);
    X.Assert.Contains('Recent completed turns:', Turn);
    X.Assert.Contains('"roomId":"boot-rack"', Turn);
    X.Assert.Contains('Player command as JSON: "Schlüssel prüfen"', Turn);
  finally
    Global.CultureInfo.CurrentUICulture := Previous;
  end try;
end procedure;

end unit;
