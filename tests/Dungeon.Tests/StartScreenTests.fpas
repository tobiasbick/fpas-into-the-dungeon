// Verifies the start menu variants and their placeholder actions.
unit Dungeon.Tests.StartScreenTests;

uses
  Dungeon.StartMenu as Menu, Dungeon.StartScreen as Screen, Fpas.Ui.Tui.Application as Tui,
  Fpas.Ui.Tui.Headless as Headless,
  Fpas.Ui.Mvu.Application as Mvu, System as Sys, System.Globalization as Globalization, Xunit as X;

function HasText(Frame: Tui.Frame; Text: string): bool;
begin
  return Sys.Array.Exists<string>(Frame.Lines, function(Line: string): bool => Line.Contains(Text));
end function;

// Each save state uses the UI culture and falls back to English for unsupported cultures.
[X.TheoryAttribute]
[X.InlineDataAttribute('en-US', 'Continue', 'Restart', 'Settings', 'Exit')]
[X.InlineDataAttribute('de-DE', 'Fortfahren', 'Neu starten', 'Einstellungen', 'Beenden')]
[X.InlineDataAttribute('fr-FR', 'Continue', 'Restart', 'Settings', 'Exit')]
public procedure ShowsMenuForSaveState(
  Culture: string; ContinueLabel: string; RestartLabel: string; SettingsLabel: string; ExitLabel: string
);
begin
  const Previous: Globalization.CultureInfo := Globalization.CultureInfo.CurrentUICulture;
  Globalization.CultureInfo.CurrentUICulture := Globalization.CultureInfo.GetCultureInfo(Culture);
  try
    using const NewGame: Tui.HeadlessSession := Headless.Start<Menu.Model, Menu.Message>(
      new Menu.Model(false), Menu.Update, Screen.View, 80, 25, Screen.Theme()
    );
    const NewFrame: Tui.Frame := NewGame.Snapshot();
    X.Assert.True(HasText(NewFrame, '> Start'));
    X.Assert.False(HasText(NewFrame, ContinueLabel));
    X.Assert.False(HasText(NewFrame, RestartLabel));
    X.Assert.True(HasText(NewFrame, SettingsLabel));
    X.Assert.True(HasText(NewFrame, ExitLabel));

    using const Returning: Tui.HeadlessSession := Headless.Start<Menu.Model, Menu.Message>(
      new Menu.Model(true), Menu.Update, Screen.View, 80, 25, Screen.Theme()
    );
    const ReturningFrame: Tui.Frame := Returning.Snapshot();
    X.Assert.True(HasText(ReturningFrame, '> ' + ContinueLabel));
    X.Assert.True(HasText(ReturningFrame, RestartLabel));
    X.Assert.True(HasText(ReturningFrame, SettingsLabel));
    X.Assert.True(HasText(ReturningFrame, ExitLabel));
  finally
    Globalization.CultureInfo.CurrentUICulture := Previous;
  end try;
end procedure;

// Activating the last entry requests that the host close.
[X.FactAttribute]
public procedure OnlyExitRequestsClosure();
begin
  for HasSave: bool in [false, true] do
    const Last: int := Menu.EntryKeys(HasSave).Length - 1;
    for Index: int := 0 to Last do
      const Next: Mvu.Transition<Menu.Model, Menu.Message> := Menu.Update(
        new Menu.Model(HasSave, Index), Menu.Message.Activate
      );
      X.Assert.Equal<int>(Index, Next.Model.Selected);
      if Index = Last then
        X.Assert.Equal<Mvu.Command<Menu.Message>>(Mvu.Exit<Menu.Message>(), Next.Commands[0]);
      else
        X.Assert.Empty(Next.Commands);
      end if;
    end for;
  end for;
end procedure;

end unit;
