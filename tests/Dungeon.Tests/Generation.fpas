// Locks the generator version's outdoor cells and dungeon layouts to reviewed samples.
unit Dungeon.Tests.Generation;

uses Dungeon.Game.Terrain as Land, Dungeon.Game.Settlements as Town, Dungeon.Game.Items as Loot, Xunit as Test;

function OutdoorFingerprint(): long;
begin
  var Hash: long := 17L;
  for Y: int := -96 to 96 do
    for X: int := -96 to 96 do
      Hash := (Hash * 31L + cast<byte>(Land.Outdoors(-25, X, Y))) mod 1000000007L;
    end for;
  end for;

  return Hash;
end function;

function FloorFingerprint(Level: int): long;
begin
  const Site: Land.Floor := new Land.Floor(3, 0, Level);
  var Hash: long := 17L;
  for Y: int := 0 to 20 do
    for X: int := 0 to 30 do
      Hash := (Hash * 31L + cast<byte>(Land.Dungeon(25, Site, X, Y))) mod 1000000007L;
    end for;
  end for;

  return Hash;
end function;

function VillageFingerprint(X: int; Y: int): long;
begin
  const Site: Land.Village := new Land.Village(X, Y);
  var Hash: long := 17L;
  for Row: int := 0 to Town.Height(25, Site) - 1 do
    for Column: int := 0 to Town.Width(25, Site) - 1 do
      const Npc: Town.Npc? := Town.At(25, Site, Column, Row);
      const Cell: long := if Npc = null then cast<byte>(Town.Tile(
          25,
          Site,
          Column,
          Row
        ))
        else 20L + cast<byte>(Npc.Kind)
        end if;
      Hash := (Hash * 31L + Cell) mod 1000000007L;
    end for;
  end for;

  return Hash;
end function;

function LootFingerprint(Level: int): long;
begin
  const Site: Land.Floor := new Land.Floor(3, 0, Level);
  var Hash: long := 17L;
  for Value: Loot.Item in Loot.Finds(25, Site) do
    const At: Loot.Ground? := Value.Ground;
    if At = null then
      return -1L;
    end if;

    for Digit: int in [Value.Slot, cast<int>(Value.Kind), At.X, At.Y] do
      Hash := (Hash * 31L + Digit) mod 1000000007L;
    end for;
  end for;

  return Hash;
end function;

/// Pins generator 5 over terrain, dungeon finds and two village rosters.
[Test.FactAttribute]
public procedure GeneratorFiveFingerprint();
begin
  Test.Assert.Equal<int>(5, Land.GeneratorVersion);
  Test.Assert.Equal<long>(701433214L, OutdoorFingerprint());
  Test.Assert.Equal<long>(772955553L, FloorFingerprint(0));
  Test.Assert.Equal<long>(633939315L, FloorFingerprint(2));
  Test.Assert.Equal<long>(207614748L, VillageFingerprint(108, 41));
  Test.Assert.Equal<long>(61709824L, VillageFingerprint(146, 104));
  Test.Assert.Equal<long>(623962043L, LootFingerprint(0));
  Test.Assert.Equal<long>(15702845L, LootFingerprint(1));
  Test.Assert.Equal<long>(815524606L, LootFingerprint(2));
end procedure;
end unit;
