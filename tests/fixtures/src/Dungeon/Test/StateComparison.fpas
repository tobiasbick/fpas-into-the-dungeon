// Exact game-state comparisons for regression tests, including array contents and discovery masks.
unit Dungeon.Test.StateComparison;

uses Dungeon.Exploration.Model as ExplorationModel, Dungeon.GameState as StateUnit;

function SameFields(Left: array of boolean; Right: array of boolean): boolean;
begin
  if Left.Length() <> Right.Length() then
    return false;
  end if;

  for Index: integer := 0 to Left.Length() - 1 do
    if Left[Index] <> Right[Index] then
      return false;
    end if;
  end for;

  return true;
end function;

function SameExploration(Left: ExplorationModel.ExplorationState; Right: ExplorationModel.ExplorationState): boolean;
begin
  if (Left.OutdoorChunks.Length() <> Right.OutdoorChunks.Length())
    or
    (Left.InteriorAreas.Length() <> Right.InteriorAreas.Length())
  then
    return false;
  end if;

  for Index: integer := 0 to Left.OutdoorChunks.Length() - 1 do
    const A: ExplorationModel.OutdoorDiscoveryChunk := Left.OutdoorChunks[Index];
    const B: ExplorationModel.OutdoorDiscoveryChunk := Right.OutdoorChunks[Index];
    if (A.ChunkX <> B.ChunkX) or (A.ChunkY <> B.ChunkY)
      or
      not SameFields(A.Fields, B.Fields)
    then
      return false;
    end if;
  end for;

  for Index: integer := 0 to Left.InteriorAreas.Length() - 1 do
    const A: ExplorationModel.InteriorDiscoveryArea := Left.InteriorAreas[Index];
    const B: ExplorationModel.InteriorDiscoveryArea := Right.InteriorAreas[Index];
    if (A.AreaId <> B.AreaId) or (A.Width <> B.Width) or (A.Height <> B.Height)
      or
      not SameFields(A.Fields, B.Fields)
    then
      return false;
    end if;
  end for;

  return true;
end function;

// Compares every current GameState field, preserving array order and accepting invalid inputs.
// No rules, normalization, generation or storage run; extend this comparison when state fields change.
public function SameState(Left: StateUnit.GameState; Right: StateUnit.GameState): boolean;
begin
  if (Left.Area <> Right.Area) or (Left.AreaId <> Right.AreaId)
    or
    (Left.Player <> Right.Player) or (Left.ReturnLocation <> Right.ReturnLocation)
    or
    (Left.Health <> Right.Health) or (Left.RandomState <> Right.RandomState)
    or
    (Left.Progression <> Right.Progression) or (Left.Quest <> Right.Quest)
    or
    (Left.VisitedAreas.Length() <> Right.VisitedAreas.Length())
    or
    (Left.Items.Length() <> Right.Items.Length())
    or
    (Left.Hostiles.Length() <> Right.Hostiles.Length())
    or
    (Left.Npcs.Length() <> Right.Npcs.Length())
  then
    return false;
  end if;

  for Index: integer := 0 to Left.VisitedAreas.Length() - 1 do
    if Left.VisitedAreas[Index] <> Right.VisitedAreas[Index] then
      return false;
    end if;
  end for;

  for Index: integer := 0 to Left.Items.Length() - 1 do
    if Left.Items[Index] <> Right.Items[Index] then
      return false;
    end if;
  end for;

  for Index: integer := 0 to Left.Hostiles.Length() - 1 do
    if Left.Hostiles[Index] <> Right.Hostiles[Index] then
      return false;
    end if;
  end for;

  for Index: integer := 0 to Left.Npcs.Length() - 1 do
    if Left.Npcs[Index] <> Right.Npcs[Index] then
      return false;
    end if;
  end for;

  return SameExploration(Left.Exploration, Right.Exploration);
end function;
end unit;
