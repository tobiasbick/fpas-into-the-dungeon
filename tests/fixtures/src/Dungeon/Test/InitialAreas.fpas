// Temporary initial-area adapters for tests not yet migrated to independent fixtures.
unit Dungeon.Test.InitialAreas;

uses
  Dungeon.Areas, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interior, Dungeon.Hostiles,
  Dungeon.Interior.InitialDungeon, Dungeon.Items, Dungeon.Movement, Dungeon.Terrain, Std.Arrays,
  Std.Results;

// Returns the identity of the initial dungeon's ancient coin in the selected world.
public function InitialCoinId(Metadata: WorldMetadata): string;
begin
  return ItemPlacementId(Metadata.DungeonAreaId, 0)
end;

// Returns the identity of the initial dungeon's rusty short sword in the selected world.
public function InitialSwordId(Metadata: WorldMetadata): string;
begin
  return ItemPlacementId(Metadata.DungeonAreaId, 1)
end;

// Returns the identity of the initial dungeon's leather jerkin in the selected world.
public function InitialJerkinId(Metadata: WorldMetadata): string;
begin
  return ItemPlacementId(Metadata.DungeonAreaId, 2)
end;

// Returns the identity of the initial dungeon's restless skeleton in the selected world.
public function InitialSkeletonId(Metadata: WorldMetadata): string;
begin
  return HostilePlacementId(Metadata.DungeonAreaId, 0)
end;

// Explicitly materializes legacy initial entities without changing NewGame semantics.
public function MaterializedInitialState(Metadata: WorldMetadata): GameState;
begin
  return MaterializeArea(NewGame(Metadata), Std.Results.Unwrap(InitialDungeonMap(Metadata)))
end;

// Supplies geometry for legacy initial-area test states, preserving invalid inputs for validation.
// Removed when these tests migrate to Dungeon.Test.Fixtures.
public function InitialAreaView(Metadata: WorldMetadata; State: GameState): AreaView;
begin
  mutable var Map: option of InteriorMap := None;
  if State.Area = AreaKind.Dungeon then
  begin
    Map := Some(Std.Results.Unwrap(InitialDungeonMap(Metadata)))
  end;

  return record
    Metadata := Metadata;
    Interior := Map;
  end
end;

// Supplies the explicit transition target for legacy initial-area test states.
public function ActivateInitialTransition(Metadata: WorldMetadata; State: GameState): result of GameState, string;
begin
  var View: AreaView := InitialAreaView(Metadata, State);
  var Target: string := try AreaTransitionTarget(View, State);
  mutable var Map: option of InteriorMap := None;
  if State.Area = AreaKind.OutdoorRegion then
  begin
    Map := Some(try InitialDungeonMap(Metadata))
  end;
  var Transition: AreaTransition := try ActivateAreaTransition(View, State, Map);
  return Ok(Transition.State)
end;

// Performs complete placement checks for legacy initial-area validation tests.
public function ValidateInitialSave(Metadata: WorldMetadata; State: GameState): result of GameState, string;
begin
  if Std.Arrays.Length(State.VisitedAreas) = 0 then
  begin
    return ValidateSavedGame(Metadata, State, [])
  end;

  return ValidateSavedGame(Metadata, State, [try InitialDungeonMap(Metadata)])
end;
