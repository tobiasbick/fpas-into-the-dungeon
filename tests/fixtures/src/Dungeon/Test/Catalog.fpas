// Valid protocol catalog fixtures for tests of connected client session choices.
unit Dungeon.Test.Catalog;

uses Dungeon.Protocol as Protocol, Dungeon.Protocol.Worlds as Worlds;

// Supplies one compatible selected world; incompatible saves remain present and visible.
public function FixtureCatalog(SaveAvailable: boolean; InvalidSave: boolean): Protocol.WorldCatalog;
begin
  var SaveStatus: string := 'missing';
  var Reason: string := '';
  if SaveAvailable then
    SaveStatus := 'available';
  end if;

  if InvalidSave then
    SaveStatus := 'incompatible';
    Reason := 'Saved game is incompatible and was kept. Start over.';
  end if;

  return Worlds.EmptyWorldCatalog(12345, 4) with SelectedId := 'test'; Total := 1; Worlds := [
    Protocol.WorldSummary(
      Id := 'test',
      Seed := 12345,
      RegionChunks := 4,
      Status := 'ready',
      SaveStatus := SaveStatus,
      Reason := Reason
    )
  ]; end with;
end function;

// Exposes classified save presence for assertions against a welcome catalog.
public function FixtureSaveAvailable(Catalog: Protocol.WorldCatalog): boolean;
begin
  case Worlds.SelectedWorld(Catalog) of
    when Some(const World):
      begin
        return World.SaveStatus = 'available';
      end;
    when None:
      begin
        return false;
      end;
  end case;
end function;

// Invalid saves are retained; this predicate asserts classification without implying deletion.
public function FixtureInvalidSave(Catalog: Protocol.WorldCatalog): boolean;
begin
  case Worlds.SelectedWorld(Catalog) of
    when Some(const World):
      begin
        return World.SaveStatus = 'incompatible';
      end;
    when None:
      begin
        return false;
      end;
  end case;
end function;
end unit;
