// Verifies protocol version 13: equip and drop intentions, worn inventory entries, character lines, and combat events.
program EquipmentProtocolTest;

uses Dungeon.Protocol as Protocol, Dungeon.Protocol.ClientMessages as ClientMessages, Dungeon.Protocol.ServerMessages as ServerMessages, Std.Test as Test;

function Item(Id: string; Name: string; Slot: Protocol.VisibleItemSlot; Equipped: boolean): Protocol.VisibleInventoryItem;
begin
  return Protocol.VisibleInventoryItem(
    Id := Id,
    Name := Name,
    Slot := Slot,
    Equipped := Equipped,
    Usable := false
  );
end function;

function Hall(
  Inventory: array of Protocol.VisibleInventoryItem;
  Character: array of Protocol.VisibleCharacterValue;
  Events: array of Protocol.VisibleCombatEvent
): Protocol.FirstPersonVisibleState;
begin
  return Protocol.FirstPersonVisibleState(
    Time := Protocol.VisibleTime(Day := 1, MinuteOfDay := 480, Phase := Protocol.DayPhase.Day),
    Coins := 0,
    Title := 'Initial dungeon', Status := 'Nothing in reach', Level := 0, Depth := 1, Width := 5,
    Height := 3, Rows := [
      '#####',
      '#wa.#',
      '#####'
    ], KnowledgeRows := [
      'vvvvv',
      'vvvvv',
      'vvvvv'
    ], PlayerX := 3, PlayerY := 1, Facing := Protocol.FirstPersonFacing.West,
    Inventory := Inventory, Health := 20, MaxHealth := 20, Character := Character, CombatLog := [],
    CombatEvents := Events, Journal := []
  );
end function;

function Encoded(Value: Protocol.FirstPersonVisibleState): string;
begin
  return ServerMessages.EncodeServer(
    Protocol.ServerMessage.State(Protocol.VisibleState.FirstPersonState(Value))
  );
end function;

function Line(Label: string; Value: string; Source: string): Protocol.VisibleCharacterValue;
begin
  return Protocol.VisibleCharacterValue(Label := Label, Value := Value, Source := Source);
end function;

function Happened(Kind: Protocol.VisibleCombatEventKind; Amount: integer): Protocol.VisibleCombatEvent;
begin
  return Protocol.VisibleCombatEvent(
    Kind := Kind,
    Amount := Amount,
    HostileCode := Protocol.InteriorHostileCode
  );
end function;

begin
  Test.AssertEquals(21, Protocol.ProtocolVersion);
  // Equip intentions carry one bounded item id.
  Test.AssertEquals(
    '{"type":"equip","item_id":"sword"}',
    ClientMessages.EncodeClient(Protocol.ClientMessage.Equip('sword'))
  );
  Test.AssertEquals(
    '{"type":"unequip","item_id":"sword"}',
    ClientMessages.EncodeClient(Protocol.ClientMessage.Unequip('sword'))
  );
  case ClientMessages.DecodeClient('{"type":"equip","item_id":"sword"}').Unwrap() of
    when Protocol.ClientMessage.Equip(const ItemId):
      Test.AssertEquals('sword', ItemId);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected equip');
  end case;

  case ClientMessages.DecodeClient('{"type":"unequip","item_id":"jerkin"}').Unwrap() of
    when Protocol.ClientMessage.Unequip(const ItemId):
      Test.AssertEquals('jerkin', ItemId);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected unequip');
  end case;

  // Drop intentions carry one bounded item id as well.
  Test.AssertEquals(
    '{"type":"drop_item","item_id":"coin"}',
    ClientMessages.EncodeClient(Protocol.ClientMessage.DropItem('coin'))
  );
  case ClientMessages.DecodeClient('{"type":"drop_item","item_id":"coin"}').Unwrap() of
    when Protocol.ClientMessage.DropItem(const ItemId):
      Test.AssertEquals('coin', ItemId);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected drop_item');
  end case;

  Test.AssertTrue(ClientMessages.DecodeClient('{"type":"drop_item"}') is Error(_));
  Test.AssertTrue(ClientMessages.DecodeClient('{"type":"drop_item","item_id":""}') is Error(_));
  Test.AssertTrue(ClientMessages.DecodeClient('{"type":"drop_item","item_id":42}') is Error(_));
  Test.AssertTrue(
    (ClientMessages.DecodeClient('{"type":"drop_item","item_id":"a","x":1}') is Error(_))
  );
  Test.AssertTrue(
    (
      ClientMessages.DecodeClient(
        (
          '{"type":"drop_item","item_id":"' +
          'x'.RepeatStr(
            Protocol.MaximumVisibleInventoryTextLength +
            1
          )
        ) +
        '"}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(ClientMessages.DecodeClient('{"type":"equip"}') is Error(_));
  Test.AssertTrue(ClientMessages.DecodeClient('{"type":"equip","item_id":""}') is Error(_));
  Test.AssertTrue(ClientMessages.DecodeClient('{"type":"equip","item_id":42}') is Error(_));
  Test.AssertTrue(
    (ClientMessages.DecodeClient('{"type":"unequip","item_id":"a","slot":"weapon"}') is Error(_))
  );
  Test.AssertTrue(
    (
      ClientMessages.DecodeClient(
        (
          '{"type":"equip","item_id":"' +
          'x'.RepeatStr(
            Protocol.MaximumVisibleInventoryTextLength +
            1
          )
        ) +
        '"}'
      ) is Error(_)
    )
  );
  // A complete state round-trips worn items, character lines, and events in order.
  const Full: Protocol.FirstPersonVisibleState := Hall(
    [
      Item('coin', 'Ancient coin', Protocol.VisibleItemSlot.NoSlot, false),
      Item('sword', 'Rusty short sword', Protocol.VisibleItemSlot.Weapon, true),
      Item('jerkin', 'Leather jerkin', Protocol.VisibleItemSlot.Body, false)
    ], [
      Line('Damage', 'd6+1', 'Rusty short sword'),
      Line('Armor', '0', 'None')
    ], [
      Happened(Protocol.VisibleCombatEventKind.PlayerHit, 5),
      Happened(Protocol.VisibleCombatEventKind.HostileMiss, 0),
      Happened(Protocol.VisibleCombatEventKind.PlayerMiss, 0),
      Happened(Protocol.VisibleCombatEventKind.HostileHit, 3),
      Happened(Protocol.VisibleCombatEventKind.HostileDefeated, 0)
    ]
  );
  case ServerMessages.DecodeServer(Encoded(Full)).Unwrap() of
    when Protocol.ServerMessage.State(const Value):
      case Value of
        when Protocol.VisibleState.FirstPersonState(const Decoded):
          Test.AssertEquals(3, Decoded.Inventory.Length());
          Test.AssertTrue(Decoded.Inventory[0].Slot = Protocol.VisibleItemSlot.NoSlot);
          Test.AssertTrue(Decoded.Inventory[1].Slot = Protocol.VisibleItemSlot.Weapon);
          Test.AssertTrue(Decoded.Inventory[1].Equipped);
          Test.AssertTrue(Decoded.Inventory[2].Slot = Protocol.VisibleItemSlot.Body);
          Test.AssertFalse(Decoded.Inventory[2].Equipped);
          Test.AssertEquals(2, Decoded.Character.Length());
          Test.AssertEquals('d6+1', Decoded.Character[0].Value);
          Test.AssertEquals('Rusty short sword', Decoded.Character[0].Source);
          Test.AssertEquals(5, Decoded.CombatEvents.Length());
          Test.AssertTrue(Decoded.CombatEvents[0].Kind = Protocol.VisibleCombatEventKind.PlayerHit);
          Test.AssertEquals(5, Decoded.CombatEvents[0].Amount);
          Test.AssertTrue(
            Decoded.CombatEvents[3].Kind = Protocol.VisibleCombatEventKind.HostileHit
          );
          Test.AssertTrue(
            Decoded.CombatEvents[4].Kind = Protocol.VisibleCombatEventKind.HostileDefeated
          );
          Test.AssertEquals(Protocol.InteriorWeaponCode, Decoded.Rows[1][1]);
          Test.AssertEquals(Protocol.InteriorArmorCode, Decoded.Rows[1][2]);
        when Protocol.VisibleState.MapState(_):
          panic('expected first-person state');
      end case;
    when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
      panic('expected state');
  end case;

  // Only items with a slot can be worn, and never two in one slot.
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        Encoded(
          Hall([Item('coin', 'Ancient coin', Protocol.VisibleItemSlot.NoSlot, true)], [], [])
        )
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        Encoded(
          Hall(
            [
              Item('a', 'Sword', Protocol.VisibleItemSlot.Weapon, true),
              Item('b', 'Axe', Protocol.VisibleItemSlot.Weapon, true)
            ], [], []
          )
        )
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        Encoded(
          Hall(
            [
              Item('a', 'Sword', Protocol.VisibleItemSlot.Weapon, true),
              Item('b', 'Jerkin', Protocol.VisibleItemSlot.Body, true)
            ], [], []
          )
        )
      ) is Ok(_)
    )
  );
  const OneCoin: string := Encoded(
    Hall(
      [
        Item('coin', 'Ancient coin', Protocol.VisibleItemSlot.NoSlot, false)
      ], [], []
    )
  );
  Test.AssertTrue(
    (ServerMessages.DecodeServer(OneCoin.Replace('"slot":""', '"slot":"head"')) is Error(_))
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(OneCoin.Replace('"equipped":false', '"equipped":"no"')) is Error(_)
    )
  );
  Test.AssertTrue(
    (ServerMessages.DecodeServer(OneCoin.Replace(',"equipped":false', '')) is Error(_))
  );
  // Character lines: bounded count and text, no empty parts.
  var ManyLines: array of Protocol.VisibleCharacterValue := [];
  for Index: integer := 0 to Protocol.MaximumCharacterValues do
    begin
      ManyLines.PushInPlace(Line('Armor', '0', 'None'));
    end;
  end for;

  Test.AssertTrue(ServerMessages.DecodeServer(Encoded(Hall([], ManyLines, []))) is Error(_));
  Test.AssertTrue(
    (ServerMessages.DecodeServer(Encoded(Hall([], [Line('', '0', 'None')], []))) is Error(_))
  );
  Test.AssertTrue(
    (ServerMessages.DecodeServer(Encoded(Hall([], [Line('Armor', '', 'None')], []))) is Error(_))
  );
  Test.AssertTrue(
    (ServerMessages.DecodeServer(Encoded(Hall([], [Line('Armor', '0', '')], []))) is Error(_))
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        Encoded(
          Hall(
            [], [
              Line('Armor', '9'.RepeatStr(Protocol.MaximumCharacterTextLength + 1), 'None')
            ], []
          )
        )
      ) is Error(_)
    )
  );
  const OneLine: string := Encoded(Hall([], [Line('Armor', '0', 'None')], []));
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(OneLine.Replace('"source":"None"', '"source":"None","extra":1')) is Error(_)
    )
  );
  Test.AssertTrue(
    (ServerMessages.DecodeServer(OneLine.Replace('"character":[', '"character":[42,')) is Error(_))
  );
  // Combat events: known kinds, bounded count and amount.
  var ManyEvents: array of Protocol.VisibleCombatEvent := [];
  for Index: integer := 0 to Protocol.MaximumCombatEvents do
    begin
      ManyEvents.PushInPlace(Happened(Protocol.VisibleCombatEventKind.PlayerMiss, 0));
    end;
  end for;

  Test.AssertTrue(ServerMessages.DecodeServer(Encoded(Hall([], [], ManyEvents))) is Error(_));
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        Encoded(Hall([], [], [Happened(Protocol.VisibleCombatEventKind.PlayerHit, -1)]))
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        Encoded(
          Hall(
            [], [], [
              Happened(
                Protocol.VisibleCombatEventKind.PlayerHit,
                Protocol.MaximumCombatEventAmount + 1
              )
            ]
          )
        )
      ) is Error(_)
    )
  );
  const OneEvent: string := Encoded(
    Hall([], [], [Happened(Protocol.VisibleCombatEventKind.PlayerHit, 2)])
  );
  Test.AssertTrue(ServerMessages.DecodeServer(OneEvent) is Ok(_));
  Test.AssertTrue(
    (ServerMessages.DecodeServer(OneEvent.Replace('"player_hit"', '"dragon_breath"')) is Error(_))
  );
  Test.AssertTrue(
    (ServerMessages.DecodeServer(OneEvent.Replace('"amount":2', '"amount":2.5')) is Error(_))
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(OneEvent.Replace('"combat_events":[', '"combat_events":["x",')) is Error(_)
    )
  );
  // A missing event list is rejected wherever the field stands in the object.
  const EventsField: string := '"combat_events":[{"kind":"player_hit","amount":2,"hostile_code":"h"}]';
  Test.AssertTrue(EventsField in OneEvent);
  var WithoutEvents: string := OneEvent.Replace(',' + EventsField, '');
  if WithoutEvents = OneEvent then
    begin
      WithoutEvents := OneEvent.Replace(EventsField + ',', '');
    end;
  end if;

  Test.AssertTrue(ServerMessages.DecodeServer(WithoutEvents) is Error(_));
  // Both item codes belong to the interior alphabet; the map alphabet stays unchanged.
  Test.AssertTrue(Protocol.IsInteriorCellCode(Protocol.InteriorWeaponCode));
  Test.AssertTrue(Protocol.IsInteriorCellCode(Protocol.InteriorArmorCode));
  Test.AssertFalse(Protocol.IsMapCellCode(Protocol.InteriorArmorCode));
end.
