// Verifies protocol version 13: equip and drop intentions, worn inventory entries, character lines, and combat events.
program EquipmentProtocolTest;

uses Dungeon.Protocol, Dungeon.Protocol.ClientMessages, Dungeon.Protocol.ServerMessages, Std.Test;

function Item(Id: string; Name: string; Slot: VisibleItemSlot; Equipped: boolean): VisibleInventoryItem;
begin
  return VisibleInventoryItem(Id := Id, Name := Name, Slot := Slot, Equipped := Equipped);
end function;

function Hall(
  Inventory: array of VisibleInventoryItem;
  Character: array of VisibleCharacterValue;
  Events: array of VisibleCombatEvent
): FirstPersonVisibleState;
begin
  return FirstPersonVisibleState(Title := 'Initial dungeon', Status := 'Nothing in reach', Width := 5, Height := 3, Rows := [
                                                                                                                              '#####',
                                                                                                                              '#wa.#',
                                                                                                                              '#####'
                                                                                                                            ], KnowledgeRows := [
                                                                                                                                                  'vvvvv',
                                                                                                                                                  'vvvvv',
                                                                                                                                                  'vvvvv'
                                                                                                                                                ], PlayerX := 3, PlayerY := 1, Facing := FirstPersonFacing.West, Inventory := Inventory, Health := 20, MaxHealth := 20, Character := Character, CombatLog := [], CombatEvents := Events);
end function;

function Encoded(Value: FirstPersonVisibleState): string;
begin
  return EncodeServer(ServerMessage.State(VisibleState.FirstPersonState(Value)));
end function;

function Line(Label: string; Value: string; Source: string): VisibleCharacterValue;
begin
  return VisibleCharacterValue(Label := Label, Value := Value, Source := Source);
end function;

function Happened(Kind: VisibleCombatEventKind; Amount: integer): VisibleCombatEvent;
begin
  return VisibleCombatEvent(Kind := Kind, Amount := Amount);
end function;

begin
  AssertEquals(14, ProtocolVersion);
  // Equip intentions carry one bounded item id.
  AssertEquals('{"type":"equip","item_id":"sword"}', EncodeClient(ClientMessage.Equip('sword')));
  AssertEquals('{"type":"unequip","item_id":"sword"}', EncodeClient(ClientMessage.Unequip('sword')));
  if DecodeClient('{"type":"equip","item_id":"sword"}').Unwrap() is ClientMessage.Equip(const ItemId) then
    begin
      AssertEquals('sword', ItemId);
    end;
  else
    begin
      panic('expected equip');
    end;
  end if;

  if DecodeClient('{"type":"unequip","item_id":"jerkin"}').Unwrap() is ClientMessage.Unequip(const ItemId) then
    begin
      AssertEquals('jerkin', ItemId);
    end;
  else
    begin
      panic('expected unequip');
    end;
  end if;

  // Drop intentions carry one bounded item id as well.
  AssertEquals('{"type":"drop_item","item_id":"coin"}', EncodeClient(ClientMessage.DropItem('coin')));
  if DecodeClient('{"type":"drop_item","item_id":"coin"}').Unwrap() is ClientMessage.DropItem(const ItemId) then
    begin
      AssertEquals('coin', ItemId);
    end;
  else
    begin
      panic('expected drop_item');
    end;
  end if;

  AssertTrue(DecodeClient('{"type":"drop_item"}').IsError());
  AssertTrue(DecodeClient('{"type":"drop_item","item_id":""}').IsError());
  AssertTrue(DecodeClient('{"type":"drop_item","item_id":42}').IsError());
  AssertTrue(DecodeClient('{"type":"drop_item","item_id":"a","x":1}').IsError());
  AssertTrue(DecodeClient(('{"type":"drop_item","item_id":"' + 'x'.RepeatStr(MaximumVisibleInventoryTextLength +
                                                                             1)) +
                          '"}')
               .IsError());
  AssertTrue(DecodeClient('{"type":"equip"}').IsError());
  AssertTrue(DecodeClient('{"type":"equip","item_id":""}').IsError());
  AssertTrue(DecodeClient('{"type":"equip","item_id":42}').IsError());
  AssertTrue(DecodeClient('{"type":"unequip","item_id":"a","slot":"weapon"}').IsError());
  AssertTrue(DecodeClient(('{"type":"equip","item_id":"' + 'x'.RepeatStr(MaximumVisibleInventoryTextLength +
                                                                         1)) +
                          '"}')
               .IsError());
  // A complete state round-trips worn items, character lines, and events in order.
  const Full: FirstPersonVisibleState := Hall([
                                                Item('coin', 'Ancient coin', VisibleItemSlot.NoSlot, false),
                                                Item('sword', 'Rusty short sword', VisibleItemSlot.Weapon, true),
                                                Item('jerkin', 'Leather jerkin', VisibleItemSlot.Body, false)
                                              ], [
                                                   Line('Damage', 'd6+1', 'Rusty short sword'),
                                                   Line('Armor', '0', 'None')
                                                 ], [
                                                      Happened(VisibleCombatEventKind.PlayerHit, 5),
                                                      Happened(VisibleCombatEventKind.HostileMiss, 0),
                                                      Happened(VisibleCombatEventKind.PlayerMiss, 0),
                                                      Happened(VisibleCombatEventKind.HostileHit, 3),
                                                      Happened(VisibleCombatEventKind.HostileDefeated, 0)
                                                    ]);
  if DecodeServer(Encoded(Full)).Unwrap() is ServerMessage.State(const Value) then
    begin
      if Value is VisibleState.FirstPersonState(const Decoded) then
        begin
          AssertEquals(3, Decoded.Inventory.Length());
          AssertTrue(Decoded.Inventory[0].Slot = VisibleItemSlot.NoSlot);
          AssertTrue(Decoded.Inventory[1].Slot = VisibleItemSlot.Weapon);
          AssertTrue(Decoded.Inventory[1].Equipped);
          AssertTrue(Decoded.Inventory[2].Slot = VisibleItemSlot.Body);
          AssertFalse(Decoded.Inventory[2].Equipped);
          AssertEquals(2, Decoded.Character.Length());
          AssertEquals('d6+1', Decoded.Character[0].Value);
          AssertEquals('Rusty short sword', Decoded.Character[0].Source);
          AssertEquals(5, Decoded.CombatEvents.Length());
          AssertTrue(Decoded.CombatEvents[0].Kind = VisibleCombatEventKind.PlayerHit);
          AssertEquals(5, Decoded.CombatEvents[0].Amount);
          AssertTrue(Decoded.CombatEvents[3].Kind = VisibleCombatEventKind.HostileHit);
          AssertTrue(Decoded.CombatEvents[4].Kind = VisibleCombatEventKind.HostileDefeated);
          AssertEquals(InteriorWeaponCode, Decoded.Rows[1].CharAt(1));
          AssertEquals(InteriorArmorCode, Decoded.Rows[1].CharAt(2));
        end;
      else
        begin
          panic('expected first-person state');
        end;
      end if;
    end;
  else
    begin
      panic('expected state');
    end;
  end if;

  // Only items with a slot can be worn, and never two in one slot.
  AssertTrue(DecodeServer(Encoded(Hall([Item('coin', 'Ancient coin', VisibleItemSlot.NoSlot, true)], [], [])))
               .IsError());
  AssertTrue(DecodeServer(Encoded(Hall([
                                         Item('a', 'Sword', VisibleItemSlot.Weapon, true),
                                         Item('b', 'Axe', VisibleItemSlot.Weapon, true)
                                       ], [], [])))
               .IsError());
  AssertTrue(DecodeServer(Encoded(Hall([
                                         Item('a', 'Sword', VisibleItemSlot.Weapon, true),
                                         Item('b', 'Jerkin', VisibleItemSlot.Body, true)
                                       ], [], [])))
               .IsOk());
  const OneCoin: string := Encoded(Hall([
                                          Item('coin', 'Ancient coin', VisibleItemSlot.NoSlot, false)
                                        ], [], []));
  AssertTrue(DecodeServer(OneCoin.Replace('"slot":""', '"slot":"head"')).IsError());
  AssertTrue(DecodeServer(OneCoin.Replace('"equipped":false', '"equipped":"no"')).IsError());
  AssertTrue(DecodeServer(OneCoin.Replace(',"equipped":false', '')).IsError());
  // Character lines: bounded count and text, no empty parts.
  var ManyLines: array of VisibleCharacterValue := [];
  for Index: integer := 0 to MaximumCharacterValues do
    begin
      ManyLines.Push(Line('Armor', '0', 'None'));
    end;
  end for;

  AssertTrue(DecodeServer(Encoded(Hall([], ManyLines, []))).IsError());
  AssertTrue(DecodeServer(Encoded(Hall([], [Line('', '0', 'None')], []))).IsError());
  AssertTrue(DecodeServer(Encoded(Hall([], [Line('Armor', '', 'None')], []))).IsError());
  AssertTrue(DecodeServer(Encoded(Hall([], [Line('Armor', '0', '')], []))).IsError());
  AssertTrue(DecodeServer(Encoded(Hall([], [
                                             Line('Armor', '9'.RepeatStr(MaximumCharacterTextLength + 1), 'None')
                                           ], [])))
               .IsError());
  const OneLine: string := Encoded(Hall([], [Line('Armor', '0', 'None')], []));
  AssertTrue(DecodeServer(OneLine.Replace('"source":"None"', '"source":"None","extra":1')).IsError());
  AssertTrue(DecodeServer(OneLine.Replace('"character":[', '"character":[42,')).IsError());
  // Combat events: known kinds, bounded count and amount.
  var ManyEvents: array of VisibleCombatEvent := [];
  for Index: integer := 0 to MaximumCombatEvents do
    begin
      ManyEvents.Push(Happened(VisibleCombatEventKind.PlayerMiss, 0));
    end;
  end for;

  AssertTrue(DecodeServer(Encoded(Hall([], [], ManyEvents))).IsError());
  AssertTrue(DecodeServer(Encoded(Hall([], [], [Happened(VisibleCombatEventKind.PlayerHit, -1)])))
               .IsError());
  AssertTrue(DecodeServer(Encoded(Hall([], [], [
                                                 Happened(VisibleCombatEventKind.PlayerHit, MaximumCombatEventAmount + 1)
                                               ])))
               .IsError());
  const OneEvent: string := Encoded(Hall([], [], [Happened(VisibleCombatEventKind.PlayerHit, 2)]));
  AssertTrue(DecodeServer(OneEvent).IsOk());
  AssertTrue(DecodeServer(OneEvent.Replace('"player_hit"', '"dragon_breath"')).IsError());
  AssertTrue(DecodeServer(OneEvent.Replace('"amount":2', '"amount":2.5')).IsError());
  AssertTrue(DecodeServer(OneEvent.Replace('"combat_events":[', '"combat_events":["x",')).IsError());
  // A missing event list is rejected wherever the field stands in the object.
  const EventsField: string := '"combat_events":[{"kind":"player_hit","amount":2}]';
  AssertTrue(OneEvent.Contains(EventsField));
  var WithoutEvents: string := OneEvent.Replace(',' + EventsField, '');
  if WithoutEvents = OneEvent then
    begin
      WithoutEvents := OneEvent.Replace(EventsField + ',', '');
    end;
  end if;

  AssertTrue(DecodeServer(WithoutEvents).IsError());
  // Both item codes belong to the interior alphabet; the map alphabet stays unchanged.
  AssertTrue(IsInteriorCellCode(InteriorWeaponCode));
  AssertTrue(IsInteriorCellCode(InteriorArmorCode));
  AssertFalse(IsMapCellCode(InteriorArmorCode));
end.
