// Verifies protocol round trips and malformed-message rejection.
program DungeonProtocolMessagesTest;

uses Dungeon.Protocol, Std.Results, Std.Str, Std.Test;

begin
  case Unwrap(DecodeClient(EncodeClient(ClientMessage.Hello(ProtocolVersion, 80, 24)))) of
    ClientMessage.Hello(Version, Width, Height):
    begin
      AssertEquals(ProtocolVersion, Version);
      AssertEquals(80, Width);
      AssertEquals(24, Height)
    end
    else
    begin
      panic('expected hello message')
    end
  end;

  case Unwrap(DecodeClient(EncodeClient(ClientMessage.StartNewGame))) of
    ClientMessage.StartNewGame:
    begin
    end
    else
    begin
      panic('expected new-game message')
    end
  end;

  case Unwrap(DecodeClient(EncodeClient(ClientMessage.LoadGame))) of
    ClientMessage.LoadGame:
    begin
    end
    else
    begin
      panic('expected load-game message')
    end
  end;

  case Unwrap(DecodeClient(EncodeClient(ClientMessage.SaveGame))) of
    ClientMessage.SaveGame:
    begin
    end
    else
    begin
      panic('expected save-game message')
    end
  end;

  case Unwrap(DecodeServer(EncodeServer(ServerMessage.Welcome(ProtocolVersion, true, false)))) of
    ServerMessage.Welcome(Version, SaveAvailable, InvalidSaveRemoved):
    begin
      AssertEquals(ProtocolVersion, Version);
      AssertTrue(SaveAvailable);
      AssertFalse(InvalidSaveRemoved)
    end
    else
    begin
      panic('expected welcome message')
    end
  end;

  case Unwrap(DecodeServer(EncodeServer(ServerMessage.SaveCompleted))) of
    ServerMessage.SaveCompleted:
    begin
    end
    else
    begin
      panic('expected save-completed message')
    end
  end;

  case Unwrap(DecodeClient(EncodeClient(ClientMessage.Viewport(120, 40)))) of
    ClientMessage.Viewport(Width, Height):
    begin
      AssertEquals(120, Width);
      AssertEquals(40, Height)
    end
    else
    begin
      panic('expected viewport message')
    end
  end;
  var EncodedMove: string := EncodeClient(ClientMessage.Move(-1, 0));
  case Unwrap(DecodeClient(EncodedMove)) of
    ClientMessage.Move(DeltaX, DeltaY):
    begin
      AssertEquals(-1, DeltaX);
      AssertEquals(0, DeltaY)
    end
    else
    begin
      panic('expected move message')
    end
  end;

  case Unwrap(DecodeClient(EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Left)))) of
    ClientMessage.StepFirstPerson(Direction):
    begin
      AssertTrue(Direction = FirstPersonStepDirection.Left)
    end
    else
    begin
      panic('expected first-person step message')
    end
  end;

  case Unwrap(DecodeClient(EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward)))) of
    ClientMessage.StepFirstPerson(Direction):
    begin
      AssertTrue(Direction = FirstPersonStepDirection.Forward)
    end
    else
    begin
      panic('expected forward first-person step message')
    end
  end;

  case Unwrap(DecodeClient(EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Backward)))) of
    ClientMessage.StepFirstPerson(Direction):
    begin
      AssertTrue(Direction = FirstPersonStepDirection.Backward)
    end
    else
    begin
      panic('expected backward first-person step message')
    end
  end;

  case Unwrap(DecodeClient(EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Right)))) of
    ClientMessage.StepFirstPerson(Direction):
    begin
      AssertTrue(Direction = FirstPersonStepDirection.Right)
    end
    else
    begin
      panic('expected right first-person step message')
    end
  end;

  case Unwrap(DecodeClient(EncodeClient(ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Right)))) of
    ClientMessage.TurnFirstPerson(Direction):
    begin
      AssertTrue(Direction = FirstPersonTurnDirection.Right)
    end
    else
    begin
      panic('expected first-person turn message')
    end
  end;

  case Unwrap(DecodeClient(EncodeClient(ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Left)))) of
    ClientMessage.TurnFirstPerson(Direction):
    begin
      AssertTrue(Direction = FirstPersonTurnDirection.Left)
    end
    else
    begin
      panic('expected left first-person turn message')
    end
  end;

  case Unwrap(DecodeClient(EncodeClient(ClientMessage.ActivateAreaTransition))) of
    ClientMessage.ActivateAreaTransition:
    begin
    end
    else
    begin
      panic('expected area-transition activation')
    end
  end;
  var MapValue: MapVisibleState := record
    OriginX := -12;
    OriginY := 7;
    Width := 5;
    Height := 2;
    Rows := ['otfdm', 'gplrg'];
    KnowledgeRows := ['vvvvv', 'vvvvv'];
    PlayerX := 2;
    PlayerY := 1;
    WorldX := -10;
    WorldY := 8;
  end;
  var StateValue: VisibleState := VisibleState.MapState(MapValue);
  var EncodedMapState: string := EncodeServer(ServerMessage.State(StateValue));
  AssertFalse(Std.Str.Contains(EncodedMapState, 'chunk_x'));
  AssertFalse(Std.Str.Contains(EncodedMapState, 'outdoor_chunks'));
  AssertFalse(Std.Str.Contains(EncodedMapState, 'save'));
  case Unwrap(DecodeServer(EncodedMapState)) of
    ServerMessage.State(DecodedState):
    begin
      AssertTrue(ViewForVisibleState(DecodedState) = ViewKind.Map);
      case DecodedState of
        VisibleState.MapState(DecodedMap):
        begin
          AssertEquals(5, DecodedMap.Width);
          AssertEquals(2, DecodedMap.Height);
          AssertEquals('gplrg', DecodedMap.Rows[1]);
          AssertEquals('vvvvv', DecodedMap.KnowledgeRows[1]);
          AssertEquals(2, DecodedMap.PlayerX);
          AssertEquals(1, DecodedMap.PlayerY);
          AssertEquals(-12, DecodedMap.OriginX);
          AssertEquals(7, DecodedMap.OriginY);
          AssertEquals(-10, DecodedMap.WorldX);
          AssertEquals(8, DecodedMap.WorldY)
        end
        else
        begin
          panic('expected map state')
        end
      end
    end
    else
    begin
      panic('expected state message')
    end
  end;
  var FirstPersonValue: FirstPersonVisibleState := record
    Title := 'Initial dungeon';
    Status := 'Find the exit.';
    Width := 5;
    Height := 3;
    Rows := ['#####', '#.x.#', '#####'];
    KnowledgeRows := ['vvvvv', 'vvvvv', 'vvvvv'];
    PlayerX := 1;
    PlayerY := 1;
    Facing := FirstPersonFacing.West;
  end;
  var EncodedFirstPerson: string := EncodeServer(ServerMessage.State(VisibleState.FirstPersonState(FirstPersonValue)));
  AssertFalse(Std.Str.Contains(EncodedFirstPerson, 'area_id'));
  AssertFalse(Std.Str.Contains(EncodedFirstPerson, 'return_location'));
  case Unwrap(DecodeServer(EncodedFirstPerson)) of
    ServerMessage.State(DecodedFirstPerson):
    begin
      AssertTrue(ViewForVisibleState(DecodedFirstPerson) = ViewKind.FirstPerson);
      case DecodedFirstPerson of
        VisibleState.FirstPersonState(Value):
        begin
          AssertEquals('Initial dungeon', Value.Title);
          AssertEquals('Find the exit.', Value.Status);
          AssertEquals(5, Value.Width);
          AssertEquals(3, Value.Height);
          AssertEquals('#.x.#', Value.Rows[1]);
          AssertEquals('vvvvv', Value.KnowledgeRows[1]);
          AssertEquals(1, Value.PlayerX);
          AssertEquals(1, Value.PlayerY);
          AssertTrue(Value.Facing = FirstPersonFacing.West)
        end
        else
        begin
          panic('expected first-person state')
        end
      end
    end
    else
    begin
      panic('expected first-person server state')
    end
  end;

  case Unwrap(DecodeClient(EncodeClient(ClientMessage.ExplorationMap(-20, 30, 40, 12)))) of
    ClientMessage.ExplorationMap(OriginX, OriginY, Width, Height):
    begin
      AssertEquals(-20, OriginX);
      AssertEquals(30, OriginY);
      AssertEquals(40, Width);
      AssertEquals(12, Height)
    end
    else
    begin
      panic('expected exploration-map request')
    end
  end;
  var ExplorationValue: ExplorationMapState := record
    View := ViewKind.Map;
    LabelText := 'Outdoor region';
    OriginX := 9;
    OriginY := 20;
    Width := 3;
    Height := 1;
    Rows := ['?go'];
    KnowledgeRows := ['urv'];
    PlayerWorldX := 11;
    PlayerWorldY := 20;
    PlayerInWindow := true;
  end;

  case Unwrap(DecodeServer(EncodeServer(ServerMessage.ExplorationMap(ExplorationValue)))) of
    ServerMessage.ExplorationMap(Value):
    begin
      AssertTrue(Value.View = ViewKind.Map);
      AssertEquals('Outdoor region', Value.LabelText);
      AssertEquals('?go', Value.Rows[0]);
      AssertEquals('urv', Value.KnowledgeRows[0]);
      AssertTrue(Value.PlayerInWindow)
    end
    else
    begin
      panic('expected exploration-map response')
    end
  end;

  AssertTrue(IsError(DecodeClient('{"type":"move","dx":0.5,"dy":0}')));
  AssertTrue(IsError(DecodeClient('{"type":"hello","version":5,"width":80,"height":24,"extra":1}')));
  AssertTrue(IsError(DecodeClient('{"type":"new_game","extra":1}')));
  AssertTrue(IsError(DecodeClient('{"type":"new_game","type":"new_game"}')));
  AssertTrue(IsError(DecodeClient('{"type":"load_game","extra":1}')));
  AssertTrue(IsError(DecodeClient('{"type":"load_game","type":"load_game"}')));
  AssertTrue(IsError(DecodeClient('{"type":"save_game","extra":1}')));
  AssertTrue(IsError(DecodeClient('{"type":"save_game","type":"save_game"}')));
  AssertTrue(IsError(DecodeClient('{"type":"disconnect","extra":1}')));
  AssertTrue(IsError(DecodeClient('{"type":"viewport","width":1.5,"height":2}')));
  AssertTrue(IsError(DecodeClient('{"type":"viewport","width":2,"height":2,"extra":1}')));
  AssertTrue(IsError(DecodeClient('{"type":"exploration_map","origin_x":0,"origin_y":0,"width":0,"height":2}')));
  AssertTrue(IsError(DecodeClient('{"type":"exploration_map","origin_x":0,"origin_y":0,"width":241,"height":2}')));
  AssertTrue(IsError(DecodeClient('{"type":"exploration_map","origin_x":1000000001,"origin_y":0,"width":2,"height":2}')));
  AssertTrue(IsError(DecodeClient('{"type":"exploration_map","origin_x":0,"origin_y":0,"width":2,"height":2,"extra":1}')));
  AssertTrue(IsError(DecodeServer('{"type":"exploration_map","view":"map","label":"Area","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["gg"],"knowledge_rows":["uv"],"player_world_x":1,"player_world_y":0,"player_in_window":true}')));
  AssertTrue(IsError(DecodeServer('{"type":"exploration_map","view":"map","label":"Area","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["?g"],"knowledge_rows":["uv"],"player_world_x":2,"player_world_y":0,"player_in_window":true}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["gg"],"knowledge_rows":["uv"],"x":1,"y":0,"world_x":1,"world_y":0}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["?g"],"knowledge_rows":["u"],"x":1,"y":0,"world_x":1,"world_y":0}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["?g"],"knowledge_rows":["uv"],"knowledge_rows":["uv"],"x":1,"y":0,"world_x":1,"world_y":0}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["ggg"],"x":0,"y":0,"world_x":0,"world_y":0}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["gx"],"x":0,"y":0,"world_x":0,"world_y":0}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"map","origin_x":10,"origin_y":20,"width":2,"height":1,"rows":["gg"],"x":0,"y":0,"world_x":11,"world_y":20}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"first_person","title":"","status":"Return","width":5,"height":3,"rows":["#####","#.x.#","#####"],"x":1,"y":1,"facing":"north"}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"first_person","title":"Dungeon"}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"first_person","title":"Dungeon","status":"Return","width":5,"height":3,"rows":["#####","#.x.#","####"],"x":1,"y":1,"facing":"north"}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"first_person","title":"Dungeon","status":"Return","width":5,"height":3,"rows":["#####","#xx.#","#####"],"x":3,"y":1,"facing":"north"}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"first_person","title":"Dungeon","status":"Return","width":5,"height":3,"rows":["#####","#.x.#","#####"],"x":0,"y":0,"facing":"north"}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"first_person","title":"Dungeon","status":"Return","width":5,"height":3,"rows":["#####","#.x.#","#####"],"x":1,"y":1,"facing":"up"}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"first_person","title":"Dungeon","status":"Return","width":5,"height":3,"rows":["#####","#.x.#","#####"],"x":1,"y":1,"facing":"north","extra":1}')));
  AssertTrue(IsError(DecodeClient('{"type":"first_person_step","direction":"diagonal"}')));
  AssertTrue(IsError(DecodeClient('{"type":"first_person_step","direction":"forward","extra":1}')));
  AssertTrue(IsError(DecodeClient('{"type":"first_person_turn","direction":"around"}')));
  AssertTrue(IsError(DecodeClient('{"type":"activate_area_transition","dx":1}')));
  AssertTrue(IsError(DecodeServer('{"type":"welcome","version":5,"save_available":"yes","invalid_save_removed":false}')));
  AssertTrue(IsError(DecodeServer('{"type":"welcome","version":5,"save_available":false}')));
  AssertTrue(IsError(DecodeServer('{"type":"welcome","version":5,"save_available":false,"invalid_save_removed":false,"extra":1}')));
  AssertTrue(IsError(DecodeServer('{"type":"welcome","version":5,"save_available":false,"invalid_save_removed":false,"invalid_save_removed":false}')));
  AssertTrue(IsError(DecodeServer('{"type":"save_completed","extra":1}')));
  AssertTrue(IsError(DecodeServer('{"type":"save_completed","type":"save_completed"}')));
  AssertTrue(IsError(DecodeServer('{"type":"rejected","code":"x","message":"x","extra":1}')));
  AssertTrue(IsError(DecodeClient('{}')));
  AssertTrue(IsError(DecodeClient('{"type":2}')));
  AssertTrue(IsError(DecodeServer('{"type":"unknown"}')))
end.
