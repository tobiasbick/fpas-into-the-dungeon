program DungeonProtocolMessagesTest;

uses Dungeon.Protocol, Std.Results, Std.Test;

begin
  var EncodedMove: string := EncodeClient(ClientMessage.Move(-1, 0));
  case Unwrap(DecodeClient(EncodedMove)) of
    ClientMessage.Move(DeltaX, DeltaY):
    begin
      AssertEquals(-1, DeltaX);
      AssertEquals(0, DeltaY)
    end
    else
    begin
      panic('expected move message')
    end
  end;

  case Unwrap(DecodeServer(EncodeServer(ServerMessage.State(4, 2)))) of
    ServerMessage.State(PlayerX, PlayerY):
    begin
      AssertEquals(4, PlayerX);
      AssertEquals(2, PlayerY)
    end
    else
    begin
      panic('expected state message')
    end
  end;

  AssertTrue(IsError(DecodeClient('{"type":"move","dx":0.5,"dy":0}')));
  AssertTrue(IsError(DecodeServer('{"type":"unknown"}')))
end.
