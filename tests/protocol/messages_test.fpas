// Verifies protocol round trips and malformed-message rejection.
program DungeonProtocolMessagesTest;

uses Dungeon.Protocol, Std.Results, Std.Str, Std.Test;

begin
  case Unwrap(DecodeClient(EncodeClient(ClientMessage.Hello(ProtocolVersion, 80, 24)))) of
    ClientMessage.Hello(Version, Width, Height):
    begin
      AssertEquals(ProtocolVersion, Version);
      AssertEquals(80, Width);
      AssertEquals(24, Height)
    end
    else
    begin
      panic('expected hello message')
    end
  end;

  case Unwrap(DecodeClient(EncodeClient(ClientMessage.Viewport(120, 40)))) of
    ClientMessage.Viewport(Width, Height):
    begin
      AssertEquals(120, Width);
      AssertEquals(40, Height)
    end
    else
    begin
      panic('expected viewport message')
    end
  end;
  var EncodedMove: string := EncodeClient(ClientMessage.Move(-1, 0));
  case Unwrap(DecodeClient(EncodedMove)) of
    ClientMessage.Move(DeltaX, DeltaY):
    begin
      AssertEquals(-1, DeltaX);
      AssertEquals(0, DeltaY)
    end
    else
    begin
      panic('expected move message')
    end
  end;

  case Unwrap(DecodeClient(EncodeClient(ClientMessage.ActivateAreaTransition))) of
    ClientMessage.ActivateAreaTransition:
    begin
    end
    else
    begin
      panic('expected area-transition activation')
    end
  end;
  var MapValue: MapVisibleState := record
    OriginX := -12;
    OriginY := 7;
    Width := 5;
    Height := 2;
    Rows := ['otfdm', 'gplrg'];
    PlayerX := 2;
    PlayerY := 1;
    WorldX := -10;
    WorldY := 8;
  end;
  var StateValue: VisibleState := VisibleState.MapState(MapValue);
  case Unwrap(DecodeServer(EncodeServer(ServerMessage.State(StateValue)))) of
    ServerMessage.State(DecodedState):
    begin
      AssertTrue(ViewForVisibleState(DecodedState) = ViewKind.Map);
      case DecodedState of
        VisibleState.MapState(DecodedMap):
        begin
          AssertEquals(5, DecodedMap.Width);
          AssertEquals(2, DecodedMap.Height);
          AssertEquals('gplrg', DecodedMap.Rows[1]);
          AssertEquals(2, DecodedMap.PlayerX);
          AssertEquals(1, DecodedMap.PlayerY);
          AssertEquals(-12, DecodedMap.OriginX);
          AssertEquals(7, DecodedMap.OriginY);
          AssertEquals(-10, DecodedMap.WorldX);
          AssertEquals(8, DecodedMap.WorldY)
        end
        else
        begin
          panic('expected map state')
        end
      end
    end
    else
    begin
      panic('expected state message')
    end
  end;
  var FirstPersonValue: FirstPersonVisibleState := record
    Title := 'Initial dungeon';
    Status := 'Press Enter to return.';
  end;
  var EncodedFirstPerson: string := EncodeServer(ServerMessage.State(VisibleState.FirstPersonState(FirstPersonValue)));
  AssertFalse(Std.Str.Contains(EncodedFirstPerson, 'area_id'));
  AssertFalse(Std.Str.Contains(EncodedFirstPerson, 'return_location'));
  case Unwrap(DecodeServer(EncodedFirstPerson)) of
    ServerMessage.State(DecodedFirstPerson):
    begin
      AssertTrue(ViewForVisibleState(DecodedFirstPerson) = ViewKind.FirstPerson);
      case DecodedFirstPerson of
        VisibleState.FirstPersonState(Value):
        begin
          AssertEquals('Initial dungeon', Value.Title);
          AssertEquals('Press Enter to return.', Value.Status)
        end
        else
        begin
          panic('expected first-person state')
        end
      end
    end
    else
    begin
      panic('expected first-person server state')
    end
  end;

  AssertTrue(IsError(DecodeClient('{"type":"move","dx":0.5,"dy":0}')));
  AssertTrue(IsError(DecodeClient('{"type":"viewport","width":1.5,"height":2}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["ggg"],"x":0,"y":0,"world_x":0,"world_y":0}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["gx"],"x":0,"y":0,"world_x":0,"world_y":0}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"map","origin_x":10,"origin_y":20,"width":2,"height":1,"rows":["gg"],"x":0,"y":0,"world_x":11,"world_y":20}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"first_person","title":"","status":"Return"}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"first_person","title":"Dungeon"}')));
  AssertTrue(IsError(DecodeServer('{"type":"state","view":"first_person","title":"Dungeon","status":"Return","rows":[]}')));
  AssertTrue(IsError(DecodeClient('{"type":"activate_area_transition","dx":1}')));
  AssertTrue(IsError(DecodeClient('{"type":2}')));
  AssertTrue(IsError(DecodeServer('{"type":"unknown"}')))
end.
