// Verifies protocol round trips and malformed-message rejection.
program DungeonProtocolMessagesTest;

uses
  Dungeon.Test.Catalog, Dungeon.Protocol, Dungeon.Protocol.ClientMessages,
  Dungeon.Protocol.ServerMessages, Std.Conv, Std.Test;

begin
  if DecodeClient(EncodeClient(ClientMessage.Hello(ProtocolVersion, 80, 24))).Unwrap() is ClientMessage.Hello(const Version, const Width, const Height) then
    begin
      AssertEquals(ProtocolVersion, Version);
      AssertEquals(80, Width);
      AssertEquals(24, Height);
    end;
  else
    begin
      panic('expected hello message');
    end;
  end if;

  if DecodeClient(EncodeClient(ClientMessage.StartNewGame)).Unwrap() is ClientMessage.StartNewGame then
    begin
      null;
    end;
  else
    begin
      panic('expected new-game message');
    end;
  end if;

  if DecodeClient(EncodeClient(ClientMessage.LoadGame)).Unwrap() is ClientMessage.LoadGame then
    begin
      null;
    end;
  else
    begin
      panic('expected load-game message');
    end;
  end if;

  if DecodeClient(EncodeClient(ClientMessage.SaveGame)).Unwrap() is ClientMessage.SaveGame then
    begin
      null;
    end;
  else
    begin
      panic('expected save-game message');
    end;
  end if;

  if DecodeServer(EncodeServer(ServerMessage.Welcome(ProtocolVersion, FixtureCatalog(true, false)))).Unwrap() is ServerMessage.Welcome(const Version, const Catalog) then
    begin
      AssertEquals(ProtocolVersion, Version);
      AssertTrue(FixtureSaveAvailable(Catalog));
      AssertFalse(FixtureInvalidSave(Catalog));
    end;
  else
    begin
      panic('expected welcome message');
    end;
  end if;

  if DecodeServer(EncodeServer(ServerMessage.SaveCompleted)).Unwrap() is ServerMessage.SaveCompleted then
    begin
      null;
    end;
  else
    begin
      panic('expected save-completed message');
    end;
  end if;

  if DecodeClient(EncodeClient(ClientMessage.Viewport(120, 40))).Unwrap() is ClientMessage.Viewport(const Width, const Height) then
    begin
      AssertEquals(120, Width);
      AssertEquals(40, Height);
    end;
  else
    begin
      panic('expected viewport message');
    end;
  end if;
  const EncodedMove: string := EncodeClient(ClientMessage.Move(-1, 0));
  if DecodeClient(EncodedMove).Unwrap() is ClientMessage.Move(const DeltaX, const DeltaY) then
    begin
      AssertEquals(-1, DeltaX);
      AssertEquals(0, DeltaY);
    end;
  else
    begin
      panic('expected move message');
    end;
  end if;

  if DecodeClient(EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Left))).Unwrap() is ClientMessage.StepFirstPerson(const Direction) then
    begin
      AssertTrue(Direction = FirstPersonStepDirection.Left);
    end;
  else
    begin
      panic('expected first-person step message');
    end;
  end if;

  if DecodeClient(EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward))).Unwrap() is ClientMessage.StepFirstPerson(const Direction) then
    begin
      AssertTrue(Direction = FirstPersonStepDirection.Forward);
    end;
  else
    begin
      panic('expected forward first-person step message');
    end;
  end if;

  if DecodeClient(EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Backward))).Unwrap() is ClientMessage.StepFirstPerson(const Direction) then
    begin
      AssertTrue(Direction = FirstPersonStepDirection.Backward);
    end;
  else
    begin
      panic('expected backward first-person step message');
    end;
  end if;

  if DecodeClient(EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Right))).Unwrap() is ClientMessage.StepFirstPerson(const Direction) then
    begin
      AssertTrue(Direction = FirstPersonStepDirection.Right);
    end;
  else
    begin
      panic('expected right first-person step message');
    end;
  end if;

  if DecodeClient(EncodeClient(ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Right))).Unwrap() is ClientMessage.TurnFirstPerson(const Direction) then
    begin
      AssertTrue(Direction = FirstPersonTurnDirection.Right);
    end;
  else
    begin
      panic('expected first-person turn message');
    end;
  end if;

  if DecodeClient(EncodeClient(ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Left))).Unwrap() is ClientMessage.TurnFirstPerson(const Direction) then
    begin
      AssertTrue(Direction = FirstPersonTurnDirection.Left);
    end;
  else
    begin
      panic('expected left first-person turn message');
    end;
  end if;

  if DecodeClient(EncodeClient(ClientMessage.Interact)).Unwrap() is ClientMessage.Interact then
    begin
      null;
    end;
  else
    begin
      panic('expected interaction intention');
    end;
  end if;

  if DecodeServer(EncodeServer(ServerMessage.Interaction('Ancient coin', 'A tarnished coin.'))).Unwrap() is ServerMessage.Interaction(const Title, const Message) then
    begin
      AssertEquals('Ancient coin', Title);
      AssertEquals('A tarnished coin.', Message);
    end;
  else
    begin
      panic('expected interaction result');
    end;
  end if;
  const MapValue: MapVisibleState := MapVisibleState(OriginX := -12, OriginY := 7, Width := 5, Height := 2, Rows := [
                                                                                                                      'otfdm',
                                                                                                                      'gplrg'
                                                                                                                    ], KnowledgeRows := [
                                                                                                                                          'vvvvv',
                                                                                                                                          'vvvvv'
                                                                                                                                        ], PlayerX := 2, PlayerY := 1, WorldX := -10, WorldY := 8, Inventory := [
                                                                                                                                                                                                                  VisibleInventoryItem(Id := 'example:dungeon:0:0:item:0', Name := 'Ancient coin', Slot := VisibleItemSlot.NoSlot, Equipped := false)
                                                                                                                                                                                                                ], Health := 17, MaxHealth := 20, Character := []);
  const StateValue: VisibleState := VisibleState.MapState(MapValue);
  const EncodedMapState: string := EncodeServer(ServerMessage.State(StateValue));
  AssertFalse(EncodedMapState.Contains('chunk_x'));
  AssertFalse(EncodedMapState.Contains('outdoor_chunks'));
  AssertFalse(EncodedMapState.Contains('save'));
  if DecodeServer(EncodedMapState).Unwrap() is ServerMessage.State(const DecodedState) then
    begin
      AssertTrue(ViewForVisibleState(DecodedState) = ViewKind.Map);
      if DecodedState is VisibleState.MapState(const DecodedMap) then
        begin
          AssertEquals(5, DecodedMap.Width);
          AssertEquals(2, DecodedMap.Height);
          AssertEquals('gplrg', DecodedMap.Rows[1]);
          AssertEquals('vvvvv', DecodedMap.KnowledgeRows[1]);
          AssertEquals(2, DecodedMap.PlayerX);
          AssertEquals(1, DecodedMap.PlayerY);
          AssertEquals(-12, DecodedMap.OriginX);
          AssertEquals(7, DecodedMap.OriginY);
          AssertEquals(-10, DecodedMap.WorldX);
          AssertEquals(8, DecodedMap.WorldY);
          AssertEquals(1, DecodedMap.Inventory.Length());
          AssertEquals('example:dungeon:0:0:item:0', DecodedMap.Inventory[0].Id);
          AssertEquals('Ancient coin', DecodedMap.Inventory[0].Name);
        end;
      else
        begin
          panic('expected map state');
        end;
      end if;
    end;
  else
    begin
      panic('expected state message');
    end;
  end if;
  const EncodedInventory: string := '"inventory":[{"id":"example:dungeon:0:0:item:0","name":"Ancient coin","slot":"","equipped":false}]';
  AssertTrue(DecodeServer(EncodedMapState.Replace(EncodedInventory, '"inventory":42')).IsError());
  AssertTrue(DecodeServer(EncodedMapState.Replace(EncodedInventory, '"inventory":[42]')).IsError());
  AssertTrue(DecodeServer(EncodedMapState.Replace(EncodedInventory, '"inventory":[{"id":"coin"}]'))
               .IsError());
  AssertTrue(DecodeServer(EncodedMapState.Replace(EncodedInventory, '"inventory":[{"id":"coin","name":"Coin","extra":1}]'))
               .IsError());
  var InvalidInventoryMap: MapVisibleState := MapValue;
  InvalidInventoryMap.Inventory := [
                                     VisibleInventoryItem(Id := '', Name := 'Ancient coin', Slot := VisibleItemSlot.NoSlot, Equipped := false)
                                   ];
  AssertTrue(DecodeServer(EncodeServer(ServerMessage.State(VisibleState.MapState(InvalidInventoryMap))))
               .IsError());
  InvalidInventoryMap.Inventory := [
                                     VisibleInventoryItem(Id := 'coin', Name := '', Slot := VisibleItemSlot.NoSlot, Equipped := false)
                                   ];
  AssertTrue(DecodeServer(EncodeServer(ServerMessage.State(VisibleState.MapState(InvalidInventoryMap))))
               .IsError());
  InvalidInventoryMap.Inventory := [
                                     VisibleInventoryItem(Id := 'coin', Name := 'Coin', Slot := VisibleItemSlot.NoSlot, Equipped := false),
                                     VisibleInventoryItem(Id := 'coin', Name := 'Duplicate', Slot := VisibleItemSlot.NoSlot, Equipped := false)
                                   ];
  AssertTrue(DecodeServer(EncodeServer(ServerMessage.State(VisibleState.MapState(InvalidInventoryMap))))
               .IsError());
  InvalidInventoryMap.Inventory := [
                                     VisibleInventoryItem(Id := 'x'.RepeatStr(MaximumVisibleInventoryTextLength + 1), Name := 'Too long', Slot := VisibleItemSlot.NoSlot, Equipped := false)
                                   ];
  AssertTrue(DecodeServer(EncodeServer(ServerMessage.State(VisibleState.MapState(InvalidInventoryMap))))
               .IsError());
  var MaximumInventory: array of VisibleInventoryItem := [];
  for Index: integer := 0 to MaximumVisibleInventoryItems - 1 do
    begin
      MaximumInventory.Push(VisibleInventoryItem(Id := 'item-' + IntToStr(Index), Name := 'Item ' +
                                                                                          IntToStr(Index), Slot := VisibleItemSlot.NoSlot, Equipped := false));
    end;
  end for;

  InvalidInventoryMap.Inventory := MaximumInventory;
  AssertTrue(DecodeServer(EncodeServer(ServerMessage.State(VisibleState.MapState(InvalidInventoryMap))))
               .IsOk());
  MaximumInventory.Push(VisibleInventoryItem(Id := 'one-too-many', Name := 'One too many', Slot := VisibleItemSlot.NoSlot, Equipped := false));
  InvalidInventoryMap.Inventory := MaximumInventory;
  AssertTrue(DecodeServer(EncodeServer(ServerMessage.State(VisibleState.MapState(InvalidInventoryMap))))
               .IsError());
  const FirstPersonValue: FirstPersonVisibleState := FirstPersonVisibleState(Title := 'Initial dungeon', Status := 'Find the exit.', Width := 5, Height := 3, Rows := [
                                                                                                                                                                        '#####',
                                                                                                                                                                        '#ix.#',
                                                                                                                                                                        '#####'
                                                                                                                                                                      ], KnowledgeRows := [
                                                                                                                                                                                            'vvvvv',
                                                                                                                                                                                            'vvvvv',
                                                                                                                                                                                            'vvvvv'
                                                                                                                                                                                          ], PlayerX := 1, PlayerY := 1, Facing := FirstPersonFacing.West, Inventory := [], Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []);
  const EncodedFirstPerson: string := EncodeServer(ServerMessage.State(VisibleState.FirstPersonState(FirstPersonValue)));
  AssertFalse(EncodedFirstPerson.Contains('area_id'));
  AssertFalse(EncodedFirstPerson.Contains('return_location'));
  if DecodeServer(EncodedFirstPerson).Unwrap() is ServerMessage.State(const DecodedFirstPerson) then
    begin
      AssertTrue(ViewForVisibleState(DecodedFirstPerson) = ViewKind.FirstPerson);
      if DecodedFirstPerson is VisibleState.FirstPersonState(const Value) then
        begin
          AssertEquals('Initial dungeon', Value.Title);
          AssertEquals('Find the exit.', Value.Status);
          AssertEquals(5, Value.Width);
          AssertEquals(3, Value.Height);
          AssertEquals('#ix.#', Value.Rows[1]);
          AssertEquals('vvvvv', Value.KnowledgeRows[1]);
          AssertEquals(1, Value.PlayerX);
          AssertEquals(1, Value.PlayerY);
          AssertTrue(Value.Facing = FirstPersonFacing.West);
        end;
      else
        begin
          panic('expected first-person state');
        end;
      end if;
    end;
  else
    begin
      panic('expected first-person server state');
    end;
  end if;

  if DecodeClient(EncodeClient(ClientMessage.ExplorationMap(-20, 30, 40, 12))).Unwrap() is ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height) then
    begin
      AssertEquals(-20, OriginX);
      AssertEquals(30, OriginY);
      AssertEquals(40, Width);
      AssertEquals(12, Height);
    end;
  else
    begin
      panic('expected exploration-map request');
    end;
  end if;
  const ExplorationValue: ExplorationMapState := ExplorationMapState(View := ViewKind.Map, LabelText := 'Outdoor region', OriginX := 9, OriginY := 20, Width := 3, Height := 1, Rows := [
                                                                                                                                                                                          '?go'
                                                                                                                                                                                        ], KnowledgeRows := [
                                                                                                                                                                                                              'urv'
                                                                                                                                                                                                            ], PlayerWorldX := 11, PlayerWorldY := 20, PlayerInWindow := true);
  if DecodeServer(EncodeServer(ServerMessage.ExplorationMap(ExplorationValue))).Unwrap() is ServerMessage.ExplorationMap(const Value) then
    begin
      AssertTrue(Value.View = ViewKind.Map);
      AssertEquals('Outdoor region', Value.LabelText);
      AssertEquals('?go', Value.Rows[0]);
      AssertEquals('urv', Value.KnowledgeRows[0]);
      AssertTrue(Value.PlayerInWindow);
    end;
  else
    begin
      panic('expected exploration-map response');
    end;
  end if;

  AssertTrue(DecodeClient('{"type":"move","dx":0.5,"dy":0}').IsError());
  // Numbers beyond the integer range are rejected instead of raising a runtime error.
  AssertTrue(DecodeClient('{"type":"move","dx":1e300,"dy":0}').IsError());
  AssertTrue(DecodeClient('{"type":"move","dx":-1e300,"dy":0}').IsError());
  AssertTrue(DecodeClient('{"type":"hello","version":5,"width":80,"height":24,"extra":1}').IsError());
  AssertTrue(DecodeClient('{"type":"new_game","extra":1}').IsError());
  AssertTrue(DecodeClient('{"type":"new_game","type":"new_game"}').IsError());
  AssertTrue(DecodeClient('{"type":"load_game","extra":1}').IsError());
  AssertTrue(DecodeClient('{"type":"load_game","type":"load_game"}').IsError());
  AssertTrue(DecodeClient('{"type":"save_game","extra":1}').IsError());
  AssertTrue(DecodeClient('{"type":"save_game","type":"save_game"}').IsError());
  AssertTrue(DecodeClient('{"type":"disconnect","extra":1}').IsError());
  AssertTrue(DecodeClient('{"type":"viewport","width":1.5,"height":2}').IsError());
  AssertTrue(DecodeClient('{"type":"viewport","width":2,"height":2,"extra":1}').IsError());
  AssertTrue(DecodeClient('{"type":"exploration_map","origin_x":0,"origin_y":0,"width":0,"height":2}')
               .IsError());
  AssertTrue(DecodeClient('{"type":"exploration_map","origin_x":0,"origin_y":0,"width":241,"height":2}')
               .IsError());
  AssertTrue(DecodeClient('{"type":"exploration_map","origin_x":1000000001,"origin_y":0,"width":2,"height":2}')
               .IsError());
  AssertTrue(DecodeClient('{"type":"exploration_map","origin_x":0,"origin_y":0,"width":2,"height":2,"extra":1}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"exploration_map","view":"map","label":"Area","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["gg"],"knowledge_rows":["uv"],"player_world_x":1,"player_world_y":0,"player_in_window":true}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"exploration_map","view":"map","label":"Area","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["?g"],"knowledge_rows":["uv"],"player_world_x":2,"player_world_y":0,"player_in_window":true}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["gg"],"knowledge_rows":["uv"],"x":1,"y":0,"world_x":1,"world_y":0}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["?g"],"knowledge_rows":["u"],"x":1,"y":0,"world_x":1,"world_y":0}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["?g"],"knowledge_rows":["uv"],"knowledge_rows":["uv"],"x":1,"y":0,"world_x":1,"world_y":0}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["ggg"],"x":0,"y":0,"world_x":0,"world_y":0}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["gx"],"x":0,"y":0,"world_x":0,"world_y":0}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"state","view":"map","origin_x":10,"origin_y":20,"width":2,"height":1,"rows":["gg"],"x":0,"y":0,"world_x":11,"world_y":20}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"state","view":"first_person","title":"","status":"Return","width":5,"height":3,"rows":["#####","#.x.#","#####"],"x":1,"y":1,"facing":"north"}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"state","view":"first_person","title":"Dungeon"}').IsError());
  AssertTrue(DecodeServer('{"type":"state","view":"first_person","title":"Dungeon","status":"Return","width":5,"height":3,"rows":["#####","#.x.#","####"],"x":1,"y":1,"facing":"north"}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"state","view":"first_person","title":"Dungeon","status":"Return","width":5,"height":3,"rows":["#####","#xx.#","#####"],"x":3,"y":1,"facing":"north"}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"state","view":"first_person","title":"Dungeon","status":"Return","width":5,"height":3,"rows":["#####","#.x.#","#####"],"x":0,"y":0,"facing":"north"}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"state","view":"first_person","title":"Dungeon","status":"Return","width":5,"height":3,"rows":["#####","#.x.#","#####"],"x":1,"y":1,"facing":"up"}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"state","view":"first_person","title":"Dungeon","status":"Return","width":5,"height":3,"rows":["#####","#.x.#","#####"],"x":1,"y":1,"facing":"north","extra":1}')
               .IsError());
  AssertTrue(DecodeClient('{"type":"first_person_step","direction":"diagonal"}').IsError());
  AssertTrue(DecodeClient('{"type":"first_person_step","direction":"forward","extra":1}').IsError());
  AssertTrue(DecodeClient('{"type":"first_person_turn","direction":"around"}').IsError());
  AssertTrue(DecodeClient('{"type":"interact","extra":1}').IsError());
  AssertTrue(DecodeServer('{"type":"interaction","title":"Coin","message":""}').IsError());
  AssertTrue(DecodeServer('{"type":"interaction","title":"Coin","message":"x","extra":1}').IsError());
  AssertTrue(DecodeServer('{"type":"interaction","title":42,"message":"x"}').IsError());
  AssertTrue(DecodeServer('{"type":"interaction","message":"x"}').IsError());
  AssertTrue(DecodeServer('{"type":"welcome","version":5,"save_available":"yes","invalid_save_removed":false}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"welcome","version":5,"save_available":false}').IsError());
  AssertTrue(DecodeServer('{"type":"welcome","version":5,"save_available":false,"invalid_save_removed":false,"extra":1}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"welcome","version":5,"save_available":false,"invalid_save_removed":false,"invalid_save_removed":false}')
               .IsError());
  AssertTrue(DecodeServer('{"type":"save_completed","extra":1}').IsError());
  AssertTrue(DecodeServer('{"type":"save_completed","type":"save_completed"}').IsError());
  AssertTrue(DecodeServer('{"type":"rejected","code":"x","message":"x","extra":1}').IsError());
  AssertTrue(DecodeClient('{}').IsError());
  AssertTrue(DecodeClient('{"type":2}').IsError());
  AssertTrue(DecodeServer('{"type":"unknown"}').IsError());
end.
