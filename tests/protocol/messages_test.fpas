// Verifies protocol round trips and malformed-message rejection.
program DungeonProtocolMessagesTest;

uses Dungeon.Test.Catalog as CatalogUnit, Dungeon.Protocol as Protocol, Dungeon.Protocol.ClientMessages as ClientMessages, Dungeon.Protocol.ServerMessages as ServerMessages, Std.Conv as Conv, Std.Test as Test;

begin
  case ClientMessages.DecodeClient(
    ClientMessages.EncodeClient(Protocol.ClientMessage.Hello(Protocol.ProtocolVersion, 80, 24))
  ).Unwrap() of
    when Protocol.ClientMessage.Hello(const Version, const Width, const Height):
      Test.AssertEquals(Protocol.ProtocolVersion, Version);
      Test.AssertEquals(80, Width);
      Test.AssertEquals(24, Height);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected hello message');
  end case;

  if ClientMessages.DecodeClient(
    ClientMessages.EncodeClient(Protocol.ClientMessage.StartNewGame)
  ).Unwrap() is Protocol.ClientMessage.StartNewGame
  then
    begin
      null;
    end;
  else
    begin
      panic('expected new-game message');
    end;
  end if;

  if ClientMessages.DecodeClient(
    ClientMessages.EncodeClient(Protocol.ClientMessage.LoadGame)
  ).Unwrap() is Protocol.ClientMessage.LoadGame
  then
    begin
      null;
    end;
  else
    begin
      panic('expected load-game message');
    end;
  end if;

  if ClientMessages.DecodeClient(
    ClientMessages.EncodeClient(Protocol.ClientMessage.SaveGame)
  ).Unwrap() is Protocol.ClientMessage.SaveGame
  then
    begin
      null;
    end;
  else
    begin
      panic('expected save-game message');
    end;
  end if;

  case ServerMessages.DecodeServer(
    ServerMessages.EncodeServer(
      Protocol.ServerMessage.Welcome(
        Protocol.ProtocolVersion,
        CatalogUnit.FixtureCatalog(true, false)
      )
    )
  ).Unwrap() of
    when Protocol.ServerMessage.Welcome(const Version, const Catalog):
      Test.AssertEquals(Protocol.ProtocolVersion, Version);
      Test.AssertTrue(CatalogUnit.FixtureSaveAvailable(Catalog));
      Test.AssertFalse(CatalogUnit.FixtureInvalidSave(Catalog));
    when Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
      panic('expected welcome message');
  end case;

  if ServerMessages.DecodeServer(
    ServerMessages.EncodeServer(Protocol.ServerMessage.SaveCompleted)
  ).Unwrap() is Protocol.ServerMessage.SaveCompleted
  then
    begin
      null;
    end;
  else
    begin
      panic('expected save-completed message');
    end;
  end if;

  case ClientMessages.DecodeClient(
    ClientMessages.EncodeClient(Protocol.ClientMessage.Viewport(120, 40))
  ).Unwrap() of
    when Protocol.ClientMessage.Viewport(const Width, const Height):
      Test.AssertEquals(120, Width);
      Test.AssertEquals(40, Height);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected viewport message');
  end case;
  const EncodedMove: string := ClientMessages.EncodeClient(Protocol.ClientMessage.Move(-1, 0));
  case ClientMessages.DecodeClient(EncodedMove).Unwrap() of
    when Protocol.ClientMessage.Move(const DeltaX, const DeltaY):
      Test.AssertEquals(-1, DeltaX);
      Test.AssertEquals(0, DeltaY);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected move message');
  end case;

  case ClientMessages.DecodeClient(
    ClientMessages.EncodeClient(
      Protocol.ClientMessage.StepFirstPerson(Protocol.FirstPersonStepDirection.Left)
    )
  ).Unwrap() of
    when Protocol.ClientMessage.StepFirstPerson(const Direction):
      Test.AssertTrue(Direction = Protocol.FirstPersonStepDirection.Left);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected first-person step message');
  end case;

  case ClientMessages.DecodeClient(
    ClientMessages.EncodeClient(
      Protocol.ClientMessage.StepFirstPerson(Protocol.FirstPersonStepDirection.Forward)
    )
  ).Unwrap() of
    when Protocol.ClientMessage.StepFirstPerson(const Direction):
      Test.AssertTrue(Direction = Protocol.FirstPersonStepDirection.Forward);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected forward first-person step message');
  end case;

  case ClientMessages.DecodeClient(
    ClientMessages.EncodeClient(
      Protocol.ClientMessage.StepFirstPerson(Protocol.FirstPersonStepDirection.Backward)
    )
  ).Unwrap() of
    when Protocol.ClientMessage.StepFirstPerson(const Direction):
      Test.AssertTrue(Direction = Protocol.FirstPersonStepDirection.Backward);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected backward first-person step message');
  end case;

  case ClientMessages.DecodeClient(
    ClientMessages.EncodeClient(
      Protocol.ClientMessage.StepFirstPerson(Protocol.FirstPersonStepDirection.Right)
    )
  ).Unwrap() of
    when Protocol.ClientMessage.StepFirstPerson(const Direction):
      Test.AssertTrue(Direction = Protocol.FirstPersonStepDirection.Right);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected right first-person step message');
  end case;

  case ClientMessages.DecodeClient(
    ClientMessages.EncodeClient(
      Protocol.ClientMessage.TurnFirstPerson(Protocol.FirstPersonTurnDirection.Right)
    )
  ).Unwrap() of
    when Protocol.ClientMessage.TurnFirstPerson(const Direction):
      Test.AssertTrue(Direction = Protocol.FirstPersonTurnDirection.Right);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected first-person turn message');
  end case;

  case ClientMessages.DecodeClient(
    ClientMessages.EncodeClient(
      Protocol.ClientMessage.TurnFirstPerson(Protocol.FirstPersonTurnDirection.Left)
    )
  ).Unwrap() of
    when Protocol.ClientMessage.TurnFirstPerson(const Direction):
      Test.AssertTrue(Direction = Protocol.FirstPersonTurnDirection.Left);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected left first-person turn message');
  end case;

  if ClientMessages.DecodeClient(
    ClientMessages.EncodeClient(Protocol.ClientMessage.Interact)
  ).Unwrap() is Protocol.ClientMessage.Interact
  then
    begin
      null;
    end;
  else
    begin
      panic('expected interaction intention');
    end;
  end if;

  case ServerMessages.DecodeServer(
    ServerMessages.EncodeServer(
      Protocol.ServerMessage.Interaction('Ancient coin', 'A tarnished coin.')
    )
  ).Unwrap() of
    when Protocol.ServerMessage.Interaction(const Title, const Message):
      Test.AssertEquals('Ancient coin', Title);
      Test.AssertEquals('A tarnished coin.', Message);
    when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
      panic('expected interaction result');
  end case;
  const MapValue: Protocol.MapVisibleState := Protocol.MapVisibleState(
    OriginX := -12, OriginY := 7, Width := 5, Height := 2, Rows := [
      'otfdm',
      'gplrg'
    ], KnowledgeRows := [
      'vvvvv',
      'vvvvv'
    ], PlayerX := 2, PlayerY := 1, WorldX := -10, WorldY := 8, Inventory := [
      Protocol.VisibleInventoryItem(
        Id := 'example:dungeon:0:0:item:0',
        Name := 'Ancient coin',
        Slot := Protocol.VisibleItemSlot.NoSlot,
        Equipped := false, Usable := false
      )
    ], Health := 17, MaxHealth := 20, Character := [], Journal := []
  );
  const StateValue: Protocol.VisibleState := Protocol.VisibleState.MapState(MapValue);
  const EncodedMapState: string := ServerMessages.EncodeServer(
    Protocol.ServerMessage.State(StateValue)
  );
  Test.AssertFalse('chunk_x' in EncodedMapState);
  Test.AssertFalse('outdoor_chunks' in EncodedMapState);
  Test.AssertFalse('save' in EncodedMapState);
  case ServerMessages.DecodeServer(EncodedMapState).Unwrap() of
    when Protocol.ServerMessage.State(const DecodedState):
      Test.AssertTrue(Protocol.ViewForVisibleState(DecodedState) = Protocol.ViewKind.Map);
      case DecodedState of
        when Protocol.VisibleState.MapState(const DecodedMap):
          Test.AssertEquals(5, DecodedMap.Width);
          Test.AssertEquals(2, DecodedMap.Height);
          Test.AssertEquals('gplrg', DecodedMap.Rows[1]);
          Test.AssertEquals('vvvvv', DecodedMap.KnowledgeRows[1]);
          Test.AssertEquals(2, DecodedMap.PlayerX);
          Test.AssertEquals(1, DecodedMap.PlayerY);
          Test.AssertEquals(-12, DecodedMap.OriginX);
          Test.AssertEquals(7, DecodedMap.OriginY);
          Test.AssertEquals(-10, DecodedMap.WorldX);
          Test.AssertEquals(8, DecodedMap.WorldY);
          Test.AssertEquals(1, DecodedMap.Inventory.Length());
          Test.AssertEquals('example:dungeon:0:0:item:0', DecodedMap.Inventory[0].Id);
          Test.AssertEquals('Ancient coin', DecodedMap.Inventory[0].Name);
        when Protocol.VisibleState.FirstPersonState(_):
          panic('expected map state');
      end case;
    when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
      panic('expected state message');
  end case;
  const EncodedInventory: string := '"inventory":[{"id":"example:dungeon:0:0:item:0","name":"Ancient coin","slot":"","equipped":false,"usable":false}]';
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(EncodedMapState.Replace(EncodedInventory, '"inventory":42')) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(EncodedMapState.Replace(EncodedInventory, '"inventory":[42]')) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        EncodedMapState.Replace(EncodedInventory, '"inventory":[{"id":"coin"}]')
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        EncodedMapState.Replace(
          EncodedInventory,
          '"inventory":[{"id":"coin","name":"Coin","extra":1}]'
        )
      ) is Error(_)
    )
  );
  var InvalidInventoryMap: Protocol.MapVisibleState := MapValue;
  InvalidInventoryMap.Inventory := [
    Protocol.VisibleInventoryItem(
      Id := '',
      Name := 'Ancient coin',
      Slot := Protocol.VisibleItemSlot.NoSlot,
      Equipped := false, Usable := false
    )
  ];
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        ServerMessages.EncodeServer(
          Protocol.ServerMessage.State(Protocol.VisibleState.MapState(InvalidInventoryMap))
        )
      ) is Error(_)
    )
  );
  InvalidInventoryMap.Inventory := [
    Protocol.VisibleInventoryItem(
      Id := 'coin',
      Name := '',
      Slot := Protocol.VisibleItemSlot.NoSlot,
      Equipped := false, Usable := false
    )
  ];
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        ServerMessages.EncodeServer(
          Protocol.ServerMessage.State(Protocol.VisibleState.MapState(InvalidInventoryMap))
        )
      ) is Error(_)
    )
  );
  InvalidInventoryMap.Inventory := [
    Protocol.VisibleInventoryItem(
      Id := 'coin',
      Name := 'Coin',
      Slot := Protocol.VisibleItemSlot.NoSlot,
      Equipped := false, Usable := false
    ),
    Protocol.VisibleInventoryItem(
      Id := 'coin',
      Name := 'Duplicate',
      Slot := Protocol.VisibleItemSlot.NoSlot,
      Equipped := false, Usable := false
    )
  ];
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        ServerMessages.EncodeServer(
          Protocol.ServerMessage.State(Protocol.VisibleState.MapState(InvalidInventoryMap))
        )
      ) is Error(_)
    )
  );
  InvalidInventoryMap.Inventory := [
    Protocol.VisibleInventoryItem(
      Id := 'x'.RepeatStr(Protocol.MaximumVisibleInventoryTextLength + 1),
      Name := 'Too long',
      Slot := Protocol.VisibleItemSlot.NoSlot,
      Equipped := false, Usable := false
    )
  ];
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        ServerMessages.EncodeServer(
          Protocol.ServerMessage.State(Protocol.VisibleState.MapState(InvalidInventoryMap))
        )
      ) is Error(_)
    )
  );
  var MaximumInventory: array of Protocol.VisibleInventoryItem := [];
  for Index: integer := 0 to Protocol.MaximumVisibleInventoryItems - 1 do
    begin
      MaximumInventory.PushInPlace(
        Protocol.VisibleInventoryItem(
          Id := 'item-' + Conv.IntToStr(Index), Name := 'Item ' +
          Conv.IntToStr(Index), Slot := Protocol.VisibleItemSlot.NoSlot, Equipped := false,
          Usable := false
        )
      );
    end;
  end for;

  InvalidInventoryMap.Inventory := MaximumInventory;
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        ServerMessages.EncodeServer(
          Protocol.ServerMessage.State(Protocol.VisibleState.MapState(InvalidInventoryMap))
        )
      ) is Ok(_)
    )
  );
  MaximumInventory.PushInPlace(
    Protocol.VisibleInventoryItem(
      Id := 'one-too-many',
      Name := 'One too many',
      Slot := Protocol.VisibleItemSlot.NoSlot,
      Equipped := false, Usable := false
    )
  );
  InvalidInventoryMap.Inventory := MaximumInventory;
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        ServerMessages.EncodeServer(
          Protocol.ServerMessage.State(Protocol.VisibleState.MapState(InvalidInventoryMap))
        )
      ) is Error(_)
    )
  );
  const FirstPersonValue: Protocol.FirstPersonVisibleState := Protocol.FirstPersonVisibleState(
    Title := 'Initial dungeon', Status := 'Find the exit.', Level := 0, Depth := 1, Width := 5,
    Height := 3, Rows := [
      '#####',
      '#ix.#',
      '#####'
    ], KnowledgeRows := [
      'vvvvv',
      'vvvvv',
      'vvvvv'
    ], PlayerX := 1, PlayerY := 1, Facing := Protocol.FirstPersonFacing.West, Inventory := [],
    Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := [],
    Journal := []
  );
  const EncodedFirstPerson: string := ServerMessages.EncodeServer(
    Protocol.ServerMessage.State(Protocol.VisibleState.FirstPersonState(FirstPersonValue))
  );
  Test.AssertFalse('area_id' in EncodedFirstPerson);
  Test.AssertFalse('return_location' in EncodedFirstPerson);
  case ServerMessages.DecodeServer(EncodedFirstPerson).Unwrap() of
    when Protocol.ServerMessage.State(const DecodedFirstPerson):
      Test.AssertTrue(
        Protocol.ViewForVisibleState(DecodedFirstPerson) = Protocol.ViewKind.FirstPerson
      );
      case DecodedFirstPerson of
        when Protocol.VisibleState.FirstPersonState(const Value):
          Test.AssertEquals('Initial dungeon', Value.Title);
          Test.AssertEquals('Find the exit.', Value.Status);
          Test.AssertEquals(5, Value.Width);
          Test.AssertEquals(3, Value.Height);
          Test.AssertEquals('#ix.#', Value.Rows[1]);
          Test.AssertEquals('vvvvv', Value.KnowledgeRows[1]);
          Test.AssertEquals(1, Value.PlayerX);
          Test.AssertEquals(1, Value.PlayerY);
          Test.AssertTrue(Value.Facing = Protocol.FirstPersonFacing.West);
        when Protocol.VisibleState.MapState(_):
          panic('expected first-person state');
      end case;
    when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
      panic('expected first-person server state');
  end case;

  case ClientMessages.DecodeClient(
    ClientMessages.EncodeClient(Protocol.ClientMessage.ExplorationMap(-20, 30, 40, 12))
  ).Unwrap() of
    when Protocol.ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height):
      Test.AssertEquals(-20, OriginX);
      Test.AssertEquals(30, OriginY);
      Test.AssertEquals(40, Width);
      Test.AssertEquals(12, Height);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected exploration-map request');
  end case;
  const ExplorationValue: Protocol.ExplorationMapState := Protocol.ExplorationMapState(
    View := Protocol.ViewKind.Map, LabelText := 'Outdoor region', OriginX := 9, OriginY := 20,
    Width := 3, Height := 1, Rows := [
      '?go'
    ], KnowledgeRows := [
      'urv'
    ], PlayerWorldX := 11, PlayerWorldY := 20, PlayerInWindow := true
  );
  case ServerMessages.DecodeServer(
    ServerMessages.EncodeServer(Protocol.ServerMessage.ExplorationMap(ExplorationValue))
  ).Unwrap() of
    when Protocol.ServerMessage.ExplorationMap(const Value):
      Test.AssertTrue(Value.View = Protocol.ViewKind.Map);
      Test.AssertEquals('Outdoor region', Value.LabelText);
      Test.AssertEquals('?go', Value.Rows[0]);
      Test.AssertEquals('urv', Value.KnowledgeRows[0]);
      Test.AssertTrue(Value.PlayerInWindow);
    when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
      panic('expected exploration-map response');
  end case;

  Test.AssertTrue(ClientMessages.DecodeClient('{"type":"move","dx":0.5,"dy":0}') is Error(_));
  // Numbers beyond the integer range are rejected instead of raising a runtime error.
  Test.AssertTrue(ClientMessages.DecodeClient('{"type":"move","dx":1e300,"dy":0}') is Error(_));
  Test.AssertTrue(ClientMessages.DecodeClient('{"type":"move","dx":-1e300,"dy":0}') is Error(_));
  Test.AssertTrue(
    (
      ClientMessages.DecodeClient('{"type":"hello","version":5,"width":80,"height":24,"extra":1}') is Error(_)
    )
  );
  Test.AssertTrue(ClientMessages.DecodeClient('{"type":"new_game","extra":1}') is Error(_));
  Test.AssertTrue(
    (ClientMessages.DecodeClient('{"type":"new_game","type":"new_game"}') is Error(_))
  );
  Test.AssertTrue(ClientMessages.DecodeClient('{"type":"load_game","extra":1}') is Error(_));
  Test.AssertTrue(
    (ClientMessages.DecodeClient('{"type":"load_game","type":"load_game"}') is Error(_))
  );
  Test.AssertTrue(ClientMessages.DecodeClient('{"type":"save_game","extra":1}') is Error(_));
  Test.AssertTrue(
    (ClientMessages.DecodeClient('{"type":"save_game","type":"save_game"}') is Error(_))
  );
  Test.AssertTrue(ClientMessages.DecodeClient('{"type":"disconnect","extra":1}') is Error(_));
  Test.AssertTrue(
    (ClientMessages.DecodeClient('{"type":"viewport","width":1.5,"height":2}') is Error(_))
  );
  Test.AssertTrue(
    (ClientMessages.DecodeClient('{"type":"viewport","width":2,"height":2,"extra":1}') is Error(_))
  );
  Test.AssertTrue(
    (
      ClientMessages.DecodeClient(
        '{"type":"exploration_map","origin_x":0,"origin_y":0,"width":0,"height":2}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ClientMessages.DecodeClient(
        '{"type":"exploration_map","origin_x":0,"origin_y":0,"width":241,"height":2}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ClientMessages.DecodeClient(
        '{"type":"exploration_map","origin_x":1000000001,"origin_y":0,"width":2,"height":2}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ClientMessages.DecodeClient(
        '{"type":"exploration_map","origin_x":0,"origin_y":0,"width":2,"height":2,"extra":1}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"exploration_map","view":"map","label":"Area","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["gg"],"knowledge_rows":["uv"],"player_world_x":1,"player_world_y":0,"player_in_window":true}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"exploration_map","view":"map","label":"Area","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["?g"],"knowledge_rows":["uv"],"player_world_x":2,"player_world_y":0,"player_in_window":true}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["gg"],"knowledge_rows":["uv"],"x":1,"y":0,"world_x":1,"world_y":0}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["?g"],"knowledge_rows":["u"],"x":1,"y":0,"world_x":1,"world_y":0}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["?g"],"knowledge_rows":["uv"],"knowledge_rows":["uv"],"x":1,"y":0,"world_x":1,"world_y":0}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["ggg"],"x":0,"y":0,"world_x":0,"world_y":0}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"state","view":"map","origin_x":0,"origin_y":0,"width":2,"height":1,"rows":["gx"],"x":0,"y":0,"world_x":0,"world_y":0}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"state","view":"map","origin_x":10,"origin_y":20,"width":2,"height":1,"rows":["gg"],"x":0,"y":0,"world_x":11,"world_y":20}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"state","view":"first_person","title":"","status":"Return","width":5,"height":3,"rows":["#####","#.x.#","#####"],"x":1,"y":1,"facing":"north"}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer('{"type":"state","view":"first_person","title":"Dungeon"}') is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"state","view":"first_person","title":"Dungeon","status":"Return","width":5,"height":3,"rows":["#####","#.x.#","####"],"x":1,"y":1,"facing":"north"}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"state","view":"first_person","title":"Dungeon","status":"Return","width":5,"height":3,"rows":["#####","#xx.#","#####"],"x":3,"y":1,"facing":"north"}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"state","view":"first_person","title":"Dungeon","status":"Return","width":5,"height":3,"rows":["#####","#.x.#","#####"],"x":0,"y":0,"facing":"north"}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"state","view":"first_person","title":"Dungeon","status":"Return","width":5,"height":3,"rows":["#####","#.x.#","#####"],"x":1,"y":1,"facing":"up"}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"state","view":"first_person","title":"Dungeon","status":"Return","width":5,"height":3,"rows":["#####","#.x.#","#####"],"x":1,"y":1,"facing":"north","extra":1}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ClientMessages.DecodeClient('{"type":"first_person_step","direction":"diagonal"}') is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ClientMessages.DecodeClient('{"type":"first_person_step","direction":"forward","extra":1}') is Error(_)
    )
  );
  Test.AssertTrue(
    (ClientMessages.DecodeClient('{"type":"first_person_turn","direction":"around"}') is Error(_))
  );
  Test.AssertTrue(ClientMessages.DecodeClient('{"type":"interact","extra":1}') is Error(_));
  Test.AssertTrue(
    (ServerMessages.DecodeServer('{"type":"interaction","title":"Coin","message":""}') is Error(_))
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer('{"type":"interaction","title":"Coin","message":"x","extra":1}') is Error(_)
    )
  );
  Test.AssertTrue(
    (ServerMessages.DecodeServer('{"type":"interaction","title":42,"message":"x"}') is Error(_))
  );
  Test.AssertTrue(
    (ServerMessages.DecodeServer('{"type":"interaction","message":"x"}') is Error(_))
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"welcome","version":5,"save_available":"yes","invalid_save_removed":false}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer('{"type":"welcome","version":5,"save_available":false}') is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"welcome","version":5,"save_available":false,"invalid_save_removed":false,"extra":1}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer(
        '{"type":"welcome","version":5,"save_available":false,"invalid_save_removed":false,"invalid_save_removed":false}'
      ) is Error(_)
    )
  );
  Test.AssertTrue(ServerMessages.DecodeServer('{"type":"save_completed","extra":1}') is Error(_));
  Test.AssertTrue(
    (ServerMessages.DecodeServer('{"type":"save_completed","type":"save_completed"}') is Error(_))
  );
  Test.AssertTrue(
    (
      ServerMessages.DecodeServer('{"type":"rejected","code":"x","message":"x","extra":1}') is Error(_)
    )
  );
  Test.AssertTrue(ClientMessages.DecodeClient('{}') is Error(_));
  Test.AssertTrue(ClientMessages.DecodeClient('{"type":2}') is Error(_));
  Test.AssertTrue(ServerMessages.DecodeServer('{"type":"unknown"}') is Error(_));
end.
