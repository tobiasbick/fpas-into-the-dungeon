// Verifies settlement map codes round-trip and NPC markers cannot leak into remembered fields.
program SettlementCellsProtocolTest;

uses Dungeon.Protocol as Protocol, Dungeon.Protocol.ServerMessages as Messages, Std.Test as Test;

function Encoded(Value: Protocol.MapVisibleState): string;
begin
  return Messages.EncodeServer(Protocol.ServerMessage.State(Protocol.VisibleState.MapState(Value)));
end function;

begin
  const Value := Protocol.MapVisibleState(
    Time := Protocol.VisibleTime(Day := 1, MinuteOfDay := 480, Phase := Protocol.DayPhase.Day),
    Coins := 0,
    OriginX := 0, OriginY := 0, Width := 3, Height := 1,
    Rows := ['.nx'], KnowledgeRows := ['vvv'], PlayerX := 0, PlayerY := 0, WorldX := 0, WorldY := 0,
    Inventory := [], Health := 20, MaxHealth := 20, Character := [], Journal := []
  );
  const Decoded := Messages.DecodeServer(Encoded(Value)).Unwrap();
  Test.AssertTrue(Decoded is Protocol.ServerMessage.State(Protocol.VisibleState.MapState(_)));
  Test.AssertTrue(
    Messages.DecodeServer(Encoded(Value with Rows := ['.#x']; KnowledgeRows := ['vrr']; end with)) is Ok(_)
  );
  for Knowledge: string in ['vrv', 'vuv'] do
    case Messages.DecodeServer(Encoded(Value with KnowledgeRows := [Knowledge]; end with)) of
      when Error(const Reason):
        Test.AssertTrue('NPC' in Reason);
      when Ok(_):
        panic('NPC must not be remembered or undiscovered');
    end case;
  end for;
end.
