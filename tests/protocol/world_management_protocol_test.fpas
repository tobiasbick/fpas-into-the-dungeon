// Positive, malformed and boundary coverage for versioned world catalogs and lifecycle intentions.
program WorldManagementProtocolTest;

uses
  Dungeon.Protocol, Dungeon.Protocol.ClientMessages, Dungeon.Protocol.ServerMessages,
  Dungeon.Protocol.Worlds, Dungeon.Test.Catalog, Std.Conv, Std.Test;

function CatalogRoundTrip(Value: WorldCatalog): WorldCatalog;
begin
  if DecodeServer(EncodeServer(ServerMessage.Worlds(Value))).Unwrap() is ServerMessage.Worlds(const Catalog) then
    begin
      return Catalog;
    end;
  else
    begin
      panic('expected catalog');
    end;
  end if;
end function;

begin
  for Message: ClientMessage in [
                                  ClientMessage.ListWorlds(0, false),
                                  ClientMessage.ListWorlds(1000000, true),
                                  ClientMessage.SelectWorld('world-1'),
                                  ClientMessage.CreateWorld(-2147483648, 1),
                                  ClientMessage.CreateWorld(2147483647, 16),
                                  ClientMessage.OverwriteSaveGame
                                ] do
    AssertTrue(Message = DecodeClient(EncodeClient(Message)).Unwrap());
  end for;

  for Text: string in [
                        '{"type":"list_worlds","offset":-1,"discard":false}',
                        '{"type":"list_worlds","offset":1000001,"discard":false}',
                        '{"type":"list_worlds","offset":0,"discard":"yes"}',
                        '{"type":"list_worlds","offset":0}',
                        '{"type":"overwrite_save","extra":1}',
                        '{"type":"select_world","id":"../outside"}',
                        '{"type":"select_world","id":""}',
                        '{"type":"create_world","seed":2147483648,"region_chunks":4}',
                        '{"type":"create_world","seed":1,"region_chunks":0}',
                        '{"type":"create_world","seed":1,"region_chunks":17}',
                        '{"type":"create_world","seed":1.5,"region_chunks":4}',
                        '{"type":"create_world","seed":"1","region_chunks":4}',
                        '{"type":"create_world","seed":1,"seed":2,"region_chunks":4}'
                      ] do
    AssertTrue(DecodeClient(Text).IsError());
  end for;
  const Empty: WorldCatalog := CatalogRoundTrip(EmptyWorldCatalog(0, 1));
  AssertEquals(0, Empty.Total);
  AssertFalse(CanContinueWorld(Empty));
  AssertFalse(CatalogHasSave(Empty));
  const Fixture: WorldCatalog := FixtureCatalog(false, false);
  AssertTrue(CanContinueWorld(Fixture));
  AssertFalse(CatalogHasSave(Fixture));
  AssertFalse(CanContinueWorld(FixtureCatalog(false, true)));
  AssertTrue(CatalogHasSave(FixtureCatalog(false, true)));
  // Original worlds can retain all signed 64-bit seed values even though new seeds are bounded.
  var Worlds: array of WorldSummary := [];
  for Index: integer := 0 to MaximumWorldsPerPage - 1 do
    Worlds.Push(WorldSummary(Id := 'world-' + IntToStr(Index), Seed := 9223372036854775807, RegionChunks := 16, Status := 'ready', SaveStatus := 'available', Reason := 'x'
                                                                                                                                                                          .RepeatStr(256)));
  end for;
  const Full: WorldCatalog := EmptyWorldCatalog(-2147483648, 16) with Worlds := Worlds; Total := 64; SelectedId := 'world-0'; end with;
  const Decoded: WorldCatalog := CatalogRoundTrip(Full);
  AssertEquals(64, Decoded.Worlds.Length());
  AssertEquals(9223372036854775807, Decoded.Worlds[0].Seed);
  AssertEquals(256, Decoded.Worlds[63].Reason.Length());
  Worlds.Push(Worlds[0] with Id := 'overflow'; end with);
  AssertTrue(DecodeServer(EncodeServer(ServerMessage.Worlds(Full with Worlds := Worlds; Total := 65; end with)))
               .IsError());
  for Invalid: WorldCatalog in [
                                 Full with Offset := -1; end with,
                                 Full with Total := 63; end with,
                                 Full with DefaultSeed := 2147483648; end with,
                                 Full with DefaultRegionChunks := 0; end with,
                                 Full with SelectedId := '../invalid'; end with,
                                 Full with SelectionReason := 'x'.RepeatStr(257); end with
                               ] do
    AssertTrue(DecodeServer(EncodeServer(ServerMessage.Worlds(Invalid))).IsError());
  end for;
  const Wire: string := EncodeServer(ServerMessage.Worlds(Fixture));
  for Bad: string in [
                       Wire.Replace('"seed":"12345"', '"seed":12345'),
                       Wire.Replace('"seed":"12345"', '"seed":"+12345"'),
                       Wire.Replace('"seed":"12345"', '"seed":"9223372036854775808"'),
                       Wire.Replace('"status":"ready"', '"status":"unknown"'),
                       Wire.Replace('"save_status":"missing"', '"save_status":"unknown"'),
                       Wire.Replace('"status":"ready"', '"status":"ready","extra":1'),
                       Wire.Replace('"status":"ready"', '"status":"ready","status":"ready"'),
                       Wire.Replace('"total":1', '"total":"1"'),
                       Wire.Replace('"total":1', '"total":1,"extra":1')
                     ] do
    AssertTrue(DecodeServer(Bad).IsError());
  end for;

  AssertTrue(ValidateWorldCatalog(Fixture with Worlds := [Fixture.Worlds[0], Fixture.Worlds[0]]; Total := 2; end with)
               .IsError());
  var Escaped: array of WorldSummary := [];
  for Entry: WorldSummary in Full.Worlds do
    Escaped.Push(Entry with Reason := string.Chr(1).RepeatStr(256); end with);
  end for;

  AssertTrue(ValidateWorldCatalog(Full with Worlds := Escaped; end with).IsError());
  AssertTrue(ParseWorldInteger('9223372036854775808').IsError());
  AssertTrue(ParseWorldInteger('abc').IsError());
end.
