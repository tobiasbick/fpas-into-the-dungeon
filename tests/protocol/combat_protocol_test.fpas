// Verifies combat messages, health and combat-log bounds, and the opponent code.
program CombatProtocolTest;

uses Dungeon.Protocol, Dungeon.Protocol.ClientMessages, Dungeon.Protocol.ServerMessages, Std.Test;

function Corridor(Rows: array of string; Health: integer; MaxHealth: integer; Log: array of string): FirstPersonVisibleState;
begin
  return FirstPersonVisibleState(Title := 'Initial dungeon', Status := 'Restless skeleton 12/12 — Space: Attack', Width := 5, Height := 3, Rows := Rows, KnowledgeRows := [
                                                                                                                                                                            'vvvvv',
                                                                                                                                                                            'vvvvv',
                                                                                                                                                                            'vvvvv'
                                                                                                                                                                          ], PlayerX := 3, PlayerY := 1, Facing := FirstPersonFacing.West, Inventory := [], Health := Health, MaxHealth := MaxHealth, Character := [], CombatLog := Log, CombatEvents := []);
end function;

function Encoded(Value: FirstPersonVisibleState): string;
begin
  return EncodeServer(ServerMessage.State(VisibleState.FirstPersonState(Value)));
end function;

begin
  AssertEquals(14, ProtocolVersion);
  AssertEquals('{"type":"attack"}', EncodeClient(ClientMessage.Attack));
  AssertEquals('{"type":"wait"}', EncodeClient(ClientMessage.Wait));
  if DecodeClient('{"type":"attack"}').Unwrap() is ClientMessage.Attack then
    begin
      null;
    end;
  else
    begin
      panic('expected attack');
    end;
  end if;

  if DecodeClient('{"type":"wait"}').Unwrap() is ClientMessage.Wait then
    begin
      null;
    end;
  else
    begin
      panic('expected wait');
    end;
  end if;

  AssertTrue(DecodeClient('{"type":"attack","target":"skeleton"}').IsError());
  AssertTrue(DecodeClient('{"type":"wait","turns":3}').IsError());
  const Defeat: string := EncodeServer(ServerMessage.Defeated('The restless skeleton strikes you for 4. You have fallen.'));
  if DecodeServer(Defeat).Unwrap() is ServerMessage.Defeated(const Summary) then
    begin
      AssertEquals('The restless skeleton strikes you for 4. You have fallen.', Summary);
    end;
  else
    begin
      panic('expected defeat');
    end;
  end if;

  AssertTrue(DecodeServer('{"type":"defeated","message":""}').IsError());
  AssertTrue(DecodeServer('{"type":"defeated"}').IsError());
  AssertTrue(DecodeServer(('{"type":"defeated","message":"' + 'x'.RepeatStr(MaximumCombatLogTextLength +
                                                                            1)) +
                          '"}')
               .IsError());
  // A visible opponent directly ahead, with health and this turn's messages.
  const Fight: FirstPersonVisibleState := Corridor(['#####', '#.h.#', '#####'], 14, 20, [
                                                                                          'You hit the restless skeleton for 3.',
                                                                                          'The restless skeleton strikes you for 2.'
                                                                                        ]);
  if DecodeServer(Encoded(Fight)).Unwrap() is ServerMessage.State(const Value) then
    begin
      if Value is VisibleState.FirstPersonState(const Decoded) then
        begin
          AssertEquals(14, Decoded.Health);
          AssertEquals(20, Decoded.MaxHealth);
          AssertEquals(2, Decoded.CombatLog.Length());
          AssertEquals('The restless skeleton strikes you for 2.', Decoded.CombatLog[1]);
          AssertEquals(InteriorHostileCode, Decoded.Rows[1].CharAt(2));
        end;
      else
        begin
          panic('expected first-person state');
        end;
      end if;
    end;
  else
    begin
      panic('expected state');
    end;
  end if;

  // Health must stay within 1..MaxHealth..MaximumVisibleHealth.
  AssertTrue(DecodeServer(Encoded(Corridor(['#####', '#...#', '#####'], 0, 20, []))).IsError());
  AssertTrue(DecodeServer(Encoded(Corridor(['#####', '#...#', '#####'], 21, 20, []))).IsError());
  AssertTrue(DecodeServer(Encoded(Corridor(['#####', '#...#', '#####'], 5, MaximumVisibleHealth + 1, [])))
               .IsError());
  // The combat log is bounded in entries and length, and entries are never empty.
  var LongLog: array of string := [];
  for Index: integer := 0 to MaximumCombatLogEntries do
    begin
      LongLog.Push('You wait.');
    end;
  end for;

  AssertTrue(DecodeServer(Encoded(Corridor(['#####', '#...#', '#####'], 5, 20, LongLog))).IsError());
  AssertTrue(DecodeServer(Encoded(Corridor(['#####', '#...#', '#####'], 5, 20, [
                                                                                 'x'.RepeatStr(MaximumCombatLogTextLength + 1)
                                                                               ])))
               .IsError());
  AssertTrue(DecodeServer(Encoded(Corridor(['#####', '#...#', '#####'], 5, 20, ['']))).IsError());
  // The player never shares a field with a standing opponent.
  AssertTrue(DecodeServer(Encoded(Corridor(['#####', '#..h#', '#####'], 5, 20, []))).IsError());
  // Opponents belong to the interior alphabet only.
  AssertTrue(IsInteriorCellCode(InteriorHostileCode));
  AssertFalse(IsMapCellCode(InteriorHostileCode));
  // States without the new fields belong to protocol version 10 and are rejected.
  AssertTrue(Encoded(Fight).Contains('"health":14,'));
  AssertTrue(DecodeServer(Encoded(Fight).Replace('"health":14,', '')).IsError());
end.
