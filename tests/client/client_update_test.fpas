// Verifies client screen, overlay, panel, and movement transitions without host routing.
program DungeonClientUpdateTest;

uses Dungeon.Test.Catalog as Catalog, Dungeon.Client as Client, Dungeon.Protocol as Protocol, Dungeon.RuntimeData as RuntimeData, Std.Tasks as Tasks, Std.Test as Test, Std.Tui as Tui;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string; Ctrl: boolean; Alt: boolean): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(
    kind := Kind,
    ch := Character,
    shift := false,
    ctrl := Ctrl,
    alt := Alt,
    meta := false
  );
end function;

begin
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(2);
  const Events: channel of Client.ClientEvent := Tasks.CreateChannel(2);
  var Model: Client.ClientModel := Client.NewClientModel(
    '127.0.0.1',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    Requests,
    Events
  );
  const Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  Test.AssertTrue(Model.Screen = Client.ClientScreen.StartScreen);
  Test.AssertTrue(Model.ConnectionPhase = Client.ClientConnectionPhase.Offline);
  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'w', false, false)),
    Cmd
  );
  Test.AssertTrue((Tasks.ReceiveWithTimeout(Requests, 0) is Error(_)));
  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Enter, '', false, false)),
    Cmd
  );
  Test.AssertTrue((Tasks.ReceiveWithTimeout(Requests, 0) is Error(_)));
  Model := Client.UpdateClientEvent(
    Model,
    Client.ClientEvent.Connected(Catalog.FixtureCatalog(false, false)),
    Cmd
  );
  Test.AssertTrue(Model.Screen = Client.ClientScreen.StartScreen);
  Test.AssertTrue(Model.ConnectionPhase = Client.ClientConnectionPhase.AwaitingSession);
  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'a', false, false)),
    Cmd
  );
  Test.AssertTrue((Tasks.ReceiveWithTimeout(Requests, 0) is Error(_)));
  Model := Client.UpdateClientEvent(
    Model, Client.ClientEvent.State(
      Protocol.VisibleState.MapState(
        Protocol.MapVisibleState(
          OriginX := 0, OriginY := 0, Width := 1, Height := 1, Rows := [
            'g'
          ], KnowledgeRows := [
            'v'
          ], PlayerX := 0, PlayerY := 0, WorldX := 0, WorldY := 0, Inventory := [], Health := 20,
          MaxHealth := 20, Character := []
        )
      )
    ), Cmd
  );
  Test.AssertTrue(Model.ConnectionPhase = Client.ClientConnectionPhase.Active);
  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'a', false, false)),
    Cmd
  );
  Test.AssertTrue(Model.Pending);
  Test.AssertEquals('Moving...', Model.Status);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.Move(const DeltaX, const DeltaY):
      Test.AssertEquals(-1, DeltaX);
      Test.AssertEquals(0, DeltaY);
    when Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected one movement intention');
  end case;

  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'd', false, false)),
    Cmd
  );
  Test.AssertTrue((Tasks.ReceiveWithTimeout(Requests, 0) is Error(_)));
  Model := Client.UpdateClientEvent(
    Model,
    Client.ClientEvent.Rejected('movement_rejected', 'blocked'),
    Cmd
  );
  Test.AssertFalse(Model.Pending);
  Test.AssertEquals('blocked', Model.Status);
  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Enter, '', false, false)),
    Cmd
  );
  Test.AssertTrue(Model.Pending);
  if Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() is Protocol.ClientMessage.Interact then
    begin
      null;
    end;
  else
    begin
      panic('expected interaction intention');
    end;
  end if;

  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Enter, '', false, false)),
    Cmd
  );
  Test.AssertTrue((Tasks.ReceiveWithTimeout(Requests, 0) is Error(_)));
  Model := Client.UpdateClientEvent(
    Model,
    Client.ClientEvent.Interaction('', 'Nothing useful.'),
    Cmd
  );
  Test.AssertFalse(Model.Pending);
  Test.AssertEquals('Nothing useful.', Model.Status);
  Test.AssertEquals('Nothing useful.', Model.Messages[Model.Messages.Length() - 1]);
  Test.AssertTrue(Model.Overlay = Client.ClientOverlay.NoOverlay);
  Model := Client.UpdateClientEvent(
    Model,
    Client.ClientEvent.Interaction('Ancient coin', 'A tarnished coin.'),
    Cmd
  );
  Test.AssertTrue(Model.Overlay = Client.ClientOverlay.DescriptionOverlay);
  Test.AssertEquals('Ancient coin', Model.DescriptionTitle);
  Test.AssertEquals('A tarnished coin.', Model.DescriptionText);
  Test.AssertFalse(Model.Status = Model.DescriptionText);
  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'w', false, false)),
    Cmd
  );
  Test.AssertTrue((Tasks.ReceiveWithTimeout(Requests, 0) is Error(_)));
  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Enter, '', false, false)),
    Cmd
  );
  Test.AssertTrue(Model.Overlay = Client.ClientOverlay.NoOverlay);
  Test.AssertTrue((Tasks.ReceiveWithTimeout(Requests, 0) is Error(_)));
  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'p', true, false)),
    Cmd
  );
  Test.AssertTrue(Model.Overlay = Client.ClientOverlay.SystemMenuOverlay);
  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'd', false, false)),
    Cmd
  );
  Test.AssertTrue((Tasks.ReceiveWithTimeout(Requests, 0) is Error(_)));
  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Enter, '', false, false)),
    Cmd
  );
  Test.AssertTrue((Tasks.ReceiveWithTimeout(Requests, 0) is Error(_)));
  Model := Client.UpdateClient(Model, Tui.TuiMsg.QuitRequested, Cmd);
  Test.AssertTrue(Model.Overlay = Client.ClientOverlay.NoOverlay);
  Test.AssertTrue(Cmd.Command() = Tui.TuiCmd.NoCommand);
  Model := Client.UpdateClient(Model, Tui.TuiMsg.Resize(Tui.TuiSize.Create(40, 12)), Cmd);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.Viewport(const Width, const Height):
      Test.AssertEquals(19, Width);
      Test.AssertEquals(7, Height);
    when Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected viewport update after resize');
  end case;

  Test.AssertTrue(Model.Pending);
  const ResizedMap: Protocol.MapVisibleState := Protocol.MapVisibleState(
    OriginX := -9, OriginY := -3, Width := 19, Height := 7, Rows := [
      'ggggggggggggggggggg',
      'ggggggggggggggggggg',
      'ggggggggggggggggggg',
      'ppppppppppppppppppp',
      'ggggggggggggggggggg',
      'ggggggggggggggggggg',
      'ggggggggggggggggggg'
    ], KnowledgeRows := [
      'vvvvvvvvvvvvvvvvvvv',
      'vvvvvvvvvvvvvvvvvvv',
      'vvvvvvvvvvvvvvvvvvv',
      'vvvvvvvvvvvvvvvvvvv',
      'vvvvvvvvvvvvvvvvvvv',
      'vvvvvvvvvvvvvvvvvvv',
      'vvvvvvvvvvvvvvvvvvv'
    ], PlayerX := 9, PlayerY := 3, WorldX := 0, WorldY := 0, Inventory := [], Health := 20,
    MaxHealth := 20, Character := []
  );
  const ResizedState: Protocol.VisibleState := Protocol.VisibleState.MapState(ResizedMap);
  Model := Client.UpdateClientEvent(Model, Client.ClientEvent.State(ResizedState), Cmd);
  Test.AssertFalse(Model.Pending);
  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.F2, '', false, false)),
    Cmd
  );
  Test.AssertTrue(Model.Overlay = Client.ClientOverlay.ContextOverlay);
  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.F2, '', false, false)),
    Cmd
  );
  Test.AssertTrue(Model.Overlay = Client.ClientOverlay.NoOverlay);
  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.F3, '', false, false)),
    Cmd
  );
  Test.AssertTrue(Model.Overlay = Client.ClientOverlay.MessageOverlay);
  Model := Client.UpdateClient(Model, Tui.TuiMsg.QuitRequested, Cmd);
  Test.AssertTrue(Model.Overlay = Client.ClientOverlay.NoOverlay);
  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'x', false, true)),
    Cmd
  );
  Test.AssertTrue(Cmd.Command() = Tui.TuiCmd.Quit);
  if Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() is Protocol.ClientMessage.Disconnect then
    begin
      null;
    end;
  else
    begin
      panic('expected a clean disconnect request');
    end;
  end if;

  Model.Pending := true;
  Model := Client.UpdateClientEvent(Model, Client.ClientEvent.Failed('network down'), Cmd);
  Test.AssertTrue(Model.ConnectionPhase = Client.ClientConnectionPhase.Failed);
  Test.AssertFalse(Model.Pending);
  Test.AssertEquals('Connection failed: network down', Model.Status);
  Model := Client.UpdateClientEvent(Model, Client.ClientEvent.Disconnected, Cmd);
  Test.AssertTrue(Model.ConnectionPhase = Client.ClientConnectionPhase.Disconnected);
  Test.AssertEquals('Disconnected', Model.Status);
  discard Tasks.CloseChannel(Requests);
  discard Tasks.CloseChannel(Events);
end.
