// Verifies client screen, overlay, panel, and movement transitions without host routing.
program DungeonClientUpdateTest;

uses
  Dungeon.Test.Catalog, Dungeon.Client, Dungeon.Protocol, Dungeon.RuntimeData, Std.Tasks, Std.Test,
  Std.Tui;

function MakeKey(Kind: TuiKeyKind; Character: string; Ctrl: boolean; Alt: boolean): TuiKeyEvent;
begin
  return TuiKeyEvent(kind := Kind, ch := Character, shift := false, ctrl := Ctrl, alt := Alt, meta := false);
end function;

begin
  const Requests: channel of ClientMessage := CreateChannel(2);
  const Events: channel of ClientEvent := CreateChannel(2);
  var Model: ClientModel := NewClientModel('127.0.0.1', 4040, '', DefaultClientPreferences(), Requests, Events);
  const Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  AssertTrue(Model.Screen = ClientScreen.StartScreen);
  AssertTrue(Model.ConnectionPhase = ClientConnectionPhase.Offline);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Character, 'w', false, false)), Cmd);
  AssertTrue(ReceiveWithTimeout(Requests, 0).IsError());
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Enter, '', false, false)), Cmd);
  AssertTrue(ReceiveWithTimeout(Requests, 0).IsError());
  Model := UpdateClientEvent(Model, ClientEvent.Connected(FixtureCatalog(false, false)), Cmd);
  AssertTrue(Model.Screen = ClientScreen.StartScreen);
  AssertTrue(Model.ConnectionPhase = ClientConnectionPhase.AwaitingSession);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Character, 'a', false, false)), Cmd);
  AssertTrue(ReceiveWithTimeout(Requests, 0).IsError());
  Model := UpdateClientEvent(Model, ClientEvent.State(VisibleState.MapState(MapVisibleState(OriginX := 0, OriginY := 0, Width := 1, Height := 1, Rows := [
                                                                                                                                                           'g'
                                                                                                                                                         ], KnowledgeRows := [
                                                                                                                                                                               'v'
                                                                                                                                                                             ], PlayerX := 0, PlayerY := 0, WorldX := 0, WorldY := 0, Inventory := [], Health := 20, MaxHealth := 20, Character := []))), Cmd);
  AssertTrue(Model.ConnectionPhase = ClientConnectionPhase.Active);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Character, 'a', false, false)), Cmd);
  AssertTrue(Model.Pending);
  AssertEquals('Moving...', Model.Status);
  if ReceiveWithTimeout(Requests, 0).Unwrap() is ClientMessage.Move(const DeltaX, const DeltaY) then
    begin
      AssertEquals(-1, DeltaX);
      AssertEquals(0, DeltaY);
    end;
  else
    begin
      panic('expected one movement intention');
    end;
  end if;

  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Character, 'd', false, false)), Cmd);
  AssertTrue(ReceiveWithTimeout(Requests, 0).IsError());
  Model := UpdateClientEvent(Model, ClientEvent.Rejected('movement_rejected', 'blocked'), Cmd);
  AssertFalse(Model.Pending);
  AssertEquals('blocked', Model.Status);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Enter, '', false, false)), Cmd);
  AssertTrue(Model.Pending);
  if ReceiveWithTimeout(Requests, 0).Unwrap() is ClientMessage.Interact then
    begin
      null;
    end;
  else
    begin
      panic('expected interaction intention');
    end;
  end if;

  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Enter, '', false, false)), Cmd);
  AssertTrue(ReceiveWithTimeout(Requests, 0).IsError());
  Model := UpdateClientEvent(Model, ClientEvent.Interaction('', 'Nothing useful.'), Cmd);
  AssertFalse(Model.Pending);
  AssertEquals('Nothing useful.', Model.Status);
  AssertEquals('Nothing useful.', Model.Messages[Model.Messages.Length() - 1]);
  AssertTrue(Model.Overlay = ClientOverlay.NoOverlay);
  Model := UpdateClientEvent(Model, ClientEvent.Interaction('Ancient coin', 'A tarnished coin.'), Cmd);
  AssertTrue(Model.Overlay = ClientOverlay.DescriptionOverlay);
  AssertEquals('Ancient coin', Model.DescriptionTitle);
  AssertEquals('A tarnished coin.', Model.DescriptionText);
  AssertFalse(Model.Status = Model.DescriptionText);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Character, 'w', false, false)), Cmd);
  AssertTrue(ReceiveWithTimeout(Requests, 0).IsError());
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Enter, '', false, false)), Cmd);
  AssertTrue(Model.Overlay = ClientOverlay.NoOverlay);
  AssertTrue(ReceiveWithTimeout(Requests, 0).IsError());
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Character, 'p', true, false)), Cmd);
  AssertTrue(Model.Overlay = ClientOverlay.SystemMenuOverlay);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Character, 'd', false, false)), Cmd);
  AssertTrue(ReceiveWithTimeout(Requests, 0).IsError());
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Enter, '', false, false)), Cmd);
  AssertTrue(ReceiveWithTimeout(Requests, 0).IsError());
  Model := UpdateClient(Model, TuiMsg.QuitRequested, Cmd);
  AssertTrue(Model.Overlay = ClientOverlay.NoOverlay);
  AssertTrue(Cmd.Command() = TuiCmd.NoCommand);
  Model := UpdateClient(Model, TuiMsg.Resize(TuiSize.Create(40, 12)), Cmd);
  if ReceiveWithTimeout(Requests, 0).Unwrap() is ClientMessage.Viewport(const Width, const Height) then
    begin
      AssertEquals(19, Width);
      AssertEquals(7, Height);
    end;
  else
    begin
      panic('expected viewport update after resize');
    end;
  end if;

  AssertTrue(Model.Pending);
  const ResizedMap: MapVisibleState := MapVisibleState(OriginX := -9, OriginY := -3, Width := 19, Height := 7, Rows := [
                                                                                                                         'ggggggggggggggggggg',
                                                                                                                         'ggggggggggggggggggg',
                                                                                                                         'ggggggggggggggggggg',
                                                                                                                         'ppppppppppppppppppp',
                                                                                                                         'ggggggggggggggggggg',
                                                                                                                         'ggggggggggggggggggg',
                                                                                                                         'ggggggggggggggggggg'
                                                                                                                       ], KnowledgeRows := [
                                                                                                                                             'vvvvvvvvvvvvvvvvvvv',
                                                                                                                                             'vvvvvvvvvvvvvvvvvvv',
                                                                                                                                             'vvvvvvvvvvvvvvvvvvv',
                                                                                                                                             'vvvvvvvvvvvvvvvvvvv',
                                                                                                                                             'vvvvvvvvvvvvvvvvvvv',
                                                                                                                                             'vvvvvvvvvvvvvvvvvvv',
                                                                                                                                             'vvvvvvvvvvvvvvvvvvv'
                                                                                                                                           ], PlayerX := 9, PlayerY := 3, WorldX := 0, WorldY := 0, Inventory := [], Health := 20, MaxHealth := 20, Character := []);
  const ResizedState: VisibleState := VisibleState.MapState(ResizedMap);
  Model := UpdateClientEvent(Model, ClientEvent.State(ResizedState), Cmd);
  AssertFalse(Model.Pending);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.F2, '', false, false)), Cmd);
  AssertTrue(Model.Overlay = ClientOverlay.ContextOverlay);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.F2, '', false, false)), Cmd);
  AssertTrue(Model.Overlay = ClientOverlay.NoOverlay);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.F3, '', false, false)), Cmd);
  AssertTrue(Model.Overlay = ClientOverlay.MessageOverlay);
  Model := UpdateClient(Model, TuiMsg.QuitRequested, Cmd);
  AssertTrue(Model.Overlay = ClientOverlay.NoOverlay);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Character, 'x', false, true)), Cmd);
  AssertTrue(Cmd.Command() = TuiCmd.Quit);
  if ReceiveWithTimeout(Requests, 0).Unwrap() is ClientMessage.Disconnect then
    begin
      null;
    end;
  else
    begin
      panic('expected a clean disconnect request');
    end;
  end if;

  Model.Pending := true;
  Model := UpdateClientEvent(Model, ClientEvent.Failed('network down'), Cmd);
  AssertTrue(Model.ConnectionPhase = ClientConnectionPhase.Failed);
  AssertFalse(Model.Pending);
  AssertEquals('Connection failed: network down', Model.Status);
  Model := UpdateClientEvent(Model, ClientEvent.Disconnected, Cmd);
  AssertTrue(Model.ConnectionPhase = ClientConnectionPhase.Disconnected);
  AssertEquals('Disconnected', Model.Status);
  discard CloseChannel(Requests);
  discard CloseChannel(Events);
end.
