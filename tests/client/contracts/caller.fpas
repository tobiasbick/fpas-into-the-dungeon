// Calls the public client update boundary with valid or deliberately corrupt caller-owned state.
program ClientContractCaller;

uses Dungeon.Client as Client, Dungeon.Protocol as Protocol, Dungeon.RuntimeData as RuntimeData, Std.Args as Args, Std.Console as Console, Std.Tasks as Tasks, Std.Tui as Tui;

begin
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(1);
  const Events: channel of Client.ConnectionEvent := Tasks.CreateChannel(1);
  var State := Client.NewClientModel(
    'contract.example', 4040, '', RuntimeData.DefaultClientPreferences(), Requests, Events
  );
  case Args.ParamStr(0) of
    when 'valid':
      null;
    when 'invalid-generation':
      State.ConnectionGeneration := -1;
    when 'invalid-viewport':
      State.RequestedWorldWidth := 0;
    else
      panic('unknown contract caller scenario');
  end case;

  discard Client.UpdateClient(State, Tui.TuiMsg.Tick(0), Tui.TuiCmdOutput.Create());
  discard Tasks.CloseChannel(Requests);
  discard Tasks.CloseChannel(Events);
  Console.WriteLn('completed');
end.
