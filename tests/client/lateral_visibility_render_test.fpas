// Replays an open room's server visibility through the renderer to catch lateral fog walls.
program LateralVisibilityRenderTest;

uses
  Dungeon.Client.Raycast, Dungeon.Client.Raycast.Rays, Dungeon.Coordinates,
  Dungeon.Exploration.Sight, Dungeon.Interior, Dungeon.Protocol, Dungeon.Test.Fixtures, Std.Test;

function Room(): InteriorMap;
begin
  var Cells: array of InteriorCellKind := array.Fill(InteriorCellKind.Floor, 49);
  for N: integer := 0 to 6 do
    begin
      Cells[N] := InteriorCellKind.Wall;
      Cells[42 + N] := InteriorCellKind.Wall;
      Cells[N * 7] := InteriorCellKind.Wall;
      Cells[N * 7 + 6] := InteriorCellKind.Wall;
    end;
  end for;

  Cells[36] := InteriorCellKind.ExitField;
  return ValidateInteriorMap(FixtureDungeonMap() with Width := 7; Height := 7; Cells := Cells; Start := InteriorPosition(X := 2, Y := 2); Exit := InteriorPosition(X := 1, Y := 5); Items := []; Hostiles := []; end with)
           .Unwrap();
end function;

function WireFacing(Facing: FacingDirection): FirstPersonFacing;
begin
  case Facing of
    when FacingDirection.North:
      begin
        return FirstPersonFacing.North;
      end;
    when FacingDirection.East:
      begin
        return FirstPersonFacing.East;
      end;
    when FacingDirection.South:
      begin
        return FirstPersonFacing.South;
      end;
    when FacingDirection.West:
      begin
        return FirstPersonFacing.West;
      end;
  end case;
end function;

function Projection(Map: InteriorMap; Pose: FirstPersonPose): FirstPersonVisibleState;
begin
  const Visible: array of boolean := InteriorVisibility(Map, Pose);
  var Rows: array of string := [];
  var Knowledge: array of string := [];
  for Y: integer := 0 to Map.Height - 1 do
    begin
      var Row: string := '';
      var Mask: string := '';
      for X: integer := 0 to Map.Width - 1 do
        begin
          if Visible[Y * Map.Width + X] then
            begin
              Row := Row + InteriorCellCode(Map.Cells[Y * Map.Width + X]);
              Mask := Mask + 'v';
            end;
          else
            begin
              Row := Row + '?';
              Mask := Mask + 'u';
            end;
          end if;
        end;
      end for;

      Rows.Push(Row);
      Knowledge.Push(Mask);
    end;
  end for;

  return FirstPersonVisibleState(Title := 'Lateral visibility', Status := '', Width := Map.Width, Height := Map.Height, Rows := Rows, KnowledgeRows := Knowledge, PlayerX := Pose.Position.X, PlayerY := Pose.Position.Y, Facing := WireFacing(Pose.Facing), Inventory := [], Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []);
end function;

begin
  const Map: InteriorMap := Room();
  for Direction: FacingDirection in [
                                      FacingDirection.North,
                                      FacingDirection.East,
                                      FacingDirection.South,
                                      FacingDirection.West
                                    ] do
    begin
      const Pose: FirstPersonPose := FirstPersonPose(Position := InteriorPosition(X := 3, Y := 3), Facing := Direction);
      const Forward: InteriorPosition := StepOffset(Direction, RelativeStep.Forward);
      const Side: InteriorPosition := StepOffset(Direction, RelativeStep.Right);
      const Visible: array of boolean := InteriorVisibility(Map, Pose);
      // Partly projected edge fields are known; farther sideways and behind remain hidden.
      AssertTrue(Visible[((((3 + Forward.Y) + 2 * Side.Y) * Map.Width + 3) + Forward.X) + 2 * Side.X]);
      AssertFalse(Visible[((3 + 2 * Side.Y) * Map.Width + 3) + 2 * Side.X]);
      AssertFalse(Visible[((3 - Forward.Y) * Map.Width + 3) - Forward.X]);
      for PX: integer in [2, 4] do
        begin
          for PY: integer in [2, 4] do
            begin
              const Value: FirstPersonVisibleState := Projection(Map, FirstPersonPose(Position := InteriorPosition(X := PX, Y := PY), Facing := Direction));
              // Every ray in this small empty room meets a wall within sight range.
              for CameraX: real in [-1.0, -0.9, -0.5, 0.0, 0.5, 0.9, 1.0] do
                begin
                  AssertEquals('#', CastFirstPersonRay(Value, CameraX).FieldCode);
                end;
              end for;

              for Width: integer in [81, 101] do
                begin
                  const Scene: FirstPersonScene := RenderFirstPersonScene(Value, Width, 37);
                  for X: integer := 0 to Width - 1 do
                    begin
                      // The horizon intersects stone in every column; unknown fog is red 18.
                      AssertTrue(Scene.Pixels[37 * Width + X] div 65536 > 30);
                    end;
                  end for;
                end;
              end for;
            end;
          end for;
        end;
      end for;
    end;
  end for;
end.
