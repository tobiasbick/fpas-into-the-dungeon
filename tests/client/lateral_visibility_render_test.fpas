// Replays an open room's server visibility through the renderer to catch lateral fog walls.
program LateralVisibilityRenderTest;

uses Dungeon.Client.Raycast as Raycast, Dungeon.Client.Raycast.Rays as Rays, Dungeon.Coordinates as Coordinates, Dungeon.Exploration.Sight as Sight, Dungeon.Interior as InteriorUnit, Dungeon.Protocol as Protocol, Dungeon.Test.Fixtures as Fixtures, Std.Test as Test;

function Room(): InteriorUnit.InteriorMap;
begin
  var Cells: array of InteriorUnit.InteriorCellKind := array.Fill(
    InteriorUnit.InteriorCellKind.Floor,
    49
  );
  for N: integer := 0 to 6 do
    begin
      Cells[N] := InteriorUnit.InteriorCellKind.Wall;
      Cells[42 + N] := InteriorUnit.InteriorCellKind.Wall;
      Cells[N * 7] := InteriorUnit.InteriorCellKind.Wall;
      Cells[N * 7 + 6] := InteriorUnit.InteriorCellKind.Wall;
    end;
  end for;

  Cells[36] := InteriorUnit.InteriorCellKind.ExitField;
  return InteriorUnit.ValidateInteriorMap(
    Fixtures.FixtureDungeonMap() with Width := 7; Height := 7; Cells := Cells; Start := Coordinates.InteriorPosition(
      X := 2,
      Y := 2
    ); Arrival := Coordinates.InteriorPosition(X := 1, Y := 5); Items := []; Hostiles := []; end with
  ).Unwrap();
end function;

function WireFacing(Facing: Coordinates.FacingDirection): Protocol.FirstPersonFacing;
begin
  case Facing of
    when Coordinates.FacingDirection.North:
      begin
        return Protocol.FirstPersonFacing.North;
      end;
    when Coordinates.FacingDirection.East:
      begin
        return Protocol.FirstPersonFacing.East;
      end;
    when Coordinates.FacingDirection.South:
      begin
        return Protocol.FirstPersonFacing.South;
      end;
    when Coordinates.FacingDirection.West:
      begin
        return Protocol.FirstPersonFacing.West;
      end;
  end case;
end function;

function Projection(Map: InteriorUnit.InteriorMap; Pose: Coordinates.FirstPersonPose): Protocol.FirstPersonVisibleState;
begin
  const Visible: array of boolean := Sight.InteriorVisibility(Map, Pose);
  var Rows: array of string := [];
  var Knowledge: array of string := [];
  for Y: integer := 0 to Map.Height - 1 do
    begin
      var Row: string := '';
      var Mask: string := '';
      for X: integer := 0 to Map.Width - 1 do
        begin
          if Visible[Y * Map.Width + X] then
            begin
              Row := Row + InteriorUnit.InteriorCellCode(Map.Cells[Y * Map.Width + X]);
              Mask := Mask + 'v';
            end;
          else
            begin
              Row := Row + '?';
              Mask := Mask + 'u';
            end;
          end if;
        end;
      end for;

      Rows.PushInPlace(Row);
      Knowledge.PushInPlace(Mask);
    end;
  end for;

  return Protocol.FirstPersonVisibleState(
    Time := Protocol.VisibleTime(Day := 1, MinuteOfDay := 480, Phase := Protocol.DayPhase.Day),
    Coins := 0,
    Title := 'Lateral visibility',
    Status := '',
    Level := 0, Depth := 1,
    Width := Map.Width,
    Height := Map.Height,
    Rows := Rows,
    KnowledgeRows := Knowledge,
    PlayerX := Pose.Position.X,
    PlayerY := Pose.Position.Y,
    Facing := WireFacing(Pose.Facing),
    Inventory := [],
    Health := 20,
    MaxHealth := 20,
    Character := [],
    CombatLog := [],
    CombatEvents := [], Journal := []
  );
end function;

begin
  const Map: InteriorUnit.InteriorMap := Room();
  for Direction: Coordinates.FacingDirection in [
    Coordinates.FacingDirection.North,
    Coordinates.FacingDirection.East,
    Coordinates.FacingDirection.South,
    Coordinates.FacingDirection.West
  ] do
    begin
      const Pose: Coordinates.FirstPersonPose := Coordinates.FirstPersonPose(
        Position := Coordinates.InteriorPosition(X := 3, Y := 3),
        Facing := Direction
      );
      const Forward: Coordinates.InteriorPosition := Coordinates.StepOffset(
        Direction,
        Coordinates.RelativeStep.Forward
      );
      const Side: Coordinates.InteriorPosition := Coordinates.StepOffset(
        Direction,
        Coordinates.RelativeStep.Right
      );
      const Visible: array of boolean := Sight.InteriorVisibility(Map, Pose);
      // Partly projected edge fields are known; farther sideways and behind remain hidden.
      Test.AssertTrue(
        Visible[((((3 + Forward.Y) + 2 * Side.Y) * Map.Width + 3) + Forward.X) + 2 * Side.X]
      );
      Test.AssertFalse(Visible[((3 + 2 * Side.Y) * Map.Width + 3) + 2 * Side.X]);
      Test.AssertFalse(Visible[((3 - Forward.Y) * Map.Width + 3) - Forward.X]);
      for PX: integer in [2, 4] do
        begin
          for PY: integer in [2, 4] do
            begin
              const Value: Protocol.FirstPersonVisibleState := Projection(
                Map,
                Coordinates.FirstPersonPose(
                  Position := Coordinates.InteriorPosition(X := PX, Y := PY),
                  Facing := Direction
                )
              );
              // Every ray in this small empty room meets a wall within sight range.
              for CameraX: real in [-1.0, -0.9, -0.5, 0.0, 0.5, 0.9, 1.0] do
                begin
                  Test.AssertEquals('#', Rays.CastFirstPersonRay(Value, CameraX).FieldCode);
                end;
              end for;

              for Width: integer in [81, 101] do
                begin
                  const Scene: Raycast.FirstPersonScene := Raycast.RenderFirstPersonScene(
                    Value,
                    Width,
                    37
                  );
                  for X: integer := 0 to Width - 1 do
                    begin
                      // The horizon intersects stone in every column; unknown fog is red 18.
                      Test.AssertTrue(Scene.Pixels[37 * Width + X] div 65536 > 30);
                    end;
                  end for;
                end;
              end for;
            end;
          end for;
        end;
      end for;
    end;
  end for;
end.
