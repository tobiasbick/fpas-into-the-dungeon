// Exercises seed presets, custom input, active colors, and bounded creation actions through the TUI.
program WorldCreationUiTest;

uses
  Dungeon.Client as Client, Dungeon.Protocol as Protocol, Dungeon.Protocol.Worlds as Worlds,
  Dungeon.RuntimeData as RuntimeData, Dungeon.Ui.Theme as Theme,
  Std.Io.Fs as Fs, Std.Tasks as Tasks, Std.Test as Test, Std.Ui.Terminal as Tui;

function Find(Screen: Tui.TuiSurfaceSnapshot; Text: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Screen.Height - 1 do
    case Screen.LineAt(Y).IndexOf(Text) of
      when Some(const X):
        return Tui.TuiPoint.Create(X, Y);
      when None:
        null;
    end case;
  end for;

  panic('creation text missing: ' + Text);
end function;

function Press(
  App: Tui.TuiApplication; State: Client.ClientModel;
  Kind: Tui.TuiKeyKind; Text: string; Shift: boolean
): Client.ClientModel;
begin
  App.InjectKeyForTest(
    Tui.TuiKeyEvent(
      kind := Kind, ch := Text, shift := Shift, ctrl := false, alt := false, meta := false
    )
  );
  return App.RunIterations(State, Client.UpdateClient, Client.ViewClient, 3, 0);
end function;

begin
  for Size: Tui.TuiSize in [
    Tui.TuiSize.Create(80, 25), Tui.TuiSize.Create(144, 45), Tui.TuiSize.Create(40, 12),
    Tui.TuiSize.Create(80, 12), Tui.TuiSize.Create(60, 12), Tui.TuiSize.Create(40, 25)
  ] do
    const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(8);
    const Events: channel of Client.ConnectionEvent := Tasks.CreateChannel(8);
    const Cmd := Tui.TuiCmdOutput.Create();
    var State := Client.NewClientModel(
      '127.0.0.1', 4040, '',
      RuntimeData.DefaultClientPreferences(), Requests, Events
    ) with ViewportWidth := Size.Width; ViewportHeight := Size.Height; end with;

    Test.AssertEquals(32, State.Catalog.DefaultSeed);
    State := Client.UpdateClientEvent(
      State,
      Client.ClientEvent.Connected(Worlds.EmptyWorldCatalog(32, 4)), Cmd
    );
    State := Client.UpdateClient(
      State,
      Tui.TuiMsg.Action(Tui.TuiControlId.Create(41), Tui.TuiAction.Create(140)), Cmd
    );
    const App := Tui.TuiApplication.OpenForTestWithPalette(Size, Theme.Palette());
    State := App.RunIterations(State, Client.UpdateClient, Client.ViewClient, 0, 0);
    var Screen := App.SurfaceSnapshot();
    const Cancel := Find(Screen, 'Cancel');
    const CreateX := Screen.LineAt(Cancel.Y).IndexOf('Create').Unwrap();
    Test.AssertTrue(CreateX < Cancel.X);
    Test.AssertTrue(
      Screen.CellAt(CreateX, Cancel.Y).ButtonAppearance.Unwrap().Kind = Tui.TuiButtonKind.Primary
    );
    if (Size.Width = 80) and (Size.Height = 25) then
      Test.AssertEquals(18, Cancel.Y);
      Test.AssertEquals(73, Cancel.X + 6);
      Test.AssertTrue(Find(Screen, 'Forest edge: Dense woodland nearby.').Y > 0);
      const Active := Find(Screen, '32 Forest edge');
      Test.AssertTrue(
        Screen.CellAt(Active.X, Active.Y).ButtonAppearance.Unwrap().State =
        Tui.TuiButtonState.Active
      );
      var Lines: array of string := [];
      for Y: integer := 0 to Screen.Height - 1 do
        Lines.PushInPlace(Screen.LineAt(Y));
      end for;

      discard Fs.WriteText('.temp-data/world-creation-80.txt', Lines.Join(#10)).Unwrap();
    end if;

    // Resize notices retain a reachable Cancel even if the previously focused input disappears.
    App.InjectResizeForTest(Tui.TuiSize.Create(30, 10));
    State := App.RunIterations(State, Client.UpdateClient, Client.ViewClient, 3, 0);
    Test.AssertTrue(Find(App.SurfaceSnapshot(), 'Need at least 40 x 12').Y > 0);
    Test.AssertEquals(7, Find(App.SurfaceSnapshot(), 'Cancel').Y);
    App.InjectResizeForTest(Size);
    State := App.RunIterations(State, Client.UpdateClient, Client.ViewClient, 3, 0);
    Screen := App.SurfaceSnapshot();
    // A mouse choice edits only the seed, without creating or replacing the region value.
    const Choice := Find(
      Screen,
      if (Size.Width < 60) or (Size.Height < 17) then '38' else '38 River and lake' end if
    );
    App.InjectPointerForTest(
      Tui.TuiPointerEvent.Create(
        Tui.TuiPointerAction.Down, Tui.TuiPointerButton.Left, Choice
      )
    );
    State := App.RunIterations(State, Client.UpdateClient, Client.ViewClient, 3, 0);
    App.InjectPointerForTest(
      Tui.TuiPointerEvent.Create(
        Tui.TuiPointerAction.Up, Tui.TuiPointerButton.Left, Choice
      )
    );
    State := App.RunIterations(State, Client.UpdateClient, Client.ViewClient, 3, 0);
    Test.AssertEquals('38', State.SeedText);
    Test.AssertEquals('4', State.RegionText);
    Test.AssertFalse(State.Pending);
    Test.AssertTrue(Tasks.ReceiveWithTimeout(Requests, 0) is Error(_));
    Test.AssertEquals(Cancel.Y, Find(App.SurfaceSnapshot(), 'Cancel').Y);

    // Keyboard activation reaches both remaining presets, then returns to the editable seed.
    State := Press(App, State, Tui.TuiKeyKind.Tab, '', false);
    State := Press(App, State, Tui.TuiKeyKind.Enter, '', false);
    Test.AssertEquals('53', State.SeedText);
    State := Press(App, State, Tui.TuiKeyKind.Tab, '', false);
    State := Press(App, State, Tui.TuiKeyKind.Enter, '', false);
    Test.AssertEquals('24', State.SeedText);
    for Index: integer := 1 to 4 do
      State := Press(App, State, Tui.TuiKeyKind.Tab, '', true);
    end for;

    Test.AssertEquals(42, State.FocusedControl);
    State := Press(App, State, Tui.TuiKeyKind.Backspace, '', false);
    State := Press(App, State, Tui.TuiKeyKind.Backspace, '', false);
    for Digit: string in ['9', '8', '7'] do
      State := Press(App, State, Tui.TuiKeyKind.Character, Digit, false);
    end for;

    Test.AssertEquals('987', State.SeedText);
    if (Size.Width >= 60) and (Size.Height >= 17) then
      Screen := App.SurfaceSnapshot();
      Test.AssertTrue(Find(Screen, 'Custom seed: generated landscape.').Y > 0);
      const Original := Find(Screen, '32 Forest edge');
      Test.AssertTrue(
        Screen.CellAt(Original.X, Original.Y).ButtonAppearance.Unwrap().State =
        Tui.TuiButtonState.Normal
      );
    end if;

    for Index: integer := 1 to 6 do
      State := Press(App, State, Tui.TuiKeyKind.Tab, '', false);
    end for;

    Test.AssertEquals(44, State.FocusedControl);
    State := Client.UpdateClient(
      State, Tui.TuiMsg.TextChanged(
        Tui.TuiControlId.Create(42), Tui.TuiAction.Create(141), 'invalid', 7
      ), Cmd
    );
    State := Press(App, State, Tui.TuiKeyKind.Enter, '', false);
    Test.AssertFalse(State.Pending);
    Test.AssertTrue(Find(App.SurfaceSnapshot(), 'Enter a valid whole-number seed.').Y < Cancel.Y);
    Test.AssertEquals(Cancel.Y, Find(App.SurfaceSnapshot(), 'Cancel').Y);
    State := Client.UpdateClient(
      State, Tui.TuiMsg.TextChanged(
        Tui.TuiControlId.Create(42), Tui.TuiAction.Create(141), '987', 3
      ), Cmd
    );
    State := Press(App, State, Tui.TuiKeyKind.Enter, '', false);
    Test.AssertTrue(State.Pending);
    Test.AssertTrue(
      Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() = Protocol.ClientMessage.CreateWorld(987, 4)
    );
    App.Close();
    discard Tasks.CloseChannel(Requests);
    discard Tasks.CloseChannel(Events);
  end for;
end.
