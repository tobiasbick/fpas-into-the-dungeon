// Verifies that combat effects on deeper levels with several opponents of one kind only animate
// the opponent on the field the rules allow: the field ahead for player blows, adjacent fields for attackers.
program DungeonSameKindAnimationTest;

uses Dungeon.Client.Raycast as Raycast, Dungeon.Client.Raycast.Sprites as Sprites, Dungeon.Protocol as Protocol, Std.Test as Test, Std.Tui as Tui;

function Corridor(Middle: string): Protocol.FirstPersonVisibleState;
begin
  return Protocol.FirstPersonVisibleState(
    Title := 'Corridor', Status := '', Level := 1, Depth := 3, Width := 7, Height := 3,
    Rows := ['#######', Middle, '#######'], KnowledgeRows := ['vvvvvvv', 'vvvvvvv', 'vvvvvvv'],
    PlayerX := 1, PlayerY := 1, Facing := Protocol.FirstPersonFacing.East, Inventory := [],
    Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := [],
    Journal := []
  );
end function;

function Compose(Value: Protocol.FirstPersonVisibleState; Effect: Sprites.FirstPersonEffect): Tui.TuiCellGrid;
begin
  return Raycast.ComposeFirstPersonGrid(
    Value,
    Raycast.RenderFirstPersonScene(Value, 61, 25),
    Effect
  );
end function;

function FlashCells(Grid: Tui.TuiCellGrid): integer;
begin
  var Count: integer := 0;
  for Cell: Tui.TuiCell in Grid.Cells do
    const Style: Tui.TuiStyle := Cell.ConcreteStyle.Unwrap();
    if ((Style.Background.Red = 255) and (Style.Background.Green = 250))
      or
      ((Style.Foreground.Red = 255) and (Style.Foreground.Green = 250))
    then
      Count := Count + 1;
    end if;
  end for;

  return Count;
end function;

function DifferentCells(Left: Tui.TuiCellGrid; Right: Tui.TuiCellGrid): integer;
begin
  var Count: integer := 0;
  for I: integer := 0 to Left.Cells.Length() - 1 do
    const A: Tui.TuiStyle := Left.Cells[I].ConcreteStyle.Unwrap();
    const B: Tui.TuiStyle := Right.Cells[I].ConcreteStyle.Unwrap();
    if (Left.Cells[I].Glyph <> Right.Cells[I].Glyph) or (A.Background <> B.Background)
      or
      (A.Foreground <> B.Foreground)
    then
      Count := Count + 1;
    end if;
  end for;

  return Count;
end function;

begin
  var Flash := Sprites.NoFirstPersonEffect();
  Flash.Flash := true;
  Flash.TargetCode := Protocol.InteriorRatCode;
  // Two rats: only the one directly ahead flashes, exactly as if it stood alone.
  const Pair := Corridor('#.r.r.#');
  const Near := Corridor('#.r...#');
  Test.AssertTrue(FlashCells(Compose(Near, Flash)) > 0);
  Test.AssertEquals(FlashCells(Compose(Near, Flash)), FlashCells(Compose(Pair, Flash)));
  // A rat that is not directly ahead never shows a player hit.
  Test.AssertEquals(0, FlashCells(Compose(Corridor('#...r.#'), Flash)));
  // A lunge enlarges only an adjacent attacker; a distant rat of the same kind stays still.
  var Lunge := Sprites.NoFirstPersonEffect();
  Lunge.Scale := 1.4;
  Lunge.ActorCodes := [Protocol.InteriorRatCode];
  const Far := Corridor('#...r.#');
  Test.AssertEquals(
    0,
    DifferentCells(Compose(Far, Lunge), Compose(Far, Sprites.NoFirstPersonEffect()))
  );
  Test.AssertTrue(
    DifferentCells(Compose(Near, Lunge), Compose(Near, Sprites.NoFirstPersonEffect())) > 0
  );
end.
