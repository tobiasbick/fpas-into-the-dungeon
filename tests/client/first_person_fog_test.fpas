// Verifies that remembered geometry cannot become current first-person sight.
program FirstPersonFogTest;

uses Dungeon.Client.Raycast as Raycast, Dungeon.Client.Raycast.Rays as Rays, Dungeon.Protocol as Protocol, Std.Test as Test, Std.Ui.Terminal as Tui;

function Corridor(Remembered: boolean): Protocol.FirstPersonVisibleState;
begin
  var Value: Protocol.FirstPersonVisibleState := Protocol.FirstPersonVisibleState(
    Weather := None,
    Time := Protocol.VisibleTime(Day := 1, MinuteOfDay := 480, Phase := Protocol.DayPhase.Day),
    Coins := 0,
    Title := 'Fog boundary', Status := 'Nothing in reach', Level := 0, Depth := 1, Width := 7,
    Height := 3, Rows := [
      '####???',
      '#...???',
      '####???'
    ], KnowledgeRows := [
      'vvvvuuu',
      'vvvvuuu',
      'vvvvuuu'
    ], PlayerX := 1, PlayerY := 1, Facing := Protocol.FirstPersonFacing.East, Inventory := [],
    Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := [],
    Journal := []
  );
  if Remembered then
    begin
      Value.Rows := ['#######', '#....x#', '#######'];
      Value.KnowledgeRows := ['vvvvrrr', 'vvvvrrr', 'vvvvrrr'];
    end;
  end if;

  return Value;
end function;

// Counts cells whose glyph or either color differs between two equally sized grids.
function DifferentCells(Left: Tui.TuiCellGrid; Right: Tui.TuiCellGrid): integer;
begin
  var Count: integer := 0;
  for I: integer := 0 to Left.Cells.Length() - 1 do
    begin
      const A: Tui.TuiStyle := Left.Cells[I].ConcreteStyle.Unwrap();
      const B: Tui.TuiStyle := Right.Cells[I].ConcreteStyle.Unwrap();
      if (
        ((Left.Cells[I].Glyph <> Right.Cells[I].Glyph) or (A.Background.Red <> B.Background.Red))
        or
        ((A.Background.Green <> B.Background.Green) or (A.Background.Blue <> B.Background.Blue))
      )
        or
        (
          ((A.Foreground.Red <> B.Foreground.Red) or (A.Foreground.Green <> B.Foreground.Green))
          or
          (A.Foreground.Blue <> B.Foreground.Blue)
        )
      then
        begin
          Count := Count + 1;
        end;
      end if;
    end;
  end for;

  return Count;
end function;

begin
  const FogHit: Rays.FirstPersonRayHit := Rays.CastFirstPersonRay(Corridor(true), 0.0);
  Test.AssertEquals('?', FogHit.FieldCode);
  Test.AssertEquals(4, FogHit.MapX);
  Test.AssertEquals(1, FogHit.MapY);
  var Approached: Protocol.FirstPersonVisibleState := Corridor(true);
  Approached.KnowledgeRows := ['vvvvvvv', 'vvvvvvv', 'vvvvvvv'];
  const VisibleHit: Rays.FirstPersonRayHit := Rays.CastFirstPersonRay(Approached, 0.0);
  Test.AssertEquals('#', VisibleHit.FieldCode);
  Test.AssertEquals(6, VisibleHit.MapX);
  Test.AssertEquals(1, VisibleHit.MapY);
  Test.AssertTrue(FogHit.Distance < VisibleHit.Distance);
  // Same present sight, different exploration history: the 3-D picture must
  // not reveal the distant wall or exit just because they were visited earlier.
  for Width: integer in [21, 101] do
    begin
      const Unknown: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(Corridor(false), Width, 31);
      const Remembered: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(Corridor(true), Width, 31);
      for I: integer := 0 to Unknown.Cells.Length() - 1 do
        begin
          const A: Tui.TuiColor := Unknown.Cells[I].ConcreteStyle.Unwrap().Background;
          const B: Tui.TuiColor := Remembered.Cells[I].ConcreteStyle.Unwrap().Background;
          Test.AssertEquals(A.Red, B.Red);
          Test.AssertEquals(A.Green, B.Green);
          Test.AssertEquals(A.Blue, B.Blue);
          Test.AssertEquals(Unknown.Cells[I].Glyph, Remembered.Cells[I].Glyph);
        end;
      end for;
    end;
  end for;
  var HostileAhead: Protocol.FirstPersonVisibleState := Protocol.FirstPersonVisibleState(
    Weather := None,
    Time := Protocol.VisibleTime(Day := 1, MinuteOfDay := 480, Phase := Protocol.DayPhase.Day),
    Coins := 0,
    Title := 'Opponent visibility', Status := '', Level := 0, Depth := 1, Width := 7, Height := 3,
    Rows := [
      '#######',
      '#.h...#',
      '#######'
    ], KnowledgeRows := [
      'vvvvvvv',
      'vvvvvvv',
      'vvvvvvv'
    ], PlayerX := 1, PlayerY := 1, Facing := Protocol.FirstPersonFacing.East, Inventory := [],
    Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := [],
    Journal := []
  );
  const VisibleHostile: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(HostileAhead, 81, 31);
  var EmptyAhead: Protocol.FirstPersonVisibleState := HostileAhead;
  EmptyAhead.Rows[1] := '#.....#';
  // A currently visible opponent stands as a figure in front of the corridor.
  Test.AssertTrue(
    DifferentCells(VisibleHostile, Raycast.RenderFirstPersonGrid(EmptyAhead, 81, 31)) > 0
  );
  // A remembered opponent field shows only the corridor.
  HostileAhead.KnowledgeRows[1] := 'vrrvvvv';
  EmptyAhead.KnowledgeRows[1] := 'vrrvvvv';
  Test.AssertEquals(
    0,
    DifferentCells(
      Raycast.RenderFirstPersonGrid(HostileAhead, 81, 31),
      Raycast.RenderFirstPersonGrid(EmptyAhead, 81, 31)
    )
  );
end.
