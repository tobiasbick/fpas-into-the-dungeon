// Verifies that remembered geometry cannot become current first-person sight.
program FirstPersonFogTest;

uses Dungeon.Client.Raycast, Dungeon.Client.Raycast.Rays, Dungeon.Protocol, Std.Test, Std.Tui;

function Corridor(Remembered: boolean): FirstPersonVisibleState;
begin
  var Value: FirstPersonVisibleState := FirstPersonVisibleState(Title := 'Fog boundary', Status := 'Nothing in reach', Width := 7, Height := 3, Rows := [
                                                                                                                                                          '####???',
                                                                                                                                                          '#...???',
                                                                                                                                                          '####???'
                                                                                                                                                        ], KnowledgeRows := [
                                                                                                                                                                              'vvvvuuu',
                                                                                                                                                                              'vvvvuuu',
                                                                                                                                                                              'vvvvuuu'
                                                                                                                                                                            ], PlayerX := 1, PlayerY := 1, Facing := FirstPersonFacing.East, Inventory := [], Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []);
  if Remembered then
    begin
      Value.Rows := ['#######', '#....x#', '#######'];
      Value.KnowledgeRows := ['vvvvrrr', 'vvvvrrr', 'vvvvrrr'];
    end;
  end if;

  return Value;
end function;

// Counts cells whose glyph or either color differs between two equally sized grids.
function DifferentCells(Left: TuiCellGrid; Right: TuiCellGrid): integer;
begin
  var Count: integer := 0;
  for I: integer := 0 to Left.Cells.Length() - 1 do
    begin
      const A: TuiStyle := Left.Cells[I].ConcreteStyle.Unwrap();
      const B: TuiStyle := Right.Cells[I].ConcreteStyle.Unwrap();
      if (((Left.Cells[I].Glyph <> Right.Cells[I].Glyph) or (A.Background.Red <> B.Background.Red)) or ((A.Background.Green <> B.Background.Green) or (A.Background.Blue <> B.Background.Blue))) or
         (((A.Foreground.Red <> B.Foreground.Red) or (A.Foreground.Green <> B.Foreground.Green)) or (A.Foreground.Blue <> B.Foreground.Blue)) then
        begin
          Count := Count + 1;
        end;
      end if;
    end;
  end for;

  return Count;
end function;

begin
  const FogHit: FirstPersonRayHit := CastFirstPersonRay(Corridor(true), 0.0);
  AssertEquals('?', FogHit.FieldCode);
  AssertFalse(FogHit.SawExit);
  var Approached: FirstPersonVisibleState := Corridor(true);
  Approached.KnowledgeRows := ['vvvvvvv', 'vvvvvvv', 'vvvvvvv'];
  const VisibleHit: FirstPersonRayHit := CastFirstPersonRay(Approached, 0.0);
  AssertEquals('#', VisibleHit.FieldCode);
  AssertTrue(VisibleHit.SawExit);
  AssertTrue(FogHit.Distance < VisibleHit.Distance);
  // Same present sight, different exploration history: the 3-D picture must
  // not reveal the distant wall or exit just because they were visited earlier.
  for Width: integer in [21, 101] do
    begin
      const Unknown: TuiCellGrid := RenderFirstPersonGrid(Corridor(false), Width, 31);
      const Remembered: TuiCellGrid := RenderFirstPersonGrid(Corridor(true), Width, 31);
      for I: integer := 0 to Unknown.Cells.Length() - 1 do
        begin
          const A: TuiColor := Unknown.Cells[I].ConcreteStyle.Unwrap().Background;
          const B: TuiColor := Remembered.Cells[I].ConcreteStyle.Unwrap().Background;
          AssertEquals(A.Red, B.Red);
          AssertEquals(A.Green, B.Green);
          AssertEquals(A.Blue, B.Blue);
          AssertEquals(Unknown.Cells[I].Glyph, Remembered.Cells[I].Glyph);
        end;
      end for;
    end;
  end for;
  var HostileAhead: FirstPersonVisibleState := FirstPersonVisibleState(Title := 'Opponent visibility', Status := '', Width := 7, Height := 3, Rows := [
                                                                                                                                                        '#######',
                                                                                                                                                        '#.h...#',
                                                                                                                                                        '#######'
                                                                                                                                                      ], KnowledgeRows := [
                                                                                                                                                                            'vvvvvvv',
                                                                                                                                                                            'vvvvvvv',
                                                                                                                                                                            'vvvvvvv'
                                                                                                                                                                          ], PlayerX := 1, PlayerY := 1, Facing := FirstPersonFacing.East, Inventory := [], Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []);
  const VisibleHostile: TuiCellGrid := RenderFirstPersonGrid(HostileAhead, 81, 31);
  var EmptyAhead: FirstPersonVisibleState := HostileAhead;
  EmptyAhead.Rows[1] := '#.....#';
  // A currently visible opponent stands as a figure in front of the corridor.
  AssertTrue(DifferentCells(VisibleHostile, RenderFirstPersonGrid(EmptyAhead, 81, 31)) > 0);
  // A remembered opponent field shows only the corridor.
  HostileAhead.KnowledgeRows[1] := 'vrrvvvv';
  EmptyAhead.KnowledgeRows[1] := 'vrrvvvv';
  AssertEquals(0, DifferentCells(RenderFirstPersonGrid(HostileAhead, 81, 31), RenderFirstPersonGrid(EmptyAhead, 81, 31)));
end.
