// Verifies that remembered geometry cannot become current first-person sight.
program FirstPersonFogTest;

uses Dungeon.Client.Raycast, Dungeon.Protocol, Std.Arrays, Std.Options, Std.Test, Std.Tui;

function Corridor(Remembered: boolean): FirstPersonVisibleState;
begin
  mutable var Value: FirstPersonVisibleState := record
    Title := 'Fog boundary';
    Status := 'Nothing in reach';
    Width := 7;
    Height := 3;
    Rows := ['####???', '#...???', '####???'];
    KnowledgeRows := ['vvvvuuu', 'vvvvuuu', 'vvvvuuu'];
    PlayerX := 1;
    PlayerY := 1;
    Facing := FirstPersonFacing.East;
    Inventory := [];
    Health := 20;
    MaxHealth := 20;
    Character := [];
    CombatLog := [];
    CombatEvents := [];
  end;

  if Remembered then
  begin
    Value.Rows := ['#######', '#....x#', '#######'];
    Value.KnowledgeRows := ['vvvvrrr', 'vvvvrrr', 'vvvvrrr']
  end;

  return Value
end;

// Counts cells whose glyph or either color differs between two equally sized grids.
function DifferentCells(Left: TuiCellGrid; Right: TuiCellGrid): integer;
begin
  mutable var Count: integer := 0;
  for I: integer := 0 to Std.Arrays.Length(Left.Cells) - 1 do
  begin
    var A: TuiStyle := Std.Options.Unwrap(Left.Cells[I].ConcreteStyle);
    var B: TuiStyle := Std.Options.Unwrap(Right.Cells[I].ConcreteStyle);
    if (((Left.Cells[I].Glyph <> Right.Cells[I].Glyph) or (A.Background.Red <> B.Background.Red)) or ((A.Background.Green <> B.Background.Green) or (A.Background.Blue <> B.Background.Blue))) or
       (((A.Foreground.Red <> B.Foreground.Red) or (A.Foreground.Green <> B.Foreground.Green)) or (A.Foreground.Blue <> B.Foreground.Blue)) then
    begin
      Count := Count + 1
    end
  end;

  return Count
end;

begin
  var FogHit: FirstPersonRayHit := CastFirstPersonRay(Corridor(true), 0.0);
  AssertEquals('?', FogHit.FieldCode);
  AssertFalse(FogHit.SawExit);
  mutable var Approached: FirstPersonVisibleState := Corridor(true);
  Approached.KnowledgeRows := ['vvvvvvv', 'vvvvvvv', 'vvvvvvv'];
  var VisibleHit: FirstPersonRayHit := CastFirstPersonRay(Approached, 0.0);
  AssertEquals('#', VisibleHit.FieldCode);
  AssertTrue(VisibleHit.SawExit);
  AssertTrue(FogHit.Distance < VisibleHit.Distance);
  // Same present sight, different exploration history: the 3-D picture must
  // not reveal the distant wall or exit just because they were visited earlier.
  for Width: integer in [21, 101] do
  begin
    var Unknown: TuiCellGrid := RenderFirstPersonGrid(Corridor(false), Width, 31);
    var Remembered: TuiCellGrid := RenderFirstPersonGrid(Corridor(true), Width, 31);
    for I: integer := 0 to Std.Arrays.Length(Unknown.Cells) - 1 do
    begin
      var A: TuiColor := Std.Options.Unwrap(Unknown.Cells[I].ConcreteStyle).Background;
      var B: TuiColor := Std.Options.Unwrap(Remembered.Cells[I].ConcreteStyle).Background;
      AssertEquals(A.Red, B.Red);
      AssertEquals(A.Green, B.Green);
      AssertEquals(A.Blue, B.Blue);
      AssertEquals(Unknown.Cells[I].Glyph, Remembered.Cells[I].Glyph)
    end
  end;
  mutable var NpcAhead: FirstPersonVisibleState := record
    Title := 'NPC visibility';
    Status := '';
    Width := 7;
    Height := 3;
    Rows := ['#######', '#.n...#', '#######'];
    KnowledgeRows := ['vvvvvvv', 'vvvvvvv', 'vvvvvvv'];
    PlayerX := 1;
    PlayerY := 1;
    Facing := FirstPersonFacing.East;
    Inventory := [];
    Health := 20;
    MaxHealth := 20;
    Character := [];
    CombatLog := [];
    CombatEvents := [];
  end;
  var VisibleNpc: TuiCellGrid := RenderFirstPersonGrid(NpcAhead, 81, 31);
  mutable var EmptyAhead: FirstPersonVisibleState := NpcAhead;
  EmptyAhead.Rows[1] := '#.....#';
  // A currently visible NPC stands as a figure in front of the corridor.
  AssertTrue(DifferentCells(VisibleNpc, RenderFirstPersonGrid(EmptyAhead, 81, 31)) > 0);
  // A remembered NPC field shows nothing: the picture equals the same fog without an NPC.
  NpcAhead.KnowledgeRows[1] := 'vrrvvvv';
  EmptyAhead.KnowledgeRows[1] := 'vrrvvvv';
  AssertEquals(0, DifferentCells(RenderFirstPersonGrid(NpcAhead, 81, 31), RenderFirstPersonGrid(EmptyAhead, 81, 31)))
end.
