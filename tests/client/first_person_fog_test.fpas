// Verifies that remembered geometry cannot become current first-person sight.
program FirstPersonFogTest;

uses Dungeon.Client.Raycast, Dungeon.Protocol, Std.Arrays, Std.Options, Std.Test, Std.Tui;

function Corridor(Remembered: boolean): FirstPersonVisibleState;
begin
  mutable var Value: FirstPersonVisibleState := record
    Title := 'Fog boundary';
    Status := 'Nothing in reach';
    Width := 7;
    Height := 3;
    Rows := ['####???', '#...???', '####???'];
    KnowledgeRows := ['vvvvuuu', 'vvvvuuu', 'vvvvuuu'];
    PlayerX := 1;
    PlayerY := 1;
    Facing := FirstPersonFacing.East;
    Inventory := [];
  end;

  if Remembered then
  begin
    Value.Rows := ['#######', '#....x#', '#######'];
    Value.KnowledgeRows := ['vvvvrrr', 'vvvvrrr', 'vvvvrrr']
  end;

  return Value
end;

begin
  var FogHit: FirstPersonRayHit := CastFirstPersonRay(Corridor(true), 0.0);
  AssertEquals('?', FogHit.FieldCode);
  AssertFalse(FogHit.SawExit);
  mutable var Approached: FirstPersonVisibleState := Corridor(true);
  Approached.KnowledgeRows := ['vvvvvvv', 'vvvvvvv', 'vvvvvvv'];
  var VisibleHit: FirstPersonRayHit := CastFirstPersonRay(Approached, 0.0);
  AssertEquals('#', VisibleHit.FieldCode);
  AssertTrue(VisibleHit.SawExit);
  AssertTrue(FogHit.Distance < VisibleHit.Distance);
  // Same present sight, different exploration history: the 3-D picture must
  // not reveal the distant wall or exit just because they were visited earlier.
  for Width: integer in [21, 101] do
  begin
    var Unknown: TuiCellGrid := RenderFirstPersonGrid(Corridor(false), Width, 31);
    var Remembered: TuiCellGrid := RenderFirstPersonGrid(Corridor(true), Width, 31);
    for I: integer := 0 to Std.Arrays.Length(Unknown.Cells) - 1 do
    begin
      var A: TuiColor := Std.Options.Unwrap(Unknown.Cells[I].ConcreteStyle).Background;
      var B: TuiColor := Std.Options.Unwrap(Remembered.Cells[I].ConcreteStyle).Background;
      AssertEquals(A.Red, B.Red);
      AssertEquals(A.Green, B.Green);
      AssertEquals(A.Blue, B.Blue);
      AssertEquals(Unknown.Cells[I].Glyph, Remembered.Cells[I].Glyph)
    end
  end
end.
