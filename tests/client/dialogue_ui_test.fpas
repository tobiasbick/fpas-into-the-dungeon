// Verifies modal dialogue navigation, request gating, rendering, and lifecycle cleanup.
program DungeonDialogueUiTest;

uses
  Dungeon.Client, Dungeon.Protocol, Dungeon.RuntimeData, Std.Arrays, Std.Results, Std.Str, Std.Task,
  Std.Test, Std.Tui;

function MakeKey(Kind: TuiKeyKind; Character: string; Ctrl: boolean): TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := Character;
    shift := false;
    ctrl := Ctrl;
    alt := false;
    meta := false;
  end
end;

function ScreenContains(Snapshot: TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Row: integer := 0 to Snapshot.Height - 1 do
  begin
    if Std.Str.Contains(Snapshot.LineAt(Row), Text) then
    begin
      return true
    end
  end;

  return false
end;

function Frame(Text: string): VisibleDialogue;
begin
  return record
    NpcId := 'initial-dungeon:old-adventurer';
    Speaker := 'Mara, the old adventurer';
    Text := Text;
    Choices := [
                 record
                   Id := 'identity';
                   Text := 'Who are you?';
                 end,
                 record
                   Id := 'dungeon';
                   Text := 'What is this place?';
                 end,
                 record
                   Id := 'goodbye';
                   Text := 'Goodbye.';
                 end
               ];
  end
end;

begin
  var Requests: channel of ClientMessage := CreateChannel(4);
  var Events: channel of ClientEvent := CreateChannel(1);
  mutable var Model: ClientModel := NewClientModel('127.0.0.1', 4040, '', DefaultClientPreferences(), Requests, Events);
  Model.Screen := ClientScreen.GameScreen;
  Model.ConnectionPhase := ClientConnectionPhase.Active;
  Model.HasVisibleState := true;
  Model.View := ViewKind.FirstPerson;
  Model.ViewportWidth := 100;
  Model.ViewportHeight := 28;
  Model.Width := 3;
  Model.Height := 3;
  Model.Rows := ['###', '#.#', '###'];
  Model.KnowledgeRows := ['vvv', 'vvv', 'vvv'];
  Model.PlayerX := 1;
  Model.PlayerY := 1;
  Model.PrimaryTitle := 'Initial dungeon';
  var Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  Model := UpdateClientEvent(Model, ClientEvent.Dialogue(Frame('A weathered adventurer invites your questions about these old halls.')), Cmd);
  AssertTrue(Model.Overlay = ClientOverlay.DialogueOverlay);
  AssertEquals('initial-dungeon:old-adventurer', Model.DialogueNpcId);
  AssertEquals(0, Model.DialogueSelection);
  AssertEquals(3, Std.Arrays.Length(Model.DialogueChoices));
  AssertFalse(Model.Pending);
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(100, 28));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Mara, the old adventurer'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'A weathered adventurer invites'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), '> Who are you?'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'W/S or arrows select'));
  App.Close();
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Up, '', false)), Cmd);
  AssertEquals(2, Model.DialogueSelection);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Down, '', false)), Cmd);
  AssertEquals(0, Model.DialogueSelection);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Character, 's', false)), Cmd);
  AssertEquals(1, Model.DialogueSelection);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Character, 'w', false)), Cmd);
  AssertEquals(0, Model.DialogueSelection);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Character, 's', false)), Cmd);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Enter, '', false)), Cmd);
  AssertTrue(Model.Pending);
  AssertEquals('Responding...', Model.Status);
  case Unwrap(ReceiveWithTimeout(Requests, 0)) of
    ClientMessage.DialogueChoice(ChoiceId):
    begin
      AssertEquals('dungeon', ChoiceId)
    end
    else
    begin
      panic('expected selected dialogue choice')
    end
  end;

  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Escape, '', false)), Cmd);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Character, 'd', false)), Cmd);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Character, 'p', true)), Cmd);
  AssertTrue(Model.Overlay = ClientOverlay.DialogueOverlay);
  AssertEquals(1, Model.DialogueSelection);
  AssertTrue(IsError(ReceiveWithTimeout(Requests, 0)));
  Model := UpdateClientEvent(Model, ClientEvent.Rejected('dialogue_choice_rejected', 'Unknown choice.'), Cmd);
  AssertFalse(Model.Pending);
  AssertTrue(Model.Overlay = ClientOverlay.DialogueOverlay);
  AssertEquals(1, Model.DialogueSelection);
  AssertEquals('Unknown choice.', Model.Status);
  Model := UpdateClientEvent(Model, ClientEvent.Dialogue(Frame('Mara describes a corridor that bends beyond the torchlight.')), Cmd);
  AssertFalse(Model.Pending);
  AssertEquals(0, Model.DialogueSelection);
  AssertTrue(Model.Overlay = ClientOverlay.DialogueOverlay);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Character, 'd', false)), Cmd);
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Character, 'p', true)), Cmd);
  AssertTrue(Model.Overlay = ClientOverlay.DialogueOverlay);
  AssertTrue(IsError(ReceiveWithTimeout(Requests, 0)));
  Model := UpdateClient(Model, TuiMsg.Key(MakeKey(TuiKeyKind.Escape, '', false)), Cmd);
  AssertTrue(Model.Pending);
  AssertEquals('Ending conversation...', Model.Status);
  case Unwrap(ReceiveWithTimeout(Requests, 0)) of
    ClientMessage.EndDialogue:
    begin
    end
    else
    begin
      panic('expected end-dialogue intention')
    end
  end;

  Model := UpdateClientEvent(Model, ClientEvent.DialogueEnded, Cmd);
  AssertFalse(Model.Pending);
  AssertTrue(Model.Overlay = ClientOverlay.NoOverlay);
  AssertEquals('', Model.DialogueNpcId);
  AssertEquals('', Model.DialogueSpeaker);
  AssertEquals('', Model.DialogueText);
  AssertEquals(0, Std.Arrays.Length(Model.DialogueChoices));
  AssertEquals('Connected', Model.Status);
  Model := UpdateClientEvent(Model, ClientEvent.Dialogue(Frame('This deliberately long sentence must wrap inside a narrow dialogue overlay without losing its choices or controls.')), Cmd);
  Model.ViewportWidth := 48;
  Model.ViewportHeight := 18;
  var NarrowApp: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(48, 18));
  Model := NarrowApp.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(NarrowApp.SurfaceSnapshot(), 'Mara, the old adventurer'));
  AssertTrue(ScreenContains(NarrowApp.SurfaceSnapshot(), 'deliberately long sentence'));
  AssertTrue(ScreenContains(NarrowApp.SurfaceSnapshot(), 'Goodbye.'));
  AssertTrue(ScreenContains(NarrowApp.SurfaceSnapshot(), 'Esc leave'));
  NarrowApp.Close();
  CloseChannel(Requests);
  CloseChannel(Events)
end.
