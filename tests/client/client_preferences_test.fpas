// Verifies client panel preferences are loaded and persisted outside gameplay state.
program DungeonClientPreferencesTest;

uses
  Dungeon.Client, Dungeon.Protocol, Dungeon.RuntimeData, Std.Conv, Std.Fs, Std.Tasks, Std.Test,
  Std.Time, Std.Tui;

function FunctionKey(Kind: TuiKeyKind): TuiKeyEvent;
begin
  return TuiKeyEvent(kind := Kind, ch := '', shift := false, ctrl := false, alt := false, meta := false);
end function;

begin
  const Root: string := '.temp-data/client-preferences-' + IntToStr(TimestampMillis());
  if not Std.Fs.Exists('.temp-data') then
    begin
      AssertTrue(Std.Fs.CreateDir('.temp-data').Unwrap());
    end;
  end if;
  var Runtime: RuntimeSettings := LoadClientRuntime(Some(Root)).Unwrap();
  const Requests: channel of ClientMessage := CreateChannel(4);
  const Events: channel of ClientEvent := CreateChannel(1);
  var Model: ClientModel := NewClientModel('temporary.example', 5050, Runtime.Paths.ClientConfig, Runtime.Preferences, Requests, Events);
  AssertTrue(Model.ContextPanelVisible);
  AssertFalse(Model.MessagePanelVisible);
  Model.Screen := ClientScreen.GameScreen;
  Model.ConnectionPhase := ClientConnectionPhase.Active;
  Model.ViewportWidth := 120;
  Model.ViewportHeight := 30;
  Model.RequestedWorldWidth := 39;
  Model.RequestedWorldHeight := 25;
  const Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  Model := UpdateClient(Model, TuiMsg.Key(FunctionKey(TuiKeyKind.F2)), Cmd);
  AssertFalse(Model.ContextPanelVisible);
  Runtime := LoadClientRuntime(Some(Root)).Unwrap();
  AssertFalse(Runtime.Preferences.ContextPanelVisible);
  AssertFalse(Runtime.Preferences.MessagePanelVisible);
  AssertEquals('127.0.0.1', Runtime.Network.Host);
  AssertEquals(4040, Runtime.Network.Port);
  Model.Pending := false;
  Model := UpdateClient(Model, TuiMsg.Key(FunctionKey(TuiKeyKind.F3)), Cmd);
  AssertTrue(Model.MessagePanelVisible);
  Runtime := LoadClientRuntime(Some(Root)).Unwrap();
  AssertFalse(Runtime.Preferences.ContextPanelVisible);
  AssertTrue(Runtime.Preferences.MessagePanelVisible);
  AssertEquals('127.0.0.1', Runtime.Network.Host);
  AssertEquals(4040, Runtime.Network.Port);
  const ReconnectedRequests: channel of ClientMessage := CreateChannel(1);
  const ReconnectedEvents: channel of ClientEvent := CreateChannel(1);
  const Reconnected: ClientModel := NewClientModel('temporary.example', 5050, Runtime.Paths.ClientConfig, Runtime.Preferences, ReconnectedRequests, ReconnectedEvents);
  AssertFalse(Reconnected.ContextPanelVisible);
  AssertTrue(Reconnected.MessagePanelVisible);
  AssertFalse(Reconnected.HasVisibleState);
  AssertTrue(Reconnected.ConnectionPhase = ClientConnectionPhase.Offline);
  discard CloseChannel(Requests);
  discard CloseChannel(Events);
  discard CloseChannel(ReconnectedRequests);
  discard CloseChannel(ReconnectedEvents);
end.
