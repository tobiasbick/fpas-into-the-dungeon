// Verifies client panel preferences are loaded and persisted outside gameplay state.
program DungeonClientPreferencesTest;

uses Dungeon.Client as Client, Dungeon.Protocol as Protocol, Dungeon.RuntimeData as RuntimeData, Std.Conv as Conv, Std.Fs as Fs, Std.Tasks as Tasks, Std.Test as Test, Std.Time as Time, Std.Tui as Tui;

function FunctionKey(Kind: Tui.TuiKeyKind): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(
    kind := Kind,
    ch := '',
    shift := false,
    ctrl := false,
    alt := false,
    meta := false
  );
end function;

begin
  const Root: string := '.temp-data/client-preferences-' + Conv.IntToStr(Time.TimestampMillis());
  if not Fs.Exists('.temp-data') then
    begin
      Test.AssertTrue(Fs.CreateDir('.temp-data').Unwrap());
    end;
  end if;
  var Runtime: RuntimeData.RuntimeSettings := RuntimeData.LoadClientRuntime(Some(Root)).Unwrap();
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(4);
  const Events: channel of Client.ClientEvent := Tasks.CreateChannel(1);
  var Model: Client.ClientModel := Client.NewClientModel(
    'temporary.example',
    5050,
    Runtime.Paths.ClientConfig,
    Runtime.Preferences,
    Requests,
    Events
  );
  Test.AssertTrue(Model.ContextPanelVisible);
  Test.AssertFalse(Model.MessagePanelVisible);
  Model.Screen := Client.ClientScreen.GameScreen;
  Model.ConnectionPhase := Client.ClientConnectionPhase.Active;
  Model.ViewportWidth := 120;
  Model.ViewportHeight := 30;
  Model.RequestedWorldWidth := 39;
  Model.RequestedWorldHeight := 25;
  const Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  Model := Client.UpdateClient(Model, Tui.TuiMsg.Key(FunctionKey(Tui.TuiKeyKind.F2)), Cmd);
  Test.AssertFalse(Model.ContextPanelVisible);
  Runtime := RuntimeData.LoadClientRuntime(Some(Root)).Unwrap();
  Test.AssertFalse(Runtime.Preferences.ContextPanelVisible);
  Test.AssertFalse(Runtime.Preferences.MessagePanelVisible);
  Test.AssertEquals('127.0.0.1', Runtime.Network.Host);
  Test.AssertEquals(4040, Runtime.Network.Port);
  Model.Pending := false;
  Model := Client.UpdateClient(Model, Tui.TuiMsg.Key(FunctionKey(Tui.TuiKeyKind.F3)), Cmd);
  Test.AssertTrue(Model.MessagePanelVisible);
  Runtime := RuntimeData.LoadClientRuntime(Some(Root)).Unwrap();
  Test.AssertFalse(Runtime.Preferences.ContextPanelVisible);
  Test.AssertTrue(Runtime.Preferences.MessagePanelVisible);
  Test.AssertEquals('127.0.0.1', Runtime.Network.Host);
  Test.AssertEquals(4040, Runtime.Network.Port);
  const ReconnectedRequests: channel of Protocol.ClientMessage := Tasks.CreateChannel(1);
  const ReconnectedEvents: channel of Client.ClientEvent := Tasks.CreateChannel(1);
  const Reconnected: Client.ClientModel := Client.NewClientModel(
    'temporary.example',
    5050,
    Runtime.Paths.ClientConfig,
    Runtime.Preferences,
    ReconnectedRequests,
    ReconnectedEvents
  );
  Test.AssertFalse(Reconnected.ContextPanelVisible);
  Test.AssertTrue(Reconnected.MessagePanelVisible);
  Test.AssertFalse(Reconnected.HasVisibleState);
  Test.AssertTrue(Reconnected.ConnectionPhase = Client.ClientConnectionPhase.Offline);
  discard Tasks.CloseChannel(Requests);
  discard Tasks.CloseChannel(Events);
  discard Tasks.CloseChannel(ReconnectedRequests);
  discard Tasks.CloseChannel(ReconnectedEvents);
end.
