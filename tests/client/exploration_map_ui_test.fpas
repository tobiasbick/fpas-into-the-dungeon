// Verifies three-state map styling, overlay controls, serialized panning, and compact rendering.
program DungeonExplorationMapUiTest;

uses Dungeon.Client as ClientUnit, Dungeon.Protocol as Protocol, Dungeon.RuntimeData as RuntimeData, Std.Tasks as Tasks, Std.Test as Test, Std.Tui as Tui;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(
    kind := Kind,
    ch := Character,
    shift := false,
    ctrl := false,
    alt := false,
    meta := false
  );
end function;

function UniformRows(Width: integer; Height: integer; Code: string): array of string;
begin
  var Rows: array of string := [];
  for Y: integer := 0 to Height - 1 do
    begin
      Rows.PushInPlace(Code.RepeatStr(Width));
    end;
  end for;

  return Rows;
end function;

function MapResponse(
  OriginX: integer;
  OriginY: integer;
  Width: integer;
  Height: integer;
  PlayerX: integer;
  PlayerY: integer;
  PlayerInWindow: boolean
): Protocol.ExplorationMapState;
begin
  var KnowledgeRows: array of string := UniformRows(Width, Height, 'r');
  if PlayerInWindow then
    begin
      const LocalX: integer := PlayerX - OriginX;
      const LocalY: integer := PlayerY - OriginY;
      KnowledgeRows[LocalY] := KnowledgeRows[LocalY].SetCharAt(LocalX, 'v');
    end;
  end if;

  return Protocol.ExplorationMapState(
    View := Protocol.ViewKind.Map,
    LabelText := 'Outdoor region',
    OriginX := OriginX,
    OriginY := OriginY,
    Width := Width,
    Height := Height,
    Rows := UniformRows(Width, Height, 'g'),
    KnowledgeRows := KnowledgeRows,
    PlayerWorldX := PlayerX,
    PlayerWorldY := PlayerY,
    PlayerInWindow := PlayerInWindow
  );
end function;

function ViewportReply(State: ClientUnit.ClientModel): ClientUnit.ClientEvent;
begin
  return ClientUnit.ClientEvent.ViewportState(
    Protocol.VisibleState.MapState(
      Protocol.MapVisibleState(
        Weather := Some(Protocol.WeatherKind.Clear),
        Time := Protocol.VisibleTime(Day := 1, MinuteOfDay := 480, Phase := Protocol.DayPhase.Day),
        Coins := 0,
        OriginX := State.OriginX, OriginY := State.OriginY, Width := State.Width,
        Height := State.Height,
        Rows := State.Rows, KnowledgeRows := State.KnowledgeRows, PlayerX := State.PlayerX,
        PlayerY := State.PlayerY,
        WorldX := State.WorldX, WorldY := State.WorldY, Inventory := State.Inventory,
        Health := State.Health, MaxHealth := State.MaxHealth, Character := State.Character,
        Journal := []
      )
    )
  );
end function;

function SurfaceContains(Surface: Tui.TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Y: integer := 0 to Surface.Height - 1 do
    begin
      if Text in Surface.LineAt(Y) then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

function CountGlyph(Surface: Tui.TuiSurfaceSnapshot; Glyph: string): integer;
begin
  var Count: integer := 0;
  for Y: integer := 0 to Surface.Height - 1 do
    begin
      for X: integer := 0 to Surface.Width - 1 do
        begin
          if Surface.CellAt(X, Y).Glyph = Glyph then
            begin
              Count := Count + 1;
            end;
          end if;
        end;
      end for;
    end;
  end for;

  return Count;
end function;

begin
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(4);
  const Events: channel of ClientUnit.ConnectionEvent := Tasks.CreateChannel(4);
  var Model: ClientUnit.ClientModel := ClientUnit.NewClientModel(
    '127.0.0.1',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    Requests,
    Events
  );
  const Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  Model.ViewportWidth := 30;
  Model.ViewportHeight := 12;
  Model := ClientUnit.UpdateClientEvent(
    Model, ClientUnit.ClientEvent.State(
      Protocol.VisibleState.MapState(
        Protocol.MapVisibleState(
          Weather := Some(Protocol.WeatherKind.Clear),
          Time := Protocol.VisibleTime(
            Day := 1,
            MinuteOfDay := 480,
            Phase := Protocol.DayPhase.Day
          ),
          Coins := 0,
          OriginX := 9, OriginY := 20, Width := 3, Height := 1, Rows := [
            '?ge'
          ], KnowledgeRows := [
            'urv'
          ], PlayerX := 2, PlayerY := 0, WorldX := 11, WorldY := 20, Inventory := [], Health := 20,
          MaxHealth := 20, Character := [], Journal := []
        )
      )
    ), Cmd
  );
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.Viewport(const Width, const Height):
      null;
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected initial viewport synchronization');
  end case;

  Model.Pending := false;
  var WideModel: ClientUnit.ClientModel := Model;
  WideModel.ViewportWidth := 100;
  WideModel.ViewportHeight := 40;
  WideModel.MapRequestPending := false;
  WideModel := ClientUnit.UpdateClient(
    WideModel,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'm')),
    Cmd
  );
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height):
      Test.AssertEquals(76, Width);
      Test.AssertEquals(26, Height);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected proportionally inset exploration-map request');
  end case;
  const App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(30, 12));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertEquals(' ', App.SurfaceSnapshot().CellAt(1, 1).Glyph);
  Test.AssertEquals(9, App.SurfaceSnapshot().CellAt(1, 1).ConcreteStyle.Unwrap().Background.Red);
  const Remembered: Tui.TuiStyle := App.SurfaceSnapshot().CellAt(3, 1).ConcreteStyle.Unwrap();
  Test.AssertFalse(Remembered.Dim);
  Test.AssertEquals(20, Remembered.Background.Red);
  Test.AssertEquals(46, Remembered.Background.Green);
  Test.AssertEquals(26, Remembered.Background.Blue);
  Test.AssertEquals(68, Remembered.Foreground.Red);
  Test.AssertEquals(93, Remembered.Foreground.Green);
  Test.AssertEquals(55, Remembered.Foreground.Blue);
  Test.AssertEquals('●', App.SurfaceSnapshot().CellAt(5, 1).Glyph);
  Model := ClientUnit.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'm')),
    Cmd
  );
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.ExplorationMapOverlay);
  Test.AssertTrue(Model.MapRequestPending);
  Test.AssertEquals(-2, Model.MapDesiredOriginX);
  Test.AssertEquals(17, Model.MapDesiredOriginY);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height):
      Test.AssertEquals(-2, OriginX);
      Test.AssertEquals(17, OriginY);
      Test.AssertEquals(26, Width);
      Test.AssertEquals(6, Height);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected centered exploration-map request');
  end case;

  Model := ClientUnit.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'w')),
    Cmd
  );
  Model := ClientUnit.UpdateClient(Model, Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Right, '')), Cmd);
  Model := ClientUnit.UpdateClient(Model, Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Down, '')), Cmd);
  Test.AssertEquals(-1, Model.MapDesiredOriginX);
  Test.AssertEquals(17, Model.MapDesiredOriginY);
  Test.AssertTrue(Tasks.ReceiveWithTimeout(Requests, 0) is Error(_));
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.ExplorationMap(MapResponse(-2, 17, 26, 6, 11, 20, true)),
    Cmd
  );
  Test.AssertTrue(Model.MapRequestPending);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height):
      Test.AssertEquals(-1, OriginX);
      Test.AssertEquals(17, OriginY);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected one coalesced latest map request');
  end case;

  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.ExplorationMap(MapResponse(-1, 17, 26, 6, 11, 20, true)),
    Cmd
  );
  Test.AssertFalse(Model.MapRequestPending);
  Test.AssertTrue(Model.MapHasState);
  Test.AssertTrue(Tasks.ReceiveWithTimeout(Requests, 0) is Error(_));
  // Resize and Home must keep the received dimensions until replacement arrives.
  var Resized: ClientUnit.ClientModel := Model;
  Resized := ClientUnit.UpdateClient(Resized, Tui.TuiMsg.Resize(Tui.TuiSize.Create(100, 40)), Cmd);
  Test.AssertTrue(Resized.Pending);
  Test.AssertTrue(
    Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() is Protocol.ClientMessage.Viewport(_, _)
  );
  Resized := ClientUnit.UpdateClientEvent(Resized, ViewportReply(Resized), Cmd);
  Test.AssertFalse(Resized.Pending);
  Test.AssertTrue(Resized.Overlay = ClientUnit.ClientOverlay.ExplorationMapOverlay);
  Resized := ClientUnit.UpdateClient(
    Resized,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Home, '')),
    Cmd
  );
  Test.AssertEquals(26, Resized.MapWidth);
  Test.AssertEquals(6, Resized.MapHeight);
  Test.AssertEquals(76, Resized.MapDesiredWidth);
  Test.AssertEquals(26, Resized.MapDesiredHeight);
  Resized := App.RunIterations(Resized, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.ExplorationMap(const OX, const OY, const W, const H):
      Resized := ClientUnit.UpdateClientEvent(
        Resized,
        ClientUnit.ClientEvent.ExplorationMap(MapResponse(OX, OY, W, H, 11, 20, true)),
        Cmd
      );
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected resized map request');
  end case;

  Test.AssertEquals(76, Resized.MapWidth);
  Test.AssertEquals(26, Resized.MapHeight);
  // Closing and reopening cannot reset a live request or enqueue another one.
  var Reopened: ClientUnit.ClientModel := Model;
  Reopened := ClientUnit.UpdateClient(
    Reopened,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'd')),
    Cmd
  );
  const Outstanding: Protocol.ClientMessage := Tasks.ReceiveWithTimeout(Requests, 0).Unwrap();
  Reopened := ClientUnit.UpdateClient(
    Reopened,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'm')),
    Cmd
  );
  Reopened := ClientUnit.UpdateClient(
    Reopened,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'm')),
    Cmd
  );
  Test.AssertTrue(Reopened.MapRequestPending);
  Test.AssertTrue(Tasks.ReceiveWithTimeout(Requests, 0) is Error(_));
  case Outstanding of
    when Protocol.ClientMessage.ExplorationMap(const OX, const OY, const W, const H):
      Reopened := ClientUnit.UpdateClientEvent(
        Reopened,
        ClientUnit.ClientEvent.ExplorationMap(MapResponse(OX, OY, W, H, 11, 20, true)),
        Cmd
      );
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected outstanding map request');
  end case;

  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.ExplorationMap(const OX, const OY, const W, const H):
      Reopened := ClientUnit.UpdateClientEvent(
        Reopened,
        ClientUnit.ClientEvent.ExplorationMap(MapResponse(OX, OY, W, H, 11, 20, true)),
        Cmd
      );
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected one coalesced reopen request');
  end case;

  Test.AssertFalse(Reopened.MapRequestPending);
  Test.AssertTrue(Tasks.ReceiveWithTimeout(Requests, 0) is Error(_));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(SurfaceContains(App.SurfaceSnapshot(), 'Map - Outdoor region'));
  Test.AssertEquals(1, CountGlyph(App.SurfaceSnapshot(), '●'));
  // Pending updates must not move or resize the already displayed map overlay.
  const ReadySurface: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  var Updating: ClientUnit.ClientModel := Model;
  Updating.MapRequestPending := true;
  Updating.Status := 'Updating map...';
  Updating := App.RunIterations(Updating, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  for Y: integer := 0 to ReadySurface.Height - 4 do
    begin
      Test.AssertEquals(ReadySurface.LineAt(Y), App.SurfaceSnapshot().LineAt(Y));
    end;
  end for;

  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.ExplorationMap(MapResponse(-1, 17, 26, 6, 100, 100, false)),
    Cmd
  );
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertEquals(0, CountGlyph(App.SurfaceSnapshot(), '●'));
  Model := ClientUnit.UpdateClient(Model, Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Home, '')), Cmd);
  Test.AssertEquals(-2, Model.MapDesiredOriginX);
  Test.AssertEquals(17, Model.MapDesiredOriginY);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height):
      Test.AssertEquals(-2, OriginX);
      Test.AssertEquals(17, OriginY);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected recentered map request');
  end case;
  // A rejection of another intention must not resolve the in-flight map request.
  const OtherRejection: ClientUnit.ClientModel := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.Rejected('movement_rejected', 'Blocked.'),
    Cmd
  );
  Test.AssertTrue(OtherRejection.MapRequestPending);
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.MapRejected('map_failed', 'Map unavailable.'),
    Cmd
  );
  Test.AssertFalse(Model.MapRequestPending);
  Test.AssertTrue(Model.MapHasState);
  Test.AssertEquals('Map unavailable.', Model.Status);
  Model := ClientUnit.UpdateClient(Model, Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Escape, '')), Cmd);
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.NoOverlay);
  Model := ClientUnit.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'm')),
    Cmd
  );
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.ExplorationMapOverlay);
  Model := ClientUnit.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'm')),
    Cmd
  );
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.NoOverlay);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height):
      Model := ClientUnit.UpdateClientEvent(
        Model,
        ClientUnit.ClientEvent.ExplorationMap(
          MapResponse(OriginX, OriginY, Width, Height, 11, 20, true)
        ),
        Cmd
      );
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected map request before M closes the overlay');
  end case;

  Model := ClientUnit.UpdateClientEvent(
    Model, ClientUnit.ClientEvent.State(
      Protocol.VisibleState.FirstPersonState(
        Protocol.FirstPersonVisibleState(
          Weather := None,
          Time := Protocol.VisibleTime(
            Day := 1,
            MinuteOfDay := 480,
            Phase := Protocol.DayPhase.Day
          ),
          Coins := 0,
          Title := 'Interior', Status := 'Explore.', Level := 0, Depth := 1, Width := 3,
          Height := 3, Rows := [
            '###',
            '#.#',
            '###'
          ], KnowledgeRows := [
            'vvv',
            'vvv',
            'vvv'
          ], PlayerX := 1, PlayerY := 1, Facing := Protocol.FirstPersonFacing.North,
          Inventory := [], Health := 20, MaxHealth := 20, Character := [], CombatLog := [],
          CombatEvents := [], Journal := []
        )
      )
    ), Cmd
  );
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.Viewport(const Width, const Height):
      null;
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected first-person viewport synchronization');
  end case;

  Model.Pending := false;
  Model := ClientUnit.UpdateClient(
    Model,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'm')),
    Cmd
  );
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.ExplorationMapOverlay);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height):
      Test.AssertEquals(-12, OriginX);
      Test.AssertEquals(-2, OriginY);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected centered interior map request');
  end case;
  const InteriorMapWidth: integer := Model.MapDesiredWidth;
  const InteriorMapHeight: integer := Model.MapDesiredHeight;
  var InteriorRows: array of string := UniformRows(InteriorMapWidth, InteriorMapHeight, '.');
  var InteriorKnowledge: array of string := UniformRows(InteriorMapWidth, InteriorMapHeight, 'r');
  InteriorRows[2] := InteriorRows[2].SetCharAt(21, '#');
  InteriorRows[3] := InteriorRows[3].SetCharAt(14, 'i');
  InteriorRows[3] := InteriorRows[3].SetCharAt(15, 'p');
  InteriorKnowledge[3] := InteriorKnowledge[3].SetCharAt(13, 'v');
  InteriorKnowledge[3] := InteriorKnowledge[3].SetCharAt(15, 'v');
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.ExplorationMap(
      Protocol.ExplorationMapState(
        View := Protocol.ViewKind.FirstPerson,
        LabelText := 'Initial dungeon',
        OriginX := -12,
        OriginY := -2,
        Width := InteriorMapWidth,
        Height := InteriorMapHeight,
        Rows := InteriorRows,
        KnowledgeRows := InteriorKnowledge,
        PlayerWorldX := 1,
        PlayerWorldY := 1,
        PlayerInWindow := true
      )
    ),
    Cmd
  );
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(CountGlyph(App.SurfaceSnapshot(), '█') > 0);
  Test.AssertTrue(CountGlyph(App.SurfaceSnapshot(), '●') > 1);
  Test.AssertEquals(1, CountGlyph(App.SurfaceSnapshot(), '!'));
  App.Close();
  Model.ViewportWidth := 10;
  Model.ViewportHeight := 5;
  const TinyApp: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(10, 5));
  Model := TinyApp.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertEquals(10, TinyApp.SurfaceSnapshot().Width);
  Test.AssertEquals(5, TinyApp.SurfaceSnapshot().Height);
  Model := ClientUnit.UpdateClient(Model, Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Escape, '')), Cmd);
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.NoOverlay);
  TinyApp.Close();
  var Offline: ClientUnit.ClientModel := ClientUnit.NewClientModel(
    '127.0.0.1',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    Requests,
    Events
  );
  Offline := ClientUnit.UpdateClient(
    Offline,
    Tui.TuiMsg.Key(MakeKey(Tui.TuiKeyKind.Character, 'm')),
    Cmd
  );
  Test.AssertTrue(Offline.Overlay = ClientUnit.ClientOverlay.NoOverlay);
  discard Tasks.CloseChannel(Requests);
  discard Tasks.CloseChannel(Events);
end.
