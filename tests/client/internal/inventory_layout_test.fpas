// Checks text-cell clipping and bounded inventory summaries at exact, empty and overflow boundaries.
program InventoryLayoutTest;

uses Dungeon.Client.Character as Character, Dungeon.Client.Ui.Layout as Layout, Dungeon.Protocol as Protocol, Std.Console as Console, Std.Text.Format as Conv, Std.Test as Test;

begin
  Test.AssertEquals('', Layout.FitLine('abc', -1));
  Test.AssertEquals('', Layout.FitLine('abc', 0));
  Test.AssertEquals('', Layout.FitLine('', 5));
  Test.AssertEquals('abc', Layout.FitLine('abc', 3));
  Test.AssertEquals('.', Layout.FitLine('abc', 1));
  Test.AssertEquals('..', Layout.FitLine('abc', 2));
  Test.AssertEquals('...', Layout.FitLine('abcd', 3));
  Test.AssertEquals('a...', Layout.FitLine('abcde', 4));
  Test.AssertEquals('界...', Layout.FitLine('界界界', 5));
  Test.AssertEquals('界界', Layout.FitLine('界界', 4));
  const Accent := 'e' + '́';
  Test.AssertEquals(Accent + '...', Layout.FitLine(Accent.RepeatStr(5), 4));
  Test.AssertEquals(Accent.RepeatStr(4), Layout.FitLine(Accent.RepeatStr(4), 4));
  for Width: integer := 1 to 8 do
    const Clipped := Layout.FitLine('界' + Accent + 'abcde', Width);
    Test.AssertTrue(Console.DisplayWidth(Clipped) <= Width);
    for Glyph: string in Console.SplitGraphemes(Clipped) do
      Test.AssertTrue(Console.GraphemeWidth(Glyph) > 0);
    end for;
  end for;
  var Inventory: array of Protocol.VisibleInventoryItem := [];
  Test.AssertEquals(0, Character.QuickInventoryLines([], 0).Length());
  Test.AssertEquals(0, Character.QuickInventoryLines([], -1).Length());
  Test.AssertEquals('Empty', Character.QuickInventoryLines([], 1)[0]);
  for Index: integer := 0 to 4 do
    Inventory.PushInPlace(
      Protocol.VisibleInventoryItem(
        Id := 'item-' + Conv.IntToStr(Index), Name := 'Name ' + Conv.IntToStr(Index),
        Slot := Protocol.VisibleItemSlot.NoSlot, Equipped := false, Usable := false
      )
    );
    const Lines := Character.QuickInventoryLines(Inventory, 4);
    if Index < 4 then
      Test.AssertEquals(Index + 1, Lines.Length());
      Test.AssertEquals('Name ' + Conv.IntToStr(Index), Lines[Index]);
    else
      Test.AssertEquals(4, Lines.Length());
      Test.AssertEquals('Name 2', Lines[2]);
      Test.AssertEquals('+2 more (I)', Lines[3]);
    end if;
  end for;

  Test.AssertEquals(4, Character.QuickInventoryLines(Inventory, 100).Length());
  const OneRow := Character.QuickInventoryLines(Inventory, 1);
  Test.AssertEquals(1, OneRow.Length());
  Test.AssertEquals('5 items (I)', OneRow[0]);
  const TwoRows := Character.QuickInventoryLines(Inventory, 2);
  Test.AssertEquals('Name 0', TwoRows[0]);
  Test.AssertEquals('+4 more (I)', TwoRows[1]);
  // Worn entries never occupy the carried summary or inflate its hidden count.
  Inventory[0] := Inventory[0] with Equipped := true; Slot := Protocol.VisibleItemSlot.Weapon; end with;
  const Carried := Character.QuickInventoryLines(Inventory, 2);
  Test.AssertEquals('Name 1', Carried[0]);
  Test.AssertEquals('+3 more (I)', Carried[1]);
  Test.AssertEquals('Empty', Character.QuickInventoryLines([Inventory[0]], 4)[0]);
end.
