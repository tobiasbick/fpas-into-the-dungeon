// Verifies settlement gate markers in the primary map and exploration overlay, including Fog of War.
program SettlementMapRenderTest;

uses
  Dungeon.Client.Model as Model, Dungeon.Client.Ui.MapCells as MapCells, Dungeon.Protocol as Protocol,
  Dungeon.RuntimeData as RuntimeData, Std.Tasks as Tasks, Std.Test as Test;

begin
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(1);
  const Events: channel of Model.ConnectionEvent := Tasks.CreateChannel(1);
  var State := Model.NewClientModel(
    '127.0.0.1',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    Requests,
    Events
  );
  State.Width := 4;
  State.Height := 1;
  State.Rows := ['gss?'];
  State.KnowledgeRows := ['vvru'];
  State.PlayerX := 0;
  State.PlayerY := 0;
  const Primary := MapCells.MapGrid(State);
  Test.AssertEquals('⌂', Primary.Cells[2].Glyph);
  Test.AssertEquals('⌂', Primary.Cells[4].Glyph);
  Test.AssertTrue(
    Primary.Cells[4].ConcreteStyle.Unwrap().Foreground.Red <
    Primary.Cells[2].ConcreteStyle.Unwrap().Foreground.Red
  );
  Test.AssertEquals(' ', Primary.Cells[6].Glyph);
  State.MapView := Protocol.ViewKind.Map;
  State.MapWidth := 4;
  State.MapHeight := 1;
  State.MapRows := State.Rows;
  State.MapKnowledgeRows := State.KnowledgeRows;
  State.MapPlayerInWindow := true;
  State.MapPlayerWorldX := 0;
  State.MapPlayerWorldY := 0;
  const Overlay := MapCells.ExplorationMapGrid(State);
  Test.AssertEquals('⌂', Overlay.Cells[1].Glyph);
  Test.AssertEquals('⌂', Overlay.Cells[2].Glyph);
  Test.AssertEquals(' ', Overlay.Cells[3].Glyph);
  State.Width := 7;
  State.Rows := ['.#xn.n?'];
  State.KnowledgeRows := ['vvvvvuu'];
  State.PlayerX := 0;
  const Settlement := MapCells.MapGrid(State);
  Test.AssertEquals('▩', Settlement.Cells[2].Glyph);
  Test.AssertEquals('⌂', Settlement.Cells[4].Glyph);
  Test.AssertEquals('M', Settlement.Cells[6].Glyph);
  Test.AssertEquals('·', Settlement.Cells[8].Glyph);
  Test.AssertEquals(' ', Settlement.Cells[10].Glyph);
  State.MapWidth := 7;
  State.MapRows := State.Rows;
  State.MapKnowledgeRows := State.KnowledgeRows;
  const SettlementOverlay := MapCells.ExplorationMapGrid(State);
  Test.AssertEquals('▩', SettlementOverlay.Cells[1].Glyph);
  Test.AssertEquals('⌂', SettlementOverlay.Cells[2].Glyph);
  Test.AssertEquals('M', SettlementOverlay.Cells[3].Glyph);
  Test.AssertEquals('·', SettlementOverlay.Cells[4].Glyph);
  Test.AssertEquals(' ', SettlementOverlay.Cells[5].Glyph);
  State.DayPhase := Protocol.DayPhase.Night;
  const Night := MapCells.MapGrid(State);
  const NightOverlay := MapCells.ExplorationMapGrid(State);
  Test.AssertEquals(Settlement.Cells[2].Glyph, Night.Cells[2].Glyph);
  Test.AssertEquals(
    Settlement.Cells[2].ConcreteStyle.Unwrap().Background.Red div 2,
    Night.Cells[2].ConcreteStyle.Unwrap().Background.Red
  );
  Test.AssertEquals(
    Settlement.Cells[6].ConcreteStyle.Unwrap().Foreground.Red,
    Night.Cells[6].ConcreteStyle.Unwrap().Foreground.Red
  );
  Test.AssertTrue(Settlement.Cells[0] = Night.Cells[0]);
  Test.AssertTrue(Settlement.Cells[10] = Night.Cells[10]);
  Test.AssertEquals(
    SettlementOverlay.Cells[1].ConcreteStyle.Unwrap().Background.Red div 2,
    NightOverlay.Cells[1].ConcreteStyle.Unwrap().Background.Red
  );
  discard Tasks.CloseChannel(Requests);
  discard Tasks.CloseChannel(Events);
end.
