// Checks click-to-activate on inventory, disabled trade offers and wrapped dialogue choices.
program DialogPointerTest;

uses
  Dungeon.Client as Client, Dungeon.Protocol as Protocol, Dungeon.RuntimeData as RuntimeData,
  Std.Tasks as Tasks, Std.Test as Test, Std.Ui.Terminal as Tui;

function Find(Screen: Tui.TuiSurfaceSnapshot; Text: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Screen.Height - 1 do
    case Screen.LineAt(Y).IndexOf(Text) of
      when Some(const X):
        return Tui.TuiPoint.Create(X, Y);
      when None:
        null;
    end case;
  end for;

  panic('Missing text: ' + Text);
end function;

function Click(App: Tui.TuiApplication; State: Client.ClientModel; Text: string): Client.ClientModel;
begin
  App.InjectPointerForTest(
    Tui.TuiPointerEvent.Create(
      Tui.TuiPointerAction.Down,
      Tui.TuiPointerButton.Left, Find(App.SurfaceSnapshot(), Text)
    )
  );
  return App.RunIterations(State, Client.UpdateClient, Client.ViewClient, 3, 0);
end function;

begin
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(8);
  const Events: channel of Client.ConnectionEvent := Tasks.CreateChannel(8);
  const App := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(80, 25));
  var State := Client.NewClientModel(
    'localhost',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    Requests,
    Events
  ) with Screen := Client.ClientScreen.GameScreen; ConnectionPhase := Client.ClientConnectionPhase.Active; HasVisibleState := true; ViewportWidth := 80; ViewportHeight := 25; Width := 1; Height := 1; Rows := [
    '.'
  ]; KnowledgeRows := ['v']; Overlay := Client.ClientOverlay.InventoryOverlay; Inventory := [
    Protocol.VisibleInventoryItem(
      Id := 'first',
      Name := 'First potion',
      Slot := Protocol.VisibleItemSlot.NoSlot,
      Equipped := false,
      Usable := true
    ),
    Protocol.VisibleInventoryItem(
      Id := 'second',
      Name := 'Second potion',
      Slot := Protocol.VisibleItemSlot.NoSlot,
      Equipped := false,
      Usable := true
    )
  ]; end with;

  State := App.RunIterations(State, Client.UpdateClient, Client.ViewClient, 0, 0);
  State := Click(App, State, 'Second potion');
  Test.AssertTrue(
    Tasks.TryReceive(Requests).Unwrap() = Some(Protocol.ClientMessage.UseItem('second'))
  );
  State := Click(App, State, 'Second potion');
  Test.AssertTrue(Tasks.TryReceive(Requests).Unwrap() is None);

  State := State with Pending := false; Overlay := Client.ClientOverlay.NoOverlay; ActiveTrade := Some(
    Protocol.TradeQuote(
      NpcId := 'merchant', Speaker := 'Merchant', Revision := 1,
      MerchantCapacity := 64, BuyPage := 0, SellPage := 0, BuyTotal := 2, SellTotal := 0,
      SellItems := [],
      BuyItems := [
        Protocol.TradeItem(
          Id := 'blocked',
          Name := 'Blocked offer',
          Price := Some(5),
          Enabled := false,
          Reason := 'Unavailable'
        ),
        Protocol.TradeItem(
          Id := 'available',
          Name := 'Available offer',
          Price := Some(5),
          Enabled := true,
          Reason := ''
        )
      ]
    )
  ); end with;

  State := App.RunIterations(State, Client.UpdateClient, Client.ViewClient, 0, 0);
  const Blocked := Find(App.SurfaceSnapshot(), 'Blocked offer');
  Test.AssertTrue(
    App.SurfaceSnapshot().CellAt(Blocked.X, Blocked.Y).Role = Tui.TuiStyleRole.Disabled
  );
  State := Click(App, State, 'Blocked offer');
  Test.AssertTrue(Tasks.TryReceive(Requests).Unwrap() is None);
  State := Click(App, State, 'Available offer');
  Test.AssertTrue(
    Tasks.TryReceive(Requests).Unwrap() =
    Some(Protocol.ClientMessage.TradeBuy('merchant', 'available', 1))
  );

  State := State with Pending := false; ActiveTrade := None; ActiveDialogue := Some(
    Protocol.DialogueFrame(
      NpcId := 'resident', Speaker := 'Resident', Text := 'Welcome.',
      Choices := [
        Protocol.DialogueChoice(Id := 'first', Text := 'First topic'),
        Protocol.DialogueChoice(
          Id := 'long',
          Text := 'This is a deliberately long topic with a wrapped continuation line. CONTINUATION-TARGET'
        )
      ]
    )
  ); end with;

  State := App.RunIterations(State, Client.UpdateClient, Client.ViewClient, 0, 0);
  State := Click(App, State, 'CONTINUATION-TARGET');
  Test.AssertTrue(
    Tasks.TryReceive(Requests).Unwrap() =
    Some(Protocol.ClientMessage.DialogueChoice('resident', 'long'))
  );
  App.Close();
  discard Tasks.CloseChannel(Requests);
  discard Tasks.CloseChannel(Events);
end.
