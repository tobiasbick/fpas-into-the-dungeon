// Replays connected-menu keyboard navigation without network activity at large terminal sizes.
program MenuNavigationTest;

uses Dungeon.Client as Client, Dungeon.Protocol as Protocol, Dungeon.RuntimeData as RuntimeData, Dungeon.Test.Catalog as Catalog, Std.Conv as Conv, Std.Console as Console, Std.Tasks as Tasks, Std.Test as Test, Std.Time as Time, Std.Tui as Tui;

begin
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(16);
  const Events: channel of Client.ClientEvent := Tasks.CreateChannel(4);
  const Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  var Model: Client.ClientModel := Client.NewClientModel(
    '127.0.0.1',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    Requests,
    Events
  );
  Model := Client.UpdateClient(Model, Tui.TuiMsg.Resize(Tui.TuiSize.Create(144, 41)), Cmd);
  Model := Client.UpdateClientEvent(
    Model,
    Client.ClientEvent.Connected(Catalog.FixtureCatalog(false, false)),
    Cmd
  );
  const App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(144, 41));
  Model := App.RunIterations(Model, Client.UpdateClient, Client.ViewClient, 0, 0);
  for Index: integer := 0 to 6 do
    App.InjectKeyForTest(
      Console.KeyEvent(
        kind := Tui.TuiKeyKind.Tab,
        ch := '',
        shift := false,
        ctrl := false,
        alt := false,
        meta := false
      )
    );
  end for;
  const Before: integer := Model.FocusedControl;
  const Started: integer := Time.MonotonicMillis();
  Model := App.RunIterations(Model, Client.UpdateClient, Client.ViewClient, 7, 0);
  const Elapsed: integer := Time.ElapsedMillis(Started);
  Console.WriteLn(('Seven menu focus changes: ' + Conv.IntToStr(Elapsed)) + ' ms');
  Test.AssertTrue(Model.FocusedControl <> Before);
  Test.AssertTrue(Elapsed < 700);
  App.Close();
  // Mark one cached cell: focus, network menus and editor updates must retain and paint it.
  Test.AssertEquals(144, Model.StartBackdrop.Width);
  Test.AssertEquals(41, Model.StartBackdrop.Height);
  const Original: Tui.TuiCell := Model.StartBackdrop.Cells[0];
  Test.AssertEquals('*', Original.Glyph);
  Model.StartBackdrop.Cells[0] := Original with Glyph := '@'; end with;

  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.FocusChanged(None, Some(Tui.TuiControlId.Create(4))),
    Cmd
  );
  Model := Client.UpdateClientEvent(
    Model,
    Client.ClientEvent.Worlds(Catalog.FixtureCatalog(false, false)),
    Cmd
  );
  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Action(Tui.TuiControlId.Create(41), Tui.TuiAction.Create(140)),
    Cmd
  );
  Test.AssertEquals('@', Model.StartBackdrop.Cells[0].Glyph);
  const SameSize: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(144, 41));
  Model := SameSize.RunIterations(Model, Client.UpdateClient, Client.ViewClient, 0, 0);
  Test.AssertEquals('@', SameSize.SurfaceSnapshot().CellAt(0, 0).Glyph);
  SameSize.Close();
  Model := Client.UpdateClient(
    Model,
    Tui.TuiMsg.Action(Tui.TuiControlId.Create(8), Tui.TuiAction.Create(120)),
    Cmd
  );
  Model := Client.UpdateClient(Model, Tui.TuiMsg.Resize(Tui.TuiSize.Create(80, 24)), Cmd);
  Test.AssertEquals(80, Model.StartBackdrop.Width);
  Test.AssertEquals(24, Model.StartBackdrop.Height);
  Test.AssertEquals('*', Model.StartBackdrop.Cells[0].Glyph);
  Model.StartBackdrop.Cells[0] := Original with Glyph := '@'; end with;

  Model := Client.UpdateClient(Model, Tui.TuiMsg.Resize(Tui.TuiSize.Create(80, 24)), Cmd);
  Test.AssertEquals('@', Model.StartBackdrop.Cells[0].Glyph);
  // Gameplay resize defers artwork generation; returning through a network event prepares it.
  Model.Screen := Client.ClientScreen.GameScreen;
  Model := Client.UpdateClient(Model, Tui.TuiMsg.Resize(Tui.TuiSize.Create(100, 28)), Cmd);
  Test.AssertEquals(80, Model.StartBackdrop.Width);
  Test.AssertEquals('@', Model.StartBackdrop.Cells[0].Glyph);
  Model := Client.UpdateClientEvent(
    Model,
    Client.ClientEvent.Worlds(Catalog.FixtureCatalog(false, false)),
    Cmd
  );
  Test.AssertEquals(100, Model.StartBackdrop.Width);
  Test.AssertEquals(28, Model.StartBackdrop.Height);
  Test.AssertEquals('*', Model.StartBackdrop.Cells[0].Glyph);
  // Zero-sized and raw standalone models keep the existing safe rendering contract.
  Model := Client.UpdateClient(Model, Tui.TuiMsg.Resize(Tui.TuiSize.Create(0, 0)), Cmd);
  Test.AssertEquals(0, Model.StartBackdrop.Width);
  Test.AssertEquals(0, Model.StartBackdrop.Height);
  const EmptyTree: Tui.TuiElement := Client.ViewClient(Model);
  const Raw: Client.ClientModel := Client.NewClientModel(
    '127.0.0.1',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    Requests,
    Events
  ) with ViewportWidth := 40; ViewportHeight := 14; end with;
  const RawApp: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(40, 14));
  const RawRendered: Client.ClientModel := RawApp.RunIterations(
    Raw,
    Client.UpdateClient,
    Client.ViewClient,
    0,
    0
  );
  Test.AssertEquals('*', RawApp.SurfaceSnapshot().CellAt(0, 0).Glyph);
  Test.AssertEquals(0, RawRendered.StartBackdrop.Width);
  RawApp.Close();
  discard Tasks.CloseChannel(Requests);
  discard Tasks.CloseChannel(Events);
end.
