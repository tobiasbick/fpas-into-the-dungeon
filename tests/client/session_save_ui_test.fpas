// Verifies connected session selection and retryable save status through the pure client update seam.
program DungeonClientSessionSaveUiTest;

uses Dungeon.Test.Catalog as CatalogUnit, Dungeon.Client as ClientUnit, Dungeon.Protocol as Protocol, Dungeon.RuntimeData as RuntimeData, Std.Tasks as Tasks, Std.Test as Test, Std.Tui as Tui;

function Action(ControlId: integer; ActionId: integer): Tui.TuiMsg;
begin
  return Tui.TuiMsg.Action(Tui.TuiControlId.Create(ControlId), Tui.TuiAction.Create(ActionId));
end function;

function ScreenContains(Snapshot: Tui.TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Row: integer := 0 to Snapshot.Height - 1 do
    begin
      if Text in Snapshot.LineAt(Row) then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

begin
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(4);
  const Events: channel of ClientUnit.ConnectionEvent := Tasks.CreateChannel(1);
  const Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  var Model: ClientUnit.ClientModel := ClientUnit.NewClientModel(
    '127.0.0.1',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    Requests,
    Events
  );
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.Connected(CatalogUnit.FixtureCatalog(true, false)),
    Cmd
  );
  Test.AssertTrue(Model.Screen = ClientUnit.ClientScreen.StartScreen);
  Test.AssertTrue(Model.ConnectionPhase = ClientUnit.ClientConnectionPhase.AwaitingSession);
  Test.AssertTrue(Model.SaveAvailable);
  Model := ClientUnit.UpdateClient(Model, Action(5, 105), Cmd);
  Test.AssertTrue(Model.Pending);
  Test.AssertEquals('Loading game...', Model.Status);
  if Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() is Protocol.ClientMessage.LoadGame then
    begin
      null;
    end;
  else
    begin
      panic('expected load-game intention');
    end;
  end if;

  Model := ClientUnit.UpdateClient(Model, Action(5, 105), Cmd);
  Test.AssertTrue(Tasks.ReceiveWithTimeout(Requests, 0) is Error(_));
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.Rejected('load_failed', 'Saved game could not be loaded.'),
    Cmd
  );
  Test.AssertFalse(Model.Pending);
  Test.AssertTrue(Model.Screen = ClientUnit.ClientScreen.StartScreen);
  Test.AssertTrue(Model.ConnectionPhase = ClientUnit.ClientConnectionPhase.AwaitingSession);
  Test.AssertEquals('Saved game could not be loaded.', Model.Status);
  Model := ClientUnit.UpdateClient(Model, Action(4, 104), Cmd);
  if Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() is Protocol.ClientMessage.StartNewGame then
    begin
      null;
    end;
  else
    begin
      panic('expected new-game intention after load failure');
    end;
  end if;
  const MapValue: Protocol.MapVisibleState := Protocol.MapVisibleState(
    OriginX := -1, OriginY := -1, Width := 3, Height := 3, Rows := [
      'ggg',
      'ggg',
      'ggg'
    ], KnowledgeRows := [
      'vvv',
      'vvv',
      'vvv'
    ], PlayerX := 1, PlayerY := 1, WorldX := 0, WorldY := 0, Inventory := [], Health := 20,
    MaxHealth := 20, Character := [], Journal := []
  );
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Protocol.VisibleState.MapState(MapValue)),
    Cmd
  );
  Test.AssertTrue(Model.Screen = ClientUnit.ClientScreen.GameScreen);
  Test.AssertTrue(Model.ConnectionPhase = ClientUnit.ClientConnectionPhase.Active);
  Model.SaveAvailable := false;
  Model := ClientUnit.UpdateClient(Model, Action(14, 112), Cmd);
  Test.AssertTrue(Model.Pending);
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.NoOverlay);
  Test.AssertEquals('Saving game...', Model.Status);
  if Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() is Protocol.ClientMessage.SaveGame then
    begin
      null;
    end;
  else
    begin
      panic('expected direct first save without overwrite confirmation');
    end;
  end if;

  Model := ClientUnit.UpdateClient(Model, Action(14, 112), Cmd);
  Test.AssertTrue(Tasks.ReceiveWithTimeout(Requests, 0) is Error(_));
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.Rejected('save_failed', 'Save failed; retry is available.'),
    Cmd
  );
  Test.AssertFalse(Model.Pending);
  Test.AssertEquals('Save failed; retry is available.', Model.Status);
  Model := ClientUnit.UpdateClient(Model, Action(14, 112), Cmd);
  if Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() is Protocol.ClientMessage.SaveGame then
    begin
      null;
    end;
  else
    begin
      panic('expected save retry after a recoverable failure');
    end;
  end if;

  discard Tasks.CloseChannel(Requests);
  discard Tasks.CloseChannel(Events);
  const CancelRequests: channel of Protocol.ClientMessage := Tasks.CreateChannel(4);
  const CancelEvents: channel of ClientUnit.ConnectionEvent := Tasks.CreateChannel(1);
  const CancelCmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  var CancelModel: ClientUnit.ClientModel := ClientUnit.NewClientModel(
    '127.0.0.1',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    CancelRequests,
    CancelEvents
  );
  CancelModel := ClientUnit.UpdateClientEvent(
    CancelModel,
    ClientUnit.ClientEvent.Connected(CatalogUnit.FixtureCatalog(false, false)),
    CancelCmd
  );
  CancelModel := ClientUnit.UpdateClient(CancelModel, Action(4, 104), CancelCmd);
  Test.AssertTrue(CancelModel.Pending);
  if Tasks.ReceiveWithTimeout(CancelRequests, 0).Unwrap() is Protocol.ClientMessage.StartNewGame then
    begin
      null;
    end;
  else
    begin
      panic('expected new-game intention before cancellation');
    end;
  end if;

  CancelModel := ClientUnit.UpdateClient(CancelModel, Action(7, 132), CancelCmd);
  Test.AssertTrue(CancelModel.Overlay = ClientUnit.ClientOverlay.SessionCancelConfirmationOverlay);
  Test.AssertTrue(CancelModel.Pending);
  const CancelApp: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(80, 24));
  CancelModel := CancelApp.RunIterations(
    CancelModel,
    ClientUnit.UpdateClient,
    ClientUnit.ViewClient,
    0,
    0
  );
  const CancelSurface: Tui.TuiSurfaceSnapshot := CancelApp.SurfaceSnapshot();
  Test.AssertTrue(ScreenContains(CancelSurface, 'Cancel session start?'));
  Test.AssertTrue(ScreenContains(CancelSurface, 'The connection will be closed.'));
  Test.AssertTrue(ScreenContains(CancelSurface, 'Continue waiting'));
  Test.AssertTrue(ScreenContains(CancelSurface, 'Cancel and disconnect'));
  CancelApp.Close();
  CancelModel := ClientUnit.UpdateClient(CancelModel, Action(33, 134), CancelCmd);
  Test.AssertTrue(CancelModel.Overlay = ClientUnit.ClientOverlay.NoOverlay);
  Test.AssertEquals(7, CancelModel.FocusedControl);
  Test.AssertTrue(CancelModel.Pending);
  CancelModel := ClientUnit.UpdateClient(CancelModel, Action(7, 132), CancelCmd);
  CancelModel := ClientUnit.UpdateClient(CancelModel, Action(32, 133), CancelCmd);
  Test.AssertTrue(CancelModel.Screen = ClientUnit.ClientScreen.StartScreen);
  Test.AssertTrue(CancelModel.ConnectionPhase = ClientUnit.ClientConnectionPhase.Offline);
  Test.AssertTrue(CancelModel.Overlay = ClientUnit.ClientOverlay.NoOverlay);
  Test.AssertFalse(CancelModel.Pending);
  Test.AssertEquals('Ready', CancelModel.Status);
  Test.AssertTrue(Tasks.ReceiveWithTimeout(CancelRequests, 0) is Error(_));
  Test.AssertTrue(Tasks.TrySend(CancelRequests, Protocol.ClientMessage.StartNewGame) is Error(_));
  Test.AssertEquals(1, CancelModel.ConnectionGeneration);

  discard Tasks.CloseChannel(CancelRequests);
  discard Tasks.CloseChannel(CancelEvents);
end.
