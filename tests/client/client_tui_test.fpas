// Verifies that server-provided state is rendered by the terminal client.
program DungeonClientTuiTest;

uses Dungeon.Client, Dungeon.Protocol, Std.Str, Std.Task, Std.Test, Std.Tui;

function ScreenContains(Snapshot: TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Row: integer := 0 to Snapshot.Height - 1 do
  begin
    if Std.Str.Contains(Snapshot.LineAt(Row), Text) then
    begin
      return true
    end
  end;

  return false
end;

begin
  var Requests: channel of ClientMessage := CreateChannel(1);
  var Events: channel of ClientEvent := CreateChannel(2);
  mutable var Model: ClientModel := NewClientModel('127.0.0.1', 4040, Requests, Events);
  var Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  Model := UpdateClientEvent(Model, ClientEvent.Connected, Cmd);
  var StateValue: VisibleState := record
    View := ViewKind.Map;
    Width := 6;
    Height := 3;
    Rows := ['~~~~~~', '..==..', '......'];
    PlayerX := 3;
    PlayerY := 1;
  end;

  Model := UpdateClientEvent(Model, ClientEvent.State(StateValue), Cmd);
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(40, 10));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'INTO THE DUNGEON'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), '..=@..'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Connected'));
  App.Close();
  CloseChannel(Requests);
  CloseChannel(Events)
end.
