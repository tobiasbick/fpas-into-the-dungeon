// Verifies start, game, responsive panel, and modal client presentation through the TUI host.
program DungeonClientTuiTest;

uses Dungeon.Test.Catalog as CatalogUnit, Dungeon.Client as ClientUnit, Dungeon.Protocol as Protocol, Dungeon.RuntimeData as RuntimeData, Std.Tasks as Tasks, Std.Test as Test, Std.Tui as Tui;

const ConnectControlId: integer := 1;
const ConnectAction: integer := 101;

function ScreenContains(Snapshot: Tui.TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Row: integer := 0 to Snapshot.Height - 1 do
    begin
      if Text in Snapshot.LineAt(Row) then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string; Ctrl: boolean; Alt: boolean): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(
    kind := Kind,
    ch := Character,
    shift := false,
    ctrl := Ctrl,
    alt := Alt,
    meta := false
  );
end function;

begin
  const StartRequests: channel of Protocol.ClientMessage := Tasks.CreateChannel(2);
  const StartEvents: channel of ClientUnit.ConnectionEvent := Tasks.CreateChannel(2);
  var StartModel: ClientUnit.ClientModel := ClientUnit.NewClientModel(
    '127.0.0.1',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    StartRequests,
    StartEvents
  );
  StartModel.ViewportWidth := 80;
  StartModel.ViewportHeight := 24;
  const StartApp: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(80, 24));
  StartModel := StartApp.RunIterations(
    StartModel,
    ClientUnit.UpdateClient,
    ClientUnit.ViewClient,
    0,
    0
  );
  const StartSurface: Tui.TuiSurfaceSnapshot := StartApp.SurfaceSnapshot();
  Test.AssertTrue(ScreenContains(StartSurface, 'INTO THE DUNGEON'));
  Test.AssertTrue(ScreenContains(StartSurface, 'Connect'));
  Test.AssertTrue(ScreenContains(StartSurface, 'Information'));
  Test.AssertTrue(ScreenContains(StartSurface, 'Quit'));
  Test.AssertTrue(ScreenContains(StartSurface, '╭'));
  Test.AssertEquals('*', StartSurface.CellAt(0, 0).Glyph);
  Test.AssertEquals(8, StartSurface.CellAt(0, 0).ConcreteStyle.Unwrap().Background.Red);
  Test.AssertEquals(13, StartSurface.CellAt(0, 23).ConcreteStyle.Unwrap().Background.Red);
  StartApp.InjectResizeForTest(Tui.TuiSize.Create(40, 14));
  StartModel := StartApp.RunIterations(
    StartModel,
    ClientUnit.UpdateClient,
    ClientUnit.ViewClient,
    1,
    0
  );
  const SmallStartSurface: Tui.TuiSurfaceSnapshot := StartApp.SurfaceSnapshot();
  Test.AssertEquals(40, SmallStartSurface.Width);
  Test.AssertEquals(14, SmallStartSurface.Height);
  Test.AssertTrue(ScreenContains(SmallStartSurface, 'Connect'));
  Test.AssertEquals(13, SmallStartSurface.CellAt(0, 13).ConcreteStyle.Unwrap().Background.Red);
  StartApp.InjectResizeForTest(Tui.TuiSize.Create(120, 30));
  StartModel := StartApp.RunIterations(
    StartModel,
    ClientUnit.UpdateClient,
    ClientUnit.ViewClient,
    1,
    0
  );
  const WideStartSurface: Tui.TuiSurfaceSnapshot := StartApp.SurfaceSnapshot();
  Test.AssertEquals(120, WideStartSurface.Width);
  Test.AssertEquals(30, WideStartSurface.Height);
  Test.AssertEquals('^', WideStartSurface.CellAt(15, 5).Glyph);
  StartApp.InjectResizeForTest(Tui.TuiSize.Create(80, 24));
  StartModel := StartApp.RunIterations(
    StartModel,
    ClientUnit.UpdateClient,
    ClientUnit.ViewClient,
    1,
    0
  );
  StartApp.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Down, '', false, false));
  StartModel := StartApp.RunIterations(
    StartModel,
    ClientUnit.UpdateClient,
    ClientUnit.ViewClient,
    1,
    0
  );
  StartApp.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Enter, '', false, false));
  StartModel := StartApp.RunIterations(
    StartModel,
    ClientUnit.UpdateClient,
    ClientUnit.ViewClient,
    1,
    0
  );
  Test.AssertTrue(StartModel.Overlay = ClientUnit.ClientOverlay.InformationOverlay);
  Test.AssertTrue(
    ScreenContains(StartApp.SurfaceSnapshot(), 'Functional Pascal client-server RPG')
  );
  StartApp.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Escape, '', false, false));
  StartModel := StartApp.RunIterations(
    StartModel,
    ClientUnit.UpdateClient,
    ClientUnit.ViewClient,
    1,
    0
  );
  Test.AssertTrue(StartModel.Overlay = ClientUnit.ClientOverlay.NoOverlay);
  Test.AssertTrue(ScreenContains(StartApp.SurfaceSnapshot(), 'Connect'));
  StartModel := ClientUnit.UpdateClientEvent(
    StartModel,
    ClientUnit.ClientEvent.Connected(CatalogUnit.FixtureCatalog(false, false)),
    Tui.TuiCmdOutput.Create()
  );
  StartModel := StartApp.RunIterations(
    StartModel,
    ClientUnit.UpdateClient,
    ClientUnit.ViewClient,
    0,
    0
  );
  Test.AssertTrue(ScreenContains(StartApp.SurfaceSnapshot(), 'Start over'));
  Test.AssertTrue(ScreenContains(StartApp.SurfaceSnapshot(), 'Continue'));
  StartModel := ClientUnit.UpdateClientEvent(
    StartModel,
    ClientUnit.ClientEvent.Connected(CatalogUnit.FixtureCatalog(false, true)),
    Tui.TuiCmdOutput.Create()
  );
  StartModel := StartApp.RunIterations(
    StartModel,
    ClientUnit.UpdateClient,
    ClientUnit.ViewClient,
    0,
    0
  );
  Test.AssertTrue(ScreenContains(StartApp.SurfaceSnapshot(), 'Saved game is incompatible'));
  Test.AssertTrue(ScreenContains(StartApp.SurfaceSnapshot(), 'Start over'));
  Test.AssertFalse(ScreenContains(StartApp.SurfaceSnapshot(), 'Continue'));
  StartApp.Close();
  discard Tasks.CloseChannel(StartRequests);
  discard Tasks.CloseChannel(StartEvents);
  const ConnectingRequests: channel of Protocol.ClientMessage := Tasks.CreateChannel(2);
  const ConnectingEvents: channel of ClientUnit.ConnectionEvent := Tasks.CreateChannel(2);
  var ConnectingModel: ClientUnit.ClientModel := ClientUnit.NewClientModel(
    '127.0.0.1',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    ConnectingRequests,
    ConnectingEvents
  );
  const ConnectingCmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  ConnectingModel := ClientUnit.UpdateClient(
    ConnectingModel,
    Tui.TuiMsg.Action(
      Tui.TuiControlId.Create(ConnectControlId),
      Tui.TuiAction.Create(ConnectAction)
    ),
    ConnectingCmd
  );
  const ConnectingApp: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(
    Tui.TuiSize.Create(80, 24)
  );
  ConnectingModel := ConnectingApp.RunIterations(
    ConnectingModel,
    ClientUnit.UpdateClient,
    ClientUnit.ViewClient,
    0,
    0
  );
  Test.AssertTrue(ConnectingModel.Screen = ClientUnit.ClientScreen.StartScreen);
  Test.AssertTrue(ConnectingModel.ConnectionPhase = ClientUnit.ClientConnectionPhase.Connecting);
  Test.AssertTrue(ScreenContains(ConnectingApp.SurfaceSnapshot(), 'Connecting to 127.0.0.1:4040'));
  ConnectingApp.Close();
  discard Tasks.CloseChannel(ConnectingRequests);
  discard Tasks.CloseChannel(ConnectingEvents);
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(8);
  const Events: channel of ClientUnit.ConnectionEvent := Tasks.CreateChannel(2);
  var Model: ClientUnit.ClientModel := ClientUnit.NewClientModel(
    '127.0.0.1',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    Requests,
    Events
  );
  Model.FocusedControl := 0;
  Model.ViewportWidth := 180;
  Model.ViewportHeight := 30;
  Model.RequestedWorldWidth := 59;
  Model.RequestedWorldHeight := 25;
  const Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.Connected(CatalogUnit.FixtureCatalog(true, false)),
    Cmd
  );
  const App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(180, 30));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(Model.ConnectionPhase = ClientUnit.ClientConnectionPhase.AwaitingSession);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Start over'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Continue'));
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertTrue(Model.Pending);
  Test.AssertEquals(7, Model.FocusedControl);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Starting over...'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Please wait.'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Cancel'));
  Test.AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Start over'));
  Test.AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Continue'));
  Test.AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Information'));
  Test.AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Disconnect'));
  Test.AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Quit'));
  if Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() is Protocol.ClientMessage.StartNewGame then
    begin
      null;
    end;
  else
    begin
      panic('expected new-game intention');
    end;
  end if;
  const MapValue: Protocol.MapVisibleState := Protocol.MapVisibleState(
    OriginX := -3, OriginY := -1, Width := 6, Height := 3, Rows := [
      'ofdmgl',
      'gppett',
      'lromfg'
    ], KnowledgeRows := [
      'vvvvvv',
      'vvvvvv',
      'vvvvvv'
    ], PlayerX := 3, PlayerY := 1, WorldX := 0, WorldY := 0, Inventory := [], Health := 20,
    MaxHealth := 20, Character := [], Journal := []
  );
  const StateValue: Protocol.VisibleState := Protocol.VisibleState.MapState(MapValue);
  Model := ClientUnit.UpdateClientEvent(Model, ClientUnit.ClientEvent.State(StateValue), Cmd);
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  const GameSurface: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  const ContextColumn: integer := case GameSurface.LineAt(0).IndexOf('Environment') of
    when Some(const Column): Column;
    when None: -1;
  end case;
  Test.AssertTrue(ContextColumn >= GameSurface.Width div 2);
  Test.AssertTrue(ContextColumn <= (GameSurface.Width * 3) div 4);
  Test.AssertEquals('●', GameSurface.CellAt(7, 2).Glyph);
  Test.AssertEquals(' ', GameSurface.CellAt(8, 2).Glyph);
  Test.AssertTrue(GameSurface.CellAt(1, 1).ConcreteStyle.Unwrap().Background.Red = 18);
  Test.AssertTrue(GameSurface.CellAt(2, 1).ConcreteStyle.Unwrap().Background.Red = 18);
  Test.AssertTrue(GameSurface.CellAt(3, 1).ConcreteStyle.Unwrap().Background.Red = 24);
  Test.AssertTrue(GameSurface.CellAt(5, 1).ConcreteStyle.Unwrap().Background.Red = 151);
  Test.AssertTrue(GameSurface.CellAt(7, 1).ConcreteStyle.Unwrap().Background.Red = 82);
  Test.AssertTrue(GameSurface.CellAt(9, 1).ConcreteStyle.Unwrap().Background.Red = 40);
  Test.AssertTrue(GameSurface.CellAt(11, 1).ConcreteStyle.Unwrap().Background.Red = 35);
  Test.AssertTrue(GameSurface.CellAt(3, 2).ConcreteStyle.Unwrap().Background.Red = 116);
  Test.AssertTrue(GameSurface.CellAt(3, 3).ConcreteStyle.Unwrap().Background.Red = 30);
  Test.AssertEquals('♣', GameSurface.CellAt(11, 2).Glyph);
  Test.AssertTrue(GameSurface.CellAt(11, 2).ConcreteStyle.Unwrap().Foreground.Green = 166);
  Test.AssertTrue(GameSurface.CellAt(7, 2).ConcreteStyle.Unwrap().Background.Red = 150);
  Test.AssertTrue(
    GameSurface.CellAt(1, 1).ConcreteStyle.Unwrap().Background.Kind = Tui.TuiColorKind.Rgb
  );
  Test.AssertTrue(ScreenContains(GameSurface, 'Context'));
  Test.AssertTrue(ScreenContains(GameSurface, 'Character'));
  Test.AssertTrue(ScreenContains(GameSurface, 'Position: 0, 0'));
  Test.AssertTrue(ScreenContains(GameSurface, 'ctrl-p | Connected'));
  var PlayerMovedMap: Protocol.MapVisibleState := MapValue;
  PlayerMovedMap.PlayerX := 2;
  PlayerMovedMap.WorldX := -1;
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Protocol.VisibleState.MapState(PlayerMovedMap)),
    Cmd
  );
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertEquals('◆', App.SurfaceSnapshot().CellAt(7, 2).Glyph);
  Test.AssertEquals(' ', App.SurfaceSnapshot().CellAt(8, 2).Glyph);
  Test.AssertTrue(App.SurfaceSnapshot().CellAt(7, 2).ConcreteStyle.Unwrap().Background.Red = 72);
  Test.AssertTrue(App.SurfaceSnapshot().CellAt(8, 2).ConcreteStyle.Unwrap().Background.Red = 72);
  Model := ClientUnit.UpdateClientEvent(Model, ClientUnit.ClientEvent.State(StateValue), Cmd);
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertEquals('●', App.SurfaceSnapshot().CellAt(7, 2).Glyph);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertTrue(Model.Pending);
  if Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() is Protocol.ClientMessage.Interact then
    begin
      null;
    end;
  else
    begin
      panic('expected Enter to request an interaction');
    end;
  end if;
  const BeforeInspectionMessages: array of string := Model.Messages;
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.Interaction('Ancient coin', 'A heavy, tarnished coin.'),
    Cmd
  );
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Ancient coin'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'A heavy, tarnished coin.'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Enter/Esc close'));
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.Interaction(
      'Long inscription',
      'An old story continues. '.RepeatStr(100)
    ),
    Cmd
  );
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Up/Down scroll'));
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Down, '', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertEquals(1, Model.DescriptionOffset);
  Test.AssertTrue(Tasks.ReceiveWithTimeout(Requests, 0) is Error(_));
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Escape, '', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.NoOverlay);
  Model.Messages := BeforeInspectionMessages;
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.F3, '', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertTrue(Model.MessagePanelVisible);
  Test.AssertTrue(Model.Pending);
  Test.AssertEquals('●', App.SurfaceSnapshot().CellAt(7, 2).Glyph);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.Viewport(const Width, const Height):
      Test.AssertEquals(59, Width);
      Test.AssertEquals(19, Height);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected viewport update after message panel toggle');
  end case;

  Model.Pending := false;
  Model.RequestedWorldWidth := 59;
  Model.RequestedWorldHeight := 19;
  const MessageSurface: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  Test.AssertTrue(ScreenContains(MessageSurface, 'Messages'));
  Test.AssertTrue(ScreenContains(MessageSurface, 'Status'));
  Test.AssertEquals(
    '╮',
    MessageSurface.LineAt(MessageSurface.Height - 9)[MessageSurface.Width - 1]
  );
  Test.AssertEquals('╰', MessageSurface.LineAt(MessageSurface.Height - 4)[0]);
  Test.AssertEquals(
    '╯',
    MessageSurface.LineAt(MessageSurface.Height - 4)[MessageSurface.Width - 1]
  );
  Test.AssertEquals('╰', MessageSurface.LineAt(MessageSurface.Height - 1)[0]);
  Test.AssertEquals(
    '╯',
    MessageSurface.LineAt(MessageSurface.Height - 1)[MessageSurface.Width - 1]
  );
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 'p', true, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.SystemMenuOverlay);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'System menu'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'WASD'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Save'));
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 'd', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertTrue(Tasks.ReceiveWithTimeout(Requests, 0) is Error(_));
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Down, '', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Down, '', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.SaveConfirmationOverlay);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Overwrite save?'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'existing save for this world'));
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Escape, '', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.SystemMenuOverlay);
  Test.AssertTrue(Tasks.ReceiveWithTimeout(Requests, 0) is Error(_));
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertTrue(Model.Pending);
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.NoOverlay);
  if Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() is Protocol.ClientMessage.OverwriteSaveGame then
    begin
      null;
    end;
  else
    begin
      panic('expected one confirmed save request');
    end;
  end if;

  Model := ClientUnit.UpdateClientEvent(Model, ClientUnit.ClientEvent.SaveCompleted, Cmd);
  Test.AssertFalse(Model.Pending);
  Test.AssertTrue(Model.SaveAvailable);
  Test.AssertEquals('Game saved.', Model.Status);
  const FirstPersonValue: Protocol.FirstPersonVisibleState := Protocol.FirstPersonVisibleState(
    Title := 'Initial dungeon', Status := 'Find the gold exit field.', Level := 0, Depth := 1,
    Width := 11, Height := 9,
    Rows := [
      '###########',
      '#.........#',
      '#.#####.#.#',
      '#.....#.#.#',
      '###.#.#.#.#',
      '#...#...#.#',
      '#.#####.#.#',
      '#x........#',
      '###########'
    ], KnowledgeRows := [
      'vvvvvvvvvvv',
      'vvvvvvvvvvv',
      'vvvvvvvvvvv',
      'vvvvvvvvvvv',
      'vvvvvvvvvvv',
      'vvvvvvvvvvv',
      'vvvvvvvvvvv',
      'vvvvvvvvvvv',
      'vvvvvvvvvvv'
    ], PlayerX := 9, PlayerY := 1, Facing := Protocol.FirstPersonFacing.West, Inventory := [],
    Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := [],
    Journal := []
  );
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Protocol.VisibleState.FirstPersonState(FirstPersonValue)),
    Cmd
  );
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Initial dungeon'));
  Test.AssertEquals('Find the gold exit field.', Model.PrimaryStatus);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'ctrl-p | Updating view...'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Context'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Messages'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Status'));
  Test.AssertEquals('╭', App.SurfaceSnapshot().LineAt(0)[0]);
  Test.AssertTrue(App.SurfaceSnapshot().CellAt(1, 1).ConcreteStyle is Some(_));
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.Viewport(const Width, const Height):
      Test.AssertEquals(118, Width);
      Test.AssertEquals(19, Height);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected first-person viewport update');
  end case;

  Model.Pending := false;
  Model.RequestedWorldWidth := 118;
  Model.RequestedWorldHeight := 19;
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Protocol.VisibleState.FirstPersonState(FirstPersonValue)),
    Cmd
  );
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertEquals('Connected', Model.Status);
  Test.AssertEquals('Find the gold exit field.', Model.PrimaryStatus);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 'w', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.StepFirstPerson(const Direction):
      Test.AssertTrue(Direction = Protocol.FirstPersonStepDirection.Forward);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected forward first-person step');
  end case;

  Model.Pending := false;
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 'a', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.StepFirstPerson(const Direction):
      Test.AssertTrue(Direction = Protocol.FirstPersonStepDirection.Left);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected left first-person step');
  end case;

  Model.Pending := false;
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 's', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.StepFirstPerson(const Direction):
      Test.AssertTrue(Direction = Protocol.FirstPersonStepDirection.Backward);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected backward first-person step');
  end case;

  Model.Pending := false;
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 'd', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.StepFirstPerson(const Direction):
      Test.AssertTrue(Direction = Protocol.FirstPersonStepDirection.Right);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected right first-person step');
  end case;

  Model.Pending := false;
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 'q', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.TurnFirstPerson(const Direction):
      Test.AssertTrue(Direction = Protocol.FirstPersonTurnDirection.Left);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected left first-person turn');
  end case;

  Model.Pending := false;
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 'e', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.TurnFirstPerson(const Direction):
      Test.AssertTrue(Direction = Protocol.FirstPersonTurnDirection.Right);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected right first-person turn');
  end case;

  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 'w', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertTrue(Tasks.ReceiveWithTimeout(Requests, 0) is Error(_));
  Model.Pending := false;
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 'p', true, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'W/S    Forward/back one field'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'A/D    Left/right one field'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Q/E    Turn left/right 90 degrees'));
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertTrue(Tasks.ReceiveWithTimeout(Requests, 0) is Error(_));
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Escape, '', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  App.InjectResizeForTest(Tui.TuiSize.Create(40, 16));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertEquals(40, Model.ViewportWidth);
  Test.AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Character'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Initial dungeon'));
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.Viewport(const Width, const Height):
      Test.AssertEquals(38, Width);
      Test.AssertEquals(11, Height);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected viewport update after terminal resize');
  end case;

  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.F2, '', false, false));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.ContextOverlay);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Character'));
  App.Close();
  discard Tasks.CloseChannel(Requests);
  discard Tasks.CloseChannel(Events);
  const TinyRequests: channel of Protocol.ClientMessage := Tasks.CreateChannel(1);
  const TinyEvents: channel of ClientUnit.ConnectionEvent := Tasks.CreateChannel(1);
  var TinyModel: ClientUnit.ClientModel := ClientUnit.NewClientModel(
    '127.0.0.1',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    TinyRequests,
    TinyEvents
  );
  TinyModel.Screen := ClientUnit.ClientScreen.GameScreen;
  TinyModel.FocusedControl := 0;
  TinyModel.ViewportWidth := 20;
  TinyModel.ViewportHeight := 6;
  const TinyApp: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(20, 6));
  TinyModel := TinyApp.RunIterations(
    TinyModel,
    ClientUnit.UpdateClient,
    ClientUnit.ViewClient,
    0,
    0
  );
  Test.AssertEquals(20, TinyApp.SurfaceSnapshot().Width);
  Test.AssertEquals(6, TinyApp.SurfaceSnapshot().Height);
  TinyApp.Close();
  discard Tasks.CloseChannel(TinyRequests);
  discard Tasks.CloseChannel(TinyEvents);
end.
