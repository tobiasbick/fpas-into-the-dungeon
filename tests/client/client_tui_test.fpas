// Verifies start, game, responsive panel, and modal client presentation through the TUI host.
program DungeonClientTuiTest;

uses
  Dungeon.Test.Catalog, Dungeon.Client, Dungeon.Protocol, Dungeon.RuntimeData, Std.Tasks, Std.Test,
  Std.Tui;

const ConnectControlId: integer := 1;
const ConnectAction: integer := 101;

function ScreenContains(Snapshot: TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Row: integer := 0 to Snapshot.Height - 1 do
    begin
      if Snapshot.LineAt(Row).Contains(Text) then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

function MakeKey(Kind: TuiKeyKind; Character: string; Ctrl: boolean; Alt: boolean): TuiKeyEvent;
begin
  return TuiKeyEvent(kind := Kind, ch := Character, shift := false, ctrl := Ctrl, alt := Alt, meta := false);
end function;

begin
  const StartRequests: channel of ClientMessage := CreateChannel(2);
  const StartEvents: channel of ClientEvent := CreateChannel(2);
  var StartModel: ClientModel := NewClientModel('127.0.0.1', 4040, '', DefaultClientPreferences(), StartRequests, StartEvents);
  StartModel.ViewportWidth := 80;
  StartModel.ViewportHeight := 24;
  const StartApp: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 24));
  StartModel := StartApp.RunIterations(StartModel, UpdateClient, ViewClient, 0, 0);
  const StartSurface: TuiSurfaceSnapshot := StartApp.SurfaceSnapshot();
  AssertTrue(ScreenContains(StartSurface, 'INTO THE DUNGEON'));
  AssertTrue(ScreenContains(StartSurface, 'Connect'));
  AssertTrue(ScreenContains(StartSurface, 'Information'));
  AssertTrue(ScreenContains(StartSurface, 'Quit'));
  AssertTrue(ScreenContains(StartSurface, '╭'));
  AssertEquals('*', StartSurface.CellAt(0, 0).Glyph);
  AssertEquals(8, StartSurface.CellAt(0, 0).ConcreteStyle.Unwrap().Background.Red);
  AssertEquals(13, StartSurface.CellAt(0, 23).ConcreteStyle.Unwrap().Background.Red);
  StartApp.InjectResizeForTest(TuiSize.Create(40, 14));
  StartModel := StartApp.RunIterations(StartModel, UpdateClient, ViewClient, 1, 0);
  const SmallStartSurface: TuiSurfaceSnapshot := StartApp.SurfaceSnapshot();
  AssertEquals(40, SmallStartSurface.Width);
  AssertEquals(14, SmallStartSurface.Height);
  AssertTrue(ScreenContains(SmallStartSurface, 'Connect'));
  AssertEquals(13, SmallStartSurface.CellAt(0, 13).ConcreteStyle.Unwrap().Background.Red);
  StartApp.InjectResizeForTest(TuiSize.Create(120, 30));
  StartModel := StartApp.RunIterations(StartModel, UpdateClient, ViewClient, 1, 0);
  const WideStartSurface: TuiSurfaceSnapshot := StartApp.SurfaceSnapshot();
  AssertEquals(120, WideStartSurface.Width);
  AssertEquals(30, WideStartSurface.Height);
  AssertEquals('^', WideStartSurface.CellAt(15, 5).Glyph);
  StartApp.InjectResizeForTest(TuiSize.Create(80, 24));
  StartModel := StartApp.RunIterations(StartModel, UpdateClient, ViewClient, 1, 0);
  StartApp.InjectKeyForTest(MakeKey(TuiKeyKind.Down, '', false, false));
  StartModel := StartApp.RunIterations(StartModel, UpdateClient, ViewClient, 1, 0);
  StartApp.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, '', false, false));
  StartModel := StartApp.RunIterations(StartModel, UpdateClient, ViewClient, 1, 0);
  AssertTrue(StartModel.Overlay = ClientOverlay.InformationOverlay);
  AssertTrue(ScreenContains(StartApp.SurfaceSnapshot(), 'Functional Pascal client-server RPG'));
  StartApp.InjectKeyForTest(MakeKey(TuiKeyKind.Escape, '', false, false));
  StartModel := StartApp.RunIterations(StartModel, UpdateClient, ViewClient, 1, 0);
  AssertTrue(StartModel.Overlay = ClientOverlay.NoOverlay);
  AssertTrue(ScreenContains(StartApp.SurfaceSnapshot(), 'Connect'));
  StartModel := UpdateClientEvent(StartModel, ClientEvent.Connected(FixtureCatalog(false, false)), TuiCmdOutput.Create());
  StartModel := StartApp.RunIterations(StartModel, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(StartApp.SurfaceSnapshot(), 'Start over'));
  AssertTrue(ScreenContains(StartApp.SurfaceSnapshot(), 'Continue'));
  StartModel := UpdateClientEvent(StartModel, ClientEvent.Connected(FixtureCatalog(false, true)), TuiCmdOutput.Create());
  StartModel := StartApp.RunIterations(StartModel, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(StartApp.SurfaceSnapshot(), 'Saved game is incompatible'));
  AssertTrue(ScreenContains(StartApp.SurfaceSnapshot(), 'Start over'));
  AssertFalse(ScreenContains(StartApp.SurfaceSnapshot(), 'Continue'));
  StartApp.Close();
  discard CloseChannel(StartRequests);
  discard CloseChannel(StartEvents);
  const ConnectingRequests: channel of ClientMessage := CreateChannel(2);
  const ConnectingEvents: channel of ClientEvent := CreateChannel(2);
  var ConnectingModel: ClientModel := NewClientModel('127.0.0.1', 4040, '', DefaultClientPreferences(), ConnectingRequests, ConnectingEvents);
  const ConnectingCmd: TuiCmdOutput := TuiCmdOutput.Create();
  ConnectingModel := UpdateClient(ConnectingModel, TuiMsg.Action(TuiControlId.Create(ConnectControlId), TuiAction.Create(ConnectAction)), ConnectingCmd);
  const ConnectingApp: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 24));
  ConnectingModel := ConnectingApp.RunIterations(ConnectingModel, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ConnectingModel.Screen = ClientScreen.StartScreen);
  AssertTrue(ConnectingModel.ConnectionPhase = ClientConnectionPhase.Connecting);
  AssertTrue(ScreenContains(ConnectingApp.SurfaceSnapshot(), 'Connecting to 127.0.0.1:4040'));
  ConnectingApp.Close();
  discard CloseChannel(ConnectingRequests);
  discard CloseChannel(ConnectingEvents);
  const Requests: channel of ClientMessage := CreateChannel(8);
  const Events: channel of ClientEvent := CreateChannel(2);
  var Model: ClientModel := NewClientModel('127.0.0.1', 4040, '', DefaultClientPreferences(), Requests, Events);
  Model.FocusedControl := 0;
  Model.ViewportWidth := 180;
  Model.ViewportHeight := 30;
  Model.RequestedWorldWidth := 59;
  Model.RequestedWorldHeight := 25;
  const Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  Model := UpdateClientEvent(Model, ClientEvent.Connected(FixtureCatalog(true, false)), Cmd);
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(180, 30));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(Model.ConnectionPhase = ClientConnectionPhase.AwaitingSession);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Start over'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Continue'));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(Model.Pending);
  AssertEquals(7, Model.FocusedControl);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Starting over...'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Please wait.'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Cancel'));
  AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Start over'));
  AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Continue'));
  AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Information'));
  AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Disconnect'));
  AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Quit'));
  if ReceiveWithTimeout(Requests, 0).Unwrap() is ClientMessage.StartNewGame then
    begin
      null;
    end;
  else
    begin
      panic('expected new-game intention');
    end;
  end if;
  const MapValue: MapVisibleState := MapVisibleState(OriginX := -3, OriginY := -1, Width := 6, Height := 3, Rows := [
                                                                                                                      'ofdmgl',
                                                                                                                      'gppett',
                                                                                                                      'lromfg'
                                                                                                                    ], KnowledgeRows := [
                                                                                                                                          'vvvvvv',
                                                                                                                                          'vvvvvv',
                                                                                                                                          'vvvvvv'
                                                                                                                                        ], PlayerX := 3, PlayerY := 1, WorldX := 0, WorldY := 0, Inventory := [], Health := 20, MaxHealth := 20, Character := []);
  const StateValue: VisibleState := VisibleState.MapState(MapValue);
  Model := UpdateClientEvent(Model, ClientEvent.State(StateValue), Cmd);
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  const GameSurface: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  const ContextColumn: integer := GameSurface.LineAt(0).IndexOf('Environment');
  AssertTrue(ContextColumn >= GameSurface.Width div 2);
  AssertTrue(ContextColumn <= (GameSurface.Width * 3) div 4);
  AssertEquals('●', GameSurface.CellAt(7, 2).Glyph);
  AssertEquals(' ', GameSurface.CellAt(8, 2).Glyph);
  AssertTrue(GameSurface.CellAt(1, 1).ConcreteStyle.Unwrap().Background.Red = 18);
  AssertTrue(GameSurface.CellAt(2, 1).ConcreteStyle.Unwrap().Background.Red = 18);
  AssertTrue(GameSurface.CellAt(3, 1).ConcreteStyle.Unwrap().Background.Red = 24);
  AssertTrue(GameSurface.CellAt(5, 1).ConcreteStyle.Unwrap().Background.Red = 151);
  AssertTrue(GameSurface.CellAt(7, 1).ConcreteStyle.Unwrap().Background.Red = 82);
  AssertTrue(GameSurface.CellAt(9, 1).ConcreteStyle.Unwrap().Background.Red = 40);
  AssertTrue(GameSurface.CellAt(11, 1).ConcreteStyle.Unwrap().Background.Red = 35);
  AssertTrue(GameSurface.CellAt(3, 2).ConcreteStyle.Unwrap().Background.Red = 116);
  AssertTrue(GameSurface.CellAt(3, 3).ConcreteStyle.Unwrap().Background.Red = 30);
  AssertEquals('♣', GameSurface.CellAt(11, 2).Glyph);
  AssertTrue(GameSurface.CellAt(11, 2).ConcreteStyle.Unwrap().Foreground.Green = 166);
  AssertTrue(GameSurface.CellAt(7, 2).ConcreteStyle.Unwrap().Background.Red = 150);
  AssertTrue(GameSurface.CellAt(1, 1).ConcreteStyle.Unwrap().Background.Kind = TuiColorKind.Rgb);
  AssertTrue(ScreenContains(GameSurface, 'Context'));
  AssertTrue(ScreenContains(GameSurface, 'Character'));
  AssertTrue(ScreenContains(GameSurface, 'Position: 0, 0'));
  AssertTrue(ScreenContains(GameSurface, 'ctrl-p | Connected'));
  var PlayerMovedMap: MapVisibleState := MapValue;
  PlayerMovedMap.PlayerX := 2;
  PlayerMovedMap.WorldX := -1;
  Model := UpdateClientEvent(Model, ClientEvent.State(VisibleState.MapState(PlayerMovedMap)), Cmd);
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertEquals('◆', App.SurfaceSnapshot().CellAt(7, 2).Glyph);
  AssertEquals(' ', App.SurfaceSnapshot().CellAt(8, 2).Glyph);
  AssertTrue(App.SurfaceSnapshot().CellAt(7, 2).ConcreteStyle.Unwrap().Background.Red = 72);
  AssertTrue(App.SurfaceSnapshot().CellAt(8, 2).ConcreteStyle.Unwrap().Background.Red = 72);
  Model := UpdateClientEvent(Model, ClientEvent.State(StateValue), Cmd);
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertEquals('●', App.SurfaceSnapshot().CellAt(7, 2).Glyph);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(Model.Pending);
  if ReceiveWithTimeout(Requests, 0).Unwrap() is ClientMessage.Interact then
    begin
      null;
    end;
  else
    begin
      panic('expected Enter to request an interaction');
    end;
  end if;
  const BeforeInspectionMessages: array of string := Model.Messages;
  Model := UpdateClientEvent(Model, ClientEvent.Interaction('Ancient coin', 'A heavy, tarnished coin.'), Cmd);
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Ancient coin'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'A heavy, tarnished coin.'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Enter/Esc close'));
  Model := UpdateClientEvent(Model, ClientEvent.Interaction('Long inscription', 'An old story continues. '
                                                                                  .RepeatStr(100)), Cmd);
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Up/Down scroll'));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Down, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertEquals(1, Model.DescriptionOffset);
  AssertTrue(ReceiveWithTimeout(Requests, 0).IsError());
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Escape, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(Model.Overlay = ClientOverlay.NoOverlay);
  Model.Messages := BeforeInspectionMessages;
  App.InjectKeyForTest(MakeKey(TuiKeyKind.F3, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(Model.MessagePanelVisible);
  AssertTrue(Model.Pending);
  AssertEquals('●', App.SurfaceSnapshot().CellAt(7, 2).Glyph);
  if ReceiveWithTimeout(Requests, 0).Unwrap() is ClientMessage.Viewport(const Width, const Height) then
    begin
      AssertEquals(59, Width);
      AssertEquals(19, Height);
    end;
  else
    begin
      panic('expected viewport update after message panel toggle');
    end;
  end if;

  Model.Pending := false;
  Model.RequestedWorldWidth := 59;
  Model.RequestedWorldHeight := 19;
  const MessageSurface: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  AssertTrue(ScreenContains(MessageSurface, 'Messages'));
  AssertTrue(ScreenContains(MessageSurface, 'Status'));
  AssertEquals('╮', MessageSurface.LineAt(MessageSurface.Height - 9)
                      .CharAt(MessageSurface.Width - 1));
  AssertEquals('╰', MessageSurface.LineAt(MessageSurface.Height - 4).CharAt(0));
  AssertEquals('╯', MessageSurface.LineAt(MessageSurface.Height - 4)
                      .CharAt(MessageSurface.Width - 1));
  AssertEquals('╰', MessageSurface.LineAt(MessageSurface.Height - 1).CharAt(0));
  AssertEquals('╯', MessageSurface.LineAt(MessageSurface.Height - 1)
                      .CharAt(MessageSurface.Width - 1));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'p', true, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(Model.Overlay = ClientOverlay.SystemMenuOverlay);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'System menu'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'WASD'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Save'));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'd', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(ReceiveWithTimeout(Requests, 0).IsError());
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Down, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Down, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(Model.Overlay = ClientOverlay.SaveConfirmationOverlay);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Overwrite save?'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'existing save for this world'));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Escape, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(Model.Overlay = ClientOverlay.SystemMenuOverlay);
  AssertTrue(ReceiveWithTimeout(Requests, 0).IsError());
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(Model.Pending);
  AssertTrue(Model.Overlay = ClientOverlay.NoOverlay);
  if ReceiveWithTimeout(Requests, 0).Unwrap() is ClientMessage.OverwriteSaveGame then
    begin
      null;
    end;
  else
    begin
      panic('expected one confirmed save request');
    end;
  end if;

  Model := UpdateClientEvent(Model, ClientEvent.SaveCompleted, Cmd);
  AssertFalse(Model.Pending);
  AssertTrue(Model.SaveAvailable);
  AssertEquals('Game saved.', Model.Status);
  const FirstPersonValue: FirstPersonVisibleState := FirstPersonVisibleState(Title := 'Initial dungeon', Status := 'Find the gold exit field.', Width := 11, Height := 9, Rows := [
                                                                                                                                                                                    '###########',
                                                                                                                                                                                    '#.........#',
                                                                                                                                                                                    '#.#####.#.#',
                                                                                                                                                                                    '#.....#.#.#',
                                                                                                                                                                                    '###.#.#.#.#',
                                                                                                                                                                                    '#...#...#.#',
                                                                                                                                                                                    '#.#####.#.#',
                                                                                                                                                                                    '#x........#',
                                                                                                                                                                                    '###########'
                                                                                                                                                                                  ], KnowledgeRows := [
                                                                                                                                                                                                        'vvvvvvvvvvv',
                                                                                                                                                                                                        'vvvvvvvvvvv',
                                                                                                                                                                                                        'vvvvvvvvvvv',
                                                                                                                                                                                                        'vvvvvvvvvvv',
                                                                                                                                                                                                        'vvvvvvvvvvv',
                                                                                                                                                                                                        'vvvvvvvvvvv',
                                                                                                                                                                                                        'vvvvvvvvvvv',
                                                                                                                                                                                                        'vvvvvvvvvvv',
                                                                                                                                                                                                        'vvvvvvvvvvv'
                                                                                                                                                                                                      ], PlayerX := 9, PlayerY := 1, Facing := FirstPersonFacing.West, Inventory := [], Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []);
  Model := UpdateClientEvent(Model, ClientEvent.State(VisibleState.FirstPersonState(FirstPersonValue)), Cmd);
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Initial dungeon'));
  AssertEquals('Find the gold exit field.', Model.PrimaryStatus);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'ctrl-p | Updating view...'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Context'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Messages'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Status'));
  AssertEquals('╭', App.SurfaceSnapshot().LineAt(0).CharAt(0));
  AssertTrue(App.SurfaceSnapshot().CellAt(1, 1).ConcreteStyle.IsSome());
  if ReceiveWithTimeout(Requests, 0).Unwrap() is ClientMessage.Viewport(const Width, const Height) then
    begin
      AssertEquals(118, Width);
      AssertEquals(19, Height);
    end;
  else
    begin
      panic('expected first-person viewport update');
    end;
  end if;

  Model.Pending := false;
  Model.RequestedWorldWidth := 118;
  Model.RequestedWorldHeight := 19;
  Model := UpdateClientEvent(Model, ClientEvent.State(VisibleState.FirstPersonState(FirstPersonValue)), Cmd);
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertEquals('Connected', Model.Status);
  AssertEquals('Find the gold exit field.', Model.PrimaryStatus);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'w', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  if ReceiveWithTimeout(Requests, 0).Unwrap() is ClientMessage.StepFirstPerson(const Direction) then
    begin
      AssertTrue(Direction = FirstPersonStepDirection.Forward);
    end;
  else
    begin
      panic('expected forward first-person step');
    end;
  end if;

  Model.Pending := false;
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'a', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  if ReceiveWithTimeout(Requests, 0).Unwrap() is ClientMessage.StepFirstPerson(const Direction) then
    begin
      AssertTrue(Direction = FirstPersonStepDirection.Left);
    end;
  else
    begin
      panic('expected left first-person step');
    end;
  end if;

  Model.Pending := false;
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 's', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  if ReceiveWithTimeout(Requests, 0).Unwrap() is ClientMessage.StepFirstPerson(const Direction) then
    begin
      AssertTrue(Direction = FirstPersonStepDirection.Backward);
    end;
  else
    begin
      panic('expected backward first-person step');
    end;
  end if;

  Model.Pending := false;
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'd', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  if ReceiveWithTimeout(Requests, 0).Unwrap() is ClientMessage.StepFirstPerson(const Direction) then
    begin
      AssertTrue(Direction = FirstPersonStepDirection.Right);
    end;
  else
    begin
      panic('expected right first-person step');
    end;
  end if;

  Model.Pending := false;
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'q', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  if ReceiveWithTimeout(Requests, 0).Unwrap() is ClientMessage.TurnFirstPerson(const Direction) then
    begin
      AssertTrue(Direction = FirstPersonTurnDirection.Left);
    end;
  else
    begin
      panic('expected left first-person turn');
    end;
  end if;

  Model.Pending := false;
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'e', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  if ReceiveWithTimeout(Requests, 0).Unwrap() is ClientMessage.TurnFirstPerson(const Direction) then
    begin
      AssertTrue(Direction = FirstPersonTurnDirection.Right);
    end;
  else
    begin
      panic('expected right first-person turn');
    end;
  end if;

  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'w', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(ReceiveWithTimeout(Requests, 0).IsError());
  Model.Pending := false;
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'p', true, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'W/S    Forward/back one field'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'A/D    Left/right one field'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Q/E    Turn left/right 90 degrees'));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(ReceiveWithTimeout(Requests, 0).IsError());
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Escape, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  App.InjectResizeForTest(TuiSize.Create(40, 16));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertEquals(40, Model.ViewportWidth);
  AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Character'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Initial dungeon'));
  if ReceiveWithTimeout(Requests, 0).Unwrap() is ClientMessage.Viewport(const Width, const Height) then
    begin
      AssertEquals(38, Width);
      AssertEquals(11, Height);
    end;
  else
    begin
      panic('expected viewport update after terminal resize');
    end;
  end if;

  App.InjectKeyForTest(MakeKey(TuiKeyKind.F2, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(Model.Overlay = ClientOverlay.ContextOverlay);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Character'));
  App.Close();
  discard CloseChannel(Requests);
  discard CloseChannel(Events);
  const TinyRequests: channel of ClientMessage := CreateChannel(1);
  const TinyEvents: channel of ClientEvent := CreateChannel(1);
  var TinyModel: ClientModel := NewClientModel('127.0.0.1', 4040, '', DefaultClientPreferences(), TinyRequests, TinyEvents);
  TinyModel.Screen := ClientScreen.GameScreen;
  TinyModel.FocusedControl := 0;
  TinyModel.ViewportWidth := 20;
  TinyModel.ViewportHeight := 6;
  const TinyApp: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 6));
  TinyModel := TinyApp.RunIterations(TinyModel, UpdateClient, ViewClient, 0, 0);
  AssertEquals(20, TinyApp.SurfaceSnapshot().Width);
  AssertEquals(6, TinyApp.SurfaceSnapshot().Height);
  TinyApp.Close();
  discard CloseChannel(TinyRequests);
  discard CloseChannel(TinyEvents);
end.
