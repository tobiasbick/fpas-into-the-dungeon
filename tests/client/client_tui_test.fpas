// Verifies start, game, responsive panel, and modal client presentation through the TUI host.
program DungeonClientTuiTest;

uses
  Dungeon.Client, Dungeon.Protocol, Std.Options, Std.Results, Std.Str, Std.Task, Std.Test, Std.Tui;

const
  ConnectControlId: integer := 1;
  ConnectAction: integer := 101;

function ScreenContains(Snapshot: TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Row: integer := 0 to Snapshot.Height - 1 do
  begin
    if Std.Str.Contains(Snapshot.LineAt(Row), Text) then
    begin
      return true
    end
  end;

  return false
end;

function MakeKey(Kind: TuiKeyKind; Character: string; Ctrl: boolean; Alt: boolean): TuiKeyEvent;
begin
  return record
    kind := Kind;
    ch := Character;
    shift := false;
    ctrl := Ctrl;
    alt := Alt;
    meta := false;
  end
end;

begin
  var StartRequests: channel of ClientMessage := CreateChannel(2);
  var StartEvents: channel of ClientEvent := CreateChannel(2);
  mutable var StartModel: ClientModel := NewClientModel('127.0.0.1', 4040, StartRequests, StartEvents);
  var StartApp: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 24));
  StartModel := StartApp.RunIterations(StartModel, UpdateClient, ViewClient, 0, 0);
  var StartSurface: TuiSurfaceSnapshot := StartApp.SurfaceSnapshot();
  AssertTrue(ScreenContains(StartSurface, 'INTO THE DUNGEON'));
  AssertTrue(ScreenContains(StartSurface, 'Connect'));
  AssertTrue(ScreenContains(StartSurface, 'Information'));
  AssertTrue(ScreenContains(StartSurface, 'Quit'));
  AssertTrue(ScreenContains(StartSurface, '╭'));
  StartApp.InjectKeyForTest(MakeKey(TuiKeyKind.Down, '', false, false));
  StartModel := StartApp.RunIterations(StartModel, UpdateClient, ViewClient, 1, 0);
  StartApp.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, '', false, false));
  StartModel := StartApp.RunIterations(StartModel, UpdateClient, ViewClient, 1, 0);
  AssertTrue(StartModel.Overlay = ClientOverlay.InformationOverlay);
  AssertTrue(ScreenContains(StartApp.SurfaceSnapshot(), 'Functional Pascal client-server RPG'));
  StartApp.InjectKeyForTest(MakeKey(TuiKeyKind.Escape, '', false, false));
  StartModel := StartApp.RunIterations(StartModel, UpdateClient, ViewClient, 1, 0);
  AssertTrue(StartModel.Overlay = ClientOverlay.NoOverlay);
  AssertTrue(ScreenContains(StartApp.SurfaceSnapshot(), 'Connect'));
  StartApp.Close();
  CloseChannel(StartRequests);
  CloseChannel(StartEvents);
  var ConnectingRequests: channel of ClientMessage := CreateChannel(2);
  var ConnectingEvents: channel of ClientEvent := CreateChannel(2);
  mutable var ConnectingModel: ClientModel := NewClientModel('127.0.0.1', 4040, ConnectingRequests, ConnectingEvents);
  var ConnectingCmd: TuiCmdOutput := TuiCmdOutput.Create();
  ConnectingModel := UpdateClient(ConnectingModel, TuiMsg.Action(TuiControlId.Create(ConnectControlId), TuiAction.Create(ConnectAction)), ConnectingCmd);
  var ConnectingApp: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 24));
  ConnectingModel := ConnectingApp.RunIterations(ConnectingModel, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ConnectingModel.Screen = ClientScreen.GameScreen);
  AssertTrue(ConnectingModel.ConnectionPhase = ClientConnectionPhase.Connecting);
  AssertTrue(ScreenContains(ConnectingApp.SurfaceSnapshot(), 'Connecting to 127.0.0.1:4040'));
  ConnectingApp.Close();
  CloseChannel(ConnectingRequests);
  CloseChannel(ConnectingEvents);
  var Requests: channel of ClientMessage := CreateChannel(2);
  var Events: channel of ClientEvent := CreateChannel(2);
  mutable var Model: ClientModel := NewClientModel('127.0.0.1', 4040, Requests, Events);
  Model.Screen := ClientScreen.GameScreen;
  Model.FocusedControl := 0;
  Model.ViewportWidth := 180;
  Model.ViewportHeight := 30;
  Model.RequestedWorldWidth := 59;
  Model.RequestedWorldHeight := 25;
  var Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  Model := UpdateClientEvent(Model, ClientEvent.Connected, Cmd);
  var MapValue: MapVisibleState := record
    OriginX := -3;
    OriginY := -1;
    Width := 6;
    Height := 3;
    Rows := ['ofdmgl', 'gppett', 'lromfg'];
    PlayerX := 3;
    PlayerY := 1;
    WorldX := 0;
    WorldY := 0;
  end;
  var StateValue: VisibleState := VisibleState.MapState(MapValue);
  Model := UpdateClientEvent(Model, ClientEvent.State(StateValue), Cmd);
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(180, 30));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  var GameSurface: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  var ContextColumn: integer := Std.Str.IndexOf(GameSurface.LineAt(0), 'Context');
  AssertTrue(ContextColumn >= GameSurface.Width div 2);
  AssertTrue(ContextColumn <= (GameSurface.Width * 3) div 4);
  AssertEquals('●', GameSurface.CellAt(7, 2).Glyph);
  AssertEquals(' ', GameSurface.CellAt(8, 2).Glyph);
  AssertTrue(Std.Options.Unwrap(GameSurface.CellAt(1, 1).ConcreteStyle).Background.Red = 18);
  AssertTrue(Std.Options.Unwrap(GameSurface.CellAt(2, 1).ConcreteStyle).Background.Red = 18);
  AssertTrue(Std.Options.Unwrap(GameSurface.CellAt(3, 1).ConcreteStyle).Background.Red = 24);
  AssertTrue(Std.Options.Unwrap(GameSurface.CellAt(5, 1).ConcreteStyle).Background.Red = 151);
  AssertTrue(Std.Options.Unwrap(GameSurface.CellAt(7, 1).ConcreteStyle).Background.Red = 82);
  AssertTrue(Std.Options.Unwrap(GameSurface.CellAt(9, 1).ConcreteStyle).Background.Red = 40);
  AssertTrue(Std.Options.Unwrap(GameSurface.CellAt(11, 1).ConcreteStyle).Background.Red = 35);
  AssertTrue(Std.Options.Unwrap(GameSurface.CellAt(3, 2).ConcreteStyle).Background.Red = 116);
  AssertTrue(Std.Options.Unwrap(GameSurface.CellAt(3, 3).ConcreteStyle).Background.Red = 30);
  AssertEquals('♣', GameSurface.CellAt(11, 2).Glyph);
  AssertTrue(Std.Options.Unwrap(GameSurface.CellAt(11, 2).ConcreteStyle).Foreground.Green = 166);
  AssertTrue(Std.Options.Unwrap(GameSurface.CellAt(7, 2).ConcreteStyle).Background.Red = 150);
  AssertTrue(Std.Options.Unwrap(GameSurface.CellAt(1, 1).ConcreteStyle).Background.Kind =
             TuiColorKind.Rgb);
  AssertTrue(ScreenContains(GameSurface, 'Context'));
  AssertTrue(ScreenContains(GameSurface, 'Character'));
  AssertTrue(ScreenContains(GameSurface, 'Position: 0, 0'));
  AssertTrue(ScreenContains(GameSurface, 'Connected'));
  AssertTrue(ScreenContains(GameSurface, 'Ctrl+P'));
  mutable var PlayerMovedMap: MapVisibleState := MapValue;
  PlayerMovedMap.PlayerX := 2;
  PlayerMovedMap.WorldX := -1;
  Model := UpdateClientEvent(Model, ClientEvent.State(VisibleState.MapState(PlayerMovedMap)), Cmd);
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertEquals('◆', App.SurfaceSnapshot().CellAt(7, 2).Glyph);
  AssertEquals(' ', App.SurfaceSnapshot().CellAt(8, 2).Glyph);
  AssertTrue(Std.Options.Unwrap(App.SurfaceSnapshot().CellAt(7, 2).ConcreteStyle).Background.Red =
             72);
  AssertTrue(Std.Options.Unwrap(App.SurfaceSnapshot().CellAt(8, 2).ConcreteStyle).Background.Red =
             72);
  Model := UpdateClientEvent(Model, ClientEvent.State(StateValue), Cmd);
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertEquals('●', App.SurfaceSnapshot().CellAt(7, 2).Glyph);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(Model.Pending);
  case Std.Results.Unwrap(ReceiveWithTimeout(Requests, 0)) of
    ClientMessage.ActivateAreaTransition:
    begin
    end
    else
    begin
      panic('expected Enter to activate the area transition')
    end
  end;

  Model.Pending := false;
  App.InjectKeyForTest(MakeKey(TuiKeyKind.F3, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(Model.MessagePanelVisible);
  AssertTrue(Model.Pending);
  AssertEquals('●', App.SurfaceSnapshot().CellAt(7, 2).Glyph);
  case Std.Results.Unwrap(ReceiveWithTimeout(Requests, 0)) of
    ClientMessage.Viewport(Width, Height):
    begin
      AssertEquals(59, Width);
      AssertEquals(19, Height)
    end
    else
    begin
      panic('expected viewport update after message panel toggle')
    end
  end;

  Model.Pending := false;
  Model.RequestedWorldWidth := 59;
  Model.RequestedWorldHeight := 19;
  var MessageSurface: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  AssertTrue(ScreenContains(MessageSurface, 'Messages'));
  AssertTrue(ScreenContains(MessageSurface, 'Status'));
  AssertEquals('╮', Std.Str.CharAt(MessageSurface.LineAt(MessageSurface.Height - 9), MessageSurface.Width -
                                                                                     1));
  AssertEquals('╰', Std.Str.CharAt(MessageSurface.LineAt(MessageSurface.Height - 4), 0));
  AssertEquals('╯', Std.Str.CharAt(MessageSurface.LineAt(MessageSurface.Height - 4), MessageSurface.Width -
                                                                                     1));
  AssertEquals('╰', Std.Str.CharAt(MessageSurface.LineAt(MessageSurface.Height - 1), 0));
  AssertEquals('╯', Std.Str.CharAt(MessageSurface.LineAt(MessageSurface.Height - 1), MessageSurface.Width -
                                                                                     1));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'p', true, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(Model.Overlay = ClientOverlay.SystemMenuOverlay);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'System menu'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'WASD'));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'd', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(Std.Results.IsError(ReceiveWithTimeout(Requests, 0)));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Escape, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(Model.Overlay = ClientOverlay.NoOverlay);
  var FirstPersonValue: FirstPersonVisibleState := record
    Title := 'Initial dungeon';
    Status := 'Press Enter to return to the outdoor region.';
  end;

  Model := UpdateClientEvent(Model, ClientEvent.State(VisibleState.FirstPersonState(FirstPersonValue)), Cmd);
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'First-person view'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Initial dungeon'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'passage continues into darkness'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Press Enter to return'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Context'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Messages'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Status'));
  AssertEquals('╭', Std.Str.CharAt(App.SurfaceSnapshot().LineAt(0), 0));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Character, 'p', true, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Enter, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(Std.Results.IsError(ReceiveWithTimeout(Requests, 0)));
  App.InjectKeyForTest(MakeKey(TuiKeyKind.Escape, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  App.InjectResizeForTest(TuiSize.Create(40, 16));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertEquals(40, Model.ViewportWidth);
  AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Character'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Initial dungeon'));
  case Std.Results.Unwrap(ReceiveWithTimeout(Requests, 0)) of
    ClientMessage.Viewport(Width, Height):
    begin
      AssertEquals(19, Width);
      AssertEquals(11, Height)
    end
    else
    begin
      panic('expected viewport update after terminal resize')
    end
  end;

  App.InjectKeyForTest(MakeKey(TuiKeyKind.F2, '', false, false));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 1, 0);
  AssertTrue(Model.Overlay = ClientOverlay.ContextOverlay);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Character'));
  App.Close();
  CloseChannel(Requests);
  CloseChannel(Events);
  var TinyRequests: channel of ClientMessage := CreateChannel(1);
  var TinyEvents: channel of ClientEvent := CreateChannel(1);
  mutable var TinyModel: ClientModel := NewClientModel('127.0.0.1', 4040, TinyRequests, TinyEvents);
  TinyModel.Screen := ClientScreen.GameScreen;
  TinyModel.FocusedControl := 0;
  TinyModel.ViewportWidth := 20;
  TinyModel.ViewportHeight := 6;
  var TinyApp: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(20, 6));
  TinyModel := TinyApp.RunIterations(TinyModel, UpdateClient, ViewClient, 0, 0);
  AssertEquals(20, TinyApp.SurfaceSnapshot().Width);
  AssertEquals(6, TinyApp.SurfaceSnapshot().Height);
  TinyApp.Close();
  CloseChannel(TinyRequests);
  CloseChannel(TinyEvents)
end.
