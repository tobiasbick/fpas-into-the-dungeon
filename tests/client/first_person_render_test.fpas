// Verifies deterministic first-person ray intersections and complete terminal-cell rendering.
program DungeonFirstPersonRenderTest;

uses Dungeon.Client.Raycast, Dungeon.Protocol, Std.Arrays, Std.Options, Std.Str, Std.Test, Std.Tui;

function FixedState(Facing: FirstPersonFacing): FirstPersonVisibleState;
begin
  return record
    Title := 'Initial dungeon';
    Status := 'Find the gold exit field.';
    Width := 11;
    Height := 9;
    Rows := [
              '#########t#',
              '#.........#',
              '#.#####.#.#',
              '#.....#.#.#',
              '###.#.#.#.#',
              '#...#...#.#',
              '#.#####.#.#',
              '#x........#',
              '###########'
            ];
    KnowledgeRows := [
                       'vvvvvvvvvvv',
                       'vvvvvvvvvvv',
                       'vvvvvvvvvvv',
                       'vvvvvvvvvvv',
                       'vvvvvvvvvvv',
                       'vvvvvvvvvvv',
                       'vvvvvvvvvvv',
                       'vvvvvvvvvvv',
                       'vvvvvvvvvvv'
                     ];
    PlayerX := 9;
    PlayerY := 1;
    Facing := Facing;
    Inventory := [];
  end
end;

// Checks each branch independently with open and blocked forward movement.
procedure VerifyJunction(Facing: FirstPersonFacing; DX: integer; DY: integer);
begin
  for FrontBlocked: boolean in [false, true] do
  begin
    for Width: integer in [21, 41, 101] do
    begin
      var Height: integer := 21;
      mutable var Value: FirstPersonVisibleState := FixedState(Facing);
      Value.Width := 7;
      Value.Height := 7;
      Value.PlayerX := 3;
      Value.PlayerY := 3;
      Value.Rows := ['#######', '#######', '#######', '###.###', '#######', '#######', '#######'];
      Value.KnowledgeRows := [
                               'vvvvvvv',
                               'vvvvvvv',
                               'vvvvvvv',
                               'vvvvvvv',
                               'vvvvvvv',
                               'vvvvvvv',
                               'vvvvvvv'
                             ];
      if not FrontBlocked then
      begin
        for Depth: integer := 1 to 2 do
        begin
          var Y: integer := 3 + DY * Depth;
          Value.Rows[Y] := Std.Str.SetCharAt(Value.Rows[Y], 3 + DX * Depth, '.')
        end
      end;
      var Closed: TuiCellGrid := RenderFirstPersonGrid(Value, Width, Height);
      // In screen coordinates, left is (DY, -DX).
      Value.Rows[3 - DX] := Std.Str.SetCharAt(Value.Rows[3 - DX], 3 + DY, '.');
      var LeftOpen: TuiCellGrid := RenderFirstPersonGrid(Value, Width, Height);
      Value.Rows[3 + DX] := Std.Str.SetCharAt(Value.Rows[3 + DX], 3 - DY, '.');
      var BothOpen: TuiCellGrid := RenderFirstPersonGrid(Value, Width, Height);
      var L: integer := 10 * Width;
      var R: integer := (L + Width) - 1;
      AssertTrue(Std.Options.Unwrap(Closed.Cells[L].ConcreteStyle).Background.Red <>
                 Std.Options.Unwrap(LeftOpen.Cells[L].ConcreteStyle).Background.Red);
      AssertEquals(Std.Options.Unwrap(Closed.Cells[R].ConcreteStyle).Background.Red, Std.Options.Unwrap(LeftOpen.Cells[R].ConcreteStyle)
                                                                                       .Background
                                                                                       .Red);
      AssertTrue(Std.Options.Unwrap(LeftOpen.Cells[R].ConcreteStyle).Background.Red <>
                 Std.Options.Unwrap(BothOpen.Cells[R].ConcreteStyle).Background.Red);
      AssertEquals(Std.Options.Unwrap(LeftOpen.Cells[L].ConcreteStyle).Background.Red, Std.Options.Unwrap(BothOpen.Cells[L].ConcreteStyle)
                                                                                         .Background
                                                                                         .Red);
      // A near closed side reaches the top edge; an opening exposes ceiling.
      AssertTrue(Std.Options.Unwrap(Closed.Cells[0].ConcreteStyle).Background.Red > 100);
      AssertEquals(12, Std.Options.Unwrap(BothOpen.Cells[0].ConcreteStyle).Background.Red);
      AssertEquals(12, Std.Options.Unwrap(BothOpen.Cells[Width - 1].ConcreteStyle).Background.Red)
    end
  end
end;

function BackgroundRed(Cell: TuiCell): integer;
begin
  return Std.Options.Unwrap(Cell.ConcreteStyle).Background.Red
end;

function BackgroundBlue(Cell: TuiCell): integer;
begin
  return Std.Options.Unwrap(Cell.ConcreteStyle).Background.Blue
end;

// Removing a traversable exit may change floor pixels only, never walls or sky.
function VerifyExitMaterial(Value: FirstPersonVisibleState; Width: integer; Height: integer): integer;
begin
  mutable var Plain: FirstPersonVisibleState := Value;
  Plain.Rows[7] := '#.........#';
  var Actual: TuiCellGrid := RenderFirstPersonGrid(Value, Width, Height);
  var Expected: TuiCellGrid := RenderFirstPersonGrid(Plain, Width, Height);
  mutable var GoldCount: integer := 0;
  for I: integer := 0 to Std.Arrays.Length(Actual.Cells) - 1 do
  begin
    var A: TuiColor := Std.Options.Unwrap(Actual.Cells[I].ConcreteStyle).Background;
    var B: TuiColor := Std.Options.Unwrap(Expected.Cells[I].ConcreteStyle).Background;
    if ((A.Red <> B.Red) or (A.Green <> B.Green)) or (A.Blue <> B.Blue) then
    begin
      AssertEquals(92, A.Red);
      AssertEquals(68, A.Green);
      AssertEquals(20, A.Blue);
      AssertEquals(38, B.Red);
      AssertEquals(34, B.Green);
      AssertEquals(31, B.Blue);
      GoldCount := GoldCount + 1
    end
  end;

  return GoldCount
end;

begin
  // At a junction, opening either immediate side must change that screen edge,
  // even while the field directly ahead remains traversable.
  mutable var Junction: FirstPersonVisibleState := FixedState(FirstPersonFacing.North);
  Junction.PlayerX := 5;
  Junction.PlayerY := 5;
  Junction.Rows := [
                     '###########',
                     '#####.#####',
                     '#####.#####',
                     '#####.#####',
                     '#####.#####',
                     '#####.#####',
                     '###########',
                     '###########',
                     '###########'
                   ];
  var ClosedJunction: TuiCellGrid := RenderFirstPersonGrid(Junction, 41, 21);
  Junction.Rows[5] := '####...####';
  var OpenJunction: TuiCellGrid := RenderFirstPersonGrid(Junction, 41, 21);
  AssertTrue(BackgroundRed(ClosedJunction.Cells[10 * 41]) <>
             BackgroundRed(OpenJunction.Cells[10 * 41]));
  AssertTrue(BackgroundRed(ClosedJunction.Cells[10 * 41 + 40]) <>
             BackgroundRed(OpenJunction.Cells[10 * 41 + 40]));
  VerifyJunction(FirstPersonFacing.North, 0, -1);
  VerifyJunction(FirstPersonFacing.East, 1, 0);
  VerifyJunction(FirstPersonFacing.South, 0, 1);
  VerifyJunction(FirstPersonFacing.West, -1, 0);
  // Covers near and distant walls, junctions, and each facing with one projection.
  for Facing: FirstPersonFacing in [
                                     FirstPersonFacing.North,
                                     FirstPersonFacing.East,
                                     FirstPersonFacing.South,
                                     FirstPersonFacing.West
                                   ] do
  begin
    mutable var Pose: FirstPersonVisibleState := FixedState(Facing);
    for Y: integer := 1 to 7 do
    begin
      for X: integer := 1 to 9 do
      begin
        if Std.Str.CharAt(Pose.Rows[Y], X) <> '#' then
        begin
          Pose.PlayerX := X;
          Pose.PlayerY := Y;
          var Changed: integer := VerifyExitMaterial(Pose, 21, 11);
          AssertTrue(Changed >= 0)
        end
      end
    end
  end;
  mutable var Approach: FirstPersonVisibleState := FixedState(FirstPersonFacing.West);
  Approach.PlayerX := 2;
  Approach.PlayerY := 7;
  AssertTrue(VerifyExitMaterial(Approach, 101, 39) > 0);
  Approach.PlayerX := 1;
  AssertTrue(VerifyExitMaterial(Approach, 101, 39) > 0);
  var North: FirstPersonRayHit := CastFirstPersonRay(FixedState(FirstPersonFacing.North), 0.0);
  var East: FirstPersonRayHit := CastFirstPersonRay(FixedState(FirstPersonFacing.East), 0.0);
  var South: FirstPersonRayHit := CastFirstPersonRay(FixedState(FirstPersonFacing.South), 0.0);
  var West: FirstPersonRayHit := CastFirstPersonRay(FixedState(FirstPersonFacing.West), 0.0);
  AssertTrue((North.Distance > 0.84) and (North.Distance < 0.86));
  AssertTrue((East.Distance > 0.84) and (East.Distance < 0.86));
  AssertTrue((South.Distance > 6.84) and (South.Distance < 6.86));
  AssertTrue((West.Distance > 8.84) and (West.Distance < 8.86));
  AssertFalse(North.VerticalSide);
  AssertEquals('t', North.FieldCode);
  AssertTrue(East.VerticalSide);
  AssertFalse(South.VerticalSide);
  AssertTrue(West.VerticalSide);
  var TabletGrid: TuiCellGrid := RenderFirstPersonGrid(FixedState(FirstPersonFacing.North), 21, 11);
  var TabletCenter: TuiCell := TabletGrid.Cells[(5 * 21) + 10];
  AssertTrue(BackgroundBlue(TabletCenter) > BackgroundRed(TabletCenter));
  mutable var PlainNorth: FirstPersonVisibleState := FixedState(FirstPersonFacing.North);
  PlainNorth.Rows[0] := '###########';
  var PlainGrid: TuiCellGrid := RenderFirstPersonGrid(PlainNorth, 21, 11);
  AssertTrue(BackgroundBlue(TabletCenter) <> BackgroundBlue(PlainGrid.Cells[(5 * 21) + 10]));
  mutable var ItemAhead: FirstPersonVisibleState := FixedState(FirstPersonFacing.West);
  ItemAhead.Rows[1] := Std.Str.SetCharAt(ItemAhead.Rows[1], 8, 'i');
  var ItemGrid: TuiCellGrid := RenderFirstPersonGrid(ItemAhead, 41, 21);
  mutable var ItemPixels: integer := 0;
  for Cell: TuiCell in ItemGrid.Cells do
  begin
    if Cell.Glyph = '●' then
    begin
      AssertEquals(78, BackgroundRed(Cell));
      ItemPixels := ItemPixels + 1
    end
  end;

  AssertTrue(ItemPixels > 0);
  AssertTrue(ItemPixels < 41);
  ItemAhead.Rows[1] := Std.Str.SetCharAt(ItemAhead.Rows[1], 8, '.');
  var CollectedGrid: TuiCellGrid := RenderFirstPersonGrid(ItemAhead, 41, 21);
  for Cell: TuiCell in CollectedGrid.Cells do
  begin
    AssertFalse(Cell.Glyph = '●')
  end;
  var Occluded: FirstPersonVisibleState := record
    Title := 'Occlusion';
    Status := '';
    Width := 7;
    Height := 5;
    Rows := ['#######', '#.....#', '#.#x#.#', '#.....#', '#######'];
    KnowledgeRows := ['vvvvvvv', 'vvvvvvv', 'vvvvvvv', 'vvvvvvv', 'vvvvvvv'];
    PlayerX := 1;
    PlayerY := 2;
    Facing := FirstPersonFacing.East;
    Inventory := [];
  end;
  var OccludedHit: FirstPersonRayHit := CastFirstPersonRay(Occluded, 0.0);
  AssertTrue((OccludedHit.Distance > 0.84) and (OccludedHit.Distance < 0.86));
  AssertFalse(OccludedHit.SawExit);
  var VisibleExit: FirstPersonVisibleState := record
    Title := 'Visible exit';
    Status := '';
    Width := 7;
    Height := 5;
    Rows := ['#######', '#.....#', '#.x...#', '#.....#', '#######'];
    KnowledgeRows := ['vvvvvvv', 'vvvvvvv', 'vvvvvvv', 'vvvvvvv', 'vvvvvvv'];
    PlayerX := 1;
    PlayerY := 2;
    Facing := FirstPersonFacing.East;
    Inventory := [];
  end;
  var ExitHit: FirstPersonRayHit := CastFirstPersonRay(VisibleExit, 0.0);
  AssertTrue((ExitHit.Distance > 4.84) and (ExitHit.Distance < 4.86));
  AssertTrue(ExitHit.SawExit);
  var Fogged: FirstPersonVisibleState := record
    Title := 'Fogged';
    Status := 'Unknown ahead.';
    Width := 5;
    Height := 3;
    Rows := ['?????', '?.???', '?????'];
    KnowledgeRows := ['uuuuu', 'uvuuu', 'uuuuu'];
    PlayerX := 1;
    PlayerY := 1;
    Facing := FirstPersonFacing.East;
    Inventory := [];
  end;
  var FogHit: FirstPersonRayHit := CastFirstPersonRay(Fogged, 0.0);
  AssertEquals('?', FogHit.FieldCode);
  AssertFalse(FogHit.SawExit);
  var FogGrid: TuiCellGrid := RenderFirstPersonGrid(Fogged, 5, 5);
  AssertEquals(18, BackgroundRed(FogGrid.Cells[(2 * 5) + 2]));
  var FrontWallWithSidePaths: FirstPersonVisibleState := record
    Title := 'Side paths';
    Status := '';
    Width := 5;
    Height := 5;
    Rows := ['#####', '#.#.#', '#...#', '#...#', '#####'];
    KnowledgeRows := ['vvvvv', 'vvvvv', 'vvvvv', 'vvvvv', 'vvvvv'];
    PlayerX := 2;
    PlayerY := 2;
    Facing := FirstPersonFacing.North;
    Inventory := [];
  end;
  var SidePathGrid: TuiCellGrid := RenderFirstPersonGrid(FrontWallWithSidePaths, 21, 11);
  var FrontWallRed: integer := BackgroundRed(SidePathGrid.Cells[(5 * 21) + 10]);
  AssertEquals(12, BackgroundRed(SidePathGrid.Cells[10]));
  AssertTrue(FrontWallRed > 100);
  AssertEquals(38, BackgroundRed(SidePathGrid.Cells[(10 * 21) + 10]));
  AssertEquals(12, BackgroundRed(SidePathGrid.Cells[1 * 21]));
  AssertTrue(BackgroundRed(SidePathGrid.Cells[5 * 21]) > 100);
  AssertEquals(38, BackgroundRed(SidePathGrid.Cells[9 * 21]));
  mutable var LeftBlocked: FirstPersonVisibleState := FrontWallWithSidePaths;
  LeftBlocked.Rows[2] := '##..#';
  var OneSidePathGrid: TuiCellGrid := RenderFirstPersonGrid(LeftBlocked, 21, 11);
  AssertTrue(BackgroundRed(OneSidePathGrid.Cells[1 * 21]) > 100);
  AssertEquals(12, BackgroundRed(OneSidePathGrid.Cells[(1 * 21) + 20]));
  AssertTrue(BackgroundRed(OneSidePathGrid.Cells[(5 * 21) + 20]) > 100);
  mutable var UnknownSide: FirstPersonVisibleState := LeftBlocked;
  UnknownSide.Rows[2] := '#?..#';
  UnknownSide.KnowledgeRows[2] := 'vuvvv';
  var UnknownSideGrid: TuiCellGrid := RenderFirstPersonGrid(UnknownSide, 21, 11);
  AssertEquals(18, BackgroundRed(UnknownSideGrid.Cells[5 * 21]));
  AssertEquals(25, BackgroundBlue(UnknownSideGrid.Cells[5 * 21]));
  mutable var ScreenshotState: FirstPersonVisibleState := FixedState(FirstPersonFacing.West);
  ScreenshotState.PlayerX := 1;
  ScreenshotState.PlayerY := 1;
  var ScreenshotGrid: TuiCellGrid := RenderFirstPersonGrid(ScreenshotState, 21, 11);
  // The western boundary continues south: its front plane must remain seamless.
  for Y: integer := 0 to 10 do
  begin
    AssertEquals(BackgroundRed(ScreenshotGrid.Cells[(Y * 21) + 10]), BackgroundRed(ScreenshotGrid.Cells[Y *
                                                                                                        21]))
  end;

  AssertTrue(BackgroundRed(ScreenshotGrid.Cells[3 * 21]) > 100);
  AssertTrue(BackgroundRed(ScreenshotGrid.Cells[5 * 21]) > 100);
  AssertTrue(BackgroundRed(ScreenshotGrid.Cells[7 * 21]) > 100);
  AssertTrue(BackgroundRed(ScreenshotGrid.Cells[(1 * 21) + 20]) > 100);
  AssertEquals(12, BackgroundRed(ScreenshotGrid.Cells[10]));
  AssertEquals(38, BackgroundRed(ScreenshotGrid.Cells[(10 * 21) + 10]));
  mutable var BothSidePathsState: FirstPersonVisibleState := FixedState(FirstPersonFacing.East);
  BothSidePathsState.PlayerX := 7;
  BothSidePathsState.PlayerY := 5;
  var BothSidePathsGrid: TuiCellGrid := RenderFirstPersonGrid(BothSidePathsState, 21, 11);
  // Both branches run alongside the same eastern wall plane.
  for Y: integer := 0 to 10 do
  begin
    AssertEquals(BackgroundRed(BothSidePathsGrid.Cells[(Y * 21) + 10]), BackgroundRed(BothSidePathsGrid.Cells[Y *
                                                                                                              21]));
    AssertEquals(BackgroundRed(BothSidePathsGrid.Cells[(Y * 21) + 10]), BackgroundRed(BothSidePathsGrid.Cells[(Y * 21) +
                                                                                                              20]))
  end;

  AssertTrue(BackgroundRed(BothSidePathsGrid.Cells[4 * 21]) > 100);
  AssertTrue(BackgroundRed(BothSidePathsGrid.Cells[5 * 21]) > 100);
  AssertTrue(BackgroundRed(BothSidePathsGrid.Cells[(5 * 21) + 20]) > 100);
  AssertTrue(BackgroundRed(BothSidePathsGrid.Cells[7 * 21]) > 100);
  AssertTrue(BackgroundRed(BothSidePathsGrid.Cells[(7 * 21) + 20]) > 100);
  mutable var ExitState: FirstPersonVisibleState := FixedState(FirstPersonFacing.South);
  ExitState.PlayerX := 1;
  ExitState.PlayerY := 7;
  var ExitGrid: TuiCellGrid := RenderFirstPersonGrid(ExitState, 21, 11);
  AssertTrue(BackgroundBlue(ExitGrid.Cells[(5 * 21) + 10]) > 100);
  AssertEquals(92, BackgroundRed(ExitGrid.Cells[(10 * 21) + 10]));
  var NearGrid: TuiCellGrid := RenderFirstPersonGrid(FixedState(FirstPersonFacing.East), 9, 20);
  var FarGrid: TuiCellGrid := RenderFirstPersonGrid(FixedState(FirstPersonFacing.West), 9, 20);
  AssertEquals(9, NearGrid.Width);
  AssertEquals(20, NearGrid.Height);
  AssertEquals(180, Std.Arrays.Length(NearGrid.Cells));
  AssertEquals(180, Std.Arrays.Length(FarGrid.Cells));
  AssertTrue(BackgroundRed(NearGrid.Cells[(10 * 9) + 4]) >
             BackgroundRed(FarGrid.Cells[(10 * 9) + 4]));
  AssertEquals(12, BackgroundRed(FarGrid.Cells[4]));
  AssertEquals(38, BackgroundRed(FarGrid.Cells[(19 * 9) + 4]));
  for Cell: TuiCell in FarGrid.Cells do
  begin
    AssertTrue(Std.Options.IsSome(Cell.ConcreteStyle));
    AssertEquals(' ', Cell.Glyph)
  end;
  var Empty: TuiCellGrid := RenderFirstPersonGrid(FixedState(FirstPersonFacing.West), 0, 0);
  AssertEquals(0, Empty.Width);
  AssertEquals(0, Empty.Height);
  AssertEquals(0, Std.Arrays.Length(Empty.Cells));
  var Negative: TuiCellGrid := RenderFirstPersonGrid(FixedState(FirstPersonFacing.West), -2, -3);
  AssertEquals(0, Negative.Width);
  AssertEquals(0, Negative.Height);
  AssertEquals(0, Std.Arrays.Length(Negative.Cells));
  var Tiny: TuiCellGrid := RenderFirstPersonGrid(FixedState(FirstPersonFacing.West), 1, 1);
  AssertEquals(1, Tiny.Width);
  AssertEquals(1, Tiny.Height);
  AssertEquals(1, Std.Arrays.Length(Tiny.Cells));
  AssertTrue(Std.Options.IsSome(Tiny.Cells[0].ConcreteStyle))
end.
