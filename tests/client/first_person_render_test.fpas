// Verifies deterministic first-person ray intersections and complete terminal-cell rendering.
program DungeonFirstPersonRenderTest;

uses Dungeon.Client.Raycast, Dungeon.Client.Raycast.Rays, Dungeon.Protocol, Std.Test, Std.Tui;

function FixedState(Facing: FirstPersonFacing): FirstPersonVisibleState;
begin
  return FirstPersonVisibleState(Title := 'Initial dungeon', Status := 'Find the gold exit field.', Width := 11, Height := 9, Rows := [
                                                                                                                                        '###########',
                                                                                                                                        '#.........#',
                                                                                                                                        '#.#####.#.#',
                                                                                                                                        '#.....#.#.#',
                                                                                                                                        '###.#.#.#.#',
                                                                                                                                        '#...#...#.#',
                                                                                                                                        '#.#####.#.#',
                                                                                                                                        '#x........#',
                                                                                                                                        '###########'
                                                                                                                                      ], KnowledgeRows := [
                                                                                                                                                            'vvvvvvvvvvv',
                                                                                                                                                            'vvvvvvvvvvv',
                                                                                                                                                            'vvvvvvvvvvv',
                                                                                                                                                            'vvvvvvvvvvv',
                                                                                                                                                            'vvvvvvvvvvv',
                                                                                                                                                            'vvvvvvvvvvv',
                                                                                                                                                            'vvvvvvvvvvv',
                                                                                                                                                            'vvvvvvvvvvv',
                                                                                                                                                            'vvvvvvvvvvv'
                                                                                                                                                          ], PlayerX := 9, PlayerY := 1, Facing := Facing, Inventory := [], Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []);
end function;

// Checks each branch independently with open and blocked forward movement.
procedure VerifyJunction(Facing: FirstPersonFacing; DX: integer; DY: integer);
begin
  for FrontBlocked: boolean in [false, true] do
    begin
      for Width: integer in [21, 41, 101] do
        begin
          const Height: integer := 21;
          var Value: FirstPersonVisibleState := FixedState(Facing);
          Value.Width := 7;
          Value.Height := 7;
          Value.PlayerX := 3;
          Value.PlayerY := 3;
          Value.Rows := [
                          '#######',
                          '#######',
                          '#######',
                          '###.###',
                          '#######',
                          '#######',
                          '#######'
                        ];
          Value.KnowledgeRows := [
                                   'vvvvvvv',
                                   'vvvvvvv',
                                   'vvvvvvv',
                                   'vvvvvvv',
                                   'vvvvvvv',
                                   'vvvvvvv',
                                   'vvvvvvv'
                                 ];
          if not FrontBlocked then
            begin
              for Depth: integer := 1 to 2 do
                begin
                  const Y: integer := 3 + DY * Depth;
                  Value.Rows[Y] := Value.Rows[Y].SetCharAt(3 + DX * Depth, '.');
                end;
              end for;
            end;
          end if;
          const Closed: TuiCellGrid := RenderFirstPersonGrid(Value, Width, Height);
          // In screen coordinates, left is (DY, -DX).
          Value.Rows[3 - DX] := Value.Rows[3 - DX].SetCharAt(3 + DY, '.');
          const LeftOpen: TuiCellGrid := RenderFirstPersonGrid(Value, Width, Height);
          Value.Rows[3 + DX] := Value.Rows[3 + DX].SetCharAt(3 - DY, '.');
          const BothOpen: TuiCellGrid := RenderFirstPersonGrid(Value, Width, Height);
          const L: integer := 10 * Width;
          const R: integer := (L + Width) - 1;
          AssertTrue(Closed.Cells[L].ConcreteStyle.Unwrap().Background.Red <>
                     LeftOpen.Cells[L].ConcreteStyle.Unwrap().Background.Red);
          AssertEquals(Closed.Cells[R].ConcreteStyle.Unwrap().Background.Red, LeftOpen.Cells[R].ConcreteStyle.Unwrap()
                                                                                .Background
                                                                                .Red);
          AssertTrue(LeftOpen.Cells[R].ConcreteStyle.Unwrap().Background.Red <>
                     BothOpen.Cells[R].ConcreteStyle.Unwrap().Background.Red);
          AssertEquals(LeftOpen.Cells[L].ConcreteStyle.Unwrap().Background.Red, BothOpen.Cells[L].ConcreteStyle.Unwrap()
                                                                                  .Background
                                                                                  .Red);
          // A near closed side reaches the top edge; an opening exposes ceiling.
          AssertTrue(Closed.Cells[0].ConcreteStyle.Unwrap().Background.Red > 100);
          AssertEquals(12, BothOpen.Cells[0].ConcreteStyle.Unwrap().Background.Red);
          AssertEquals(12, BothOpen.Cells[Width - 1].ConcreteStyle.Unwrap().Background.Red);
        end;
      end for;
    end;
  end for;
end procedure;

// Counts cells whose glyph or either color differs between two equally sized grids.
function DifferentCells(Left: TuiCellGrid; Right: TuiCellGrid): integer;
begin
  var Count: integer := 0;
  for I: integer := 0 to Left.Cells.Length() - 1 do
    begin
      const A: TuiStyle := Left.Cells[I].ConcreteStyle.Unwrap();
      const B: TuiStyle := Right.Cells[I].ConcreteStyle.Unwrap();
      if (((Left.Cells[I].Glyph <> Right.Cells[I].Glyph) or (A.Background.Red <> B.Background.Red)) or ((A.Background.Green <> B.Background.Green) or (A.Background.Blue <> B.Background.Blue))) or
         (((A.Foreground.Red <> B.Foreground.Red) or (A.Foreground.Green <> B.Foreground.Green)) or (A.Foreground.Blue <> B.Foreground.Blue)) then
        begin
          Count := Count + 1;
        end;
      end if;
    end;
  end for;

  return Count;
end function;

function BackgroundRed(Cell: TuiCell): integer;
begin
  return Cell.ConcreteStyle.Unwrap().Background.Red;
end function;

function BackgroundBlue(Cell: TuiCell): integer;
begin
  return Cell.ConcreteStyle.Unwrap().Background.Blue;
end function;

// Every exit pixel is warmer than the plain floor at the same depth: more red, less blue.
procedure AssertGoldOverFloor(A: TuiColor; B: TuiColor);
begin
  AssertTrue(A.Red > B.Red);
  AssertTrue(A.Red > A.Green);
  AssertTrue(A.Green > A.Blue);
  AssertTrue(A.Blue <= B.Blue);
end procedure;

// Removing a traversable exit may change floor pixels only, never walls or sky.
// Both stacked pixels of a cell are compared: background is the lower, foreground the upper half.
function VerifyExitMaterial(Value: FirstPersonVisibleState; Width: integer; Height: integer): integer;
begin
  var Plain: FirstPersonVisibleState := Value;
  Plain.Rows[7] := '#.........#';
  const Actual: TuiCellGrid := RenderFirstPersonGrid(Value, Width, Height);
  const Expected: TuiCellGrid := RenderFirstPersonGrid(Plain, Width, Height);
  var GoldCount: integer := 0;
  for I: integer := 0 to Actual.Cells.Length() - 1 do
    begin
      const ActualStyle: TuiStyle := Actual.Cells[I].ConcreteStyle.Unwrap();
      const ExpectedStyle: TuiStyle := Expected.Cells[I].ConcreteStyle.Unwrap();
      const A: TuiColor := ActualStyle.Background;
      const B: TuiColor := ExpectedStyle.Background;
      if ((A.Red <> B.Red) or (A.Green <> B.Green)) or (A.Blue <> B.Blue) then
        begin
          AssertGoldOverFloor(A, B);
          GoldCount := GoldCount + 1;
        end;
      end if;
      const UpperA: TuiColor := ActualStyle.Foreground;
      const UpperB: TuiColor := ExpectedStyle.Foreground;
      if (Actual.Cells[I].Glyph = '▀') and
         (((UpperA.Red <> UpperB.Red) or (UpperA.Green <> UpperB.Green)) or (UpperA.Blue <> UpperB.Blue)) then
        begin
          AssertGoldOverFloor(UpperA, UpperB);
          GoldCount := GoldCount + 1;
        end;
      end if;
    end;
  end for;

  return GoldCount;
end function;

// Classifies a cell's lower pixel as stone wall, including darkened mortar: fog is red 18,
// ceiling at most 12, plain floor at most 38, and the gold exit floor has almost no blue.
function IsWallCell(Cell: TuiCell): boolean;
begin
  const Color: TuiColor := Cell.ConcreteStyle.Unwrap().Background;
  return (Color.Red > 60) and ((Color.Blue * 2) > Color.Red);
end function;

begin
  // At a junction, opening either immediate side must change that screen edge,
  // even while the field directly ahead remains traversable.
  var Junction: FirstPersonVisibleState := FixedState(FirstPersonFacing.North);
  Junction.PlayerX := 5;
  Junction.PlayerY := 5;
  Junction.Rows := [
                     '###########',
                     '#####.#####',
                     '#####.#####',
                     '#####.#####',
                     '#####.#####',
                     '#####.#####',
                     '###########',
                     '###########',
                     '###########'
                   ];
  const ClosedJunction: TuiCellGrid := RenderFirstPersonGrid(Junction, 41, 21);
  Junction.Rows[5] := '####...####';
  const OpenJunction: TuiCellGrid := RenderFirstPersonGrid(Junction, 41, 21);
  AssertTrue(BackgroundRed(ClosedJunction.Cells[10 * 41]) <>
             BackgroundRed(OpenJunction.Cells[10 * 41]));
  AssertTrue(BackgroundRed(ClosedJunction.Cells[10 * 41 + 40]) <>
             BackgroundRed(OpenJunction.Cells[10 * 41 + 40]));
  VerifyJunction(FirstPersonFacing.North, 0, -1);
  VerifyJunction(FirstPersonFacing.East, 1, 0);
  VerifyJunction(FirstPersonFacing.South, 0, 1);
  VerifyJunction(FirstPersonFacing.West, -1, 0);
  // Covers near and distant walls, junctions, and each facing with one projection.
  for Facing: FirstPersonFacing in [
                                     FirstPersonFacing.North,
                                     FirstPersonFacing.East,
                                     FirstPersonFacing.South,
                                     FirstPersonFacing.West
                                   ] do
    begin
      var Pose: FirstPersonVisibleState := FixedState(Facing);
      for Y: integer := 1 to 7 do
        begin
          for X: integer := 1 to 9 do
            begin
              if Pose.Rows[Y].CharAt(X) <> '#' then
                begin
                  Pose.PlayerX := X;
                  Pose.PlayerY := Y;
                  const Changed: integer := VerifyExitMaterial(Pose, 21, 11);
                  AssertTrue(Changed >= 0);
                end;
              end if;
            end;
          end for;
        end;
      end for;
    end;
  end for;
  var Approach: FirstPersonVisibleState := FixedState(FirstPersonFacing.West);
  Approach.PlayerX := 2;
  Approach.PlayerY := 7;
  AssertTrue(VerifyExitMaterial(Approach, 101, 39) > 0);
  Approach.PlayerX := 1;
  AssertTrue(VerifyExitMaterial(Approach, 101, 39) > 0);
  const North: FirstPersonRayHit := CastFirstPersonRay(FixedState(FirstPersonFacing.North), 0.0);
  const East: FirstPersonRayHit := CastFirstPersonRay(FixedState(FirstPersonFacing.East), 0.0);
  const South: FirstPersonRayHit := CastFirstPersonRay(FixedState(FirstPersonFacing.South), 0.0);
  const West: FirstPersonRayHit := CastFirstPersonRay(FixedState(FirstPersonFacing.West), 0.0);
  AssertTrue((North.Distance > 0.84) and (North.Distance < 0.86));
  AssertTrue((East.Distance > 0.84) and (East.Distance < 0.86));
  AssertTrue((South.Distance > 6.84) and (South.Distance < 6.86));
  AssertTrue((West.Distance > 8.84) and (West.Distance < 8.86));
  AssertFalse(North.VerticalSide);
  AssertEquals(InteriorWallCode, North.FieldCode);
  AssertTrue(East.VerticalSide);
  AssertFalse(South.VerticalSide);
  AssertTrue(West.VerticalSide);
  var ItemAhead: FirstPersonVisibleState := FixedState(FirstPersonFacing.West);
  ItemAhead.Rows[1] := ItemAhead.Rows[1].SetCharAt(8, 'i');
  const ItemGrid: TuiCellGrid := RenderFirstPersonGrid(ItemAhead, 41, 21);
  ItemAhead.Rows[1] := ItemAhead.Rows[1].SetCharAt(8, '.');
  const CollectedGrid: TuiCellGrid := RenderFirstPersonGrid(ItemAhead, 41, 21);
  // The coin is a small floor object: visible, but far smaller than one screen row.
  const ItemCells: integer := DifferentCells(ItemGrid, CollectedGrid);
  AssertTrue(ItemCells > 0);
  AssertTrue(ItemCells < 41);
  // Once collected, the field renders exactly like the plain corridor.
  AssertEquals(0, DifferentCells(CollectedGrid, RenderFirstPersonGrid(FixedState(FirstPersonFacing.West), 41, 21)));
  // The opponent is an upright figure: it changes cells above the horizon, not only the floor.
  const HostileCorridor: FirstPersonVisibleState := FirstPersonVisibleState(Title := 'Opponent figure', Status := '', Width := 7, Height := 3, Rows := [
                                                                                                                                                         '#######',
                                                                                                                                                         '#..h..#',
                                                                                                                                                         '#######'
                                                                                                                                                       ], KnowledgeRows := [
                                                                                                                                                                             'vvvvvvv',
                                                                                                                                                                             'vvvvvvv',
                                                                                                                                                                             'vvvvvvv'
                                                                                                                                                                           ], PlayerX := 1, PlayerY := 1, Facing := FirstPersonFacing.East, Inventory := [], Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []);
  var EmptyCorridor: FirstPersonVisibleState := HostileCorridor;
  EmptyCorridor.Rows[1] := '#.....#';
  const HostileFigure: TuiCellGrid := RenderFirstPersonGrid(HostileCorridor, 61, 25);
  const EmptyFigure: TuiCellGrid := RenderFirstPersonGrid(EmptyCorridor, 61, 25);
  var UpperHostileCells: integer := 0;
  for I: integer := 0 to (12 * 61) - 1 do
    begin
      if DifferentCells(TuiCellGrid.Create(1, 1, [HostileFigure.Cells[I]]), TuiCellGrid.Create(1, 1, [
                                                                                                       EmptyFigure.Cells[I]
                                                                                                     ])) >
         0 then
        begin
          UpperHostileCells := UpperHostileCells + 1;
        end;
      end if;
    end;
  end for;

  AssertTrue(UpperHostileCells > 0);
  // Walls hide figures standing behind them.
  var HiddenHostile: FirstPersonVisibleState := HostileCorridor;
  HiddenHostile.Rows[1] := '#.#h..#';
  var HiddenEmpty: FirstPersonVisibleState := HostileCorridor;
  HiddenEmpty.Rows[1] := '#.#...#';
  AssertEquals(0, DifferentCells(RenderFirstPersonGrid(HiddenHostile, 61, 25), RenderFirstPersonGrid(HiddenEmpty, 61, 25)));
  const Occluded: FirstPersonVisibleState := FirstPersonVisibleState(Title := 'Occlusion', Status := '', Width := 7, Height := 5, Rows := [
                                                                                                                                            '#######',
                                                                                                                                            '#.....#',
                                                                                                                                            '#.#x#.#',
                                                                                                                                            '#.....#',
                                                                                                                                            '#######'
                                                                                                                                          ], KnowledgeRows := [
                                                                                                                                                                'vvvvvvv',
                                                                                                                                                                'vvvvvvv',
                                                                                                                                                                'vvvvvvv',
                                                                                                                                                                'vvvvvvv',
                                                                                                                                                                'vvvvvvv'
                                                                                                                                                              ], PlayerX := 1, PlayerY := 2, Facing := FirstPersonFacing.East, Inventory := [], Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []);
  const OccludedHit: FirstPersonRayHit := CastFirstPersonRay(Occluded, 0.0);
  AssertTrue((OccludedHit.Distance > 0.84) and (OccludedHit.Distance < 0.86));
  AssertFalse(OccludedHit.SawExit);
  const VisibleExit: FirstPersonVisibleState := FirstPersonVisibleState(Title := 'Visible exit', Status := '', Width := 7, Height := 5, Rows := [
                                                                                                                                                  '#######',
                                                                                                                                                  '#.....#',
                                                                                                                                                  '#.x...#',
                                                                                                                                                  '#.....#',
                                                                                                                                                  '#######'
                                                                                                                                                ], KnowledgeRows := [
                                                                                                                                                                      'vvvvvvv',
                                                                                                                                                                      'vvvvvvv',
                                                                                                                                                                      'vvvvvvv',
                                                                                                                                                                      'vvvvvvv',
                                                                                                                                                                      'vvvvvvv'
                                                                                                                                                                    ], PlayerX := 1, PlayerY := 2, Facing := FirstPersonFacing.East, Inventory := [], Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []);
  const ExitHit: FirstPersonRayHit := CastFirstPersonRay(VisibleExit, 0.0);
  AssertTrue((ExitHit.Distance > 4.84) and (ExitHit.Distance < 4.86));
  AssertTrue(ExitHit.SawExit);
  const Fogged: FirstPersonVisibleState := FirstPersonVisibleState(Title := 'Fogged', Status := 'Unknown ahead.', Width := 5, Height := 3, Rows := [
                                                                                                                                                     '?????',
                                                                                                                                                     '?.???',
                                                                                                                                                     '?????'
                                                                                                                                                   ], KnowledgeRows := [
                                                                                                                                                                         'uuuuu',
                                                                                                                                                                         'uvuuu',
                                                                                                                                                                         'uuuuu'
                                                                                                                                                                       ], PlayerX := 1, PlayerY := 1, Facing := FirstPersonFacing.East, Inventory := [], Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []);
  const FogHit: FirstPersonRayHit := CastFirstPersonRay(Fogged, 0.0);
  AssertEquals('?', FogHit.FieldCode);
  AssertFalse(FogHit.SawExit);
  const FogGrid: TuiCellGrid := RenderFirstPersonGrid(Fogged, 5, 5);
  AssertEquals(18, BackgroundRed(FogGrid.Cells[(2 * 5) + 2]));
  const FrontWallWithSidePaths: FirstPersonVisibleState := FirstPersonVisibleState(Title := 'Side paths', Status := '', Width := 5, Height := 5, Rows := [
                                                                                                                                                           '#####',
                                                                                                                                                           '#.#.#',
                                                                                                                                                           '#...#',
                                                                                                                                                           '#...#',
                                                                                                                                                           '#####'
                                                                                                                                                         ], KnowledgeRows := [
                                                                                                                                                                               'vvvvv',
                                                                                                                                                                               'vvvvv',
                                                                                                                                                                               'vvvvv',
                                                                                                                                                                               'vvvvv',
                                                                                                                                                                               'vvvvv'
                                                                                                                                                                             ], PlayerX := 2, PlayerY := 2, Facing := FirstPersonFacing.North, Inventory := [], Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []);
  const SidePathGrid: TuiCellGrid := RenderFirstPersonGrid(FrontWallWithSidePaths, 21, 11);
  const FrontWallRed: integer := BackgroundRed(SidePathGrid.Cells[(5 * 21) + 10]);
  AssertEquals(12, BackgroundRed(SidePathGrid.Cells[10]));
  AssertTrue(FrontWallRed > 100);
  AssertEquals(38, BackgroundRed(SidePathGrid.Cells[(10 * 21) + 10]));
  AssertEquals(12, BackgroundRed(SidePathGrid.Cells[1 * 21]));
  AssertTrue(IsWallCell(SidePathGrid.Cells[5 * 21]));
  AssertEquals(38, BackgroundRed(SidePathGrid.Cells[9 * 21]));
  var LeftBlocked: FirstPersonVisibleState := FrontWallWithSidePaths;
  LeftBlocked.Rows[2] := '##..#';
  const OneSidePathGrid: TuiCellGrid := RenderFirstPersonGrid(LeftBlocked, 21, 11);
  AssertTrue(IsWallCell(OneSidePathGrid.Cells[1 * 21]));
  AssertEquals(12, BackgroundRed(OneSidePathGrid.Cells[(1 * 21) + 20]));
  AssertTrue(IsWallCell(OneSidePathGrid.Cells[(5 * 21) + 20]));
  var UnknownSide: FirstPersonVisibleState := LeftBlocked;
  UnknownSide.Rows[2] := '#?..#';
  UnknownSide.KnowledgeRows[2] := 'vuvvv';
  const UnknownSideGrid: TuiCellGrid := RenderFirstPersonGrid(UnknownSide, 21, 11);
  AssertEquals(18, BackgroundRed(UnknownSideGrid.Cells[5 * 21]));
  AssertEquals(25, BackgroundBlue(UnknownSideGrid.Cells[5 * 21]));
  var ScreenshotState: FirstPersonVisibleState := FixedState(FirstPersonFacing.West);
  ScreenshotState.PlayerX := 1;
  ScreenshotState.PlayerY := 1;
  const ScreenshotGrid: TuiCellGrid := RenderFirstPersonGrid(ScreenshotState, 21, 11);
  // The western boundary continues south: its front plane keeps one wall height across the view.
  for Y: integer := 0 to 10 do
    begin
      AssertEquals(IsWallCell(ScreenshotGrid.Cells[(Y * 21) + 10]), IsWallCell(ScreenshotGrid.Cells[Y *
                                                                                                    21]));
    end;
  end for;

  AssertTrue(IsWallCell(ScreenshotGrid.Cells[3 * 21]));
  AssertTrue(IsWallCell(ScreenshotGrid.Cells[5 * 21]));
  AssertTrue(IsWallCell(ScreenshotGrid.Cells[7 * 21]));
  AssertTrue(IsWallCell(ScreenshotGrid.Cells[(1 * 21) + 20]));
  AssertEquals(12, BackgroundRed(ScreenshotGrid.Cells[10]));
  AssertEquals(38, BackgroundRed(ScreenshotGrid.Cells[(10 * 21) + 10]));
  var BothSidePathsState: FirstPersonVisibleState := FixedState(FirstPersonFacing.East);
  BothSidePathsState.PlayerX := 7;
  BothSidePathsState.PlayerY := 5;
  const BothSidePathsGrid: TuiCellGrid := RenderFirstPersonGrid(BothSidePathsState, 21, 11);
  // Both branches run alongside the same eastern wall plane at one wall height.
  for Y: integer := 0 to 10 do
    begin
      AssertEquals(IsWallCell(BothSidePathsGrid.Cells[(Y * 21) + 10]), IsWallCell(BothSidePathsGrid.Cells[Y *
                                                                                                          21]));
      AssertEquals(IsWallCell(BothSidePathsGrid.Cells[(Y * 21) + 10]), IsWallCell(BothSidePathsGrid.Cells[(Y * 21) +
                                                                                                          20]));
    end;
  end for;

  AssertTrue(IsWallCell(BothSidePathsGrid.Cells[4 * 21]));
  AssertTrue(IsWallCell(BothSidePathsGrid.Cells[5 * 21]));
  AssertTrue(IsWallCell(BothSidePathsGrid.Cells[(5 * 21) + 20]));
  AssertTrue(IsWallCell(BothSidePathsGrid.Cells[7 * 21]));
  AssertTrue(IsWallCell(BothSidePathsGrid.Cells[(7 * 21) + 20]));
  var ExitState: FirstPersonVisibleState := FixedState(FirstPersonFacing.South);
  ExitState.PlayerX := 1;
  ExitState.PlayerY := 7;
  const ExitGrid: TuiCellGrid := RenderFirstPersonGrid(ExitState, 21, 11);
  AssertTrue(IsWallCell(ExitGrid.Cells[(5 * 21) + 10]));
  AssertEquals(92, BackgroundRed(ExitGrid.Cells[(10 * 21) + 10]));
  // A near stone wall shows masonry: stones and mortar joints, not one flat color.
  const MasonryGrid: TuiCellGrid := RenderFirstPersonGrid(FixedState(FirstPersonFacing.East), 41, 21);
  var WallReds: array of integer := [];
  for Cell: TuiCell in MasonryGrid.Cells do
    begin
      if IsWallCell(Cell) and not WallReds.Contains(BackgroundRed(Cell)) then
        begin
          WallReds.Push(BackgroundRed(Cell));
        end;
      end if;
    end;
  end for;

  AssertTrue(WallReds.Length() >= 3);
  // Torchlight: the floor keeps its full color near the eye and darkens toward the horizon.
  const CorridorGrid: TuiCellGrid := RenderFirstPersonGrid(FixedState(FirstPersonFacing.West), 41, 21);
  AssertEquals(38, BackgroundRed(CorridorGrid.Cells[(20 * 41) + 20]));
  AssertTrue(BackgroundRed(CorridorGrid.Cells[(11 * 41) + 20]) < 38);
  const NearGrid: TuiCellGrid := RenderFirstPersonGrid(FixedState(FirstPersonFacing.East), 9, 20);
  const FarGrid: TuiCellGrid := RenderFirstPersonGrid(FixedState(FirstPersonFacing.West), 9, 20);
  AssertEquals(9, NearGrid.Width);
  AssertEquals(20, NearGrid.Height);
  AssertEquals(180, NearGrid.Cells.Length());
  AssertEquals(180, FarGrid.Cells.Length());
  AssertTrue(BackgroundRed(NearGrid.Cells[(10 * 9) + 4]) >
             BackgroundRed(FarGrid.Cells[(10 * 9) + 4]));
  AssertEquals(12, BackgroundRed(FarGrid.Cells[4]));
  AssertEquals(38, BackgroundRed(FarGrid.Cells[(19 * 9) + 4]));
  // Every cell is either one uniform pixel pair or an upper-half block over a lower pixel.
  for Cell: TuiCell in FarGrid.Cells do
    begin
      AssertTrue(Cell.ConcreteStyle.IsSome());
      AssertTrue((Cell.Glyph = ' ') or (Cell.Glyph = '▀'));
    end;
  end for;
  const Empty: TuiCellGrid := RenderFirstPersonGrid(FixedState(FirstPersonFacing.West), 0, 0);
  AssertEquals(0, Empty.Width);
  AssertEquals(0, Empty.Height);
  AssertEquals(0, Empty.Cells.Length());
  const Negative: TuiCellGrid := RenderFirstPersonGrid(FixedState(FirstPersonFacing.West), -2, -3);
  AssertEquals(0, Negative.Width);
  AssertEquals(0, Negative.Height);
  AssertEquals(0, Negative.Cells.Length());
  const Tiny: TuiCellGrid := RenderFirstPersonGrid(FixedState(FirstPersonFacing.West), 1, 1);
  AssertEquals(1, Tiny.Width);
  AssertEquals(1, Tiny.Height);
  AssertEquals(1, Tiny.Cells.Length());
  AssertTrue(Tiny.Cells[0].ConcreteStyle.IsSome());
end.
