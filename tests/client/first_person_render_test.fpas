// Verifies deterministic first-person ray intersections and complete terminal-cell rendering.
program DungeonFirstPersonRenderTest;

uses Dungeon.Client.Raycast as Raycast, Dungeon.Client.Raycast.Rays as Rays, Dungeon.Protocol as Protocol, Std.Test as Test, Std.Tui as Tui;

function FixedState(Facing: Protocol.FirstPersonFacing): Protocol.FirstPersonVisibleState;
begin
  return Protocol.FirstPersonVisibleState(
    Title := 'Initial dungeon', Status := 'Find the gold exit field.', Width := 11, Height := 9,
    Rows := [
      '###########',
      '#.........#',
      '#.#####.#.#',
      '#.....#.#.#',
      '###.#.#.#.#',
      '#...#...#.#',
      '#.#####.#.#',
      '#x........#',
      '###########'
    ], KnowledgeRows := [
      'vvvvvvvvvvv',
      'vvvvvvvvvvv',
      'vvvvvvvvvvv',
      'vvvvvvvvvvv',
      'vvvvvvvvvvv',
      'vvvvvvvvvvv',
      'vvvvvvvvvvv',
      'vvvvvvvvvvv',
      'vvvvvvvvvvv'
    ], PlayerX := 9, PlayerY := 1, Facing := Facing, Inventory := [], Health := 20, MaxHealth := 20,
    Character := [], CombatLog := [], CombatEvents := []
  );
end function;

// Checks each branch independently with open and blocked forward movement.
procedure VerifyJunction(Facing: Protocol.FirstPersonFacing; DX: integer; DY: integer);
begin
  for FrontBlocked: boolean in [false, true] do
    begin
      for Width: integer in [21, 41, 101] do
        begin
          const Height: integer := 21;
          var Value: Protocol.FirstPersonVisibleState := FixedState(Facing);
          Value.Width := 7;
          Value.Height := 7;
          Value.PlayerX := 3;
          Value.PlayerY := 3;
          Value.Rows := [
            '#######',
            '#######',
            '#######',
            '###.###',
            '#######',
            '#######',
            '#######'
          ];
          Value.KnowledgeRows := [
            'vvvvvvv',
            'vvvvvvv',
            'vvvvvvv',
            'vvvvvvv',
            'vvvvvvv',
            'vvvvvvv',
            'vvvvvvv'
          ];
          if not FrontBlocked then
            begin
              for Depth: integer := 1 to 2 do
                begin
                  const Y: integer := 3 + DY * Depth;
                  Value.Rows[Y] := Value.Rows[Y].SetCharAt(3 + DX * Depth, '.');
                end;
              end for;
            end;
          end if;
          const Closed: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(Value, Width, Height);
          // In screen coordinates, left is (DY, -DX).
          Value.Rows[3 - DX] := Value.Rows[3 - DX].SetCharAt(3 + DY, '.');
          const LeftOpen: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(Value, Width, Height);
          Value.Rows[3 + DX] := Value.Rows[3 + DX].SetCharAt(3 - DY, '.');
          const BothOpen: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(Value, Width, Height);
          const L: integer := 10 * Width;
          const R: integer := (L + Width) - 1;
          Test.AssertTrue(
            Closed.Cells[L].ConcreteStyle.Unwrap().Background.Red <>
            LeftOpen.Cells[L].ConcreteStyle.Unwrap().Background.Red
          );
          Test.AssertEquals(
            Closed.Cells[R].ConcreteStyle.Unwrap().Background.Red,
            LeftOpen.Cells[R].ConcreteStyle.Unwrap().Background.Red
          );
          Test.AssertTrue(
            LeftOpen.Cells[R].ConcreteStyle.Unwrap().Background.Red <>
            BothOpen.Cells[R].ConcreteStyle.Unwrap().Background.Red
          );
          Test.AssertEquals(
            LeftOpen.Cells[L].ConcreteStyle.Unwrap().Background.Red,
            BothOpen.Cells[L].ConcreteStyle.Unwrap().Background.Red
          );
          // A near closed side reaches the top edge; an opening exposes ceiling.
          Test.AssertTrue(Closed.Cells[0].ConcreteStyle.Unwrap().Background.Red > 100);
          Test.AssertEquals(12, BothOpen.Cells[0].ConcreteStyle.Unwrap().Background.Red);
          Test.AssertEquals(12, BothOpen.Cells[Width - 1].ConcreteStyle.Unwrap().Background.Red);
        end;
      end for;
    end;
  end for;
end procedure;

// Counts cells whose glyph or either color differs between two equally sized grids.
function DifferentCells(Left: Tui.TuiCellGrid; Right: Tui.TuiCellGrid): integer;
begin
  var Count: integer := 0;
  for I: integer := 0 to Left.Cells.Length() - 1 do
    begin
      const A: Tui.TuiStyle := Left.Cells[I].ConcreteStyle.Unwrap();
      const B: Tui.TuiStyle := Right.Cells[I].ConcreteStyle.Unwrap();
      if (
        ((Left.Cells[I].Glyph <> Right.Cells[I].Glyph) or (A.Background.Red <> B.Background.Red))
        or
        ((A.Background.Green <> B.Background.Green) or (A.Background.Blue <> B.Background.Blue))
      )
        or
        (
          ((A.Foreground.Red <> B.Foreground.Red) or (A.Foreground.Green <> B.Foreground.Green))
          or
          (A.Foreground.Blue <> B.Foreground.Blue)
        )
      then
        begin
          Count := Count + 1;
        end;
      end if;
    end;
  end for;

  return Count;
end function;

function BackgroundRed(Cell: Tui.TuiCell): integer;
begin
  return Cell.ConcreteStyle.Unwrap().Background.Red;
end function;

function BackgroundBlue(Cell: Tui.TuiCell): integer;
begin
  return Cell.ConcreteStyle.Unwrap().Background.Blue;
end function;

// Every exit pixel is warmer than the plain floor at the same depth: more red, less blue.
procedure AssertGoldOverFloor(A: Tui.TuiColor; B: Tui.TuiColor);
begin
  Test.AssertTrue(A.Red > B.Red);
  Test.AssertTrue(A.Red > A.Green);
  Test.AssertTrue(A.Green > A.Blue);
  Test.AssertTrue(A.Blue <= B.Blue);
end procedure;

// Removing a traversable exit may change floor pixels only, never walls or sky.
// Both stacked pixels of a cell are compared: background is the lower, foreground the upper half.
function VerifyExitMaterial(Value: Protocol.FirstPersonVisibleState; Width: integer; Height: integer): integer;
begin
  var Plain: Protocol.FirstPersonVisibleState := Value;
  Plain.Rows[7] := '#.........#';
  const Actual: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(Value, Width, Height);
  const Expected: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(Plain, Width, Height);
  var GoldCount: integer := 0;
  for I: integer := 0 to Actual.Cells.Length() - 1 do
    begin
      const ActualStyle: Tui.TuiStyle := Actual.Cells[I].ConcreteStyle.Unwrap();
      const ExpectedStyle: Tui.TuiStyle := Expected.Cells[I].ConcreteStyle.Unwrap();
      const A: Tui.TuiColor := ActualStyle.Background;
      const B: Tui.TuiColor := ExpectedStyle.Background;
      if ((A.Red <> B.Red) or (A.Green <> B.Green)) or (A.Blue <> B.Blue) then
        begin
          AssertGoldOverFloor(A, B);
          GoldCount := GoldCount + 1;
        end;
      end if;
      const UpperA: Tui.TuiColor := ActualStyle.Foreground;
      const UpperB: Tui.TuiColor := ExpectedStyle.Foreground;
      if (Actual.Cells[I].Glyph = '▀')
        and
        (
          ((UpperA.Red <> UpperB.Red) or (UpperA.Green <> UpperB.Green))
          or
          (UpperA.Blue <> UpperB.Blue)
        )
      then
        begin
          AssertGoldOverFloor(UpperA, UpperB);
          GoldCount := GoldCount + 1;
        end;
      end if;
    end;
  end for;

  return GoldCount;
end function;

// Classifies a cell's lower pixel as stone wall, including darkened mortar: fog is red 18,
// ceiling at most 12, plain floor at most 38, and the gold exit floor has almost no blue.
function IsWallCell(Cell: Tui.TuiCell): boolean;
begin
  const Color: Tui.TuiColor := Cell.ConcreteStyle.Unwrap().Background;
  return (Color.Red > 60) and ((Color.Blue * 2) > Color.Red);
end function;

begin
  // At a junction, opening either immediate side must change that screen edge,
  // even while the field directly ahead remains traversable.
  var Junction: Protocol.FirstPersonVisibleState := FixedState(Protocol.FirstPersonFacing.North);
  Junction.PlayerX := 5;
  Junction.PlayerY := 5;
  Junction.Rows := [
    '###########',
    '#####.#####',
    '#####.#####',
    '#####.#####',
    '#####.#####',
    '#####.#####',
    '###########',
    '###########',
    '###########'
  ];
  const ClosedJunction: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(Junction, 41, 21);
  Junction.Rows[5] := '####...####';
  const OpenJunction: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(Junction, 41, 21);
  Test.AssertTrue(
    BackgroundRed(ClosedJunction.Cells[10 * 41]) <>
    BackgroundRed(OpenJunction.Cells[10 * 41])
  );
  Test.AssertTrue(
    BackgroundRed(ClosedJunction.Cells[10 * 41 + 40]) <>
    BackgroundRed(OpenJunction.Cells[10 * 41 + 40])
  );
  VerifyJunction(Protocol.FirstPersonFacing.North, 0, -1);
  VerifyJunction(Protocol.FirstPersonFacing.East, 1, 0);
  VerifyJunction(Protocol.FirstPersonFacing.South, 0, 1);
  VerifyJunction(Protocol.FirstPersonFacing.West, -1, 0);
  // Covers near and distant walls, junctions, and each facing with one projection.
  for Facing: Protocol.FirstPersonFacing in [
    Protocol.FirstPersonFacing.North,
    Protocol.FirstPersonFacing.East,
    Protocol.FirstPersonFacing.South,
    Protocol.FirstPersonFacing.West
  ] do
    begin
      var Pose: Protocol.FirstPersonVisibleState := FixedState(Facing);
      for Y: integer := 1 to 7 do
        begin
          for X: integer := 1 to 9 do
            begin
              if Pose.Rows[Y][X] <> '#' then
                begin
                  Pose.PlayerX := X;
                  Pose.PlayerY := Y;
                  const Changed: integer := VerifyExitMaterial(Pose, 21, 11);
                  Test.AssertTrue(Changed >= 0);
                end;
              end if;
            end;
          end for;
        end;
      end for;
    end;
  end for;
  var Approach: Protocol.FirstPersonVisibleState := FixedState(Protocol.FirstPersonFacing.West);
  Approach.PlayerX := 2;
  Approach.PlayerY := 7;
  Test.AssertTrue(VerifyExitMaterial(Approach, 101, 39) > 0);
  Approach.PlayerX := 1;
  Test.AssertTrue(VerifyExitMaterial(Approach, 101, 39) > 0);
  const North: Rays.FirstPersonRayHit := Rays.CastFirstPersonRay(
    FixedState(Protocol.FirstPersonFacing.North),
    0.0
  );
  const East: Rays.FirstPersonRayHit := Rays.CastFirstPersonRay(
    FixedState(Protocol.FirstPersonFacing.East),
    0.0
  );
  const South: Rays.FirstPersonRayHit := Rays.CastFirstPersonRay(
    FixedState(Protocol.FirstPersonFacing.South),
    0.0
  );
  const West: Rays.FirstPersonRayHit := Rays.CastFirstPersonRay(
    FixedState(Protocol.FirstPersonFacing.West),
    0.0
  );
  Test.AssertTrue((North.Distance > 0.84) and (North.Distance < 0.86));
  Test.AssertTrue((East.Distance > 0.84) and (East.Distance < 0.86));
  Test.AssertTrue((South.Distance > 6.84) and (South.Distance < 6.86));
  Test.AssertTrue((West.Distance > 8.84) and (West.Distance < 8.86));
  Test.AssertFalse(North.VerticalSide);
  Test.AssertEquals(Protocol.InteriorWallCode, North.FieldCode);
  Test.AssertTrue(East.VerticalSide);
  Test.AssertFalse(South.VerticalSide);
  Test.AssertTrue(West.VerticalSide);
  var ItemAhead: Protocol.FirstPersonVisibleState := FixedState(Protocol.FirstPersonFacing.West);
  ItemAhead.Rows[1] := ItemAhead.Rows[1].SetCharAt(8, 'i');
  const ItemGrid: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(ItemAhead, 41, 21);
  ItemAhead.Rows[1] := ItemAhead.Rows[1].SetCharAt(8, '.');
  const CollectedGrid: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(ItemAhead, 41, 21);
  // The coin is a small floor object: visible, but far smaller than one screen row.
  const ItemCells: integer := DifferentCells(ItemGrid, CollectedGrid);
  Test.AssertTrue(ItemCells > 0);
  Test.AssertTrue(ItemCells < 41);
  // Once collected, the field renders exactly like the plain corridor.
  Test.AssertEquals(
    0,
    DifferentCells(
      CollectedGrid,
      Raycast.RenderFirstPersonGrid(FixedState(Protocol.FirstPersonFacing.West), 41, 21)
    )
  );
  // The opponent is an upright figure: it changes cells above the horizon, not only the floor.
  const HostileCorridor: Protocol.FirstPersonVisibleState := Protocol.FirstPersonVisibleState(
    Title := 'Opponent figure', Status := '', Width := 7, Height := 3, Rows := [
      '#######',
      '#..h..#',
      '#######'
    ], KnowledgeRows := [
      'vvvvvvv',
      'vvvvvvv',
      'vvvvvvv'
    ], PlayerX := 1, PlayerY := 1, Facing := Protocol.FirstPersonFacing.East, Inventory := [],
    Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []
  );
  var EmptyCorridor: Protocol.FirstPersonVisibleState := HostileCorridor;
  EmptyCorridor.Rows[1] := '#.....#';
  const HostileFigure: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(HostileCorridor, 61, 25);
  const EmptyFigure: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(EmptyCorridor, 61, 25);
  var UpperHostileCells: integer := 0;
  for I: integer := 0 to (12 * 61) - 1 do
    begin
      if DifferentCells(
        Tui.TuiCellGrid.Create(1, 1, [HostileFigure.Cells[I]]), Tui.TuiCellGrid.Create(
          1, 1, [
            EmptyFigure.Cells[I]
          ]
        )
      ) >
        0
      then
        begin
          UpperHostileCells := UpperHostileCells + 1;
        end;
      end if;
    end;
  end for;

  Test.AssertTrue(UpperHostileCells > 0);
  // Walls hide figures standing behind them.
  var HiddenHostile: Protocol.FirstPersonVisibleState := HostileCorridor;
  HiddenHostile.Rows[1] := '#.#h..#';
  var HiddenEmpty: Protocol.FirstPersonVisibleState := HostileCorridor;
  HiddenEmpty.Rows[1] := '#.#...#';
  Test.AssertEquals(
    0,
    DifferentCells(
      Raycast.RenderFirstPersonGrid(HiddenHostile, 61, 25),
      Raycast.RenderFirstPersonGrid(HiddenEmpty, 61, 25)
    )
  );
  const Occluded: Protocol.FirstPersonVisibleState := Protocol.FirstPersonVisibleState(
    Title := 'Occlusion', Status := '', Width := 7, Height := 5, Rows := [
      '#######',
      '#.....#',
      '#.#x#.#',
      '#.....#',
      '#######'
    ], KnowledgeRows := [
      'vvvvvvv',
      'vvvvvvv',
      'vvvvvvv',
      'vvvvvvv',
      'vvvvvvv'
    ], PlayerX := 1, PlayerY := 2, Facing := Protocol.FirstPersonFacing.East, Inventory := [],
    Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []
  );
  const OccludedHit: Rays.FirstPersonRayHit := Rays.CastFirstPersonRay(Occluded, 0.0);
  Test.AssertTrue((OccludedHit.Distance > 0.84) and (OccludedHit.Distance < 0.86));
  Test.AssertFalse(OccludedHit.SawExit);
  const VisibleExit: Protocol.FirstPersonVisibleState := Protocol.FirstPersonVisibleState(
    Title := 'Visible exit', Status := '', Width := 7, Height := 5, Rows := [
      '#######',
      '#.....#',
      '#.x...#',
      '#.....#',
      '#######'
    ], KnowledgeRows := [
      'vvvvvvv',
      'vvvvvvv',
      'vvvvvvv',
      'vvvvvvv',
      'vvvvvvv'
    ], PlayerX := 1, PlayerY := 2, Facing := Protocol.FirstPersonFacing.East, Inventory := [],
    Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []
  );
  const ExitHit: Rays.FirstPersonRayHit := Rays.CastFirstPersonRay(VisibleExit, 0.0);
  Test.AssertTrue((ExitHit.Distance > 4.84) and (ExitHit.Distance < 4.86));
  Test.AssertTrue(ExitHit.SawExit);
  const Fogged: Protocol.FirstPersonVisibleState := Protocol.FirstPersonVisibleState(
    Title := 'Fogged', Status := 'Unknown ahead.', Width := 5, Height := 3, Rows := [
      '?????',
      '?.???',
      '?????'
    ], KnowledgeRows := [
      'uuuuu',
      'uvuuu',
      'uuuuu'
    ], PlayerX := 1, PlayerY := 1, Facing := Protocol.FirstPersonFacing.East, Inventory := [],
    Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []
  );
  const FogHit: Rays.FirstPersonRayHit := Rays.CastFirstPersonRay(Fogged, 0.0);
  Test.AssertEquals('?', FogHit.FieldCode);
  Test.AssertFalse(FogHit.SawExit);
  const FogGrid: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(Fogged, 5, 5);
  Test.AssertEquals(18, BackgroundRed(FogGrid.Cells[(2 * 5) + 2]));
  const FrontWallWithSidePaths: Protocol.FirstPersonVisibleState := Protocol.FirstPersonVisibleState(
    Title := 'Side paths', Status := '', Width := 5, Height := 5, Rows := [
      '#####',
      '#.#.#',
      '#...#',
      '#...#',
      '#####'
    ], KnowledgeRows := [
      'vvvvv',
      'vvvvv',
      'vvvvv',
      'vvvvv',
      'vvvvv'
    ], PlayerX := 2, PlayerY := 2, Facing := Protocol.FirstPersonFacing.North, Inventory := [],
    Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []
  );
  const SidePathGrid: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(
    FrontWallWithSidePaths,
    21,
    11
  );
  const FrontWallRed: integer := BackgroundRed(SidePathGrid.Cells[(5 * 21) + 10]);
  Test.AssertEquals(12, BackgroundRed(SidePathGrid.Cells[10]));
  Test.AssertTrue(FrontWallRed > 100);
  Test.AssertEquals(38, BackgroundRed(SidePathGrid.Cells[(10 * 21) + 10]));
  Test.AssertEquals(12, BackgroundRed(SidePathGrid.Cells[1 * 21]));
  Test.AssertTrue(IsWallCell(SidePathGrid.Cells[5 * 21]));
  Test.AssertEquals(38, BackgroundRed(SidePathGrid.Cells[9 * 21]));
  var LeftBlocked: Protocol.FirstPersonVisibleState := FrontWallWithSidePaths;
  LeftBlocked.Rows[2] := '##..#';
  const OneSidePathGrid: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(LeftBlocked, 21, 11);
  Test.AssertTrue(IsWallCell(OneSidePathGrid.Cells[1 * 21]));
  Test.AssertEquals(12, BackgroundRed(OneSidePathGrid.Cells[(1 * 21) + 20]));
  Test.AssertTrue(IsWallCell(OneSidePathGrid.Cells[(5 * 21) + 20]));
  var UnknownSide: Protocol.FirstPersonVisibleState := LeftBlocked;
  UnknownSide.Rows[2] := '#?..#';
  UnknownSide.KnowledgeRows[2] := 'vuvvv';
  const UnknownSideGrid: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(UnknownSide, 21, 11);
  Test.AssertEquals(18, BackgroundRed(UnknownSideGrid.Cells[5 * 21]));
  Test.AssertEquals(25, BackgroundBlue(UnknownSideGrid.Cells[5 * 21]));
  var ScreenshotState: Protocol.FirstPersonVisibleState := FixedState(
    Protocol.FirstPersonFacing.West
  );
  ScreenshotState.PlayerX := 1;
  ScreenshotState.PlayerY := 1;
  const ScreenshotGrid: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(ScreenshotState, 21, 11);
  // The western boundary continues south: its front plane keeps one wall height across the view.
  for Y: integer := 0 to 10 do
    begin
      Test.AssertEquals(
        IsWallCell(ScreenshotGrid.Cells[(Y * 21) + 10]), IsWallCell(
          ScreenshotGrid.Cells[
            Y *
            21
          ]
        )
      );
    end;
  end for;

  Test.AssertTrue(IsWallCell(ScreenshotGrid.Cells[3 * 21]));
  Test.AssertTrue(IsWallCell(ScreenshotGrid.Cells[5 * 21]));
  Test.AssertTrue(IsWallCell(ScreenshotGrid.Cells[7 * 21]));
  Test.AssertTrue(IsWallCell(ScreenshotGrid.Cells[(1 * 21) + 20]));
  Test.AssertEquals(12, BackgroundRed(ScreenshotGrid.Cells[10]));
  Test.AssertEquals(38, BackgroundRed(ScreenshotGrid.Cells[(10 * 21) + 10]));
  var BothSidePathsState: Protocol.FirstPersonVisibleState := FixedState(
    Protocol.FirstPersonFacing.East
  );
  BothSidePathsState.PlayerX := 7;
  BothSidePathsState.PlayerY := 5;
  const BothSidePathsGrid: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(
    BothSidePathsState,
    21,
    11
  );
  // Both branches run alongside the same eastern wall plane at one wall height.
  for Y: integer := 0 to 10 do
    begin
      Test.AssertEquals(
        IsWallCell(BothSidePathsGrid.Cells[(Y * 21) + 10]), IsWallCell(
          BothSidePathsGrid.Cells[
            Y *
            21
          ]
        )
      );
      Test.AssertEquals(
        IsWallCell(BothSidePathsGrid.Cells[(Y * 21) + 10]), IsWallCell(
          BothSidePathsGrid.Cells[
            (Y * 21) +
            20
          ]
        )
      );
    end;
  end for;

  Test.AssertTrue(IsWallCell(BothSidePathsGrid.Cells[4 * 21]));
  Test.AssertTrue(IsWallCell(BothSidePathsGrid.Cells[5 * 21]));
  Test.AssertTrue(IsWallCell(BothSidePathsGrid.Cells[(5 * 21) + 20]));
  Test.AssertTrue(IsWallCell(BothSidePathsGrid.Cells[7 * 21]));
  Test.AssertTrue(IsWallCell(BothSidePathsGrid.Cells[(7 * 21) + 20]));
  var ExitState: Protocol.FirstPersonVisibleState := FixedState(Protocol.FirstPersonFacing.South);
  ExitState.PlayerX := 1;
  ExitState.PlayerY := 7;
  const ExitGrid: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(ExitState, 21, 11);
  Test.AssertTrue(IsWallCell(ExitGrid.Cells[(5 * 21) + 10]));
  Test.AssertEquals(92, BackgroundRed(ExitGrid.Cells[(10 * 21) + 10]));
  // A near stone wall shows masonry: stones and mortar joints, not one flat color.
  const MasonryGrid: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(
    FixedState(Protocol.FirstPersonFacing.East),
    41,
    21
  );
  var WallReds: array of integer := [];
  for Cell: Tui.TuiCell in MasonryGrid.Cells do
    begin
      if IsWallCell(Cell) and not BackgroundRed(Cell) in WallReds then
        begin
          WallReds.PushInPlace(BackgroundRed(Cell));
        end;
      end if;
    end;
  end for;

  Test.AssertTrue(WallReds.Length() >= 3);
  // Torchlight: the floor keeps its full color near the eye and darkens toward the horizon.
  const CorridorGrid: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(
    FixedState(Protocol.FirstPersonFacing.West),
    41,
    21
  );
  Test.AssertEquals(38, BackgroundRed(CorridorGrid.Cells[(20 * 41) + 20]));
  Test.AssertTrue(BackgroundRed(CorridorGrid.Cells[(11 * 41) + 20]) < 38);
  const NearGrid: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(
    FixedState(Protocol.FirstPersonFacing.East),
    9,
    20
  );
  const FarGrid: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(
    FixedState(Protocol.FirstPersonFacing.West),
    9,
    20
  );
  Test.AssertEquals(9, NearGrid.Width);
  Test.AssertEquals(20, NearGrid.Height);
  Test.AssertEquals(180, NearGrid.Cells.Length());
  Test.AssertEquals(180, FarGrid.Cells.Length());
  Test.AssertTrue(
    BackgroundRed(NearGrid.Cells[(10 * 9) + 4]) >
    BackgroundRed(FarGrid.Cells[(10 * 9) + 4])
  );
  Test.AssertEquals(12, BackgroundRed(FarGrid.Cells[4]));
  Test.AssertEquals(38, BackgroundRed(FarGrid.Cells[(19 * 9) + 4]));
  // Every cell is either one uniform pixel pair or an upper-half block over a lower pixel.
  for Cell: Tui.TuiCell in FarGrid.Cells do
    begin
      Test.AssertTrue(Cell.ConcreteStyle is Some(_));
      Test.AssertTrue((Cell.Glyph = ' ') or (Cell.Glyph = '▀'));
    end;
  end for;
  const Empty: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(
    FixedState(Protocol.FirstPersonFacing.West),
    0,
    0
  );
  Test.AssertEquals(0, Empty.Width);
  Test.AssertEquals(0, Empty.Height);
  Test.AssertEquals(0, Empty.Cells.Length());
  const Negative: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(
    FixedState(Protocol.FirstPersonFacing.West),
    -2,
    -3
  );
  Test.AssertEquals(0, Negative.Width);
  Test.AssertEquals(0, Negative.Height);
  Test.AssertEquals(0, Negative.Cells.Length());
  const Tiny: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(
    FixedState(Protocol.FirstPersonFacing.West),
    1,
    1
  );
  Test.AssertEquals(1, Tiny.Width);
  Test.AssertEquals(1, Tiny.Height);
  Test.AssertEquals(1, Tiny.Cells.Length());
  Test.AssertTrue(Tiny.Cells[0].ConcreteStyle is Some(_));
end.
