// Verifies the inventory overlay, the character sheet, equipment summaries, and combat animation playback.
program DungeonEquipmentUiTest;

uses Dungeon.Test.Catalog as CatalogUnit, Dungeon.Client as ClientUnit, Dungeon.Client.Animation as AnimationUnit, Dungeon.Protocol as Protocol, Dungeon.RuntimeData as RuntimeData, Std.Tasks as Tasks, Std.Test as Test, Std.Tui as Tui;

function ScreenContains(Snapshot: Tui.TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Row: integer := 0 to Snapshot.Height - 1 do
    begin
      if Text in Snapshot.LineAt(Row) then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(
    kind := Kind,
    ch := Character,
    shift := false,
    ctrl := false,
    alt := false,
    meta := false
  );
end function;

function Item(Id: string; Name: string; Slot: Protocol.VisibleItemSlot; Equipped: boolean): Protocol.VisibleInventoryItem;
begin
  return Protocol.VisibleInventoryItem(
    Id := Id,
    Name := Name,
    Slot := Slot,
    Equipped := Equipped,
    Usable := false
  );
end function;

function Happened(Kind: Protocol.VisibleCombatEventKind; Amount: integer): Protocol.VisibleCombatEvent;
begin
  return Protocol.VisibleCombatEvent(
    Kind := Kind,
    Amount := Amount,
    HostileCode := Protocol.InteriorHostileCode
  );
end function;

function Hall(
  Inventory: array of Protocol.VisibleInventoryItem;
  Health: integer;
  Events: array of Protocol.VisibleCombatEvent
): Protocol.VisibleState;
begin
  return Protocol.VisibleState.FirstPersonState(
    Protocol.FirstPersonVisibleState(
      Time := Protocol.VisibleTime(Day := 1, MinuteOfDay := 480, Phase := Protocol.DayPhase.Day),
      Coins := 0,
      Title := 'Initial dungeon', Status := 'Restless skeleton 9/12 — Space: Attack', Level := 0,
      Depth := 1, Width := 5,
      Height := 3, Rows := [
        '#####',
        '#.h.#',
        '#####'
      ], KnowledgeRows := [
        'vvvvv',
        'vvvvv',
        'vvvvv'
      ], PlayerX := 3, PlayerY := 1, Facing := Protocol.FirstPersonFacing.West,
      Inventory := Inventory, Health := Health, MaxHealth := 20, Character := [
        Protocol.VisibleCharacterValue(
          Label := 'Damage',
          Value := 'd6+1',
          Source := 'Rusty short sword'
        ),
        Protocol.VisibleCharacterValue(Label := 'Armor', Value := '0', Source := 'None')
      ], CombatLog := [], CombatEvents := Events, Journal := []
    )
  );
end function;

function Press(App: Tui.TuiApplication; Model: ClientUnit.ClientModel; Kind: Tui.TuiKeyKind; Character: string): ClientUnit.ClientModel;
begin
  App.InjectKeyForTest(MakeKey(Kind, Character));
  return App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
end function;

const Coin: Protocol.VisibleInventoryItem := Item(
  'coin',
  'Ancient coin',
  Protocol.VisibleItemSlot.NoSlot,
  false
);
const Sword: Protocol.VisibleInventoryItem := Item(
  'sword',
  'Rusty short sword',
  Protocol.VisibleItemSlot.Weapon,
  false
);
const WornSword: Protocol.VisibleInventoryItem := Item(
  'sword',
  'Rusty short sword',
  Protocol.VisibleItemSlot.Weapon,
  true
);

begin
  // Playback rules: durations follow the turn's events, and frames change over time.
  Test.AssertFalse(AnimationUnit.StartAnimation([], false).Active);
  const Swing: AnimationUnit.CombatAnimation := AnimationUnit.StartAnimation(
    [Happened(Protocol.VisibleCombatEventKind.PlayerHit, 5)],
    true
  );
  Test.AssertTrue(Swing.Active);
  Test.AssertEquals(2 * AnimationUnit.AnimationPhaseMilliseconds, Swing.Duration);
  Test.AssertTrue(AnimationUnit.AnimationFrameAt(Swing).Effect.Swing >= 0.0);
  Test.AssertTrue(AnimationUnit.AnimationFrameAt(Swing).Effect.Armed);
  const Impact: AnimationUnit.CombatAnimation := AnimationUnit.AdvanceAnimation(
    Swing,
    AnimationUnit.AnimationPhaseMilliseconds
  );
  Test.AssertTrue(AnimationUnit.AnimationFrameAt(Impact).Effect.Flash);
  Test.AssertEquals('-5', AnimationUnit.AnimationFrameAt(Impact).HostileText);
  Test.AssertTrue(AnimationUnit.AnimationFrameAt(Impact).Effect.Swing < 0.0);
  Test.AssertFalse(
    AnimationUnit.AdvanceAnimation(Impact, AnimationUnit.AnimationPhaseMilliseconds).Active
  );
  Test.AssertEquals(
    '',
    AnimationUnit.AnimationFrameAt(
      AnimationUnit.AdvanceAnimation(Impact, AnimationUnit.AnimationPhaseMilliseconds)
    ).HostileText
  );
  const Dodge: AnimationUnit.CombatAnimation := AnimationUnit.AdvanceAnimation(
    AnimationUnit.StartAnimation(
      [
        Happened(Protocol.VisibleCombatEventKind.PlayerMiss, 0)
      ], false
    ), AnimationUnit.AnimationPhaseMilliseconds +
    (AnimationUnit.AnimationPhaseMilliseconds div 2)
  );
  Test.AssertTrue(AnimationUnit.AnimationFrameAt(Dodge).Effect.Shift > 0.2);
  Test.AssertEquals('miss', AnimationUnit.AnimationFrameAt(Dodge).HostileText);
  // The opponent's blow comes after the player's; the red frame waits for it.
  const Exchange: AnimationUnit.CombatAnimation := AnimationUnit.StartAnimation(
    [
      Happened(Protocol.VisibleCombatEventKind.PlayerMiss, 0),
      Happened(Protocol.VisibleCombatEventKind.HostileHit, 3)
    ], false
  );
  Test.AssertEquals(3 * AnimationUnit.AnimationPhaseMilliseconds, Exchange.Duration);
  Test.AssertFalse(AnimationUnit.AnimationFrameAt(Exchange).ShowDamageFrame);
  const Lunge: AnimationUnit.CombatAnimation := AnimationUnit.AdvanceAnimation(
    Exchange, (2 * AnimationUnit.AnimationPhaseMilliseconds) +
    (AnimationUnit.AnimationPhaseMilliseconds div 2)
  );
  Test.AssertTrue(AnimationUnit.AnimationFrameAt(Lunge).Effect.Scale > 1.2);
  Test.AssertTrue(AnimationUnit.AnimationFrameAt(Lunge).ShowDamageFrame);
  Test.AssertEquals('-3', AnimationUnit.AnimationFrameAt(Lunge).PlayerText);
  // A destroyed opponent sinks where it stood.
  const Collapse: AnimationUnit.CombatAnimation := AnimationUnit.AdvanceAnimation(
    AnimationUnit.StartAnimation(
      [
        Happened(Protocol.VisibleCombatEventKind.PlayerHit, 4),
        Happened(Protocol.VisibleCombatEventKind.HostileDefeated, 0)
      ], true
    ), 2 *
    AnimationUnit.AnimationPhaseMilliseconds
  );
  Test.AssertTrue(AnimationUnit.AnimationFrameAt(Collapse).Effect.FallenAhead);
  Test.AssertTrue(AnimationUnit.AnimationFrameAt(Collapse).Effect.Sink > 0.4);
  // The client: equipment summaries in the context panel.
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(4);
  const Events: channel of ClientUnit.ConnectionEvent := Tasks.CreateChannel(1);
  var Model: ClientUnit.ClientModel := ClientUnit.NewClientModel(
    '127.0.0.1',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    Requests,
    Events
  );
  Model.ViewportWidth := 120;
  Model.ViewportHeight := 34;
  Model.RequestedWorldWidth := 78;
  Model.RequestedWorldHeight := 29;
  const Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.Connected(CatalogUnit.FixtureCatalog(false, false)),
    Cmd
  );
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Hall([Coin, Sword], 20, [])),
    Cmd
  );
  const App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(120, 34));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Nothing worn'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Rusty short sword'));
  // I opens the inventory; the coin cannot be worn, the sword can.
  Model := Press(App, Model, Tui.TuiKeyKind.Character, 'i');
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.InventoryOverlay);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), '> Ancient coin — no Enter action'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Rusty short sword — Weapon'));
  Model := Press(App, Model, Tui.TuiKeyKind.Enter, '');
  Test.AssertEquals('No item action available.', Model.Status);
  Test.AssertTrue(Tasks.ReceiveWithTimeout(Requests, 0) is Error(_));
  Model := Press(App, Model, Tui.TuiKeyKind.Down, '');
  Test.AssertEquals(1, Model.InventorySelection);
  Model := Press(App, Model, Tui.TuiKeyKind.Character, 's');
  Test.AssertEquals(0, Model.InventorySelection);
  Model := Press(App, Model, Tui.TuiKeyKind.Character, 'w');
  Test.AssertEquals(1, Model.InventorySelection);
  Model := Press(App, Model, Tui.TuiKeyKind.Enter, '');
  Test.AssertTrue(Model.Pending);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.Equip(const ItemId):
      Test.AssertEquals('sword', ItemId);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected Enter to equip the sword');
  end case;

  // The answer keeps the overlay open and shows the sword as worn.
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Hall([Coin, WornSword], 20, [])),
    Cmd
  );
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.InventoryOverlay);
  Test.AssertFalse(Model.Pending);
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Rusty short sword — worn as Weapon'));
  Model := Press(App, Model, Tui.TuiKeyKind.Enter, '');
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.Unequip(const ItemId):
      Test.AssertEquals('sword', ItemId);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected Enter on a worn item to unequip it');
  end case;

  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.Rejected('equip_rejected', 'this item is not worn'),
    Cmd
  );
  Test.AssertEquals('this item is not worn', Model.Status);
  // Escape closes; the context panel lists the worn sword separately from carried items.
  Model := Press(App, Model, Tui.TuiKeyKind.Escape, '');
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.NoOverlay);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Weapon: Rusty short sword'));
  Test.AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Nothing worn'));
  // C opens the character sheet with the server's lines; I switches to the inventory.
  Model := Press(App, Model, Tui.TuiKeyKind.Character, 'c');
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.CharacterSheetOverlay);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Health         20/20'));
  // 13b: each line is a label/value row followed by its source row.
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Damage         d6+1'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), '  · Rusty short sword'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Armor          0'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), '  · None'));
  Model := Press(App, Model, Tui.TuiKeyKind.Character, 'i');
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.InventoryOverlay);
  Model := Press(App, Model, Tui.TuiKeyKind.Character, 'I');
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.NoOverlay);
  Model := Press(App, Model, Tui.TuiKeyKind.Character, 'C');
  Model := Press(App, Model, Tui.TuiKeyKind.Escape, '');
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.NoOverlay);
  // A turn with combat events starts the animation; ticks advance it until it ends.
  Model := ClientUnit.UpdateClientEvent(
    Model, ClientUnit.ClientEvent.State(
      Hall(
        [Coin, WornSword], 17, [
          Happened(Protocol.VisibleCombatEventKind.PlayerHit, 5),
          Happened(Protocol.VisibleCombatEventKind.HostileHit, 3)
        ]
      )
    ), Cmd
  );
  Test.AssertTrue(Model.Animation.Active);
  Test.AssertTrue(Model.Animation.Armed);
  Test.AssertTrue(Model.DamageTaken);
  Test.AssertTrue(Model.AnimationScene.Width > 0);
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  var Ticks: integer := 0;
  var SawDamageNumber: boolean := false;
  while Model.Animation.Active and (Ticks < 40) do
    begin
      Model := ClientUnit.UpdateClient(
        Model,
        Tui.TuiMsg.Tick(AnimationUnit.AnimationFrameMilliseconds),
        Cmd
      );
      Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
      SawDamageNumber := SawDamageNumber or ScreenContains(App.SurfaceSnapshot(), '-5');
      Ticks := Ticks + 1;
    end;
  end while;

  Test.AssertFalse(Model.Animation.Active);
  Test.AssertEquals(
    (3 * AnimationUnit.AnimationPhaseMilliseconds) div AnimationUnit.AnimationFrameMilliseconds,
    Ticks
  );
  Test.AssertTrue(SawDamageNumber);
  // Late ticks change nothing; a key press completes a running animation at once.
  const Settled: ClientUnit.ClientModel := ClientUnit.UpdateClient(
    Model,
    Tui.TuiMsg.Tick(AnimationUnit.AnimationFrameMilliseconds),
    Cmd
  );
  Test.AssertFalse(Settled.Animation.Active);
  Model := ClientUnit.UpdateClientEvent(
    Model, ClientUnit.ClientEvent.State(
      Hall(
        [Coin, WornSword], 17, [
          Happened(Protocol.VisibleCombatEventKind.PlayerMiss, 0)
        ]
      )
    ), Cmd
  );
  Test.AssertTrue(Model.Animation.Active);
  Model := Press(App, Model, Tui.TuiKeyKind.Character, 'z');
  Test.AssertFalse(Model.Animation.Active);
  if Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() is Protocol.ClientMessage.Wait then
    begin
      null;
    end;
  else
    begin
      panic('expected the key that ended the animation to be handled');
    end;
  end if;

  // D drops the selected item; the server decides whether that is allowed. An empty inventory sends nothing.
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Hall([Coin, WornSword], 20, [])),
    Cmd
  );
  Model := Press(App, Model, Tui.TuiKeyKind.Character, 'i');
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'D drop'));
  Test.AssertTrue(
    ScreenContains(App.SurfaceSnapshot(), 'Item actions: one turn')
  );
  Model := Press(App, Model, Tui.TuiKeyKind.Character, 'w');
  Test.AssertEquals(0, Model.InventorySelection);
  Model := Press(App, Model, Tui.TuiKeyKind.Character, 'd');
  Test.AssertTrue(Model.Pending);
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.DropItem(const ItemId):
      Test.AssertEquals('coin', ItemId);
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.Disconnect:
      panic('expected D to drop the selected coin');
    when Protocol.ClientMessage.UseItem(_):
      panic('D must not use a consumable');
  end case;

  // The answer leaves the overlay open with a valid selection, even when the list shrinks to nothing.
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Hall([WornSword], 20, [])),
    Cmd
  );
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.InventoryOverlay);
  Test.AssertEquals(0, Model.InventorySelection);
  Model := ClientUnit.UpdateClientEvent(Model, ClientUnit.ClientEvent.State(Hall([], 20, [])), Cmd);
  Test.AssertEquals(0, Model.InventorySelection);
  Model := Press(App, Model, Tui.TuiKeyKind.Character, 'D');
  Test.AssertFalse(Model.Pending);
  Test.AssertTrue(Tasks.ReceiveWithTimeout(Requests, 0) is Error(_));
  Model := Press(App, Model, Tui.TuiKeyKind.Escape, '');
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.NoOverlay);
  // Projected capability chooses use even at full health; D still drops that same identity.
  const Potion := Item('potion', 'Healing potion', Protocol.VisibleItemSlot.NoSlot, false) with Usable := true; end with;

  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Hall([Coin, Potion, WornSword], 20, [])),
    Cmd
  );
  Model := Press(App, Model, Tui.TuiKeyKind.Character, 'i');
  Model := Press(App, Model, Tui.TuiKeyKind.Down, '');
  Test.AssertEquals(1, Model.InventorySelection);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Enter: Use'));
  Model := Press(App, Model, Tui.TuiKeyKind.Enter, '');
  Test.AssertTrue(
    Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() is Protocol.ClientMessage.UseItem('potion')
  );
  Test.AssertEquals(20, Model.Health);
  Test.AssertEquals(3, Model.Inventory.Length());
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.Rejected('item_use_rejected', 'you are already at full health'),
    Cmd
  );
  Test.AssertEquals(1, Model.InventorySelection);
  Test.AssertEquals('potion', Model.Inventory[1].Id);
  Test.AssertEquals('you are already at full health', Model.Status);
  Model := Press(App, Model, Tui.TuiKeyKind.Character, 'D');
  Test.AssertTrue(
    Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() is Protocol.ClientMessage.DropItem('potion')
  );
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Hall([Coin, WornSword], 20, [])),
    Cmd
  );
  Test.AssertEquals(1, Model.InventorySelection);
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Enter: Remove'));
  Model := Press(App, Model, Tui.TuiKeyKind.Escape, '');
  // Defeat stops any running animation.
  Model := ClientUnit.UpdateClientEvent(
    Model, ClientUnit.ClientEvent.State(
      Hall(
        [Coin, WornSword], 17, [
          Happened(Protocol.VisibleCombatEventKind.PlayerMiss, 0)
        ]
      )
    ), Cmd
  );
  Test.AssertTrue(Model.Animation.Active);
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.Defeated('You have fallen.'),
    Cmd
  );
  Test.AssertFalse(Model.Animation.Active);
end.
