// Verifies combat presentation: health panel, attack and wait keys, turn log, damage frame, and defeat.
program DungeonCombatUiTest;

uses Dungeon.Test.Catalog as CatalogUnit, Dungeon.Client as ClientUnit, Dungeon.Protocol as Protocol, Dungeon.RuntimeData as RuntimeData, Std.Tasks as Tasks, Std.Test as Test, Std.Tui as Tui;

function ScreenContains(Snapshot: Tui.TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Row: integer := 0 to Snapshot.Height - 1 do
    begin
      if Text in Snapshot.LineAt(Row) then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

function MakeKey(Kind: Tui.TuiKeyKind; Character: string): Tui.TuiKeyEvent;
begin
  return Tui.TuiKeyEvent(
    kind := Kind,
    ch := Character,
    shift := false,
    ctrl := false,
    alt := false,
    meta := false
  );
end function;

function Fight(Health: integer; Log: array of string): Protocol.VisibleState;
begin
  return Protocol.VisibleState.FirstPersonState(
    Protocol.FirstPersonVisibleState(
      Title := 'Initial dungeon', Status := 'Restless skeleton 9/12 — Space: Attack', Width := 5,
      Height := 3, Rows := [
        '#####',
        '#.h.#',
        '#####'
      ], KnowledgeRows := [
        'vvvvv',
        'vvvvv',
        'vvvvv'
      ], PlayerX := 3, PlayerY := 1, Facing := Protocol.FirstPersonFacing.West, Inventory := [],
      Health := Health, MaxHealth := 20, Character := [], CombatLog := Log, CombatEvents := []
    )
  );
end function;

begin
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(4);
  const Events: channel of ClientUnit.ClientEvent := Tasks.CreateChannel(1);
  var Model: ClientUnit.ClientModel := ClientUnit.NewClientModel(
    '127.0.0.1',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    Requests,
    Events
  );
  Model.ViewportWidth := 120;
  Model.ViewportHeight := 30;
  Model.RequestedWorldWidth := 78;
  Model.RequestedWorldHeight := 25;
  const Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.Connected(CatalogUnit.FixtureCatalog(false, false)),
    Cmd
  );
  Model := ClientUnit.UpdateClientEvent(Model, ClientUnit.ClientEvent.State(Fight(20, [])), Cmd);
  Test.AssertEquals(20, Model.Health);
  Test.AssertEquals(20, Model.MaxHealth);
  // Entering a game never flashes damage.
  Test.AssertFalse(Model.DamageTaken);
  const App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(120, 30));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Health 20/20 ████████'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Space: Attack'));
  // Space attacks and Z waits, each as one pending turn.
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Space, ' '));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertTrue(Model.Pending);
  if Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() is Protocol.ClientMessage.Attack then
    begin
      null;
    end;
  else
    begin
      panic('expected Space to request an attack');
    end;
  end if;

  // While a turn is pending, further combat input is ignored.
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 'z'));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  Test.AssertTrue(Tasks.ReceiveWithTimeout(Requests, 0) is Error(_));
  // The turn's messages reach the message log, the last one the status line, and damage frames the view red.
  Model := ClientUnit.UpdateClientEvent(
    Model, ClientUnit.ClientEvent.State(
      Fight(
        14, [
          'You hit the restless skeleton for 3.',
          'The restless skeleton strikes you for 6.'
        ]
      )
    ), Cmd
  );
  Test.AssertFalse(Model.Pending);
  Test.AssertTrue(Model.DamageTaken);
  Test.AssertEquals('The restless skeleton strikes you for 6.', Model.Status);
  Test.AssertEquals(
    'The restless skeleton strikes you for 6.', Model.Messages[
      Model.Messages.Length() -
      1
    ]
  );
  Test.AssertEquals(
    'You hit the restless skeleton for 3.',
    Model.Messages[Model.Messages.Length() - 2]
  );
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Health 14/20 ██████░░'));
  var RedFrame: boolean := false;
  const Snapshot: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  for X: integer := 0 to Snapshot.Width - 1 do
    begin
      for Y: integer := 0 to Snapshot.Height - 1 do
        begin
          case Snapshot.CellAt(X, Y).ConcreteStyle of
            when Some(const Style):
              if ((Style.Background.Red = 150) and (Style.Background.Green = 18))
                and
                (Style.Background.Blue = 18)
              then
                begin
                  RedFrame := true;
                end;
              end if;
            when None:
              null;
          end case;
        end;
      end for;
    end;
  end for;

  Test.AssertTrue(RedFrame);
  App.InjectKeyForTest(MakeKey(Tui.TuiKeyKind.Character, 'Z'));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 1, 0);
  if Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() is Protocol.ClientMessage.Wait then
    begin
      null;
    end;
  else
    begin
      panic('expected Z to request waiting');
    end;
  end if;

  // Without further damage the frame disappears again.
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Fight(14, ['You wait.'])),
    Cmd
  );
  Test.AssertFalse(Model.DamageTaken);
  // Defeat returns to the session start screen and explains what happened.
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.Defeated('The restless skeleton strikes you for 4. You have fallen.'),
    Cmd
  );
  Test.AssertTrue(Model.Screen = ClientUnit.ClientScreen.StartScreen);
  Test.AssertTrue(Model.ConnectionPhase = ClientUnit.ClientConnectionPhase.AwaitingSession);
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.DefeatOverlay);
  Test.AssertFalse(Model.HasVisibleState);
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'You have fallen'));
  Test.AssertTrue(
    ScreenContains(App.SurfaceSnapshot(), 'The restless skeleton strikes you for 4.')
  );
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Continue'));
  // Defeat refreshes the server-selected world while retaining the report overlay.
  case Tasks.ReceiveWithTimeout(Requests, 0).Unwrap() of
    when Protocol.ClientMessage.ListWorlds(const Offset, const DiscardProgress):
      Test.AssertFalse(DiscardProgress);
    when Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.Disconnect:
      panic('expected catalog refresh after defeat');
  end case;

  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.Worlds(CatalogUnit.FixtureCatalog(false, false)),
    Cmd
  );
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.DefeatOverlay);
  // Continue leaves the report; the refreshed session choices are ready.
  Test.AssertTrue(Model.FocusedControl > 0);
  Model := ClientUnit.UpdateClient(
    Model,
    Tui.TuiMsg.Action(Tui.TuiControlId.Create(Model.FocusedControl), Tui.TuiAction.Create(120)),
    Cmd
  );
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.NoOverlay);
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Start over'));
end.
