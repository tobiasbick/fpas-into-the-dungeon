// Verifies that a wide client preserves the 2:1 main-row split and fills the world panel.
program DungeonClientWideLayoutTest;

uses
  Dungeon.Client, Dungeon.Protocol, Dungeon.RuntimeData, Std.Arrays, Std.Options, Std.Str, Std.Task,
  Std.Test, Std.Tui;

function UniformRows(Width: integer; Height: integer; Code: string): array of string;
begin
  mutable var Rows: array of string := [];
  for Row: integer := 0 to Height - 1 do
  begin
    Std.Arrays.Push(Rows, Std.Str.RepeatStr(Code, Width))
  end;

  return Rows
end;

begin
  var Requests: channel of ClientMessage := CreateChannel(1);
  var Events: channel of ClientEvent := CreateChannel(1);
  mutable var Model: ClientModel := NewClientModel('127.0.0.1', 4040, '', DefaultClientPreferences(), Requests, Events);
  Model.Screen := ClientScreen.GameScreen;
  Model.FocusedControl := 0;
  Model.ViewportWidth := 240;
  Model.ViewportHeight := 40;
  Model.RequestedWorldWidth := 79;
  Model.RequestedWorldHeight := 35;
  var Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  Model := UpdateClientEvent(Model, ClientEvent.Connected(false, false), Cmd);
  var MapValue: MapVisibleState := record
    OriginX := 0;
    OriginY := 0;
    Width := 79;
    Height := 35;
    Rows := UniformRows(79, 35, 'g');
    KnowledgeRows := UniformRows(79, 35, 'v');
    PlayerX := 39;
    PlayerY := 17;
    WorldX := 39;
    WorldY := 17;
    Inventory := [];
  end;
  var StateValue: VisibleState := VisibleState.MapState(MapValue);
  Model := UpdateClientEvent(Model, ClientEvent.State(StateValue), Cmd);
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(240, 40));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  var Surface: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  var ContextColumn: integer := Std.Str.IndexOf(Surface.LineAt(0), 'Context');
  AssertEquals(163, ContextColumn);
  AssertTrue(Std.Options.IsSome(Surface.CellAt(ContextColumn - 5, 1).ConcreteStyle));
  App.Close();
  CloseChannel(Requests);
  CloseChannel(Events)
end.
