// Verifies that a wide client preserves the 2:1 main-row split and fills the world panel.
program DungeonClientWideLayoutTest;

uses Dungeon.Test.Catalog as Catalog, Dungeon.Client as Client, Dungeon.Protocol as Protocol, Dungeon.RuntimeData as RuntimeData, Std.Tasks as Tasks, Std.Test as Test, Std.Tui as Tui;

function UniformRows(Width: integer; Height: integer; Code: string): array of string;
begin
  var Rows: array of string := [];
  for Row: integer := 0 to Height - 1 do
    begin
      Rows.PushInPlace(Code.RepeatStr(Width));
    end;
  end for;

  return Rows;
end function;

begin
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(1);
  const Events: channel of Client.ClientEvent := Tasks.CreateChannel(1);
  var Model: Client.ClientModel := Client.NewClientModel(
    '127.0.0.1',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    Requests,
    Events
  );
  Model.Screen := Client.ClientScreen.GameScreen;
  Model.FocusedControl := 0;
  Model.ViewportWidth := 240;
  Model.ViewportHeight := 40;
  Model.RequestedWorldWidth := 79;
  Model.RequestedWorldHeight := 35;
  const Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  Model := Client.UpdateClientEvent(
    Model,
    Client.ClientEvent.Connected(Catalog.FixtureCatalog(false, false)),
    Cmd
  );
  const MapValue: Protocol.MapVisibleState := Protocol.MapVisibleState(
    OriginX := 0,
    OriginY := 0,
    Width := 79,
    Height := 35,
    Rows := UniformRows(79, 35, 'g'),
    KnowledgeRows := UniformRows(79, 35, 'v'),
    PlayerX := 39,
    PlayerY := 17,
    WorldX := 39,
    WorldY := 17,
    Inventory := [],
    Health := 20,
    MaxHealth := 20,
    Character := []
  );
  const StateValue: Protocol.VisibleState := Protocol.VisibleState.MapState(MapValue);
  Model := Client.UpdateClientEvent(Model, Client.ClientEvent.State(StateValue), Cmd);
  const App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(240, 40));
  Model := App.RunIterations(Model, Client.UpdateClient, Client.ViewClient, 0, 0);
  const Surface: Tui.TuiSurfaceSnapshot := App.SurfaceSnapshot();
  const ContextColumn: integer := Surface.LineAt(0).IndexOf('Environment').Unwrap();
  Test.AssertEquals(163, ContextColumn);
  Test.AssertTrue((Surface.CellAt(ContextColumn - 5, 1).ConcreteStyle is Some(_)));
  App.Close();
  discard Tasks.CloseChannel(Requests);
  discard Tasks.CloseChannel(Events);
end.
