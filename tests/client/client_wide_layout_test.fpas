// Verifies that a wide client preserves the 2:1 main-row split and fills the world panel.
program DungeonClientWideLayoutTest;

uses
  Dungeon.Test.Catalog, Dungeon.Client, Dungeon.Protocol, Dungeon.RuntimeData, Std.Tasks, Std.Test,
  Std.Tui;

function UniformRows(Width: integer; Height: integer; Code: string): array of string;
begin
  var Rows: array of string := [];
  for Row: integer := 0 to Height - 1 do
    begin
      Rows.Push(Code.RepeatStr(Width));
    end;
  end for;

  return Rows;
end function;

begin
  const Requests: channel of ClientMessage := CreateChannel(1);
  const Events: channel of ClientEvent := CreateChannel(1);
  var Model: ClientModel := NewClientModel('127.0.0.1', 4040, '', DefaultClientPreferences(), Requests, Events);
  Model.Screen := ClientScreen.GameScreen;
  Model.FocusedControl := 0;
  Model.ViewportWidth := 240;
  Model.ViewportHeight := 40;
  Model.RequestedWorldWidth := 79;
  Model.RequestedWorldHeight := 35;
  const Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  Model := UpdateClientEvent(Model, ClientEvent.Connected(FixtureCatalog(false, false)), Cmd);
  const MapValue: MapVisibleState := MapVisibleState(OriginX := 0, OriginY := 0, Width := 79, Height := 35, Rows := UniformRows(79, 35, 'g'), KnowledgeRows := UniformRows(79, 35, 'v'), PlayerX := 39, PlayerY := 17, WorldX := 39, WorldY := 17, Inventory := [], Health := 20, MaxHealth := 20, Character := []);
  const StateValue: VisibleState := VisibleState.MapState(MapValue);
  Model := UpdateClientEvent(Model, ClientEvent.State(StateValue), Cmd);
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(240, 40));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  const Surface: TuiSurfaceSnapshot := App.SurfaceSnapshot();
  const ContextColumn: integer := Surface.LineAt(0).IndexOf('Environment');
  AssertEquals(163, ContextColumn);
  AssertTrue(Surface.CellAt(ContextColumn - 5, 1).ConcreteStyle.IsSome());
  App.Close();
  discard CloseChannel(Requests);
  discard CloseChannel(Events);
end.
