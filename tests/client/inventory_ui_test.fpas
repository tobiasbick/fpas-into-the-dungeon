// Verifies authoritative inventory updates in the client model and context presentation.
program DungeonInventoryUiTest;

uses
  Dungeon.Test.Catalog, Dungeon.Client, Dungeon.Protocol, Dungeon.RuntimeData, Std.Tasks, Std.Test,
  Std.Tui;

function ScreenContains(Snapshot: TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Row: integer := 0 to Snapshot.Height - 1 do
    begin
      if Snapshot.LineAt(Row).Contains(Text) then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

function MapState(Inventory: array of VisibleInventoryItem): VisibleState;
begin
  return VisibleState.MapState(MapVisibleState(OriginX := -2, OriginY := -1, Width := 5, Height := 3, Rows := [
                                                                                                                'ggggg',
                                                                                                                'ggggg',
                                                                                                                'ggggg'
                                                                                                              ], KnowledgeRows := [
                                                                                                                                    'vvvvv',
                                                                                                                                    'vvvvv',
                                                                                                                                    'vvvvv'
                                                                                                                                  ], PlayerX := 2, PlayerY := 1, WorldX := 0, WorldY := 0, Inventory := Inventory, Health := 20, MaxHealth := 20, Character := []));
end function;

begin
  const Requests: channel of ClientMessage := CreateChannel(4);
  const Events: channel of ClientEvent := CreateChannel(1);
  var Model: ClientModel := NewClientModel('127.0.0.1', 4040, '', DefaultClientPreferences(), Requests, Events);
  Model.ViewportWidth := 120;
  Model.ViewportHeight := 30;
  Model.RequestedWorldWidth := 39;
  Model.RequestedWorldHeight := 25;
  const Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  Model := UpdateClientEvent(Model, ClientEvent.Connected(FixtureCatalog(false, false)), Cmd);
  Model := UpdateClientEvent(Model, ClientEvent.State(MapState([])), Cmd);
  AssertEquals(0, Model.Inventory.Length());
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(120, 30));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Quick inventory'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Empty'));
  AssertTrue(App.SurfaceSnapshot().LineAt(0).Contains('Environment'));
  AssertTrue(App.SurfaceSnapshot().LineAt(7).Contains('Context'));
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Nothing in reach'));
  Model := UpdateClientEvent(Model, ClientEvent.State(MapState([
                                                                 VisibleInventoryItem(Id := 'example:dungeon:0:0:item:0', Name := 'Ancient coin', Slot := VisibleItemSlot.NoSlot, Equipped := false)
                                                               ])), Cmd);
  AssertEquals(1, Model.Inventory.Length());
  AssertEquals('example:dungeon:0:0:item:0', Model.Inventory[0].Id);
  AssertEquals('Ancient coin', Model.Inventory[0].Name);
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Ancient coin'));
  AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Empty'));
  Model := UpdateClientEvent(Model, ClientEvent.State(MapState([])), Cmd);
  AssertEquals(0, Model.Inventory.Length());
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Empty'));
  var Interior: FirstPersonVisibleState := FirstPersonVisibleState(Title := 'Initial dungeon', Status := 'At your feet: Ancient coin — Enter: Pick up', Width := 3, Height := 3, Rows := [
                                                                                                                                                                                           '###',
                                                                                                                                                                                           '#i#',
                                                                                                                                                                                           '###'
                                                                                                                                                                                         ], KnowledgeRows := [
                                                                                                                                                                                                               'vvv',
                                                                                                                                                                                                               'vvv',
                                                                                                                                                                                                               'vvv'
                                                                                                                                                                                                             ], PlayerX := 1, PlayerY := 1, Facing := FirstPersonFacing.West, Inventory := [], Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []);
  Model := UpdateClientEvent(Model, ClientEvent.State(VisibleState.FirstPersonState(Interior)), Cmd);
  Model := UpdateClientEvent(Model, ClientEvent.State(VisibleState.FirstPersonState(Interior)), Cmd);
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'At your feet: Ancient coin'));
  // The hint belongs to the right-hand panel, not the bottom of the 3-D view.
  AssertTrue(App.SurfaceSnapshot().LineAt(1).IndexOf('At your feet:') >= 80);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Pick up'));
  AssertTrue(App.SurfaceSnapshot().LineAt(7).Contains('Context'));
  AssertFalse(App.SurfaceSnapshot().LineAt(19).Contains('At your feet:'));
  AssertTrue(Model.Overlay = ClientOverlay.NoOverlay);
  AssertEquals('Connected', Model.Status);
  Model.ContextPanelVisible := false;
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'At your feet: Ancient coin'));
  AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Quick inventory'));
  AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Environment'));
  // Empty interaction feedback keeps the sidebar geometry stable.
  Model.ContextPanelVisible := true;
  Interior.Status := 'Nothing in reach';
  Model := UpdateClientEvent(Model, ClientEvent.State(VisibleState.FirstPersonState(Interior)), Cmd);
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Nothing in reach'));
  AssertTrue(App.SurfaceSnapshot().LineAt(7).Contains('Context'));
  Model.ContextPanelVisible := false;
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Nothing in reach'));
  Interior.Rows[1] := '#.#';
  Interior.Status := 'Find the gold exit field.';
  Interior.Inventory := [
                          VisibleInventoryItem(Id := 'coin', Name := 'Ancient coin', Slot := VisibleItemSlot.NoSlot, Equipped := false)
                        ];
  Model := UpdateClientEvent(Model, ClientEvent.State(VisibleState.FirstPersonState(Interior)), Cmd);
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Picked up: Ancient coin'));
  AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'At your feet:'));
  Model := UpdateClientEvent(Model, ClientEvent.State(VisibleState.FirstPersonState(Interior)), Cmd);
  AssertEquals('Find the gold exit field.', Model.PrimaryStatus);
  Model.HasVisibleState := false;
  Model.Inventory := [];
  Model := UpdateClientEvent(Model, ClientEvent.State(VisibleState.FirstPersonState(Interior)), Cmd);
  AssertEquals('Find the gold exit field.', Model.PrimaryStatus);
  App.Close();
  // F2's narrow-screen overlay contains both sections, including the action.
  Model.ViewportWidth := 60;
  Model.ViewportHeight := 30;
  Model.Overlay := ClientOverlay.ContextOverlay;
  Interior.Status := 'At your feet: Ancient coin — Enter: Pick up';
  Model.PrimaryStatus := Interior.Status;
  const NarrowApp: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(60, 30));
  Model := NarrowApp.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(ScreenContains(NarrowApp.SurfaceSnapshot(), 'Environment'));
  AssertTrue(ScreenContains(NarrowApp.SurfaceSnapshot(), 'Context'));
  AssertTrue(ScreenContains(NarrowApp.SurfaceSnapshot(), 'Enter: Pick up'));
  AssertTrue(ScreenContains(NarrowApp.SurfaceSnapshot(), 'Quick inventory'));
  NarrowApp.Close();
  Model.ViewportWidth := 120;
  Model.ViewportHeight := 22;
  Model.ContextPanelVisible := true;
  Model.Overlay := ClientOverlay.NoOverlay;
  const ShortApp: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(120, 22));
  Model := ShortApp.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertFalse(ScreenContains(ShortApp.SurfaceSnapshot(), 'Environment'));
  AssertTrue(ScreenContains(ShortApp.SurfaceSnapshot(), 'At your feet: Ancient coin'));
  ShortApp.Close();
  discard CloseChannel(Requests);
  discard CloseChannel(Events);
end.
