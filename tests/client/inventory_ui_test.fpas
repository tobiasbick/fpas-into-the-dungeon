// Verifies authoritative inventory updates in the client model and context presentation.
program DungeonInventoryUiTest;

uses Dungeon.Test.Catalog as CatalogUnit, Dungeon.Client as ClientUnit, Dungeon.Protocol as Protocol, Dungeon.RuntimeData as RuntimeData, Std.Tasks as Tasks, Std.Test as Test, Std.Tui as Tui;

function ScreenContains(Snapshot: Tui.TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Row: integer := 0 to Snapshot.Height - 1 do
    begin
      if Text in Snapshot.LineAt(Row) then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

function MapState(Inventory: array of Protocol.VisibleInventoryItem): Protocol.VisibleState;
begin
  return Protocol.VisibleState.MapState(
    Protocol.MapVisibleState(
      OriginX := -2, OriginY := -1, Width := 5, Height := 3, Rows := [
        'ggggg',
        'ggggg',
        'ggggg'
      ], KnowledgeRows := [
        'vvvvv',
        'vvvvv',
        'vvvvv'
      ], PlayerX := 2, PlayerY := 1, WorldX := 0, WorldY := 0, Inventory := Inventory, Health := 20,
      MaxHealth := 20, Character := []
    )
  );
end function;

function Potion(Id: string): Protocol.VisibleInventoryItem;
begin
  return Protocol.VisibleInventoryItem(
    Id := Id,
    Name := 'Healing potion',
    Slot := Protocol.VisibleItemSlot.NoSlot,
    Equipped := false,
    Usable := true
  );
end function;

begin
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(4);
  const Events: channel of ClientUnit.ConnectionEvent := Tasks.CreateChannel(1);
  var Model: ClientUnit.ClientModel := ClientUnit.NewClientModel(
    '127.0.0.1',
    4040,
    '',
    RuntimeData.DefaultClientPreferences(),
    Requests,
    Events
  );
  Model.ViewportWidth := 120;
  Model.ViewportHeight := 30;
  Model.RequestedWorldWidth := 39;
  Model.RequestedWorldHeight := 25;
  const Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.Connected(CatalogUnit.FixtureCatalog(false, false)),
    Cmd
  );
  Model := ClientUnit.UpdateClientEvent(Model, ClientUnit.ClientEvent.State(MapState([])), Cmd);
  Test.AssertEquals(0, Model.Inventory.Length());
  const App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(120, 30));
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Quick inventory'));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Empty'));
  Test.AssertTrue('Environment' in App.SurfaceSnapshot().LineAt(0));
  Test.AssertTrue('Context' in App.SurfaceSnapshot().LineAt(7));
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Nothing in reach'));
  Model := ClientUnit.UpdateClientEvent(
    Model, ClientUnit.ClientEvent.State(
      MapState([
        Protocol.VisibleInventoryItem(
          Id := 'example:dungeon:0:0:item:0',
          Name := 'Ancient coin',
          Slot := Protocol.VisibleItemSlot.NoSlot,
          Equipped := false, Usable := false
        )
      ])
    ), Cmd
  );
  Test.AssertEquals(1, Model.Inventory.Length());
  Test.AssertEquals('example:dungeon:0:0:item:0', Model.Inventory[0].Id);
  Test.AssertEquals('Ancient coin', Model.Inventory[0].Name);
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Ancient coin'));
  Test.AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Empty'));
  Model := ClientUnit.UpdateClientEvent(Model, ClientUnit.ClientEvent.State(MapState([])), Cmd);
  Test.AssertEquals(0, Model.Inventory.Length());
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Empty'));
  var Interior: Protocol.FirstPersonVisibleState := Protocol.FirstPersonVisibleState(
    Title := 'Initial dungeon', Status := 'At your feet: Ancient coin — Enter: Pick up', Width := 3,
    Height := 3, Rows := [
      '###',
      '#i#',
      '###'
    ], KnowledgeRows := [
      'vvv',
      'vvv',
      'vvv'
    ], PlayerX := 1, PlayerY := 1, Facing := Protocol.FirstPersonFacing.West, Inventory := [],
    Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []
  );
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Protocol.VisibleState.FirstPersonState(Interior)),
    Cmd
  );
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Protocol.VisibleState.FirstPersonState(Interior)),
    Cmd
  );
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'At your feet: Ancient coin'));
  // The hint belongs to the right-hand panel, not the bottom of the 3-D view.
  const HintColumn: integer := case App.SurfaceSnapshot().LineAt(1).IndexOf('At your feet:') of
    when Some(const Column): Column;
    when None: -1;
  end case;
  Test.AssertTrue(HintColumn >= 80);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Pick up'));
  Test.AssertTrue('Context' in App.SurfaceSnapshot().LineAt(7));
  Test.AssertFalse('At your feet:' in App.SurfaceSnapshot().LineAt(19));
  Test.AssertTrue(Model.Overlay = ClientUnit.ClientOverlay.NoOverlay);
  Test.AssertEquals('Connected', Model.Status);
  Model.ContextPanelVisible := false;
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'At your feet: Ancient coin'));
  Test.AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Quick inventory'));
  Test.AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Environment'));
  // Empty interaction feedback keeps the sidebar geometry stable.
  Model.ContextPanelVisible := true;
  Interior.Status := 'Nothing in reach';
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Protocol.VisibleState.FirstPersonState(Interior)),
    Cmd
  );
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Nothing in reach'));
  Test.AssertTrue('Context' in App.SurfaceSnapshot().LineAt(7));
  Model.ContextPanelVisible := false;
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'Nothing in reach'));
  Interior.Rows[1] := '#.#';
  Interior.Status := 'Find the gold exit field.';
  Interior.Inventory := [
    Protocol.VisibleInventoryItem(
      Id := 'coin',
      Name := 'Ancient coin',
      Slot := Protocol.VisibleItemSlot.NoSlot,
      Equipped := false, Usable := false
    )
  ];
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Protocol.VisibleState.FirstPersonState(Interior)),
    Cmd
  );
  Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(App.SurfaceSnapshot(), 'Picked up: Ancient coin'));
  Test.AssertFalse(ScreenContains(App.SurfaceSnapshot(), 'At your feet:'));
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Protocol.VisibleState.FirstPersonState(Interior)),
    Cmd
  );
  Test.AssertEquals('Find the gold exit field.', Model.PrimaryStatus);
  Model.HasVisibleState := false;
  Model.Inventory := [];
  Model := ClientUnit.UpdateClientEvent(
    Model,
    ClientUnit.ClientEvent.State(Protocol.VisibleState.FirstPersonState(Interior)),
    Cmd
  );
  Test.AssertEquals('Find the gold exit field.', Model.PrimaryStatus);
  App.Close();
  // F2's narrow-screen overlay contains both sections, including the action.
  Model.ViewportWidth := 60;
  Model.ViewportHeight := 30;
  Model.Overlay := ClientUnit.ClientOverlay.ContextOverlay;
  Interior.Status := 'At your feet: Ancient coin — Enter: Pick up';
  Model.PrimaryStatus := Interior.Status;
  const NarrowApp: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(60, 30));
  Model := NarrowApp.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertTrue(ScreenContains(NarrowApp.SurfaceSnapshot(), 'Environment'));
  Test.AssertTrue(ScreenContains(NarrowApp.SurfaceSnapshot(), 'Context'));
  Test.AssertTrue(ScreenContains(NarrowApp.SurfaceSnapshot(), 'Enter: Pick up'));
  Test.AssertTrue(ScreenContains(NarrowApp.SurfaceSnapshot(), 'Quick inventory'));
  NarrowApp.Close();
  Model.ViewportWidth := 120;
  Model.ViewportHeight := 22;
  Model.ContextPanelVisible := true;
  Model.Overlay := ClientUnit.ClientOverlay.NoOverlay;
  const ShortApp: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(120, 22));
  Model := ShortApp.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
  Test.AssertFalse(ScreenContains(ShortApp.SurfaceSnapshot(), 'Environment'));
  Test.AssertTrue(ScreenContains(ShortApp.SurfaceSnapshot(), 'At your feet: Ancient coin'));
  ShortApp.Close();
  // Authoritative refreshes keep identity, even for identical names, and clamp a removed selection.
  const Potions := [Potion('first'), Potion('middle'), Potion('last')];
  for Selected: integer := 0 to 2 do
    var Remaining: array of Protocol.VisibleInventoryItem := [];
    for Index: integer := 0 to 2 do
      if Index <> Selected then
        Remaining.PushInPlace(Potions[Index]);
      end if;
    end for;
    const Before := Model with Inventory := Potions; InventorySelection := Selected; end with;
    const After := ClientUnit.UpdateClientEvent(
      Before,
      ClientUnit.ClientEvent.State(MapState(Remaining)),
      Cmd
    );
    Test.AssertEquals(if Selected = 2 then 1 else Selected end if, After.InventorySelection);
    Test.AssertEquals(
      Remaining[After.InventorySelection].Id,
      After.Inventory[After.InventorySelection].Id
    );
    Test.AssertFalse('Picked up:' in After.PrimaryStatus);
  end for;
  const SelectedLast := Model with Inventory := Potions; InventorySelection := 2; end with;
  const Reordered := ClientUnit.UpdateClientEvent(
    SelectedLast,
    ClientUnit.ClientEvent.State(MapState([Potions[2], Potions[0]])),
    Cmd
  );
  Test.AssertEquals(0, Reordered.InventorySelection);
  Test.AssertEquals('last', Reordered.Inventory[0].Id);
  const Unchanged := ClientUnit.UpdateClientEvent(
    SelectedLast,
    ClientUnit.ClientEvent.State(MapState(Potions)),
    Cmd
  );
  Test.AssertEquals(2, Unchanged.InventorySelection);
  const Only := Model with Inventory := [Potions[1]]; InventorySelection := 0; end with;
  const Empty := ClientUnit.UpdateClientEvent(
    Only,
    ClientUnit.ClientEvent.State(MapState([])),
    Cmd
  );
  Test.AssertEquals(0, Empty.InventorySelection);
  Test.AssertEquals(0, Empty.Inventory.Length());
  for Invalid: integer in [-1, 99] do
    const Before := Model with Inventory := Potions; InventorySelection := Invalid; end with;
    const After := ClientUnit.UpdateClientEvent(
      Before,
      ClientUnit.ClientEvent.State(MapState(Potions)),
      Cmd
    );
    Test.AssertEquals(if Invalid < 0 then 0 else 2 end if, After.InventorySelection);
  end for;

  discard Tasks.CloseChannel(Requests);
  discard Tasks.CloseChannel(Events);
end.
