// Verifies floor sprites for equipment/potions and the first-person effects of combat animation frames.
program DungeonCombatAnimationRenderTest;

uses Dungeon.Client.Animation as AnimationUnit, Dungeon.Client.Raycast as Raycast, Dungeon.Client.Raycast.Sprites as Sprites, Dungeon.Protocol as Protocol, Std.Test as Test, Std.Tui as Tui;

function Corridor(Middle: string): Protocol.FirstPersonVisibleState;
begin
  return Protocol.FirstPersonVisibleState(
    Weather := None,
    Time := Protocol.VisibleTime(Day := 1, MinuteOfDay := 480, Phase := Protocol.DayPhase.Day),
    Coins := 0,
    Title := 'Corridor', Status := '', Level := 0, Depth := 1, Width := 7, Height := 3, Rows := [
      '#######',
      Middle,
      '#######'
    ], KnowledgeRows := [
      'vvvvvvv',
      'vvvvvvv',
      'vvvvvvv'
    ], PlayerX := 1, PlayerY := 1, Facing := Protocol.FirstPersonFacing.East, Inventory := [],
    Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := [],
    Journal := []
  );
end function;

function SameCell(Left: Tui.TuiCell; Right: Tui.TuiCell): boolean;
begin
  const A: Tui.TuiStyle := Left.ConcreteStyle.Unwrap();
  const B: Tui.TuiStyle := Right.ConcreteStyle.Unwrap();
  return (
    (Left.Glyph = Right.Glyph)
    and
    ((A.Background.Red = B.Background.Red) and (A.Background.Green = B.Background.Green))
  )
    and
    (
      ((A.Background.Blue = B.Background.Blue) and (A.Foreground.Red = B.Foreground.Red))
      and
      ((A.Foreground.Green = B.Foreground.Green) and (A.Foreground.Blue = B.Foreground.Blue))
    );
end function;

function DifferentCells(Left: Tui.TuiCellGrid; Right: Tui.TuiCellGrid): integer;
begin
  var Count: integer := 0;
  for I: integer := 0 to Left.Cells.Length() - 1 do
    begin
      if not SameCell(Left.Cells[I], Right.Cells[I]) then
        begin
          Count := Count + 1;
        end;
      end if;
    end;
  end for;

  return Count;
end function;

// Counts cells whose upper or lower half shows the white-hot flash color.
function FlashCells(Grid: Tui.TuiCellGrid): integer;
begin
  var Count: integer := 0;
  for Cell: Tui.TuiCell in Grid.Cells do
    begin
      const Style: Tui.TuiStyle := Cell.ConcreteStyle.Unwrap();
      if ((Style.Foreground.Red = 255) and (Style.Foreground.Green = 250))
        and
        (Style.Foreground.Blue = 236)
      then
        begin
          Count := Count + 1;
        end;
      end if;
    end;
  end for;

  return Count;
end function;

begin
  const Width: integer := 61;
  const Height: integer := 25;
  const Empty: Protocol.FirstPersonVisibleState := Corridor('#.....#');
  const EmptyGrid: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(Empty, Width, Height);
  // Equipment and potions lie on the floor: they change cells only below the horizon.
  for Code: string in ['w', 'a', 'p'] do
    begin
      const WithItem: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(
        Corridor(('#.' + Code) + '...#'),
        Width,
        Height
      );
      Test.AssertTrue(DifferentCells(WithItem, EmptyGrid) > 0);
      for I: integer := 0 to ((Height div 2) * Width) - 1 do
        begin
          Test.AssertTrue(SameCell(WithItem.Cells[I], EmptyGrid.Cells[I]));
        end;
      end for;
    end;
  end for;

  Test.AssertTrue(
    DifferentCells(
      Raycast.RenderFirstPersonGrid(Corridor('#.w...#'), Width, Height),
      Raycast.RenderFirstPersonGrid(Corridor('#.a...#'), Width, Height)
    ) >
    0
  );
  const Potion := Corridor('#.p...#');
  Test.AssertEquals(1, Sprites.VisibleSprites(Potion).Length());
  Test.AssertFalse(Sprites.VisibleSprites(Potion)[0].Hostile);
  const PotionGrid := Raycast.RenderFirstPersonGrid(Potion, Width, Height);
  Test.AssertTrue(
    DifferentCells(PotionGrid, Raycast.RenderFirstPersonGrid(Corridor('#.i...#'), Width, Height)) >
    0
  );
  Test.AssertTrue(
    DifferentCells(PotionGrid, Raycast.RenderFirstPersonGrid(Corridor('#.w...#'), Width, Height)) >
    0
  );
  const HiddenPotion := Potion with KnowledgeRows := ['vvvvvvv', 'vvrvvvv', 'vvvvvvv']; end with;

  Test.AssertEquals(0, Sprites.VisibleSprites(HiddenPotion).Length());
  // A still frame composed from a scene equals the plain rendering.
  const Fight: Protocol.FirstPersonVisibleState := Corridor('#.h...#');
  const Scene: Raycast.FirstPersonScene := Raycast.RenderFirstPersonScene(Fight, Width, Height);
  const Still: Tui.TuiCellGrid := Raycast.ComposeFirstPersonGrid(
    Fight,
    Scene,
    Sprites.NoFirstPersonEffect()
  );
  Test.AssertEquals(0, DifferentCells(Still, Raycast.RenderFirstPersonGrid(Fight, Width, Height)));
  Test.AssertEquals(0, FlashCells(Still));
  // A flash whitens the skeleton; a dodge and a lunge move and enlarge it.
  var Effect: Sprites.FirstPersonEffect := Sprites.NoFirstPersonEffect();
  Effect.Flash := true;
  Effect.TargetCode := Protocol.InteriorHostileCode;
  Test.AssertTrue(FlashCells(Raycast.ComposeFirstPersonGrid(Fight, Scene, Effect)) > 10);
  Effect := Sprites.NoFirstPersonEffect();
  Effect.Shift := 0.35;
  Effect.TargetCode := Protocol.InteriorHostileCode;
  Test.AssertTrue(DifferentCells(Raycast.ComposeFirstPersonGrid(Fight, Scene, Effect), Still) > 0);
  Effect := Sprites.NoFirstPersonEffect();
  Effect.Scale := 1.25;
  Effect.ActorCodes := [Protocol.InteriorHostileCode];
  Test.AssertTrue(DifferentCells(Raycast.ComposeFirstPersonGrid(Fight, Scene, Effect), Still) > 0);
  // A fully sunk skeleton is gone; a fallen one is drawn on the field ahead without an h code.
  Effect := Sprites.NoFirstPersonEffect();
  Effect.Sink := 1.0;
  Effect.TargetCode := Protocol.InteriorHostileCode;
  const Sunk: Tui.TuiCellGrid := Raycast.ComposeFirstPersonGrid(Fight, Scene, Effect);
  Test.AssertTrue(DifferentCells(Sunk, Still) > 0);
  const EmptyScene: Raycast.FirstPersonScene := Raycast.RenderFirstPersonScene(
    Empty,
    Width,
    Height
  );
  Effect := Sprites.NoFirstPersonEffect();
  Effect.FallenAhead := true;
  Effect.FallenCode := Protocol.InteriorHostileCode;
  Test.AssertEquals(
    0,
    DifferentCells(Raycast.ComposeFirstPersonGrid(Empty, EmptyScene, Effect), Still)
  );
  // Swings change the lower right of the view; blade and fist differ.
  Effect := Sprites.NoFirstPersonEffect();
  Effect.Swing := 0.5;
  const Fist: Tui.TuiCellGrid := Raycast.ComposeFirstPersonGrid(Empty, EmptyScene, Effect);
  Effect.Armed := true;
  const Blade: Tui.TuiCellGrid := Raycast.ComposeFirstPersonGrid(Empty, EmptyScene, Effect);
  Test.AssertTrue(DifferentCells(Fist, EmptyGrid) > 0);
  Test.AssertTrue(DifferentCells(Blade, EmptyGrid) > 0);
  Test.AssertTrue(DifferentCells(Blade, Fist) > 0);
  // Rising texts land centered in the view; empty texts draw nothing.
  var Frame: AnimationUnit.AnimationFrame := AnimationUnit.AnimationFrameAt(
    AnimationUnit.NoAnimation()
  );
  Test.AssertEquals(0, DifferentCells(AnimationUnit.PaintAnimationText(Still, Frame), Still));
  Frame.HostileText := '-5';
  Frame.PlayerText := '-3';
  const Texts: Tui.TuiCellGrid := AnimationUnit.PaintAnimationText(Still, Frame);
  Test.AssertEquals(4, DifferentCells(Texts, Still));
  Test.AssertEquals('-', Texts.Cells[((Height div 4) * Width) + (Width - 2) div 2].Glyph);
  Test.AssertEquals('3', Texts.Cells[(((Height - 4) * Width) + ((Width - 2) div 2)) + 1].Glyph);
  // Texts outside the grid are clipped instead of failing.
  Frame.Rise := Height;
  Test.AssertEquals(0, DifferentCells(AnimationUnit.PaintAnimationText(Still, Frame), Still));
end.
