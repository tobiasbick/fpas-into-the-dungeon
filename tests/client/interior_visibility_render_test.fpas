// Replays real dungeon visibility through the renderer at both reported screenshot positions.
program InteriorVisibilityRenderTest;

uses
  Dungeon.Client.Raycast, Dungeon.Client.Raycast.Rays, Dungeon.Coordinates, Dungeon.Exploration,
  Dungeon.Exploration.Sight, Dungeon.Interior, Dungeon.Test.Fixtures, Dungeon.Protocol, Std.Test,
  Std.Tui;

begin
  const Map: InteriorMap := FixtureDungeonMap();
  for X: integer in [1, 2] do
    begin
      const Pose: FirstPersonPose := FirstPersonPose(Position := InteriorPosition(X := X, Y := 5), Facing := FacingDirection.East);
      const Visible: array of boolean := InteriorVisibility(Map, Pose);
      var Rows: array of string := [];
      var Knowledge: array of string := [];
      for Y: integer := 0 to Map.Height - 1 do
        begin
          var Row: string := '';
          var Mask: string := '';
          for Col: integer := 0 to Map.Width - 1 do
            begin
              if Visible[Y * Map.Width + Col] then
                begin
                  Mask := Mask + 'v';
                  Row := Row + InteriorCellCode(Map.Cells[Y * Map.Width + Col]);
                end;
              else
                begin
                  Mask := Mask + 'u';
                  Row := Row + '?';
                end;
              end if;
            end;
          end for;

          Rows.Push(Row);
          Knowledge.Push(Mask);
        end;
      end for;
      const Value: FirstPersonVisibleState := FirstPersonVisibleState(Title := 'Initial dungeon', Status := 'Nothing in reach', Width := Map.Width, Height := Map.Height, Rows := Rows, KnowledgeRows := Knowledge, PlayerX := X, PlayerY := 5, Facing := FirstPersonFacing.East, Inventory := [], Health := 20, MaxHealth := 20, Character := [], CombatLog := [], CombatEvents := []);
      const Center: FirstPersonRayHit := CastFirstPersonRay(Value, 0.0);
      const Right: FirstPersonRayHit := CastFirstPersonRay(Value, 0.25);
      AssertEquals('#', Center.FieldCode);
      AssertEquals('#', Right.FieldCode);
      if X = 1 then
        begin
          AssertTrue(Center.Distance > 2.84);
          AssertTrue(Center.Distance < 2.86);
          // At this angle the exposed face of (3,6), not fog, is reached first.
          AssertTrue(Right.Distance > 1.99);
          AssertTrue(Right.Distance < 2.01);
        end;
      else
        begin
          AssertTrue(Center.Distance > 1.84);
          AssertTrue(Center.Distance < 1.86);
        end;
      end if;

      for Width: integer in [81, 101] do
        begin
          const Grid: TuiCellGrid := RenderFirstPersonGrid(Value, Width, 37);
          // The right portion of the end-wall junction must be stone, not a fog slit.
          // Fog is red 18; stone stays above 60 even on a darkened mortar joint.
          const Color: TuiColor := Grid.Cells[18 * Width + ((Width - 1) * 5) div 8].ConcreteStyle.Unwrap()
                                     .Background;
          AssertTrue(Color.Red > 60);
        end;
      end for;
    end;
  end for;
end.
