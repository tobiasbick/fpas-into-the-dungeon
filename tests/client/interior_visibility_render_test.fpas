// Replays real dungeon visibility through the renderer at both reported screenshot positions.
program InteriorVisibilityRenderTest;

uses
  Dungeon.Game, Dungeon.Exploration, Dungeon.Protocol, Dungeon.Client.Raycast, Std.Results,
  Std.Arrays, Std.Options, Std.Test, Std.Tui;

begin
  var Map: InteriorMap := Std.Results.Unwrap(InitialDungeonMap());
  for X: integer in [1, 2] do
  begin
    var Pose: FirstPersonPose := record
      Position := record
        X := X;
        Y := 5;
      end;
      Facing := FacingDirection.East;
    end;
    var Visible: array of boolean := InteriorVisibility(Map, Pose);
    mutable var Rows: array of string := [];
    mutable var Knowledge: array of string := [];
    for Y: integer := 0 to Map.Height - 1 do
    begin
      mutable var Row: string := '';
      mutable var Mask: string := '';
      for Col: integer := 0 to Map.Width - 1 do
      begin
        if Visible[Y * Map.Width + Col] then
        begin
          Mask := Mask + 'v';
          Row := Row + InteriorCellCode(Map.Cells[Y * Map.Width + Col])
        end
        else
        begin
          Mask := Mask + 'u';
          Row := Row + '?'
        end
      end;

      Std.Arrays.Push(Rows, Row);
      Std.Arrays.Push(Knowledge, Mask)
    end;
    var Value: FirstPersonVisibleState := record
      Title := 'Initial dungeon';
      Status := 'Nothing in reach';
      Width := Map.Width;
      Height := Map.Height;
      Rows := Rows;
      KnowledgeRows := Knowledge;
      PlayerX := X;
      PlayerY := 5;
      Facing := FirstPersonFacing.East;
      Inventory := [];
    end;
    var Center: FirstPersonRayHit := CastFirstPersonRay(Value, 0.0);
    var Right: FirstPersonRayHit := CastFirstPersonRay(Value, 0.25);
    AssertEquals('#', Center.FieldCode);
    AssertEquals('#', Right.FieldCode);
    if X = 1 then
    begin
      AssertTrue(Center.Distance > 2.84);
      AssertTrue(Center.Distance < 2.86);
      // At this angle the exposed face of (3,6), not fog, is reached first.
      AssertTrue(Right.Distance > 1.99);
      AssertTrue(Right.Distance < 2.01)
    end
    else
    begin
      AssertTrue(Center.Distance > 1.84);
      AssertTrue(Center.Distance < 1.86)
    end;

    for Width: integer in [81, 101] do
    begin
      var Grid: TuiCellGrid := RenderFirstPersonGrid(Value, Width, 37);
      // The right portion of the end-wall junction must be stone, not a fog slit.
      var Color: TuiColor := Std.Options.Unwrap(Grid.Cells[18 * Width + ((Width - 1) * 5) div 8].ConcreteStyle)
                               .Background;
      AssertTrue(Color.Red > 100)
    end
  end
end.
