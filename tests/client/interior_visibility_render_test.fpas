// Replays real dungeon visibility through the renderer at both reported screenshot positions.
program InteriorVisibilityRenderTest;

uses Dungeon.Client.Raycast as Raycast, Dungeon.Client.Raycast.Rays as Rays, Dungeon.Coordinates as Coordinates, Dungeon.Exploration as Exploration, Dungeon.Exploration.Sight as Sight, Dungeon.Interior as InteriorUnit, Dungeon.Test.Fixtures as Fixtures, Dungeon.Protocol as Protocol, Std.Test as Test, Std.Tui as Tui;

begin
  const Map: InteriorUnit.InteriorMap := Fixtures.FixtureDungeonMap();
  for X: integer in [1, 2] do
    begin
      const Pose: Coordinates.FirstPersonPose := Coordinates.FirstPersonPose(
        Position := Coordinates.InteriorPosition(X := X, Y := 5),
        Facing := Coordinates.FacingDirection.East
      );
      const Visible: array of boolean := Sight.InteriorVisibility(Map, Pose);
      var Rows: array of string := [];
      var Knowledge: array of string := [];
      for Y: integer := 0 to Map.Height - 1 do
        begin
          var Row: string := '';
          var Mask: string := '';
          for Col: integer := 0 to Map.Width - 1 do
            begin
              if Visible[Y * Map.Width + Col] then
                begin
                  Mask := Mask + 'v';
                  Row := Row + InteriorUnit.InteriorCellCode(Map.Cells[Y * Map.Width + Col]);
                end;
              else
                begin
                  Mask := Mask + 'u';
                  Row := Row + '?';
                end;
              end if;
            end;
          end for;

          Rows.PushInPlace(Row);
          Knowledge.PushInPlace(Mask);
        end;
      end for;
      const Value: Protocol.FirstPersonVisibleState := Protocol.FirstPersonVisibleState(
        Title := 'Initial dungeon',
        Status := 'Nothing in reach',
        Width := Map.Width,
        Height := Map.Height,
        Rows := Rows,
        KnowledgeRows := Knowledge,
        PlayerX := X,
        PlayerY := 5,
        Facing := Protocol.FirstPersonFacing.East,
        Inventory := [],
        Health := 20,
        MaxHealth := 20,
        Character := [],
        CombatLog := [],
        CombatEvents := []
      );
      const Center: Rays.FirstPersonRayHit := Rays.CastFirstPersonRay(Value, 0.0);
      const Right: Rays.FirstPersonRayHit := Rays.CastFirstPersonRay(Value, 0.25);
      Test.AssertEquals('#', Center.FieldCode);
      Test.AssertEquals('#', Right.FieldCode);
      if X = 1 then
        begin
          Test.AssertTrue(Center.Distance > 2.84);
          Test.AssertTrue(Center.Distance < 2.86);
          // At this angle the exposed face of (3,6), not fog, is reached first.
          Test.AssertTrue(Right.Distance > 1.99);
          Test.AssertTrue(Right.Distance < 2.01);
        end;
      else
        begin
          Test.AssertTrue(Center.Distance > 1.84);
          Test.AssertTrue(Center.Distance < 1.86);
        end;
      end if;

      for Width: integer in [81, 101] do
        begin
          const Grid: Tui.TuiCellGrid := Raycast.RenderFirstPersonGrid(Value, Width, 37);
          // The right portion of the end-wall junction must be stone, not a fog slit.
          // Fog is red 18; stone stays above 60 even on a darkened mortar joint.
          const Color: Tui.TuiColor := Grid.Cells[18 * Width + ((Width - 1) * 5) div 8].ConcreteStyle.Unwrap().Background;
          Test.AssertTrue(Color.Red > 60);
        end;
      end for;
    end;
  end for;
end.
