// Verifies rat level/save round trips, kind/health rejection and non-destructive obsolete save handling.
program RatStorageTest;

uses Dungeon.Areas.Identities as Identities, Dungeon.Coordinates as Coordinates, Dungeon.Hostiles as Hostiles, Dungeon.Test.Levels as Levels, Dungeon.World as WorldUnit, Dungeon.World.Interiors as Interiors, Dungeon.World.Interiors.Encoding as Encoding, Dungeon.World.Savegame as Savegame, Dungeon.GameState as GameState, Dungeon.Terrain.Entrances as Entrances, Std.Conv as Conv, Std.Fs as Fs, Std.Test as Test, Std.Time as Time;

begin
  const Root := '.temp-data/rat-storage-' + Conv.IntToStr(Time.TimestampMillis());
  Test.AssertTrue(Fs.CreateDirAll(Root).Unwrap());
  const World := WorldUnit.OpenWorld(Root, 'rats', 12345, 4, 16).Unwrap();
  const Map := Levels.SpawnLevel(World);
  const Region := Entrances.RegionOf(World.Metadata, World.Metadata.Spawn);
  const Path := World.Directory + '/dungeons/' + Conv.IntToStr(Region.X) + '_' +
    Conv.IntToStr(Region.Y) + '/0.json';
  const Stored := Encoding.EncodeLevel(World.Metadata, Map);
  Test.AssertTrue(
    Encoding.DecodeLevel(Stored, World.Metadata, Map.AreaId).Unwrap().Hostiles[1].Kind =
    Hostiles.HostileKind.GiantRat
  );
  Test.AssertTrue(Fs.WriteTextAtomic(Path, Stored).Unwrap());
  var State := Levels.EnterSpawnLevel(World, GameState.NewGame(World.Metadata)).Unwrap();
  Test.AssertEquals(6, State.Hostiles[1].Health);
  for Health: integer in [0, 1, 6] do
    State.Hostiles[1] := State.Hostiles[1] with Health := Health; end with;

    Test.AssertTrue(Savegame.WriteSaveGame(World, State).Unwrap());
    case Savegame.LoadSaveGame(World).Unwrap() of
      when Savegame.SaveGameLoad.Loaded(const Loaded, const View):
        Test.AssertEquals(Health, Loaded.Hostiles[1].Health);
        Test.AssertTrue(Loaded.Hostiles[1].Kind = Hostiles.HostileKind.GiantRat);
        Test.AssertTrue(View.Interior.Unwrap().Hostiles[1].Kind = Hostiles.HostileKind.GiantRat);
      when Savegame.SaveGameLoad.Missing, Savegame.SaveGameLoad.Invalid(_):
        panic('rat save must load');
    end case;
  end for;
  const ValidSave := Fs.ReadText(Savegame.SaveGamePath(World)).Unwrap();
  for Broken: string in [
    ValidSave.Replace('"health":6', '"health":7'),
    ValidSave.Replace('"kind":"giant_rat"', '"kind":"unknown_rat"'),
    ValidSave.Replace('"format_version":15', '"format_version":9')
  ] do
    Test.AssertTrue(Fs.WriteTextAtomic(Savegame.SaveGamePath(World), Broken).Unwrap());
    Test.AssertTrue(Savegame.LoadSaveGame(World).Unwrap() is Savegame.SaveGameLoad.Invalid(_));
    Test.AssertEquals(Broken, Fs.ReadText(Savegame.SaveGamePath(World)).Unwrap());
  end for;

  Test.AssertTrue(
    Encoding.DecodeLevel(
      Stored.Replace('"kind":"giant_rat"', '"kind":"unknown_rat"'),
      World.Metadata,
      Map.AreaId
    ) is Error(_)
  );
  Test.AssertEquals(Stored, Fs.ReadText(Path).Unwrap());
end.
