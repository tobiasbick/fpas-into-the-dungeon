// Covers the savegame failure matrix: missing, invalid, and unreadable levels never remove a save.
program PersistenceFailureTest;

uses
  Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interior, Dungeon.Items, Dungeon.Terrain,
  Dungeon.Terrain.Entrances, Dungeon.Test.Fixtures, Dungeon.Test.Levels, Dungeon.World,
  Dungeon.World.Interiors.Errors, Dungeon.World.Savegame, Dungeon.World.Savegame.Errors, Std.Conv,
  Std.Fs, Std.Path, Std.Test, Std.Time;

function LevelPath(World: WorldSession): string;
begin
  const Region: RegionCoordinate := RegionOf(World.Metadata, World.Metadata.Spawn);
  return Std.Path.Join([
                         World.Directory,
                         'dungeons',
                         (IntToStr(Region.X) + '_') + IntToStr(Region.Y),
                         '0.json'
                       ]);
end function;

// Names the class of a persistence failure without looking at any message text.
function FailureClass(Failure: PersistenceFailure): string;
begin
  case Failure of
    when PersistenceFailure.InvalidState(const Reason):
      begin
        return 'invalid-state';
      end;
    when PersistenceFailure.Io(const Reason):
      begin
        return 'io';
      end;
    when PersistenceFailure.Level(const Level):
      begin
        case Level of
          when LevelFailure.Missing(const AreaId):
            begin
              return 'level-missing';
            end;
          when LevelFailure.Invalid(const AreaId, const Reason):
            begin
              return 'level-invalid';
            end;
          when LevelFailure.Io(const Reason):
            begin
              return 'level-io';
            end;
          when LevelFailure.Generation(const AreaId, const Reason):
            begin
              return 'level-generation';
            end;
        end case;
      end;
  end case;
end function;

// Names the class of a load outcome without looking at any message text.
function LoadClass(Value: result of (SaveGameLoad, PersistenceFailure)): string;
begin
  case Value of
    when Ok(const Loaded):
      begin
        case Loaded of
          when SaveGameLoad.Missing:
            begin
              return 'missing';
            end;
          when SaveGameLoad.Invalid(const Reason):
            begin
              return 'invalid';
            end;
          when SaveGameLoad.Loaded(const State, const View):
            begin
              return 'loaded';
            end;
        end case;
      end;
    when Error(const Failure):
      begin
        return FailureClass(Failure);
      end;
  end case;
end function;

function WriteClass(Value: result of (boolean, PersistenceFailure)): string;
begin
  case Value of
    when Ok(const Written):
      begin
        return 'written';
      end;
    when Error(const Failure):
      begin
        return FailureClass(Failure);
      end;
  end case;
end function;

begin
  const Root: string := '.temp-data/persistence-failure-test-' + IntToStr(TimestampMillis());
  const World: WorldSession := OpenWorld(Root, 'failures', 24680, 4, 16).Unwrap();
  const Dungeons: string := Std.Path.Join([World.Directory, 'dungeons']);
  // No save: Missing, and no level is inspected or created.
  AssertEquals('missing', LoadClass(LoadSaveGame(World)));
  AssertFalse(Std.Fs.Exists(Dungeons));
  // A valid save that visited the spawn dungeon, standing outside again.
  const Map: InteriorMap := SpawnLevel(World);
  const Entered: GameState := EnterSpawnLevel(World, NewGame(World.Metadata)).Unwrap();
  const AtExit: GameState := Entered with Player := PlayerPosition.FirstPerson(FirstPersonPose(Position := Map.Exit, Facing := Map.StartFacing)); end with;
  const Outside: GameState := LeaveLevel(World, AtExit, Map).Unwrap();
  AssertEquals('written', WriteClass(WriteSaveGame(World, Outside)));
  const SaveText: string := Std.Fs.ReadText(SaveGamePath(World)).Unwrap();
  const LevelText: string := Std.Fs.ReadText(LevelPath(World)).Unwrap();
  // Fully valid: loaded without any write.
  AssertEquals('loaded', LoadClass(LoadSaveGame(World)));
  AssertEquals(SaveText, Std.Fs.ReadText(SaveGamePath(World)).Unwrap());
  AssertEquals(LevelText, Std.Fs.ReadText(LevelPath(World)).Unwrap());
  // Missing referenced level: a world-data failure that keeps the save and never regenerates.
  AssertTrue(Std.Fs.DeleteFile(LevelPath(World)).Unwrap());
  AssertEquals('level-missing', LoadClass(LoadSaveGame(World)));
  AssertEquals(SaveText, Std.Fs.ReadText(SaveGamePath(World)).Unwrap());
  AssertFalse(Std.Fs.Exists(LevelPath(World)));
  AssertEquals('level-missing', WriteClass(WriteSaveGame(World, Outside)));
  AssertEquals(SaveText, Std.Fs.ReadText(SaveGamePath(World)).Unwrap());
  // Invalid referenced level: reported, never repaired, and the save is kept.
  const Broken: string := LevelText.Replace('"level":0', '"level":1');
  AssertTrue(Std.Fs.WriteTextAtomic(LevelPath(World), Broken).Unwrap());
  AssertEquals('level-invalid', LoadClass(LoadSaveGame(World)));
  AssertEquals(SaveText, Std.Fs.ReadText(SaveGamePath(World)).Unwrap());
  AssertEquals(Broken, Std.Fs.ReadText(LevelPath(World)).Unwrap());
  // A level path that cannot be read is an I/O failure of the level.
  AssertTrue(Std.Fs.DeleteFile(LevelPath(World)).Unwrap());
  AssertTrue(Std.Fs.CreateDirAll(LevelPath(World)).Unwrap());
  AssertEquals('level-io', LoadClass(LoadSaveGame(World)));
  AssertEquals('level-io', WriteClass(WriteSaveGame(World, Outside)));
  AssertEquals(SaveText, Std.Fs.ReadText(SaveGamePath(World)).Unwrap());
  // Restore the level; invalid save content is classified and preserved.
  const RestoreRoot: string := Std.Path.Join([Root, 'restore']);
  const Fresh: WorldSession := OpenWorld(RestoreRoot, 'failures', 24680, 4, 16).Unwrap();
  const FreshMap: InteriorMap := SpawnLevel(Fresh);
  const FreshOutside: GameState := LeaveLevel(Fresh, EnterSpawnLevel(Fresh, NewGame(Fresh.Metadata))
                                                       .Unwrap() with Player := PlayerPosition.FirstPerson(FirstPersonPose(Position := FreshMap.Exit, Facing := FreshMap.StartFacing)); end with, FreshMap)
                                     .Unwrap();
  var OnWall: GameState := FreshOutside;
  OnWall.Items[0] := OnWall.Items[0] with Location := ItemLocation.InInterior(FreshMap.AreaId, InteriorPosition(X := 0, Y := 0)); end with;

  AssertEquals('invalid-state', WriteClass(WriteSaveGame(Fresh, OnWall)));
  AssertFalse(Std.Fs.Exists(SaveGamePath(Fresh)));
  AssertEquals('written', WriteClass(WriteSaveGame(Fresh, FreshOutside)));
  const FreshSave: string := Std.Fs.ReadText(SaveGamePath(Fresh)).Unwrap();
  AssertEquals('invalid-state', WriteClass(WriteSaveGame(Fresh, OnWall)));
  AssertEquals(FreshSave, Std.Fs.ReadText(SaveGamePath(Fresh)).Unwrap());
  const FreshLevel: string := Std.Fs.ReadText(LevelPath(Fresh)).Unwrap();
  const ItemField: InteriorPosition := FreshMap.Items[0].Position;
  const ItemJson: string := (('"x":' + IntToStr(ItemField.X)) + ',"y":') + IntToStr(ItemField.Y);
  AssertTrue(FreshSave.Contains(ItemJson));
  AssertTrue(Std.Fs.WriteTextAtomic(SaveGamePath(Fresh), FreshSave.Replace(ItemJson, '"x":0,"y":0'))
               .Unwrap());
  AssertEquals('invalid', LoadClass(LoadSaveGame(Fresh)));
  AssertEquals(FreshSave.Replace(ItemJson, '"x":0,"y":0'), Std.Fs.ReadText(SaveGamePath(Fresh))
                                                             .Unwrap());
  AssertTrue(DeleteSaveGame(Fresh).Unwrap());
  AssertEquals(FreshLevel, Std.Fs.ReadText(LevelPath(Fresh)).Unwrap());
  // An unreadable save is an I/O failure; a blocked save directory makes writing fail the same way.
  AssertTrue(Std.Fs.CreateDirAll(SaveGamePath(Fresh)).Unwrap());
  AssertEquals('io', LoadClass(LoadSaveGame(Fresh)));
  AssertTrue(Std.Fs.Exists(SaveGamePath(Fresh)));
  const Blocked: WorldSession := OpenWorld(Std.Path.Join([Root, 'blocked']), 'failures', 24680, 4, 16)
                                   .Unwrap();
  AssertTrue(Std.Fs.WriteTextAtomic(Std.Path.Join([Blocked.Directory, 'saves']), 'not a directory')
               .Unwrap());
  AssertEquals('io', WriteClass(WriteSaveGame(Blocked, NewGame(Blocked.Metadata))));
  AssertEquals('not a directory', Std.Fs.ReadText(Std.Path.Join([Blocked.Directory, 'saves']))
                                    .Unwrap());
  // An older save that never visited an existing level loads unvisited and reuses the file on entry.
  const Older: WorldSession := OpenWorld(Std.Path.Join([Root, 'older']), 'failures', 24680, 4, 16)
                                 .Unwrap();
  AssertEquals('written', WriteClass(WriteSaveGame(Older, NewGame(Older.Metadata))));
  const OlderMap: InteriorMap := SpawnLevel(Older);
  const OlderLevel: string := Std.Fs.ReadText(LevelPath(Older)).Unwrap();
  if LoadSaveGame(Older).Unwrap() is SaveGameLoad.Loaded(const State, const View) then
    begin
      AssertEquals(0, State.VisitedAreas.Length());
      AssertEquals(0, State.Items.Length());
      const Again: GameState := EnterSpawnLevel(Older, State).Unwrap();
      AssertEquals(OlderMap.Items.Length(), Again.Items.Length());
      AssertEquals(OlderMap.Hostiles.Length(), Again.Hostiles.Length());
    end;
  else
    begin
      panic('expected the older save to load');
    end;
  end if;

  AssertEquals(OlderLevel, Std.Fs.ReadText(LevelPath(Older)).Unwrap());
end.
