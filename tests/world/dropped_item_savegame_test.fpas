// Verifies that a dropped item is saved at its new field without duplicating its placement.
program DroppedItemSavegameTest;

uses
  Dungeon.Coordinates, Dungeon.Equipment, Dungeon.GameState, Dungeon.Interior, Dungeon.Items,
  Dungeon.Test.Fixtures, Dungeon.Test.Levels, Dungeon.Terrain, Dungeon.World, Dungeon.World.Savegame,
  Std.Conv, Std.Test, Std.Time;

begin
  const Root: string := '.temp-data/dropped-item-save-test-' + IntToStr(TimestampMillis());
  const World: WorldSession := OpenWorld(Root, 'dropped', 12345, 4, 16).Unwrap();
  const Metadata: WorldMetadata := World.Metadata;
  const Map: InteriorMap := SpawnLevel(World);
  const Outside: GameState := NewGame(Metadata) with Player := PlayerPosition.Outdoor(Metadata.SpawnEntrance); end with;
  const Entered: GameState := EnterSpawnLevel(World, Outside).Unwrap();
  const CoinId: string := FixtureCoinId(Metadata);
  var Carrying: GameState := Entered;
  Carrying.Items[0] := Carrying.Items[0] with Location := ItemLocation.CarriedByPlayer; end with;
  // The entry field is an ordinary floor field, so the coin can be laid down there.
  const Change: EquipmentChange := DropItem(LevelView(World, Carrying, Map), Carrying, CoinId)
                                     .Unwrap();
  AssertTrue(WriteSaveGame(World, Change.State).Unwrap());
  if LoadSaveGame(World).Unwrap() is SaveGameLoad.Loaded(const Loaded, const View) then
    begin
      AssertTrue(ValidateGameState(View, Loaded).IsOk());
      AssertEquals(3, Loaded.Items.Length());
      AssertEquals(0, InventoryItems(Loaded).Length());
      AssertTrue(Loaded.Items[0] = Change.State.Items[0]);
      if Loaded.Items[0].Location is ItemLocation.InInterior(const AreaId, const Position) then
        begin
          AssertEquals(Map.AreaId, AreaId);
          AssertEquals(Map.Start.X, Position.X);
          AssertEquals(Map.Start.Y, Position.Y);
        end;
      else
        begin
          panic('expected the coin on the floor at the entry field');
        end;
      end if;
    end;
  else
    begin
      panic('expected the dropped item to load');
    end;
  end if;
  // A floor item may never lie on the exit, even in a hand-edited save.
  var OnExit: GameState := Change.State;
  OnExit.Items[0] := OnExit.Items[0] with Location := ItemLocation.InInterior(Map.AreaId, Map.Exit); end with;

  AssertTrue(WriteSaveGame(World, OnExit).IsError());
end.
