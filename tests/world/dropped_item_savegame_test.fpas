// Verifies that a dropped item is saved at its new field without duplicating its placement.
program DroppedItemSavegameTest;

uses Dungeon.Coordinates as Coordinates, Dungeon.Equipment as Equipment, Dungeon.GameState as GameState, Dungeon.Interior as Interior, Dungeon.Items as Items, Dungeon.Test.Fixtures as Fixtures, Dungeon.Test.Levels as Levels, Dungeon.Terrain as Terrain, Dungeon.World as WorldUnit, Dungeon.World.Savegame as Savegame, Std.Conv as Conv, Std.Test as Test, Std.Time as Time;

begin
  const Root: string := '.temp-data/dropped-item-save-test-' +
    Conv.IntToStr(Time.TimestampMillis());
  const World: WorldUnit.WorldSession := WorldUnit.OpenWorld(
    Root,
    'dropped',
    12345,
    4,
    16
  ).Unwrap();
  const Metadata: Terrain.WorldMetadata := World.Metadata;
  const Map: Interior.InteriorMap := Levels.SpawnLevel(World);
  const Outside: GameState.GameState := GameState.NewGame(Metadata) with Player := Coordinates.PlayerPosition.Outdoor(
    Metadata.SpawnEntrance
  ); end with;
  const Entered: GameState.GameState := Levels.EnterSpawnLevel(World, Outside).Unwrap();
  const CoinId: string := Fixtures.FixtureCoinId(Metadata);
  var Carrying: GameState.GameState := Entered;
  Carrying.Items[0] := Carrying.Items[0] with Location := Items.ItemLocation.CarriedByPlayer; end with;
  // The entry field is an ordinary floor field, so the coin can be laid down there.
  const Change: Equipment.EquipmentChange := Equipment.DropItem(
    Levels.LevelView(World, Carrying, Map),
    Carrying,
    CoinId
  ).Unwrap();
  Test.AssertTrue(Savegame.WriteSaveGame(World, Change.State).Unwrap());
  case Savegame.LoadSaveGame(World).Unwrap() of
    when Savegame.SaveGameLoad.Loaded(const Loaded, const View):
      Test.AssertTrue((GameState.ValidateGameState(View, Loaded) is Ok(_)));
      Test.AssertEquals(3, Loaded.Items.Length());
      Test.AssertEquals(0, GameState.InventoryItems(Loaded).Length());
      Test.AssertTrue(Loaded.Items[0] = Change.State.Items[0]);
      case Loaded.Items[0].Location of
        when Items.ItemLocation.InInterior(const AreaId, const Position):
          Test.AssertEquals(Map.AreaId, AreaId);
          Test.AssertEquals(Map.Start.X, Position.X);
          Test.AssertEquals(Map.Start.Y, Position.Y);
        when Items.ItemLocation.CarriedByPlayer, Items.ItemLocation.EquippedByPlayer(_):
          panic('expected the coin on the floor at the entry field');
      end case;
    when Savegame.SaveGameLoad.Missing, Savegame.SaveGameLoad.Invalid(_):
      panic('expected the dropped item to load');
  end case;
  // A floor item may never lie on the exit, even in a hand-edited save.
  var OnExit: GameState.GameState := Change.State;
  OnExit.Items[0] := OnExit.Items[0] with Location := Items.ItemLocation.InInterior(
    Map.AreaId,
    Map.Exit
  ); end with;

  Test.AssertTrue((Savegame.WriteSaveGame(World, OnExit) is Error(_)));
end.
