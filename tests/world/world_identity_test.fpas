// Lists only canonical directory identities in stable order without opening or creating world content.
program WorldIdentityTest;

uses Dungeon.World.Catalog as Catalog, Std.Text.Format as Conv, Std.Io.Fs as Fs, Std.Test as Test, Std.Time as Time;

begin
  const Root := '.temp-data/world-identities-' + Conv.IntToStr(Time.TimestampMillis());
  Test.AssertTrue(Catalog.ListWorldIds(Root) is Error(_));
  Test.AssertFalse(Fs.Exists(Root));
  discard Fs.CreateDirAll(Root).Unwrap();
  Test.AssertEquals(0, Catalog.ListWorldIds(Root).Unwrap().Length());
  for Id: string in ['z', 'a', 'b', 'invalid name'] do
    discard Fs.CreateDirAll(Root + '/' + Id).Unwrap();
  end for;

  discard Fs.WriteTextAtomic(Root + '/ordinary-file', 'keep').Unwrap();
  discard Fs.WriteTextAtomic(Root + '/a/world.json', '{').Unwrap();
  discard Fs.CreateDirAll(Root + '/b/world.json').Unwrap();
  discard Fs.CreateDirAll(Root + '/b/saves/default.json').Unwrap();
  for Attempt: integer := 1 to 2 do
    const Ids := Catalog.ListWorldIds(Root).Unwrap();
    Test.AssertEquals(3, Ids.Length());
    Test.AssertEquals('a', Ids[0]);
    Test.AssertEquals('b', Ids[1]);
    Test.AssertEquals('z', Ids[2]);
    Test.AssertEquals('{', Fs.ReadText(Root + '/a/world.json').Unwrap());
    Test.AssertTrue(Fs.IsDir(Root + '/b/world.json'));
    Test.AssertTrue(Fs.IsDir(Root + '/b/saves/default.json'));
    Test.AssertFalse(Fs.Exists(Root + '/z/world.json'));
    Test.AssertFalse(Fs.Exists(Root + '/z/chunks'));
  end for;

  Test.AssertTrue(Catalog.ListWorldIds(Root + '/ordinary-file') is Error(_));
  Test.AssertEquals('keep', Fs.ReadText(Root + '/ordinary-file').Unwrap());
end.
