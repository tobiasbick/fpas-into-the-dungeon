// Verifies versioned outdoor and first-person savegame persistence.
program DungeonSaveGameTest;

uses
  Dungeon.Exploration, Dungeon.Exploration.Model, Dungeon.Game, Dungeon.World,
  Dungeon.World.Savegame, Std.Arrays, Std.Conv, Std.Fs, Std.Path, Std.Results, Std.Str, Std.Test,
  Std.Time;

function RequireLoaded(Value: SaveGameLoad): GameState;
begin
  case Value of
    SaveGameLoad.Loaded(State):
    begin
      return State
    end
    else
    begin
      panic('expected a loaded savegame')
    end
  end
end;

procedure AssertInvalidSaveIsRemoved(World: WorldSession; Text: string);
begin
  AssertTrue(Std.Results.Unwrap(Std.Fs.WriteTextAtomic(SaveGamePath(World), Text)));
  case Std.Results.Unwrap(LoadSaveGame(World)) of
    SaveGameLoad.InvalidRemoved(Reason):
    begin
      AssertFalse(Reason = '')
    end
    else
    begin
      panic('expected invalid savegame to be removed')
    end
  end;

  AssertFalse(Std.Fs.Exists(SaveGamePath(World)))
end;

begin
  var Root: string := '.temp-data/savegame-test-' + IntToStr(TimestampMillis());
  if not Std.Fs.Exists('.temp-data') then
  begin
    AssertTrue(Std.Results.Unwrap(Std.Fs.CreateDir('.temp-data')))
  end;
  mutable var World: WorldSession := Std.Results.Unwrap(OpenWorld(Root, 'saves', 24680, 16));
  AssertTrue(SaveGamePath(World) = Std.Path.Join([World.Directory, 'saves', 'default.json']));
  case Std.Results.Unwrap(LoadSaveGame(World)) of
    SaveGameLoad.Missing:
    begin
    end
    else
    begin
      panic('new world must not contain a savegame')
    end
  end;
  mutable var OutdoorDiscovery: ExplorationState := RevealOutdoor(RevealOutdoor(RevealOutdoor(EmptyExploration(), record
    X := -1;
    Y := -1;
  end), record
    X := 129;
    Y := 129;
  end), record
    X := -321;
    Y := 654;
  end);
  // Tangent chunk corners must survive the same save/load path as normal exploration.
  for Coordinate: integer in [7, 120, -8, -121] do
  begin
    OutdoorDiscovery := RevealOutdoor(OutdoorDiscovery, record
      X := Coordinate;
      Y := Coordinate;
    end)
  end;
  var Outdoor: GameState := record
    Area := AreaKind.OutdoorRegion;
    AreaId := World.Metadata.OutdoorAreaId;
    Player := PlayerPosition.Outdoor(record
    X := -321;
    Y := 654;
  end);
    ReturnLocation := ReturnLocation.NoReturnLocation;
    Exploration := OutdoorDiscovery;
    Items := NewGame(World.Metadata).Items;
  end;

  AssertTrue(Std.Results.Unwrap(WriteSaveGame(World, Outdoor)));
  var EncodedOutdoor: string := Std.Results.Unwrap(Std.Fs.ReadText(SaveGamePath(World)));
  AssertFalse(Std.Str.Contains(EncodedOutdoor, 'viewport'));
  AssertFalse(Std.Str.Contains(EncodedOutdoor, 'status'));
  AssertTrue(Std.Str.Contains(EncodedOutdoor, '"exploration"'));
  AssertTrue(Std.Str.Contains(EncodedOutdoor, '"rows"'));
  AssertTrue(Std.Str.Contains(EncodedOutdoor, '"items"'));
  var LoadedOutdoor: GameState := RequireLoaded(Std.Results.Unwrap(LoadSaveGame(World)));
  AssertTrue(LoadedOutdoor.Area = AreaKind.OutdoorRegion);
  AssertEquals(World.Metadata.OutdoorAreaId, LoadedOutdoor.AreaId);
  AssertEquals(-321, Std.Results.Unwrap(OutdoorPlayerPosition(LoadedOutdoor)).X);
  AssertEquals(654, Std.Results.Unwrap(OutdoorPlayerPosition(LoadedOutdoor)).Y);
  AssertTrue(OutdoorIsDiscovered(LoadedOutdoor.Exploration, -321, 654));
  AssertTrue(OutdoorIsDiscovered(LoadedOutdoor.Exploration, -1, -1));
  AssertTrue(OutdoorIsDiscovered(LoadedOutdoor.Exploration, 129, 129));
  AssertTrue(Std.Arrays.Length(LoadedOutdoor.Exploration.OutdoorChunks) > 0);
  AssertEquals(0, Std.Arrays.Length(InventoryItems(LoadedOutdoor)));
  for Coordinate: integer in [7, 120, -8, -121] do
  begin
    AssertTrue(OutdoorIsDiscovered(LoadedOutdoor.Exploration, Coordinate, Coordinate))
  end;
  mutable var Interior: GameState := Std.Results.Unwrap(ActivateAreaTransition(World.Metadata, record
    Area := AreaKind.OutdoorRegion;
    AreaId := World.Metadata.OutdoorAreaId;
    Player := PlayerPosition.Outdoor(World.Metadata.Entrance);
    ReturnLocation := ReturnLocation.NoReturnLocation;
    Exploration := Outdoor.Exploration;
    Items := Outdoor.Items;
  end));
  Interior := Std.Results.Unwrap(StepFirstPerson(World.Metadata, Interior, RelativeStep.Forward));
  case Std.Results.Unwrap(Interact(World.Metadata, Interior)) of
    InteractionOutcome.StateChanged(Changed):
    begin
      Interior := Changed
    end
    else
    begin
      panic('expected the dungeon item to be collected before saving')
    end
  end;
  Interior := Std.Results.Unwrap(TurnFirstPerson(World.Metadata, Interior, RelativeTurn.TurnRight));
  var InteriorMapValue: InteriorMap := Std.Results.Unwrap(InitialDungeonMap());
  Interior.Exploration := Std.Results.Unwrap(RevealInterior(Interior.Exploration, Interior.AreaId, InteriorMapValue, Std.Results.Unwrap(FirstPersonPlayerPose(Interior))));
  AssertTrue(Std.Results.Unwrap(WriteSaveGame(World, Interior)));
  var LoadedInterior: GameState := RequireLoaded(Std.Results.Unwrap(LoadSaveGame(World)));
  AssertTrue(LoadedInterior.Area = AreaKind.Dungeon);
  AssertEquals(World.Metadata.DungeonAreaId, LoadedInterior.AreaId);
  var Pose: FirstPersonPose := Std.Results.Unwrap(FirstPersonPlayerPose(LoadedInterior));
  AssertEquals(8, Pose.Position.X);
  AssertEquals(1, Pose.Position.Y);
  AssertTrue(Pose.Facing = FacingDirection.North);
  AssertEquals(1, Std.Arrays.Length(InventoryItems(LoadedInterior)));
  AssertEquals(InitialDungeonItemId, InventoryItems(LoadedInterior)[0].Id);
  AssertTrue(InteriorIsDiscovered(LoadedInterior.Exploration, LoadedInterior.AreaId, InteriorMapValue.Width, Pose.Position.X, Pose.Position.Y));
  case LoadedInterior.ReturnLocation of
    ReturnLocation.ReturnTo(AreaId, Position):
    begin
      AssertEquals(World.Metadata.OutdoorAreaId, AreaId);
      AssertEquals(World.Metadata.Entrance.X, Position.X);
      AssertEquals(World.Metadata.Entrance.Y, Position.Y)
    end
    else
    begin
      panic('loaded interior must retain its outdoor return location')
    end
  end;
  var InvalidState: GameState := record
    Area := AreaKind.OutdoorRegion;
    AreaId := World.Metadata.DungeonAreaId;
    Player := PlayerPosition.Outdoor(record
    X := 1;
    Y := 2;
  end);
    ReturnLocation := ReturnLocation.NoReturnLocation;
    Exploration := EmptyExploration();
    Items := NewGame(World.Metadata).Items;
  end;

  AssertTrue(Std.Results.IsError(WriteSaveGame(World, InvalidState)));
  var PreservedInterior: GameState := RequireLoaded(Std.Results.Unwrap(LoadSaveGame(World)));
  AssertTrue(PreservedInterior.Area = AreaKind.Dungeon);
  AssertTrue(Std.Results.Unwrap(FirstPersonPlayerPose(PreservedInterior)).Facing =
             FacingDirection.North);
  AssertTrue(InteriorIsDiscovered(PreservedInterior.Exploration, World.Metadata.DungeonAreaId, InteriorMapValue.Width, 8, 1));
  AssertEquals(1, Std.Arrays.Length(InventoryItems(PreservedInterior)));
  var EmptyCurrentSave: string := '{"format_version":3,"world_id":"saves","area_kind":"outdoor_region","area_id":"saves:outdoor","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none"},"exploration":{"outdoor_chunks":[],"interior_areas":[]},"items":[{"id":"initial-dungeon:ancient-coin","kind":"ancient_coin","location":{"kind":"interior","area_id":"saves:dungeon:initial","x":8,"y":1}}]}';
  AssertTrue(Std.Results.IsOk(DecodeSaveGame(EmptyCurrentSave, World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame(Std.Str.Replace(EmptyCurrentSave, '"interior_areas":[]', '"interior_areas":[],"extra":1'), World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame(Std.Str.Replace(EmptyCurrentSave, '"outdoor_chunks":[]', '"outdoor_chunks":[],"outdoor_chunks":[]'), World.Metadata)));
  var InitialItemJson: string := '{"id":"initial-dungeon:ancient-coin","kind":"ancient_coin","location":{"kind":"interior","area_id":"saves:dungeon:initial","x":8,"y":1}}';
  AssertTrue(Std.Results.IsError(DecodeSaveGame(Std.Str.Replace(EmptyCurrentSave, '"items":[' + InitialItemJson + ']', '"items":[]'), World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame(Std.Str.Replace(EmptyCurrentSave, '"items":[' + InitialItemJson + ']', '"items":[' + InitialItemJson + ',' + InitialItemJson + ']'), World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame(Std.Str.Replace(EmptyCurrentSave, '"ancient_coin"', '"unknown"'), World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame(Std.Str.Replace(EmptyCurrentSave, InitialDungeonItemId, 'unknown:item'), World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame(Std.Str.Replace(EmptyCurrentSave, '"area_id":"saves:dungeon:initial"', '"area_id":"saves:outdoor"'), World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame(Std.Str.Replace(EmptyCurrentSave, '"x":8,"y":1', '"x":7,"y":1'), World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame(Std.Str.Replace(EmptyCurrentSave, '"x":8,"y":1', '"x":8.5,"y":1'), World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame(Std.Str.Replace(EmptyCurrentSave, '"y":1}}]}', '"y":1,"extra":1}}]}'), World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame(Std.Str.Replace(EmptyCurrentSave, InitialItemJson, '42'), World.Metadata)));
  AssertTrue(Std.Results.IsOk(DecodeSaveGame(EncodeSaveGame(World.Metadata.Id, LoadedInterior), World.Metadata)));
  var LegacySave: string := '{"format_version":2,"world_id":"saves","area_kind":"outdoor_region","area_id":"saves:outdoor","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none"},"exploration":{"outdoor_chunks":[],"interior_areas":[]}}';
  AssertTrue(Std.Results.IsError(DecodeSaveGame(LegacySave, World.Metadata)));
  mutable var DuplicateDiscovery: GameState := Outdoor;
  DuplicateDiscovery.Exploration.OutdoorChunks := [
                                                    Outdoor.Exploration.OutdoorChunks[0],
                                                    Outdoor.Exploration.OutdoorChunks[0]
                                                  ];
  AssertTrue(Std.Results.IsError(DecodeSaveGame(EncodeSaveGame(World.Metadata.Id, DuplicateDiscovery), World.Metadata)));
  mutable var WrongMaskDiscovery: GameState := Outdoor;
  mutable var WrongMaskChunk: OutdoorDiscoveryChunk := WrongMaskDiscovery.Exploration.OutdoorChunks[0];
  WrongMaskChunk.Fields := [true];
  WrongMaskDiscovery.Exploration.OutdoorChunks := [WrongMaskChunk];
  AssertTrue(Std.Results.IsError(WriteSaveGame(World, WrongMaskDiscovery)));
  mutable var UnorderedDiscovery: GameState := Outdoor;
  var OutdoorCount: integer := Std.Arrays.Length(Outdoor.Exploration.OutdoorChunks);
  UnorderedDiscovery.Exploration.OutdoorChunks := [
                                                    Outdoor.Exploration.OutdoorChunks[OutdoorCount - 1],
                                                    Outdoor.Exploration.OutdoorChunks[0]
                                                  ];
  AssertTrue(Std.Results.IsError(DecodeSaveGame(EncodeSaveGame(World.Metadata.Id, UnorderedDiscovery), World.Metadata)));
  var InvalidAlphabet: string := Std.Str.Replace(EncodedOutdoor, '00000000', 'q0000000');
  AssertTrue(Std.Results.IsError(DecodeSaveGame(InvalidAlphabet, World.Metadata)));
  var InvalidWidth: string := Std.Str.Replace(EncodedOutdoor, '00000000', '0000000');
  AssertTrue(Std.Results.IsError(DecodeSaveGame(InvalidWidth, World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame('{', World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame('{"format_version":1,"format_version":1,"world_id":"saves","area_kind":"outdoor_region","area_id":"saves:outdoor","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none"}}', World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame('{"format_version":1}', World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame('{"format_version":2,"world_id":"saves","area_kind":"outdoor_region","area_id":"saves:outdoor","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none"}}', World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame('{"format_version":1,"world_id":"other","area_kind":"outdoor_region","area_id":"saves:outdoor","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none"}}', World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame('{"format_version":1,"world_id":"saves","area_kind":"outdoor_region","area_id":"saves:outdoor","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none"},"extra":1}', World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame('{"format_version":1,"world_id":"saves","area_kind":"outdoor_region","area_id":"saves:outdoor","player":{"kind":"outdoor","x":0,"y":0,"extra":1},"return_location":{"kind":"none"}}', World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame('{"format_version":1,"world_id":"saves","area_kind":"outdoor_region","area_id":"saves:outdoor","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none","extra":1}}', World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame('{"format_version":1,"world_id":"saves","area_kind":"unknown","area_id":"saves:outdoor","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none"}}', World.Metadata)));
  AssertTrue(Std.Results.IsError(DecodeSaveGame('{"format_version":1,"world_id":"saves","area_kind":"dungeon","area_id":"saves:dungeon:initial","player":{"kind":"first_person","x":0,"y":0,"facing":"north"},"return_location":{"kind":"none"}}', World.Metadata)));
  var MetadataPath: string := Std.Path.Join([World.Directory, 'world.json']);
  var MetadataBefore: string := Std.Results.Unwrap(Std.Fs.ReadText(MetadataPath));
  var StoredChunk: ChunkLoad := Std.Results.Unwrap(LoadWorldChunk(World, record
    X := 7;
    Y := -3;
  end));
  World := StoredChunk.World;
  var StoredChunkPath: string := WorldChunkPath(World, record
    X := 7;
    Y := -3;
  end);
  var StoredChunkBefore: string := Std.Results.Unwrap(Std.Fs.ReadText(StoredChunkPath));
  var UnrelatedPath: string := Std.Path.Join([World.Directory, 'saves', 'keep.txt']);
  AssertTrue(Std.Results.Unwrap(Std.Fs.WriteTextAtomic(UnrelatedPath, 'keep')));
  AssertInvalidSaveIsRemoved(World, '{');
  AssertInvalidSaveIsRemoved(World, '{"format_version":1}');
  AssertInvalidSaveIsRemoved(World, LegacySave);
  AssertInvalidSaveIsRemoved(World, '{"format_version":2,"world_id":"saves","area_kind":"outdoor_region","area_id":"saves:outdoor","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none"}}');
  AssertInvalidSaveIsRemoved(World, '{"format_version":1,"world_id":"other","area_kind":"outdoor_region","area_id":"saves:outdoor","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none"}}');
  AssertInvalidSaveIsRemoved(World, '{"format_version":1,"world_id":"saves","area_kind":"outdoor_region","area_id":"saves:outdoor","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none"},"extra":1}');
  AssertInvalidSaveIsRemoved(World, '{"format_version":1,"world_id":"saves","area_kind":"unknown","area_id":"saves:outdoor","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none"}}');
  AssertInvalidSaveIsRemoved(World, '{"format_version":1,"world_id":"saves","area_kind":"outdoor_region","area_id":"saves:dungeon:initial","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none"}}');
  AssertInvalidSaveIsRemoved(World, '{"format_version":1,"format_version":1,"world_id":"saves","area_kind":"outdoor_region","area_id":"saves:outdoor","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none"}}');
  AssertEquals(MetadataBefore, Std.Results.Unwrap(Std.Fs.ReadText(MetadataPath)));
  AssertEquals(StoredChunkBefore, Std.Results.Unwrap(Std.Fs.ReadText(StoredChunkPath)));
  AssertEquals('keep', Std.Results.Unwrap(Std.Fs.ReadText(UnrelatedPath)));
  AssertFalse(Std.Results.Unwrap(DeleteSaveGame(World)));
  AssertTrue(Std.Results.Unwrap(WriteSaveGame(World, Outdoor)));
  mutable var Replacement: GameState := Outdoor;
  Replacement.Exploration := RevealOutdoor(EmptyExploration(), record
    X := 500;
    Y := -500;
  end);
  AssertTrue(Std.Results.Unwrap(WriteSaveGame(World, Replacement)));
  var Replaced: GameState := RequireLoaded(Std.Results.Unwrap(LoadSaveGame(World)));
  AssertFalse(OutdoorIsDiscovered(Replaced.Exploration, -1, -1));
  AssertTrue(OutdoorIsDiscovered(Replaced.Exploration, 500, -500));
  AssertTrue(Std.Results.Unwrap(DeleteSaveGame(World)));
  AssertFalse(Std.Fs.Exists(SaveGamePath(World)))
end.
