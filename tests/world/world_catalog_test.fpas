// Verifies non-destructive world listing, exclusive creation, parameters, and failures.
program WorldCatalogTest;

uses Dungeon.GameState as GameState, Dungeon.World as World, Dungeon.World.Catalog as Catalog, Dungeon.World.Savegame as Savegame, Std.Conv as Conv, Std.Fs as Fs, Std.Path as Path, Std.Test as Test, Std.Time as Time;

begin
  const Root: string := Path.Join([
    '.temp-data',
    'catalog-' + Conv.IntToStr(Time.TimestampMillis())
  ]);
  Test.AssertTrue(Fs.CreateDirAll(Root).Unwrap());
  Test.AssertEquals(0, Catalog.ListWorlds(Root, 16).Unwrap().Length());
  Test.AssertTrue((Catalog.OpenExistingWorld(Root, 'absent', 16) is Error(_)));
  Test.AssertFalse(Fs.Exists(Path.Join([Root, 'absent'])));
  for Id: string in ['', '..', '../outside', 'a/b', 'a\b', 'x'.RepeatStr(65)] do
    begin
      Test.AssertTrue((Catalog.OpenExistingWorld(Root, Id, 16) is Error(_)));
    end;
  end for;

  for Region: integer in [0, 17] do
    begin
      Test.AssertTrue((Catalog.CreateWorld(Root, 1, Region, 16) is Error(_)));
    end;
  end for;

  for Seed: integer in [Catalog.MinimumWorldSeed - 1, Catalog.MaximumWorldSeed + 1] do
    begin
      Test.AssertTrue((Catalog.CreateWorld(Root, Seed, 4, 16) is Error(_)));
    end;
  end for;

  Test.AssertEquals(0, Catalog.ListWorlds(Root, 16).Unwrap().Length());
  const First: World.WorldSession := Catalog.CreateWorld(Root, 12345, 1, 16).Unwrap();
  const Second: World.WorldSession := Catalog.CreateWorld(Root, 12345, 16, 16).Unwrap();
  Test.AssertTrue(First.Metadata.Id <> Second.Metadata.Id);
  Test.AssertEquals(12345, Second.Metadata.Seed);
  Test.AssertEquals(16, Second.Metadata.DungeonRegionChunks);
  const Before: string := Fs.ReadText(World.WorldMetadataPath(First)).Unwrap();
  const Again: World.WorldSession := Catalog.OpenExistingWorld(
    Root,
    First.Metadata.Id,
    16
  ).Unwrap();
  Test.AssertTrue(First.Metadata = Again.Metadata);
  Test.AssertEquals('missing', Catalog.InspectWorld(Root, First.Metadata.Id, 16).SaveStatus);
  Test.AssertTrue(Savegame.WriteSaveGame(First, GameState.NewGame(First.Metadata)).Unwrap());
  Test.AssertEquals('available', Catalog.InspectWorld(Root, First.Metadata.Id, 16).SaveStatus);
  Test.AssertTrue(Fs.WriteTextAtomic(Savegame.SaveGamePath(First), '{').Unwrap());
  Test.AssertEquals('incompatible', Catalog.InspectWorld(Root, First.Metadata.Id, 16).SaveStatus);
  Test.AssertEquals('{', Fs.ReadText(Savegame.SaveGamePath(First)).Unwrap());
  Test.AssertEquals(Before, Fs.ReadText(World.WorldMetadataPath(First)).Unwrap());
  Test.AssertTrue(
    Fs.WriteTextAtomic(
      World.WorldMetadataPath(Second),
      Fs.ReadText(
        World.WorldMetadataPath(Second)
      ).Unwrap().Replace('"generator_version":6', '"generator_version":0')
    ).Unwrap()
  );
  Test.AssertEquals('incompatible', Catalog.InspectWorld(Root, Second.Metadata.Id, 16).Status);
  Test.AssertEquals(2, Catalog.ListWorlds(Root, 16).Unwrap().Length());
  // Occupied identities, including non-world files, must never be reused.
  Test.AssertTrue(Fs.WriteTextAtomic(Path.Join([Root, 'world-3']), 'keep').Unwrap());
  const Third: World.WorldSession := Catalog.CreateWorld(
    Root,
    Catalog.MinimumWorldSeed,
    4,
    16
  ).Unwrap();
  Test.AssertEquals('world-4', Third.Metadata.Id);
  Test.AssertEquals(
    Catalog.MinimumWorldSeed,
    Catalog.OpenExistingWorld(Root, Third.Metadata.Id, 16).Unwrap().Metadata.Seed
  );
  const Maximum: World.WorldSession := Catalog.CreateWorld(
    Root,
    Catalog.MaximumWorldSeed,
    4,
    16
  ).Unwrap();
  Test.AssertEquals(
    Catalog.MaximumWorldSeed,
    Catalog.OpenExistingWorld(Root, Maximum.Metadata.Id, 16).Unwrap().Metadata.Seed
  );
  const Broken: string := Path.Join([Root, 'broken']);
  Test.AssertTrue(Fs.CreateDirAll(Path.Join([Broken, 'world.json'])).Unwrap());
  Test.AssertEquals('storage_error', Catalog.InspectWorld(Root, 'broken', 16).Status);
  Test.AssertTrue((Catalog.ListWorlds(Path.Join([Root, 'world-3']), 16) is Error(_)));
  Test.AssertTrue((Catalog.CreateWorld(Path.Join([Root, 'world-3']), 1, 4, 16) is Error(_)));
end.
