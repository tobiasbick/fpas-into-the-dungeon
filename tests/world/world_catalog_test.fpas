// Verifies non-destructive world listing, exclusive creation, parameters, and failures.
program WorldCatalogTest;

uses
  Dungeon.GameState, Dungeon.World, Dungeon.World.Catalog, Dungeon.World.Savegame, Std.Conv, Std.Fs,
  Std.Path, Std.Test, Std.Time;

begin
  const Root: string := Std.Path.Join(['.temp-data', 'catalog-' + IntToStr(TimestampMillis())]);
  AssertTrue(Std.Fs.CreateDirAll(Root).Unwrap());
  AssertEquals(0, ListWorlds(Root, 16).Unwrap().Length());
  AssertTrue(OpenExistingWorld(Root, 'absent', 16).IsError());
  AssertFalse(Std.Fs.Exists(Std.Path.Join([Root, 'absent'])));
  for Id: string in ['', '..', '../outside', 'a/b', 'a\b', 'x'.RepeatStr(65)] do
    begin
      AssertTrue(OpenExistingWorld(Root, Id, 16).IsError());
    end;
  end for;

  for Region: integer in [0, 17] do
    begin
      AssertTrue(CreateWorld(Root, 1, Region, 16).IsError());
    end;
  end for;

  for Seed: integer in [MinimumWorldSeed - 1, MaximumWorldSeed + 1] do
    begin
      AssertTrue(CreateWorld(Root, Seed, 4, 16).IsError());
    end;
  end for;

  AssertEquals(0, ListWorlds(Root, 16).Unwrap().Length());
  const First: WorldSession := CreateWorld(Root, 12345, 1, 16).Unwrap();
  const Second: WorldSession := CreateWorld(Root, 12345, 16, 16).Unwrap();
  AssertTrue(First.Metadata.Id <> Second.Metadata.Id);
  AssertEquals(12345, Second.Metadata.Seed);
  AssertEquals(16, Second.Metadata.DungeonRegionChunks);
  const Before: string := Std.Fs.ReadText(WorldMetadataPath(First)).Unwrap();
  const Again: WorldSession := OpenExistingWorld(Root, First.Metadata.Id, 16).Unwrap();
  AssertTrue(First.Metadata = Again.Metadata);
  AssertEquals('missing', InspectWorld(Root, First.Metadata.Id, 16).SaveStatus);
  AssertTrue(WriteSaveGame(First, NewGame(First.Metadata)).Unwrap());
  AssertEquals('available', InspectWorld(Root, First.Metadata.Id, 16).SaveStatus);
  AssertTrue(Std.Fs.WriteTextAtomic(SaveGamePath(First), '{').Unwrap());
  AssertEquals('incompatible', InspectWorld(Root, First.Metadata.Id, 16).SaveStatus);
  AssertEquals('{', Std.Fs.ReadText(SaveGamePath(First)).Unwrap());
  AssertEquals(Before, Std.Fs.ReadText(WorldMetadataPath(First)).Unwrap());
  AssertTrue(Std.Fs.WriteTextAtomic(WorldMetadataPath(Second), Std.Fs.ReadText(WorldMetadataPath(Second))
                                                                 .Unwrap()
                                                                 .Replace('"generator_version":6', '"generator_version":0'))
               .Unwrap());
  AssertEquals('incompatible', InspectWorld(Root, Second.Metadata.Id, 16).Status);
  AssertEquals(2, ListWorlds(Root, 16).Unwrap().Length());
  // Occupied identities, including non-world files, must never be reused.
  AssertTrue(Std.Fs.WriteTextAtomic(Std.Path.Join([Root, 'world-3']), 'keep').Unwrap());
  const Third: WorldSession := CreateWorld(Root, MinimumWorldSeed, 4, 16).Unwrap();
  AssertEquals('world-4', Third.Metadata.Id);
  AssertEquals(MinimumWorldSeed, OpenExistingWorld(Root, Third.Metadata.Id, 16)
                                   .Unwrap()
                                   .Metadata
                                   .Seed);
  const Maximum: WorldSession := CreateWorld(Root, MaximumWorldSeed, 4, 16).Unwrap();
  AssertEquals(MaximumWorldSeed, OpenExistingWorld(Root, Maximum.Metadata.Id, 16)
                                   .Unwrap()
                                   .Metadata
                                   .Seed);
  const Broken: string := Std.Path.Join([Root, 'broken']);
  AssertTrue(Std.Fs.CreateDirAll(Std.Path.Join([Broken, 'world.json'])).Unwrap());
  AssertEquals('storage_error', InspectWorld(Root, 'broken', 16).Status);
  AssertTrue(ListWorlds(Std.Path.Join([Root, 'world-3']), 16).IsError());
  AssertTrue(CreateWorld(Std.Path.Join([Root, 'world-3']), 1, 4, 16).IsError());
end.
