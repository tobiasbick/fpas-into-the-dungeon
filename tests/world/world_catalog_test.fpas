// Verifies non-destructive world listing, exclusive creation, parameters, and failures.
program WorldCatalogTest;

uses Dungeon.GameState as GameState, Dungeon.Items as Items, Dungeon.Test.Levels as Levels, Dungeon.Terrain.Entrances as Entrances, Dungeon.World as WorldUnit, Dungeon.World.Catalog as CatalogUnit, Dungeon.World.Savegame as Savegame, Std.Conv as Conv, Std.Fs as Fs, Std.Path as PathOps, Std.Test as Test, Std.Time as Time;

begin
  const Root: string := PathOps.Join([
    '.temp-data',
    'catalog-' + Conv.IntToStr(Time.TimestampMillis())
  ]);
  Test.AssertTrue(Fs.CreateDirAll(Root).Unwrap());
  Test.AssertEquals(0, CatalogUnit.ListWorlds(Root, 16).Unwrap().Length());
  Test.AssertTrue(CatalogUnit.OpenExistingWorld(Root, 'absent', 16) is Error(_));
  Test.AssertFalse(Fs.Exists(PathOps.Join([Root, 'absent'])));
  for Id: string in ['', '..', '../outside', 'a/b', 'a\b', 'x'.RepeatStr(65)] do
    begin
      Test.AssertTrue(CatalogUnit.OpenExistingWorld(Root, Id, 16) is Error(_));
    end;
  end for;

  for Region: integer in [0, 17] do
    begin
      Test.AssertTrue(CatalogUnit.CreateWorld(Root, 1, Region, 16) is Error(_));
    end;
  end for;

  for Seed: integer in [CatalogUnit.MinimumWorldSeed - 1, CatalogUnit.MaximumWorldSeed + 1] do
    begin
      Test.AssertTrue(CatalogUnit.CreateWorld(Root, Seed, 4, 16) is Error(_));
    end;
  end for;

  Test.AssertEquals(0, CatalogUnit.ListWorlds(Root, 16).Unwrap().Length());
  const First: WorldUnit.WorldSession := CatalogUnit.CreateWorld(Root, 12345, 1, 16).Unwrap();
  const Second: WorldUnit.WorldSession := CatalogUnit.CreateWorld(Root, 12345, 16, 16).Unwrap();
  Test.AssertTrue(First.Metadata.Id <> Second.Metadata.Id);
  Test.AssertEquals(12345, Second.Metadata.Seed);
  Test.AssertEquals(16, Second.Metadata.DungeonRegionChunks);
  const Before: string := Fs.ReadText(WorldUnit.WorldMetadataPath(First)).Unwrap();
  const Again: WorldUnit.WorldSession := CatalogUnit.OpenExistingWorld(
    Root,
    First.Metadata.Id,
    16
  ).Unwrap();
  Test.AssertTrue(First.Metadata = Again.Metadata);
  Test.AssertEquals('missing', CatalogUnit.InspectWorld(Root, First.Metadata.Id, 16).SaveStatus);
  Test.AssertTrue(Savegame.WriteSaveGame(First, GameState.NewGame(First.Metadata)).Unwrap());
  Test.AssertEquals('available', CatalogUnit.InspectWorld(Root, First.Metadata.Id, 16).SaveStatus);
  Test.AssertTrue(Fs.WriteTextAtomic(Savegame.SaveGamePath(First), '{').Unwrap());
  Test.AssertEquals(
    'incompatible',
    CatalogUnit.InspectWorld(Root, First.Metadata.Id, 16).SaveStatus
  );
  Test.AssertEquals('{', Fs.ReadText(Savegame.SaveGamePath(First)).Unwrap());
  Test.AssertEquals(Before, Fs.ReadText(WorldUnit.WorldMetadataPath(First)).Unwrap());
  Test.AssertTrue(
    Fs.WriteTextAtomic(
      WorldUnit.WorldMetadataPath(Second),
      Fs.ReadText(
        WorldUnit.WorldMetadataPath(Second)
      ).Unwrap().Replace('"generator_version":9', '"generator_version":0')
    ).Unwrap()
  );
  Test.AssertEquals('incompatible', CatalogUnit.InspectWorld(Root, Second.Metadata.Id, 16).Status);
  Test.AssertEquals(2, CatalogUnit.ListWorlds(Root, 16).Unwrap().Length());
  // Occupied identities, including non-world files, must never be reused.
  Test.AssertTrue(Fs.WriteTextAtomic(PathOps.Join([Root, 'world-3']), 'keep').Unwrap());
  const Third: WorldUnit.WorldSession := CatalogUnit.CreateWorld(
    Root,
    CatalogUnit.MinimumWorldSeed,
    4,
    16
  ).Unwrap();
  Test.AssertEquals('world-4', Third.Metadata.Id);
  Test.AssertEquals(
    CatalogUnit.MinimumWorldSeed,
    CatalogUnit.OpenExistingWorld(Root, Third.Metadata.Id, 16).Unwrap().Metadata.Seed
  );
  const Maximum: WorldUnit.WorldSession := CatalogUnit.CreateWorld(
    Root,
    CatalogUnit.MaximumWorldSeed,
    4,
    16
  ).Unwrap();
  Test.AssertEquals(
    CatalogUnit.MaximumWorldSeed,
    CatalogUnit.OpenExistingWorld(Root, Maximum.Metadata.Id, 16).Unwrap().Metadata.Seed
  );
  const Broken: string := PathOps.Join([Root, 'broken']);
  Test.AssertTrue(Fs.CreateDirAll(PathOps.Join([Broken, 'world.json'])).Unwrap());
  Test.AssertEquals('storage_error', CatalogUnit.InspectWorld(Root, 'broken', 16).Status);
  Test.AssertTrue(CatalogUnit.ListWorlds(PathOps.Join([Root, 'world-3']), 16) is Error(_));
  Test.AssertTrue(CatalogUnit.CreateWorld(PathOps.Join([Root, 'world-3']), 1, 4, 16) is Error(_));
  // Catalog inspection fully validates final contents without touching levels or explicit saves.
  const Contents := WorldUnit.OpenWorld(Root, 'contents', 12345, 4, 16).Unwrap();
  const Map := Levels.SpawnLevel(Contents);
  var State := Levels.EnterSpawnLevel(Contents, GameState.NewGame(Contents.Metadata)).Unwrap();
  State.Items[3] := State.Items[3] with Location := Items.ItemLocation.Consumed; end with;

  Test.AssertTrue(Savegame.WriteSaveGame(Contents, State).Unwrap());
  const Saved := Fs.ReadText(Savegame.SaveGamePath(Contents)).Unwrap();
  const Region := Entrances.RegionOf(Contents.Metadata, Contents.Metadata.Spawn);
  const LevelPath := Contents.Directory + '/dungeons/' + Conv.IntToStr(Region.X) + '_' +
    Conv.IntToStr(Region.Y) + '/0.json';
  const LevelText := Fs.ReadText(LevelPath).Unwrap();
  const MetadataText := Fs.ReadText(WorldUnit.WorldMetadataPath(Contents)).Unwrap();
  Test.AssertEquals(
    'available',
    CatalogUnit.InspectWorld(Root, Contents.Metadata.Id, 16).SaveStatus
  );
  for BrokenLevel: string in [
    LevelText.Replace('"format_version":3', '"format_version":2'),
    LevelText.Replace('"generator_version":9', '"generator_version":7'),
    LevelText.Replace(Map.Items[Map.Items.Length() - 1].ItemId, Map.AreaId + ':item:6')
  ] do
    Test.AssertTrue(BrokenLevel <> LevelText);
    Test.AssertTrue(Fs.WriteTextAtomic(LevelPath, BrokenLevel).Unwrap());
    const Entry := CatalogUnit.InspectWorld(Root, Contents.Metadata.Id, 16);
    Test.AssertEquals('ready', Entry.Status);
    Test.AssertEquals('world_data_error', Entry.SaveStatus);
    Test.AssertTrue(Entry.Reason.Length() > 0);
    Test.AssertEquals(BrokenLevel, Fs.ReadText(LevelPath).Unwrap());
    Test.AssertEquals(Saved, Fs.ReadText(Savegame.SaveGamePath(Contents)).Unwrap());
  end for;

  Test.AssertTrue(Fs.WriteTextAtomic(LevelPath, LevelText).Unwrap());
  const MissingPotion := State with Items := State.Items.Slice(
    0,
    3
  ).Concat(State.Items.Slice(4, State.Items.Length() - 4)); end with;

  for BrokenSave: string in [
    Saved.Replace('"format_version":11', '"format_version":9'),
    Savegame.EncodeSaveGame(Contents.Metadata.Id, MissingPotion)
  ] do
    Test.AssertTrue(Fs.WriteTextAtomic(Savegame.SaveGamePath(Contents), BrokenSave).Unwrap());
    Test.AssertEquals(
      'incompatible',
      CatalogUnit.InspectWorld(Root, Contents.Metadata.Id, 16).SaveStatus
    );
    const Entries := CatalogUnit.ListWorlds(Root, 16).Unwrap();
    var Found := false;
    for Entry: CatalogUnit.WorldEntry in Entries do
      if Entry.Id = Contents.Metadata.Id then
        Found := true;
        Test.AssertEquals('ready', Entry.Status);
        Test.AssertEquals('incompatible', Entry.SaveStatus);
      end if;
    end for;

    Test.AssertTrue(Found);
    Test.AssertEquals(BrokenSave, Fs.ReadText(Savegame.SaveGamePath(Contents)).Unwrap());
    Test.AssertEquals(LevelText, Fs.ReadText(LevelPath).Unwrap());
  end for;

  Test.AssertTrue(Fs.WriteTextAtomic(Savegame.SaveGamePath(Contents), Saved).Unwrap());
  const OldMetadata := MetadataText.Replace('"generator_version":9', '"generator_version":7');
  Test.AssertTrue(Fs.WriteTextAtomic(WorldUnit.WorldMetadataPath(Contents), OldMetadata).Unwrap());
  Test.AssertEquals(
    'incompatible',
    CatalogUnit.InspectWorld(Root, Contents.Metadata.Id, 16).Status
  );
  Test.AssertEquals(OldMetadata, Fs.ReadText(WorldUnit.WorldMetadataPath(Contents)).Unwrap());
  Test.AssertEquals(Saved, Fs.ReadText(Savegame.SaveGamePath(Contents)).Unwrap());
  Test.AssertEquals(LevelText, Fs.ReadText(LevelPath).Unwrap());
  Test.AssertTrue(Fs.WriteTextAtomic(WorldUnit.WorldMetadataPath(Contents), MetadataText).Unwrap());
  Test.AssertTrue(Fs.DeleteFile(LevelPath).Unwrap());
  Test.AssertEquals(
    'world_data_error',
    CatalogUnit.InspectWorld(Root, Contents.Metadata.Id, 16).SaveStatus
  );
  Test.AssertFalse(Fs.Exists(LevelPath));
  Test.AssertTrue(Fs.CreateDirAll(LevelPath).Unwrap());
  Test.AssertEquals(
    'world_data_error',
    CatalogUnit.InspectWorld(Root, Contents.Metadata.Id, 16).SaveStatus
  );
  Test.AssertTrue(Fs.IsDir(LevelPath));
  Test.AssertEquals(Saved, Fs.ReadText(Savegame.SaveGamePath(Contents)).Unwrap());
  Test.AssertEquals(MetadataText, Fs.ReadText(WorldUnit.WorldMetadataPath(Contents)).Unwrap());
end.
