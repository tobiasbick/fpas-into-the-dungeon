// Verifies that saves retain first-visit entities and reject invalid visit lists.
program VisitedSavegameTest;

uses
  Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interior, Dungeon.Items, Dungeon.Movement,
  Dungeon.Test.Fixtures, Dungeon.Test.Levels, Dungeon.World, Dungeon.World.Savegame, Dungeon.Terrain,
  Std.Conv, Std.Fs, Std.Test, Std.Time;

begin
  const Root: string := '.temp-data/visited-save-test-' + IntToStr(TimestampMillis());
  const World: WorldSession := OpenWorld(Root, 'visited', 12345, 4, 16).Unwrap();
  const Metadata: WorldMetadata := World.Metadata;
  const Map: InteriorMap := SpawnLevel(World);
  const Fresh: GameState := NewGame(Metadata);
  AssertTrue(WriteSaveGame(World, Fresh).Unwrap());
  AssertEquals(0, DecodeStoredSave(World, EncodeSaveGame(Metadata.Id, Fresh))
                    .Unwrap()
                    .VisitedAreas
                    .Length());
  const Entered: GameState := EnterSpawnLevel(World, Fresh).Unwrap();
  var Changed: GameState := Entered;
  Changed.Items[0] := Changed.Items[0] with Location := ItemLocation.CarriedByPlayer; end with;

  Changed.Hostiles[0] := Changed.Hostiles[0] with Health := 0; Alerted := true; end with;

  Changed.Player := PlayerPosition.FirstPerson(FirstPersonPose(Position := Map.Exit, Facing := Map.StartFacing));
  const Outside: GameState := LeaveLevel(World, Changed, Map).Unwrap();
  AssertTrue(WriteSaveGame(World, Outside).Unwrap());
  const Saved: string := Std.Fs.ReadText(SaveGamePath(World)).Unwrap();
  AssertTrue(Saved.Contains('"visited_areas"'));
  if LoadSaveGame(World).Unwrap() is SaveGameLoad.Loaded(const State, const View) then
    begin
      AssertTrue(ValidateGameState(View, State).IsOk());
      AssertTrue(HasVisitedArea(State, Map.AreaId));
      const Again: GameState := EnterSpawnLevel(World, State).Unwrap();
      AssertEquals(3, Again.Items.Length());
      AssertEquals(Map.Hostiles.Length(), Again.Hostiles.Length());
      AssertTrue(Again.Items[0] = Changed.Items[0]);
      AssertTrue(Again.Hostiles[0] = Changed.Hostiles[0]);
      AssertTrue(WriteSaveGame(World, Again).Unwrap());
      if LoadSaveGame(World).Unwrap() is SaveGameLoad.Loaded(const Indoor, const IndoorView) then
        begin
          AssertTrue(ValidateGameState(IndoorView, Indoor).IsOk());
          AssertTrue(Indoor.Items[0] = Changed.Items[0]);
          AssertTrue(Indoor.Hostiles[0] = Changed.Hostiles[0]);
        end;
      else
        begin
          panic('expected indoor load');
        end;
      end if;
    end;
  else
    begin
      panic('expected outdoor load');
    end;
  end if;
  const VisitJson: string := ('"visited_areas":["' + Map.AreaId) + '"]';
  AssertTrue(DecodeStoredSave(World, Saved.Replace(VisitJson, '"visited_areas":[]')).IsError());
  AssertTrue(DecodeStoredSave(World, Saved.Replace(VisitJson, '"visited_areas":["wrong"]'))
               .IsError());
  const Duplicate: string := ((('"visited_areas":["' + Map.AreaId) + '","') + Map.AreaId) + '"]';
  AssertTrue(DecodeStoredSave(World, Saved.Replace(VisitJson, Duplicate)).IsError());
  AssertTrue(DecodeStoredSave(World, Saved.Replace(VisitJson, '"visited_areas":[42]')).IsError());
  AssertTrue(DecodeStoredSave(World, Saved.Replace(VisitJson + ',', '')).IsError());
  const Before: string := Std.Fs.ReadText(SaveGamePath(World)).Unwrap();
  AssertTrue(WriteSaveGame(World, Outside with VisitedAreas := []; end with).IsError());
  AssertEquals(Before, Std.Fs.ReadText(SaveGamePath(World)).Unwrap());
  AssertTrue(WriteSaveGame(World, Fresh).Unwrap());
  if LoadSaveGame(World).Unwrap() is SaveGameLoad.Loaded(const State, const View) then
    begin
      AssertEquals(0, State.VisitedAreas.Length());
      AssertEquals(0, State.Items.Length());
      AssertEquals(0, State.Hostiles.Length());
      AssertTrue(ValidateGameState(View, State).IsOk());
    end;
  else
    begin
      panic('expected fresh save');
    end;
  end if;
end.
