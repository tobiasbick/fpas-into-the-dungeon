// Verifies that saves retain first-visit entities and reject invalid visit lists.
program VisitedSavegameTest;

uses Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Interior as InteriorUnit, Dungeon.Items as ItemRules, Dungeon.Movement as Movement, Dungeon.Test.Fixtures as Fixtures, Dungeon.Test.Levels as Levels, Dungeon.Hostiles as Hostiles, Dungeon.World as WorldUnit, Dungeon.World.Savegame as Savegame, Dungeon.Terrain as Terrain, Std.Text.Format as Conv, Std.Io.Fs as Fs, Std.Test as Test, Std.Time as Time;

begin
  const Root: string := '.temp-data/visited-save-test-' + Conv.IntToStr(Time.TimestampMillis());
  const World: WorldUnit.WorldSession := WorldUnit.OpenWorld(
    Root,
    'visited',
    12345,
    4,
    16
  ).Unwrap();
  const Metadata: Terrain.WorldMetadata := World.Metadata;
  const Map: InteriorUnit.InteriorMap := Levels.SpawnLevel(World);
  const Fresh: GameState.GameState := GameState.NewGame(Metadata);
  Test.AssertTrue(Savegame.WriteSaveGame(World, Fresh).Unwrap());
  Test.AssertEquals(
    0,
    Levels.DecodeStoredSave(
      World,
      Savegame.EncodeSaveGame(Metadata.Id, Fresh)
    ).Unwrap().VisitedAreas.Length()
  );
  const Entered: GameState.GameState := Levels.EnterSpawnLevel(World, Fresh).Unwrap();
  var Changed: GameState.GameState := Entered;
  Changed.Items[0] := Changed.Items[0] with Location := ItemRules.ItemLocation.CarriedByPlayer; end with;

  Changed.Items[3] := Changed.Items[3] with Location := ItemRules.ItemLocation.Consumed; end with;

  Changed.Health := 14;
  Changed.RandomState := 123456;
  Changed.Hostiles[0] := Changed.Hostiles[0] with Health := 0; Alerted := true; end with;

  Changed.Player := Coordinates.PlayerPosition.FirstPerson(
    Coordinates.FirstPersonPose(Position := Map.Arrival, Facing := Map.StartFacing)
  );
  const Outside: GameState.GameState := Levels.LeaveLevel(World, Changed, Map).Unwrap();
  Test.AssertTrue(Savegame.WriteSaveGame(World, Outside).Unwrap());
  const Saved: string := Fs.ReadText(Savegame.SaveGamePath(World)).Unwrap();
  Test.AssertTrue('"visited_areas"' in Saved);
  case Savegame.LoadSaveGame(World).Unwrap() of
    when Savegame.SaveGameLoad.Loaded(const State, const View):
      Test.AssertTrue(GameState.ValidateGameState(View, State) is Ok(_));
      Test.AssertTrue(GameState.HasVisitedArea(State, Map.AreaId));
      const Again: GameState.GameState := Levels.EnterSpawnLevel(World, State).Unwrap();
      Test.AssertEquals(Map.Items.Length(), Again.Items.Length());
      Test.AssertEquals(Map.Hostiles.Length(), Again.Hostiles.Length());
      Test.AssertTrue(Again.Items[0] = Changed.Items[0]);
      Test.AssertTrue(Again.Hostiles[0] = Changed.Hostiles[0]);
      Test.AssertEquals(Changed.Health, Again.Health);
      Test.AssertEquals(Changed.RandomState, Again.RandomState);
      for Index: integer := 0 to Changed.Items.Length() - 1 do
        Test.AssertTrue(Changed.Items[Index] = Again.Items[Index]);
      end for;

      for Index: integer := 0 to Changed.Hostiles.Length() - 1 do
        Test.AssertTrue(Changed.Hostiles[Index] = Again.Hostiles[Index]);
      end for;

      Test.AssertTrue(Savegame.WriteSaveGame(World, Again).Unwrap());
      case Savegame.LoadSaveGame(World).Unwrap() of
        when Savegame.SaveGameLoad.Loaded(const Indoor, const IndoorView):
          Test.AssertTrue(GameState.ValidateGameState(IndoorView, Indoor) is Ok(_));
          Test.AssertEquals(Map.DisplayName, IndoorView.Interior.Unwrap().DisplayName);
          Test.AssertTrue(Indoor.Items[0] = Changed.Items[0]);
          Test.AssertTrue(Indoor.Hostiles[0] = Changed.Hostiles[0]);
        when Savegame.SaveGameLoad.Missing, Savegame.SaveGameLoad.Invalid(_):
          panic('expected indoor load');
      end case;
    when Savegame.SaveGameLoad.Missing, Savegame.SaveGameLoad.Invalid(_):
      panic('expected outdoor load');
  end case;
  const VisitJson: string := ('"visited_areas":["' + Map.AreaId) + '"]';
  Test.AssertTrue(
    (Levels.DecodeStoredSave(World, Saved.Replace(VisitJson, '"visited_areas":[]')) is Error(_))
  );
  Test.AssertTrue(
    (
      Levels.DecodeStoredSave(World, Saved.Replace(VisitJson, '"visited_areas":["wrong"]')) is Error(_)
    )
  );
  const Duplicate: string := ((('"visited_areas":["' + Map.AreaId) + '","') + Map.AreaId) + '"]';
  Test.AssertTrue(
    (Levels.DecodeStoredSave(World, Saved.Replace(VisitJson, Duplicate)) is Error(_))
  );
  Test.AssertTrue(
    (Levels.DecodeStoredSave(World, Saved.Replace(VisitJson, '"visited_areas":[42]')) is Error(_))
  );
  Test.AssertTrue(Levels.DecodeStoredSave(World, Saved.Replace(VisitJson + ',', '')) is Error(_));
  const Before: string := Fs.ReadText(Savegame.SaveGamePath(World)).Unwrap();
  Test.AssertTrue(
    (Savegame.WriteSaveGame(World, Outside with VisitedAreas := []; end with) is Error(_))
  );
  Test.AssertEquals(Before, Fs.ReadText(Savegame.SaveGamePath(World)).Unwrap());
  // Starting over rematerializes original placements without changing the earlier explicit save.
  const Reset := Levels.EnterSpawnLevel(World, Fresh).Unwrap();
  for Index: integer := 0 to Map.Items.Length() - 1 do
    Test.AssertEquals(Map.Items[Index].ItemId, Reset.Items[Index].Id);
    Test.AssertTrue(Reset.Items[Index].Kind = Map.Items[Index].Kind);
    Test.AssertTrue(
      Reset.Items[Index].Location =
      ItemRules.ItemLocation.InInterior(Map.AreaId, Map.Items[Index].Position)
    );
  end for;

  for Opponent: Hostiles.GameHostile in Reset.Hostiles do
    Test.AssertEquals(Hostiles.HostileMaximumHealth(Opponent.Kind), Opponent.Health);
    Test.AssertFalse(Opponent.Alerted);
  end for;

  Test.AssertEquals(Before, Fs.ReadText(Savegame.SaveGamePath(World)).Unwrap());
  Test.AssertTrue(Savegame.WriteSaveGame(World, Fresh).Unwrap());
  case Savegame.LoadSaveGame(World).Unwrap() of
    when Savegame.SaveGameLoad.Loaded(const State, const View):
      Test.AssertEquals(0, State.VisitedAreas.Length());
      Test.AssertEquals(0, State.Items.Length());
      Test.AssertEquals(0, State.Hostiles.Length());
      Test.AssertTrue(GameState.ValidateGameState(View, State) is Ok(_));
    when Savegame.SaveGameLoad.Missing, Savegame.SaveGameLoad.Invalid(_):
      panic('expected fresh save');
  end case;
end.
