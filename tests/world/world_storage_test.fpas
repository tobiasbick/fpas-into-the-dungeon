// Verifies world creation, chunk persistence, validation, composition, and cache limits.
program DungeonWorldStorageTest;

uses
  Dungeon.Terrain.Chunks, Dungeon.Terrain.Entrances, Dungeon.Coordinates, Dungeon.Exploration.Model,
  Dungeon.GameState, Dungeon.Terrain, Dungeon.Terrain.Generation, Dungeon.Terrain.Placement,
  Dungeon.World, Std.Conv, Std.Fs, Std.Path, Std.Tasks, Std.Test, Std.Time;

function EnsureTestRoot(Path: string): result of (boolean, string);
begin
  if not Std.Fs.Exists('.temp-data') then
    begin
      const CreatedBase: boolean := try Std.Fs.CreateDir('.temp-data');
    end;
  end if;

  if not Std.Fs.Exists(Path) then
    begin
      const Created: boolean := try Std.Fs.CreateDir(Path);
    end;
  end if;

  return Ok(true);
end function;

function EnsureChild(Path: string): result of (boolean, string);
begin
  if Std.Fs.Exists(Path) then
    begin
      return Ok(Std.Fs.IsDir(Path));
    end;
  end if;

  return Std.Fs.CreateDir(Path);
end function;

function RequireOutdoor(State: GameState): WorldPosition;
begin
  return OutdoorPlayerPosition(State).Unwrap();
end function;

function MetadataJsonWithEntrance(
  Id: string;
  FormatVersion: integer;
  GeneratorVersion: integer;
  ChunkSize: integer;
  SpawnX: integer;
  SpawnY: integer;
  EntranceX: integer;
  EntranceY: integer;
  RegionChunks: integer
): string;
begin
  const Expected: WorldMetadata := NewWorldMetadata(Id, 12345, 4).Unwrap();
  var Text: string := '{"version":' + IntToStr(FormatVersion);
  Text := ((Text + ',"id":"') + Id) + '"';
  Text := (Text + ',"seed":12345,"generator_version":') + IntToStr(GeneratorVersion);
  Text := (Text + ',"chunk_size":') + IntToStr(ChunkSize);
  Text := (Text + ',"spawn_x":') + IntToStr(SpawnX);
  Text := (Text + ',"spawn_y":') + IntToStr(SpawnY);
  Text := ((Text + ',"outdoor_area_id":"') + Expected.OutdoorAreaId) + '"';
  Text := ((Text + ',"outdoor_area_label":"') + Expected.OutdoorAreaLabel) + '"';
  Text := (Text + ',"spawn_entrance_x":') + IntToStr(EntranceX);
  Text := (Text + ',"spawn_entrance_y":') + IntToStr(EntranceY);
  Text := (Text + ',"dungeon_region_chunks":') + IntToStr(RegionChunks);
  return Text + '}';
end function;

function MetadataJson(
  Id: string;
  FormatVersion: integer;
  GeneratorVersion: integer;
  ChunkSize: integer;
  SpawnX: integer;
  SpawnY: integer
): string;
begin
  const Expected: WorldMetadata := NewWorldMetadata(Id, 12345, 4).Unwrap();
  return MetadataJsonWithEntrance(Id, FormatVersion, GeneratorVersion, ChunkSize, SpawnX, SpawnY, Expected.SpawnEntrance.X, Expected.SpawnEntrance.Y, 4);
end function;

function CountEntrances(Chunk: WorldChunk): integer;
begin
  var Count: integer := 0;
  for Cell: WorldCell in Chunk.Cells do
    begin
      if Cell.Feature = TerrainFeatureKind.Entrance then
        begin
          Count := Count + 1;
        end;
      end if;
    end;
  end for;

  return Count;
end function;

function JsonRows(Code: string; Width: integer; Count: integer): string;
begin
  var Text: string := '[';
  for Index: integer := 0 to Count - 1 do
    begin
      if Index > 0 then
        begin
          Text := Text + ',';
        end;
      end if;

      Text := ((Text + '"') + Code.RepeatStr(Width)) + '"';
    end;
  end for;

  return Text + ']';
end function;

function ChunkJson(
  WorldId: string;
  ChunkX: integer;
  ChunkY: integer;
  Version: integer;
  BaseCode: string;
  Width: integer;
  Count: integer
): string;
begin
  var Text: string := '{"version":' + IntToStr(Version);
  Text := ((Text + ',"world_id":"') + WorldId) + '"';
  Text := (Text + ',"chunk_x":') + IntToStr(ChunkX);
  Text := (Text + ',"chunk_y":') + IntToStr(ChunkY);
  Text := (Text + ',"base_rows":') + JsonRows(BaseCode, Width, Count);
  Text := (Text + ',"feature_rows":') + JsonRows('.', Width, Count);
  Text := (Text + ',"water_rows":') + JsonRows('.', Width, Count);
  return Text + '}';
end function;

function ChunkJsonWithFeature(
  WorldId: string;
  ChunkX: integer;
  ChunkY: integer;
  FeatureCode: string
): string;
begin
  var Text: string := '{"version":' + IntToStr(WorldFormatVersion);
  Text := ((Text + ',"world_id":"') + WorldId) + '"';
  Text := (Text + ',"chunk_x":') + IntToStr(ChunkX);
  Text := (Text + ',"chunk_y":') + IntToStr(ChunkY);
  Text := (Text + ',"base_rows":') + JsonRows('g', WorldChunkSize, WorldChunkSize);
  Text := (Text + ',"feature_rows":') + JsonRows(FeatureCode, WorldChunkSize, WorldChunkSize);
  Text := (Text + ',"water_rows":') + JsonRows('.', WorldChunkSize, WorldChunkSize);
  return Text + '}';
end function;

// Builds an all-grass chunk whose only feature is an entrance at one local field, or none for -1.
function GrassChunkJsonWithEntrance(
  WorldId: string;
  Coordinate: ChunkCoordinate;
  LocalX: integer;
  LocalY: integer
): string;
begin
  var FeatureRows: string := '[';
  for Y: integer := 0 to WorldChunkSize - 1 do
    begin
      var Row: string := '.'.RepeatStr(WorldChunkSize);
      if Y = LocalY then
        begin
          Row := Row.SetCharAt(LocalX, 'e');
        end;
      end if;

      if Y > 0 then
        begin
          FeatureRows := FeatureRows + ',';
        end;
      end if;

      FeatureRows := ((FeatureRows + '"') + Row) + '"';
    end;
  end for;
  var Text: string := '{"version":' + IntToStr(WorldFormatVersion);
  Text := ((Text + ',"world_id":"') + WorldId) + '"';
  Text := (Text + ',"chunk_x":') + IntToStr(Coordinate.X);
  Text := (Text + ',"chunk_y":') + IntToStr(Coordinate.Y);
  Text := (Text + ',"base_rows":') + JsonRows('g', WorldChunkSize, WorldChunkSize);
  Text := ((Text + ',"feature_rows":') + FeatureRows) + ']';
  Text := (Text + ',"water_rows":') + JsonRows('.', WorldChunkSize, WorldChunkSize);
  return Text + '}';
end function;

// Returns the first ordinary entrance site near the origin, outside the spawn region.
function OrdinarySite(Metadata: WorldMetadata): WorldPosition;
begin
  const SpawnRegion: RegionCoordinate := RegionOf(Metadata, Metadata.Spawn);
  for RegionY: integer := -3 to 3 do
    begin
      for RegionX: integer := -3 to 3 do
        begin
          const Region: RegionCoordinate := RegionCoordinate(X := RegionX, Y := RegionY);
          if Region <> SpawnRegion then
            begin
              if EntranceSite(Metadata, Region) is Some(const Site) then
                begin
                  return Site;
                end;
              else
                begin
                  null;
                end;
              end if;
            end;
          end if;
        end;
      end for;
    end;
  end for;

  panic('no ordinary entrance site near the origin');
end function;

function ConcurrentLoad(Root: string; Coordinate: ChunkCoordinate): result of (boolean, string);
begin
  const World: WorldSession := try OpenWorld(Root, 'concurrent', 12345, 4, 8);
  const Loaded: ChunkLoad := try LoadWorldChunk(World, Coordinate);
  return Ok(Loaded.Chunk.Cells.Length() = WorldChunkSize * WorldChunkSize);
end function;

function FindHorizontalCrossing(Metadata: WorldMetadata; LeftX: integer; RightX: integer): integer;
begin
  for Y: integer := -2048 to 2048 do
    begin
      if IsWalkable(GenerateWorldCell(Metadata, LeftX, Y)) and
         IsWalkable(GenerateWorldCell(Metadata, RightX, Y)) then
        begin
          return Y;
        end;
      end if;
    end;
  end for;

  panic('expected a traversable horizontal chunk crossing');
end function;

function FindVerticalCrossing(Metadata: WorldMetadata; TopY: integer; BottomY: integer): integer;
begin
  for X: integer := -2048 to 2048 do
    begin
      if IsWalkable(GenerateWorldCell(Metadata, X, TopY)) and
         IsWalkable(GenerateWorldCell(Metadata, X, BottomY)) then
        begin
          return X;
        end;
      end if;
    end;
  end for;

  panic('expected a traversable vertical chunk crossing');
end function;

begin
  const Root: string := '.temp-data/world-storage-test-' + IntToStr(TimestampMillis());
  AssertTrue(EnsureTestRoot(Root).Unwrap());
  var World: WorldSession := OpenWorld(Root, 'storage', 12345, 4, 16).Unwrap();
  AssertTrue(Std.Fs.IsFile(WorldMetadataPath(World)));
  AssertEquals(WorldFormatVersion, World.Metadata.FormatVersion);
  AssertEquals(WorldChunkSize, World.Metadata.ChunkSize);
  const MetadataBeforeReload: string := Std.Fs.ReadText(WorldMetadataPath(World)).Unwrap();
  // Reopening ignores a changed configured seed and region size: the stored world keeps its values.
  const ReloadedWorld: WorldSession := OpenWorld(Root, 'storage', 99999, 9, 16).Unwrap();
  AssertEquals(4, ReloadedWorld.Metadata.DungeonRegionChunks);
  AssertEquals(World.Metadata.SpawnEntrance.X, ReloadedWorld.Metadata.SpawnEntrance.X);
  AssertEquals(World.Metadata.SpawnEntrance.Y, ReloadedWorld.Metadata.SpawnEntrance.Y);
  AssertEquals(MetadataBeforeReload, Std.Fs.ReadText(WorldMetadataPath(ReloadedWorld)).Unwrap());
  const EntranceCoordinate: ChunkCoordinate := ChunkCoordinate(X := ChunkForCoordinate(World.Metadata.SpawnEntrance.X), Y := ChunkForCoordinate(World.Metadata.SpawnEntrance.Y));
  const EntranceChunk: WorldChunk := LoadWorldChunk(World, EntranceCoordinate).Unwrap().Chunk;
  AssertEquals(1, CountEntrances(EntranceChunk));
  AssertTrue(ChunkCell(EntranceChunk, LocalForCoordinate(World.Metadata.SpawnEntrance.X), LocalForCoordinate(World.Metadata.SpawnEntrance.Y)).Feature =
             TerrainFeatureKind.Entrance);
  const Coordinate: ChunkCoordinate := ChunkCoordinate(X := -1, Y := 2);
  const First: ChunkLoad := LoadWorldChunk(World, Coordinate).Unwrap();
  World := First.World;
  const Path: string := WorldChunkPath(World, Coordinate);
  AssertTrue(Std.Fs.IsFile(Path));
  const Stored: string := Std.Fs.ReadText(Path).Unwrap();
  const Second: ChunkLoad := LoadWorldChunk(OpenWorld(Root, 'storage', 99999, 4, 16).Unwrap(), Coordinate)
                               .Unwrap();
  AssertEquals(Stored, Std.Fs.ReadText(Path).Unwrap());
  AssertTrue(VisibleCellCode(First.Chunk.Cells[0]) = VisibleCellCode(Second.Chunk.Cells[0]));
  const State: GameState := NewGame(World.Metadata);
  const WindowResult: WindowLoad := LoadVisibleWindow(World, State, 17, 9).Unwrap();
  World := WindowResult.World;
  AssertEquals(RequireOutdoor(State).X - 8, WindowResult.Window.OriginX);
  AssertEquals(RequireOutdoor(State).Y - 4, WindowResult.Window.OriginY);
  AssertEquals(17, WindowResult.Window.Width);
  AssertEquals(9, WindowResult.Window.Rows.Length());
  AssertEquals(17, WindowResult.Window.Rows[0].Length());
  AssertTrue(CachedChunkCount(World) <= 16);
  const WithinOne: ChunkRange := ChunkRangeForWindow(10, 10, 5, 5).Unwrap();
  AssertEquals(0, WithinOne.MinimumX);
  AssertEquals(0, WithinOne.MaximumX);
  const AcrossEdge: ChunkRange := ChunkRangeForWindow(127, 20, 2, 2).Unwrap();
  AssertEquals(0, AcrossEdge.MinimumX);
  AssertEquals(1, AcrossEdge.MaximumX);
  const AcrossCorners: ChunkRange := ChunkRangeForWindow(127, 127, 2, 2).Unwrap();
  AssertEquals(0, AcrossCorners.MinimumX);
  AssertEquals(1, AcrossCorners.MaximumX);
  AssertEquals(0, AcrossCorners.MinimumY);
  AssertEquals(1, AcrossCorners.MaximumY);
  const NegativeEdge: ChunkRange := ChunkRangeForWindow(-129, -129, 2, 2).Unwrap();
  AssertEquals(-2, NegativeEdge.MinimumX);
  AssertEquals(-1, NegativeEdge.MaximumX);
  AssertEquals(-2, NegativeEdge.MinimumY);
  AssertEquals(-1, NegativeEdge.MaximumY);
  const AcrossMany: ChunkRange := ChunkRangeForWindow(-200, -200, 520, 520).Unwrap();
  AssertTrue((AcrossMany.MaximumX - AcrossMany.MinimumX) + 1 > 3);
  AssertTrue((AcrossMany.MaximumY - AcrossMany.MinimumY) + 1 > 3);
  const WideWorld: WorldSession := OpenWorld(Root, 'storage', 12345, 4, 64).Unwrap();
  const WideWindow: WindowLoad := LoadVisibleWindow(WideWorld, State, 385, 385).Unwrap();
  AssertEquals(385, WideWindow.Window.Width);
  AssertEquals(385, WideWindow.Window.Height);
  AssertEquals(385, WideWindow.Window.Rows[384].Length());
  AssertTrue(CachedChunkCount(WideWindow.World) <= 64);
  const Moved: WorldMove := MoveInWorld(World, State, -1, 0).Unwrap();
  AssertEquals(RequireOutdoor(State).X - 1, RequireOutdoor(Moved.State).X);
  AssertEquals(RequireOutdoor(State).Y, RequireOutdoor(Moved.State).Y);
  const RightY: integer := FindHorizontalCrossing(World.Metadata, 127, 128);
  const CrossRight: WorldMove := MoveInWorld(World, GameState(Area := AreaKind.OutdoorRegion, AreaId := World.Metadata.OutdoorAreaId, Player := PlayerPosition.Outdoor(WorldPosition(X := 127, Y := RightY)), ReturnLocation := ReturnLocation.NoReturnLocation, VisitedAreas := [], Exploration := EmptyExploration(), Items := NewGame(World.Metadata)
                                                                                                                                                                                                                                                                                                                                   .Items, Health := NewGame(World.Metadata)
                                                                                                                                                                                                                                                                                                                                                       .Health, Hostiles := NewGame(World.Metadata)
                                                                                                                                                                                                                                                                                                                                                                              .Hostiles, RandomState := NewGame(World.Metadata)
                                                                                                                                                                                                                                                                                                                                                                                                          .RandomState), 1, 0)
                                   .Unwrap();
  AssertEquals(128, RequireOutdoor(CrossRight.State).X);
  const LeftY: integer := FindHorizontalCrossing(World.Metadata, -128, -129);
  const CrossLeft: WorldMove := MoveInWorld(World, GameState(Area := AreaKind.OutdoorRegion, AreaId := World.Metadata.OutdoorAreaId, Player := PlayerPosition.Outdoor(WorldPosition(X := -128, Y := LeftY)), ReturnLocation := ReturnLocation.NoReturnLocation, VisitedAreas := [], Exploration := EmptyExploration(), Items := NewGame(World.Metadata)
                                                                                                                                                                                                                                                                                                                                  .Items, Health := NewGame(World.Metadata)
                                                                                                                                                                                                                                                                                                                                                      .Health, Hostiles := NewGame(World.Metadata)
                                                                                                                                                                                                                                                                                                                                                                             .Hostiles, RandomState := NewGame(World.Metadata)
                                                                                                                                                                                                                                                                                                                                                                                                         .RandomState), -1, 0)
                                  .Unwrap();
  AssertEquals(-129, RequireOutdoor(CrossLeft.State).X);
  const DownX: integer := FindVerticalCrossing(World.Metadata, 127, 128);
  const CrossDown: WorldMove := MoveInWorld(World, GameState(Area := AreaKind.OutdoorRegion, AreaId := World.Metadata.OutdoorAreaId, Player := PlayerPosition.Outdoor(WorldPosition(X := DownX, Y := 127)), ReturnLocation := ReturnLocation.NoReturnLocation, VisitedAreas := [], Exploration := EmptyExploration(), Items := NewGame(World.Metadata)
                                                                                                                                                                                                                                                                                                                                 .Items, Health := NewGame(World.Metadata)
                                                                                                                                                                                                                                                                                                                                                     .Health, Hostiles := NewGame(World.Metadata)
                                                                                                                                                                                                                                                                                                                                                                            .Hostiles, RandomState := NewGame(World.Metadata)
                                                                                                                                                                                                                                                                                                                                                                                                        .RandomState), 0, 1)
                                  .Unwrap();
  AssertEquals(128, RequireOutdoor(CrossDown.State).Y);
  const UpX: integer := FindVerticalCrossing(World.Metadata, -128, -129);
  const CrossUp: WorldMove := MoveInWorld(World, GameState(Area := AreaKind.OutdoorRegion, AreaId := World.Metadata.OutdoorAreaId, Player := PlayerPosition.Outdoor(WorldPosition(X := UpX, Y := -128)), ReturnLocation := ReturnLocation.NoReturnLocation, VisitedAreas := [], Exploration := EmptyExploration(), Items := NewGame(World.Metadata)
                                                                                                                                                                                                                                                                                                                              .Items, Health := NewGame(World.Metadata)
                                                                                                                                                                                                                                                                                                                                                  .Health, Hostiles := NewGame(World.Metadata)
                                                                                                                                                                                                                                                                                                                                                                         .Hostiles, RandomState := NewGame(World.Metadata)
                                                                                                                                                                                                                                                                                                                                                                                                     .RandomState), 0, -1)
                                .Unwrap();
  AssertEquals(-129, RequireOutdoor(CrossUp.State).Y);
  AssertTrue(OpenWorld(Root, '../escape', 1, 4, 16).IsError());
  AssertTrue(OpenWorld(Root, '', 1, 4, 16).IsError());
  AssertTrue(OpenWorld(Root, 'a'.RepeatStr(65), 1, 4, 16).IsError());
  AssertTrue(OpenWorld(Root, 'welt-ä', 1, 4, 16).IsError());
  const MaximumIdWorld: WorldSession := OpenWorld(Root, 'a'.RepeatStr(64), 1, 4, 16).Unwrap();
  AssertEquals(64, MaximumIdWorld.Metadata.Id.Length());
  AssertTrue(OpenWorld(Root, 'storage', 1, 4, 0).IsError());
  var SmallCache: WorldSession := OpenWorld(Root, 'small-cache', 12345, 4, 2).Unwrap();
  const CachedA: ChunkLoad := LoadWorldChunk(SmallCache, ChunkCoordinate(X := 10, Y := 10)).Unwrap();
  SmallCache := CachedA.World;
  const CachedB: ChunkLoad := LoadWorldChunk(SmallCache, ChunkCoordinate(X := 11, Y := 10)).Unwrap();
  SmallCache := CachedB.World;
  const CachedC: ChunkLoad := LoadWorldChunk(SmallCache, ChunkCoordinate(X := 12, Y := 10)).Unwrap();
  SmallCache := CachedC.World;
  AssertEquals(2, CachedChunkCount(SmallCache));
  AssertEquals(11, SmallCache.Cache[0].Chunk.Coordinate.X);
  AssertEquals(12, SmallCache.Cache[1].Chunk.Coordinate.X);
  const InvalidVersionDirectory: string := Std.Path.Join([Root, 'invalid-version']);
  AssertTrue(EnsureChild(InvalidVersionDirectory).Unwrap());
  const InvalidVersionPath: string := Std.Path.Join([InvalidVersionDirectory, 'world.json']);
  const InvalidVersionText: string := MetadataJson('invalid-version', 99, WorldGeneratorVersion, WorldChunkSize, 0, 0);
  AssertTrue(Std.Fs.WriteTextAtomic(InvalidVersionPath, InvalidVersionText).Unwrap());
  AssertTrue(OpenWorld(Root, 'invalid-version', 1, 4, 8).IsError());
  AssertEquals(InvalidVersionText, Std.Fs.ReadText(InvalidVersionPath).Unwrap());
  const MissingFieldDirectory: string := Std.Path.Join([Root, 'missing-field']);
  AssertTrue(EnsureChild(MissingFieldDirectory).Unwrap());
  const MissingFieldText: string := '{"version":2,"id":"missing-field"}';
  const MissingFieldPath: string := Std.Path.Join([MissingFieldDirectory, 'world.json']);
  AssertTrue(Std.Fs.WriteTextAtomic(MissingFieldPath, MissingFieldText).Unwrap());
  AssertTrue(OpenWorld(Root, 'missing-field', 12345, 4, 8).IsError());
  AssertEquals(MissingFieldText, Std.Fs.ReadText(MissingFieldPath).Unwrap());
  const InvalidSizeDirectory: string := Std.Path.Join([Root, 'invalid-size']);
  AssertTrue(EnsureChild(InvalidSizeDirectory).Unwrap());
  AssertTrue(Std.Fs.WriteTextAtomic(Std.Path.Join([InvalidSizeDirectory, 'world.json']), MetadataJson('invalid-size', WorldFormatVersion, WorldGeneratorVersion, 127, 0, 0))
               .Unwrap());
  AssertTrue(OpenWorld(Root, 'invalid-size', 1, 4, 8).IsError());
  const MismatchDirectory: string := Std.Path.Join([Root, 'mismatch']);
  AssertTrue(EnsureChild(MismatchDirectory).Unwrap());
  AssertTrue(Std.Fs.WriteTextAtomic(Std.Path.Join([MismatchDirectory, 'world.json']), MetadataJson('different', WorldFormatVersion, WorldGeneratorVersion, WorldChunkSize, 0, 0))
               .Unwrap());
  AssertTrue(OpenWorld(Root, 'mismatch', 1, 4, 8).IsError());
  const LegacyGeneratorDirectory: string := Std.Path.Join([Root, 'legacy-generator']);
  AssertTrue(EnsureChild(LegacyGeneratorDirectory).Unwrap());
  const LegacyGeneratorPath: string := Std.Path.Join([LegacyGeneratorDirectory, 'world.json']);
  const LegacyGeneratorText: string := MetadataJson('legacy-generator', WorldFormatVersion, WorldGeneratorVersion -
                                                                                            1, WorldChunkSize, 0, 0);
  AssertTrue(Std.Fs.WriteTextAtomic(LegacyGeneratorPath, LegacyGeneratorText).Unwrap());
  AssertTrue(OpenWorld(Root, 'legacy-generator', 1, 4, 8).IsError());
  AssertEquals(LegacyGeneratorText, Std.Fs.ReadText(LegacyGeneratorPath).Unwrap());
  var BlockedX: integer := 100;
  const InvalidSpawnMetadata: WorldMetadata := NewWorldMetadata('invalid-spawn', 12345, 4).Unwrap();
  while IsWalkable(GenerateWorldCell(InvalidSpawnMetadata, BlockedX, 100)) do
    begin
      BlockedX := BlockedX + 1;
    end;
  end while;
  const InvalidSpawnDirectory: string := Std.Path.Join([Root, 'invalid-spawn']);
  AssertTrue(EnsureChild(InvalidSpawnDirectory).Unwrap());
  AssertTrue(Std.Fs.WriteTextAtomic(Std.Path.Join([InvalidSpawnDirectory, 'world.json']), MetadataJson('invalid-spawn', WorldFormatVersion, WorldGeneratorVersion, WorldChunkSize, BlockedX, 100))
               .Unwrap());
  AssertTrue(OpenWorld(Root, 'invalid-spawn', 1, 4, 8).IsError());
  const ConflictingEntranceDirectory: string := Std.Path.Join([Root, 'conflicting-entrance']);
  AssertTrue(EnsureChild(ConflictingEntranceDirectory).Unwrap());
  const ConflictingMetadata: WorldMetadata := NewWorldMetadata('conflicting-entrance', 12345, 4)
                                                .Unwrap();
  var ConflictingX: integer := 100;
  while IsWalkable(GenerateWorldCell(ConflictingMetadata, ConflictingX, 100)) do
    begin
      ConflictingX := ConflictingX + 1;
    end;
  end while;
  const ConflictingText: string := MetadataJsonWithEntrance('conflicting-entrance', WorldFormatVersion, WorldGeneratorVersion, WorldChunkSize, ConflictingMetadata.Spawn.X, ConflictingMetadata.Spawn.Y, ConflictingX, 100, 4);
  const ConflictingPath: string := Std.Path.Join([ConflictingEntranceDirectory, 'world.json']);
  AssertTrue(Std.Fs.WriteTextAtomic(ConflictingPath, ConflictingText).Unwrap());
  AssertTrue(OpenWorld(Root, 'conflicting-entrance', 12345, 4, 8).IsError());
  AssertEquals(ConflictingText, Std.Fs.ReadText(ConflictingPath).Unwrap());
  // Stored region sizes outside 1 through 16 are rejected without rewriting the file.
  const WrongRegionDirectory: string := Std.Path.Join([Root, 'wrong-region']);
  AssertTrue(EnsureChild(WrongRegionDirectory).Unwrap());
  const WrongRegionMetadata: WorldMetadata := NewWorldMetadata('wrong-region', 12345, 4).Unwrap();
  const WrongRegionText: string := MetadataJsonWithEntrance('wrong-region', WorldFormatVersion, WorldGeneratorVersion, WorldChunkSize, WrongRegionMetadata.Spawn.X, WrongRegionMetadata.Spawn.Y, WrongRegionMetadata.SpawnEntrance.X, WrongRegionMetadata.SpawnEntrance.Y, 17);
  const WrongRegionPath: string := Std.Path.Join([WrongRegionDirectory, 'world.json']);
  AssertTrue(Std.Fs.WriteTextAtomic(WrongRegionPath, WrongRegionText).Unwrap());
  AssertTrue(OpenWorld(Root, 'wrong-region', 12345, 4, 8).IsError());
  AssertEquals(WrongRegionText, Std.Fs.ReadText(WrongRegionPath).Unwrap());
  AssertTrue(OpenWorld(Root, 'new-wrong-region', 12345, 0, 8).IsError());
  var InvalidChunkWorld: WorldSession := OpenWorld(Root, 'invalid-chunks', 12345, 4, 8).Unwrap();
  const InvalidCoordinate: ChunkCoordinate := ChunkCoordinate(X := 20, Y := -20);
  const InvalidColumn: string := Std.Path.Join([InvalidChunkWorld.Directory, 'chunks', 'x_20']);
  AssertTrue(EnsureChild(InvalidColumn).Unwrap());
  const InvalidChunkPath: string := WorldChunkPath(InvalidChunkWorld, InvalidCoordinate);
  const InvalidChunkText: string := ChunkJson('invalid-chunks', 20, -20, WorldFormatVersion, 'x', WorldChunkSize, WorldChunkSize);
  AssertTrue(Std.Fs.WriteTextAtomic(InvalidChunkPath, InvalidChunkText).Unwrap());
  AssertTrue(LoadWorldChunk(InvalidChunkWorld, InvalidCoordinate).IsError());
  AssertEquals(InvalidChunkText, Std.Fs.ReadText(InvalidChunkPath).Unwrap());
  const MalformedCoordinate: ChunkCoordinate := ChunkCoordinate(X := 21, Y := -20);
  const MalformedColumn: string := Std.Path.Join([InvalidChunkWorld.Directory, 'chunks', 'x_21']);
  AssertTrue(EnsureChild(MalformedColumn).Unwrap());
  AssertTrue(Std.Fs.WriteTextAtomic(WorldChunkPath(InvalidChunkWorld, MalformedCoordinate), ChunkJson('invalid-chunks', 21, -20, WorldFormatVersion, 'g', 127, WorldChunkSize))
               .Unwrap());
  AssertTrue(LoadWorldChunk(InvalidChunkWorld, MalformedCoordinate).IsError());
  const WrongCoordinate: ChunkCoordinate := ChunkCoordinate(X := 22, Y := -20);
  const WrongColumn: string := Std.Path.Join([InvalidChunkWorld.Directory, 'chunks', 'x_22']);
  AssertTrue(EnsureChild(WrongColumn).Unwrap());
  AssertTrue(Std.Fs.WriteTextAtomic(WorldChunkPath(InvalidChunkWorld, WrongCoordinate), ChunkJson('invalid-chunks', 999, -20, WorldFormatVersion, 'g', WorldChunkSize, WorldChunkSize))
               .Unwrap());
  AssertTrue(LoadWorldChunk(InvalidChunkWorld, WrongCoordinate).IsError());
  const WrongVersionCoordinate: ChunkCoordinate := ChunkCoordinate(X := 23, Y := -20);
  const WrongVersionColumn: string := Std.Path.Join([InvalidChunkWorld.Directory, 'chunks', 'x_23']);
  AssertTrue(EnsureChild(WrongVersionColumn).Unwrap());
  AssertTrue(Std.Fs.WriteTextAtomic(WorldChunkPath(InvalidChunkWorld, WrongVersionCoordinate), ChunkJson('invalid-chunks', 23, -20, 99, 'g', WorldChunkSize, WorldChunkSize))
               .Unwrap());
  AssertTrue(LoadWorldChunk(InvalidChunkWorld, WrongVersionCoordinate).IsError());
  const WrongWorldCoordinate: ChunkCoordinate := ChunkCoordinate(X := 24, Y := -20);
  const WrongWorldColumn: string := Std.Path.Join([InvalidChunkWorld.Directory, 'chunks', 'x_24']);
  AssertTrue(EnsureChild(WrongWorldColumn).Unwrap());
  AssertTrue(Std.Fs.WriteTextAtomic(WorldChunkPath(InvalidChunkWorld, WrongWorldCoordinate), ChunkJson('another-world', 24, -20, WorldFormatVersion, 'g', WorldChunkSize, WorldChunkSize))
               .Unwrap());
  AssertTrue(LoadWorldChunk(InvalidChunkWorld, WrongWorldCoordinate).IsError());
  const WrongRowCountCoordinate: ChunkCoordinate := ChunkCoordinate(X := 25, Y := -20);
  const WrongRowCountColumn: string := Std.Path.Join([InvalidChunkWorld.Directory, 'chunks', 'x_25']);
  AssertTrue(EnsureChild(WrongRowCountColumn).Unwrap());
  AssertTrue(Std.Fs.WriteTextAtomic(WorldChunkPath(InvalidChunkWorld, WrongRowCountCoordinate), ChunkJson('invalid-chunks', 25, -20, WorldFormatVersion, 'g', WorldChunkSize, 127))
               .Unwrap());
  AssertTrue(LoadWorldChunk(InvalidChunkWorld, WrongRowCountCoordinate).IsError());
  const DuplicateEntranceCoordinate: ChunkCoordinate := ChunkCoordinate(X := 26, Y := -20);
  const DuplicateEntranceColumn: string := Std.Path.Join([
                                                           InvalidChunkWorld.Directory,
                                                           'chunks',
                                                           'x_26'
                                                         ]);
  AssertTrue(EnsureChild(DuplicateEntranceColumn).Unwrap());
  const DuplicateEntrancePath: string := WorldChunkPath(InvalidChunkWorld, DuplicateEntranceCoordinate);
  const DuplicateEntranceText: string := ChunkJsonWithFeature('invalid-chunks', 26, -20, 'e');
  AssertTrue(Std.Fs.WriteTextAtomic(DuplicateEntrancePath, DuplicateEntranceText).Unwrap());
  AssertTrue(LoadWorldChunk(InvalidChunkWorld, DuplicateEntranceCoordinate).IsError());
  AssertEquals(DuplicateEntranceText, Std.Fs.ReadText(DuplicateEntrancePath).Unwrap());
  // A stored chunk carries an entrance exactly on an entrance field whose stored cell is clear land.
  const Site: WorldPosition := OrdinarySite(InvalidChunkWorld.Metadata);
  const SiteCoordinate: ChunkCoordinate := ChunkCoordinate(X := ChunkForCoordinate(Site.X), Y := ChunkForCoordinate(Site.Y));
  const SiteLoad: ChunkLoad := LoadWorldChunk(InvalidChunkWorld, SiteCoordinate).Unwrap();
  AssertTrue(ChunkCell(SiteLoad.Chunk, LocalForCoordinate(Site.X), LocalForCoordinate(Site.Y)).Feature =
             TerrainFeatureKind.Entrance);
  const SitePath: string := WorldChunkPath(InvalidChunkWorld, SiteCoordinate);
  const SiteX: integer := LocalForCoordinate(Site.X);
  const SiteY: integer := LocalForCoordinate(Site.Y);
  const Matching: string := GrassChunkJsonWithEntrance('invalid-chunks', SiteCoordinate, SiteX, SiteY);
  AssertTrue(Std.Fs.WriteTextAtomic(SitePath, Matching).Unwrap());
  AssertTrue(LoadWorldChunk(OpenWorld(Root, 'invalid-chunks', 12345, 4, 8).Unwrap(), SiteCoordinate)
               .IsOk());
  const Missing: string := GrassChunkJsonWithEntrance('invalid-chunks', SiteCoordinate, -1, -1);
  AssertTrue(Std.Fs.WriteTextAtomic(SitePath, Missing).Unwrap());
  AssertTrue(LoadWorldChunk(OpenWorld(Root, 'invalid-chunks', 12345, 4, 8).Unwrap(), SiteCoordinate)
               .IsError());
  AssertEquals(Missing, Std.Fs.ReadText(SitePath).Unwrap());
  const ShiftedX: integer := (SiteX + 1) mod WorldChunkSize;
  const Shifted: string := GrassChunkJsonWithEntrance('invalid-chunks', SiteCoordinate, ShiftedX, SiteY);
  AssertTrue(Std.Fs.WriteTextAtomic(SitePath, Shifted).Unwrap());
  AssertTrue(LoadWorldChunk(OpenWorld(Root, 'invalid-chunks', 12345, 4, 8).Unwrap(), SiteCoordinate)
               .IsError());
  const ConcurrentWorld: WorldSession := OpenWorld(Root, 'concurrent', 12345, 4, 8).Unwrap();
  const ConcurrentCoordinate: ChunkCoordinate := ChunkCoordinate(X := 31, Y := 17);
  const FirstTask: task := go ConcurrentLoad(Root, ConcurrentCoordinate);
  const SecondTask: task := go ConcurrentLoad(Root, ConcurrentCoordinate);
  AssertTrue(Std.Tasks.Wait(FirstTask).Unwrap());
  AssertTrue(Std.Tasks.Wait(SecondTask).Unwrap());
  const ConcurrentResult: ChunkLoad := LoadWorldChunk(ConcurrentWorld, ConcurrentCoordinate)
                                         .Unwrap();
  AssertEquals(WorldChunkSize * WorldChunkSize, ConcurrentResult.Chunk.Cells.Length());
end.
