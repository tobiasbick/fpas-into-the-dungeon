// Verifies world creation, chunk persistence, validation, composition, and cache limits.
program DungeonWorldStorageTest;

uses
  Dungeon.Terrain.Chunks, Dungeon.Terrain.Entrances, Dungeon.Coordinates, Dungeon.Exploration.Model,
  Dungeon.GameState, Dungeon.Terrain, Dungeon.Terrain.Generation, Dungeon.Terrain.Placement,
  Dungeon.World, Std.Arrays, Std.Conv, Std.Fs, Std.Path, Std.Results, Std.Str, Std.Tasks, Std.Test,
  Std.Time;

function EnsureTestRoot(Path: string): result of boolean, string;
begin
  if not Std.Fs.Exists('.temp-data') then
    begin
      var CreatedBase: boolean := try Std.Fs.CreateDir('.temp-data');
    end;
  end if;

  if not Std.Fs.Exists(Path) then
    begin
      var Created: boolean := try Std.Fs.CreateDir(Path);
    end;
  end if;

  return Ok(true);
end function;

function EnsureChild(Path: string): result of boolean, string;
begin
  if Std.Fs.Exists(Path) then
    begin
      return Ok(Std.Fs.IsDir(Path));
    end;
  end if;

  return Std.Fs.CreateDir(Path);
end function;

function RequireOutdoor(State: GameState): WorldPosition;
begin
  return Unwrap(OutdoorPlayerPosition(State));
end function;

function MetadataJsonWithEntrance(
  Id: string;
  FormatVersion: integer;
  GeneratorVersion: integer;
  ChunkSize: integer;
  SpawnX: integer;
  SpawnY: integer;
  EntranceX: integer;
  EntranceY: integer;
  RegionChunks: integer
): string;
begin
  var Expected: WorldMetadata := Unwrap(NewWorldMetadata(Id, 12345, 4));
  mutable var Text: string := '{"version":' + IntToStr(FormatVersion);
  Text := ((Text + ',"id":"') + Id) + '"';
  Text := (Text + ',"seed":12345,"generator_version":') + IntToStr(GeneratorVersion);
  Text := (Text + ',"chunk_size":') + IntToStr(ChunkSize);
  Text := (Text + ',"spawn_x":') + IntToStr(SpawnX);
  Text := (Text + ',"spawn_y":') + IntToStr(SpawnY);
  Text := ((Text + ',"outdoor_area_id":"') + Expected.OutdoorAreaId) + '"';
  Text := ((Text + ',"outdoor_area_label":"') + Expected.OutdoorAreaLabel) + '"';
  Text := (Text + ',"spawn_entrance_x":') + IntToStr(EntranceX);
  Text := (Text + ',"spawn_entrance_y":') + IntToStr(EntranceY);
  Text := (Text + ',"dungeon_region_chunks":') + IntToStr(RegionChunks);
  return Text + '}';
end function;

function MetadataJson(
  Id: string;
  FormatVersion: integer;
  GeneratorVersion: integer;
  ChunkSize: integer;
  SpawnX: integer;
  SpawnY: integer
): string;
begin
  var Expected: WorldMetadata := Unwrap(NewWorldMetadata(Id, 12345, 4));
  return MetadataJsonWithEntrance(Id, FormatVersion, GeneratorVersion, ChunkSize, SpawnX, SpawnY, Expected.SpawnEntrance.X, Expected.SpawnEntrance.Y, 4);
end function;

function CountEntrances(Chunk: WorldChunk): integer;
begin
  mutable var Count: integer := 0;
  for Cell: WorldCell in Chunk.Cells do
    begin
      if Cell.Feature = TerrainFeatureKind.Entrance then
        begin
          Count := Count + 1;
        end;
      end if;
    end;
  end for;

  return Count;
end function;

function JsonRows(Code: string; Width: integer; Count: integer): string;
begin
  mutable var Text: string := '[';
  for Index: integer := 0 to Count - 1 do
    begin
      if Index > 0 then
        begin
          Text := Text + ',';
        end;
      end if;

      Text := ((Text + '"') + Std.Str.RepeatStr(Code, Width)) + '"';
    end;
  end for;

  return Text + ']';
end function;

function ChunkJson(
  WorldId: string;
  ChunkX: integer;
  ChunkY: integer;
  Version: integer;
  BaseCode: string;
  Width: integer;
  Count: integer
): string;
begin
  mutable var Text: string := '{"version":' + IntToStr(Version);
  Text := ((Text + ',"world_id":"') + WorldId) + '"';
  Text := (Text + ',"chunk_x":') + IntToStr(ChunkX);
  Text := (Text + ',"chunk_y":') + IntToStr(ChunkY);
  Text := (Text + ',"base_rows":') + JsonRows(BaseCode, Width, Count);
  Text := (Text + ',"feature_rows":') + JsonRows('.', Width, Count);
  Text := (Text + ',"water_rows":') + JsonRows('.', Width, Count);
  return Text + '}';
end function;

function ChunkJsonWithFeature(
  WorldId: string;
  ChunkX: integer;
  ChunkY: integer;
  FeatureCode: string
): string;
begin
  mutable var Text: string := '{"version":' + IntToStr(WorldFormatVersion);
  Text := ((Text + ',"world_id":"') + WorldId) + '"';
  Text := (Text + ',"chunk_x":') + IntToStr(ChunkX);
  Text := (Text + ',"chunk_y":') + IntToStr(ChunkY);
  Text := (Text + ',"base_rows":') + JsonRows('g', WorldChunkSize, WorldChunkSize);
  Text := (Text + ',"feature_rows":') + JsonRows(FeatureCode, WorldChunkSize, WorldChunkSize);
  Text := (Text + ',"water_rows":') + JsonRows('.', WorldChunkSize, WorldChunkSize);
  return Text + '}';
end function;

// Builds an all-grass chunk whose only feature is an entrance at one local field, or none for -1.
function GrassChunkJsonWithEntrance(
  WorldId: string;
  Coordinate: ChunkCoordinate;
  LocalX: integer;
  LocalY: integer
): string;
begin
  mutable var FeatureRows: string := '[';
  for Y: integer := 0 to WorldChunkSize - 1 do
    begin
      mutable var Row: string := Std.Str.RepeatStr('.', WorldChunkSize);
      if Y = LocalY then
        begin
          Row := Std.Str.SetCharAt(Row, LocalX, 'e');
        end;
      end if;

      if Y > 0 then
        begin
          FeatureRows := FeatureRows + ',';
        end;
      end if;

      FeatureRows := ((FeatureRows + '"') + Row) + '"';
    end;
  end for;
  mutable var Text: string := '{"version":' + IntToStr(WorldFormatVersion);
  Text := ((Text + ',"world_id":"') + WorldId) + '"';
  Text := (Text + ',"chunk_x":') + IntToStr(Coordinate.X);
  Text := (Text + ',"chunk_y":') + IntToStr(Coordinate.Y);
  Text := (Text + ',"base_rows":') + JsonRows('g', WorldChunkSize, WorldChunkSize);
  Text := ((Text + ',"feature_rows":') + FeatureRows) + ']';
  Text := (Text + ',"water_rows":') + JsonRows('.', WorldChunkSize, WorldChunkSize);
  return Text + '}';
end function;

// Returns the first ordinary entrance site near the origin, outside the spawn region.
function OrdinarySite(Metadata: WorldMetadata): WorldPosition;
begin
  var SpawnRegion: RegionCoordinate := RegionOf(Metadata, Metadata.Spawn);
  for RegionY: integer := -3 to 3 do
    begin
      for RegionX: integer := -3 to 3 do
        begin
          var Region: RegionCoordinate := record
            X := RegionX;
            Y := RegionY;
          end;

          if Region <> SpawnRegion then
            begin
              case EntranceSite(Metadata, Region) of
                when Some(Site):
                  begin
                    return Site;
                  end;
                else
                  begin
                    null;
                  end;
              end case;
            end;
          end if;
        end;
      end for;
    end;
  end for;

  panic('no ordinary entrance site near the origin');
end function;

function ConcurrentLoad(Root: string; Coordinate: ChunkCoordinate): result of boolean, string;
begin
  var World: WorldSession := try OpenWorld(Root, 'concurrent', 12345, 4, 8);
  var Loaded: ChunkLoad := try LoadWorldChunk(World, Coordinate);
  return Ok(Std.Arrays.Length(Loaded.Chunk.Cells) = WorldChunkSize * WorldChunkSize);
end function;

function FindHorizontalCrossing(Metadata: WorldMetadata; LeftX: integer; RightX: integer): integer;
begin
  for Y: integer := -2048 to 2048 do
    begin
      if IsWalkable(GenerateWorldCell(Metadata, LeftX, Y)) and
         IsWalkable(GenerateWorldCell(Metadata, RightX, Y)) then
        begin
          return Y;
        end;
      end if;
    end;
  end for;

  panic('expected a traversable horizontal chunk crossing');
end function;

function FindVerticalCrossing(Metadata: WorldMetadata; TopY: integer; BottomY: integer): integer;
begin
  for X: integer := -2048 to 2048 do
    begin
      if IsWalkable(GenerateWorldCell(Metadata, X, TopY)) and
         IsWalkable(GenerateWorldCell(Metadata, X, BottomY)) then
        begin
          return X;
        end;
      end if;
    end;
  end for;

  panic('expected a traversable vertical chunk crossing');
end function;

begin
  var Root: string := '.temp-data/world-storage-test-' + IntToStr(TimestampMillis());
  AssertTrue(Unwrap(EnsureTestRoot(Root)));
  mutable var World: WorldSession := Unwrap(OpenWorld(Root, 'storage', 12345, 4, 16));
  AssertTrue(Std.Fs.IsFile(WorldMetadataPath(World)));
  AssertEquals(WorldFormatVersion, World.Metadata.FormatVersion);
  AssertEquals(WorldChunkSize, World.Metadata.ChunkSize);
  var MetadataBeforeReload: string := Unwrap(Std.Fs.ReadText(WorldMetadataPath(World)));
  // Reopening ignores a changed configured seed and region size: the stored world keeps its values.
  var ReloadedWorld: WorldSession := Unwrap(OpenWorld(Root, 'storage', 99999, 9, 16));
  AssertEquals(4, ReloadedWorld.Metadata.DungeonRegionChunks);
  AssertEquals(World.Metadata.SpawnEntrance.X, ReloadedWorld.Metadata.SpawnEntrance.X);
  AssertEquals(World.Metadata.SpawnEntrance.Y, ReloadedWorld.Metadata.SpawnEntrance.Y);
  AssertEquals(MetadataBeforeReload, Unwrap(Std.Fs.ReadText(WorldMetadataPath(ReloadedWorld))));
  var EntranceCoordinate: ChunkCoordinate := record
    X := ChunkForCoordinate(World.Metadata.SpawnEntrance.X);
    Y := ChunkForCoordinate(World.Metadata.SpawnEntrance.Y);
  end;
  var EntranceChunk: WorldChunk := Unwrap(LoadWorldChunk(World, EntranceCoordinate)).Chunk;
  AssertEquals(1, CountEntrances(EntranceChunk));
  AssertTrue(ChunkCell(EntranceChunk, LocalForCoordinate(World.Metadata.SpawnEntrance.X), LocalForCoordinate(World.Metadata.SpawnEntrance.Y)).Feature =
             TerrainFeatureKind.Entrance);
  var Coordinate: ChunkCoordinate := record
    X := -1;
    Y := 2;
  end;
  var First: ChunkLoad := Unwrap(LoadWorldChunk(World, Coordinate));
  World := First.World;
  var Path: string := WorldChunkPath(World, Coordinate);
  AssertTrue(Std.Fs.IsFile(Path));
  var Stored: string := Unwrap(Std.Fs.ReadText(Path));
  var Second: ChunkLoad := Unwrap(LoadWorldChunk(Unwrap(OpenWorld(Root, 'storage', 99999, 4, 16)), Coordinate));
  AssertEquals(Stored, Unwrap(Std.Fs.ReadText(Path)));
  AssertTrue(VisibleCellCode(First.Chunk.Cells[0]) = VisibleCellCode(Second.Chunk.Cells[0]));
  var State: GameState := NewGame(World.Metadata);
  var WindowResult: WindowLoad := Unwrap(LoadVisibleWindow(World, State, 17, 9));
  World := WindowResult.World;
  AssertEquals(RequireOutdoor(State).X - 8, WindowResult.Window.OriginX);
  AssertEquals(RequireOutdoor(State).Y - 4, WindowResult.Window.OriginY);
  AssertEquals(17, WindowResult.Window.Width);
  AssertEquals(9, Std.Arrays.Length(WindowResult.Window.Rows));
  AssertEquals(17, Std.Str.Length(WindowResult.Window.Rows[0]));
  AssertTrue(CachedChunkCount(World) <= 16);
  var WithinOne: ChunkRange := Unwrap(ChunkRangeForWindow(10, 10, 5, 5));
  AssertEquals(0, WithinOne.MinimumX);
  AssertEquals(0, WithinOne.MaximumX);
  var AcrossEdge: ChunkRange := Unwrap(ChunkRangeForWindow(127, 20, 2, 2));
  AssertEquals(0, AcrossEdge.MinimumX);
  AssertEquals(1, AcrossEdge.MaximumX);
  var AcrossCorners: ChunkRange := Unwrap(ChunkRangeForWindow(127, 127, 2, 2));
  AssertEquals(0, AcrossCorners.MinimumX);
  AssertEquals(1, AcrossCorners.MaximumX);
  AssertEquals(0, AcrossCorners.MinimumY);
  AssertEquals(1, AcrossCorners.MaximumY);
  var NegativeEdge: ChunkRange := Unwrap(ChunkRangeForWindow(-129, -129, 2, 2));
  AssertEquals(-2, NegativeEdge.MinimumX);
  AssertEquals(-1, NegativeEdge.MaximumX);
  AssertEquals(-2, NegativeEdge.MinimumY);
  AssertEquals(-1, NegativeEdge.MaximumY);
  var AcrossMany: ChunkRange := Unwrap(ChunkRangeForWindow(-200, -200, 520, 520));
  AssertTrue((AcrossMany.MaximumX - AcrossMany.MinimumX) + 1 > 3);
  AssertTrue((AcrossMany.MaximumY - AcrossMany.MinimumY) + 1 > 3);
  var WideWorld: WorldSession := Unwrap(OpenWorld(Root, 'storage', 12345, 4, 64));
  var WideWindow: WindowLoad := Unwrap(LoadVisibleWindow(WideWorld, State, 385, 385));
  AssertEquals(385, WideWindow.Window.Width);
  AssertEquals(385, WideWindow.Window.Height);
  AssertEquals(385, Std.Str.Length(WideWindow.Window.Rows[384]));
  AssertTrue(CachedChunkCount(WideWindow.World) <= 64);
  var Moved: WorldMove := Unwrap(MoveInWorld(World, State, -1, 0));
  AssertEquals(RequireOutdoor(State).X - 1, RequireOutdoor(Moved.State).X);
  AssertEquals(RequireOutdoor(State).Y, RequireOutdoor(Moved.State).Y);
  var RightY: integer := FindHorizontalCrossing(World.Metadata, 127, 128);
  var CrossRight: WorldMove := Unwrap(MoveInWorld(World, record
    Area := AreaKind.OutdoorRegion;
    AreaId := World.Metadata.OutdoorAreaId;
    Player := PlayerPosition.Outdoor(record
      X := 127;
      Y := RightY;
    end);
    ReturnLocation := ReturnLocation.NoReturnLocation;
    VisitedAreas := [];
    Exploration := EmptyExploration();
    Items := NewGame(World.Metadata).Items;
    Health := NewGame(World.Metadata).Health;
    Hostiles := NewGame(World.Metadata).Hostiles;
    RandomState := NewGame(World.Metadata).RandomState;
  end, 1, 0));
  AssertEquals(128, RequireOutdoor(CrossRight.State).X);
  var LeftY: integer := FindHorizontalCrossing(World.Metadata, -128, -129);
  var CrossLeft: WorldMove := Unwrap(MoveInWorld(World, record
    Area := AreaKind.OutdoorRegion;
    AreaId := World.Metadata.OutdoorAreaId;
    Player := PlayerPosition.Outdoor(record
      X := -128;
      Y := LeftY;
    end);
    ReturnLocation := ReturnLocation.NoReturnLocation;
    VisitedAreas := [];
    Exploration := EmptyExploration();
    Items := NewGame(World.Metadata).Items;
    Health := NewGame(World.Metadata).Health;
    Hostiles := NewGame(World.Metadata).Hostiles;
    RandomState := NewGame(World.Metadata).RandomState;
  end, -1, 0));
  AssertEquals(-129, RequireOutdoor(CrossLeft.State).X);
  var DownX: integer := FindVerticalCrossing(World.Metadata, 127, 128);
  var CrossDown: WorldMove := Unwrap(MoveInWorld(World, record
    Area := AreaKind.OutdoorRegion;
    AreaId := World.Metadata.OutdoorAreaId;
    Player := PlayerPosition.Outdoor(record
      X := DownX;
      Y := 127;
    end);
    ReturnLocation := ReturnLocation.NoReturnLocation;
    VisitedAreas := [];
    Exploration := EmptyExploration();
    Items := NewGame(World.Metadata).Items;
    Health := NewGame(World.Metadata).Health;
    Hostiles := NewGame(World.Metadata).Hostiles;
    RandomState := NewGame(World.Metadata).RandomState;
  end, 0, 1));
  AssertEquals(128, RequireOutdoor(CrossDown.State).Y);
  var UpX: integer := FindVerticalCrossing(World.Metadata, -128, -129);
  var CrossUp: WorldMove := Unwrap(MoveInWorld(World, record
    Area := AreaKind.OutdoorRegion;
    AreaId := World.Metadata.OutdoorAreaId;
    Player := PlayerPosition.Outdoor(record
      X := UpX;
      Y := -128;
    end);
    ReturnLocation := ReturnLocation.NoReturnLocation;
    VisitedAreas := [];
    Exploration := EmptyExploration();
    Items := NewGame(World.Metadata).Items;
    Health := NewGame(World.Metadata).Health;
    Hostiles := NewGame(World.Metadata).Hostiles;
    RandomState := NewGame(World.Metadata).RandomState;
  end, 0, -1));
  AssertEquals(-129, RequireOutdoor(CrossUp.State).Y);
  AssertTrue(IsError(OpenWorld(Root, '../escape', 1, 4, 16)));
  AssertTrue(IsError(OpenWorld(Root, '', 1, 4, 16)));
  AssertTrue(IsError(OpenWorld(Root, Std.Str.RepeatStr('a', 65), 1, 4, 16)));
  AssertTrue(IsError(OpenWorld(Root, 'welt-ä', 1, 4, 16)));
  var MaximumIdWorld: WorldSession := Unwrap(OpenWorld(Root, Std.Str.RepeatStr('a', 64), 1, 4, 16));
  AssertEquals(64, MaximumIdWorld.Metadata.Id.Length());
  AssertTrue(IsError(OpenWorld(Root, 'storage', 1, 4, 0)));
  mutable var SmallCache: WorldSession := Unwrap(OpenWorld(Root, 'small-cache', 12345, 4, 2));
  var CachedA: ChunkLoad := Unwrap(LoadWorldChunk(SmallCache, record
    X := 10;
    Y := 10;
  end));
  SmallCache := CachedA.World;
  var CachedB: ChunkLoad := Unwrap(LoadWorldChunk(SmallCache, record
    X := 11;
    Y := 10;
  end));
  SmallCache := CachedB.World;
  var CachedC: ChunkLoad := Unwrap(LoadWorldChunk(SmallCache, record
    X := 12;
    Y := 10;
  end));
  SmallCache := CachedC.World;
  AssertEquals(2, CachedChunkCount(SmallCache));
  AssertEquals(11, SmallCache.Cache[0].Chunk.Coordinate.X);
  AssertEquals(12, SmallCache.Cache[1].Chunk.Coordinate.X);
  var InvalidVersionDirectory: string := Std.Path.Join([Root, 'invalid-version']);
  AssertTrue(Unwrap(EnsureChild(InvalidVersionDirectory)));
  var InvalidVersionPath: string := Std.Path.Join([InvalidVersionDirectory, 'world.json']);
  var InvalidVersionText: string := MetadataJson('invalid-version', 99, WorldGeneratorVersion, WorldChunkSize, 0, 0);
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(InvalidVersionPath, InvalidVersionText)));
  AssertTrue(IsError(OpenWorld(Root, 'invalid-version', 1, 4, 8)));
  AssertEquals(InvalidVersionText, Unwrap(Std.Fs.ReadText(InvalidVersionPath)));
  var MissingFieldDirectory: string := Std.Path.Join([Root, 'missing-field']);
  AssertTrue(Unwrap(EnsureChild(MissingFieldDirectory)));
  var MissingFieldText: string := '{"version":2,"id":"missing-field"}';
  var MissingFieldPath: string := Std.Path.Join([MissingFieldDirectory, 'world.json']);
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(MissingFieldPath, MissingFieldText)));
  AssertTrue(IsError(OpenWorld(Root, 'missing-field', 12345, 4, 8)));
  AssertEquals(MissingFieldText, Unwrap(Std.Fs.ReadText(MissingFieldPath)));
  var InvalidSizeDirectory: string := Std.Path.Join([Root, 'invalid-size']);
  AssertTrue(Unwrap(EnsureChild(InvalidSizeDirectory)));
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(Std.Path.Join([InvalidSizeDirectory, 'world.json']), MetadataJson('invalid-size', WorldFormatVersion, WorldGeneratorVersion, 127, 0, 0))));
  AssertTrue(IsError(OpenWorld(Root, 'invalid-size', 1, 4, 8)));
  var MismatchDirectory: string := Std.Path.Join([Root, 'mismatch']);
  AssertTrue(Unwrap(EnsureChild(MismatchDirectory)));
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(Std.Path.Join([MismatchDirectory, 'world.json']), MetadataJson('different', WorldFormatVersion, WorldGeneratorVersion, WorldChunkSize, 0, 0))));
  AssertTrue(IsError(OpenWorld(Root, 'mismatch', 1, 4, 8)));
  var LegacyGeneratorDirectory: string := Std.Path.Join([Root, 'legacy-generator']);
  AssertTrue(Unwrap(EnsureChild(LegacyGeneratorDirectory)));
  var LegacyGeneratorPath: string := Std.Path.Join([LegacyGeneratorDirectory, 'world.json']);
  var LegacyGeneratorText: string := MetadataJson('legacy-generator', WorldFormatVersion, WorldGeneratorVersion -
                                                                                          1, WorldChunkSize, 0, 0);
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(LegacyGeneratorPath, LegacyGeneratorText)));
  AssertTrue(IsError(OpenWorld(Root, 'legacy-generator', 1, 4, 8)));
  AssertEquals(LegacyGeneratorText, Unwrap(Std.Fs.ReadText(LegacyGeneratorPath)));
  mutable var BlockedX: integer := 100;
  var InvalidSpawnMetadata: WorldMetadata := Unwrap(NewWorldMetadata('invalid-spawn', 12345, 4));
  while IsWalkable(GenerateWorldCell(InvalidSpawnMetadata, BlockedX, 100)) do
    begin
      BlockedX := BlockedX + 1;
    end;
  end while;
  var InvalidSpawnDirectory: string := Std.Path.Join([Root, 'invalid-spawn']);
  AssertTrue(Unwrap(EnsureChild(InvalidSpawnDirectory)));
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(Std.Path.Join([InvalidSpawnDirectory, 'world.json']), MetadataJson('invalid-spawn', WorldFormatVersion, WorldGeneratorVersion, WorldChunkSize, BlockedX, 100))));
  AssertTrue(IsError(OpenWorld(Root, 'invalid-spawn', 1, 4, 8)));
  var ConflictingEntranceDirectory: string := Std.Path.Join([Root, 'conflicting-entrance']);
  AssertTrue(Unwrap(EnsureChild(ConflictingEntranceDirectory)));
  var ConflictingMetadata: WorldMetadata := Unwrap(NewWorldMetadata('conflicting-entrance', 12345, 4));
  mutable var ConflictingX: integer := 100;
  while IsWalkable(GenerateWorldCell(ConflictingMetadata, ConflictingX, 100)) do
    begin
      ConflictingX := ConflictingX + 1;
    end;
  end while;
  var ConflictingText: string := MetadataJsonWithEntrance('conflicting-entrance', WorldFormatVersion, WorldGeneratorVersion, WorldChunkSize, ConflictingMetadata.Spawn.X, ConflictingMetadata.Spawn.Y, ConflictingX, 100, 4);
  var ConflictingPath: string := Std.Path.Join([ConflictingEntranceDirectory, 'world.json']);
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(ConflictingPath, ConflictingText)));
  AssertTrue(IsError(OpenWorld(Root, 'conflicting-entrance', 12345, 4, 8)));
  AssertEquals(ConflictingText, Unwrap(Std.Fs.ReadText(ConflictingPath)));
  // Stored region sizes outside 1 through 16 are rejected without rewriting the file.
  var WrongRegionDirectory: string := Std.Path.Join([Root, 'wrong-region']);
  AssertTrue(Unwrap(EnsureChild(WrongRegionDirectory)));
  var WrongRegionMetadata: WorldMetadata := Unwrap(NewWorldMetadata('wrong-region', 12345, 4));
  var WrongRegionText: string := MetadataJsonWithEntrance('wrong-region', WorldFormatVersion, WorldGeneratorVersion, WorldChunkSize, WrongRegionMetadata.Spawn.X, WrongRegionMetadata.Spawn.Y, WrongRegionMetadata.SpawnEntrance.X, WrongRegionMetadata.SpawnEntrance.Y, 17);
  var WrongRegionPath: string := Std.Path.Join([WrongRegionDirectory, 'world.json']);
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(WrongRegionPath, WrongRegionText)));
  AssertTrue(IsError(OpenWorld(Root, 'wrong-region', 12345, 4, 8)));
  AssertEquals(WrongRegionText, Unwrap(Std.Fs.ReadText(WrongRegionPath)));
  AssertTrue(IsError(OpenWorld(Root, 'new-wrong-region', 12345, 0, 8)));
  mutable var InvalidChunkWorld: WorldSession := Unwrap(OpenWorld(Root, 'invalid-chunks', 12345, 4, 8));
  var InvalidCoordinate: ChunkCoordinate := record
    X := 20;
    Y := -20;
  end;
  var InvalidColumn: string := Std.Path.Join([InvalidChunkWorld.Directory, 'chunks', 'x_20']);
  AssertTrue(Unwrap(EnsureChild(InvalidColumn)));
  var InvalidChunkPath: string := WorldChunkPath(InvalidChunkWorld, InvalidCoordinate);
  var InvalidChunkText: string := ChunkJson('invalid-chunks', 20, -20, WorldFormatVersion, 'x', WorldChunkSize, WorldChunkSize);
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(InvalidChunkPath, InvalidChunkText)));
  AssertTrue(IsError(LoadWorldChunk(InvalidChunkWorld, InvalidCoordinate)));
  AssertEquals(InvalidChunkText, Unwrap(Std.Fs.ReadText(InvalidChunkPath)));
  var MalformedCoordinate: ChunkCoordinate := record
    X := 21;
    Y := -20;
  end;
  var MalformedColumn: string := Std.Path.Join([InvalidChunkWorld.Directory, 'chunks', 'x_21']);
  AssertTrue(Unwrap(EnsureChild(MalformedColumn)));
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(WorldChunkPath(InvalidChunkWorld, MalformedCoordinate), ChunkJson('invalid-chunks', 21, -20, WorldFormatVersion, 'g', 127, WorldChunkSize))));
  AssertTrue(IsError(LoadWorldChunk(InvalidChunkWorld, MalformedCoordinate)));
  var WrongCoordinate: ChunkCoordinate := record
    X := 22;
    Y := -20;
  end;
  var WrongColumn: string := Std.Path.Join([InvalidChunkWorld.Directory, 'chunks', 'x_22']);
  AssertTrue(Unwrap(EnsureChild(WrongColumn)));
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(WorldChunkPath(InvalidChunkWorld, WrongCoordinate), ChunkJson('invalid-chunks', 999, -20, WorldFormatVersion, 'g', WorldChunkSize, WorldChunkSize))));
  AssertTrue(IsError(LoadWorldChunk(InvalidChunkWorld, WrongCoordinate)));
  var WrongVersionCoordinate: ChunkCoordinate := record
    X := 23;
    Y := -20;
  end;
  var WrongVersionColumn: string := Std.Path.Join([InvalidChunkWorld.Directory, 'chunks', 'x_23']);
  AssertTrue(Unwrap(EnsureChild(WrongVersionColumn)));
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(WorldChunkPath(InvalidChunkWorld, WrongVersionCoordinate), ChunkJson('invalid-chunks', 23, -20, 99, 'g', WorldChunkSize, WorldChunkSize))));
  AssertTrue(IsError(LoadWorldChunk(InvalidChunkWorld, WrongVersionCoordinate)));
  var WrongWorldCoordinate: ChunkCoordinate := record
    X := 24;
    Y := -20;
  end;
  var WrongWorldColumn: string := Std.Path.Join([InvalidChunkWorld.Directory, 'chunks', 'x_24']);
  AssertTrue(Unwrap(EnsureChild(WrongWorldColumn)));
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(WorldChunkPath(InvalidChunkWorld, WrongWorldCoordinate), ChunkJson('another-world', 24, -20, WorldFormatVersion, 'g', WorldChunkSize, WorldChunkSize))));
  AssertTrue(IsError(LoadWorldChunk(InvalidChunkWorld, WrongWorldCoordinate)));
  var WrongRowCountCoordinate: ChunkCoordinate := record
    X := 25;
    Y := -20;
  end;
  var WrongRowCountColumn: string := Std.Path.Join([InvalidChunkWorld.Directory, 'chunks', 'x_25']);
  AssertTrue(Unwrap(EnsureChild(WrongRowCountColumn)));
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(WorldChunkPath(InvalidChunkWorld, WrongRowCountCoordinate), ChunkJson('invalid-chunks', 25, -20, WorldFormatVersion, 'g', WorldChunkSize, 127))));
  AssertTrue(IsError(LoadWorldChunk(InvalidChunkWorld, WrongRowCountCoordinate)));
  var DuplicateEntranceCoordinate: ChunkCoordinate := record
    X := 26;
    Y := -20;
  end;
  var DuplicateEntranceColumn: string := Std.Path.Join([
                                                         InvalidChunkWorld.Directory,
                                                         'chunks',
                                                         'x_26'
                                                       ]);
  AssertTrue(Unwrap(EnsureChild(DuplicateEntranceColumn)));
  var DuplicateEntrancePath: string := WorldChunkPath(InvalidChunkWorld, DuplicateEntranceCoordinate);
  var DuplicateEntranceText: string := ChunkJsonWithFeature('invalid-chunks', 26, -20, 'e');
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(DuplicateEntrancePath, DuplicateEntranceText)));
  AssertTrue(IsError(LoadWorldChunk(InvalidChunkWorld, DuplicateEntranceCoordinate)));
  AssertEquals(DuplicateEntranceText, Unwrap(Std.Fs.ReadText(DuplicateEntrancePath)));
  // A stored chunk carries an entrance exactly on an entrance field whose stored cell is clear land.
  var Site: WorldPosition := OrdinarySite(InvalidChunkWorld.Metadata);
  var SiteCoordinate: ChunkCoordinate := record
    X := ChunkForCoordinate(Site.X);
    Y := ChunkForCoordinate(Site.Y);
  end;
  var SiteLoad: ChunkLoad := Unwrap(LoadWorldChunk(InvalidChunkWorld, SiteCoordinate));
  AssertTrue(ChunkCell(SiteLoad.Chunk, LocalForCoordinate(Site.X), LocalForCoordinate(Site.Y)).Feature =
             TerrainFeatureKind.Entrance);
  var SitePath: string := WorldChunkPath(InvalidChunkWorld, SiteCoordinate);
  var SiteX: integer := LocalForCoordinate(Site.X);
  var SiteY: integer := LocalForCoordinate(Site.Y);
  var Matching: string := GrassChunkJsonWithEntrance('invalid-chunks', SiteCoordinate, SiteX, SiteY);
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(SitePath, Matching)));
  AssertTrue(IsOk(LoadWorldChunk(Unwrap(OpenWorld(Root, 'invalid-chunks', 12345, 4, 8)), SiteCoordinate)));
  var Missing: string := GrassChunkJsonWithEntrance('invalid-chunks', SiteCoordinate, -1, -1);
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(SitePath, Missing)));
  AssertTrue(IsError(LoadWorldChunk(Unwrap(OpenWorld(Root, 'invalid-chunks', 12345, 4, 8)), SiteCoordinate)));
  AssertEquals(Missing, Unwrap(Std.Fs.ReadText(SitePath)));
  var ShiftedX: integer := (SiteX + 1) mod WorldChunkSize;
  var Shifted: string := GrassChunkJsonWithEntrance('invalid-chunks', SiteCoordinate, ShiftedX, SiteY);
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(SitePath, Shifted)));
  AssertTrue(IsError(LoadWorldChunk(Unwrap(OpenWorld(Root, 'invalid-chunks', 12345, 4, 8)), SiteCoordinate)));
  var ConcurrentWorld: WorldSession := Unwrap(OpenWorld(Root, 'concurrent', 12345, 4, 8));
  var ConcurrentCoordinate: ChunkCoordinate := record
    X := 31;
    Y := 17;
  end;
  var FirstTask: task := go ConcurrentLoad(Root, ConcurrentCoordinate);
  var SecondTask: task := go ConcurrentLoad(Root, ConcurrentCoordinate);
  AssertTrue(Unwrap(Std.Tasks.Wait(FirstTask)));
  AssertTrue(Unwrap(Std.Tasks.Wait(SecondTask)));
  var ConcurrentResult: ChunkLoad := Unwrap(LoadWorldChunk(ConcurrentWorld, ConcurrentCoordinate));
  AssertEquals(WorldChunkSize * WorldChunkSize, Std.Arrays.Length(ConcurrentResult.Chunk.Cells));
end.
