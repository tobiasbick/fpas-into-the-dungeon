// Verifies world creation, chunk persistence, validation, composition, and cache limits.
program DungeonWorldStorageTest;

uses Dungeon.Terrain.Chunks as ChunksUnit, Dungeon.Terrain.Entrances as Entrances, Dungeon.Coordinates as Coordinates, Dungeon.Exploration.Model as Model, Dungeon.GameState as GameState, Dungeon.Progression as Progression, Dungeon.Terrain as Terrain, Dungeon.Terrain.Generation as TerrainGeneration, Dungeon.Terrain.Placement as PlacementRules, Dungeon.World as WorldUnit, Std.Conv as Conv, Std.Fs as Fs, Std.Path as PathOps, Std.Tasks as Tasks, Std.Test as Test, Std.Time as Time;

function EnsureTestRoot(Path: string): result of (boolean, Fs.FsError);
begin
  if not Fs.Exists('.temp-data') then
    begin
      const CreatedBase: boolean := try Fs.CreateDir('.temp-data');
    end;
  end if;

  if not Fs.Exists(Path) then
    begin
      const Created: boolean := try Fs.CreateDir(Path);
    end;
  end if;

  return Ok(true);
end function;

function EnsureChild(Path: string): result of (boolean, Fs.FsError);
begin
  if Fs.Exists(Path) then
    begin
      return Ok(Fs.IsDir(Path));
    end;
  end if;

  return Fs.CreateDir(Path);
end function;

function RequireOutdoor(State: GameState.GameState): Coordinates.WorldPosition;
begin
  return GameState.OutdoorPlayerPosition(State).Unwrap();
end function;

function MetadataJsonWithEntrance(
  Id: string;
  FormatVersion: integer;
  GeneratorVersion: integer;
  ChunkSize: integer;
  SpawnX: integer;
  SpawnY: integer;
  EntranceX: integer;
  EntranceY: integer;
  RegionChunks: integer
): string;
begin
  const Expected: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(Id, 12345, 4).Unwrap();
  var Text: string := '{"version":' + Conv.IntToStr(FormatVersion);
  Text := ((Text + ',"id":"') + Id) + '"';
  Text := (Text + ',"seed":12345,"generator_version":') + Conv.IntToStr(GeneratorVersion);
  Text := (Text + ',"chunk_size":') + Conv.IntToStr(ChunkSize);
  Text := (Text + ',"spawn_x":') + Conv.IntToStr(SpawnX);
  Text := (Text + ',"spawn_y":') + Conv.IntToStr(SpawnY);
  Text := ((Text + ',"outdoor_area_id":"') + Expected.OutdoorAreaId) + '"';
  Text := ((Text + ',"outdoor_area_label":"') + Expected.OutdoorAreaLabel) + '"';
  Text := (Text + ',"spawn_entrance_x":') + Conv.IntToStr(EntranceX);
  Text := (Text + ',"spawn_entrance_y":') + Conv.IntToStr(EntranceY);
  Text := Text + ',"settlement_gate":{"x":' + Conv.IntToStr(Expected.SettlementGate.X) +
    ',"y":' + Conv.IntToStr(Expected.SettlementGate.Y) + '}';
  Text := (Text + ',"dungeon_region_chunks":') + Conv.IntToStr(RegionChunks);
  return Text + '}';
end function;

function MetadataJson(
  Id: string;
  FormatVersion: integer;
  GeneratorVersion: integer;
  ChunkSize: integer;
  SpawnX: integer;
  SpawnY: integer
): string;
begin
  const Expected: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(Id, 12345, 4).Unwrap();
  return MetadataJsonWithEntrance(
    Id,
    FormatVersion,
    GeneratorVersion,
    ChunkSize,
    SpawnX,
    SpawnY,
    Expected.SpawnEntrance.X,
    Expected.SpawnEntrance.Y,
    4
  );
end function;

function CountEntrances(Chunk: Terrain.WorldChunk): integer;
begin
  var Count: integer := 0;
  for Cell: Terrain.WorldCell in Chunk.Cells do
    begin
      if Cell.Feature = Terrain.TerrainFeatureKind.Entrance then
        begin
          Count := Count + 1;
        end;
      end if;
    end;
  end for;

  return Count;
end function;

function JsonRows(Code: string; Width: integer; Count: integer): string;
begin
  var Text: string := '[';
  for Index: integer := 0 to Count - 1 do
    begin
      if Index > 0 then
        begin
          Text := Text + ',';
        end;
      end if;

      Text := ((Text + '"') + Code.RepeatStr(Width)) + '"';
    end;
  end for;

  return Text + ']';
end function;

function ChunkJson(
  WorldId: string;
  ChunkX: integer;
  ChunkY: integer;
  Version: integer;
  BaseCode: string;
  Width: integer;
  Count: integer
): string;
begin
  var Text: string := '{"version":' + Conv.IntToStr(Version);
  Text := ((Text + ',"world_id":"') + WorldId) + '"';
  Text := (Text + ',"chunk_x":') + Conv.IntToStr(ChunkX);
  Text := (Text + ',"chunk_y":') + Conv.IntToStr(ChunkY);
  Text := (Text + ',"base_rows":') + JsonRows(BaseCode, Width, Count);
  Text := (Text + ',"feature_rows":') + JsonRows('.', Width, Count);
  Text := (Text + ',"water_rows":') + JsonRows('.', Width, Count);
  return Text + '}';
end function;

function ChunkJsonWithFeature(
  WorldId: string;
  ChunkX: integer;
  ChunkY: integer;
  FeatureCode: string
): string;
begin
  var Text: string := '{"version":' + Conv.IntToStr(Terrain.WorldFormatVersion);
  Text := ((Text + ',"world_id":"') + WorldId) + '"';
  Text := (Text + ',"chunk_x":') + Conv.IntToStr(ChunkX);
  Text := (Text + ',"chunk_y":') + Conv.IntToStr(ChunkY);
  Text := (Text + ',"base_rows":') +
    JsonRows('g', Coordinates.WorldChunkSize, Coordinates.WorldChunkSize);
  Text := (Text + ',"feature_rows":') +
    JsonRows(FeatureCode, Coordinates.WorldChunkSize, Coordinates.WorldChunkSize);
  Text := (Text + ',"water_rows":') +
    JsonRows('.', Coordinates.WorldChunkSize, Coordinates.WorldChunkSize);
  return Text + '}';
end function;

// Builds an all-grass chunk whose only feature is an entrance at one local field, or none for -1.
function GrassChunkJsonWithEntrance(
  WorldId: string;
  Coordinate: Coordinates.ChunkCoordinate;
  LocalX: integer;
  LocalY: integer
): string;
begin
  var FeatureRows: string := '[';
  for Y: integer := 0 to Coordinates.WorldChunkSize - 1 do
    begin
      var Row: string := '.'.RepeatStr(Coordinates.WorldChunkSize);
      if Y = LocalY then
        begin
          Row := Row.SetCharAt(LocalX, 'e');
        end;
      end if;

      if Y > 0 then
        begin
          FeatureRows := FeatureRows + ',';
        end;
      end if;

      FeatureRows := ((FeatureRows + '"') + Row) + '"';
    end;
  end for;
  var Text: string := '{"version":' + Conv.IntToStr(Terrain.WorldFormatVersion);
  Text := ((Text + ',"world_id":"') + WorldId) + '"';
  Text := (Text + ',"chunk_x":') + Conv.IntToStr(Coordinate.X);
  Text := (Text + ',"chunk_y":') + Conv.IntToStr(Coordinate.Y);
  Text := (Text + ',"base_rows":') +
    JsonRows('g', Coordinates.WorldChunkSize, Coordinates.WorldChunkSize);
  Text := ((Text + ',"feature_rows":') + FeatureRows) + ']';
  Text := (Text + ',"water_rows":') +
    JsonRows('.', Coordinates.WorldChunkSize, Coordinates.WorldChunkSize);
  return Text + '}';
end function;

// Returns the first ordinary entrance site near the origin, outside the spawn region.
function OrdinarySite(Metadata: Terrain.WorldMetadata): Coordinates.WorldPosition;
begin
  const SpawnRegion: Entrances.RegionCoordinate := Entrances.RegionOf(Metadata, Metadata.Spawn);
  for RegionY: integer := -3 to 3 do
    begin
      for RegionX: integer := -3 to 3 do
        begin
          const Region: Entrances.RegionCoordinate := Entrances.RegionCoordinate(
            X := RegionX,
            Y := RegionY
          );
          if Region <> SpawnRegion then
            begin
              case Entrances.EntranceSite(Metadata, Region) of
                when Some(const Site):
                  return Site;
                when None:
                  null;
              end case;
            end;
          end if;
        end;
      end for;
    end;
  end for;

  panic('no ordinary entrance site near the origin');
end function;

function ConcurrentLoad(Root: string; Coordinate: Coordinates.ChunkCoordinate): result of (boolean, string);
begin
  const World: WorldUnit.WorldSession := try WorldUnit.OpenWorld(Root, 'concurrent', 12345, 4, 8);
  const Loaded: WorldUnit.ChunkLoad := try WorldUnit.LoadWorldChunk(World, Coordinate);
  return Ok(Loaded.Chunk.Cells.Length() = Coordinates.WorldChunkSize * Coordinates.WorldChunkSize);
end function;

function FindHorizontalCrossing(Metadata: Terrain.WorldMetadata; LeftX: integer; RightX: integer): integer;
begin
  for Y: integer := -2048 to 2048 do
    begin
      if Terrain.IsWalkable(ChunksUnit.GenerateWorldCell(Metadata, LeftX, Y))
        and
        Terrain.IsWalkable(ChunksUnit.GenerateWorldCell(Metadata, RightX, Y))
      then
        begin
          return Y;
        end;
      end if;
    end;
  end for;

  panic('expected a traversable horizontal chunk crossing');
end function;

function FindVerticalCrossing(Metadata: Terrain.WorldMetadata; TopY: integer; BottomY: integer): integer;
begin
  for X: integer := -2048 to 2048 do
    begin
      if Terrain.IsWalkable(ChunksUnit.GenerateWorldCell(Metadata, X, TopY))
        and
        Terrain.IsWalkable(ChunksUnit.GenerateWorldCell(Metadata, X, BottomY))
      then
        begin
          return X;
        end;
      end if;
    end;
  end for;

  panic('expected a traversable vertical chunk crossing');
end function;

begin
  const Root: string := '.temp-data/world-storage-test-' + Conv.IntToStr(Time.TimestampMillis());
  Test.AssertTrue(EnsureTestRoot(Root).Unwrap());
  var World: WorldUnit.WorldSession := WorldUnit.OpenWorld(Root, 'storage', 12345, 4, 16).Unwrap();
  Test.AssertTrue(Fs.IsFile(WorldUnit.WorldMetadataPath(World)));
  Test.AssertEquals(Terrain.WorldFormatVersion, World.Metadata.FormatVersion);
  Test.AssertEquals(Coordinates.WorldChunkSize, World.Metadata.ChunkSize);
  const MetadataBeforeReload: string := Fs.ReadText(WorldUnit.WorldMetadataPath(World)).Unwrap();
  // Reopening ignores a changed configured seed and region size: the stored world keeps its values.
  const ReloadedWorld: WorldUnit.WorldSession := WorldUnit.OpenWorld(
    Root,
    'storage',
    99999,
    9,
    16
  ).Unwrap();
  Test.AssertEquals(4, ReloadedWorld.Metadata.DungeonRegionChunks);
  Test.AssertEquals(World.Metadata.SpawnEntrance.X, ReloadedWorld.Metadata.SpawnEntrance.X);
  Test.AssertEquals(World.Metadata.SpawnEntrance.Y, ReloadedWorld.Metadata.SpawnEntrance.Y);
  Test.AssertEquals(
    MetadataBeforeReload,
    Fs.ReadText(WorldUnit.WorldMetadataPath(ReloadedWorld)).Unwrap()
  );
  const EntranceCoordinate: Coordinates.ChunkCoordinate := Coordinates.ChunkCoordinate(
    X := Coordinates.ChunkForCoordinate(World.Metadata.SpawnEntrance.X),
    Y := Coordinates.ChunkForCoordinate(World.Metadata.SpawnEntrance.Y)
  );
  const EntranceChunk: Terrain.WorldChunk := WorldUnit.LoadWorldChunk(
    World,
    EntranceCoordinate
  ).Unwrap().Chunk;
  Test.AssertEquals(1, CountEntrances(EntranceChunk));
  Test.AssertTrue(
    Terrain.ChunkCell(
      EntranceChunk,
      Coordinates.LocalForCoordinate(World.Metadata.SpawnEntrance.X),
      Coordinates.LocalForCoordinate(World.Metadata.SpawnEntrance.Y)
    ).Feature =
    Terrain.TerrainFeatureKind.Entrance
  );
  const Coordinate: Coordinates.ChunkCoordinate := Coordinates.ChunkCoordinate(X := -1, Y := 2);
  const First: WorldUnit.ChunkLoad := WorldUnit.LoadWorldChunk(World, Coordinate).Unwrap();
  World := First.World;
  const Path: string := WorldUnit.WorldChunkPath(World, Coordinate);
  Test.AssertTrue(Fs.IsFile(Path));
  const Stored: string := Fs.ReadText(Path).Unwrap();
  const Second: WorldUnit.ChunkLoad := WorldUnit.LoadWorldChunk(
    WorldUnit.OpenWorld(Root, 'storage', 99999, 4, 16).Unwrap(),
    Coordinate
  ).Unwrap();
  Test.AssertEquals(Stored, Fs.ReadText(Path).Unwrap());
  Test.AssertTrue(
    Terrain.VisibleCellCode(First.Chunk.Cells[0]) = Terrain.VisibleCellCode(Second.Chunk.Cells[0])
  );
  const State: GameState.GameState := GameState.NewGame(World.Metadata);
  const WindowResult: WorldUnit.WindowLoad := WorldUnit.LoadVisibleWindow(
    World,
    State,
    17,
    9
  ).Unwrap();
  World := WindowResult.World;
  Test.AssertEquals(RequireOutdoor(State).X - 8, WindowResult.Window.OriginX);
  Test.AssertEquals(RequireOutdoor(State).Y - 4, WindowResult.Window.OriginY);
  Test.AssertEquals(17, WindowResult.Window.Width);
  Test.AssertEquals(9, WindowResult.Window.Rows.Length());
  Test.AssertEquals(17, WindowResult.Window.Rows[0].Length());
  Test.AssertTrue(WorldUnit.CachedChunkCount(World) <= 16);
  const WithinOne: WorldUnit.ChunkRange := WorldUnit.ChunkRangeForWindow(10, 10, 5, 5).Unwrap();
  Test.AssertEquals(0, WithinOne.MinimumX);
  Test.AssertEquals(0, WithinOne.MaximumX);
  const AcrossEdge: WorldUnit.ChunkRange := WorldUnit.ChunkRangeForWindow(127, 20, 2, 2).Unwrap();
  Test.AssertEquals(0, AcrossEdge.MinimumX);
  Test.AssertEquals(1, AcrossEdge.MaximumX);
  const AcrossCorners: WorldUnit.ChunkRange := WorldUnit.ChunkRangeForWindow(
    127,
    127,
    2,
    2
  ).Unwrap();
  Test.AssertEquals(0, AcrossCorners.MinimumX);
  Test.AssertEquals(1, AcrossCorners.MaximumX);
  Test.AssertEquals(0, AcrossCorners.MinimumY);
  Test.AssertEquals(1, AcrossCorners.MaximumY);
  const NegativeEdge: WorldUnit.ChunkRange := WorldUnit.ChunkRangeForWindow(
    -129,
    -129,
    2,
    2
  ).Unwrap();
  Test.AssertEquals(-2, NegativeEdge.MinimumX);
  Test.AssertEquals(-1, NegativeEdge.MaximumX);
  Test.AssertEquals(-2, NegativeEdge.MinimumY);
  Test.AssertEquals(-1, NegativeEdge.MaximumY);
  const AcrossMany: WorldUnit.ChunkRange := WorldUnit.ChunkRangeForWindow(
    -200,
    -200,
    520,
    520
  ).Unwrap();
  Test.AssertTrue((AcrossMany.MaximumX - AcrossMany.MinimumX) + 1 > 3);
  Test.AssertTrue((AcrossMany.MaximumY - AcrossMany.MinimumY) + 1 > 3);
  const WideWorld: WorldUnit.WorldSession := WorldUnit.OpenWorld(
    Root,
    'storage',
    12345,
    4,
    64
  ).Unwrap();
  const WideWindow: WorldUnit.WindowLoad := WorldUnit.LoadVisibleWindow(
    WideWorld,
    State,
    385,
    385
  ).Unwrap();
  Test.AssertEquals(385, WideWindow.Window.Width);
  Test.AssertEquals(385, WideWindow.Window.Height);
  Test.AssertEquals(385, WideWindow.Window.Rows[384].Length());
  Test.AssertTrue(WorldUnit.CachedChunkCount(WideWindow.World) <= 64);
  const Moved: WorldUnit.WorldMove := WorldUnit.MoveInWorld(World, State, -1, 0).Unwrap();
  Test.AssertEquals(RequireOutdoor(State).X - 1, RequireOutdoor(Moved.State).X);
  Test.AssertEquals(RequireOutdoor(State).Y, RequireOutdoor(Moved.State).Y);
  const RightY: integer := FindHorizontalCrossing(World.Metadata, 127, 128);
  const CrossRight: WorldUnit.WorldMove := WorldUnit.MoveInWorld(
    World,
    GameState.GameState(
      Area := Coordinates.AreaKind.OutdoorRegion,
      AreaId := World.Metadata.OutdoorAreaId,
      Player := Coordinates.PlayerPosition.Outdoor(
        Coordinates.WorldPosition(X := 127, Y := RightY)
      ),
      ReturnLocation := Coordinates.ReturnLocation.NoReturnLocation,
      VisitedAreas := [],
      Exploration := Model.EmptyExploration(),
      Items := GameState.NewGame(World.Metadata).Items,
      Health := GameState.NewGame(World.Metadata).Health,
      Hostiles := GameState.NewGame(World.Metadata).Hostiles,
      Npcs := GameState.NewGame(World.Metadata).Npcs,
      Quest := GameState.NewGame(World.Metadata).Quest,
      RandomState := GameState.NewGame(World.Metadata).RandomState,
      Progression := Progression.NewProgression()
    ),
    1,
    0
  ).Unwrap();
  Test.AssertEquals(128, RequireOutdoor(CrossRight.State).X);
  const LeftY: integer := FindHorizontalCrossing(World.Metadata, -128, -129);
  const CrossLeft: WorldUnit.WorldMove := WorldUnit.MoveInWorld(
    World,
    GameState.GameState(
      Area := Coordinates.AreaKind.OutdoorRegion,
      AreaId := World.Metadata.OutdoorAreaId,
      Player := Coordinates.PlayerPosition.Outdoor(
        Coordinates.WorldPosition(X := -128, Y := LeftY)
      ),
      ReturnLocation := Coordinates.ReturnLocation.NoReturnLocation,
      VisitedAreas := [],
      Exploration := Model.EmptyExploration(),
      Items := GameState.NewGame(World.Metadata).Items,
      Health := GameState.NewGame(World.Metadata).Health,
      Hostiles := GameState.NewGame(World.Metadata).Hostiles,
      Npcs := GameState.NewGame(World.Metadata).Npcs,
      Quest := GameState.NewGame(World.Metadata).Quest,
      RandomState := GameState.NewGame(World.Metadata).RandomState,
      Progression := Progression.NewProgression()
    ),
    -1,
    0
  ).Unwrap();
  Test.AssertEquals(-129, RequireOutdoor(CrossLeft.State).X);
  const DownX: integer := FindVerticalCrossing(World.Metadata, 127, 128);
  const CrossDown: WorldUnit.WorldMove := WorldUnit.MoveInWorld(
    World,
    GameState.GameState(
      Area := Coordinates.AreaKind.OutdoorRegion,
      AreaId := World.Metadata.OutdoorAreaId,
      Player := Coordinates.PlayerPosition.Outdoor(Coordinates.WorldPosition(X := DownX, Y := 127)),
      ReturnLocation := Coordinates.ReturnLocation.NoReturnLocation,
      VisitedAreas := [],
      Exploration := Model.EmptyExploration(),
      Items := GameState.NewGame(World.Metadata).Items,
      Health := GameState.NewGame(World.Metadata).Health,
      Hostiles := GameState.NewGame(World.Metadata).Hostiles,
      Npcs := GameState.NewGame(World.Metadata).Npcs,
      Quest := GameState.NewGame(World.Metadata).Quest,
      RandomState := GameState.NewGame(World.Metadata).RandomState,
      Progression := Progression.NewProgression()
    ),
    0,
    1
  ).Unwrap();
  Test.AssertEquals(128, RequireOutdoor(CrossDown.State).Y);
  const UpX: integer := FindVerticalCrossing(World.Metadata, -128, -129);
  const CrossUp: WorldUnit.WorldMove := WorldUnit.MoveInWorld(
    World,
    GameState.GameState(
      Area := Coordinates.AreaKind.OutdoorRegion,
      AreaId := World.Metadata.OutdoorAreaId,
      Player := Coordinates.PlayerPosition.Outdoor(Coordinates.WorldPosition(X := UpX, Y := -128)),
      ReturnLocation := Coordinates.ReturnLocation.NoReturnLocation,
      VisitedAreas := [],
      Exploration := Model.EmptyExploration(),
      Items := GameState.NewGame(World.Metadata).Items,
      Health := GameState.NewGame(World.Metadata).Health,
      Hostiles := GameState.NewGame(World.Metadata).Hostiles,
      Npcs := GameState.NewGame(World.Metadata).Npcs,
      Quest := GameState.NewGame(World.Metadata).Quest,
      RandomState := GameState.NewGame(World.Metadata).RandomState,
      Progression := Progression.NewProgression()
    ),
    0,
    -1
  ).Unwrap();
  Test.AssertEquals(-129, RequireOutdoor(CrossUp.State).Y);
  Test.AssertTrue(WorldUnit.OpenWorld(Root, '../escape', 1, 4, 16) is Error(_));
  Test.AssertTrue(WorldUnit.OpenWorld(Root, '', 1, 4, 16) is Error(_));
  Test.AssertTrue(WorldUnit.OpenWorld(Root, 'a'.RepeatStr(65), 1, 4, 16) is Error(_));
  Test.AssertTrue(WorldUnit.OpenWorld(Root, 'welt-ä', 1, 4, 16) is Error(_));
  const MaximumIdWorld: WorldUnit.WorldSession := WorldUnit.OpenWorld(
    Root,
    'a'.RepeatStr(64),
    1,
    4,
    16
  ).Unwrap();
  Test.AssertEquals(64, MaximumIdWorld.Metadata.Id.Length());
  Test.AssertTrue(WorldUnit.OpenWorld(Root, 'storage', 1, 4, 0) is Error(_));
  var SmallCache: WorldUnit.WorldSession := WorldUnit.OpenWorld(
    Root,
    'small-cache',
    12345,
    4,
    2
  ).Unwrap();
  const CachedA: WorldUnit.ChunkLoad := WorldUnit.LoadWorldChunk(
    SmallCache,
    Coordinates.ChunkCoordinate(X := 10, Y := 10)
  ).Unwrap();
  SmallCache := CachedA.World;
  const CachedB: WorldUnit.ChunkLoad := WorldUnit.LoadWorldChunk(
    SmallCache,
    Coordinates.ChunkCoordinate(X := 11, Y := 10)
  ).Unwrap();
  SmallCache := CachedB.World;
  const CachedC: WorldUnit.ChunkLoad := WorldUnit.LoadWorldChunk(
    SmallCache,
    Coordinates.ChunkCoordinate(X := 12, Y := 10)
  ).Unwrap();
  SmallCache := CachedC.World;
  Test.AssertEquals(2, WorldUnit.CachedChunkCount(SmallCache));
  Test.AssertEquals(11, SmallCache.Cache[0].Chunk.Coordinate.X);
  Test.AssertEquals(12, SmallCache.Cache[1].Chunk.Coordinate.X);
  const InvalidVersionDirectory: string := PathOps.Join([Root, 'invalid-version']);
  Test.AssertTrue(EnsureChild(InvalidVersionDirectory).Unwrap());
  const InvalidVersionPath: string := PathOps.Join([InvalidVersionDirectory, 'world.json']);
  const InvalidVersionText: string := MetadataJson(
    'invalid-version',
    99,
    Terrain.WorldGeneratorVersion,
    Coordinates.WorldChunkSize,
    0,
    0
  );
  Test.AssertTrue(Fs.WriteTextAtomic(InvalidVersionPath, InvalidVersionText).Unwrap());
  Test.AssertTrue(WorldUnit.OpenWorld(Root, 'invalid-version', 1, 4, 8) is Error(_));
  Test.AssertEquals(InvalidVersionText, Fs.ReadText(InvalidVersionPath).Unwrap());
  const MissingFieldDirectory: string := PathOps.Join([Root, 'missing-field']);
  Test.AssertTrue(EnsureChild(MissingFieldDirectory).Unwrap());
  const MissingFieldText: string := '{"version":2,"id":"missing-field"}';
  const MissingFieldPath: string := PathOps.Join([MissingFieldDirectory, 'world.json']);
  Test.AssertTrue(Fs.WriteTextAtomic(MissingFieldPath, MissingFieldText).Unwrap());
  Test.AssertTrue(WorldUnit.OpenWorld(Root, 'missing-field', 12345, 4, 8) is Error(_));
  Test.AssertEquals(MissingFieldText, Fs.ReadText(MissingFieldPath).Unwrap());
  const InvalidSizeDirectory: string := PathOps.Join([Root, 'invalid-size']);
  Test.AssertTrue(EnsureChild(InvalidSizeDirectory).Unwrap());
  Test.AssertTrue(
    Fs.WriteTextAtomic(
      PathOps.Join([InvalidSizeDirectory, 'world.json']),
      MetadataJson(
        'invalid-size',
        Terrain.WorldFormatVersion,
        Terrain.WorldGeneratorVersion,
        127,
        0,
        0
      )
    ).Unwrap()
  );
  Test.AssertTrue(WorldUnit.OpenWorld(Root, 'invalid-size', 1, 4, 8) is Error(_));
  const MismatchDirectory: string := PathOps.Join([Root, 'mismatch']);
  Test.AssertTrue(EnsureChild(MismatchDirectory).Unwrap());
  Test.AssertTrue(
    Fs.WriteTextAtomic(
      PathOps.Join([MismatchDirectory, 'world.json']),
      MetadataJson(
        'different',
        Terrain.WorldFormatVersion,
        Terrain.WorldGeneratorVersion,
        Coordinates.WorldChunkSize,
        0,
        0
      )
    ).Unwrap()
  );
  Test.AssertTrue(WorldUnit.OpenWorld(Root, 'mismatch', 1, 4, 8) is Error(_));
  const LegacyGeneratorDirectory: string := PathOps.Join([Root, 'legacy-generator']);
  Test.AssertTrue(EnsureChild(LegacyGeneratorDirectory).Unwrap());
  const LegacyGeneratorPath: string := PathOps.Join([LegacyGeneratorDirectory, 'world.json']);
  const LegacyGeneratorText: string := MetadataJson(
    'legacy-generator', Terrain.WorldFormatVersion, Terrain.WorldGeneratorVersion -
    1, Coordinates.WorldChunkSize, 0, 0
  );
  Test.AssertTrue(Fs.WriteTextAtomic(LegacyGeneratorPath, LegacyGeneratorText).Unwrap());
  Test.AssertTrue(WorldUnit.OpenWorld(Root, 'legacy-generator', 1, 4, 8) is Error(_));
  Test.AssertEquals(LegacyGeneratorText, Fs.ReadText(LegacyGeneratorPath).Unwrap());
  var BlockedX: integer := 100;
  const InvalidSpawnMetadata: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
    'invalid-spawn',
    12345,
    4
  ).Unwrap();
  while Terrain.IsWalkable(ChunksUnit.GenerateWorldCell(InvalidSpawnMetadata, BlockedX, 100)) do
    begin
      BlockedX := BlockedX + 1;
    end;
  end while;
  const InvalidSpawnDirectory: string := PathOps.Join([Root, 'invalid-spawn']);
  Test.AssertTrue(EnsureChild(InvalidSpawnDirectory).Unwrap());
  Test.AssertTrue(
    Fs.WriteTextAtomic(
      PathOps.Join([InvalidSpawnDirectory, 'world.json']),
      MetadataJson(
        'invalid-spawn',
        Terrain.WorldFormatVersion,
        Terrain.WorldGeneratorVersion,
        Coordinates.WorldChunkSize,
        BlockedX,
        100
      )
    ).Unwrap()
  );
  Test.AssertTrue(WorldUnit.OpenWorld(Root, 'invalid-spawn', 1, 4, 8) is Error(_));
  const ConflictingEntranceDirectory: string := PathOps.Join([Root, 'conflicting-entrance']);
  Test.AssertTrue(EnsureChild(ConflictingEntranceDirectory).Unwrap());
  const ConflictingMetadata: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
    'conflicting-entrance',
    12345,
    4
  ).Unwrap();
  var ConflictingX: integer := 100;
  while Terrain.IsWalkable(ChunksUnit.GenerateWorldCell(ConflictingMetadata, ConflictingX, 100)) do
    begin
      ConflictingX := ConflictingX + 1;
    end;
  end while;
  const ConflictingText: string := MetadataJsonWithEntrance(
    'conflicting-entrance',
    Terrain.WorldFormatVersion,
    Terrain.WorldGeneratorVersion,
    Coordinates.WorldChunkSize,
    ConflictingMetadata.Spawn.X,
    ConflictingMetadata.Spawn.Y,
    ConflictingX,
    100,
    4
  );
  const ConflictingPath: string := PathOps.Join([ConflictingEntranceDirectory, 'world.json']);
  Test.AssertTrue(Fs.WriteTextAtomic(ConflictingPath, ConflictingText).Unwrap());
  Test.AssertTrue(WorldUnit.OpenWorld(Root, 'conflicting-entrance', 12345, 4, 8) is Error(_));
  Test.AssertEquals(ConflictingText, Fs.ReadText(ConflictingPath).Unwrap());
  // Stored region sizes outside 1 through 16 are rejected without rewriting the file.
  const WrongRegionDirectory: string := PathOps.Join([Root, 'wrong-region']);
  Test.AssertTrue(EnsureChild(WrongRegionDirectory).Unwrap());
  const WrongRegionMetadata: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
    'wrong-region',
    12345,
    4
  ).Unwrap();
  const WrongRegionText: string := MetadataJsonWithEntrance(
    'wrong-region',
    Terrain.WorldFormatVersion,
    Terrain.WorldGeneratorVersion,
    Coordinates.WorldChunkSize,
    WrongRegionMetadata.Spawn.X,
    WrongRegionMetadata.Spawn.Y,
    WrongRegionMetadata.SpawnEntrance.X,
    WrongRegionMetadata.SpawnEntrance.Y,
    17
  );
  const WrongRegionPath: string := PathOps.Join([WrongRegionDirectory, 'world.json']);
  Test.AssertTrue(Fs.WriteTextAtomic(WrongRegionPath, WrongRegionText).Unwrap());
  Test.AssertTrue(WorldUnit.OpenWorld(Root, 'wrong-region', 12345, 4, 8) is Error(_));
  Test.AssertEquals(WrongRegionText, Fs.ReadText(WrongRegionPath).Unwrap());
  Test.AssertTrue(WorldUnit.OpenWorld(Root, 'new-wrong-region', 12345, 0, 8) is Error(_));
  var InvalidChunkWorld: WorldUnit.WorldSession := WorldUnit.OpenWorld(
    Root,
    'invalid-chunks',
    12345,
    4,
    8
  ).Unwrap();
  const InvalidCoordinate: Coordinates.ChunkCoordinate := Coordinates.ChunkCoordinate(
    X := 20,
    Y := -20
  );
  const InvalidColumn: string := PathOps.Join([InvalidChunkWorld.Directory, 'chunks', 'x_20']);
  Test.AssertTrue(EnsureChild(InvalidColumn).Unwrap());
  const InvalidChunkPath: string := WorldUnit.WorldChunkPath(InvalidChunkWorld, InvalidCoordinate);
  const InvalidChunkText: string := ChunkJson(
    'invalid-chunks',
    20,
    -20,
    Terrain.WorldFormatVersion,
    'x',
    Coordinates.WorldChunkSize,
    Coordinates.WorldChunkSize
  );
  Test.AssertTrue(Fs.WriteTextAtomic(InvalidChunkPath, InvalidChunkText).Unwrap());
  Test.AssertTrue(WorldUnit.LoadWorldChunk(InvalidChunkWorld, InvalidCoordinate) is Error(_));
  Test.AssertEquals(InvalidChunkText, Fs.ReadText(InvalidChunkPath).Unwrap());
  const MalformedCoordinate: Coordinates.ChunkCoordinate := Coordinates.ChunkCoordinate(
    X := 21,
    Y := -20
  );
  const MalformedColumn: string := PathOps.Join([InvalidChunkWorld.Directory, 'chunks', 'x_21']);
  Test.AssertTrue(EnsureChild(MalformedColumn).Unwrap());
  Test.AssertTrue(
    Fs.WriteTextAtomic(
      WorldUnit.WorldChunkPath(InvalidChunkWorld, MalformedCoordinate),
      ChunkJson(
        'invalid-chunks',
        21,
        -20,
        Terrain.WorldFormatVersion,
        'g',
        127,
        Coordinates.WorldChunkSize
      )
    ).Unwrap()
  );
  Test.AssertTrue(WorldUnit.LoadWorldChunk(InvalidChunkWorld, MalformedCoordinate) is Error(_));
  const WrongCoordinate: Coordinates.ChunkCoordinate := Coordinates.ChunkCoordinate(
    X := 22,
    Y := -20
  );
  const WrongColumn: string := PathOps.Join([InvalidChunkWorld.Directory, 'chunks', 'x_22']);
  Test.AssertTrue(EnsureChild(WrongColumn).Unwrap());
  Test.AssertTrue(
    Fs.WriteTextAtomic(
      WorldUnit.WorldChunkPath(InvalidChunkWorld, WrongCoordinate),
      ChunkJson(
        'invalid-chunks',
        999,
        -20,
        Terrain.WorldFormatVersion,
        'g',
        Coordinates.WorldChunkSize,
        Coordinates.WorldChunkSize
      )
    ).Unwrap()
  );
  Test.AssertTrue(WorldUnit.LoadWorldChunk(InvalidChunkWorld, WrongCoordinate) is Error(_));
  const WrongVersionCoordinate: Coordinates.ChunkCoordinate := Coordinates.ChunkCoordinate(
    X := 23,
    Y := -20
  );
  const WrongVersionColumn: string := PathOps.Join([InvalidChunkWorld.Directory, 'chunks', 'x_23']);
  Test.AssertTrue(EnsureChild(WrongVersionColumn).Unwrap());
  Test.AssertTrue(
    Fs.WriteTextAtomic(
      WorldUnit.WorldChunkPath(InvalidChunkWorld, WrongVersionCoordinate),
      ChunkJson(
        'invalid-chunks',
        23,
        -20,
        99,
        'g',
        Coordinates.WorldChunkSize,
        Coordinates.WorldChunkSize
      )
    ).Unwrap()
  );
  Test.AssertTrue(
    (WorldUnit.LoadWorldChunk(InvalidChunkWorld, WrongVersionCoordinate) is Error(_))
  );
  const WrongWorldCoordinate: Coordinates.ChunkCoordinate := Coordinates.ChunkCoordinate(
    X := 24,
    Y := -20
  );
  const WrongWorldColumn: string := PathOps.Join([InvalidChunkWorld.Directory, 'chunks', 'x_24']);
  Test.AssertTrue(EnsureChild(WrongWorldColumn).Unwrap());
  Test.AssertTrue(
    Fs.WriteTextAtomic(
      WorldUnit.WorldChunkPath(InvalidChunkWorld, WrongWorldCoordinate),
      ChunkJson(
        'another-world',
        24,
        -20,
        Terrain.WorldFormatVersion,
        'g',
        Coordinates.WorldChunkSize,
        Coordinates.WorldChunkSize
      )
    ).Unwrap()
  );
  Test.AssertTrue(WorldUnit.LoadWorldChunk(InvalidChunkWorld, WrongWorldCoordinate) is Error(_));
  const WrongRowCountCoordinate: Coordinates.ChunkCoordinate := Coordinates.ChunkCoordinate(
    X := 25,
    Y := -20
  );
  const WrongRowCountColumn: string := PathOps.Join([InvalidChunkWorld.Directory, 'chunks', 'x_25']);
  Test.AssertTrue(EnsureChild(WrongRowCountColumn).Unwrap());
  Test.AssertTrue(
    Fs.WriteTextAtomic(
      WorldUnit.WorldChunkPath(InvalidChunkWorld, WrongRowCountCoordinate),
      ChunkJson(
        'invalid-chunks',
        25,
        -20,
        Terrain.WorldFormatVersion,
        'g',
        Coordinates.WorldChunkSize,
        127
      )
    ).Unwrap()
  );
  Test.AssertTrue(
    (WorldUnit.LoadWorldChunk(InvalidChunkWorld, WrongRowCountCoordinate) is Error(_))
  );
  const DuplicateEntranceCoordinate: Coordinates.ChunkCoordinate := Coordinates.ChunkCoordinate(
    X := 26,
    Y := -20
  );
  const DuplicateEntranceColumn: string := PathOps.Join([
    InvalidChunkWorld.Directory,
    'chunks',
    'x_26'
  ]);
  Test.AssertTrue(EnsureChild(DuplicateEntranceColumn).Unwrap());
  const DuplicateEntrancePath: string := WorldUnit.WorldChunkPath(
    InvalidChunkWorld,
    DuplicateEntranceCoordinate
  );
  const DuplicateEntranceText: string := ChunkJsonWithFeature('invalid-chunks', 26, -20, 'e');
  Test.AssertTrue(Fs.WriteTextAtomic(DuplicateEntrancePath, DuplicateEntranceText).Unwrap());
  Test.AssertTrue(
    (WorldUnit.LoadWorldChunk(InvalidChunkWorld, DuplicateEntranceCoordinate) is Error(_))
  );
  Test.AssertEquals(DuplicateEntranceText, Fs.ReadText(DuplicateEntrancePath).Unwrap());
  // A stored chunk carries an entrance exactly on an entrance field whose stored cell is clear land.
  const Site: Coordinates.WorldPosition := OrdinarySite(InvalidChunkWorld.Metadata);
  const SiteCoordinate: Coordinates.ChunkCoordinate := Coordinates.ChunkCoordinate(
    X := Coordinates.ChunkForCoordinate(Site.X),
    Y := Coordinates.ChunkForCoordinate(Site.Y)
  );
  const SiteLoad: WorldUnit.ChunkLoad := WorldUnit.LoadWorldChunk(
    InvalidChunkWorld,
    SiteCoordinate
  ).Unwrap();
  Test.AssertTrue(
    Terrain.ChunkCell(
      SiteLoad.Chunk,
      Coordinates.LocalForCoordinate(Site.X),
      Coordinates.LocalForCoordinate(Site.Y)
    ).Feature =
    Terrain.TerrainFeatureKind.Entrance
  );
  const SitePath: string := WorldUnit.WorldChunkPath(InvalidChunkWorld, SiteCoordinate);
  const SiteX: integer := Coordinates.LocalForCoordinate(Site.X);
  const SiteY: integer := Coordinates.LocalForCoordinate(Site.Y);
  const Matching: string := GrassChunkJsonWithEntrance(
    'invalid-chunks',
    SiteCoordinate,
    SiteX,
    SiteY
  );
  Test.AssertTrue(Fs.WriteTextAtomic(SitePath, Matching).Unwrap());
  Test.AssertTrue(
    (
      WorldUnit.LoadWorldChunk(
        WorldUnit.OpenWorld(Root, 'invalid-chunks', 12345, 4, 8).Unwrap(),
        SiteCoordinate
      ) is Ok(_)
    )
  );
  const Missing: string := GrassChunkJsonWithEntrance('invalid-chunks', SiteCoordinate, -1, -1);
  Test.AssertTrue(Fs.WriteTextAtomic(SitePath, Missing).Unwrap());
  Test.AssertTrue(
    (
      WorldUnit.LoadWorldChunk(
        WorldUnit.OpenWorld(Root, 'invalid-chunks', 12345, 4, 8).Unwrap(),
        SiteCoordinate
      ) is Error(_)
    )
  );
  Test.AssertEquals(Missing, Fs.ReadText(SitePath).Unwrap());
  const ShiftedX: integer := (SiteX + 1) mod Coordinates.WorldChunkSize;
  const Shifted: string := GrassChunkJsonWithEntrance(
    'invalid-chunks',
    SiteCoordinate,
    ShiftedX,
    SiteY
  );
  Test.AssertTrue(Fs.WriteTextAtomic(SitePath, Shifted).Unwrap());
  Test.AssertTrue(
    (
      WorldUnit.LoadWorldChunk(
        WorldUnit.OpenWorld(Root, 'invalid-chunks', 12345, 4, 8).Unwrap(),
        SiteCoordinate
      ) is Error(_)
    )
  );
  const ConcurrentWorld: WorldUnit.WorldSession := WorldUnit.OpenWorld(
    Root,
    'concurrent',
    12345,
    4,
    8
  ).Unwrap();
  const ConcurrentCoordinate: Coordinates.ChunkCoordinate := Coordinates.ChunkCoordinate(
    X := 31,
    Y := 17
  );
  scope
    const FirstTask: task of result of (boolean, string) := go ConcurrentLoad(
      Root,
      ConcurrentCoordinate
    );
    const SecondTask: task of result of (boolean, string) := go ConcurrentLoad(
      Root,
      ConcurrentCoordinate
    );
    Test.AssertTrue(Tasks.Wait(FirstTask).Unwrap());
    Test.AssertTrue(Tasks.Wait(SecondTask).Unwrap());
  end scope;
  const ConcurrentResult: WorldUnit.ChunkLoad := WorldUnit.LoadWorldChunk(
    ConcurrentWorld,
    ConcurrentCoordinate
  ).Unwrap();
  Test.AssertEquals(
    Coordinates.WorldChunkSize * Coordinates.WorldChunkSize,
    ConcurrentResult.Chunk.Cells.Length()
  );
end.
