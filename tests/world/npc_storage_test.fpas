// Verifies explicit NPC persistence, settlement discovery, and preservation of malformed savegames.
program NpcStorageTest;

uses
  Dungeon.Coordinates as Coordinates, Dungeon.Dialogue as Dialogue, Dungeon.Exploration as Exploration,
  Dungeon.Exploration.Model as Model, Dungeon.GameState as GameState, Dungeon.Movement as Movement,
  Dungeon.World as WorldUnit, Dungeon.World.Savegame as Savegame, Std.Conv as Conv, Std.Fs as Fs,
  Std.Json as Json, Std.Json.Fields as Fields, Std.Test as Test, Std.Time as Time;

begin
  const Root := '.temp-data/npc-storage-' + Conv.IntToStr(Time.TimestampMillis());
  Test.AssertTrue(Fs.CreateDirAll(Root).Unwrap());
  const World := WorldUnit.OpenWorld(Root, 'home', 12345, 4, 8).Unwrap();
  const Initial := GameState.NewGame(World.Metadata);
  const Outside := Initial with Player := Coordinates.PlayerPosition.Outdoor(
    World.Metadata.SettlementGate
  ); end with;
  const Entry := Movement.ActivateAreaTransition(
    GameState.AreaView(Metadata := World.Metadata, Interior := None),
    Outside,
    None
  ).Unwrap();
  const Ready := Entry.State with Player := Coordinates.PlayerPosition.Settlement(
    Coordinates.InteriorPosition(X := 11, Y := 8)
  ); Health := 3; end with;
  var Met := Ready;
  case Dialogue.Start(Entry.View, Ready).Unwrap() of
    when Dialogue.Outcome.Continued(const State, _, _):
      Met := State;
    when Dialogue.Outcome.Ended(_):
      panic('expected first greeting');
  end case;
  var Discovered: array of boolean := array.Fill(false, 23 * 15);
  Discovered[8 * 23 + 11] := true;
  Met.Exploration := Model.ExplorationState(
    OutdoorChunks := [], InteriorAreas := [
      Model.InteriorDiscoveryArea(
        AreaId := Met.AreaId,
        Width := 23,
        Height := 15,
        Fields := Discovered
      )
    ]
  );
  Test.AssertTrue(Savegame.WriteSaveGame(World, Met).Unwrap());
  const Path := Savegame.SaveGamePath(World);
  const Saved := Fs.ReadText(Path).Unwrap();
  Test.AssertFalse('"dialogue"' in Saved);
  Test.AssertFalse('"choices"' in Saved);
  Test.AssertFalse('"speaker"' in Saved);
  const Restarted := WorldUnit.OpenWorld(Root, 'home', 0, 1, 8).Unwrap();
  case Savegame.LoadSaveGame(Restarted).Unwrap() of
    when Savegame.SaveGameLoad.Loaded(const State, const View):
      Test.AssertTrue(State.Npcs[0].HasMetPlayer);
      Test.AssertTrue(Exploration.InteriorIsDiscovered(State.Exploration, State.AreaId, 23, 11, 8));
      case Dialogue.Start(View, State).Unwrap() of
        when Dialogue.Outcome.Continued(_, const Frame, _):
          Test.AssertTrue('recognizes you' in Frame.Text);
        when Dialogue.Outcome.Ended(_):
          panic('expected repeat greeting');
      end case;
    when Savegame.SaveGameLoad.Missing, Savegame.SaveGameLoad.Invalid(_):
      panic('expected remembered NPC after restart');
  end case;
  const Fresh := GameState.NewGame(World.Metadata);
  Test.AssertFalse(Fresh.Npcs[0].HasMetPlayer);
  Test.AssertEquals(Saved, Fs.ReadText(Path).Unwrap());
  Test.AssertFalse(Fs.Exists(World.Directory + '/dungeons'));
  const NpcArray := Fields.ArrayField(Fields.ParseObject(Saved).Unwrap(), 'npcs').Unwrap();
  const RecordText := Json.Stringify(NpcArray[0]);
  const NpcField := '"npcs":' + Json.Stringify(Json.JsonValue.ArrayValue(NpcArray));
  Test.AssertTrue(NpcField in Saved);
  for Broken: string in [
    Saved.Replace(NpcField + ',', ''), Saved.Replace(NpcField, '"npcs":[]'),
    Saved.Replace(NpcField, '"npcs":null'),
    Saved.Replace(NpcField, '"npcs":[' + RecordText + ',' + RecordText + ']'),
    Saved.Replace('"format_version":14', '"format_version":10'),
    Saved.Replace(NpcField, NpcField + ',"dialogue":{}')
  ] do
    Test.AssertTrue(Broken <> Saved);
    Test.AssertTrue(Fs.WriteTextAtomic(Path, Broken).Unwrap());
    Test.AssertTrue(Savegame.LoadSaveGame(Restarted).Unwrap() is Savegame.SaveGameLoad.Invalid(_));
    Test.AssertEquals(Broken, Fs.ReadText(Path).Unwrap());
  end for;

  for BadRecord: string in [
    'null', RecordText.Replace('"kind":"mara"', '"kind":"unknown"'),
    RecordText.Replace('home:settlement:home:npc:mara', 'foreign-npc'),
    RecordText.Replace('"area_id":"home:settlement:home"', '"area_id":"other:settlement:home"'),
    RecordText.Replace('"has_met_player":true', '"has_met_player":"yes"'),
    RecordText.Replace('"has_met_player":true', '"has_met_player":true,"x":11'),
    RecordText.Replace('"has_met_player":true', '"has_met_player":true,"has_met_player":false')
  ] do
    Test.AssertTrue(BadRecord <> RecordText);
    const Broken := Saved.Replace(RecordText, BadRecord);
    Test.AssertTrue(Fs.WriteTextAtomic(Path, Broken).Unwrap());
    Test.AssertTrue(Savegame.LoadSaveGame(Restarted).Unwrap() is Savegame.SaveGameLoad.Invalid(_));
    Test.AssertEquals(Broken, Fs.ReadText(Path).Unwrap());
  end for;

  Test.AssertTrue(Fs.WriteTextAtomic(Path, Saved).Unwrap());
  var Impossible := Fresh;
  Impossible.Npcs[0].HasMetPlayer := true;
  Test.AssertTrue(Savegame.WriteSaveGame(World, Impossible) is Error(_));
  Test.AssertEquals(Saved, Fs.ReadText(Path).Unwrap());
end.
