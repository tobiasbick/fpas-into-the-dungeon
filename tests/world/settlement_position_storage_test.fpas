// Verifies settlement-local positions and visits survive explicit save/reopen without creating a level file.
program SettlementPositionStorageTest;

uses
  Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Movement as Movement,
  Dungeon.Settlements as Settlements, Dungeon.World as WorldUnit, Dungeon.World.Savegame as Savegame,
  Std.Conv as Conv, Std.Fs as Fs, Std.Test as Test, Std.Time as Time;

begin
  const Root := '.temp-data/settlement-position-' + Conv.IntToStr(Time.TimestampMillis());
  Test.AssertTrue(Fs.CreateDirAll(Root).Unwrap());
  const World := WorldUnit.OpenWorld(Root, 'home', 12345, 4, 8).Unwrap();
  const Outside := GameState.NewGame(World.Metadata) with Player := Coordinates.PlayerPosition.Outdoor(
    World.Metadata.SettlementGate
  ); end with;
  const Entry := Movement.ActivateAreaTransition(
    GameState.AreaView(Metadata := World.Metadata, Interior := None),
    Outside,
    None
  ).Unwrap();
  const Moved := Movement.MoveSettlement(Entry.View, Entry.State, 0, -1).Unwrap();
  Test.AssertTrue(Savegame.WriteSaveGame(World, Moved).Unwrap());
  const Path := Savegame.SaveGamePath(World);
  const Saved := Fs.ReadText(Path).Unwrap();
  Test.AssertTrue('"format_version":13' in Saved);
  Test.AssertTrue('"kind":"settlement"' in Saved);
  const Reopened := WorldUnit.OpenWorld(Root, 'home', 0, 1, 8).Unwrap();
  case Savegame.LoadSaveGame(Reopened).Unwrap() of
    when Savegame.SaveGameLoad.Loaded(const State, const View):
      Test.AssertEquals(Settlements.HomeAreaId(World.Metadata), State.AreaId);
      Test.AssertTrue(
        GameState.SettlementPlayerPosition(State).Unwrap() =
        Coordinates.InteriorPosition(X := 11, Y := 11)
      );
      Test.AssertTrue(View.Interior is Some(_));
    when Savegame.SaveGameLoad.Missing, Savegame.SaveGameLoad.Invalid(_):
      panic('expected saved settlement position');
  end case;

  Test.AssertFalse(Fs.Exists(World.Directory + '/dungeons'));
  for Broken: string in [
    Saved.Replace('"format_version":13', '"format_version":10'),
    Saved.Replace('"kind":"settlement"', '"kind":"outdoor"'),
    Saved.Replace('"kind":"settlement"', '"kind":"settlement","facing":"north"')
  ] do
    Test.AssertTrue(Broken <> Saved);
    Test.AssertTrue(Fs.WriteTextAtomic(Path, Broken).Unwrap());
    Test.AssertTrue(Savegame.LoadSaveGame(Reopened).Unwrap() is Savegame.SaveGameLoad.Invalid(_));
    Test.AssertEquals(Broken, Fs.ReadText(Path).Unwrap());
  end for;
end.
