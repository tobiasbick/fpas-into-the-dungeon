// Verifies empty new games, first entry, revisit retention, and invalid visit state.
program AreaMaterializationTest;

uses Dungeon.Areas as Areas, Dungeon.Coordinates as Coordinates, Dungeon.Exploration.Model as Model, Dungeon.GameState as GameState, Dungeon.Hostiles as HostileRules, Dungeon.Interior as InteriorUnit, Dungeon.Items as ItemRules, Dungeon.Movement as Movement, Dungeon.Test.Fixtures as Fixtures, Dungeon.Terrain as Terrain, Std.Test as Test;

begin
  const Metadata: Terrain.WorldMetadata := Fixtures.FixtureMetadata();
  const Map: InteriorUnit.InteriorMap := Fixtures.FixtureDungeonMap();
  const Fresh: GameState.GameState := GameState.NewGame(Metadata);
  const OutdoorView: GameState.AreaView := GameState.AreaView(
    Metadata := Metadata,
    Interior := None
  );
  Test.AssertEquals(0, Fresh.VisitedAreas.Length());
  Test.AssertEquals(0, Fresh.Items.Length());
  Test.AssertEquals(0, Fresh.Hostiles.Length());
  Test.AssertTrue(Areas.ValidateSavedGame(Metadata, Fresh, []) is Ok(_));
  Test.AssertTrue(Areas.ValidateSavedGame(Metadata, Fresh, [Map]) is Error(_));
  const AtEntrance: GameState.GameState := Fresh with Player := Coordinates.PlayerPosition.Outdoor(
    Metadata.SpawnEntrance
  ); end with;

  Test.AssertTrue(Movement.ActivateAreaTransition(OutdoorView, AtEntrance, None) is Error(_));
  Test.AssertTrue(
    (
      Movement.ActivateAreaTransition(
        OutdoorView,
        AtEntrance,
        Some(Map with AreaId := 'wrong'; end with)
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      Movement.ActivateAreaTransition(
        OutdoorView,
        AtEntrance,
        Some(Map with Cells := []; end with)
      ) is Error(_)
    )
  );
  Test.AssertEquals(0, AtEntrance.Items.Length());
  const Entered: Movement.AreaTransition := Movement.ActivateAreaTransition(
    OutdoorView,
    AtEntrance,
    Some(Map)
  ).Unwrap();
  Test.AssertTrue(GameState.HasVisitedArea(Entered.State, Map.AreaId));
  Test.AssertEquals(1, Entered.State.VisitedAreas.Length());
  Test.AssertEquals(Map.Items.Length(), Entered.State.Items.Length());
  Test.AssertEquals(Map.Hostiles.Length(), Entered.State.Hostiles.Length());
  Test.AssertEquals(Fresh.RandomState, Entered.State.RandomState);
  Test.AssertEquals(Fresh.Health, Entered.State.Health);
  for Index: integer := 0 to Map.Items.Length() - 1 do
    begin
      Test.AssertEquals(Map.Items[Index].ItemId, Entered.State.Items[Index].Id);
      Test.AssertTrue(Map.Items[Index].Kind = Entered.State.Items[Index].Kind);
      Test.AssertTrue(
        Entered.State.Items[Index].Location =
        ItemRules.ItemLocation.InInterior(Map.AreaId, Map.Items[Index].Position)
      );
    end;
  end for;

  Test.AssertEquals(
    HostileRules.HostileMaximumHealth(Map.Hostiles[0].Kind),
    Entered.State.Hostiles[0].Health
  );
  Test.AssertFalse(Entered.State.Hostiles[0].Alerted);
  var Changed: GameState.GameState := Entered.State;
  Changed.Items[0] := Changed.Items[0] with Location := ItemRules.ItemLocation.CarriedByPlayer; end with;

  Changed.Hostiles[0] := Changed.Hostiles[0] with Health := 0; Alerted := true; end with;

  Changed.Player := Coordinates.PlayerPosition.FirstPerson(
    Coordinates.FirstPersonPose(Position := Map.Arrival, Facing := Map.StartFacing)
  );
  const Left: Movement.AreaTransition := Movement.ActivateAreaTransition(
    Entered.View,
    Changed,
    None
  ).Unwrap();
  const Again: Movement.AreaTransition := Movement.ActivateAreaTransition(
    Left.View,
    Left.State,
    Some(Map)
  ).Unwrap();
  Test.AssertEquals(1, Again.State.VisitedAreas.Length());
  Test.AssertEquals(3, Again.State.Items.Length());
  Test.AssertEquals(1, Again.State.Hostiles.Length());
  Test.AssertTrue(Again.State.Items[0] = Changed.Items[0]);
  Test.AssertTrue(Again.State.Hostiles[0] = Changed.Hostiles[0]);
  Test.AssertTrue(Areas.ValidateSavedGame(Metadata, Again.State, [Map]) is Ok(_));
  Test.AssertTrue(
    (
      GameState.ValidateGameState(Again.View, Again.State with VisitedAreas := []; end with) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      GameState.ValidateGameState(
        Again.View,
        Again.State with VisitedAreas := [Map.AreaId, Map.AreaId]; end with
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      GameState.ValidateGameState(OutdoorView, Fresh with VisitedAreas := ['z', 'a']; end with) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      GameState.ValidateGameState(OutdoorView, Fresh with VisitedAreas := ['']; end with) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      GameState.ValidateGameState(OutdoorView, Fresh with Items := Changed.Items; end with) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      GameState.ValidateGameState(OutdoorView, Fresh with Hostiles := Changed.Hostiles; end with) is Error(_)
    )
  );
  const Discovered: GameState.GameState := Fresh with Exploration := Model.ExplorationState(
    OutdoorChunks := [], InteriorAreas := [
      Model.InteriorDiscoveryArea(
        AreaId := Map.AreaId, Width := Map.Width, Height := Map.Height, Fields := array.Fill(
          false, Map.Width *
          Map.Height
        )
      )
    ]
  ); end with;

  Test.AssertTrue(GameState.ValidateGameState(OutdoorView, Discovered) is Error(_));
  // Materialization maintains canonical order even when areas are supplied in reverse.
  const EmptyMap: InteriorUnit.InteriorMap := Map with Items := []; Hostiles := []; end with;
  const Z: GameState.GameState := Areas.MaterializeArea(
    Fresh,
    EmptyMap with AreaId := 'z'; end with
  );
  const A: GameState.GameState := Areas.MaterializeArea(Z, EmptyMap with AreaId := 'a'; end with);
  const AA: GameState.GameState := Areas.MaterializeArea(A, EmptyMap with AreaId := 'aa'; end with);
  Test.AssertEquals('a', AA.VisitedAreas[0]);
  Test.AssertEquals('aa', AA.VisitedAreas[1]);
  Test.AssertEquals('z', AA.VisitedAreas[2]);
  Test.AssertEquals(
    3,
    Areas.MaterializeArea(AA, EmptyMap with AreaId := 'a'; end with).VisitedAreas.Length()
  );
  Test.AssertEquals(0, GameState.NewGame(Metadata).VisitedAreas.Length());
end.
