// Verifies empty new games, first entry, revisit retention, and invalid visit state.
program AreaMaterializationTest;

uses
  Dungeon.Areas, Dungeon.Coordinates, Dungeon.Exploration.Model, Dungeon.GameState, Dungeon.Hostiles,
  Dungeon.Interior, Dungeon.Items, Dungeon.Movement, Dungeon.Test.Fixtures, Dungeon.Terrain,
  Std.Arrays, Std.Results, Std.Test;

begin
  var Metadata: WorldMetadata := FixtureMetadata();
  var Map: InteriorMap := FixtureDungeonMap();
  var Fresh: GameState := NewGame(Metadata);
  var OutdoorView: AreaView := record
    Metadata := Metadata;
    Interior := None;
  end;

  AssertEquals(0, Std.Arrays.Length(Fresh.VisitedAreas));
  AssertEquals(0, Std.Arrays.Length(Fresh.Items));
  AssertEquals(0, Std.Arrays.Length(Fresh.Hostiles));
  AssertTrue(IsOk(ValidateSavedGame(Metadata, Fresh, [])));
  AssertTrue(IsError(ValidateSavedGame(Metadata, Fresh, [Map])));
  var AtEntrance: GameState := Fresh with Player := PlayerPosition.Outdoor(Metadata.SpawnEntrance); end with;

  AssertTrue(IsError(ActivateAreaTransition(OutdoorView, AtEntrance, None)));
  AssertTrue(IsError(ActivateAreaTransition(OutdoorView, AtEntrance, Some(Map with AreaId := 'wrong'; end with))));
  AssertTrue(IsError(ActivateAreaTransition(OutdoorView, AtEntrance, Some(Map with Cells := []; end with))));
  AssertEquals(0, Std.Arrays.Length(AtEntrance.Items));
  var Entered: AreaTransition := Unwrap(ActivateAreaTransition(OutdoorView, AtEntrance, Some(Map)));
  AssertTrue(HasVisitedArea(Entered.State, Map.AreaId));
  AssertEquals(1, Std.Arrays.Length(Entered.State.VisitedAreas));
  AssertEquals(Std.Arrays.Length(Map.Items), Std.Arrays.Length(Entered.State.Items));
  AssertEquals(Std.Arrays.Length(Map.Hostiles), Std.Arrays.Length(Entered.State.Hostiles));
  AssertEquals(Fresh.RandomState, Entered.State.RandomState);
  AssertEquals(Fresh.Health, Entered.State.Health);
  for Index: integer := 0 to Std.Arrays.Length(Map.Items) - 1 do
    begin
      AssertEquals(Map.Items[Index].ItemId, Entered.State.Items[Index].Id);
      AssertTrue(Map.Items[Index].Kind = Entered.State.Items[Index].Kind);
      AssertTrue(Entered.State.Items[Index].Location =
                 ItemLocation.InInterior(Map.AreaId, Map.Items[Index].Position));
    end;
  end for;

  AssertEquals(HostileMaximumHealth(Map.Hostiles[0].Kind), Entered.State.Hostiles[0].Health);
  AssertFalse(Entered.State.Hostiles[0].Alerted);
  mutable var Changed: GameState := Entered.State;
  Changed.Items[0] := Changed.Items[0] with Location := ItemLocation.CarriedByPlayer; end with;

  Changed.Hostiles[0] := Changed.Hostiles[0] with Health := 0; Alerted := true; end with;

  Changed.Player := PlayerPosition.FirstPerson(record
    Position := Map.Exit;
    Facing := Map.StartFacing;
  end);
  var Left: AreaTransition := Unwrap(ActivateAreaTransition(Entered.View, Changed, None));
  var Again: AreaTransition := Unwrap(ActivateAreaTransition(Left.View, Left.State, Some(Map)));
  AssertEquals(1, Std.Arrays.Length(Again.State.VisitedAreas));
  AssertEquals(3, Std.Arrays.Length(Again.State.Items));
  AssertEquals(1, Std.Arrays.Length(Again.State.Hostiles));
  AssertTrue(Again.State.Items[0] = Changed.Items[0]);
  AssertTrue(Again.State.Hostiles[0] = Changed.Hostiles[0]);
  AssertTrue(IsOk(ValidateSavedGame(Metadata, Again.State, [Map])));
  AssertTrue(IsError(ValidateGameState(Again.View, Again.State with VisitedAreas := []; end with)));
  AssertTrue(IsError(ValidateGameState(Again.View, Again.State with VisitedAreas := [
                                                                                      Map.AreaId,
                                                                                      Map.AreaId
                                                                                    ]; end with)));
  AssertTrue(IsError(ValidateGameState(OutdoorView, Fresh with VisitedAreas := ['z', 'a']; end with)));
  AssertTrue(IsError(ValidateGameState(OutdoorView, Fresh with VisitedAreas := ['']; end with)));
  AssertTrue(IsError(ValidateGameState(OutdoorView, Fresh with Items := Changed.Items; end with)));
  AssertTrue(IsError(ValidateGameState(OutdoorView, Fresh with Hostiles := Changed.Hostiles; end with)));
  var Discovered: GameState := Fresh with Exploration := record
    OutdoorChunks := [];
    InteriorAreas := [record
      AreaId := Map.AreaId;
      Width := Map.Width;
      Height := Map.Height;
      Fields := Std.Arrays.Fill(false, Map.Width * Map.Height);
    end];
  end; end with;

  AssertTrue(IsError(ValidateGameState(OutdoorView, Discovered)));
  // Materialization maintains canonical order even when areas are supplied in reverse.
  var EmptyMap: InteriorMap := Map with Items := []; Hostiles := []; end with;
  var Z: GameState := MaterializeArea(Fresh, EmptyMap with AreaId := 'z'; end with);
  var A: GameState := MaterializeArea(Z, EmptyMap with AreaId := 'a'; end with);
  var AA: GameState := MaterializeArea(A, EmptyMap with AreaId := 'aa'; end with);
  AssertEquals('a', AA.VisitedAreas[0]);
  AssertEquals('aa', AA.VisitedAreas[1]);
  AssertEquals('z', AA.VisitedAreas[2]);
  AssertEquals(3, Std.Arrays.Length(MaterializeArea(AA, EmptyMap with AreaId := 'a'; end with)
                                      .VisitedAreas));
  AssertEquals(0, Std.Arrays.Length(NewGame(Metadata).VisitedAreas));
end.
