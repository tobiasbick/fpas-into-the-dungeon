// Verifies empty new games, first entry, revisit retention, and invalid visit state.
program AreaMaterializationTest;

uses
  Dungeon.Areas, Dungeon.Coordinates, Dungeon.Exploration.Model, Dungeon.GameState, Dungeon.Hostiles,
  Dungeon.Interior, Dungeon.Items, Dungeon.Movement, Dungeon.Test.Fixtures, Dungeon.Terrain,
  Std.Test;

begin
  const Metadata: WorldMetadata := FixtureMetadata();
  const Map: InteriorMap := FixtureDungeonMap();
  const Fresh: GameState := NewGame(Metadata);
  const OutdoorView: AreaView := AreaView(Metadata := Metadata, Interior := None);
  AssertEquals(0, Fresh.VisitedAreas.Length());
  AssertEquals(0, Fresh.Items.Length());
  AssertEquals(0, Fresh.Hostiles.Length());
  AssertTrue(ValidateSavedGame(Metadata, Fresh, []).IsOk());
  AssertTrue(ValidateSavedGame(Metadata, Fresh, [Map]).IsError());
  const AtEntrance: GameState := Fresh with Player := PlayerPosition.Outdoor(Metadata.SpawnEntrance); end with;

  AssertTrue(ActivateAreaTransition(OutdoorView, AtEntrance, None).IsError());
  AssertTrue(ActivateAreaTransition(OutdoorView, AtEntrance, Some(Map with AreaId := 'wrong'; end with))
               .IsError());
  AssertTrue(ActivateAreaTransition(OutdoorView, AtEntrance, Some(Map with Cells := []; end with))
               .IsError());
  AssertEquals(0, AtEntrance.Items.Length());
  const Entered: AreaTransition := ActivateAreaTransition(OutdoorView, AtEntrance, Some(Map))
                                     .Unwrap();
  AssertTrue(HasVisitedArea(Entered.State, Map.AreaId));
  AssertEquals(1, Entered.State.VisitedAreas.Length());
  AssertEquals(Map.Items.Length(), Entered.State.Items.Length());
  AssertEquals(Map.Hostiles.Length(), Entered.State.Hostiles.Length());
  AssertEquals(Fresh.RandomState, Entered.State.RandomState);
  AssertEquals(Fresh.Health, Entered.State.Health);
  for Index: integer := 0 to Map.Items.Length() - 1 do
    begin
      AssertEquals(Map.Items[Index].ItemId, Entered.State.Items[Index].Id);
      AssertTrue(Map.Items[Index].Kind = Entered.State.Items[Index].Kind);
      AssertTrue(Entered.State.Items[Index].Location =
                 ItemLocation.InInterior(Map.AreaId, Map.Items[Index].Position));
    end;
  end for;

  AssertEquals(HostileMaximumHealth(Map.Hostiles[0].Kind), Entered.State.Hostiles[0].Health);
  AssertFalse(Entered.State.Hostiles[0].Alerted);
  var Changed: GameState := Entered.State;
  Changed.Items[0] := Changed.Items[0] with Location := ItemLocation.CarriedByPlayer; end with;

  Changed.Hostiles[0] := Changed.Hostiles[0] with Health := 0; Alerted := true; end with;

  Changed.Player := PlayerPosition.FirstPerson(FirstPersonPose(Position := Map.Exit, Facing := Map.StartFacing));
  const Left: AreaTransition := ActivateAreaTransition(Entered.View, Changed, None).Unwrap();
  const Again: AreaTransition := ActivateAreaTransition(Left.View, Left.State, Some(Map)).Unwrap();
  AssertEquals(1, Again.State.VisitedAreas.Length());
  AssertEquals(3, Again.State.Items.Length());
  AssertEquals(1, Again.State.Hostiles.Length());
  AssertTrue(Again.State.Items[0] = Changed.Items[0]);
  AssertTrue(Again.State.Hostiles[0] = Changed.Hostiles[0]);
  AssertTrue(ValidateSavedGame(Metadata, Again.State, [Map]).IsOk());
  AssertTrue(ValidateGameState(Again.View, Again.State with VisitedAreas := []; end with).IsError());
  AssertTrue(ValidateGameState(Again.View, Again.State with VisitedAreas := [Map.AreaId, Map.AreaId]; end with)
               .IsError());
  AssertTrue(ValidateGameState(OutdoorView, Fresh with VisitedAreas := ['z', 'a']; end with)
               .IsError());
  AssertTrue(ValidateGameState(OutdoorView, Fresh with VisitedAreas := ['']; end with).IsError());
  AssertTrue(ValidateGameState(OutdoorView, Fresh with Items := Changed.Items; end with).IsError());
  AssertTrue(ValidateGameState(OutdoorView, Fresh with Hostiles := Changed.Hostiles; end with)
               .IsError());
  const Discovered: GameState := Fresh with Exploration := ExplorationState(OutdoorChunks := [], InteriorAreas := [
                                                                                                                    InteriorDiscoveryArea(AreaId := Map.AreaId, Width := Map.Width, Height := Map.Height, Fields := array.Fill(false, Map.Width *
                                                                                                                                                                                                                                      Map.Height))
                                                                                                                  ]); end with;

  AssertTrue(ValidateGameState(OutdoorView, Discovered).IsError());
  // Materialization maintains canonical order even when areas are supplied in reverse.
  const EmptyMap: InteriorMap := Map with Items := []; Hostiles := []; end with;
  const Z: GameState := MaterializeArea(Fresh, EmptyMap with AreaId := 'z'; end with);
  const A: GameState := MaterializeArea(Z, EmptyMap with AreaId := 'a'; end with);
  const AA: GameState := MaterializeArea(A, EmptyMap with AreaId := 'aa'; end with);
  AssertEquals('a', AA.VisitedAreas[0]);
  AssertEquals('aa', AA.VisitedAreas[1]);
  AssertEquals('z', AA.VisitedAreas[2]);
  AssertEquals(3, MaterializeArea(AA, EmptyMap with AreaId := 'a'; end with).VisitedAreas.Length());
  AssertEquals(0, NewGame(Metadata).VisitedAreas.Length());
end.
