// Verifies identity-bearing maps and caller-supplied current-area views.
program AreaViewTest;

uses
  Dungeon.Test.Fixtures, Dungeon.Areas, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interior,
  Dungeon.Hostiles, Dungeon.Items, Dungeon.Terrain, Dungeon.Terrain.Placement, Std.Test;

procedure AssertSameMap(Expected: InteriorMap; Actual: InteriorMap);
begin
  AssertEquals(Expected.AreaId, Actual.AreaId);
  AssertEquals(Expected.Width, Actual.Width);
  AssertEquals(Expected.Height, Actual.Height);
  AssertTrue(Expected.Start = Actual.Start);
  AssertTrue(Expected.Exit = Actual.Exit);
  AssertTrue(Expected.StartFacing = Actual.StartFacing);
  AssertEquals(Expected.Cells.Length(), Actual.Cells.Length());
  for Index: integer := 0 to Expected.Cells.Length() - 1 do
    begin
      AssertTrue(Expected.Cells[Index] = Actual.Cells[Index]);
    end;
  end for;

  AssertEquals(Expected.Items.Length(), Actual.Items.Length());
  for Index: integer := 0 to Expected.Items.Length() - 1 do
    begin
      AssertTrue(Expected.Items[Index] = Actual.Items[Index]);
    end;
  end for;

  AssertEquals(Expected.Hostiles.Length(), Actual.Hostiles.Length());
  for Index: integer := 0 to Expected.Hostiles.Length() - 1 do
    begin
      AssertTrue(Expected.Hostiles[Index] = Actual.Hostiles[Index]);
    end;
  end for;
end procedure;

// Compares geometry and placement kinds and fields; placement identities are area-scoped and may differ.
procedure AssertSameLayout(Expected: InteriorMap; Actual: InteriorMap);
begin
  AssertEquals(Expected.Width, Actual.Width);
  AssertEquals(Expected.Height, Actual.Height);
  AssertTrue(Expected.Start = Actual.Start);
  AssertTrue(Expected.Exit = Actual.Exit);
  AssertTrue(Expected.StartFacing = Actual.StartFacing);
  AssertEquals(Expected.Cells.Length(), Actual.Cells.Length());
  for Index: integer := 0 to Expected.Cells.Length() - 1 do
    begin
      AssertTrue(Expected.Cells[Index] = Actual.Cells[Index]);
    end;
  end for;

  AssertEquals(Expected.Items.Length(), Actual.Items.Length());
  for Index: integer := 0 to Expected.Items.Length() - 1 do
    begin
      AssertTrue(Expected.Items[Index].Kind = Actual.Items[Index].Kind);
      AssertTrue(Expected.Items[Index].Position = Actual.Items[Index].Position);
      AssertEquals(ItemPlacementId(Expected.AreaId, Index), Expected.Items[Index].ItemId);
      AssertEquals(ItemPlacementId(Actual.AreaId, Index), Actual.Items[Index].ItemId);
    end;
  end for;

  AssertEquals(Expected.Hostiles.Length(), Actual.Hostiles.Length());
  for Index: integer := 0 to Expected.Hostiles.Length() - 1 do
    begin
      AssertTrue(Expected.Hostiles[Index].Kind = Actual.Hostiles[Index].Kind);
      AssertTrue(Expected.Hostiles[Index].Position = Actual.Hostiles[Index].Position);
      AssertEquals(HostilePlacementId(Expected.AreaId, Index), Expected.Hostiles[Index].Id);
      AssertEquals(HostilePlacementId(Actual.AreaId, Index), Actual.Hostiles[Index].Id);
    end;
  end for;
end procedure;

begin
  const Metadata: WorldMetadata := NewWorldMetadata('area-view-test', 12345, 4).Unwrap();
  const OtherMetadata: WorldMetadata := NewWorldMetadata('other-view-test', 12345, 4).Unwrap();
  const Map: InteriorMap := FixtureDungeonMapFor(SpawnDungeonAreaId(Metadata));
  const OtherMap: InteriorMap := FixtureDungeonMapFor(SpawnDungeonAreaId(OtherMetadata));
  AssertEquals(SpawnDungeonAreaId(Metadata), Map.AreaId);
  AssertEquals(SpawnDungeonAreaId(OtherMetadata), OtherMap.AreaId);
  AssertTrue(Map.AreaId <> OtherMap.AreaId);
  AssertSameLayout(Map, OtherMap);
  AssertTrue(ValidateInteriorMap(Map with AreaId := ''; end with).IsError());
  const Outdoor: GameState := NewGame(Metadata);
  const OutdoorView: AreaView := AreaViewFor(Metadata, Outdoor, None).Unwrap();
  AssertTrue(OutdoorView.Metadata = Metadata);
  AssertTrue(OutdoorView.Interior.IsNone());
  AssertTrue(AreaViewFor(Metadata, Outdoor, Some(Map)).IsError());
  AssertTrue(AreaViewFor(OtherMetadata, Outdoor, None).IsError());
  const Dungeon: GameState := Outdoor with Area := AreaKind.Dungeon; AreaId := Map.AreaId; end with;
  const DungeonView: AreaView := AreaViewFor(Metadata, Dungeon, Some(Map)).Unwrap();
  AssertTrue(DungeonView.Metadata = Metadata);
  AssertSameMap(Map, DungeonView.Interior.Unwrap());
  AssertTrue(AreaViewFor(Metadata, Dungeon, None).IsError());
  AssertTrue(AreaViewFor(Metadata, Dungeon, Some(OtherMap)).IsError());
  AssertTrue(AreaViewFor(Metadata, Dungeon with AreaId := ''; end with, Some(Map with AreaId := ''; end with))
               .IsError());
  AssertTrue(AreaViewFor(Metadata, Outdoor with Area := AreaKind.Settlement; end with, None)
               .IsError());
  // A supplied map is retained rather than reconstructed from the fixed layout.
  const Custom: InteriorMap := ValidateInteriorMap(Map with Hostiles := []; end with).Unwrap();
  const CustomView: AreaView := AreaViewFor(Metadata, Dungeon, Some(Custom)).Unwrap();
  AssertSameMap(Custom, CustomView.Interior.Unwrap());
end.
