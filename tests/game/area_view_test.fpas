// Verifies identity-bearing maps and caller-supplied current-area views.
program AreaViewTest;

uses
  Dungeon.Areas, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interior, Dungeon.Hostiles,
  Dungeon.Interior.InitialDungeon, Dungeon.Items, Dungeon.Terrain, Dungeon.Terrain.Placement,
  Std.Arrays, Std.Options, Std.Results, Std.Test;

procedure AssertSameMap(Expected: InteriorMap; Actual: InteriorMap);
begin
  AssertEquals(Expected.AreaId, Actual.AreaId);
  AssertEquals(Expected.Width, Actual.Width);
  AssertEquals(Expected.Height, Actual.Height);
  AssertTrue(Expected.Start = Actual.Start);
  AssertTrue(Expected.Exit = Actual.Exit);
  AssertTrue(Expected.StartFacing = Actual.StartFacing);
  AssertEquals(Std.Arrays.Length(Expected.Cells), Std.Arrays.Length(Actual.Cells));
  for Index: integer := 0 to Std.Arrays.Length(Expected.Cells) - 1 do
  begin
    AssertTrue(Expected.Cells[Index] = Actual.Cells[Index])
  end;

  AssertEquals(Std.Arrays.Length(Expected.Items), Std.Arrays.Length(Actual.Items));
  for Index: integer := 0 to Std.Arrays.Length(Expected.Items) - 1 do
  begin
    AssertTrue(Expected.Items[Index] = Actual.Items[Index])
  end;

  AssertEquals(Std.Arrays.Length(Expected.Hostiles), Std.Arrays.Length(Actual.Hostiles));
  for Index: integer := 0 to Std.Arrays.Length(Expected.Hostiles) - 1 do
  begin
    AssertTrue(Expected.Hostiles[Index] = Actual.Hostiles[Index])
  end
end;

// Compares geometry and placement kinds and fields; placement identities are area-scoped and may differ.
procedure AssertSameLayout(Expected: InteriorMap; Actual: InteriorMap);
begin
  AssertEquals(Expected.Width, Actual.Width);
  AssertEquals(Expected.Height, Actual.Height);
  AssertTrue(Expected.Start = Actual.Start);
  AssertTrue(Expected.Exit = Actual.Exit);
  AssertTrue(Expected.StartFacing = Actual.StartFacing);
  AssertEquals(Std.Arrays.Length(Expected.Cells), Std.Arrays.Length(Actual.Cells));
  for Index: integer := 0 to Std.Arrays.Length(Expected.Cells) - 1 do
  begin
    AssertTrue(Expected.Cells[Index] = Actual.Cells[Index])
  end;

  AssertEquals(Std.Arrays.Length(Expected.Items), Std.Arrays.Length(Actual.Items));
  for Index: integer := 0 to Std.Arrays.Length(Expected.Items) - 1 do
  begin
    AssertTrue(Expected.Items[Index].Kind = Actual.Items[Index].Kind);
    AssertTrue(Expected.Items[Index].Position = Actual.Items[Index].Position);
    AssertEquals(ItemPlacementId(Expected.AreaId, Index), Expected.Items[Index].ItemId);
    AssertEquals(ItemPlacementId(Actual.AreaId, Index), Actual.Items[Index].ItemId)
  end;

  AssertEquals(Std.Arrays.Length(Expected.Hostiles), Std.Arrays.Length(Actual.Hostiles));
  for Index: integer := 0 to Std.Arrays.Length(Expected.Hostiles) - 1 do
  begin
    AssertTrue(Expected.Hostiles[Index].Kind = Actual.Hostiles[Index].Kind);
    AssertTrue(Expected.Hostiles[Index].Position = Actual.Hostiles[Index].Position);
    AssertEquals(HostilePlacementId(Expected.AreaId, Index), Expected.Hostiles[Index].Id);
    AssertEquals(HostilePlacementId(Actual.AreaId, Index), Actual.Hostiles[Index].Id)
  end
end;

begin
  var Metadata: WorldMetadata := Std.Results.Unwrap(NewWorldMetadata('area-view-test', 12345));
  var OtherMetadata: WorldMetadata := Std.Results.Unwrap(NewWorldMetadata('other-view-test', 12345));
  var Map: InteriorMap := Std.Results.Unwrap(InitialDungeonMap(Metadata));
  var OtherMap: InteriorMap := Std.Results.Unwrap(InitialDungeonMap(OtherMetadata));
  AssertEquals(Metadata.DungeonAreaId, Map.AreaId);
  AssertEquals(OtherMetadata.DungeonAreaId, OtherMap.AreaId);
  AssertTrue(Map.AreaId <> OtherMap.AreaId);
  AssertSameLayout(Map, OtherMap);
  AssertTrue(IsError(ValidateInteriorMap(Map with AreaId := ''; end)));
  var Outdoor: GameState := NewGame(Metadata);
  var OutdoorView: AreaView := Std.Results.Unwrap(AreaViewFor(Metadata, Outdoor, None));
  AssertTrue(OutdoorView.Metadata = Metadata);
  AssertTrue(Std.Options.IsNone(OutdoorView.Interior));
  AssertTrue(IsError(AreaViewFor(Metadata, Outdoor, Some(Map))));
  AssertTrue(IsError(AreaViewFor(OtherMetadata, Outdoor, None)));
  var Dungeon: GameState := Outdoor with Area := AreaKind.Dungeon; AreaId := Map.AreaId; end;
  var DungeonView: AreaView := Std.Results.Unwrap(AreaViewFor(Metadata, Dungeon, Some(Map)));
  AssertTrue(DungeonView.Metadata = Metadata);
  AssertSameMap(Map, Std.Options.Unwrap(DungeonView.Interior));
  AssertTrue(IsError(AreaViewFor(Metadata, Dungeon, None)));
  AssertTrue(IsError(AreaViewFor(Metadata, Dungeon, Some(OtherMap))));
  AssertTrue(IsError(AreaViewFor(Metadata, Dungeon with AreaId := ''; end, Some(Map with AreaId := ''; end))));
  AssertTrue(IsError(AreaViewFor(Metadata, Outdoor with Area := AreaKind.Settlement; end, None)));
  // A supplied map is retained rather than reconstructed from the fixed layout.
  var Custom: InteriorMap := Std.Results.Unwrap(ValidateInteriorMap(Map with Hostiles := []; end));
  var CustomView: AreaView := Std.Results.Unwrap(AreaViewFor(Metadata, Dungeon, Some(Custom)));
  AssertSameMap(Custom, Std.Options.Unwrap(CustomView.Interior))
end.
