// Verifies authoritative item placement, pickup, inventory, validation, and reset invariants.
program DungeonInventoryTest;

uses Dungeon.Test.Fixtures as Fixtures, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Interaction as Interaction, Dungeon.Interior as InteriorUnit, Dungeon.Items as ItemRules, Dungeon.Movement as Movement, Dungeon.Terrain as Terrain, Dungeon.Terrain.Placement as PlacementRules, Std.Test as Test;

function AtOutdoorEntrance(Metadata: Terrain.WorldMetadata; State: GameState.GameState): GameState.GameState;
begin
  var Value: GameState.GameState := State;
  Value.Player := Coordinates.PlayerPosition.Outdoor(Metadata.SpawnEntrance);
  return Value;
end function;

function AtInteriorPosition(State: GameState.GameState; Position: Coordinates.InteriorPosition; Facing: Coordinates.FacingDirection): GameState.GameState;
begin
  var Value: GameState.GameState := State;
  Value.Player := Coordinates.PlayerPosition.FirstPerson(
    Coordinates.FirstPersonPose(Position := Position, Facing := Facing)
  );
  return Value;
end function;

function RequireChanged(Value: Interaction.InteractionOutcome): GameState.GameState;
begin
  case Value of
    when Interaction.InteractionOutcome.StateChanged(const State):
      return State;
    when Interaction.InteractionOutcome.TransitionRequested(_), Interaction.InteractionOutcome.Described(_, _):
      panic('expected a state-changing item interaction');
  end case;
end function;

begin
  const Metadata: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
    'inventory-test',
    77191,
    4
  ).Unwrap();
  const Map: InteriorUnit.InteriorMap := Fixtures.FixtureDungeonMapFor(
    Fixtures.SpawnDungeonAreaId(Metadata)
  );
  const Initial: GameState.GameState := Fixtures.MaterializedFixtureState(Metadata);
  const CoinField: Coordinates.InteriorPosition := Map.Items[0].Position;
  Test.AssertEquals('', Interaction.ItemInteractionHint(Initial));
  Test.AssertEquals(3, Initial.Items.Length());
  Test.AssertEquals(Fixtures.FixtureCoinId(Metadata), Initial.Items[0].Id);
  Test.AssertEquals(ItemRules.AncientCoinName, ItemRules.ItemDisplayName(Initial.Items[0].Kind));
  Test.AssertEquals(
    ItemRules.AncientCoinDescription,
    ItemRules.ItemDescription(Initial.Items[0].Kind)
  );
  Test.AssertEquals(0, GameState.InventoryItems(Initial).Length());
  case Initial.Items[0].Location of
    when ItemRules.ItemLocation.InInterior(const AreaId, const Position):
      Test.AssertEquals(Fixtures.SpawnDungeonAreaId(Metadata), AreaId);
      Test.AssertEquals(CoinField.X, Position.X);
      Test.AssertEquals(CoinField.Y, Position.Y);
    when ItemRules.ItemLocation.CarriedByPlayer, ItemRules.ItemLocation.EquippedByPlayer(_), ItemRules.ItemLocation.Consumed:
      panic('new game must place the item in the initial dungeon');
  end case;
  var Missing: GameState.GameState := Initial;
  Missing.Items := [];
  Test.AssertTrue(Fixtures.ValidateFixtureSave(Metadata, Missing) is Error(_));
  var Duplicate: GameState.GameState := Initial;
  Duplicate.Items := [Initial.Items[0], Initial.Items[0]];
  Test.AssertTrue(Fixtures.ValidateFixtureSave(Metadata, Duplicate) is Error(_));
  var UnknownIdentity: GameState.GameState := Initial;
  var ChangedItem: ItemRules.GameItem := UnknownIdentity.Items[0];
  ChangedItem.Id := 'unknown:item';
  UnknownIdentity.Items[0] := ChangedItem;
  Test.AssertTrue(Fixtures.ValidateFixtureSave(Metadata, UnknownIdentity) is Error(_));
  var WrongArea: GameState.GameState := Initial;
  ChangedItem := WrongArea.Items[0];
  ChangedItem.Location := ItemRules.ItemLocation.InInterior(Metadata.OutdoorAreaId, CoinField);
  WrongArea.Items[0] := ChangedItem;
  Test.AssertTrue(Fixtures.ValidateFixtureSave(Metadata, WrongArea) is Error(_));
  var WrongPosition: GameState.GameState := Initial;
  ChangedItem := WrongPosition.Items[0];
  ChangedItem.Location := ItemRules.ItemLocation.InInterior(
    Fixtures.SpawnDungeonAreaId(Metadata),
    Coordinates.InteriorPosition(X := 0, Y := 0)
  );
  WrongPosition.Items[0] := ChangedItem;
  Test.AssertTrue(Fixtures.ValidateFixtureSave(Metadata, WrongPosition) is Error(_));
  var InvalidMap: InteriorUnit.InteriorMap := Map;
  InvalidMap.Items := [
    ItemRules.ItemPlacement(
      ItemId := Fixtures.FixtureCoinId(Metadata),
      Kind := ItemRules.ItemKind.AncientCoin,
      Position := Map.Start
    )
  ];
  Test.AssertTrue(InteriorUnit.ValidateInteriorMap(InvalidMap) is Error(_));
  InvalidMap.Items := [
    ItemRules.ItemPlacement(
      ItemId := Fixtures.FixtureCoinId(Metadata),
      Kind := ItemRules.ItemKind.AncientCoin,
      Position := Coordinates.InteriorPosition(X := 9, Y := 0)
    )
  ];
  Test.AssertTrue(InteriorUnit.ValidateInteriorMap(InvalidMap) is Error(_));
  const Entered: GameState.GameState := Fixtures.ActivateFixtureTransition(
    Metadata,
    AtOutdoorEntrance(Metadata, Initial)
  ).Unwrap();
  Test.AssertEquals('Ancient coin — Enter: Examine', Interaction.ItemInteractionHint(Entered));
  Test.AssertEquals(
    '',
    Interaction.ItemInteractionHint(
      AtInteriorPosition(Entered, Map.Start, Coordinates.FacingDirection.East)
    )
  );
  Test.AssertEquals('i', GameState.InteriorVisibleCodeForState(Map, Entered, CoinField).Unwrap());
  case Interaction.Interact(Fixtures.FixtureViewFor(Metadata, Entered), Entered).Unwrap() of
    when Interaction.InteractionOutcome.Described(const Title, const Text):
      Test.AssertEquals(ItemRules.AncientCoinName, Title);
      Test.AssertEquals(ItemRules.AncientCoinDescription, Text);
    when Interaction.InteractionOutcome.TransitionRequested(_), Interaction.InteractionOutcome.StateChanged(_):
      panic('item directly ahead must be inspectable without being collected');
  end case;

  Test.AssertEquals(0, GameState.InventoryItems(Entered).Length());
  const OnItem: GameState.GameState := AtInteriorPosition(
    Entered,
    CoinField,
    Coordinates.FacingDirection.West
  );
  for Facing: Coordinates.FacingDirection in [
    Coordinates.FacingDirection.North,
    Coordinates.FacingDirection.East,
    Coordinates.FacingDirection.South,
    Coordinates.FacingDirection.West
  ] do
    begin
      Test.AssertEquals(
        'At your feet: Ancient coin — Enter: Pick up',
        Interaction.ItemInteractionHint(AtInteriorPosition(Entered, CoinField, Facing))
      );
    end;
  end for;
  const Collected: GameState.GameState := RequireChanged(
    Interaction.Interact(Fixtures.FixtureViewFor(Metadata, OnItem), OnItem).Unwrap()
  );
  Test.AssertEquals('', Interaction.ItemInteractionHint(Collected));
  Test.AssertEquals(1, GameState.InventoryItems(Collected).Length());
  Test.AssertEquals(Fixtures.FixtureCoinId(Metadata), GameState.InventoryItems(Collected)[0].Id);
  Test.AssertEquals('.', GameState.InteriorVisibleCodeForState(Map, Collected, CoinField).Unwrap());
  Test.AssertTrue(Fixtures.ValidateFixtureSave(Metadata, Collected) is Ok(_));
  case Interaction.Interact(Fixtures.FixtureViewFor(Metadata, Collected), Collected).Unwrap() of
    when Interaction.InteractionOutcome.Described(const Title, const Text):
      Test.AssertEquals(Interaction.NoInteractionMessage, Text);
    when Interaction.InteractionOutcome.TransitionRequested(_), Interaction.InteractionOutcome.StateChanged(_):
      panic('collecting the same item twice must not change state');
  end case;

  Test.AssertEquals(1, GameState.InventoryItems(Collected).Length());
  const AtExit: GameState.GameState := AtInteriorPosition(
    Collected,
    Map.Arrival,
    Coordinates.FacingDirection.West
  );
  case Interaction.Interact(Fixtures.FixtureViewFor(Metadata, AtExit), AtExit).Unwrap() of
    when Interaction.InteractionOutcome.TransitionRequested(const Target):
      Test.AssertEquals(Metadata.OutdoorAreaId, Target);
      const Outside: GameState.GameState := Fixtures.ActivateFixtureTransition(
        Metadata,
        AtExit
      ).Unwrap();
      Test.AssertTrue(Outside.Area = Coordinates.AreaKind.OutdoorRegion);
      Test.AssertEquals(1, GameState.InventoryItems(Outside).Length());
    when Interaction.InteractionOutcome.StateChanged(_), Interaction.InteractionOutcome.Described(_, _):
      panic('carried inventory must survive an area transition');
  end case;
  const Reset: GameState.GameState := GameState.NewGame(Metadata);
  Test.AssertEquals(0, GameState.InventoryItems(Reset).Length());
  Test.AssertEquals('i', GameState.InteriorVisibleCodeForState(Map, Entered, CoinField).Unwrap());
end.
