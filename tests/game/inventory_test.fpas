// Verifies authoritative item placement, pickup, inventory, validation, and reset invariants.
program DungeonInventoryTest;

uses
  Dungeon.Test.Fixtures, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interaction,
  Dungeon.Interior, Dungeon.Items, Dungeon.Movement, Dungeon.Terrain, Dungeon.Terrain.Placement,
  Std.Arrays, Std.Results, Std.Test;

function AtOutdoorEntrance(Metadata: WorldMetadata; State: GameState): GameState;
begin
  mutable var Value: GameState := State;
  Value.Player := PlayerPosition.Outdoor(Metadata.SpawnEntrance);
  return Value
end;

function AtInteriorPosition(State: GameState; Position: InteriorPosition; Facing: FacingDirection): GameState;
begin
  mutable var Value: GameState := State;
  Value.Player := PlayerPosition.FirstPerson(record
    Position := Position;
    Facing := Facing;
  end);
  return Value
end;

function RequireChanged(Value: InteractionOutcome): GameState;
begin
  case Value of
    InteractionOutcome.StateChanged(State):
    begin
      return State
    end
    else
    begin
      panic('expected a state-changing item interaction')
    end
  end
end;

begin
  var Metadata: WorldMetadata := Unwrap(NewWorldMetadata('inventory-test', 77191, 4));
  var Map: InteriorMap := FixtureDungeonMapFor(SpawnDungeonAreaId(Metadata));
  var Initial: GameState := MaterializedFixtureState(Metadata);
  var CoinField: InteriorPosition := Map.Items[0].Position;
  AssertEquals('', ItemInteractionHint(Initial));
  AssertEquals(3, Std.Arrays.Length(Initial.Items));
  AssertEquals(FixtureCoinId(Metadata), Initial.Items[0].Id);
  AssertEquals(AncientCoinName, ItemDisplayName(Initial.Items[0].Kind));
  AssertEquals(AncientCoinDescription, ItemDescription(Initial.Items[0].Kind));
  AssertEquals(0, Std.Arrays.Length(InventoryItems(Initial)));
  case Initial.Items[0].Location of
    ItemLocation.InInterior(AreaId, Position):
    begin
      AssertEquals(SpawnDungeonAreaId(Metadata), AreaId);
      AssertEquals(CoinField.X, Position.X);
      AssertEquals(CoinField.Y, Position.Y)
    end
    else
    begin
      panic('new game must place the item in the initial dungeon')
    end
  end;
  mutable var Missing: GameState := Initial;
  Missing.Items := [];
  AssertTrue(IsError(ValidateFixtureSave(Metadata, Missing)));
  mutable var Duplicate: GameState := Initial;
  Duplicate.Items := [Initial.Items[0], Initial.Items[0]];
  AssertTrue(IsError(ValidateFixtureSave(Metadata, Duplicate)));
  mutable var UnknownIdentity: GameState := Initial;
  mutable var ChangedItem: GameItem := UnknownIdentity.Items[0];
  ChangedItem.Id := 'unknown:item';
  UnknownIdentity.Items[0] := ChangedItem;
  AssertTrue(IsError(ValidateFixtureSave(Metadata, UnknownIdentity)));
  mutable var WrongArea: GameState := Initial;
  ChangedItem := WrongArea.Items[0];
  ChangedItem.Location := ItemLocation.InInterior(Metadata.OutdoorAreaId, CoinField);
  WrongArea.Items[0] := ChangedItem;
  AssertTrue(IsError(ValidateFixtureSave(Metadata, WrongArea)));
  mutable var WrongPosition: GameState := Initial;
  ChangedItem := WrongPosition.Items[0];
  ChangedItem.Location := ItemLocation.InInterior(SpawnDungeonAreaId(Metadata), record
    X := 0;
    Y := 0;
  end);
  WrongPosition.Items[0] := ChangedItem;
  AssertTrue(IsError(ValidateFixtureSave(Metadata, WrongPosition)));
  mutable var InvalidMap: InteriorMap := Map;
  InvalidMap.Items := [record
    ItemId := FixtureCoinId(Metadata);
    Kind := ItemKind.AncientCoin;
    Position := Map.Start;
  end];
  AssertTrue(IsError(ValidateInteriorMap(InvalidMap)));
  InvalidMap.Items := [record
    ItemId := FixtureCoinId(Metadata);
    Kind := ItemKind.AncientCoin;
    Position := record
      X := 9;
      Y := 0;
    end;
  end];
  AssertTrue(IsError(ValidateInteriorMap(InvalidMap)));
  var Entered: GameState := Unwrap(ActivateFixtureTransition(Metadata, AtOutdoorEntrance(Metadata, Initial)));
  AssertEquals('Ancient coin — Enter: Examine', ItemInteractionHint(Entered));
  AssertEquals('', ItemInteractionHint(AtInteriorPosition(Entered, Map.Start, FacingDirection.East)));
  AssertEquals('i', Unwrap(InteriorVisibleCodeForState(Map, Entered, CoinField)));
  case Unwrap(Interact(FixtureViewFor(Metadata, Entered), Entered)) of
    InteractionOutcome.Described(Title, Text):
    begin
      AssertEquals(AncientCoinName, Title);
      AssertEquals(AncientCoinDescription, Text)
    end
    else
    begin
      panic('item directly ahead must be inspectable without being collected')
    end
  end;

  AssertEquals(0, Std.Arrays.Length(InventoryItems(Entered)));
  var OnItem: GameState := AtInteriorPosition(Entered, CoinField, FacingDirection.West);
  for Facing: FacingDirection in [
                                   FacingDirection.North,
                                   FacingDirection.East,
                                   FacingDirection.South,
                                   FacingDirection.West
                                 ] do
  begin
    AssertEquals('At your feet: Ancient coin — Enter: Pick up', ItemInteractionHint(AtInteriorPosition(Entered, CoinField, Facing)))
  end;
  var Collected: GameState := RequireChanged(Unwrap(Interact(FixtureViewFor(Metadata, OnItem), OnItem)));
  AssertEquals('', ItemInteractionHint(Collected));
  AssertEquals(1, Std.Arrays.Length(InventoryItems(Collected)));
  AssertEquals(FixtureCoinId(Metadata), InventoryItems(Collected)[0].Id);
  AssertEquals('.', Unwrap(InteriorVisibleCodeForState(Map, Collected, CoinField)));
  AssertTrue(IsOk(ValidateFixtureSave(Metadata, Collected)));
  case Unwrap(Interact(FixtureViewFor(Metadata, Collected), Collected)) of
    InteractionOutcome.Described(Title, Text):
    begin
      AssertEquals(NoInteractionMessage, Text)
    end
    else
    begin
      panic('collecting the same item twice must not change state')
    end
  end;

  AssertEquals(1, Std.Arrays.Length(InventoryItems(Collected)));
  var AtExit: GameState := AtInteriorPosition(Collected, Map.Exit, FacingDirection.West);
  case Unwrap(Interact(FixtureViewFor(Metadata, AtExit), AtExit)) of
    InteractionOutcome.TransitionRequested(Target):
    begin
      AssertEquals(Metadata.OutdoorAreaId, Target);
      var Outside: GameState := Unwrap(ActivateFixtureTransition(Metadata, AtExit));
      AssertTrue(Outside.Area = AreaKind.OutdoorRegion);
      AssertEquals(1, Std.Arrays.Length(InventoryItems(Outside)))
    end
    else
    begin
      panic('carried inventory must survive an area transition')
    end
  end;
  var Reset: GameState := NewGame(Metadata);
  AssertEquals(0, Std.Arrays.Length(InventoryItems(Reset)));
  AssertEquals('i', Unwrap(InteriorVisibleCodeForState(Map, Entered, CoinField)))
end.
