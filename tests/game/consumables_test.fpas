// Verifies potion identity, capped healing, rejected use and exactly one subsequent hostile phase.
program ConsumablesTest;

uses Dungeon.Areas as Areas, Dungeon.Combat as Combat, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Hostiles as Hostiles, Dungeon.Interior as InteriorUnit, Dungeon.Items as Items, Dungeon.Test.Fixtures as Fixtures, Dungeon.Test.StateComparison as States, Std.Conv as Conv, Std.Test as Test;

// Authored geometry and original placements, independent of the generated encounter contract.
function PotionMap(Kinds: array of Hostiles.HostileKind): InteriorUnit.InteriorMap;
begin
  var Map := Fixtures.WithPotion(Fixtures.FixtureDungeonMap()) with Hostiles := []; end with;
  const Positions := [
    Coordinates.InteriorPosition(X := 2, Y := 3),
    Coordinates.InteriorPosition(X := 4, Y := 3),
    Coordinates.InteriorPosition(X := 3, Y := 4)
  ];
  for Index: integer := 0 to Kinds.Length() - 1 do
    Map.Hostiles.PushInPlace(
      Hostiles.HostilePlacement(
        Id := Map.AreaId + ':hostile:' + Conv.IntToStr(Index),
        Kind := Kinds[Index], Position := Positions[Index]
      )
    );
  end for;

  return InteriorUnit.ValidateInteriorMap(Map).Unwrap();
end function;

function Inside(Map: InteriorUnit.InteriorMap; Health: integer; Seed: integer): GameState.GameState;
begin
  const Fresh := Areas.MaterializeArea(GameState.NewGame(Fixtures.FixtureMetadata()), Map);
  var State := Fixtures.FixtureDungeonState(
    Coordinates.InteriorPosition(X := 3, Y := 3), Coordinates.FacingDirection.West
  ) with Items := Fresh.Items; Hostiles := Fresh.Hostiles; Health := Health; RandomState := Seed; end with;

  State.Items[3] := State.Items[3] with Location := Items.ItemLocation.CarriedByPlayer; end with;

  for Index: integer := 0 to State.Hostiles.Length() - 1 do
    State.Hostiles[Index] := State.Hostiles[Index] with Alerted := true; end with;
  end for;

  return Areas.ValidateSavedGame(Fixtures.FixtureMetadata(), State, [Map]).Unwrap();
end function;

function ViewFor(Map: InteriorUnit.InteriorMap; State: GameState.GameState): GameState.AreaView;
begin
  if State.Area = Coordinates.AreaKind.OutdoorRegion then
    return GameState.AreaView(Metadata := Fixtures.FixtureMetadata(), Interior := None);
  end if;

  return GameState.AreaView(Metadata := Fixtures.FixtureMetadata(), Interior := Some(Map));
end function;

function Use(Map: InteriorUnit.InteriorMap; State: GameState.GameState; Id: string): result of (Combat.TurnOutcome, string);
begin
  return Combat.ResolveTurn(ViewFor(Map, State), State, Combat.TurnAction.UseItem(Id));
end function;

function Continued(Outcome: Combat.TurnOutcome): GameState.GameState;
begin
  case Outcome of
    when Combat.TurnOutcome.Continued(const State, _, _):
      return State;
    when Combat.TurnOutcome.Defeated(_):
      panic('expected a surviving potion turn');
  end case;
end function;

procedure AssertQuietUse(Map: InteriorUnit.InteriorMap; Initial: GameState.GameState; Expected: GameState.GameState; Message: string);
begin
  const Untouched := Initial;
  case Use(Map, Initial, Map.Items[3].ItemId).Unwrap() of
    when Combat.TurnOutcome.Continued(const State, const Log, const Events):
      Test.AssertTrue(States.SameState(Expected, State));
      Test.AssertEquals(1, Log.Length());
      Test.AssertEquals(Message, Log[0]);
      Test.AssertEquals(0, Events.Length());
      Test.AssertTrue(Areas.ValidateSavedGame(Fixtures.FixtureMetadata(), State, [Map]) is Ok(_));
    when Combat.TurnOutcome.Defeated(_):
      panic('a quiet potion turn cannot defeat the player');
  end case;

  Test.AssertTrue(States.SameState(Untouched, Initial));
end procedure;

procedure AssertRejected(Map: InteriorUnit.InteriorMap; Initial: GameState.GameState; Id: string; Reason: string);
begin
  Test.AssertTrue(GameState.ValidateGameState(ViewFor(Map, Initial), Initial) is Ok(_));
  const Untouched := Initial;
  case Use(Map, Initial, Id) of
    when Error(const Message):
      Test.AssertEquals(Reason, Message);
    when Ok(_):
      panic('rejected item use must not return a turn or hostile facts');
  end case;

  Test.AssertTrue(States.SameState(Untouched, Initial));
end procedure;

begin
  const Map := PotionMap([]);
  const Id := Map.Items[3].ItemId;
  // No hostiles: every other field, including the random state, stays exactly equal.
  const Ten := Inside(Map, 10, 1);
  var Sixteen := Inside(Map, 16, 1);
  Sixteen.Items[3] := Sixteen.Items[3] with Location := Items.ItemLocation.Consumed; end with;

  AssertQuietUse(Map, Ten, Sixteen, 'You drink the healing potion and recover 6 health.');
  const Eighteen := Inside(Map, 18, 12345);
  var Full := Inside(Map, 20, 12345);
  Full.Items[3] := Full.Items[3] with Location := Items.ItemLocation.Consumed; end with;

  AssertQuietUse(Map, Eighteen, Full, 'You drink the healing potion and recover 2 health.');
  const One := Inside(Map, 1, 0);
  var Seven := Inside(Map, 7, 0);
  Seven.Items[3] := Seven.Items[3] with Location := Items.ItemLocation.Consumed; end with;

  AssertQuietUse(Map, One, Seven, 'You drink the healing potion and recover 6 health.');
  Test.AssertEquals(4, Sixteen.Items.Length());
  Test.AssertEquals(Id, Sixteen.Items[3].Id);
  Test.AssertEquals(0, GameState.InventoryItems(Sixteen).Length());

  // Two identically named potions are distinguished by stable identity, including stale repeats.
  var PairMap := Map;
  PairMap.Items.PushInPlace(
    Items.ItemPlacement(
      ItemId := Map.AreaId + ':item:4', Kind := Items.ItemKind.HealingPotion,
      Position := Coordinates.InteriorPosition(X := 2, Y := 1)
    )
  );
  var Pair := Inside(PairMap, 10, 7);
  Pair.Items[4] := Pair.Items[4] with Location := Items.ItemLocation.CarriedByPlayer; end with;

  Test.AssertTrue(Areas.ValidateSavedGame(Fixtures.FixtureMetadata(), Pair, [PairMap]) is Ok(_));
  Test.AssertEquals(
    Items.ItemDisplayName(Pair.Items[3].Kind),
    Items.ItemDisplayName(Pair.Items[4].Kind)
  );
  const AfterFirst := Continued(Use(PairMap, Pair, Pair.Items[4].Id).Unwrap());
  Test.AssertTrue(AfterFirst.Items[3].Location = Items.ItemLocation.CarriedByPlayer);
  Test.AssertTrue(AfterFirst.Items[4].Location = Items.ItemLocation.Consumed);
  Test.AssertEquals(16, AfterFirst.Health);
  Test.AssertEquals(7, AfterFirst.RandomState);
  AssertRejected(PairMap, AfterFirst, Pair.Items[4].Id, 'you do not carry this potion');
  var PairFull := Inside(PairMap, 20, 7);
  PairFull.Items[3] := PairFull.Items[3] with Location := Items.ItemLocation.Consumed; end with;

  PairFull.Items[4] := PairFull.Items[4] with Location := Items.ItemLocation.Consumed; end with;

  AssertQuietUse(
    PairMap,
    AfterFirst,
    PairFull,
    'You drink the healing potion and recover 4 health.'
  );

  // At capacity, consumption frees exactly one place while keeping the origin record.
  var Packed := Ten;
  for Index: integer := 1 to 63 do
    Packed.Items.PushInPlace(
      Items.GameItem(
        Id := 'extra:' + Conv.IntToStr(Index), Kind := Items.ItemKind.AncientCoin,
        Location := Items.ItemLocation.CarriedByPlayer
      )
    );
  end for;

  Test.AssertTrue(GameState.InventoryIsFull(Packed));
  Test.AssertTrue(GameState.ValidateGameState(ViewFor(Map, Packed), Packed) is Ok(_));
  const Relieved := Continued(Use(Map, Packed, Id).Unwrap());
  Test.AssertEquals(63, GameState.InventoryItems(Relieved).Length());
  Test.AssertFalse(GameState.InventoryIsFull(Relieved));
  Test.AssertEquals(Packed.Items.Length(), Relieved.Items.Length());
  Test.AssertTrue(Relieved.Items[3].Location = Items.ItemLocation.Consumed);

  // Outdoors, even alerted stored hostiles neither act nor roll; no outdoor step healing is added.
  const MixedMap := PotionMap([
    Hostiles.HostileKind.RestlessSkeleton,
    Hostiles.HostileKind.GiantRat
  ]);
  const Metadata := Fixtures.FixtureMetadata();
  const Outdoors := Inside(MixedMap, 10, 1) with Area := Coordinates.AreaKind.OutdoorRegion; AreaId := Metadata.OutdoorAreaId; Player := Coordinates.PlayerPosition.Outdoor(
    Metadata.Spawn
  ); ReturnLocation := Coordinates.ReturnLocation.NoReturnLocation; end with;
  var OutdoorExpected := Outdoors with Health := 16; end with;

  OutdoorExpected.Items[3] := OutdoorExpected.Items[3] with Location := Items.ItemLocation.Consumed; end with;

  AssertQuietUse(
    MixedMap,
    Outdoors,
    OutdoorExpected,
    'You drink the healing potion and recover 6 health.'
  );

  // Independent seed 1 vector: skeleton hit19/d4=3, rat hit14/d2=2. Heal 1->7 before both attacks.
  const Fragile := Inside(MixedMap, 1, 1);
  const FragileCopy := Inside(MixedMap, 1, 1);
  var Survived := Inside(MixedMap, 2, 1147902781);
  Survived.Items[3] := Survived.Items[3] with Location := Items.ItemLocation.Consumed; end with;

  case Use(MixedMap, Fragile, Id).Unwrap() of
    when Combat.TurnOutcome.Continued(const State, const Log, const Events):
      Test.AssertTrue(States.SameState(Survived, State));
      Test.AssertEquals(3, Log.Length());
      Test.AssertEquals('You drink the healing potion and recover 6 health.', Log[0]);
      Test.AssertEquals(2, Events.Length());
      Test.AssertTrue(
        Events[0] =
        Combat.CombatEvent(
          Kind := Combat.CombatEventKind.HostileHit, Amount := 3,
          HostileKind := Hostiles.HostileKind.RestlessSkeleton
        )
      );
      Test.AssertTrue(
        Events[1] =
        Combat.CombatEvent(
          Kind := Combat.CombatEventKind.HostileHit, Amount := 2,
          HostileKind := Hostiles.HostileKind.GiantRat
        )
      );
    when Combat.TurnOutcome.Defeated(_):
      panic('healing before the two hits must keep the player alive');
  end case;

  Test.AssertTrue(States.SameState(FragileCopy, Fragile));

  // Seed 0: first d20=1 misses, with no damage draw and no player attack event.
  const MissMap := PotionMap([Hostiles.HostileKind.GiantRat]);
  var MissExpected := Inside(MissMap, 16, 12345);
  MissExpected.Items[3] := MissExpected.Items[3] with Location := Items.ItemLocation.Consumed; end with;

  case Use(MissMap, Inside(MissMap, 10, 0), Id).Unwrap() of
    when Combat.TurnOutcome.Continued(const State, const Log, const Events):
      Test.AssertTrue(States.SameState(MissExpected, State));
      Test.AssertEquals(2, Log.Length());
      Test.AssertEquals(1, Events.Length());
      Test.AssertTrue(
        Events[0] =
        Combat.CombatEvent(
          Kind := Combat.CombatEventKind.HostileMiss, Amount := 0,
          HostileKind := Hostiles.HostileKind.GiantRat
        )
      );
    when Combat.TurnOutcome.Defeated(_):
      panic('a miss cannot defeat the healed player');
  end case;

  // Rejections occur before the adjacent opponents get a phase, including at full health.
  const Hurt := Inside(MixedMap, 10, 1);
  AssertRejected(MixedMap, Hurt, 'unknown-item', 'unknown item');
  AssertRejected(MixedMap, Hurt, '', 'unknown item');
  var OnFloor := Inside(MixedMap, 10, 1);
  OnFloor.Items[3] := OnFloor.Items[3] with Location := Items.ItemLocation.InInterior(
    Map.AreaId, Map.Items[3].Position
  ); end with;

  AssertRejected(MixedMap, OnFloor, Id, 'you do not carry this potion');
  var Used := Inside(MixedMap, 10, 1);
  Used.Items[3] := Used.Items[3] with Location := Items.ItemLocation.Consumed; end with;

  AssertRejected(MixedMap, Used, Id, 'you do not carry this potion');
  var Coin := Hurt;
  Coin.Items[0] := Coin.Items[0] with Location := Items.ItemLocation.CarriedByPlayer; end with;

  AssertRejected(MixedMap, Coin, Coin.Items[0].Id, 'this item cannot be consumed');
  var Worn := Hurt;
  Worn.Items[1] := Worn.Items[1] with Location := Items.ItemLocation.EquippedByPlayer(
    Items.EquipmentSlot.Weapon
  ); end with;

  AssertRejected(MixedMap, Worn, Worn.Items[1].Id, 'this item cannot be consumed');
  AssertRejected(MixedMap, Inside(MixedMap, 20, 1), Id, 'you are already at full health');

  // A valid authored three-attacker fixture can defeat health1 after healing to7.
  // Seed1 gives rat1 + rat2 + skeleton4 damage; the planned skeleton/rat pair cannot deal seven.
  const DefeatMap := PotionMap([
    Hostiles.HostileKind.GiantRat, Hostiles.HostileKind.GiantRat,
    Hostiles.HostileKind.RestlessSkeleton
  ]);
  const Doomed := Inside(DefeatMap, 1, 1);
  const DoomedCopy := Inside(DefeatMap, 1, 1);
  case Use(DefeatMap, Doomed, Id).Unwrap() of
    when Combat.TurnOutcome.Defeated(const Log):
      Test.AssertEquals(5, Log.Length());
      Test.AssertEquals('You drink the healing potion and recover 6 health.', Log[0]);
      Test.AssertEquals('The Giant rat strikes you for 1.', Log[1]);
      Test.AssertEquals('The Giant rat strikes you for 2.', Log[2]);
      Test.AssertEquals('The Restless skeleton strikes you for 4.', Log[3]);
      Test.AssertEquals('You have fallen.', Log[4]);
    when Combat.TurnOutcome.Continued(_, _, _):
      panic('three independently pinned hits must defeat the healed player');
  end case;

  Test.AssertTrue(States.SameState(DoomedCopy, Doomed));
end.
