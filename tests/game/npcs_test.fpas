// Verifies Mara's fixed world identity, blocking and visible-only projection, and strict record validation.
program NpcsTest;

uses
  Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Interior as InteriorUnit,
  Dungeon.Movement as Movement, Dungeon.Npcs as Npcs, Dungeon.Settlements as Settlements,
  Dungeon.Terrain.Placement as Placement, Std.Test as Test;

begin
  const Metadata := Placement.NewWorldMetadata('npc', 12345, 4).Unwrap();
  const Initial := GameState.NewGame(Metadata);
  Test.AssertEquals(1, Initial.Npcs.Length());
  Test.AssertEquals('npc:settlement:home:npc:mara', Initial.Npcs[0].Id);
  Test.AssertEquals('npc:settlement:home', Initial.Npcs[0].AreaId);
  Test.AssertFalse(Initial.Npcs[0].HasMetPlayer);
  Test.AssertTrue(Npcs.ValidateNpcs(Metadata, Initial.VisitedAreas, []) is Error(_));
  Test.AssertTrue(
    Npcs.ValidateNpcs(Metadata, Initial.VisitedAreas, [Initial.Npcs[0], Initial.Npcs[0]]) is Error(_)
  );
  Test.AssertTrue(
    Npcs.ValidateNpcs(
      Metadata,
      Initial.VisitedAreas,
      [Initial.Npcs[0] with Id := 'other'; end with]
    ) is Error(_)
  );
  Test.AssertTrue(
    Npcs.ValidateNpcs(
      Metadata,
      Initial.VisitedAreas,
      [Initial.Npcs[0] with AreaId := 'other:settlement:home'; end with]
    ) is Error(_)
  );
  const Outside := Initial with Player := Coordinates.PlayerPosition.Outdoor(
    Metadata.SettlementGate
  ); end with;
  const Entry := Movement.ActivateAreaTransition(
    GameState.AreaView(Metadata := Metadata, Interior := None),
    Outside,
    None
  ).Unwrap();
  const Near := Entry.State with Player := Coordinates.PlayerPosition.Settlement(
    Coordinates.InteriorPosition(X := 11, Y := 8)
  ); end with;

  Test.AssertTrue(Movement.MoveSettlement(Entry.View, Near, 0, -1) is Error(_));
  const Mara := Coordinates.InteriorPosition(X := 11, Y := 7);
  Test.AssertTrue(
    InteriorUnit.InteriorCellAt(Settlements.HomeMap(Metadata), Mara).Unwrap() =
    InteriorUnit.InteriorCellKind.Floor
  );
  Test.AssertTrue(
    GameState.ValidateGameState(
      Entry.View,
      Near with Player := Coordinates.PlayerPosition.Settlement(Mara); end with
    ) is Error(_)
  );
  Test.AssertEquals(
    'n',
    Npcs.MapCellCode(Entry.View.Interior.Unwrap().Npcs, Near.AreaId, Mara, true, '.')
  );
  Test.AssertEquals(
    '.',
    Npcs.MapCellCode(Entry.View.Interior.Unwrap().Npcs, Near.AreaId, Mara, false, '.')
  );
  Test.AssertEquals(
    '.',
    Npcs.MapCellCode(Entry.View.Interior.Unwrap().Npcs, 'other:settlement:home', Mara, true, '.')
  );
  Test.AssertTrue(
    GameState.ValidateStateShape(Metadata, Initial with Npcs := []; end with) is Error(_)
  );
end.
