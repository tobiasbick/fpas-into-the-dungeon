// Verifies that validation, movement, sight, combat, and transitions use supplied maps.
program MapRulesTest;

uses Dungeon.Areas as Areas, Dungeon.Combat as Combat, Dungeon.Coordinates as Coordinates, Dungeon.Exploration as Exploration, Dungeon.Exploration.Model as Model, Dungeon.GameState as GameState, Dungeon.Hostiles as Hostiles, Dungeon.Interaction as Interaction, Dungeon.Interior as Interior, Dungeon.Items as Items, Dungeon.Movement as Movement, Dungeon.Terrain as Terrain, Dungeon.Test.Fixtures as Fixtures, Std.Test as Test;

begin
  const Metadata: Terrain.WorldMetadata := Fixtures.FixtureMetadata();
  const Fixture: Interior.InteriorMap := Fixtures.FixtureDungeonMap();
  const Fresh: GameState.GameState := Fixtures.FixtureDungeonState(
    Fixture.Start,
    Fixture.StartFacing
  );
  Test.AssertTrue((GameState.ValidateGameState(Fixtures.FixtureAreaView(Fresh), Fresh) is Ok(_)));
  Test.AssertTrue((Areas.ValidateSavedGame(Metadata, Fresh, [Fixture]) is Ok(_)));
  Test.AssertTrue((Areas.ValidateSavedGame(Metadata, Fresh, []) is Error(_)));
  Test.AssertTrue(
    (
      Areas.ValidateSavedGame(Metadata, Fresh, [Fixture with AreaId := 'wrong-area'; end with]) is Error(_)
    )
  );
  var Unknown: GameState.GameState := Fresh;
  Unknown.Items[0] := Unknown.Items[0] with Id := 'unknown-item'; end with;

  Test.AssertTrue(
    (GameState.ValidateGameState(Fixtures.FixtureAreaView(Unknown), Unknown) is Ok(_))
  );
  Test.AssertTrue((Areas.ValidateSavedGame(Metadata, Unknown, [Fixture]) is Error(_)));
  Test.AssertTrue(
    (
      GameState.ValidateGameState(
        GameState.AreaView(Metadata := Metadata, Interior := None),
        Fresh
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      GameState.ValidateGameState(
        GameState.AreaView(
          Metadata := Metadata,
          Interior := Some(Fixture with AreaId := 'wrong-area'; end with)
        ),
        Fresh
      ) is Error(_)
    )
  );
  const Open: Interior.InteriorMap := Interior.ValidateInteriorMap(
    Fixture with Items := []; Hostiles := []; end with
  ).Unwrap();
  const State: GameState.GameState := Fresh with Items := []; Hostiles := []; end with;
  const OpenView: GameState.AreaView := Areas.AreaViewFor(Metadata, State, Some(Open)).Unwrap();
  var Blocked: Interior.InteriorMap := Open;
  Blocked.Cells[Open.Width + 8] := Interior.InteriorCellKind.Wall;
  Blocked := Interior.ValidateInteriorMap(Blocked).Unwrap();
  const BlockedView: GameState.AreaView := Areas.AreaViewFor(
    Metadata,
    State,
    Some(Blocked)
  ).Unwrap();
  const Stepped: GameState.GameState := Movement.StepFirstPerson(
    OpenView,
    State,
    Coordinates.RelativeStep.Forward
  ).Unwrap();
  Test.AssertEquals(8, GameState.FirstPersonPlayerPose(Stepped).Unwrap().Position.X);
  Test.AssertTrue(
    (Movement.StepFirstPerson(BlockedView, State, Coordinates.RelativeStep.Forward) is Error(_))
  );
  Test.AssertTrue((GameState.ValidateGameState(BlockedView, Stepped) is Error(_)));
  Test.AssertTrue((GameState.ValidateGameState(OpenView, Stepped) is Ok(_)));
  const Turned: GameState.GameState := Movement.TurnFirstPerson(
    BlockedView,
    State,
    Coordinates.RelativeTurn.TurnRight
  ).Unwrap();
  Test.AssertTrue(
    GameState.FirstPersonPlayerPose(Turned).Unwrap().Facing = Coordinates.FacingDirection.North
  );
  const SeenOpen: GameState.GameState := Exploration.RevealCurrentArea(OpenView, State).Unwrap();
  const SeenBlocked: GameState.GameState := Exploration.RevealCurrentArea(
    BlockedView,
    State
  ).Unwrap();
  Test.AssertTrue(
    Exploration.InteriorIsDiscovered(SeenOpen.Exploration, Open.AreaId, Open.Width, 7, 1)
  );
  Test.AssertFalse(
    Exploration.InteriorIsDiscovered(SeenBlocked.Exploration, Open.AreaId, Open.Width, 7, 1)
  );
  // Open a field that is a wall in the production initial layout.
  var Expanded: Interior.InteriorMap := Open;
  Expanded.Cells[2 * Open.Width + 8] := Interior.InteriorCellKind.Floor;
  Expanded := Interior.ValidateInteriorMap(Expanded).Unwrap();
  const AtNewField: GameState.GameState := State with Player := Coordinates.PlayerPosition.FirstPerson(
    Coordinates.FirstPersonPose(
      Position := Coordinates.InteriorPosition(X := 8, Y := 2),
      Facing := Coordinates.FacingDirection.West
    )
  ); Hostiles := [
    Fresh.Hostiles[0] with Position := Coordinates.InteriorPosition(X := 7, Y := 2); Alerted := true; end with
  ]; end with;
  const ExpandedView: GameState.AreaView := Areas.AreaViewFor(
    Metadata,
    AtNewField,
    Some(Expanded)
  ).Unwrap();
  Test.AssertTrue((GameState.ValidateGameState(ExpandedView, AtNewField) is Ok(_)));
  Test.AssertTrue((GameState.ValidateGameState(OpenView, AtNewField) is Error(_)));
  case Combat.ResolveTurn(ExpandedView, AtNewField, Combat.TurnAction.Wait).Unwrap() of
    when Combat.TurnOutcome.Continued(const After, const Log, const Events):
      Test.AssertTrue(After.RandomState <> AtNewField.RandomState);
      Test.AssertEquals(2, Log.Length());
      Test.AssertEquals(1, Events.Length());
    when Combat.TurnOutcome.Defeated(_):
      panic('one opponent turn must not defeat a full-health fixture player');
  end case;
  // Move the exit: both interaction eligibility and activation must use the supplied map.
  var MovedExit: Interior.InteriorMap := Expanded;
  MovedExit.Cells[Fixture.Exit.Y * Open.Width + Fixture.Exit.X] := Interior.InteriorCellKind.Floor;
  MovedExit.Cells[2 * Open.Width + 8] := Interior.InteriorCellKind.ExitField;
  MovedExit.Exit := Coordinates.InteriorPosition(X := 8, Y := 2);
  MovedExit := Interior.ValidateInteriorMap(MovedExit).Unwrap();
  const OldExitState: GameState.GameState := State with Player := Coordinates.PlayerPosition.FirstPerson(
    Coordinates.FirstPersonPose(
      Position := Fixture.Exit,
      Facing := Coordinates.FacingDirection.North
    )
  ); end with;
  const ExitView: GameState.AreaView := Areas.AreaViewFor(
    Metadata,
    OldExitState,
    Some(MovedExit)
  ).Unwrap();
  Test.AssertTrue((Movement.AreaTransitionTarget(ExitView, OldExitState) is Error(_)));
  case Interaction.Interact(ExitView, OldExitState).Unwrap() of
    when Interaction.InteractionOutcome.Described(const Title, const Text):
      Test.AssertEquals(Interaction.NoInteractionMessage, Text);
    when Interaction.InteractionOutcome.TransitionRequested(_), Interaction.InteractionOutcome.StateChanged(_):
      panic('the old exit is now an ordinary field');
  end case;
  const AtExit: GameState.GameState := State with Player := Coordinates.PlayerPosition.FirstPerson(
    Coordinates.FirstPersonPose(
      Position := MovedExit.Exit,
      Facing := Coordinates.FacingDirection.West
    )
  ); end with;

  case Interaction.Interact(ExitView, AtExit).Unwrap() of
    when Interaction.InteractionOutcome.TransitionRequested(const Target):
      Test.AssertEquals(Metadata.OutdoorAreaId, Target);
    when Interaction.InteractionOutcome.StateChanged(_), Interaction.InteractionOutcome.Described(_, _):
      panic('the supplied exit must request a transition');
  end case;
  const Left: Movement.AreaTransition := Movement.ActivateAreaTransition(
    ExitView,
    AtExit,
    None
  ).Unwrap();
  Test.AssertTrue(Left.State.Area = Coordinates.AreaKind.OutdoorRegion);
  Test.AssertTrue((Left.View.Interior is None));
  Test.AssertTrue((Movement.ActivateAreaTransition(ExitView, AtExit, Some(MovedExit)) is Error(_)));
  const OutdoorView: GameState.AreaView := Left.View;
  Test.AssertTrue((Movement.ActivateAreaTransition(OutdoorView, Left.State, None) is Error(_)));
  Test.AssertTrue(
    (
      Movement.ActivateAreaTransition(
        OutdoorView,
        Left.State,
        Some(MovedExit with AreaId := 'wrong-area'; end with)
      ) is Error(_)
    )
  );
  const Entered: Movement.AreaTransition := Movement.ActivateAreaTransition(
    OutdoorView,
    Left.State,
    Some(MovedExit)
  ).Unwrap();
  Test.AssertTrue(
    GameState.FirstPersonPlayerPose(Entered.State).Unwrap().Position = MovedExit.Start
  );
  Test.AssertEquals(MovedExit.AreaId, Entered.View.Interior.Unwrap().AreaId);
end.
