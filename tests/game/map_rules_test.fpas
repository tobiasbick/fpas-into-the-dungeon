// Verifies that validation, movement, sight, combat, and transitions use supplied maps.
program MapRulesTest;

uses
  Dungeon.Areas, Dungeon.Combat, Dungeon.Coordinates, Dungeon.Exploration, Dungeon.Exploration.Model,
  Dungeon.GameState, Dungeon.Hostiles, Dungeon.Interaction, Dungeon.Interior, Dungeon.Items,
  Dungeon.Movement, Dungeon.Terrain, Dungeon.Test.Fixtures, Std.Test;

begin
  const Metadata: WorldMetadata := FixtureMetadata();
  const Fixture: InteriorMap := FixtureDungeonMap();
  const Fresh: GameState := FixtureDungeonState(Fixture.Start, Fixture.StartFacing);
  AssertTrue(ValidateGameState(FixtureAreaView(Fresh), Fresh).IsOk());
  AssertTrue(ValidateSavedGame(Metadata, Fresh, [Fixture]).IsOk());
  AssertTrue(ValidateSavedGame(Metadata, Fresh, []).IsError());
  AssertTrue(ValidateSavedGame(Metadata, Fresh, [Fixture with AreaId := 'wrong-area'; end with])
               .IsError());
  var Unknown: GameState := Fresh;
  Unknown.Items[0] := Unknown.Items[0] with Id := 'unknown-item'; end with;

  AssertTrue(ValidateGameState(FixtureAreaView(Unknown), Unknown).IsOk());
  AssertTrue(ValidateSavedGame(Metadata, Unknown, [Fixture]).IsError());
  AssertTrue(ValidateGameState(AreaView(Metadata := Metadata, Interior := None), Fresh).IsError());
  AssertTrue(ValidateGameState(AreaView(Metadata := Metadata, Interior := Some(Fixture with AreaId := 'wrong-area'; end with)), Fresh)
               .IsError());
  const Open: InteriorMap := ValidateInteriorMap(Fixture with Items := []; Hostiles := []; end with)
                               .Unwrap();
  const State: GameState := Fresh with Items := []; Hostiles := []; end with;
  const OpenView: AreaView := AreaViewFor(Metadata, State, Some(Open)).Unwrap();
  var Blocked: InteriorMap := Open;
  Blocked.Cells[Open.Width + 8] := InteriorCellKind.Wall;
  Blocked := ValidateInteriorMap(Blocked).Unwrap();
  const BlockedView: AreaView := AreaViewFor(Metadata, State, Some(Blocked)).Unwrap();
  const Stepped: GameState := StepFirstPerson(OpenView, State, RelativeStep.Forward).Unwrap();
  AssertEquals(8, FirstPersonPlayerPose(Stepped).Unwrap().Position.X);
  AssertTrue(StepFirstPerson(BlockedView, State, RelativeStep.Forward).IsError());
  AssertTrue(ValidateGameState(BlockedView, Stepped).IsError());
  AssertTrue(ValidateGameState(OpenView, Stepped).IsOk());
  const Turned: GameState := TurnFirstPerson(BlockedView, State, RelativeTurn.TurnRight).Unwrap();
  AssertTrue(FirstPersonPlayerPose(Turned).Unwrap().Facing = FacingDirection.North);
  const SeenOpen: GameState := RevealCurrentArea(OpenView, State).Unwrap();
  const SeenBlocked: GameState := RevealCurrentArea(BlockedView, State).Unwrap();
  AssertTrue(InteriorIsDiscovered(SeenOpen.Exploration, Open.AreaId, Open.Width, 7, 1));
  AssertFalse(InteriorIsDiscovered(SeenBlocked.Exploration, Open.AreaId, Open.Width, 7, 1));
  // Open a field that is a wall in the production initial layout.
  var Expanded: InteriorMap := Open;
  Expanded.Cells[2 * Open.Width + 8] := InteriorCellKind.Floor;
  Expanded := ValidateInteriorMap(Expanded).Unwrap();
  const AtNewField: GameState := State with Player := PlayerPosition.FirstPerson(FirstPersonPose(Position := InteriorPosition(X := 8, Y := 2), Facing := FacingDirection.West)); Hostiles := [
                                                                                                                                                                                               Fresh.Hostiles[0] with Position := InteriorPosition(X := 7, Y := 2); Alerted := true; end with
                                                                                                                                                                                             ]; end with;
  const ExpandedView: AreaView := AreaViewFor(Metadata, AtNewField, Some(Expanded)).Unwrap();
  AssertTrue(ValidateGameState(ExpandedView, AtNewField).IsOk());
  AssertTrue(ValidateGameState(OpenView, AtNewField).IsError());
  if ResolveTurn(ExpandedView, AtNewField, TurnAction.Wait).Unwrap() is TurnOutcome.Continued(const After, const Log, const Events) then
    begin
      AssertTrue(After.RandomState <> AtNewField.RandomState);
      AssertEquals(2, Log.Length());
      AssertEquals(1, Events.Length());
    end;
  else
    begin
      panic('one opponent turn must not defeat a full-health fixture player');
    end;
  end if;
  // Move the exit: both interaction eligibility and activation must use the supplied map.
  var MovedExit: InteriorMap := Expanded;
  MovedExit.Cells[Fixture.Exit.Y * Open.Width + Fixture.Exit.X] := InteriorCellKind.Floor;
  MovedExit.Cells[2 * Open.Width + 8] := InteriorCellKind.ExitField;
  MovedExit.Exit := InteriorPosition(X := 8, Y := 2);
  MovedExit := ValidateInteriorMap(MovedExit).Unwrap();
  const OldExitState: GameState := State with Player := PlayerPosition.FirstPerson(FirstPersonPose(Position := Fixture.Exit, Facing := FacingDirection.North)); end with;
  const ExitView: AreaView := AreaViewFor(Metadata, OldExitState, Some(MovedExit)).Unwrap();
  AssertTrue(AreaTransitionTarget(ExitView, OldExitState).IsError());
  if Interact(ExitView, OldExitState).Unwrap() is InteractionOutcome.Described(const Title, const Text) then
    begin
      AssertEquals(NoInteractionMessage, Text);
    end;
  else
    begin
      panic('the old exit is now an ordinary field');
    end;
  end if;
  const AtExit: GameState := State with Player := PlayerPosition.FirstPerson(FirstPersonPose(Position := MovedExit.Exit, Facing := FacingDirection.West)); end with;

  if Interact(ExitView, AtExit).Unwrap() is InteractionOutcome.TransitionRequested(const Target) then
    begin
      AssertEquals(Metadata.OutdoorAreaId, Target);
    end;
  else
    begin
      panic('the supplied exit must request a transition');
    end;
  end if;
  const Left: AreaTransition := ActivateAreaTransition(ExitView, AtExit, None).Unwrap();
  AssertTrue(Left.State.Area = AreaKind.OutdoorRegion);
  AssertTrue(Left.View.Interior.IsNone());
  AssertTrue(ActivateAreaTransition(ExitView, AtExit, Some(MovedExit)).IsError());
  const OutdoorView: AreaView := Left.View;
  AssertTrue(ActivateAreaTransition(OutdoorView, Left.State, None).IsError());
  AssertTrue(ActivateAreaTransition(OutdoorView, Left.State, Some(MovedExit with AreaId := 'wrong-area'; end with))
               .IsError());
  const Entered: AreaTransition := ActivateAreaTransition(OutdoorView, Left.State, Some(MovedExit))
                                     .Unwrap();
  AssertTrue(FirstPersonPlayerPose(Entered.State).Unwrap().Position = MovedExit.Start);
  AssertEquals(MovedExit.AreaId, Entered.View.Interior.Unwrap().AreaId);
end.
