// Verifies that validation, movement, sight, combat, and transitions use supplied maps.
program MapRulesTest;

uses
  Dungeon.Areas, Dungeon.Combat, Dungeon.Coordinates, Dungeon.Exploration, Dungeon.Exploration.Model,
  Dungeon.GameState, Dungeon.Hostiles, Dungeon.Interaction, Dungeon.Interior, Dungeon.Items,
  Dungeon.Movement, Dungeon.Terrain, Dungeon.Test.Fixtures, Std.Arrays, Std.Options, Std.Results,
  Std.Test;

begin
  var Metadata: WorldMetadata := FixtureMetadata();
  var Fixture: InteriorMap := FixtureDungeonMap();
  var Fresh: GameState := FixtureDungeonState(Fixture.Start, Fixture.StartFacing);
  AssertTrue(IsOk(ValidateGameState(FixtureAreaView(Fresh), Fresh)));
  AssertTrue(IsOk(ValidateSavedGame(Metadata, Fresh, [Fixture])));
  AssertTrue(IsError(ValidateSavedGame(Metadata, Fresh, [])));
  AssertTrue(IsError(ValidateSavedGame(Metadata, Fresh, [
                                                          Fixture with AreaId := 'wrong-area'; end with
                                                        ])));
  mutable var Unknown: GameState := Fresh;
  Unknown.Items[0] := Unknown.Items[0] with Id := 'unknown-item'; end with;

  AssertTrue(IsOk(ValidateGameState(FixtureAreaView(Unknown), Unknown)));
  AssertTrue(IsError(ValidateSavedGame(Metadata, Unknown, [Fixture])));
  AssertTrue(IsError(ValidateGameState(record
    Metadata := Metadata;
    Interior := None;
  end, Fresh)));
  AssertTrue(IsError(ValidateGameState(record
    Metadata := Metadata;
    Interior := Some(Fixture with AreaId := 'wrong-area'; end with);
  end, Fresh)));
  var Open: InteriorMap := Std.Results.Unwrap(ValidateInteriorMap(Fixture with Items := []; Hostiles := []; end with));
  var State: GameState := Fresh with Items := []; Hostiles := []; end with;
  var OpenView: AreaView := Std.Results.Unwrap(AreaViewFor(Metadata, State, Some(Open)));
  mutable var Blocked: InteriorMap := Open;
  Blocked.Cells[Open.Width + 8] := InteriorCellKind.Wall;
  Blocked := Std.Results.Unwrap(ValidateInteriorMap(Blocked));
  var BlockedView: AreaView := Std.Results.Unwrap(AreaViewFor(Metadata, State, Some(Blocked)));
  var Stepped: GameState := Std.Results.Unwrap(StepFirstPerson(OpenView, State, RelativeStep.Forward));
  AssertEquals(8, Std.Results.Unwrap(FirstPersonPlayerPose(Stepped)).Position.X);
  AssertTrue(IsError(StepFirstPerson(BlockedView, State, RelativeStep.Forward)));
  AssertTrue(IsError(ValidateGameState(BlockedView, Stepped)));
  AssertTrue(IsOk(ValidateGameState(OpenView, Stepped)));
  var Turned: GameState := Std.Results.Unwrap(TurnFirstPerson(BlockedView, State, RelativeTurn.TurnRight));
  AssertTrue(Std.Results.Unwrap(FirstPersonPlayerPose(Turned)).Facing = FacingDirection.North);
  var SeenOpen: GameState := Std.Results.Unwrap(RevealCurrentArea(OpenView, State));
  var SeenBlocked: GameState := Std.Results.Unwrap(RevealCurrentArea(BlockedView, State));
  AssertTrue(InteriorIsDiscovered(SeenOpen.Exploration, Open.AreaId, Open.Width, 7, 1));
  AssertFalse(InteriorIsDiscovered(SeenBlocked.Exploration, Open.AreaId, Open.Width, 7, 1));
  // Open a field that is a wall in the production initial layout.
  mutable var Expanded: InteriorMap := Open;
  Expanded.Cells[2 * Open.Width + 8] := InteriorCellKind.Floor;
  Expanded := Std.Results.Unwrap(ValidateInteriorMap(Expanded));
  var AtNewField: GameState := State with Player := PlayerPosition.FirstPerson(record
    Position := record
      X := 8;
      Y := 2;
    end;
    Facing := FacingDirection.West;
  end); Hostiles := [Fresh.Hostiles[0] with Position := record
    X := 7;
    Y := 2;
  end; Alerted := true; end with]; end with;
  var ExpandedView: AreaView := Std.Results.Unwrap(AreaViewFor(Metadata, AtNewField, Some(Expanded)));
  AssertTrue(IsOk(ValidateGameState(ExpandedView, AtNewField)));
  AssertTrue(IsError(ValidateGameState(OpenView, AtNewField)));
  case Std.Results.Unwrap(ResolveTurn(ExpandedView, AtNewField, TurnAction.Wait)) of
    when TurnOutcome.Continued(After, Log, Events):
      begin
        AssertTrue(After.RandomState <> AtNewField.RandomState);
        AssertEquals(2, Std.Arrays.Length(Log));
        AssertEquals(1, Std.Arrays.Length(Events));
      end;
    else
      begin
        panic('one opponent turn must not defeat a full-health fixture player');
      end;
  end case;
  // Move the exit: both interaction eligibility and activation must use the supplied map.
  mutable var MovedExit: InteriorMap := Expanded;
  MovedExit.Cells[Fixture.Exit.Y * Open.Width + Fixture.Exit.X] := InteriorCellKind.Floor;
  MovedExit.Cells[2 * Open.Width + 8] := InteriorCellKind.ExitField;
  MovedExit.Exit := record
    X := 8;
    Y := 2;
  end;

  MovedExit := Std.Results.Unwrap(ValidateInteriorMap(MovedExit));
  var OldExitState: GameState := State with Player := PlayerPosition.FirstPerson(record
    Position := Fixture.Exit;
    Facing := FacingDirection.North;
  end); end with;
  var ExitView: AreaView := Std.Results.Unwrap(AreaViewFor(Metadata, OldExitState, Some(MovedExit)));
  AssertTrue(IsError(AreaTransitionTarget(ExitView, OldExitState)));
  case Std.Results.Unwrap(Interact(ExitView, OldExitState)) of
    when InteractionOutcome.Described(Title, Text):
      begin
        AssertEquals(NoInteractionMessage, Text);
      end;
    else
      begin
        panic('the old exit is now an ordinary field');
      end;
  end case;
  var AtExit: GameState := State with Player := PlayerPosition.FirstPerson(record
    Position := MovedExit.Exit;
    Facing := FacingDirection.West;
  end); end with;

  case Std.Results.Unwrap(Interact(ExitView, AtExit)) of
    when InteractionOutcome.TransitionRequested(Target):
      begin
        AssertEquals(Metadata.OutdoorAreaId, Target);
      end;
    else
      begin
        panic('the supplied exit must request a transition');
      end;
  end case;
  var Left: AreaTransition := Std.Results.Unwrap(ActivateAreaTransition(ExitView, AtExit, None));
  AssertTrue(Left.State.Area = AreaKind.OutdoorRegion);
  AssertTrue(Std.Options.IsNone(Left.View.Interior));
  AssertTrue(IsError(ActivateAreaTransition(ExitView, AtExit, Some(MovedExit))));
  var OutdoorView: AreaView := Left.View;
  AssertTrue(IsError(ActivateAreaTransition(OutdoorView, Left.State, None)));
  AssertTrue(IsError(ActivateAreaTransition(OutdoorView, Left.State, Some(MovedExit with AreaId := 'wrong-area'; end with))));
  var Entered: AreaTransition := Std.Results.Unwrap(ActivateAreaTransition(OutdoorView, Left.State, Some(MovedExit)));
  AssertTrue(Std.Results.Unwrap(FirstPersonPlayerPose(Entered.State)).Position = MovedExit.Start);
  AssertEquals(MovedExit.AreaId, Std.Options.Unwrap(Entered.View.Interior).AreaId);
end.
