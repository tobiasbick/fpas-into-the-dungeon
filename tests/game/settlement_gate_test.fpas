// Verifies the reachable six-step gate, separation from dungeon sites, and metadata identity.
program SettlementGateTest;

uses
  Dungeon.Coordinates as Coordinates, Dungeon.Terrain as Terrain, Dungeon.Terrain.Chunks as Chunks,
  Dungeon.Terrain.Entrances as Entrances, Dungeon.Terrain.Placement as Placement, Std.Math as Math, Std.Test as Test;

begin
  for Seed: integer in [-1, 12345, 1] do
    for Size: integer in [1, 4, 16] do
      const Metadata := Placement.NewWorldMetadata('gate', Seed, Size).Unwrap();
      const Gate := Metadata.SettlementGate;
      Test.AssertEquals(
        6,
        Math.Abs(Gate.X - Metadata.Spawn.X) + Math.Abs(Gate.Y - Metadata.Spawn.Y)
      );
      Test.AssertTrue(
        Math.Abs(Gate.X - Metadata.SpawnEntrance.X) + Math.Abs(Gate.Y - Metadata.SpawnEntrance.Y) >
        1
      );
      Test.AssertTrue(Entrances.EntranceRegionAt(Metadata, Gate) is None);
      Test.AssertEquals(
        's',
        Terrain.VisibleCellCode(Chunks.GenerateWorldCell(Metadata, Gate.X, Gate.Y))
      );
      var Position := Metadata.Spawn;
      for Step: integer := 1 to 6 do
        if Position.X <> Gate.X then
          Position.X := Position.X + (if Position.X < Gate.X then 1 else -1 end if);
        else
          Position.Y := Position.Y + (if Position.Y < Gate.Y then 1 else -1 end if);
        end if;

        Test.AssertTrue(
          Terrain.CellIsWalkable(Chunks.GenerateWorldCell(Metadata, Position.X, Position.Y))
        );
      end for;

      Test.AssertTrue(Position = Gate);
      const Chunk := Chunks.GenerateChunk(
        Metadata, Coordinates.ChunkCoordinate(
          X := Coordinates.ChunkForCoordinate(Gate.X), Y := Coordinates.ChunkForCoordinate(Gate.Y)
        )
      );
      Test.AssertTrue(
        Terrain.ChunkCell(
          Chunk,
          Coordinates.LocalForCoordinate(Gate.X),
          Coordinates.LocalForCoordinate(Gate.Y)
        ).Feature =
        Terrain.TerrainFeatureKind.SettlementGate
      );
      Test.AssertTrue(Placement.ValidateWorldMetadata(Metadata) is Ok(_));
      Test.AssertTrue(
        Placement.ValidateWorldMetadata(Metadata with SettlementGate := Metadata.Spawn; end with) is Error(_)
      );
    end for;
  end for;
end.
