// Verifies the fixed price contract, permanent catalogue origins and bounded map-free economy state.
program EconomyModelTest;

uses
  Dungeon.Trade.Model as Economy, Dungeon.Trade.Items as Stock, Dungeon.Items as Items,
  Dungeon.GameState as GameState, Dungeon.Terrain.Placement as Placement, Dungeon.Npcs as Npcs,
  Std.Test as Test;

begin
  const Kinds := [
    Items.ItemKind.AncientCoin, Items.ItemKind.HealingPotion,
    Items.ItemKind.RustyShortSword, Items.ItemKind.LeatherJerkin
  ];
  const Buys := [20, 8, 12, 12];
  const Sells := [10, 3, 5, 5];
  for Index: integer := 0 to Kinds.Length() - 1 do
    const Price := Economy.Price(Kinds[Index]).Unwrap();
    Test.AssertEquals(Buys[Index], Price.Buy);
    Test.AssertEquals(Sells[Index], Price.Sell);
  end for;

  Test.AssertTrue(Economy.Price(Items.ItemKind.MarasCompass) is None);
  const Goods := Stock.InitialGoods('w:settlement:home:npc:merchant');
  Test.AssertEquals(5, Goods.Length());
  Test.AssertEquals('w:settlement:home:npc:merchant:stock:0', Goods[0].Id);
  Test.AssertEquals('w:settlement:home:npc:merchant:stock:4', Goods[4].Id);
  for Index: integer := 0 to 4 do
    Test.AssertTrue(Stock.HasOrigin(Goods[Index], 'w:settlement:home:npc:merchant'));
    Test.AssertTrue(
      Goods[Index].Kind =
      if Index < 3 then Items.ItemKind.HealingPotion
        else if Index = 3 then Items.ItemKind.RustyShortSword
          else Items.ItemKind.LeatherJerkin
          end if
        end if
    );
  end for;

  Test.AssertFalse(
    Stock.HasOrigin(
      Goods[0] with Id := Goods[0].Id + '0'; end with,
      'w:settlement:home:npc:merchant'
    )
  );
  Test.AssertFalse(
    Stock.HasOrigin(
      Goods[0] with Kind := Items.ItemKind.AncientCoin; end with,
      'w:settlement:home:npc:merchant'
    )
  );
  const Metadata := Placement.NewWorldMetadata('economy', 25, 1).Unwrap();
  const State := GameState.NewGame(Metadata);
  Test.AssertEquals(0, State.Coins);
  Test.AssertTrue(
    GameState.ValidateStateShape(Metadata, State with Coins := Economy.MaximumCoins; end with) is Ok(_)
  );
  for Coins: integer in [-1, Economy.MaximumCoins + 1] do
    Test.AssertTrue(
      GameState.ValidateStateShape(Metadata, State with Coins := Coins; end with) is Error(_)
    );
  end for;

  Test.AssertTrue(
    GameState.ValidateStateShape(
      Metadata, State with Items := [
        Goods[0] with Location := Items.ItemLocation.HeldByMerchant(Npcs.MaraId(Metadata)); end with
      ]; end with
    ) is Error(_)
  );
end.
