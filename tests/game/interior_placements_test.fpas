// Verifies typed item placements and distinct, traversable opponent placements.
program InteriorPlacementsTest;

uses Dungeon.Test.Fixtures as Fixtures, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Hostiles as HostileRules, Dungeon.Interior as InteriorUnit, Dungeon.Items as ItemRules, Dungeon.Terrain as Terrain, Dungeon.Terrain.Placement as PlacementRules, Std.Test as Test;

begin
  const Metadata: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
    'placement-test',
    12345,
    4
  ).Unwrap();
  const Map: InteriorUnit.InteriorMap := Fixtures.FixtureDungeonMapFor(
    Fixtures.SpawnDungeonAreaId(Metadata)
  );
  const Second: HostileRules.HostilePlacement := Map.Hostiles[0] with Id := 'second-opponent'; Position := Coordinates.InteriorPosition(
    X := 5,
    Y := 3
  ); end with;
  const TwoOpponents: InteriorUnit.InteriorMap := Map with Hostiles := [Map.Hostiles[0], Second]; end with;

  Test.AssertTrue(InteriorUnit.ValidateInteriorMap(TwoOpponents) is Ok(_));
  Test.AssertTrue(InteriorUnit.ValidateInteriorMap(Map with Hostiles := []; end with) is Ok(_));
  Test.AssertTrue(
    (
      InteriorUnit.ValidateInteriorMap(
        TwoOpponents with Hostiles := [
          Map.Hostiles[0],
          Second with Id := Map.Hostiles[0].Id; end with
        ]; end with
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      InteriorUnit.ValidateInteriorMap(
        TwoOpponents with Hostiles := [
          Map.Hostiles[0],
          Second with Position := Map.Hostiles[0].Position; end with
        ]; end with
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      InteriorUnit.ValidateInteriorMap(
        Map with Hostiles := [
          Second with Position := Coordinates.InteriorPosition(X := 0, Y := 0); end with
        ]; end with
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      InteriorUnit.ValidateInteriorMap(
        Map with Hostiles := [
          Second with Position := Coordinates.InteriorPosition(X := -1, Y := 3); end with
        ]; end with
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      InteriorUnit.ValidateInteriorMap(
        Map with Hostiles := [Second with Position := Map.Start; end with]; end with
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      InteriorUnit.ValidateInteriorMap(
        Map with Hostiles := [Second with Position := Map.Arrival; end with]; end with
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      InteriorUnit.ValidateInteriorMap(
        Map with Hostiles := [
          Second with Position := Map.Items[0].Position; end with
        ]; end with
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      InteriorUnit.ValidateInteriorMap(
        Map with Hostiles := [
          Second with Id := Map.Items[0].ItemId; end with
        ]; end with
      ) is Error(_)
    )
  );
  const State: GameState.GameState := Fixtures.MaterializedFixtureState(Metadata);
  Test.AssertEquals(Map.Items.Length(), State.Items.Length());
  for Index: integer := 0 to Map.Items.Length() - 1 do
    begin
      Test.AssertEquals(Map.Items[Index].ItemId, State.Items[Index].Id);
      Test.AssertTrue(Map.Items[Index].Kind = State.Items[Index].Kind);
    end;
  end for;

  Test.AssertEquals(Map.Hostiles[0].Id, State.Hostiles[0].Id);
  Test.AssertTrue(Map.Hostiles[0].Kind = State.Hostiles[0].Kind);
  Test.AssertEquals(
    HostileRules.HostileMaximumHealth(Map.Hostiles[0].Kind),
    State.Hostiles[0].Health
  );
  Test.AssertFalse(State.Hostiles[0].Alerted);
  var WrongKind: GameState.GameState := State;
  WrongKind.Items[0] := State.Items[0] with Kind := ItemRules.ItemKind.LeatherJerkin; end with;

  Test.AssertTrue(Fixtures.ValidateFixtureSave(Metadata, WrongKind) is Error(_));
  var UnknownItem: GameState.GameState := State;
  UnknownItem.Items[0] := State.Items[0] with Id := 'unknown-item'; end with;

  Test.AssertTrue(Fixtures.ValidateFixtureSave(Metadata, UnknownItem) is Error(_));
end.
