// Verifies typed item placements and distinct, traversable opponent placements.
program InteriorPlacementsTest;

uses
  Dungeon.Test.Fixtures, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Hostiles, Dungeon.Interior,
  Dungeon.Items, Dungeon.Terrain, Dungeon.Terrain.Placement, Std.Test;

begin
  const Metadata: WorldMetadata := NewWorldMetadata('placement-test', 12345, 4).Unwrap();
  const Map: InteriorMap := FixtureDungeonMapFor(SpawnDungeonAreaId(Metadata));
  const Second: HostilePlacement := Map.Hostiles[0] with Id := 'second-opponent'; Position := InteriorPosition(X := 5, Y := 3); end with;
  const TwoOpponents: InteriorMap := Map with Hostiles := [Map.Hostiles[0], Second]; end with;

  AssertTrue(ValidateInteriorMap(TwoOpponents).IsOk());
  AssertTrue(ValidateInteriorMap(Map with Hostiles := []; end with).IsOk());
  AssertTrue(ValidateInteriorMap(TwoOpponents with Hostiles := [
                                                                 Map.Hostiles[0],
                                                                 Second with Id := Map.Hostiles[0].Id; end with
                                                               ]; end with)
               .IsError());
  AssertTrue(ValidateInteriorMap(TwoOpponents with Hostiles := [
                                                                 Map.Hostiles[0],
                                                                 Second with Position := Map.Hostiles[0].Position; end with
                                                               ]; end with)
               .IsError());
  AssertTrue(ValidateInteriorMap(Map with Hostiles := [
                                                        Second with Position := InteriorPosition(X := 0, Y := 0); end with
                                                      ]; end with)
               .IsError());
  AssertTrue(ValidateInteriorMap(Map with Hostiles := [
                                                        Second with Position := InteriorPosition(X := -1, Y := 3); end with
                                                      ]; end with)
               .IsError());
  AssertTrue(ValidateInteriorMap(Map with Hostiles := [Second with Position := Map.Start; end with]; end with)
               .IsError());
  AssertTrue(ValidateInteriorMap(Map with Hostiles := [Second with Position := Map.Exit; end with]; end with)
               .IsError());
  AssertTrue(ValidateInteriorMap(Map with Hostiles := [
                                                        Second with Position := Map.Items[0].Position; end with
                                                      ]; end with)
               .IsError());
  AssertTrue(ValidateInteriorMap(Map with Hostiles := [
                                                        Second with Id := Map.Items[0].ItemId; end with
                                                      ]; end with)
               .IsError());
  const State: GameState := MaterializedFixtureState(Metadata);
  AssertEquals(Map.Items.Length(), State.Items.Length());
  for Index: integer := 0 to Map.Items.Length() - 1 do
    begin
      AssertEquals(Map.Items[Index].ItemId, State.Items[Index].Id);
      AssertTrue(Map.Items[Index].Kind = State.Items[Index].Kind);
    end;
  end for;

  AssertEquals(Map.Hostiles[0].Id, State.Hostiles[0].Id);
  AssertTrue(Map.Hostiles[0].Kind = State.Hostiles[0].Kind);
  AssertEquals(HostileMaximumHealth(Map.Hostiles[0].Kind), State.Hostiles[0].Health);
  AssertFalse(State.Hostiles[0].Alerted);
  var WrongKind: GameState := State;
  WrongKind.Items[0] := State.Items[0] with Kind := ItemKind.LeatherJerkin; end with;

  AssertTrue(ValidateFixtureSave(Metadata, WrongKind).IsError());
  var UnknownItem: GameState := State;
  UnknownItem.Items[0] := State.Items[0] with Id := 'unknown-item'; end with;

  AssertTrue(ValidateFixtureSave(Metadata, UnknownItem).IsError());
end.
