// Verifies typed item placements and distinct, traversable opponent placements.
program InteriorPlacementsTest;

uses
  Dungeon.Test.Fixtures, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Hostiles, Dungeon.Interior,
  Dungeon.Items, Dungeon.Terrain, Dungeon.Terrain.Placement, Std.Arrays, Std.Results, Std.Test;

begin
  var Metadata: WorldMetadata := Unwrap(NewWorldMetadata('placement-test', 12345, 4));
  var Map: InteriorMap := FixtureDungeonMapFor(SpawnDungeonAreaId(Metadata));
  var Second: HostilePlacement := Map.Hostiles[0] with Id := 'second-opponent'; Position := record
    X := 5;
    Y := 3;
  end; end;
  var TwoOpponents: InteriorMap := Map with Hostiles := [Map.Hostiles[0], Second]; end;

  AssertTrue(IsOk(ValidateInteriorMap(TwoOpponents)));
  AssertTrue(IsOk(ValidateInteriorMap(Map with Hostiles := []; end)));
  AssertTrue(IsError(ValidateInteriorMap(TwoOpponents with Hostiles := [
                                                                         Map.Hostiles[0],
                                                                         Second with Id := Map.Hostiles[0].Id; end
                                                                       ]; end)));
  AssertTrue(IsError(ValidateInteriorMap(TwoOpponents with Hostiles := [
                                                                         Map.Hostiles[0],
                                                                         Second with Position := Map.Hostiles[0].Position; end
                                                                       ]; end)));
  AssertTrue(IsError(ValidateInteriorMap(Map with Hostiles := [Second with Position := record
    X := 0;
    Y := 0;
  end; end]; end)));
  AssertTrue(IsError(ValidateInteriorMap(Map with Hostiles := [Second with Position := record
    X := -1;
    Y := 3;
  end; end]; end)));
  AssertTrue(IsError(ValidateInteriorMap(Map with Hostiles := [
                                                                Second with Position := Map.Start; end
                                                              ]; end)));
  AssertTrue(IsError(ValidateInteriorMap(Map with Hostiles := [
                                                                Second with Position := Map.Exit; end
                                                              ]; end)));
  AssertTrue(IsError(ValidateInteriorMap(Map with Hostiles := [
                                                                Second with Position := Map.Items[0].Position; end
                                                              ]; end)));
  AssertTrue(IsError(ValidateInteriorMap(Map with Hostiles := [
                                                                Second with Id := Map.Items[0].ItemId; end
                                                              ]; end)));
  var State: GameState := MaterializedFixtureState(Metadata);
  AssertEquals(Std.Arrays.Length(Map.Items), Std.Arrays.Length(State.Items));
  for Index: integer := 0 to Std.Arrays.Length(Map.Items) - 1 do
  begin
    AssertEquals(Map.Items[Index].ItemId, State.Items[Index].Id);
    AssertTrue(Map.Items[Index].Kind = State.Items[Index].Kind)
  end;

  AssertEquals(Map.Hostiles[0].Id, State.Hostiles[0].Id);
  AssertTrue(Map.Hostiles[0].Kind = State.Hostiles[0].Kind);
  AssertEquals(HostileMaximumHealth(Map.Hostiles[0].Kind), State.Hostiles[0].Health);
  AssertFalse(State.Hostiles[0].Alerted);
  mutable var WrongKind: GameState := State;
  WrongKind.Items[0] := State.Items[0] with Kind := ItemKind.LeatherJerkin; end;

  AssertTrue(IsError(ValidateFixtureSave(Metadata, WrongKind)));
  mutable var UnknownItem: GameState := State;
  UnknownItem.Items[0] := State.Items[0] with Id := 'unknown-item'; end;

  AssertTrue(IsError(ValidateFixtureSave(Metadata, UnknownItem)))
end.
