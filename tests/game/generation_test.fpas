// Verifies deterministic terrain fixtures and absolute-coordinate chunk continuity.
program DungeonGenerationTest;

uses Dungeon.Terrain.Chunks as Chunks, Dungeon.Coordinates as Coordinates, Dungeon.Terrain as Terrain, Dungeon.Terrain.Generation as Generation, Dungeon.Terrain.Placement as Placement, Std.Test as Test;

procedure AssertVisibleCode(Metadata: Terrain.WorldMetadata; Expected: string; X: integer; Y: integer);
begin
  Test.AssertEquals(Expected, Terrain.VisibleCellCode(Chunks.GenerateWorldCell(Metadata, X, Y)));
end procedure;

procedure AssertNormalized(Value: integer);
begin
  Test.AssertTrue(Value >= 0);
  Test.AssertTrue(Value <= 1000);
end procedure;

function CountVisibleCode(
  Metadata: Terrain.WorldMetadata;
  Expected: string;
  MinimumX: integer;
  MaximumX: integer;
  MinimumY: integer;
  MaximumY: integer;
  Step: integer
): integer;
begin
  var Count: integer := 0;
  var Y: integer := MinimumY;
  while Y <= MaximumY do
    begin
      var X: integer := MinimumX;
      while X <= MaximumX do
        begin
          if Terrain.VisibleCellCode(Chunks.GenerateWorldCell(Metadata, X, Y)) = Expected then
            begin
              Count := Count + 1;
            end;
          end if;

          X := X + Step;
        end;
      end while;

      Y := Y + Step;
    end;
  end while;

  return Count;
end function;

function CountLandscapeContrast(
  Metadata: Terrain.WorldMetadata;
  MinimumX: integer;
  MaximumX: integer;
  MinimumY: integer;
  MaximumY: integer
): integer;
begin
  var Count: integer := 0;
  var Y: integer := MinimumY;
  while Y <= MaximumY do
    begin
      var X: integer := MinimumX;
      while X <= MaximumX do
        begin
          const Code: string := Terrain.VisibleCellCode(Chunks.GenerateWorldCell(Metadata, X, Y));
          if (((Code = 'f') or (Code = 'd')) or ((Code = 'm') or (Code = 'o')))
            or
            ((Code = 'r') or (Code = 'l'))
          then
            begin
              Count := Count + 1;
            end;
          end if;

          X := X + 16;
        end;
      end while;

      Y := Y + 16;
    end;
  end while;

  return Count;
end function;

procedure AssertRiverRowsConnect(
  Metadata: Terrain.WorldMetadata;
  MinimumX: integer;
  MaximumX: integer;
  MinimumY: integer;
  MaximumY: integer
);
begin
  var HasPreviousRow: boolean := false;
  var PreviousMinimumX: integer := 0;
  var PreviousMaximumX: integer := 0;
  for Y: integer := MinimumY to MaximumY do
    begin
      var FoundRiver: boolean := false;
      var RowMinimumX: integer := 0;
      var RowMaximumX: integer := 0;
      for X: integer := MinimumX to MaximumX do
        begin
          const Water: Terrain.WaterKind := Chunks.GenerateWorldCell(Metadata, X, Y).Water;
          if (Water = Terrain.WaterKind.RiverWater) or (Water = Terrain.WaterKind.Lake) then
            begin
              if not FoundRiver then
                begin
                  RowMinimumX := X;
                  FoundRiver := true;
                end;
              end if;

              RowMaximumX := X;
            end;
          end if;
        end;
      end for;

      Test.AssertTrue(FoundRiver);
      if HasPreviousRow then
        begin
          Test.AssertTrue(RowMinimumX <= PreviousMaximumX);
          Test.AssertTrue(PreviousMinimumX <= RowMaximumX);
        end;
      end if;

      PreviousMinimumX := RowMinimumX;
      PreviousMaximumX := RowMaximumX;
      HasPreviousRow := true;
    end;
  end for;
end procedure;

begin
  const Metadata: Terrain.WorldMetadata := Placement.NewWorldMetadata(
    'coverage',
    12345,
    4
  ).Unwrap();
  const RepeatedMetadata: Terrain.WorldMetadata := Placement.NewWorldMetadata(
    'coverage-again',
    12345,
    4
  ).Unwrap();
  Test.AssertEquals(Metadata.Spawn.X, RepeatedMetadata.Spawn.X);
  Test.AssertEquals(Metadata.Spawn.Y, RepeatedMetadata.Spawn.Y);
  for Seed: integer := -8 to 8 do
    begin
      const SeedMetadata: Terrain.WorldMetadata := Placement.NewWorldMetadata(
        'seed-coverage',
        Seed,
        4
      ).Unwrap();
      const SeedSpawn: Terrain.WorldCell := Chunks.GenerateWorldCell(
        SeedMetadata,
        SeedMetadata.Spawn.X,
        SeedMetadata.Spawn.Y
      );
      Test.AssertTrue(Terrain.IsWalkable(SeedSpawn));
      Test.AssertFalse(SeedSpawn.Feature = Terrain.TerrainFeatureKind.Path);
    end;
  end for;
  const SpawnCell: Terrain.WorldCell := Chunks.GenerateWorldCell(
    Metadata,
    Metadata.Spawn.X,
    Metadata.Spawn.Y
  );
  Test.AssertTrue(Terrain.IsWalkable(SpawnCell));
  Test.AssertFalse(SpawnCell.Feature = Terrain.TerrainFeatureKind.Path);
  for SpawnY: integer := Metadata.Spawn.Y - 8 to Metadata.Spawn.Y + 8 do
    begin
      for SpawnX: integer := Metadata.Spawn.X - 8 to Metadata.Spawn.X + 8 do
        begin
          Test.AssertTrue(Terrain.IsWalkable(Chunks.GenerateWorldCell(Metadata, SpawnX, SpawnY)));
        end;
      end for;
    end;
  end for;

  Test.AssertTrue(
    CountVisibleCode(
      Metadata, 't', Metadata.Spawn.X - 64, Metadata.Spawn.X + 64, Metadata.Spawn.Y -
      24, Metadata.Spawn.Y +
      24, 1
    ) +
    CountVisibleCode(
      Metadata, 'f', Metadata.Spawn.X -
      64, Metadata.Spawn.X +
      64, Metadata.Spawn.Y -
      24, Metadata.Spawn.Y +
      24, 1
    ) >
    0
  );
  Test.AssertTrue(
    CountLandscapeContrast(
      Metadata, Metadata.Spawn.X - 512, Metadata.Spawn.X + 512, Metadata.Spawn.Y -
      256, Metadata.Spawn.Y +
      256
    ) >
    0
  );
  AssertVisibleCode(Metadata, 'm', 8416, -9824);
  AssertVisibleCode(Metadata, 'g', Metadata.Spawn.X, Metadata.Spawn.Y);
  AssertVisibleCode(Metadata, 't', 14752, -6752);
  AssertVisibleCode(Metadata, 'o', -1856, -2048);
  AssertVisibleCode(Metadata, 'f', 10720, -9824);
  AssertVisibleCode(Metadata, 'd', 16864, -9824);
  AssertVisibleCode(Metadata, 'r', -1040, -2040);
  AssertVisibleCode(Metadata, 'l', 16608, -6432);
  AssertVisibleCode(Metadata, 'p', 1000, -1696);
  Test.AssertTrue(CountVisibleCode(Metadata, 'g', 10208, 11232, -10080, -9568, 8) > 500);
  Test.AssertTrue(CountVisibleCode(Metadata, 't', 10208, 11232, -10080, -9568, 8) > 500);
  Test.AssertTrue(CountVisibleCode(Metadata, 'f', 10208, 11232, -10080, -9568, 8) > 500);
  Test.AssertTrue(CountVisibleCode(Metadata, 'g', 16528, 16688, -6472, -6392, 2) > 500);
  Test.AssertTrue(CountVisibleCode(Metadata, 'l', 16528, 16688, -6472, -6392, 2) > 500);
  AssertRiverRowsConnect(Metadata, 15000, 15800, -5723, -5670);
  var LandCount: integer := 0;
  var SeaCount: integer := 0;
  var DeepLandCount: integer := 0;
  var DeepSeaCount: integer := 0;
  var BridgeCount: integer := 0;
  var LongestLandRun: integer := 0;
  var LongestSeaRun: integer := 0;
  var SampleY: integer := -32768;
  while SampleY <= 32768 do
    begin
      var LandRun: integer := 0;
      var SeaRun: integer := 0;
      var SampleX: integer := -32768;
      while SampleX <= 32768 do
        begin
          const Sample: Terrain.TerrainGenerationSample := Generation.SampleWorldGeneration(
            Metadata,
            SampleX,
            SampleY
          );
          AssertNormalized(Sample.Continentalness);
          AssertNormalized(Sample.Elevation);
          AssertNormalized(Sample.Moisture);
          AssertNormalized(Sample.Vegetation);
          AssertNormalized(Sample.LakeShape);
          AssertNormalized(Sample.Ruggedness);
          AssertNormalized(Sample.LandScore);
          AssertNormalized(Sample.LandBridge);
          if Sample.LandScore >= 600 then
            begin
              DeepLandCount := DeepLandCount + 1;
            end;
          end if;

          if Sample.LandScore <= 360 then
            begin
              DeepSeaCount := DeepSeaCount + 1;
            end;
          end if;

          if Sample.LandBridge >= 950 then
            begin
              BridgeCount := BridgeCount + 1;
              Test.AssertTrue(Sample.LandScore >= 460);
            end;
          end if;
          const Cell: Terrain.WorldCell := Chunks.GenerateWorldCell(Metadata, SampleX, SampleY);
          if Cell.Water = Terrain.WaterKind.Sea then
            begin
              SeaCount := SeaCount + 1;
              SeaRun := SeaRun + 1;
              LandRun := 0;
              if SeaRun > LongestSeaRun then
                begin
                  LongestSeaRun := SeaRun;
                end;
              end if;
            end;
          else
            begin
              LandCount := LandCount + 1;
              LandRun := LandRun + 1;
              SeaRun := 0;
              if LandRun > LongestLandRun then
                begin
                  LongestLandRun := LandRun;
                end;
              end if;
            end;
          end if;

          SampleX := SampleX + 512;
        end;
      end while;

      SampleY := SampleY + 512;
    end;
  end while;

  Test.AssertTrue(LandCount > 4000);
  Test.AssertTrue(SeaCount > 2000);
  Test.AssertTrue(DeepLandCount > 1000);
  Test.AssertTrue(DeepSeaCount > 100);
  Test.AssertTrue(BridgeCount > 100);
  Test.AssertTrue(LongestLandRun >= 8);
  Test.AssertTrue(LongestSeaRun >= 8);
  const Left: Terrain.WorldChunk := Chunks.GenerateChunk(
    Metadata,
    Coordinates.ChunkCoordinate(X := 0, Y := 0)
  );
  const Right: Terrain.WorldChunk := Chunks.GenerateChunk(
    Metadata,
    Coordinates.ChunkCoordinate(X := 1, Y := 0)
  );
  const Below: Terrain.WorldChunk := Chunks.GenerateChunk(
    Metadata,
    Coordinates.ChunkCoordinate(X := 0, Y := 1)
  );
  for Local: integer := 0 to Coordinates.WorldChunkSize - 1 do
    begin
      Test.AssertEquals(
        Terrain.VisibleCellCode(Terrain.ChunkCell(Left, 127, Local)),
        Terrain.VisibleCellCode(Chunks.GenerateWorldCell(Metadata, 127, Local))
      );
      Test.AssertEquals(
        Terrain.VisibleCellCode(Terrain.ChunkCell(Right, 0, Local)),
        Terrain.VisibleCellCode(Chunks.GenerateWorldCell(Metadata, 128, Local))
      );
      Test.AssertEquals(
        Terrain.VisibleCellCode(Terrain.ChunkCell(Left, Local, 127)),
        Terrain.VisibleCellCode(Chunks.GenerateWorldCell(Metadata, Local, 127))
      );
      Test.AssertEquals(
        Terrain.VisibleCellCode(Terrain.ChunkCell(Below, Local, 0)),
        Terrain.VisibleCellCode(Chunks.GenerateWorldCell(Metadata, Local, 128))
      );
    end;
  end for;
end.
