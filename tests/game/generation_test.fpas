// Verifies deterministic terrain fixtures and absolute-coordinate chunk continuity.
program DungeonGenerationTest;

uses
  Dungeon.Terrain.Chunks, Dungeon.Coordinates, Dungeon.Terrain, Dungeon.Terrain.Generation,
  Dungeon.Terrain.Placement, Std.Test;

procedure AssertVisibleCode(Metadata: WorldMetadata; Expected: string; X: integer; Y: integer);
begin
  AssertEquals(Expected, VisibleCellCode(GenerateWorldCell(Metadata, X, Y)));
end procedure;

procedure AssertNormalized(Value: integer);
begin
  AssertTrue(Value >= 0);
  AssertTrue(Value <= 1000);
end procedure;

function CountVisibleCode(
  Metadata: WorldMetadata;
  Expected: string;
  MinimumX: integer;
  MaximumX: integer;
  MinimumY: integer;
  MaximumY: integer;
  Step: integer
): integer;
begin
  var Count: integer := 0;
  var Y: integer := MinimumY;
  while Y <= MaximumY do
    begin
      var X: integer := MinimumX;
      while X <= MaximumX do
        begin
          if VisibleCellCode(GenerateWorldCell(Metadata, X, Y)) = Expected then
            begin
              Count := Count + 1;
            end;
          end if;

          X := X + Step;
        end;
      end while;

      Y := Y + Step;
    end;
  end while;

  return Count;
end function;

function CountLandscapeContrast(
  Metadata: WorldMetadata;
  MinimumX: integer;
  MaximumX: integer;
  MinimumY: integer;
  MaximumY: integer
): integer;
begin
  var Count: integer := 0;
  var Y: integer := MinimumY;
  while Y <= MaximumY do
    begin
      var X: integer := MinimumX;
      while X <= MaximumX do
        begin
          const Code: string := VisibleCellCode(GenerateWorldCell(Metadata, X, Y));
          if (((Code = 'f') or (Code = 'd')) or ((Code = 'm') or (Code = 'o'))) or
             ((Code = 'r') or (Code = 'l')) then
            begin
              Count := Count + 1;
            end;
          end if;

          X := X + 16;
        end;
      end while;

      Y := Y + 16;
    end;
  end while;

  return Count;
end function;

procedure AssertRiverRowsConnect(
  Metadata: WorldMetadata;
  MinimumX: integer;
  MaximumX: integer;
  MinimumY: integer;
  MaximumY: integer
);
begin
  var HasPreviousRow: boolean := false;
  var PreviousMinimumX: integer := 0;
  var PreviousMaximumX: integer := 0;
  for Y: integer := MinimumY to MaximumY do
    begin
      var FoundRiver: boolean := false;
      var RowMinimumX: integer := 0;
      var RowMaximumX: integer := 0;
      for X: integer := MinimumX to MaximumX do
        begin
          const Water: WaterKind := GenerateWorldCell(Metadata, X, Y).Water;
          if (Water = WaterKind.RiverWater) or (Water = WaterKind.Lake) then
            begin
              if not FoundRiver then
                begin
                  RowMinimumX := X;
                  FoundRiver := true;
                end;
              end if;

              RowMaximumX := X;
            end;
          end if;
        end;
      end for;

      AssertTrue(FoundRiver);
      if HasPreviousRow then
        begin
          AssertTrue(RowMinimumX <= PreviousMaximumX);
          AssertTrue(PreviousMinimumX <= RowMaximumX);
        end;
      end if;

      PreviousMinimumX := RowMinimumX;
      PreviousMaximumX := RowMaximumX;
      HasPreviousRow := true;
    end;
  end for;
end procedure;

begin
  const Metadata: WorldMetadata := NewWorldMetadata('coverage', 12345, 4).Unwrap();
  const RepeatedMetadata: WorldMetadata := NewWorldMetadata('coverage-again', 12345, 4).Unwrap();
  AssertEquals(Metadata.Spawn.X, RepeatedMetadata.Spawn.X);
  AssertEquals(Metadata.Spawn.Y, RepeatedMetadata.Spawn.Y);
  for Seed: integer := -8 to 8 do
    begin
      const SeedMetadata: WorldMetadata := NewWorldMetadata('seed-coverage', Seed, 4).Unwrap();
      const SeedSpawn: WorldCell := GenerateWorldCell(SeedMetadata, SeedMetadata.Spawn.X, SeedMetadata.Spawn.Y);
      AssertTrue(IsWalkable(SeedSpawn));
      AssertFalse(SeedSpawn.Feature = TerrainFeatureKind.Path);
    end;
  end for;
  const SpawnCell: WorldCell := GenerateWorldCell(Metadata, Metadata.Spawn.X, Metadata.Spawn.Y);
  AssertTrue(IsWalkable(SpawnCell));
  AssertFalse(SpawnCell.Feature = TerrainFeatureKind.Path);
  for SpawnY: integer := Metadata.Spawn.Y - 8 to Metadata.Spawn.Y + 8 do
    begin
      for SpawnX: integer := Metadata.Spawn.X - 8 to Metadata.Spawn.X + 8 do
        begin
          AssertTrue(IsWalkable(GenerateWorldCell(Metadata, SpawnX, SpawnY)));
        end;
      end for;
    end;
  end for;

  AssertTrue(CountVisibleCode(Metadata, 't', Metadata.Spawn.X - 64, Metadata.Spawn.X + 64, Metadata.Spawn.Y -
                                                                                           24, Metadata.Spawn.Y +
                                                                                               24, 1) + CountVisibleCode(Metadata, 'f', Metadata.Spawn.X -
                                                                                                                                        64, Metadata.Spawn.X +
                                                                                                                                            64, Metadata.Spawn.Y -
                                                                                                                                                24, Metadata.Spawn.Y +
                                                                                                                                                    24, 1) >
             0);
  AssertTrue(CountLandscapeContrast(Metadata, Metadata.Spawn.X - 512, Metadata.Spawn.X + 512, Metadata.Spawn.Y -
                                                                                              256, Metadata.Spawn.Y +
                                                                                                   256) >
             0);
  AssertVisibleCode(Metadata, 'm', 8416, -9824);
  AssertVisibleCode(Metadata, 'g', Metadata.Spawn.X, Metadata.Spawn.Y);
  AssertVisibleCode(Metadata, 't', 14752, -6752);
  AssertVisibleCode(Metadata, 'o', -1856, -2048);
  AssertVisibleCode(Metadata, 'f', 10720, -9824);
  AssertVisibleCode(Metadata, 'd', 16864, -9824);
  AssertVisibleCode(Metadata, 'r', -1040, -2040);
  AssertVisibleCode(Metadata, 'l', 16608, -6432);
  AssertVisibleCode(Metadata, 'p', 1000, -1696);
  AssertTrue(CountVisibleCode(Metadata, 'g', 10208, 11232, -10080, -9568, 8) > 500);
  AssertTrue(CountVisibleCode(Metadata, 't', 10208, 11232, -10080, -9568, 8) > 500);
  AssertTrue(CountVisibleCode(Metadata, 'f', 10208, 11232, -10080, -9568, 8) > 500);
  AssertTrue(CountVisibleCode(Metadata, 'g', 16528, 16688, -6472, -6392, 2) > 500);
  AssertTrue(CountVisibleCode(Metadata, 'l', 16528, 16688, -6472, -6392, 2) > 500);
  AssertRiverRowsConnect(Metadata, 15000, 15800, -5723, -5670);
  var LandCount: integer := 0;
  var SeaCount: integer := 0;
  var DeepLandCount: integer := 0;
  var DeepSeaCount: integer := 0;
  var BridgeCount: integer := 0;
  var LongestLandRun: integer := 0;
  var LongestSeaRun: integer := 0;
  var SampleY: integer := -32768;
  while SampleY <= 32768 do
    begin
      var LandRun: integer := 0;
      var SeaRun: integer := 0;
      var SampleX: integer := -32768;
      while SampleX <= 32768 do
        begin
          const Sample: TerrainGenerationSample := SampleWorldGeneration(Metadata, SampleX, SampleY);
          AssertNormalized(Sample.Continentalness);
          AssertNormalized(Sample.Elevation);
          AssertNormalized(Sample.Moisture);
          AssertNormalized(Sample.Vegetation);
          AssertNormalized(Sample.LakeShape);
          AssertNormalized(Sample.Ruggedness);
          AssertNormalized(Sample.LandScore);
          AssertNormalized(Sample.LandBridge);
          if Sample.LandScore >= 600 then
            begin
              DeepLandCount := DeepLandCount + 1;
            end;
          end if;

          if Sample.LandScore <= 360 then
            begin
              DeepSeaCount := DeepSeaCount + 1;
            end;
          end if;

          if Sample.LandBridge >= 950 then
            begin
              BridgeCount := BridgeCount + 1;
              AssertTrue(Sample.LandScore >= 460);
            end;
          end if;
          const Cell: WorldCell := GenerateWorldCell(Metadata, SampleX, SampleY);
          if Cell.Water = WaterKind.Sea then
            begin
              SeaCount := SeaCount + 1;
              SeaRun := SeaRun + 1;
              LandRun := 0;
              if SeaRun > LongestSeaRun then
                begin
                  LongestSeaRun := SeaRun;
                end;
              end if;
            end;
          else
            begin
              LandCount := LandCount + 1;
              LandRun := LandRun + 1;
              SeaRun := 0;
              if LandRun > LongestLandRun then
                begin
                  LongestLandRun := LandRun;
                end;
              end if;
            end;
          end if;

          SampleX := SampleX + 512;
        end;
      end while;

      SampleY := SampleY + 512;
    end;
  end while;

  AssertTrue(LandCount > 4000);
  AssertTrue(SeaCount > 2000);
  AssertTrue(DeepLandCount > 1000);
  AssertTrue(DeepSeaCount > 100);
  AssertTrue(BridgeCount > 100);
  AssertTrue(LongestLandRun >= 8);
  AssertTrue(LongestSeaRun >= 8);
  const Left: WorldChunk := GenerateChunk(Metadata, ChunkCoordinate(X := 0, Y := 0));
  const Right: WorldChunk := GenerateChunk(Metadata, ChunkCoordinate(X := 1, Y := 0));
  const Below: WorldChunk := GenerateChunk(Metadata, ChunkCoordinate(X := 0, Y := 1));
  for Local: integer := 0 to WorldChunkSize - 1 do
    begin
      AssertEquals(VisibleCellCode(ChunkCell(Left, 127, Local)), VisibleCellCode(GenerateWorldCell(Metadata, 127, Local)));
      AssertEquals(VisibleCellCode(ChunkCell(Right, 0, Local)), VisibleCellCode(GenerateWorldCell(Metadata, 128, Local)));
      AssertEquals(VisibleCellCode(ChunkCell(Left, Local, 127)), VisibleCellCode(GenerateWorldCell(Metadata, Local, 127)));
      AssertEquals(VisibleCellCode(ChunkCell(Below, Local, 0)), VisibleCellCode(GenerateWorldCell(Metadata, Local, 128)));
    end;
  end for;
end.
