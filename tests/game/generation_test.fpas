// Verifies deterministic terrain fixtures and absolute-coordinate chunk continuity.
program DungeonGenerationTest;

uses Dungeon.Game, Std.Test;

procedure AssertVisibleCode(Metadata: WorldMetadata; Expected: string; X: integer; Y: integer);
begin
  AssertEquals(Expected, VisibleCellCode(GenerateWorldCell(Metadata, X, Y)))
end;

begin
  var Metadata: WorldMetadata := NewWorldMetadata('coverage', 12345);
  AssertVisibleCode(Metadata, 'm', -2048, -2048);
  AssertVisibleCode(Metadata, 'g', -1992, -2048);
  AssertVisibleCode(Metadata, 'o', -1856, -2048);
  AssertVisibleCode(Metadata, 'f', -1592, -2048);
  AssertVisibleCode(Metadata, 'd', -608, -2048);
  AssertVisibleCode(Metadata, 'r', -1048, -2040);
  AssertVisibleCode(Metadata, 'l', -1584, -1728);
  AssertVisibleCode(Metadata, 'p', 1000, -1696);
  var Left: WorldChunk := GenerateChunk(Metadata, record
    X := 0;
    Y := 0;
  end);
  var Right: WorldChunk := GenerateChunk(Metadata, record
    X := 1;
    Y := 0;
  end);
  var Below: WorldChunk := GenerateChunk(Metadata, record
    X := 0;
    Y := 1;
  end);
  for Local: integer := 0 to WorldChunkSize - 1 do
  begin
    AssertEquals(VisibleCellCode(ChunkCell(Left, 127, Local)), VisibleCellCode(GenerateWorldCell(Metadata, 127, Local)));
    AssertEquals(VisibleCellCode(ChunkCell(Right, 0, Local)), VisibleCellCode(GenerateWorldCell(Metadata, 128, Local)));
    AssertEquals(VisibleCellCode(ChunkCell(Left, Local, 127)), VisibleCellCode(GenerateWorldCell(Metadata, Local, 127)));
    AssertEquals(VisibleCellCode(ChunkCell(Below, Local, 0)), VisibleCellCode(GenerateWorldCell(Metadata, Local, 128)))
  end
end.
