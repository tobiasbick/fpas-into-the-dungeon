// Verifies turn-based combat, pinned dice outcomes, perception, victory, defeat, and validation.
program CombatTest;

uses Dungeon.Test.Fixtures as Fixtures, Dungeon.Test.StateComparison as States, Dungeon.Combat as Combat, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Hostiles as HostileRules, Dungeon.Interaction as Interaction, Dungeon.Interior as InteriorUnit, Dungeon.Terrain as Terrain, Dungeon.Terrain.Placement as PlacementRules, Std.Test as Test;

// Independently calculated unarmed attack expectations, including the opponent's response.
type AttackVector = record
  Seed: integer;
  PlayerDamage: integer;
  HostileDamage: integer;
  FinalRandomState: integer;
  PlayerEvent: Combat.CombatEventKind;
  HostileEvent: Combat.CombatEventKind;
end record;

// Pins the full resulting state and both combat facts, not just repeatability.
procedure AssertPinnedAttack(Vector: AttackVector);
begin
  const Position: Coordinates.InteriorPosition := Coordinates.InteriorPosition(X := 4, Y := 3);
  const Initial: GameState.GameState := Fixtures.FixtureDungeonState(
    Position, Coordinates.FacingDirection.West
  ) with RandomState := Vector.Seed; end with;
  const View: GameState.AreaView := Fixtures.FixtureAreaView(Initial);
  const Outcome: Combat.TurnOutcome := Combat.ResolveTurn(
    View, Initial, Combat.TurnAction.Attack
  ).Unwrap();
  var Expected: GameState.GameState := Initial with Health := 20 - Vector.HostileDamage; RandomState := Vector.FinalRandomState; WorldMinutes := Initial.WorldMinutes +
    1; end with;

  Expected.Hostiles[0] := Expected.Hostiles[0] with Health := 12 - Vector.PlayerDamage; Alerted := true; end with;

  // 13b: a hit trains Unarmed by the health it removes; no blow here can exceed the skeleton's 12.
  Expected.Progression.UnarmedExperience := Vector.PlayerDamage;

  case Outcome of
    when Combat.TurnOutcome.Continued(const State, const Log, const Events):
      Test.AssertTrue(States.SameState(Expected, State));
      Test.AssertEquals(2, Log.Length());
      Test.AssertEquals(2, Events.Length());
      Test.AssertTrue(
        Events[0] =
        Combat.CombatEvent(
          Kind := Vector.PlayerEvent,
          Amount := Vector.PlayerDamage,
          HostileKind := HostileRules.HostileKind.RestlessSkeleton
        )
      );
      Test.AssertTrue(
        Events[1] =
        Combat.CombatEvent(
          Kind := Vector.HostileEvent,
          Amount := Vector.HostileDamage,
          HostileKind := HostileRules.HostileKind.RestlessSkeleton
        )
      );
    when Combat.TurnOutcome.Defeated(_):
      panic('pinned attack must not defeat a full-health player');
  end case;
  const Fresh: GameState.GameState := Fixtures.FixtureDungeonState(
    Position, Coordinates.FacingDirection.West
  ) with RandomState := Vector.Seed; end with;

  Test.AssertTrue(States.SameState(Fresh, Initial));
end procedure;

function InDungeon(Metadata: Terrain.WorldMetadata; X: integer; Y: integer; Facing: Coordinates.FacingDirection): GameState.GameState;
begin
  return Fixtures.MaterializedFixtureState(Metadata) with Area := Coordinates.AreaKind.Dungeon; AreaId := Fixtures.SpawnDungeonAreaId(
    Metadata
  ); Player := Coordinates.PlayerPosition.FirstPerson(
    Coordinates.FirstPersonPose(
      Position := Coordinates.InteriorPosition(X := X, Y := Y),
      Facing := Facing
    )
  ); ReturnLocation := Coordinates.ReturnLocation.ReturnTo(
    Metadata.OutdoorAreaId,
    Metadata.SpawnEntrance
  ); end with;
end function;

function Continued(Outcome: Combat.TurnOutcome): GameState.GameState;
begin
  case Outcome of
    when Combat.TurnOutcome.Continued(const State, const Log, const Events):
      begin
        return State;
      end;
    when Combat.TurnOutcome.Defeated(const Log):
      begin
        panic('expected the game to continue');
      end;
  end case;
end function;

function LogOf(Outcome: Combat.TurnOutcome): array of string;
begin
  case Outcome of
    when Combat.TurnOutcome.Continued(const State, const Log, const Events):
      begin
        return Log;
      end;
    when Combat.TurnOutcome.Defeated(const Log):
      begin
        return Log;
      end;
  end case;
end function;

function LogContains(Log: array of string; Text: string): boolean;
begin
  for Line: string in Log do
    begin
      if Text in Line then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

function Skeleton(State: GameState.GameState): HostileRules.GameHostile;
begin
  return State.Hostiles[0];
end function;

begin
  // LCG vectors calculated independently: missed attacks skip the damage draw.
  AssertPinnedAttack(
    AttackVector(
      Seed := 0, PlayerDamage := 0, HostileDamage := 1,
      FinalRandomState := 654583775, PlayerEvent := Combat.CombatEventKind.PlayerMiss,
      HostileEvent := Combat.CombatEventKind.HostileHit
    )
  );
  AssertPinnedAttack(
    AttackVector(
      Seed := 1, PlayerDamage := 2, HostileDamage := 4,
      FinalRandomState := 1147902781, PlayerEvent := Combat.CombatEventKind.PlayerHit,
      HostileEvent := Combat.CombatEventKind.HostileHit
    )
  );
  AssertPinnedAttack(
    AttackVector(
      Seed := 2, PlayerDamage := 3, HostileDamage := 3,
      FinalRandomState := 846338638, PlayerEvent := Combat.CombatEventKind.PlayerHit,
      HostileEvent := Combat.CombatEventKind.HostileHit
    )
  );
  AssertPinnedAttack(
    AttackVector(
      Seed := 3, PlayerDamage := 1, HostileDamage := 0,
      FinalRandomState := 679304702, PlayerEvent := Combat.CombatEventKind.PlayerHit,
      HostileEvent := Combat.CombatEventKind.HostileMiss
    )
  );
  const Metadata: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
    'combat',
    12345,
    4
  ).Unwrap();
  const Fresh: GameState.GameState := Fixtures.MaterializedFixtureState(Metadata);
  Test.AssertEquals(GameState.PlayerMaximumHealth, Fresh.Health);
  Test.AssertEquals(1, Fresh.Hostiles.Length());
  Test.AssertEquals(Fixtures.FixtureSkeletonId(Metadata), Skeleton(Fresh).Id);
  Test.AssertEquals(HostileRules.RestlessSkeletonMaximumHealth, Skeleton(Fresh).Health);
  Test.AssertFalse(Skeleton(Fresh).Alerted);
  Test.AssertEquals(3, Skeleton(Fresh).Position.X);
  Test.AssertEquals(3, Skeleton(Fresh).Position.Y);
  Test.AssertEquals(GameState.InitialRandomState(12345), Fresh.RandomState);
  // Walls hide the inner passages from the main corridors: the start, the lower hall
  // at the exit, and the upper corridor never alert the skeleton.
  for Watch: integer := 0 to 2 do
    begin
      var Hidden: GameState.GameState := InDungeon(
        Metadata,
        9,
        1,
        Coordinates.FacingDirection.West
      );
      if Watch = 1 then
        begin
          Hidden := InDungeon(Metadata, 1, 7, Coordinates.FacingDirection.West);
        end;
      end if;

      if Watch = 2 then
        begin
          Hidden := InDungeon(Metadata, 2, 1, Coordinates.FacingDirection.West);
        end;
      end if;
      const Quiet: Combat.TurnOutcome := Combat.ResolveTurn(
        Fixtures.FixtureViewFor(Metadata, Hidden),
        Hidden,
        Combat.TurnAction.Wait
      ).Unwrap();
      Test.AssertFalse(Skeleton(Continued(Quiet)).Alerted);
      Test.AssertTrue(LogContains(LogOf(Quiet), 'You wait.'));
    end;
  end for;
  // In the inner passages it notices the player, then approaches one field per turn.
  const InPassage: GameState.GameState := InDungeon(
    Metadata,
    5,
    3,
    Coordinates.FacingDirection.West
  );
  const Noticed: Combat.TurnOutcome := Combat.ResolveTurn(
    Fixtures.FixtureViewFor(Metadata, InPassage),
    InPassage,
    Combat.TurnAction.Wait
  ).Unwrap();
  Test.AssertTrue(Skeleton(Continued(Noticed)).Alerted);
  Test.AssertTrue(LogContains(LogOf(Noticed), 'notices you'));
  Test.AssertEquals(3, Skeleton(Continued(Noticed)).Position.X);
  // Now it stands directly ahead: it blocks movement and the hint offers an attack.
  const Blocked: GameState.GameState := Continued(
    Combat.ResolveTurn(
      Fixtures.FixtureViewFor(Metadata, Continued(Noticed)),
      Continued(Noticed),
      Combat.TurnAction.Wait
    ).Unwrap()
  );
  Test.AssertEquals(4, Skeleton(Blocked).Position.X);
  Test.AssertEquals(3, Skeleton(Blocked).Position.Y);
  Test.AssertTrue(
    (
      Combat.ResolveTurn(
        Fixtures.FixtureViewFor(Metadata, Blocked),
        Blocked,
        Combat.TurnAction.Step(Coordinates.RelativeStep.Forward)
      ) is Error(_)
    )
  );
  Test.AssertTrue('Restless skeleton' in Interaction.HostileInteractionHint(Blocked));
  Test.AssertTrue('Space: Attack' in Interaction.HostileInteractionHint(Blocked));
  Test.AssertEquals(
    Interaction.HostileInteractionHint(Blocked),
    Interaction.InteractionHint(Blocked)
  );
  // Rejected actions consume neither time nor dice.
  const NothingAhead: GameState.GameState := InDungeon(
    Metadata,
    9,
    1,
    Coordinates.FacingDirection.West
  );
  Test.AssertTrue(
    (
      Combat.ResolveTurn(
        Fixtures.FixtureViewFor(Metadata, NothingAhead),
        NothingAhead,
        Combat.TurnAction.Attack
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      Combat.ResolveTurn(
        Fixtures.FixtureViewFor(Metadata, Fixtures.MaterializedFixtureState(Metadata)),
        Fixtures.MaterializedFixtureState(Metadata),
        Combat.TurnAction.Attack
      ) is Error(_)
    )
  );
  // Fighting is deterministic: the same actions from the same state produce the same fight.
  var Fight: GameState.GameState := Blocked;
  var Replay: GameState.GameState := Blocked;
  var Turns: integer := 0;
  var SawHit: boolean := false;
  while (Skeleton(Fight).Health > 0) and (Turns < 60) do
    begin
      // Reset health between blows to cover the full deterministic combat sequence.
      Fight := Fight with Health := GameState.PlayerMaximumHealth; end with;

      Replay := Replay with Health := GameState.PlayerMaximumHealth; end with;
      const Blow: Combat.TurnOutcome := Combat.ResolveTurn(
        Fixtures.FixtureViewFor(Metadata, Fight),
        Fight,
        Combat.TurnAction.Attack
      ).Unwrap();
      const Again: Combat.TurnOutcome := Combat.ResolveTurn(
        Fixtures.FixtureViewFor(Metadata, Replay),
        Replay,
        Combat.TurnAction.Attack
      ).Unwrap();
      Test.AssertEquals(LogOf(Blow).Length(), LogOf(Again).Length());
      for Index: integer := 0 to LogOf(Blow).Length() - 1 do
        begin
          Test.AssertEquals(LogOf(Blow)[Index], LogOf(Again)[Index]);
        end;
      end for;

      SawHit := SawHit or LogContains(LogOf(Blow), 'You hit');
      Fight := Continued(Blow);
      Replay := Continued(Again);
      Test.AssertEquals(Fight.RandomState, Replay.RandomState);
      Turns := Turns + 1;
    end;
  end while;

  Test.AssertTrue(SawHit);
  Test.AssertEquals(0, Skeleton(Fight).Health);
  // A destroyed skeleton leaves no figure, blocks nothing, and stays recorded.
  Test.AssertEquals(
    -1,
    GameState.StandingHostileAt(
      Fight,
      Fixtures.SpawnDungeonAreaId(Metadata),
      Skeleton(Fight).Position
    )
  );
  Test.AssertEquals('', Interaction.HostileInteractionHint(Fight));
  const Map: InteriorUnit.InteriorMap := Fixtures.FixtureDungeonMapFor(
    Fixtures.SpawnDungeonAreaId(Metadata)
  );
  Test.AssertTrue(
    GameState.InteriorVisibleCodeForState(Map, Fight, Skeleton(Fight).Position).Unwrap() <> 'h'
  );
  const Walked: GameState.GameState := Continued(
    Combat.ResolveTurn(
      Fixtures.FixtureViewFor(Metadata, Fight),
      Fight,
      Combat.TurnAction.Step(Coordinates.RelativeStep.Forward)
    ).Unwrap()
  );
  Test.AssertEquals(4, GameState.FirstPersonPlayerPose(Walked).Unwrap().Position.X);
  Test.AssertTrue(
    (
      Combat.ResolveTurn(
        Fixtures.FixtureViewFor(Metadata, Walked),
        Walked,
        Combat.TurnAction.Attack
      ) is Error(_)
    )
  );
  // A wounded player adjacent to an alerted skeleton eventually falls.
  var Doomed: GameState.GameState := Blocked with Health := 1; end with;
  var Fallen: boolean := false;
  for Turn: integer := 1 to 40 do
    begin
      if not Fallen then
        begin
          case Combat.ResolveTurn(
            Fixtures.FixtureViewFor(Metadata, Doomed),
            Doomed,
            Combat.TurnAction.Wait
          ).Unwrap() of
            when Combat.TurnOutcome.Continued(const State, const Log, const Events):
              begin
                Doomed := State;
              end;
            when Combat.TurnOutcome.Defeated(const Log):
              begin
                Test.AssertTrue(LogContains(Log, 'You have fallen.'));
                Fallen := true;
              end;
          end case;
        end;
      end if;
    end;
  end for;

  Test.AssertTrue(Fallen);
  // Validation rejects impossible combat state.
  Test.AssertTrue(
    (Fixtures.ValidateFixtureSave(Metadata, Fresh with Health := 0; end with) is Error(_))
  );
  Test.AssertTrue(
    (
      Fixtures.ValidateFixtureSave(
        Metadata,
        Fresh with Health := GameState.PlayerMaximumHealth + 1; end with
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (Fixtures.ValidateFixtureSave(Metadata, Fresh with RandomState := -1; end with) is Error(_))
  );
  Test.AssertTrue(
    (Fixtures.ValidateFixtureSave(Metadata, Fresh with Hostiles := []; end with) is Error(_))
  );
  var Unknown: HostileRules.GameHostile := Skeleton(Fresh);
  Unknown.Id := 'unknown:hostile';
  Test.AssertTrue(
    (
      Fixtures.ValidateFixtureSave(Metadata, Fresh with Hostiles := [Unknown]; end with) is Error(_)
    )
  );
  var TooHealthy: HostileRules.GameHostile := Skeleton(Fresh);
  TooHealthy.Health := HostileRules.RestlessSkeletonMaximumHealth + 1;
  Test.AssertTrue(
    (
      Fixtures.ValidateFixtureSave(Metadata, Fresh with Hostiles := [TooHealthy]; end with) is Error(_)
    )
  );
  const StandingOnPlayer: GameState.GameState := InDungeon(
    Metadata,
    3,
    3,
    Coordinates.FacingDirection.West
  );
  Test.AssertTrue(Fixtures.ValidateFixtureSave(Metadata, StandingOnPlayer) is Error(_));
end.
