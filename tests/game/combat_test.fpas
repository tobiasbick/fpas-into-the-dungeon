// Verifies turn-based combat: perception, pursuit, dice, victory, defeat, and validation.
program CombatTest;

uses
  Dungeon.Test.InitialAreas, Dungeon.Combat, Dungeon.Coordinates, Dungeon.GameState,
  Dungeon.Hostiles, Dungeon.Interaction, Dungeon.Interior, Dungeon.Interior.InitialDungeon,
  Dungeon.Terrain, Dungeon.Terrain.Placement, Std.Arrays, Std.Results, Std.Str, Std.Test;

function InDungeon(Metadata: WorldMetadata; X: integer; Y: integer; Facing: FacingDirection): GameState;
begin
  return MaterializedInitialState(Metadata) with Area := AreaKind.Dungeon; AreaId := Metadata.DungeonAreaId; Player := PlayerPosition.FirstPerson(record
    Position := record
      X := X;
      Y := Y;
    end;
    Facing := Facing;
  end); ReturnLocation := ReturnLocation.ReturnTo(Metadata.OutdoorAreaId, Metadata.Entrance); end
end;

function Continued(Outcome: TurnOutcome): GameState;
begin
  case Outcome of
    TurnOutcome.Continued(State, Log, Events):
    begin
      return State
    end;
    TurnOutcome.Defeated(Log):
    begin
      panic('expected the game to continue')
    end
  end
end;

function LogOf(Outcome: TurnOutcome): array of string;
begin
  case Outcome of
    TurnOutcome.Continued(State, Log, Events):
    begin
      return Log
    end;
    TurnOutcome.Defeated(Log):
    begin
      return Log
    end
  end
end;

function LogContains(Log: array of string; Text: string): boolean;
begin
  for Line: string in Log do
  begin
    if Std.Str.Contains(Line, Text) then
    begin
      return true
    end
  end;

  return false
end;

function Skeleton(State: GameState): GameHostile;
begin
  return State.Hostiles[0]
end;

begin
  var Metadata: WorldMetadata := Unwrap(NewWorldMetadata('combat', 12345));
  var Fresh: GameState := MaterializedInitialState(Metadata);
  AssertEquals(PlayerMaximumHealth, Fresh.Health);
  AssertEquals(1, Std.Arrays.Length(Fresh.Hostiles));
  AssertEquals(RestlessSkeletonId, Skeleton(Fresh).Id);
  AssertEquals(RestlessSkeletonMaximumHealth, Skeleton(Fresh).Health);
  AssertFalse(Skeleton(Fresh).Alerted);
  AssertEquals(3, Skeleton(Fresh).Position.X);
  AssertEquals(3, Skeleton(Fresh).Position.Y);
  AssertEquals(InitialRandomState(12345), Fresh.RandomState);
  // Walls hide the inner passages from the main corridors: the start, the lower hall
  // at the exit, and the upper corridor never alert the skeleton.
  for Watch: integer := 0 to 2 do
  begin
    mutable var Hidden: GameState := InDungeon(Metadata, 9, 1, FacingDirection.West);
    if Watch = 1 then
    begin
      Hidden := InDungeon(Metadata, 1, 7, FacingDirection.West)
    end;

    if Watch = 2 then
    begin
      Hidden := InDungeon(Metadata, 2, 1, FacingDirection.West)
    end;
    var Quiet: TurnOutcome := Unwrap(ResolveTurn(InitialAreaView(Metadata, Hidden), Hidden, TurnAction.Wait));
    AssertFalse(Skeleton(Continued(Quiet)).Alerted);
    AssertTrue(LogContains(LogOf(Quiet), 'You wait.'))
  end;
  // In the inner passages it notices the player, then approaches one field per turn.
  var InPassage: GameState := InDungeon(Metadata, 5, 3, FacingDirection.West);
  var Noticed: TurnOutcome := Unwrap(ResolveTurn(InitialAreaView(Metadata, InPassage), InPassage, TurnAction.Wait));
  AssertTrue(Skeleton(Continued(Noticed)).Alerted);
  AssertTrue(LogContains(LogOf(Noticed), 'notices you'));
  AssertEquals(3, Skeleton(Continued(Noticed)).Position.X);
  // Now it stands directly ahead: it blocks movement and the hint offers an attack.
  var Blocked: GameState := Continued(Unwrap(ResolveTurn(InitialAreaView(Metadata, Continued(Noticed)), Continued(Noticed), TurnAction.Wait)));
  AssertEquals(4, Skeleton(Blocked).Position.X);
  AssertEquals(3, Skeleton(Blocked).Position.Y);
  AssertTrue(IsError(ResolveTurn(InitialAreaView(Metadata, Blocked), Blocked, TurnAction.Step(RelativeStep.Forward))));
  AssertTrue(Std.Str.Contains(HostileInteractionHint(Blocked), 'Restless skeleton'));
  AssertTrue(Std.Str.Contains(HostileInteractionHint(Blocked), 'Space: Attack'));
  AssertEquals(HostileInteractionHint(Blocked), InteractionHint(Blocked));
  // Rejected actions consume neither time nor dice.
  var NothingAhead: GameState := InDungeon(Metadata, 9, 1, FacingDirection.West);
  AssertTrue(IsError(ResolveTurn(InitialAreaView(Metadata, NothingAhead), NothingAhead, TurnAction.Attack)));
  AssertTrue(IsError(ResolveTurn(InitialAreaView(Metadata, MaterializedInitialState(Metadata)), MaterializedInitialState(Metadata), TurnAction.Attack)));
  // Fighting is deterministic: the same actions from the same state produce the same fight.
  mutable var Fight: GameState := Blocked;
  mutable var Replay: GameState := Blocked;
  mutable var Turns: integer := 0;
  mutable var SawHit: boolean := false;
  while (Skeleton(Fight).Health > 0) and (Turns < 60) do
  begin
    // Reset health between blows to cover the full deterministic combat sequence.
    Fight := Fight with Health := PlayerMaximumHealth; end;

    Replay := Replay with Health := PlayerMaximumHealth; end;
    var Blow: TurnOutcome := Unwrap(ResolveTurn(InitialAreaView(Metadata, Fight), Fight, TurnAction.Attack));
    var Again: TurnOutcome := Unwrap(ResolveTurn(InitialAreaView(Metadata, Replay), Replay, TurnAction.Attack));
    AssertEquals(Std.Arrays.Length(LogOf(Blow)), Std.Arrays.Length(LogOf(Again)));
    for Index: integer := 0 to Std.Arrays.Length(LogOf(Blow)) - 1 do
    begin
      AssertEquals(LogOf(Blow)[Index], LogOf(Again)[Index])
    end;

    SawHit := SawHit or LogContains(LogOf(Blow), 'You hit');
    Fight := Continued(Blow);
    Replay := Continued(Again);
    AssertEquals(Fight.RandomState, Replay.RandomState);
    Turns := Turns + 1
  end;

  AssertTrue(SawHit);
  AssertEquals(0, Skeleton(Fight).Health);
  // A destroyed skeleton leaves no figure, blocks nothing, and stays recorded.
  AssertEquals(-1, StandingHostileAt(Fight, Metadata.DungeonAreaId, Skeleton(Fight).Position));
  AssertEquals('', HostileInteractionHint(Fight));
  var Map: InteriorMap := Unwrap(InitialDungeonMap(Metadata));
  AssertTrue(Unwrap(InteriorVisibleCodeForState(Map, Fight, Skeleton(Fight).Position)) <> 'h');
  var Walked: GameState := Continued(Unwrap(ResolveTurn(InitialAreaView(Metadata, Fight), Fight, TurnAction.Step(RelativeStep.Forward))));
  AssertEquals(4, Unwrap(FirstPersonPlayerPose(Walked)).Position.X);
  AssertTrue(IsError(ResolveTurn(InitialAreaView(Metadata, Walked), Walked, TurnAction.Attack)));
  // A wounded player adjacent to an alerted skeleton eventually falls.
  mutable var Doomed: GameState := Blocked with Health := 1; end;
  mutable var Fallen: boolean := false;
  for Turn: integer := 1 to 40 do
  begin
    if not Fallen then
    begin
      case Unwrap(ResolveTurn(InitialAreaView(Metadata, Doomed), Doomed, TurnAction.Wait)) of
        TurnOutcome.Continued(State, Log, Events):
        begin
          Doomed := State
        end;
        TurnOutcome.Defeated(Log):
        begin
          AssertTrue(LogContains(Log, 'You have fallen.'));
          Fallen := true
        end
      end
    end
  end;

  AssertTrue(Fallen);
  // Validation rejects impossible combat state.
  AssertTrue(IsError(ValidateInitialSave(Metadata, Fresh with Health := 0; end)));
  AssertTrue(IsError(ValidateInitialSave(Metadata, Fresh with Health := PlayerMaximumHealth + 1; end)));
  AssertTrue(IsError(ValidateInitialSave(Metadata, Fresh with RandomState := -1; end)));
  AssertTrue(IsError(ValidateInitialSave(Metadata, Fresh with Hostiles := []; end)));
  mutable var Unknown: GameHostile := Skeleton(Fresh);
  Unknown.Id := 'initial-dungeon:someone-else';
  AssertTrue(IsError(ValidateInitialSave(Metadata, Fresh with Hostiles := [Unknown]; end)));
  mutable var TooHealthy: GameHostile := Skeleton(Fresh);
  TooHealthy.Health := RestlessSkeletonMaximumHealth + 1;
  AssertTrue(IsError(ValidateInitialSave(Metadata, Fresh with Hostiles := [TooHealthy]; end)));
  var StandingOnPlayer: GameState := InDungeon(Metadata, 3, 3, FacingDirection.West);
  AssertTrue(IsError(ValidateInitialSave(Metadata, StandingOnPlayer)))
end.
