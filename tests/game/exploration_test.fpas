// Verifies persistent discovery, derived visibility, signed chunks, ordering, and interior occlusion.
program DungeonExplorationTest;

uses Dungeon.Test.Fixtures as Fixtures, Dungeon.Coordinates as Coordinates, Dungeon.Exploration as Exploration, Dungeon.Exploration.Sight as Sight, Dungeon.Exploration.Model as Model, Dungeon.GameState as GameState, Dungeon.Interior as Interior, Dungeon.Movement as Movement, Dungeon.Terrain as Terrain, Dungeon.Terrain.Placement as Placement, Std.Test as Test;

function PoseAt(X: integer; Y: integer; Facing: Coordinates.FacingDirection): Coordinates.FirstPersonPose;
begin
  return Coordinates.FirstPersonPose(
    Position := Coordinates.InteriorPosition(X := X, Y := Y),
    Facing := Facing
  );
end function;

begin
  for Coordinate: integer in [7, 120, -8, -121] do
    begin
      const Corner: Model.ExplorationState := Exploration.RevealOutdoor(
        Model.EmptyExploration(),
        Coordinates.WorldPosition(X := Coordinate, Y := Coordinate)
      );
      Test.AssertTrue((Model.ValidateExploration(Corner, Coordinates.WorldChunkSize) is Ok(_)));
      const NextCorner: Model.ExplorationState := Exploration.RevealOutdoor(
        Corner,
        Coordinates.WorldPosition(X := Coordinate + 1, Y := Coordinate)
      );
      Test.AssertTrue((Model.ValidateExploration(NextCorner, Coordinates.WorldChunkSize) is Ok(_)));
    end;
  end for;
  const Empty: Model.ExplorationState := Model.EmptyExploration();
  Test.AssertTrue((Model.ValidateExploration(Empty, Coordinates.WorldChunkSize) is Ok(_)));
  Test.AssertFalse(Exploration.OutdoorIsDiscovered(Empty, 0, 0));
  Test.AssertTrue(Exploration.ClassifyField(false, false) = Model.FieldKnowledge.Undiscovered);
  Test.AssertTrue(Exploration.ClassifyField(true, false) = Model.FieldKnowledge.Remembered);
  Test.AssertTrue(Exploration.ClassifyField(false, true) = Model.FieldKnowledge.Visible);
  const BoundaryPlayer: Coordinates.WorldPosition := Coordinates.WorldPosition(X := -1, Y := -1);
  const Revealed: Model.ExplorationState := Exploration.RevealOutdoor(Empty, BoundaryPlayer);
  Test.AssertTrue((Model.ValidateExploration(Revealed, Coordinates.WorldChunkSize) is Ok(_)));
  Test.AssertEquals(4, Revealed.OutdoorChunks.Length());
  Test.AssertTrue(Exploration.OutdoorIsDiscovered(Revealed, -1, -1));
  Test.AssertTrue(Exploration.OutdoorIsDiscovered(Revealed, -9, -1));
  Test.AssertTrue(Exploration.OutdoorIsDiscovered(Revealed, 0, -1));
  Test.AssertFalse(Exploration.OutdoorIsDiscovered(Revealed, 8, -1));
  Test.AssertFalse(Exploration.OutdoorIsDiscovered(Revealed, -9, -9));
  Test.AssertEquals(-1, Revealed.OutdoorChunks[0].ChunkX);
  Test.AssertEquals(-1, Revealed.OutdoorChunks[0].ChunkY);
  Test.AssertEquals(0, Revealed.OutdoorChunks[1].ChunkX);
  Test.AssertEquals(-1, Revealed.OutdoorChunks[1].ChunkY);
  Test.AssertEquals(-1, Revealed.OutdoorChunks[2].ChunkX);
  Test.AssertEquals(0, Revealed.OutdoorChunks[2].ChunkY);
  const BeforeUnionCount: integer := Revealed.OutdoorChunks.Length();
  const Unioned: Model.ExplorationState := Exploration.RevealOutdoor(
    Revealed,
    Coordinates.WorldPosition(X := 8, Y := -1)
  );
  Test.AssertTrue(Exploration.OutdoorIsDiscovered(Unioned, -9, -1));
  Test.AssertTrue(Exploration.OutdoorIsDiscovered(Unioned, 16, -1));
  Test.AssertTrue(Unioned.OutdoorChunks.Length() >= BeforeUnionCount);
  const OutdoorVisible: array of boolean := Exploration.OutdoorVisibility(
    -10,
    -10,
    20,
    20,
    BoundaryPlayer
  );
  Test.AssertEquals(400, OutdoorVisible.Length());
  Test.AssertTrue(OutdoorVisible[(9 * 20) + 9]);
  Test.AssertTrue(OutdoorVisible[(9 * 20) + 1]);
  Test.AssertFalse(OutdoorVisible[0]);
  Test.AssertEquals(0, Exploration.OutdoorVisibility(0, 0, -1, 2, BoundaryPlayer).Length());
  var WrongOutdoorShape: Model.ExplorationState := Revealed;
  var WrongChunk: Model.OutdoorDiscoveryChunk := WrongOutdoorShape.OutdoorChunks[0];
  WrongChunk.Fields := [];
  WrongOutdoorShape.OutdoorChunks[0] := WrongChunk;
  Test.AssertTrue(
    (Model.ValidateExploration(WrongOutdoorShape, Coordinates.WorldChunkSize) is Error(_))
  );
  var DuplicateChunk: Model.ExplorationState := Revealed;
  DuplicateChunk.OutdoorChunks := [Revealed.OutdoorChunks[0], Revealed.OutdoorChunks[0]];
  Test.AssertTrue(
    (Model.ValidateExploration(DuplicateChunk, Coordinates.WorldChunkSize) is Error(_))
  );
  const EmptyMaskChunk: Model.OutdoorDiscoveryChunk := Model.OutdoorDiscoveryChunk(
    ChunkX := 0, ChunkY := 0, Fields := array.Fill(
      false, Coordinates.WorldChunkSize *
      Coordinates.WorldChunkSize
    )
  );
  Test.AssertTrue(
    (
      Model.ValidateExploration(
        Model.ExplorationState(OutdoorChunks := [EmptyMaskChunk], InteriorAreas := []),
        Coordinates.WorldChunkSize
      ) is Error(_)
    )
  );
  const Metadata: Terrain.WorldMetadata := Placement.NewWorldMetadata(
    'exploration-rules',
    12345,
    4
  ).Unwrap();
  const Map: Interior.InteriorMap := Fixtures.FixtureDungeonMapFor(
    Fixtures.SpawnDungeonAreaId(Metadata)
  );
  const SouthPose: Coordinates.FirstPersonPose := PoseAt(1, 1, Coordinates.FacingDirection.South);
  const SouthVisible: array of boolean := Sight.InteriorVisibility(Map, SouthPose);
  Test.AssertTrue(SouthVisible[(1 * Map.Width) + 1]);
  Test.AssertTrue(SouthVisible[(4 * Map.Width) + 1]);
  Test.AssertFalse(SouthVisible[(5 * Map.Width) + 1]);
  // The immediate lateral field is visible, but this does not reveal a side corridor.
  Test.AssertTrue(SouthVisible[(1 * Map.Width) + 2]);
  Test.AssertTrue(SouthVisible[(1 * Map.Width) + 0]);
  Test.AssertFalse(SouthVisible[(1 * Map.Width) + 3]);
  Test.AssertFalse(SouthVisible[1]);
  // Immediate lateral visibility rotates with the player, not with world axes.
  for Facing: Coordinates.FacingDirection in [
    Coordinates.FacingDirection.North,
    Coordinates.FacingDirection.East,
    Coordinates.FacingDirection.South,
    Coordinates.FacingDirection.West
  ] do
    begin
      const View: array of boolean := Sight.InteriorVisibility(Map, PoseAt(1, 1, Facing));
      if (Facing = Coordinates.FacingDirection.North)
        or
        (Facing = Coordinates.FacingDirection.South)
      then
        begin
          Test.AssertTrue(View[1 * Map.Width]);
          Test.AssertTrue(View[1 * Map.Width + 2]);
        end;
      else
        begin
          Test.AssertTrue(View[1]);
          Test.AssertTrue(View[2 * Map.Width + 1]);
        end;
      end if;
    end;
  end for;
  const InteriorRevealed: Model.ExplorationState := Exploration.RevealInterior(
    Empty,
    'z-dungeon',
    Map,
    SouthPose
  ).Unwrap();
  Test.AssertTrue(Exploration.InteriorIsDiscovered(InteriorRevealed, 'z-dungeon', Map.Width, 1, 4));
  Test.AssertFalse(
    Exploration.InteriorIsDiscovered(InteriorRevealed, 'z-dungeon', Map.Width, 1, 5)
  );
  const NorthRevealed: Model.ExplorationState := Exploration.RevealInterior(
    InteriorRevealed,
    'z-dungeon',
    Map,
    PoseAt(1, 1, Coordinates.FacingDirection.North)
  ).Unwrap();
  Test.AssertTrue(Exploration.InteriorIsDiscovered(NorthRevealed, 'z-dungeon', Map.Width, 1, 4));
  const TwoAreas: Model.ExplorationState := Exploration.RevealInterior(
    NorthRevealed,
    'a-house',
    Map,
    SouthPose
  ).Unwrap();
  Test.AssertEquals('a-house', TwoAreas.InteriorAreas[0].AreaId);
  Test.AssertEquals('z-dungeon', TwoAreas.InteriorAreas[1].AreaId);
  Test.AssertTrue((Model.ValidateExploration(TwoAreas, Coordinates.WorldChunkSize) is Ok(_)));
  var DuplicateArea: Model.ExplorationState := TwoAreas;
  DuplicateArea.InteriorAreas := [TwoAreas.InteriorAreas[0], TwoAreas.InteriorAreas[0]];
  Test.AssertTrue(
    (Model.ValidateExploration(DuplicateArea, Coordinates.WorldChunkSize) is Error(_))
  );
  Test.AssertFalse(Exploration.InteriorIsDiscovered(TwoAreas, 'missing', Map.Width, 0, 0));
  Test.AssertFalse(Exploration.InteriorIsDiscovered(TwoAreas, 'a-house', Map.Width + 1, 0, 0));
  const EmptyGame: GameState.GameState := GameState.NewGame(Metadata);
  Test.AssertEquals(0, EmptyGame.Exploration.OutdoorChunks.Length());
  const Started: GameState.GameState := Exploration.RevealCurrentArea(
    Fixtures.FixtureViewFor(Metadata, EmptyGame),
    EmptyGame
  ).Unwrap();
  const Start: Coordinates.WorldPosition := GameState.OutdoorPlayerPosition(Started).Unwrap();
  Test.AssertTrue(Exploration.OutdoorIsDiscovered(Started.Exploration, Start.X, Start.Y));
  Test.AssertTrue(
    Exploration.OutdoorIsDiscovered(
      Started.Exploration,
      Start.X - Exploration.OutdoorSightRadius,
      Start.Y
    )
  );
  Test.AssertFalse(
    Exploration.OutdoorIsDiscovered(
      Started.Exploration,
      (Start.X - Exploration.OutdoorSightRadius) - 1,
      Start.Y
    )
  );
  const RejectedBefore: boolean := Exploration.OutdoorIsDiscovered(
    Started.Exploration, (Start.X + Exploration.OutdoorSightRadius) +
    1, Start.Y
  );
  Test.AssertTrue(
    (
      Movement.MovePlayer(
        Started,
        1,
        0,
        Terrain.WorldCell(
          Base := Terrain.BaseTerrainKind.Water,
          Feature := Terrain.TerrainFeatureKind.NoFeature,
          Water := Terrain.WaterKind.Sea
        )
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    Exploration.OutdoorIsDiscovered(
      Started.Exploration,
      (Start.X + Exploration.OutdoorSightRadius) + 1,
      Start.Y
    ) =
    RejectedBefore
  );
  var Moved: GameState.GameState := Movement.MovePlayer(
    Started,
    1,
    0,
    Terrain.WorldCell(
      Base := Terrain.BaseTerrainKind.Grass,
      Feature := Terrain.TerrainFeatureKind.NoFeature,
      Water := Terrain.WaterKind.NoWater
    )
  ).Unwrap();
  Moved := Exploration.RevealCurrentArea(Fixtures.FixtureViewFor(Metadata, Moved), Moved).Unwrap();
  Test.AssertTrue(
    Exploration.OutdoorIsDiscovered(
      Moved.Exploration,
      Start.X - Exploration.OutdoorSightRadius,
      Start.Y
    )
  );
  Test.AssertTrue(
    Exploration.OutdoorIsDiscovered(
      Moved.Exploration,
      (Start.X + Exploration.OutdoorSightRadius) + 1,
      Start.Y
    )
  );
  var AtEntrance: GameState.GameState := Started;
  AtEntrance.Player := Coordinates.PlayerPosition.Outdoor(Metadata.SpawnEntrance);
  AtEntrance := Exploration.RevealCurrentArea(
    Fixtures.FixtureViewFor(Metadata, AtEntrance),
    AtEntrance
  ).Unwrap();
  const JustEntered: GameState.GameState := Fixtures.ActivateFixtureTransition(
    Metadata,
    AtEntrance
  ).Unwrap();
  const Entered: GameState.GameState := Exploration.RevealCurrentArea(
    Fixtures.FixtureViewFor(Metadata, JustEntered),
    JustEntered
  ).Unwrap();
  Test.AssertTrue(
    Exploration.OutdoorIsDiscovered(
      Entered.Exploration,
      Metadata.SpawnEntrance.X,
      Metadata.SpawnEntrance.Y
    )
  );
  Test.AssertTrue(
    Exploration.InteriorIsDiscovered(
      Entered.Exploration,
      Fixtures.SpawnDungeonAreaId(Metadata),
      Map.Width,
      Map.Start.X,
      Map.Start.Y
    )
  );
  Test.AssertFalse(
    Exploration.InteriorIsDiscovered(
      Entered.Exploration,
      Fixtures.SpawnDungeonAreaId(Metadata),
      Map.Width,
      9,
      4
    )
  );
  var Turned: GameState.GameState := Movement.TurnFirstPerson(
    Fixtures.FixtureViewFor(Metadata, Entered),
    Entered,
    Coordinates.RelativeTurn.TurnLeft
  ).Unwrap();
  Turned := Exploration.RevealCurrentArea(
    Fixtures.FixtureViewFor(Metadata, Turned),
    Turned
  ).Unwrap();
  Test.AssertTrue(
    Exploration.InteriorIsDiscovered(
      Turned.Exploration,
      Fixtures.SpawnDungeonAreaId(Metadata),
      Map.Width,
      9,
      4
    )
  );
  var AtExit: GameState.GameState := Turned;
  AtExit.Player := Coordinates.PlayerPosition.FirstPerson(
    PoseAt(Map.Exit.X, Map.Exit.Y, Coordinates.FacingDirection.West)
  );
  const JustLeft: GameState.GameState := Fixtures.ActivateFixtureTransition(
    Metadata,
    AtExit
  ).Unwrap();
  const Left: GameState.GameState := Exploration.RevealCurrentArea(
    Fixtures.FixtureViewFor(Metadata, JustLeft),
    JustLeft
  ).Unwrap();
  Test.AssertTrue(
    Exploration.OutdoorIsDiscovered(
      Left.Exploration,
      Metadata.SpawnEntrance.X,
      Metadata.SpawnEntrance.Y
    )
  );
  Test.AssertTrue(
    Exploration.InteriorIsDiscovered(
      Left.Exploration,
      Fixtures.SpawnDungeonAreaId(Metadata),
      Map.Width,
      9,
      4
    )
  );
  var UnknownAreaState: GameState.GameState := Started;
  var UnknownFields: array of boolean := array.Fill(false, Map.Width * Map.Height);
  UnknownFields[0] := true;
  UnknownAreaState.Exploration.InteriorAreas := [
    Model.InteriorDiscoveryArea(
      AreaId := 'unknown-area',
      Width := Map.Width,
      Height := Map.Height,
      Fields := UnknownFields
    )
  ];
  Test.AssertTrue((Fixtures.ValidateFixtureSave(Metadata, UnknownAreaState) is Error(_)));
  const WrongAreaShape: Model.ExplorationState := Model.ExplorationState(
    OutdoorChunks := [], InteriorAreas := [
      Model.InteriorDiscoveryArea(AreaId := 'bad-shape', Width := 1, Height := 1, Fields := [true])
    ]
  );
  Test.AssertTrue(
    (Exploration.RevealInterior(WrongAreaShape, 'bad-shape', Map, SouthPose) is Error(_))
  );
end.
