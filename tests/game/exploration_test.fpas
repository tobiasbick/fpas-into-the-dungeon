// Verifies persistent discovery, derived visibility, signed chunks, ordering, and interior occlusion.
program DungeonExplorationTest;

uses
  Dungeon.Test.Fixtures, Dungeon.Coordinates, Dungeon.Exploration, Dungeon.Exploration.Sight,
  Dungeon.Exploration.Model, Dungeon.GameState, Dungeon.Interior, Dungeon.Movement, Dungeon.Terrain,
  Dungeon.Terrain.Placement, Std.Test;

function PoseAt(X: integer; Y: integer; Facing: FacingDirection): FirstPersonPose;
begin
  return FirstPersonPose(Position := InteriorPosition(X := X, Y := Y), Facing := Facing);
end function;

begin
  for Coordinate: integer in [7, 120, -8, -121] do
    begin
      const Corner: ExplorationState := RevealOutdoor(EmptyExploration(), WorldPosition(X := Coordinate, Y := Coordinate));
      AssertTrue(ValidateExploration(Corner, WorldChunkSize).IsOk());
      const NextCorner: ExplorationState := RevealOutdoor(Corner, WorldPosition(X := Coordinate + 1, Y := Coordinate));
      AssertTrue(ValidateExploration(NextCorner, WorldChunkSize).IsOk());
    end;
  end for;
  const Empty: ExplorationState := EmptyExploration();
  AssertTrue(ValidateExploration(Empty, WorldChunkSize).IsOk());
  AssertFalse(OutdoorIsDiscovered(Empty, 0, 0));
  AssertTrue(ClassifyField(false, false) = FieldKnowledge.Undiscovered);
  AssertTrue(ClassifyField(true, false) = FieldKnowledge.Remembered);
  AssertTrue(ClassifyField(false, true) = FieldKnowledge.Visible);
  const BoundaryPlayer: WorldPosition := WorldPosition(X := -1, Y := -1);
  const Revealed: ExplorationState := RevealOutdoor(Empty, BoundaryPlayer);
  AssertTrue(ValidateExploration(Revealed, WorldChunkSize).IsOk());
  AssertEquals(4, Revealed.OutdoorChunks.Length());
  AssertTrue(OutdoorIsDiscovered(Revealed, -1, -1));
  AssertTrue(OutdoorIsDiscovered(Revealed, -9, -1));
  AssertTrue(OutdoorIsDiscovered(Revealed, 0, -1));
  AssertFalse(OutdoorIsDiscovered(Revealed, 8, -1));
  AssertFalse(OutdoorIsDiscovered(Revealed, -9, -9));
  AssertEquals(-1, Revealed.OutdoorChunks[0].ChunkX);
  AssertEquals(-1, Revealed.OutdoorChunks[0].ChunkY);
  AssertEquals(0, Revealed.OutdoorChunks[1].ChunkX);
  AssertEquals(-1, Revealed.OutdoorChunks[1].ChunkY);
  AssertEquals(-1, Revealed.OutdoorChunks[2].ChunkX);
  AssertEquals(0, Revealed.OutdoorChunks[2].ChunkY);
  const BeforeUnionCount: integer := Revealed.OutdoorChunks.Length();
  const Unioned: ExplorationState := RevealOutdoor(Revealed, WorldPosition(X := 8, Y := -1));
  AssertTrue(OutdoorIsDiscovered(Unioned, -9, -1));
  AssertTrue(OutdoorIsDiscovered(Unioned, 16, -1));
  AssertTrue(Unioned.OutdoorChunks.Length() >= BeforeUnionCount);
  const OutdoorVisible: array of boolean := OutdoorVisibility(-10, -10, 20, 20, BoundaryPlayer);
  AssertEquals(400, OutdoorVisible.Length());
  AssertTrue(OutdoorVisible[(9 * 20) + 9]);
  AssertTrue(OutdoorVisible[(9 * 20) + 1]);
  AssertFalse(OutdoorVisible[0]);
  AssertEquals(0, OutdoorVisibility(0, 0, -1, 2, BoundaryPlayer).Length());
  var WrongOutdoorShape: ExplorationState := Revealed;
  var WrongChunk: OutdoorDiscoveryChunk := WrongOutdoorShape.OutdoorChunks[0];
  WrongChunk.Fields := [];
  WrongOutdoorShape.OutdoorChunks[0] := WrongChunk;
  AssertTrue(ValidateExploration(WrongOutdoorShape, WorldChunkSize).IsError());
  var DuplicateChunk: ExplorationState := Revealed;
  DuplicateChunk.OutdoorChunks := [Revealed.OutdoorChunks[0], Revealed.OutdoorChunks[0]];
  AssertTrue(ValidateExploration(DuplicateChunk, WorldChunkSize).IsError());
  const EmptyMaskChunk: OutdoorDiscoveryChunk := OutdoorDiscoveryChunk(ChunkX := 0, ChunkY := 0, Fields := array.Fill(false, WorldChunkSize *
                                                                                                                             WorldChunkSize));
  AssertTrue(ValidateExploration(ExplorationState(OutdoorChunks := [EmptyMaskChunk], InteriorAreas := []), WorldChunkSize)
               .IsError());
  const Metadata: WorldMetadata := NewWorldMetadata('exploration-rules', 12345, 4).Unwrap();
  const Map: InteriorMap := FixtureDungeonMapFor(SpawnDungeonAreaId(Metadata));
  const SouthPose: FirstPersonPose := PoseAt(1, 1, FacingDirection.South);
  const SouthVisible: array of boolean := InteriorVisibility(Map, SouthPose);
  AssertTrue(SouthVisible[(1 * Map.Width) + 1]);
  AssertTrue(SouthVisible[(4 * Map.Width) + 1]);
  AssertFalse(SouthVisible[(5 * Map.Width) + 1]);
  // The immediate lateral field is visible, but this does not reveal a side corridor.
  AssertTrue(SouthVisible[(1 * Map.Width) + 2]);
  AssertTrue(SouthVisible[(1 * Map.Width) + 0]);
  AssertFalse(SouthVisible[(1 * Map.Width) + 3]);
  AssertFalse(SouthVisible[1]);
  // Immediate lateral visibility rotates with the player, not with world axes.
  for Facing: FacingDirection in [
                                   FacingDirection.North,
                                   FacingDirection.East,
                                   FacingDirection.South,
                                   FacingDirection.West
                                 ] do
    begin
      const View: array of boolean := InteriorVisibility(Map, PoseAt(1, 1, Facing));
      if (Facing = FacingDirection.North) or (Facing = FacingDirection.South) then
        begin
          AssertTrue(View[1 * Map.Width]);
          AssertTrue(View[1 * Map.Width + 2]);
        end;
      else
        begin
          AssertTrue(View[1]);
          AssertTrue(View[2 * Map.Width + 1]);
        end;
      end if;
    end;
  end for;
  const InteriorRevealed: ExplorationState := RevealInterior(Empty, 'z-dungeon', Map, SouthPose)
                                                .Unwrap();
  AssertTrue(InteriorIsDiscovered(InteriorRevealed, 'z-dungeon', Map.Width, 1, 4));
  AssertFalse(InteriorIsDiscovered(InteriorRevealed, 'z-dungeon', Map.Width, 1, 5));
  const NorthRevealed: ExplorationState := RevealInterior(InteriorRevealed, 'z-dungeon', Map, PoseAt(1, 1, FacingDirection.North))
                                             .Unwrap();
  AssertTrue(InteriorIsDiscovered(NorthRevealed, 'z-dungeon', Map.Width, 1, 4));
  const TwoAreas: ExplorationState := RevealInterior(NorthRevealed, 'a-house', Map, SouthPose)
                                        .Unwrap();
  AssertEquals('a-house', TwoAreas.InteriorAreas[0].AreaId);
  AssertEquals('z-dungeon', TwoAreas.InteriorAreas[1].AreaId);
  AssertTrue(ValidateExploration(TwoAreas, WorldChunkSize).IsOk());
  var DuplicateArea: ExplorationState := TwoAreas;
  DuplicateArea.InteriorAreas := [TwoAreas.InteriorAreas[0], TwoAreas.InteriorAreas[0]];
  AssertTrue(ValidateExploration(DuplicateArea, WorldChunkSize).IsError());
  AssertFalse(InteriorIsDiscovered(TwoAreas, 'missing', Map.Width, 0, 0));
  AssertFalse(InteriorIsDiscovered(TwoAreas, 'a-house', Map.Width + 1, 0, 0));
  const EmptyGame: GameState := NewGame(Metadata);
  AssertEquals(0, EmptyGame.Exploration.OutdoorChunks.Length());
  const Started: GameState := RevealCurrentArea(FixtureViewFor(Metadata, EmptyGame), EmptyGame)
                                .Unwrap();
  const Start: WorldPosition := OutdoorPlayerPosition(Started).Unwrap();
  AssertTrue(OutdoorIsDiscovered(Started.Exploration, Start.X, Start.Y));
  AssertTrue(OutdoorIsDiscovered(Started.Exploration, Start.X - OutdoorSightRadius, Start.Y));
  AssertFalse(OutdoorIsDiscovered(Started.Exploration, (Start.X - OutdoorSightRadius) - 1, Start.Y));
  const RejectedBefore: boolean := OutdoorIsDiscovered(Started.Exploration, (Start.X + OutdoorSightRadius) +
                                                                            1, Start.Y);
  AssertTrue(MovePlayer(Started, 1, 0, WorldCell(Base := BaseTerrainKind.Water, Feature := TerrainFeatureKind.NoFeature, Water := WaterKind.Sea))
               .IsError());
  AssertTrue(OutdoorIsDiscovered(Started.Exploration, (Start.X + OutdoorSightRadius) + 1, Start.Y) =
             RejectedBefore);
  var Moved: GameState := MovePlayer(Started, 1, 0, WorldCell(Base := BaseTerrainKind.Grass, Feature := TerrainFeatureKind.NoFeature, Water := WaterKind.NoWater))
                            .Unwrap();
  Moved := RevealCurrentArea(FixtureViewFor(Metadata, Moved), Moved).Unwrap();
  AssertTrue(OutdoorIsDiscovered(Moved.Exploration, Start.X - OutdoorSightRadius, Start.Y));
  AssertTrue(OutdoorIsDiscovered(Moved.Exploration, (Start.X + OutdoorSightRadius) + 1, Start.Y));
  var AtEntrance: GameState := Started;
  AtEntrance.Player := PlayerPosition.Outdoor(Metadata.SpawnEntrance);
  AtEntrance := RevealCurrentArea(FixtureViewFor(Metadata, AtEntrance), AtEntrance).Unwrap();
  const JustEntered: GameState := ActivateFixtureTransition(Metadata, AtEntrance).Unwrap();
  const Entered: GameState := RevealCurrentArea(FixtureViewFor(Metadata, JustEntered), JustEntered)
                                .Unwrap();
  AssertTrue(OutdoorIsDiscovered(Entered.Exploration, Metadata.SpawnEntrance.X, Metadata.SpawnEntrance.Y));
  AssertTrue(InteriorIsDiscovered(Entered.Exploration, SpawnDungeonAreaId(Metadata), Map.Width, Map.Start.X, Map.Start.Y));
  AssertFalse(InteriorIsDiscovered(Entered.Exploration, SpawnDungeonAreaId(Metadata), Map.Width, 9, 4));
  var Turned: GameState := TurnFirstPerson(FixtureViewFor(Metadata, Entered), Entered, RelativeTurn.TurnLeft)
                             .Unwrap();
  Turned := RevealCurrentArea(FixtureViewFor(Metadata, Turned), Turned).Unwrap();
  AssertTrue(InteriorIsDiscovered(Turned.Exploration, SpawnDungeonAreaId(Metadata), Map.Width, 9, 4));
  var AtExit: GameState := Turned;
  AtExit.Player := PlayerPosition.FirstPerson(PoseAt(Map.Exit.X, Map.Exit.Y, FacingDirection.West));
  const JustLeft: GameState := ActivateFixtureTransition(Metadata, AtExit).Unwrap();
  const Left: GameState := RevealCurrentArea(FixtureViewFor(Metadata, JustLeft), JustLeft).Unwrap();
  AssertTrue(OutdoorIsDiscovered(Left.Exploration, Metadata.SpawnEntrance.X, Metadata.SpawnEntrance.Y));
  AssertTrue(InteriorIsDiscovered(Left.Exploration, SpawnDungeonAreaId(Metadata), Map.Width, 9, 4));
  var UnknownAreaState: GameState := Started;
  var UnknownFields: array of boolean := array.Fill(false, Map.Width * Map.Height);
  UnknownFields[0] := true;
  UnknownAreaState.Exploration.InteriorAreas := [
                                                  InteriorDiscoveryArea(AreaId := 'unknown-area', Width := Map.Width, Height := Map.Height, Fields := UnknownFields)
                                                ];
  AssertTrue(ValidateFixtureSave(Metadata, UnknownAreaState).IsError());
  const WrongAreaShape: ExplorationState := ExplorationState(OutdoorChunks := [], InteriorAreas := [
                                                                                                     InteriorDiscoveryArea(AreaId := 'bad-shape', Width := 1, Height := 1, Fields := [true])
                                                                                                   ]);
  AssertTrue(RevealInterior(WrongAreaShape, 'bad-shape', Map, SouthPose).IsError());
end.
