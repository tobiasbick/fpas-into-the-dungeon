// Protects the world-clock epoch, phase boundaries, day rollover and checked arithmetic limits.
program TimeTest;

uses Dungeon.Time as Clock, Std.Test as Test;

begin
  Test.AssertEquals(480, Clock.InitialMinutes);
  Test.AssertEquals(1, Clock.DayNumber(480));
  Test.AssertEquals(480, Clock.MinuteOfDay(480));
  const Minutes := [0, 359, 360, 1199, 1200, 1439, 1440, 1800];
  const Night := [true, true, false, false, true, true, true, false];
  for Index: integer := 0 to Minutes.Length() - 1 do
    Test.AssertTrue((Clock.Phase(Minutes[Index]) = Clock.DayPhase.Night) = Night[Index]);
  end for;

  Test.AssertEquals(1440, Clock.Advance(1439, 1).Unwrap());
  Test.AssertEquals(2, Clock.DayNumber(1440));
  Test.AssertEquals(0, Clock.MinuteOfDay(1440));
  Test.AssertEquals(10080, Clock.Advance(0, 10080).Unwrap());
  Test.AssertEquals(8, Clock.DayNumber(10080));
  Test.AssertEquals(0, Clock.Advance(0, 0).Unwrap());
  Test.AssertEquals(1000000000, Clock.Advance(999999999, 1).Unwrap());
  Test.AssertTrue(Clock.Advance(1000000000, 1) is Error(_));
  Test.AssertTrue(Clock.Advance(0, 9223372036854775807) is Error(_));
  Test.AssertTrue(Clock.Advance(480, -1) is Error(_));
  for Invalid: integer in [-1, 1000000001] do
    Test.AssertTrue(Clock.Validate(Invalid) is Error(_));
    Test.AssertTrue(Clock.Advance(Invalid, 0) is Error(_));
  end for;
end.
