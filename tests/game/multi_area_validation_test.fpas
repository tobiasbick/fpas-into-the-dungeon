// Verifies complete placement and geometry checks across distinct visited dungeon maps.
program MultiAreaValidationTest;

uses
  Dungeon.Areas, Dungeon.Areas.Identities, Dungeon.Coordinates, Dungeon.Exploration.Model,
  Dungeon.GameState, Dungeon.Interior, Dungeon.Items, Dungeon.Terrain, Dungeon.Terrain.Entrances,
  Dungeon.Test.Fixtures, Std.Conv, Std.Test;

// Returns the first ordinary region east of the spawn region that has an entrance site.
function SecondRegion(Metadata: WorldMetadata): RegionCoordinate;
begin
  const Spawn: RegionCoordinate := RegionOf(Metadata, Metadata.Spawn);
  for Offset: integer := 1 to 64 do
    begin
      const Candidate: RegionCoordinate := RegionCoordinate(X := Spawn.X + Offset, Y := Spawn.Y);
      if EntranceSite(Metadata, Candidate) is Some(const Site) then
        begin
          return Candidate;
        end;
      else
        begin
          null;
        end;
      end if;
    end;
  end for;

  panic('fixture world has no second entrance region');
end function;

function SecondSite(Metadata: WorldMetadata): WorldPosition;
begin
  if EntranceSite(Metadata, SecondRegion(Metadata)) is Some(const Site) then
    begin
      return Site;
    end;
  else
    begin
      panic('second region lost its entrance site');
    end;
  end if;
end function;

// A wider second area has its own identities and fields absent from the first map.
function SecondMap(First: InteriorMap): InteriorMap;
begin
  var Cells: array of InteriorCellKind := [];
  for Y: integer := 0 to First.Height - 1 do
    begin
      for X: integer := 0 to First.Width + 1 do
        begin
          var Cell: InteriorCellKind := InteriorCellKind.Wall;
          if X < First.Width then
            begin
              Cell := First.Cells[Y * First.Width + X];
            end;
          end if;

          if ((Y > 0) and (Y < First.Height - 1)) and ((X = 10) or (X = 11)) then
            begin
              Cell := InteriorCellKind.Floor;
            end;
          end if;

          Cells.Push(Cell);
        end;
      end for;
    end;
  end for;
  var Map: InteriorMap := First with AreaId := DungeonAreaId(FixtureMetadata(), SecondRegion(FixtureMetadata())); Width := 13; Cells := Cells; end with;

  for Index: integer := 0 to Map.Items.Length() - 1 do
    begin
      Map.Items[Index] := Map.Items[Index] with ItemId := (Map.AreaId + ':item:') + IntToStr(Index); end with;
    end;
  end for;

  for Index: integer := 0 to Map.Hostiles.Length() - 1 do
    begin
      Map.Hostiles[Index] := Map.Hostiles[Index] with Id := (Map.AreaId + ':hostile:') +
                                                            IntToStr(Index); end with;
    end;
  end for;

  return ValidateInteriorMap(Map).Unwrap();
end function;

begin
  const Metadata: WorldMetadata := FixtureMetadata();
  const First: InteriorMap := FixtureDungeonMap();
  const Second: InteriorMap := SecondMap(First);
  const One: GameState := FixtureDungeonState(First.Start, First.StartFacing);
  const Both: GameState := MaterializeArea(One, Second);
  // Same local opponent coordinates in different areas are valid.
  AssertTrue(ValidateSavedGame(Metadata, Both, [First, Second]).IsOk());
  AssertTrue(ValidateSavedGame(Metadata, Both, [Second, First]).IsOk());
  AssertTrue(ValidateSavedGame(Metadata, Both, [First]).IsError());
  AssertTrue(ValidateSavedGame(Metadata, Both, [First, First]).IsError());
  AssertTrue(ValidateSavedGame(Metadata, One, [First, Second]).IsError());
  AssertTrue(ValidateSavedGame(Metadata, Both, [First, Second with Cells := []; end with]).IsError());
  // Visited areas must stay in canonical order.
  AssertTrue(ValidateSavedGame(Metadata, Both with VisitedAreas := [
                                                                     Both.VisitedAreas[1],
                                                                     Both.VisitedAreas[0]
                                                                   ]; end with, [First, Second])
               .IsError());
  AssertTrue(ValidateSavedGame(Metadata, Both with VisitedAreas := [First.AreaId, First.AreaId]; end with, [
                                                                                                             First,
                                                                                                             Second
                                                                                                           ])
               .IsError());
  const View: AreaView := AreaViewFor(Metadata, Both, Some(First)).Unwrap();
  var Transfer: GameState := Both;
  Transfer.Items[0] := Transfer.Items[0] with Location := ItemLocation.InInterior(Second.AreaId, InteriorPosition(X := 11, Y := 1)); end with;

  AssertTrue(ValidateSavedGame(Metadata, Transfer, [First, Second]).IsOk());
  // The current view may select either visited dungeon, independently of the initial identity.
  const InSecond: GameState := Transfer with AreaId := Second.AreaId; Player := PlayerPosition.FirstPerson(FirstPersonPose(Position := Second.Start, Facing := Second.StartFacing)); ReturnLocation := ReturnLocation.ReturnTo(Metadata.OutdoorAreaId, SecondSite(Metadata)); end with;

  // The return location must be the entrance site of the current dungeon's region.
  AssertTrue(ValidateSavedGame(Metadata, InSecond with ReturnLocation := Transfer.ReturnLocation; end with, [
                                                                                                              Second,
                                                                                                              First
                                                                                                            ])
               .IsError());
  AssertTrue(ValidateSavedGame(Metadata, InSecond, [Second, First]).IsOk());
  AssertTrue(ValidateSavedGame(Metadata, Transfer with Items := []; end with, [First, Second])
               .IsError());
  var Wrong: GameState := Transfer;
  Wrong.Items[0] := Wrong.Items[0] with Id := 'unknown-item'; end with;

  AssertTrue(ValidateSavedGame(Metadata, Wrong, [First, Second]).IsError());
  Wrong := Transfer;
  Wrong.Items[0] := Wrong.Items[0] with Kind := ItemKind.LeatherJerkin; end with;

  AssertTrue(ValidateSavedGame(Metadata, Wrong, [First, Second]).IsError());
  Wrong := Transfer;
  Wrong.Items[0] := Wrong.Items[0] with Location := ItemLocation.InInterior(Second.AreaId, InteriorPosition(X := 12, Y := 1)); end with;

  AssertTrue(ValidateSavedGame(Metadata, Wrong, [First, Second]).IsError());
  Wrong := Transfer;
  Wrong.Items[0] := Wrong.Items[0] with Location := ItemLocation.InInterior('unvisited', First.Start); end with;

  AssertTrue(ValidateSavedGame(Metadata, Wrong, [First, Second]).IsError());
  Wrong := Transfer;
  Wrong.Items[0] := Wrong.Items[0] with Location := Wrong.Items[3].Location; end with;

  AssertTrue(ValidateSavedGame(Metadata, Wrong, [First, Second]).IsError());
  Wrong := Both;
  Wrong.Items[3] := Wrong.Items[0];
  AssertTrue(ValidateSavedGame(Metadata, Wrong, [First, Second]).IsError());
  var DuplicateOrigin: InteriorMap := Second;
  DuplicateOrigin.Items[0] := DuplicateOrigin.Items[0] with ItemId := First.Items[0].ItemId; end with;

  AssertTrue(ValidateSavedGame(Metadata, Both, [First, DuplicateOrigin]).IsError());
  AssertTrue(ValidateSavedGame(Metadata, Both with Hostiles := []; end with, [First, Second])
               .IsError());
  Wrong := Both;
  Wrong.Hostiles[0] := Wrong.Hostiles[0] with AreaId := Second.AreaId; end with;

  AssertTrue(ValidateSavedGame(Metadata, Wrong, [First, Second]).IsError());
  Wrong := Both;
  Wrong.Hostiles[1] := Wrong.Hostiles[1] with Position := InteriorPosition(X := 12, Y := 1); end with;

  // Local validation cannot see the second map; full validation must reject its wall position.
  AssertTrue(ValidateGameState(View, Wrong).IsOk());
  AssertTrue(ValidateSavedGame(Metadata, Wrong, [First, Second]).IsError());
  Wrong.Hostiles[1] := Wrong.Hostiles[1] with Health := 0; end with;

  AssertTrue(ValidateSavedGame(Metadata, Wrong, [First, Second]).IsError());
  Wrong := Both;
  Wrong.Hostiles[1] := Wrong.Hostiles[1] with Health := 99; end with;

  AssertTrue(ValidateSavedGame(Metadata, Wrong, [First, Second]).IsError());
  var Fields: array of boolean := array.Fill(false, Second.Width * Second.Height);
  Fields[Second.Start.Y * Second.Width + Second.Start.X] := true;
  const Discovery: InteriorDiscoveryArea := InteriorDiscoveryArea(AreaId := Second.AreaId, Width := Second.Width, Height := Second.Height, Fields := Fields);
  Wrong := Both;
  Wrong.Exploration.InteriorAreas := [Discovery];
  AssertTrue(ValidateSavedGame(Metadata, Wrong, [First, Second]).IsOk());
  Wrong.Exploration.InteriorAreas[0] := Discovery with Width := First.Width; Fields := array.Fill(true, First.Width *
                                                                                                        First.Height); end with;

  AssertTrue(ValidateGameState(View, Wrong).IsOk());
  AssertTrue(ValidateSavedGame(Metadata, Wrong, [First, Second]).IsError());
  Wrong.Exploration.InteriorAreas[0] := Discovery with AreaId := 'unvisited'; end with;

  AssertTrue(ValidateSavedGame(Metadata, Wrong, [First, Second]).IsError());
  const Outdoor: GameState := Both with Area := AreaKind.OutdoorRegion; AreaId := Metadata.OutdoorAreaId; Player := PlayerPosition.Outdoor(Metadata.SpawnEntrance); ReturnLocation := ReturnLocation.NoReturnLocation; end with;

  AssertTrue(ValidateSavedGame(Metadata, Outdoor, [Second, First]).IsOk());
  const Foreign: InteriorMap := First with AreaId := 'another-world:dungeon:0:0'; end with;
  const ForeignState: GameState := MaterializeArea(NewGame(Metadata), Foreign);
  AssertTrue(ValidateSavedGame(Metadata, ForeignState, [Foreign]).IsError());
end.
