// Verifies fixture identities, state ownership, poses, area-view construction, and routes.
program FixturesTest;

uses
  Dungeon.Areas.Identities, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Movement,
  Dungeon.Hostiles, Dungeon.Interior, Dungeon.Items, Dungeon.Terrain, Dungeon.Terrain.Entrances,
  Dungeon.Test.Fixtures, Std.Arrays, Std.Options, Std.Results, Std.Test;

// Plays a route with the real movement rules and returns the reached pose.
function Follow(State: GameState; Moves: array of RouteMove): FirstPersonPose;
begin
  mutable var Current: GameState := State;
  for Move: RouteMove in Moves do
    begin
      case Move of
        when RouteMove.RouteTurnLeft:
          begin
            Current := Std.Results.Unwrap(TurnFirstPerson(FixtureAreaView(Current), Current, RelativeTurn.TurnLeft));
          end;
        when RouteMove.RouteTurnRight:
          begin
            Current := Std.Results.Unwrap(TurnFirstPerson(FixtureAreaView(Current), Current, RelativeTurn.TurnRight));
          end;
        when RouteMove.RouteForward:
          begin
            Current := Std.Results.Unwrap(StepFirstPerson(FixtureAreaView(Current), Current, RelativeStep.Forward));
          end;
      end case;
    end;
  end for;

  return Std.Results.Unwrap(FirstPersonPlayerPose(Current));
end function;

begin
  var Metadata: WorldMetadata := FixtureMetadata();
  var Map: InteriorMap := FixtureDungeonMap();
  AssertTrue(IsOk(ValidateInteriorMap(Map)));
  // The fixture map stands in for the spawn entrance's dungeon of the fixture world.
  AssertEquals(FixtureAreaId(), Map.AreaId);
  AssertTrue(ParseDungeonAreaId(Metadata, Map.AreaId).Unwrap() = RegionOf(Metadata, Metadata.Spawn));
  AssertEquals(11, Map.Width);
  AssertEquals(9, Map.Height);
  AssertEquals(3, Std.Arrays.Length(Map.Items));
  AssertEquals(Map.AreaId + ':item:0', Map.Items[0].ItemId);
  AssertEquals(Map.AreaId + ':item:1', Map.Items[1].ItemId);
  AssertEquals(Map.AreaId + ':item:2', Map.Items[2].ItemId);
  AssertEquals(Map.AreaId + ':hostile:0', Map.Hostiles[0].Id);
  var State: GameState := FixtureDungeonState(Map.Start, Map.StartFacing);
  AssertTrue(State.Area = AreaKind.Dungeon);
  AssertEquals(Map.AreaId, State.AreaId);
  AssertTrue(State.Player =
             PlayerPosition.FirstPerson(record
    Position := Map.Start;
    Facing := Map.StartFacing;
  end));
  AssertTrue(State.ReturnLocation =
             ReturnLocation.ReturnTo(Metadata.OutdoorAreaId, Metadata.SpawnEntrance));
  AssertEquals(PlayerMaximumHealth, State.Health);
  AssertEquals(InitialRandomState(Metadata.Seed), State.RandomState);
  AssertEquals(0, Std.Arrays.Length(State.Exploration.InteriorAreas));
  AssertEquals(0, Std.Arrays.Length(State.Exploration.OutdoorChunks));
  for Index: integer := 0 to Std.Arrays.Length(Map.Items) - 1 do
    begin
      AssertEquals(Map.Items[Index].ItemId, State.Items[Index].Id);
      AssertTrue(Map.Items[Index].Kind = State.Items[Index].Kind);
      AssertTrue(State.Items[Index].Location =
                 ItemLocation.InInterior(Map.AreaId, Map.Items[Index].Position));
    end;
  end for;

  AssertEquals(Map.Hostiles[0].Id, State.Hostiles[0].Id);
  AssertEquals(Map.AreaId, State.Hostiles[0].AreaId);
  AssertTrue(Map.Hostiles[0].Position = State.Hostiles[0].Position);
  AssertEquals(HostileMaximumHealth(Map.Hostiles[0].Kind), State.Hostiles[0].Health);
  AssertFalse(State.Hostiles[0].Alerted);
  var View: AreaView := FixtureAreaView(State);
  AssertTrue(View.Metadata = Metadata);
  AssertEquals(Map.AreaId, Std.Options.Unwrap(View.Interior).AreaId);
  var Outdoor: GameState := State with Area := AreaKind.OutdoorRegion; AreaId := Metadata.OutdoorAreaId; Player := PlayerPosition.Outdoor(Metadata.Spawn); ReturnLocation := ReturnLocation.NoReturnLocation; end with;

  AssertTrue(Std.Options.IsNone(FixtureAreaView(Outdoor).Interior));
  // Mutating one test state must not alter the next independently built fixture.
  mutable var Changed: GameState := State;
  Changed.Items[0] := Changed.Items[0] with Location := ItemLocation.CarriedByPlayer; end with;
  var Fresh: GameState := FixtureDungeonState(Map.Exit, FacingDirection.North);
  AssertTrue(Fresh.Items[0].Location = State.Items[0].Location);
  AssertTrue(Fresh.Player =
             PlayerPosition.FirstPerson(record
    Position := Map.Exit;
    Facing := FacingDirection.North;
  end));
  // Routes reach their target with legal moves, around the standing skeleton when asked to.
  var StartPose: FirstPersonPose := record
    Position := Map.Start;
    Facing := Map.StartFacing;
  end;

  AssertEquals(0, Std.Arrays.Length(RouteTo(Map, StartPose, Map.Start, [])));
  AssertTrue(Follow(State, RouteTo(Map, StartPose, Map.Exit, [Map.Hostiles[0].Position])).Position =
             Map.Exit);
  AssertTrue(Follow(State, RouteTo(Map, StartPose, Map.Items[2].Position, [Map.Hostiles[0].Position])).Position =
             Map.Items[2].Position);
  // A single field behind the player needs two turns and one step: from west of the start back onto it.
  var Behind: array of RouteMove := RouteTo(Map, record
    Position := record
      X := Map.Start.X - 1;
      Y := Map.Start.Y;
    end;
    Facing := FacingDirection.West;
  end, Map.Start, []);
  AssertEquals(3, Std.Arrays.Length(Behind));
end.
