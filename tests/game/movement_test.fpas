// Verifies signed chunk coordinates, deterministic terrain, and authoritative movement rules.
program DungeonMovementTest;

uses Dungeon.Terrain.Chunks as ChunksUnit, Dungeon.Test.Fixtures as Fixtures, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Interior as InteriorUnit, Dungeon.Movement as Movement, Dungeon.Terrain as Terrain, Dungeon.Terrain.Generation as TerrainGeneration, Dungeon.Terrain.Placement as PlacementRules, Std.Math as Math, Std.Test as Test;

procedure AssertCoordinate(Value: integer; ExpectedChunk: integer; ExpectedLocal: integer);
begin
  Test.AssertEquals(ExpectedChunk, Coordinates.ChunkForCoordinate(Value));
  Test.AssertEquals(ExpectedLocal, Coordinates.LocalForCoordinate(Value));
end procedure;

procedure AssertCellEquals(Expected: Terrain.WorldCell; Actual: Terrain.WorldCell);
begin
  Test.AssertTrue(Expected.Base = Actual.Base);
  Test.AssertTrue(Expected.Feature = Actual.Feature);
  Test.AssertTrue(Expected.Water = Actual.Water);
end procedure;

function RequireOutdoor(State: GameState.GameState): Coordinates.WorldPosition;
begin
  return GameState.OutdoorPlayerPosition(State).Unwrap();
end function;

function RequireFirstPerson(State: GameState.GameState): Coordinates.FirstPersonPose;
begin
  return GameState.FirstPersonPlayerPose(State).Unwrap();
end function;

begin
  AssertCoordinate(-129, -2, 127);
  AssertCoordinate(-128, -1, 0);
  AssertCoordinate(-1, -1, 127);
  AssertCoordinate(0, 0, 0);
  AssertCoordinate(127, 0, 127);
  AssertCoordinate(128, 1, 0);
  const Metadata: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
    'test-world',
    12345,
    4
  ).Unwrap();
  const Repeated: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
    'test-world',
    12345,
    4
  ).Unwrap();
  Test.AssertEquals(Metadata.OutdoorAreaId, Repeated.OutdoorAreaId);
  Test.AssertEquals(4, Repeated.DungeonRegionChunks);
  Test.AssertEquals(Metadata.SpawnEntrance.X, Repeated.SpawnEntrance.X);
  Test.AssertEquals(Metadata.SpawnEntrance.Y, Repeated.SpawnEntrance.Y);
  Test.AssertTrue(Metadata.Spawn.Y < 0);
  Test.AssertTrue(Metadata.SpawnEntrance.Y < 0);
  Test.AssertEquals(
    3, Math.Abs(Metadata.SpawnEntrance.X - Metadata.Spawn.X) +
    Math.Abs(Metadata.SpawnEntrance.Y - Metadata.Spawn.Y)
  );
  Test.AssertTrue(
    ChunksUnit.GenerateWorldCell(
      Metadata,
      Metadata.SpawnEntrance.X,
      Metadata.SpawnEntrance.Y
    ).Feature =
    Terrain.TerrainFeatureKind.Entrance
  );
  for Seed: integer := -4 to 8 do
    begin
      const SeedMetadata: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
        'multi-seed',
        Seed,
        4
      ).Unwrap();
      const SeedRepeated: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
        'multi-seed',
        Seed,
        4
      ).Unwrap();
      Test.AssertEquals(
        3, Math.Abs(SeedMetadata.SpawnEntrance.X - SeedMetadata.Spawn.X) +
        Math.Abs(SeedMetadata.SpawnEntrance.Y - SeedMetadata.Spawn.Y)
      );
      Test.AssertEquals(SeedMetadata.SpawnEntrance.X, SeedRepeated.SpawnEntrance.X);
      Test.AssertEquals(SeedMetadata.SpawnEntrance.Y, SeedRepeated.SpawnEntrance.Y);
      Test.AssertTrue(
        Terrain.IsWalkable(
          ChunksUnit.GenerateWorldCell(
            SeedMetadata,
            SeedMetadata.SpawnEntrance.X,
            SeedMetadata.SpawnEntrance.Y
          )
        )
      );
    end;
  end for;
  const Origin: Terrain.WorldCell := ChunksUnit.GenerateWorldCell(
    Metadata,
    Metadata.Spawn.X,
    Metadata.Spawn.Y
  );
  Test.AssertTrue(Terrain.IsWalkable(Origin));
  Test.AssertFalse(Origin.Feature = Terrain.TerrainFeatureKind.Path);
  const First: Terrain.WorldChunk := ChunksUnit.GenerateChunk(
    Metadata,
    Coordinates.ChunkCoordinate(X := -1, Y := 0)
  );
  const Second: Terrain.WorldChunk := ChunksUnit.GenerateChunk(
    Metadata,
    Coordinates.ChunkCoordinate(X := -1, Y := 0)
  );
  Test.AssertEquals(Coordinates.WorldChunkSize * Coordinates.WorldChunkSize, First.Cells.Length());
  AssertCellEquals(First.Cells[0], Second.Cells[0]);
  AssertCellEquals(
    First.Cells[Coordinates.WorldChunkSize * Coordinates.WorldChunkSize - 1], Second.Cells[
      Coordinates.WorldChunkSize * Coordinates.WorldChunkSize -
      1
    ]
  );
  AssertCellEquals(
    Terrain.ChunkCell(First, 127, 64),
    ChunksUnit.GenerateWorldCell(Metadata, -1, 64)
  );
  const Initial: GameState.GameState := GameState.NewGame(Metadata);
  Test.AssertEquals(Metadata.Spawn.X, RequireOutdoor(Initial).X);
  const Hurt: GameState.GameState := Initial with Health := 7; end with;
  const Healed: GameState.GameState := Movement.MovePlayer(
    Hurt,
    1,
    0,
    ChunksUnit.GenerateWorldCell(Metadata, Metadata.Spawn.X + 1, Metadata.Spawn.Y)
  ).Unwrap();
  Test.AssertEquals(8, Healed.Health);
  Test.AssertEquals(7, Hurt.Health);
  const NearlyFull: GameState.GameState := Initial with Health := GameState.PlayerMaximumHealth - 1; end with;

  Test.AssertEquals(
    GameState.PlayerMaximumHealth, Movement.MovePlayer(
      NearlyFull, 1, 0, ChunksUnit.GenerateWorldCell(
        Metadata, Metadata.Spawn.X +
        1, Metadata.Spawn.Y
      )
    ).Unwrap().Health
  );
  Test.AssertEquals(
    GameState.PlayerMaximumHealth, Movement.MovePlayer(
      Initial, 1, 0, ChunksUnit.GenerateWorldCell(
        Metadata, Metadata.Spawn.X +
        1, Metadata.Spawn.Y
      )
    ).Unwrap().Health
  );
  Test.AssertTrue(Movement.MovePlayer(Hurt, 1, 1, Origin) is Error(_));
  Test.AssertTrue(
    (
      Movement.MovePlayer(
        Hurt,
        1,
        0,
        Terrain.WorldCell(
          Base := Terrain.BaseTerrainKind.Water,
          Feature := Terrain.TerrainFeatureKind.NoFeature,
          Water := Terrain.WaterKind.Sea
        )
      ) is Error(_)
    )
  );
  Test.AssertEquals(7, Hurt.Health);
  Test.AssertEquals(Metadata.Spawn.Y, RequireOutdoor(Initial).Y);
  Test.AssertEquals(Metadata.OutdoorAreaId, Initial.AreaId);
  Test.AssertTrue(Initial.Area = Coordinates.AreaKind.OutdoorRegion);
  Test.AssertTrue(Fixtures.ValidateFixtureSave(Metadata, Initial) is Ok(_));
  Test.AssertTrue(Fixtures.ActivateFixtureTransition(Metadata, Initial) is Error(_));
  const Moved: GameState.GameState := Movement.MovePlayer(
    Initial, 1, 0, ChunksUnit.GenerateWorldCell(
      Metadata, Metadata.Spawn.X +
      1, Metadata.Spawn.Y
    )
  ).Unwrap();
  Test.AssertEquals(Metadata.Spawn.X + 1, RequireOutdoor(Moved).X);
  Test.AssertEquals(Metadata.Spawn.Y, RequireOutdoor(Moved).Y);
  Test.AssertEquals(Metadata.Spawn.X, RequireOutdoor(Initial).X);
  Test.AssertTrue(Movement.MovePlayer(Initial, 1, 1, Origin) is Error(_));
  Test.AssertTrue(
    (
      Movement.MovePlayer(
        Initial,
        1,
        0,
        Terrain.WorldCell(
          Base := Terrain.BaseTerrainKind.Water,
          Feature := Terrain.TerrainFeatureKind.NoFeature,
          Water := Terrain.WaterKind.Sea
        )
      ) is Error(_)
    )
  );
  var AtEntrance: GameState.GameState := Initial;
  AtEntrance.Player := Coordinates.PlayerPosition.Outdoor(Metadata.SpawnEntrance);
  const Entered: GameState.GameState := Fixtures.ActivateFixtureTransition(
    Metadata,
    AtEntrance
  ).Unwrap();
  Test.AssertTrue(Entered.Area = Coordinates.AreaKind.Dungeon);
  Test.AssertEquals(Fixtures.SpawnDungeonAreaId(Metadata), Entered.AreaId);
  const DungeonMap: InteriorUnit.InteriorMap := Fixtures.FixtureDungeonMapFor(
    Fixtures.SpawnDungeonAreaId(Metadata)
  );
  Test.AssertEquals(DungeonMap.Start.X, RequireFirstPerson(Entered).Position.X);
  Test.AssertEquals(DungeonMap.Start.Y, RequireFirstPerson(Entered).Position.Y);
  Test.AssertTrue(DungeonMap.StartFacing = RequireFirstPerson(Entered).Facing);
  case Entered.ReturnLocation of
    when Coordinates.ReturnLocation.ReturnTo(const AreaId, const Position):
      Test.AssertEquals(Metadata.OutdoorAreaId, AreaId);
      Test.AssertEquals(Metadata.SpawnEntrance.X, Position.X);
      Test.AssertEquals(Metadata.SpawnEntrance.Y, Position.Y);
    when Coordinates.ReturnLocation.NoReturnLocation:
      panic('expected exact return location');
  end case;

  Test.AssertTrue(Fixtures.ValidateFixtureSave(Metadata, Entered) is Ok(_));
  Test.AssertTrue(Movement.MovePlayer(Entered, 1, 0, Origin) is Error(_));
  Test.AssertTrue(Fixtures.ActivateFixtureTransition(Metadata, Entered) is Error(_));
  var AtExit: GameState.GameState := Entered;
  AtExit.Player := Coordinates.PlayerPosition.FirstPerson(
    Coordinates.FirstPersonPose(
      Position := DungeonMap.Exit,
      Facing := Coordinates.FacingDirection.West
    )
  );
  const Left: GameState.GameState := Fixtures.ActivateFixtureTransition(Metadata, AtExit).Unwrap();
  Test.AssertTrue(Left.Area = Coordinates.AreaKind.OutdoorRegion);
  Test.AssertEquals(Metadata.OutdoorAreaId, Left.AreaId);
  Test.AssertEquals(Metadata.SpawnEntrance.X, RequireOutdoor(Left).X);
  Test.AssertEquals(Metadata.SpawnEntrance.Y, RequireOutdoor(Left).Y);
  if Left.ReturnLocation is Coordinates.ReturnLocation.NoReturnLocation then
    begin
      null;
    end;
  else
    begin
      panic('return location must be cleared on exit');
    end;
  end if;
  var InvalidOutdoor: GameState.GameState := Initial;
  InvalidOutdoor.ReturnLocation := Coordinates.ReturnLocation.ReturnTo(
    Metadata.OutdoorAreaId,
    RequireOutdoor(Initial)
  );
  Test.AssertTrue(Fixtures.ValidateFixtureSave(Metadata, InvalidOutdoor) is Error(_));
  var InvalidDungeon: GameState.GameState := Entered;
  InvalidDungeon.ReturnLocation := Coordinates.ReturnLocation.NoReturnLocation;
  Test.AssertTrue(Fixtures.ValidateFixtureSave(Metadata, InvalidDungeon) is Error(_));
  Test.AssertTrue(Fixtures.ActivateFixtureTransition(Metadata, InvalidDungeon) is Error(_));
  var WrongReturnCoordinate: GameState.GameState := Entered;
  WrongReturnCoordinate.ReturnLocation := Coordinates.ReturnLocation.ReturnTo(
    Metadata.OutdoorAreaId,
    Metadata.Spawn
  );
  Test.AssertTrue(Fixtures.ValidateFixtureSave(Metadata, WrongReturnCoordinate) is Error(_));
  var MovedDungeonCoordinate: GameState.GameState := Entered;
  MovedDungeonCoordinate.Player := Coordinates.PlayerPosition.FirstPerson(
    Coordinates.FirstPersonPose(
      Position := Coordinates.InteriorPosition(X := -1, Y := 0),
      Facing := Coordinates.FacingDirection.North
    )
  );
  Test.AssertTrue(Fixtures.ValidateFixtureSave(Metadata, MovedDungeonCoordinate) is Error(_));
end.
