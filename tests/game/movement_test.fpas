// Verifies signed chunk coordinates, deterministic terrain, and authoritative movement rules.
program DungeonMovementTest;

uses Dungeon.Game, Std.Arrays, Std.Results, Std.Test;

procedure AssertCoordinate(Value: integer; ExpectedChunk: integer; ExpectedLocal: integer);
begin
  AssertEquals(ExpectedChunk, ChunkForCoordinate(Value));
  AssertEquals(ExpectedLocal, LocalForCoordinate(Value))
end;

procedure AssertCellEquals(Expected: WorldCell; Actual: WorldCell);
begin
  AssertTrue(Expected.Base = Actual.Base);
  AssertTrue(Expected.Feature = Actual.Feature);
  AssertTrue(Expected.Water = Actual.Water)
end;

begin
  AssertCoordinate(-129, -2, 127);
  AssertCoordinate(-128, -1, 0);
  AssertCoordinate(-1, -1, 127);
  AssertCoordinate(0, 0, 0);
  AssertCoordinate(127, 0, 127);
  AssertCoordinate(128, 1, 0);
  var Metadata: WorldMetadata := NewWorldMetadata('test-world', 12345);
  var Origin: WorldCell := GenerateWorldCell(Metadata, 0, 0);
  AssertTrue(IsWalkable(Origin));
  AssertTrue(Origin.Feature = TerrainFeatureKind.Path);
  var First: WorldChunk := GenerateChunk(Metadata, record
    X := -1;
    Y := 0;
  end);
  var Second: WorldChunk := GenerateChunk(Metadata, record
    X := -1;
    Y := 0;
  end);
  AssertEquals(WorldChunkSize * WorldChunkSize, Std.Arrays.Length(First.Cells));
  AssertCellEquals(First.Cells[0], Second.Cells[0]);
  AssertCellEquals(First.Cells[WorldChunkSize * WorldChunkSize - 1], Second.Cells[WorldChunkSize * WorldChunkSize -
                                                                                  1]);
  AssertCellEquals(ChunkCell(First, 127, 64), GenerateWorldCell(Metadata, -1, 64));
  var Initial: GameState := NewGame(Metadata);
  AssertEquals(0, Initial.Player.X);
  AssertEquals(0, Initial.Player.Y);
  var Moved: GameState := Unwrap(MovePlayer(Initial, 1, 0, GenerateWorldCell(Metadata, 1, 0)));
  AssertEquals(1, Moved.Player.X);
  AssertEquals(0, Moved.Player.Y);
  AssertEquals(0, Initial.Player.X);
  AssertTrue(IsError(MovePlayer(Initial, 1, 1, Origin)));
  AssertTrue(IsError(MovePlayer(Initial, 1, 0, record
    Base := BaseTerrainKind.Water;
    Feature := TerrainFeatureKind.NoFeature;
    Water := WaterKind.Sea;
  end)))
end.
