// Verifies initial outdoor state and authoritative cardinal movement rules.
program DungeonMovementTest;

uses Dungeon.Game, Std.Results, Std.Test;

begin
  var Initial: GameState := NewGame();
  AssertEquals(6, Initial.PlayerX);
  AssertEquals(3, Initial.PlayerY);
  var Visible: VisibleArea := GetVisibleArea(Initial);
  AssertTrue(Visible.Kind = AreaKind.OutdoorRegion);
  AssertEquals(13, Visible.Width);
  AssertEquals(7, Visible.Height);
  AssertEquals('~~~~.........', Visible.Rows[0]);
  var Moved: GameState := Unwrap(MovePlayer(Initial, 1, 0));
  AssertEquals(7, Moved.PlayerX);
  AssertEquals(3, Moved.PlayerY);
  AssertEquals(6, Initial.PlayerX);
  AssertTrue(IsError(MovePlayer(Initial, 1, 1)));
  AssertTrue(IsError(MovePlayer(record
    Area := AreaKind.OutdoorRegion;
    PlayerX := 0;
    PlayerY := 0;
  end, -1, 0)))
end.
