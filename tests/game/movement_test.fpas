// Verifies signed chunk coordinates, deterministic terrain, and authoritative movement rules.
program DungeonMovementTest;

uses
  Dungeon.Terrain.Chunks, Dungeon.Test.Fixtures, Dungeon.Coordinates, Dungeon.GameState,
  Dungeon.Interior, Dungeon.Movement, Dungeon.Terrain, Dungeon.Terrain.Generation,
  Dungeon.Terrain.Placement, Std.Math, Std.Test;

procedure AssertCoordinate(Value: integer; ExpectedChunk: integer; ExpectedLocal: integer);
begin
  AssertEquals(ExpectedChunk, ChunkForCoordinate(Value));
  AssertEquals(ExpectedLocal, LocalForCoordinate(Value));
end procedure;

procedure AssertCellEquals(Expected: WorldCell; Actual: WorldCell);
begin
  AssertTrue(Expected.Base = Actual.Base);
  AssertTrue(Expected.Feature = Actual.Feature);
  AssertTrue(Expected.Water = Actual.Water);
end procedure;

function RequireOutdoor(State: GameState): WorldPosition;
begin
  return OutdoorPlayerPosition(State).Unwrap();
end function;

function RequireFirstPerson(State: GameState): FirstPersonPose;
begin
  return FirstPersonPlayerPose(State).Unwrap();
end function;

begin
  AssertCoordinate(-129, -2, 127);
  AssertCoordinate(-128, -1, 0);
  AssertCoordinate(-1, -1, 127);
  AssertCoordinate(0, 0, 0);
  AssertCoordinate(127, 0, 127);
  AssertCoordinate(128, 1, 0);
  const Metadata: WorldMetadata := NewWorldMetadata('test-world', 12345, 4).Unwrap();
  const Repeated: WorldMetadata := NewWorldMetadata('test-world', 12345, 4).Unwrap();
  AssertEquals(Metadata.OutdoorAreaId, Repeated.OutdoorAreaId);
  AssertEquals(4, Repeated.DungeonRegionChunks);
  AssertEquals(Metadata.SpawnEntrance.X, Repeated.SpawnEntrance.X);
  AssertEquals(Metadata.SpawnEntrance.Y, Repeated.SpawnEntrance.Y);
  AssertTrue(Metadata.Spawn.Y < 0);
  AssertTrue(Metadata.SpawnEntrance.Y < 0);
  AssertEquals(3, Abs(Metadata.SpawnEntrance.X - Metadata.Spawn.X) +
                  Abs(Metadata.SpawnEntrance.Y - Metadata.Spawn.Y));
  AssertTrue(GenerateWorldCell(Metadata, Metadata.SpawnEntrance.X, Metadata.SpawnEntrance.Y).Feature =
             TerrainFeatureKind.Entrance);
  for Seed: integer := -4 to 8 do
    begin
      const SeedMetadata: WorldMetadata := NewWorldMetadata('multi-seed', Seed, 4).Unwrap();
      const SeedRepeated: WorldMetadata := NewWorldMetadata('multi-seed', Seed, 4).Unwrap();
      AssertEquals(3, Abs(SeedMetadata.SpawnEntrance.X - SeedMetadata.Spawn.X) +
                      Abs(SeedMetadata.SpawnEntrance.Y - SeedMetadata.Spawn.Y));
      AssertEquals(SeedMetadata.SpawnEntrance.X, SeedRepeated.SpawnEntrance.X);
      AssertEquals(SeedMetadata.SpawnEntrance.Y, SeedRepeated.SpawnEntrance.Y);
      AssertTrue(IsWalkable(GenerateWorldCell(SeedMetadata, SeedMetadata.SpawnEntrance.X, SeedMetadata.SpawnEntrance.Y)));
    end;
  end for;
  const Origin: WorldCell := GenerateWorldCell(Metadata, Metadata.Spawn.X, Metadata.Spawn.Y);
  AssertTrue(IsWalkable(Origin));
  AssertFalse(Origin.Feature = TerrainFeatureKind.Path);
  const First: WorldChunk := GenerateChunk(Metadata, ChunkCoordinate(X := -1, Y := 0));
  const Second: WorldChunk := GenerateChunk(Metadata, ChunkCoordinate(X := -1, Y := 0));
  AssertEquals(WorldChunkSize * WorldChunkSize, First.Cells.Length());
  AssertCellEquals(First.Cells[0], Second.Cells[0]);
  AssertCellEquals(First.Cells[WorldChunkSize * WorldChunkSize - 1], Second.Cells[WorldChunkSize * WorldChunkSize -
                                                                                  1]);
  AssertCellEquals(ChunkCell(First, 127, 64), GenerateWorldCell(Metadata, -1, 64));
  const Initial: GameState := NewGame(Metadata);
  AssertEquals(Metadata.Spawn.X, RequireOutdoor(Initial).X);
  const Hurt: GameState := Initial with Health := 7; end with;
  const Healed: GameState := MovePlayer(Hurt, 1, 0, GenerateWorldCell(Metadata, Metadata.Spawn.X + 1, Metadata.Spawn.Y))
                               .Unwrap();
  AssertEquals(8, Healed.Health);
  AssertEquals(7, Hurt.Health);
  const NearlyFull: GameState := Initial with Health := PlayerMaximumHealth - 1; end with;

  AssertEquals(PlayerMaximumHealth, MovePlayer(NearlyFull, 1, 0, GenerateWorldCell(Metadata, Metadata.Spawn.X +
                                                                                             1, Metadata.Spawn.Y))
                                      .Unwrap()
                                      .Health);
  AssertEquals(PlayerMaximumHealth, MovePlayer(Initial, 1, 0, GenerateWorldCell(Metadata, Metadata.Spawn.X +
                                                                                          1, Metadata.Spawn.Y))
                                      .Unwrap()
                                      .Health);
  AssertTrue(MovePlayer(Hurt, 1, 1, Origin).IsError());
  AssertTrue(MovePlayer(Hurt, 1, 0, WorldCell(Base := BaseTerrainKind.Water, Feature := TerrainFeatureKind.NoFeature, Water := WaterKind.Sea))
               .IsError());
  AssertEquals(7, Hurt.Health);
  AssertEquals(Metadata.Spawn.Y, RequireOutdoor(Initial).Y);
  AssertEquals(Metadata.OutdoorAreaId, Initial.AreaId);
  AssertTrue(Initial.Area = AreaKind.OutdoorRegion);
  AssertTrue(ValidateFixtureSave(Metadata, Initial).IsOk());
  AssertTrue(ActivateFixtureTransition(Metadata, Initial).IsError());
  const Moved: GameState := MovePlayer(Initial, 1, 0, GenerateWorldCell(Metadata, Metadata.Spawn.X +
                                                                                  1, Metadata.Spawn.Y))
                              .Unwrap();
  AssertEquals(Metadata.Spawn.X + 1, RequireOutdoor(Moved).X);
  AssertEquals(Metadata.Spawn.Y, RequireOutdoor(Moved).Y);
  AssertEquals(Metadata.Spawn.X, RequireOutdoor(Initial).X);
  AssertTrue(MovePlayer(Initial, 1, 1, Origin).IsError());
  AssertTrue(MovePlayer(Initial, 1, 0, WorldCell(Base := BaseTerrainKind.Water, Feature := TerrainFeatureKind.NoFeature, Water := WaterKind.Sea))
               .IsError());
  var AtEntrance: GameState := Initial;
  AtEntrance.Player := PlayerPosition.Outdoor(Metadata.SpawnEntrance);
  const Entered: GameState := ActivateFixtureTransition(Metadata, AtEntrance).Unwrap();
  AssertTrue(Entered.Area = AreaKind.Dungeon);
  AssertEquals(SpawnDungeonAreaId(Metadata), Entered.AreaId);
  const DungeonMap: InteriorMap := FixtureDungeonMapFor(SpawnDungeonAreaId(Metadata));
  AssertEquals(DungeonMap.Start.X, RequireFirstPerson(Entered).Position.X);
  AssertEquals(DungeonMap.Start.Y, RequireFirstPerson(Entered).Position.Y);
  AssertTrue(DungeonMap.StartFacing = RequireFirstPerson(Entered).Facing);
  if Entered.ReturnLocation is ReturnLocation.ReturnTo(const AreaId, const Position) then
    begin
      AssertEquals(Metadata.OutdoorAreaId, AreaId);
      AssertEquals(Metadata.SpawnEntrance.X, Position.X);
      AssertEquals(Metadata.SpawnEntrance.Y, Position.Y);
    end;
  else
    begin
      panic('expected exact return location');
    end;
  end if;

  AssertTrue(ValidateFixtureSave(Metadata, Entered).IsOk());
  AssertTrue(MovePlayer(Entered, 1, 0, Origin).IsError());
  AssertTrue(ActivateFixtureTransition(Metadata, Entered).IsError());
  var AtExit: GameState := Entered;
  AtExit.Player := PlayerPosition.FirstPerson(FirstPersonPose(Position := DungeonMap.Exit, Facing := FacingDirection.West));
  const Left: GameState := ActivateFixtureTransition(Metadata, AtExit).Unwrap();
  AssertTrue(Left.Area = AreaKind.OutdoorRegion);
  AssertEquals(Metadata.OutdoorAreaId, Left.AreaId);
  AssertEquals(Metadata.SpawnEntrance.X, RequireOutdoor(Left).X);
  AssertEquals(Metadata.SpawnEntrance.Y, RequireOutdoor(Left).Y);
  if Left.ReturnLocation is ReturnLocation.NoReturnLocation then
    begin
      null;
    end;
  else
    begin
      panic('return location must be cleared on exit');
    end;
  end if;
  var InvalidOutdoor: GameState := Initial;
  InvalidOutdoor.ReturnLocation := ReturnLocation.ReturnTo(Metadata.OutdoorAreaId, RequireOutdoor(Initial));
  AssertTrue(ValidateFixtureSave(Metadata, InvalidOutdoor).IsError());
  var InvalidDungeon: GameState := Entered;
  InvalidDungeon.ReturnLocation := ReturnLocation.NoReturnLocation;
  AssertTrue(ValidateFixtureSave(Metadata, InvalidDungeon).IsError());
  AssertTrue(ActivateFixtureTransition(Metadata, InvalidDungeon).IsError());
  var WrongReturnCoordinate: GameState := Entered;
  WrongReturnCoordinate.ReturnLocation := ReturnLocation.ReturnTo(Metadata.OutdoorAreaId, Metadata.Spawn);
  AssertTrue(ValidateFixtureSave(Metadata, WrongReturnCoordinate).IsError());
  var MovedDungeonCoordinate: GameState := Entered;
  MovedDungeonCoordinate.Player := PlayerPosition.FirstPerson(FirstPersonPose(Position := InteriorPosition(X := -1, Y := 0), Facing := FacingDirection.North));
  AssertTrue(ValidateFixtureSave(Metadata, MovedDungeonCoordinate).IsError());
end.
