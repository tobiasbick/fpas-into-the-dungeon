// Verifies signed chunk coordinates, deterministic terrain, and authoritative movement rules.
program DungeonMovementTest;

uses Dungeon.Game, Std.Arrays, Std.Math, Std.Results, Std.Test;

procedure AssertCoordinate(Value: integer; ExpectedChunk: integer; ExpectedLocal: integer);
begin
  AssertEquals(ExpectedChunk, ChunkForCoordinate(Value));
  AssertEquals(ExpectedLocal, LocalForCoordinate(Value))
end;

procedure AssertCellEquals(Expected: WorldCell; Actual: WorldCell);
begin
  AssertTrue(Expected.Base = Actual.Base);
  AssertTrue(Expected.Feature = Actual.Feature);
  AssertTrue(Expected.Water = Actual.Water)
end;

function RequireOutdoor(State: GameState): WorldPosition;
begin
  return Unwrap(OutdoorPlayerPosition(State))
end;

function RequireFirstPerson(State: GameState): FirstPersonPose;
begin
  return Unwrap(FirstPersonPlayerPose(State))
end;

begin
  AssertCoordinate(-129, -2, 127);
  AssertCoordinate(-128, -1, 0);
  AssertCoordinate(-1, -1, 127);
  AssertCoordinate(0, 0, 0);
  AssertCoordinate(127, 0, 127);
  AssertCoordinate(128, 1, 0);
  var Metadata: WorldMetadata := Unwrap(NewWorldMetadata('test-world', 12345));
  var Repeated: WorldMetadata := Unwrap(NewWorldMetadata('test-world', 12345));
  AssertEquals(Metadata.OutdoorAreaId, Repeated.OutdoorAreaId);
  AssertEquals(Metadata.DungeonAreaId, Repeated.DungeonAreaId);
  AssertEquals(Metadata.EntranceId, Repeated.EntranceId);
  AssertEquals(Metadata.Entrance.X, Repeated.Entrance.X);
  AssertEquals(Metadata.Entrance.Y, Repeated.Entrance.Y);
  AssertTrue(Metadata.Spawn.Y < 0);
  AssertTrue(Metadata.Entrance.Y < 0);
  AssertEquals(3, Abs(Metadata.Entrance.X - Metadata.Spawn.X) +
                  Abs(Metadata.Entrance.Y - Metadata.Spawn.Y));
  AssertTrue(GenerateWorldCell(Metadata, Metadata.Entrance.X, Metadata.Entrance.Y).Feature =
             TerrainFeatureKind.Entrance);
  for Seed: integer := -4 to 8 do
  begin
    var SeedMetadata: WorldMetadata := Unwrap(NewWorldMetadata('multi-seed', Seed));
    var SeedRepeated: WorldMetadata := Unwrap(NewWorldMetadata('multi-seed', Seed));
    AssertEquals(3, Abs(SeedMetadata.Entrance.X - SeedMetadata.Spawn.X) +
                    Abs(SeedMetadata.Entrance.Y - SeedMetadata.Spawn.Y));
    AssertEquals(SeedMetadata.Entrance.X, SeedRepeated.Entrance.X);
    AssertEquals(SeedMetadata.Entrance.Y, SeedRepeated.Entrance.Y);
    AssertTrue(IsWalkable(GenerateWorldCell(SeedMetadata, SeedMetadata.Entrance.X, SeedMetadata.Entrance.Y)))
  end;
  var Origin: WorldCell := GenerateWorldCell(Metadata, Metadata.Spawn.X, Metadata.Spawn.Y);
  AssertTrue(IsWalkable(Origin));
  AssertFalse(Origin.Feature = TerrainFeatureKind.Path);
  var First: WorldChunk := GenerateChunk(Metadata, record
    X := -1;
    Y := 0;
  end);
  var Second: WorldChunk := GenerateChunk(Metadata, record
    X := -1;
    Y := 0;
  end);
  AssertEquals(WorldChunkSize * WorldChunkSize, Std.Arrays.Length(First.Cells));
  AssertCellEquals(First.Cells[0], Second.Cells[0]);
  AssertCellEquals(First.Cells[WorldChunkSize * WorldChunkSize - 1], Second.Cells[WorldChunkSize * WorldChunkSize -
                                                                                  1]);
  AssertCellEquals(ChunkCell(First, 127, 64), GenerateWorldCell(Metadata, -1, 64));
  var Initial: GameState := NewGame(Metadata);
  AssertEquals(Metadata.Spawn.X, RequireOutdoor(Initial).X);
  AssertEquals(Metadata.Spawn.Y, RequireOutdoor(Initial).Y);
  AssertEquals(Metadata.OutdoorAreaId, Initial.AreaId);
  AssertTrue(Initial.Area = AreaKind.OutdoorRegion);
  AssertTrue(IsOk(ValidateGameState(Metadata, Initial)));
  AssertTrue(IsError(ActivateAreaTransition(Metadata, Initial)));
  var Moved: GameState := Unwrap(MovePlayer(Initial, 1, 0, GenerateWorldCell(Metadata, Metadata.Spawn.X +
                                                                                       1, Metadata.Spawn.Y)));
  AssertEquals(Metadata.Spawn.X + 1, RequireOutdoor(Moved).X);
  AssertEquals(Metadata.Spawn.Y, RequireOutdoor(Moved).Y);
  AssertEquals(Metadata.Spawn.X, RequireOutdoor(Initial).X);
  AssertTrue(IsError(MovePlayer(Initial, 1, 1, Origin)));
  AssertTrue(IsError(MovePlayer(Initial, 1, 0, record
    Base := BaseTerrainKind.Water;
    Feature := TerrainFeatureKind.NoFeature;
    Water := WaterKind.Sea;
  end)));
  mutable var AtEntrance: GameState := Initial;
  AtEntrance.Player := PlayerPosition.Outdoor(Metadata.Entrance);
  var Entered: GameState := Unwrap(ActivateAreaTransition(Metadata, AtEntrance));
  AssertTrue(Entered.Area = AreaKind.Dungeon);
  AssertEquals(Metadata.DungeonAreaId, Entered.AreaId);
  var DungeonMap: InteriorMap := Unwrap(InitialDungeonMap());
  AssertEquals(DungeonMap.Start.X, RequireFirstPerson(Entered).Position.X);
  AssertEquals(DungeonMap.Start.Y, RequireFirstPerson(Entered).Position.Y);
  AssertTrue(DungeonMap.StartFacing = RequireFirstPerson(Entered).Facing);
  case Entered.ReturnLocation of
    ReturnLocation.ReturnTo(AreaId, Position):
    begin
      AssertEquals(Metadata.OutdoorAreaId, AreaId);
      AssertEquals(Metadata.Entrance.X, Position.X);
      AssertEquals(Metadata.Entrance.Y, Position.Y)
    end
    else
    begin
      panic('expected exact return location')
    end
  end;

  AssertTrue(IsOk(ValidateGameState(Metadata, Entered)));
  AssertTrue(IsError(MovePlayer(Entered, 1, 0, Origin)));
  AssertTrue(IsError(ActivateAreaTransition(Metadata, Entered)));
  mutable var AtExit: GameState := Entered;
  AtExit.Player := PlayerPosition.FirstPerson(record
    Position := DungeonMap.Exit;
    Facing := FacingDirection.West;
  end);
  var Left: GameState := Unwrap(ActivateAreaTransition(Metadata, AtExit));
  AssertTrue(Left.Area = AreaKind.OutdoorRegion);
  AssertEquals(Metadata.OutdoorAreaId, Left.AreaId);
  AssertEquals(Metadata.Entrance.X, RequireOutdoor(Left).X);
  AssertEquals(Metadata.Entrance.Y, RequireOutdoor(Left).Y);
  case Left.ReturnLocation of
    ReturnLocation.NoReturnLocation:
    begin
    end
    else
    begin
      panic('return location must be cleared on exit')
    end
  end;
  mutable var InvalidOutdoor: GameState := Initial;
  InvalidOutdoor.ReturnLocation := ReturnLocation.ReturnTo(Metadata.OutdoorAreaId, RequireOutdoor(Initial));
  AssertTrue(IsError(ValidateGameState(Metadata, InvalidOutdoor)));
  mutable var InvalidDungeon: GameState := Entered;
  InvalidDungeon.ReturnLocation := ReturnLocation.NoReturnLocation;
  AssertTrue(IsError(ValidateGameState(Metadata, InvalidDungeon)));
  AssertTrue(IsError(ActivateAreaTransition(Metadata, InvalidDungeon)));
  mutable var WrongReturnCoordinate: GameState := Entered;
  WrongReturnCoordinate.ReturnLocation := ReturnLocation.ReturnTo(Metadata.OutdoorAreaId, Metadata.Spawn);
  AssertTrue(IsError(ValidateGameState(Metadata, WrongReturnCoordinate)));
  mutable var MovedDungeonCoordinate: GameState := Entered;
  MovedDungeonCoordinate.Player := PlayerPosition.FirstPerson(record
    Position := record
      X := -1;
      Y := 0;
    end;
    Facing := FacingDirection.North;
  end);
  AssertTrue(IsError(ValidateGameState(Metadata, MovedDungeonCoordinate)))
end.
