// Covers generator 8 levels: per-level content formulas, stairs placement, depths 1 through 5,
// acceptance below level 0 over a region block, level-0 geometry stability, and pinned deep levels.
program DungeonLevelGenerationTest;

uses Dungeon.Coordinates as Coordinates, Dungeon.Hostiles as HostileRules, Dungeon.Interior as InteriorUnit, Dungeon.Interior.Generation as Generation, Dungeon.Interior.Generation.Content as Content, Dungeon.Interior.Generation.Levels as Levels, Dungeon.Interior.Generation.Validation as Validation, Dungeon.Items as ItemRules, Std.Conv as Conv, Std.Test as Test;

function AreaId(RegionX: integer; RegionY: integer; Level: integer): string;
begin
  return (((('gen:dungeon:' + Conv.IntToStr(RegionX)) + ':') + Conv.IntToStr(RegionY)) + ':') +
    Conv.IntToStr(Level);
end function;

function Generated(Seed: integer; RegionX: integer; RegionY: integer; Level: integer; Depth: integer): InteriorUnit.InteriorMap;
begin
  return Generation.GenerateDungeon(
    Seed,
    RegionX,
    RegionY,
    Level,
    Depth,
    AreaId(RegionX, RegionY, Level)
  ).Unwrap();
end function;

function CountCells(Map: InteriorUnit.InteriorMap; Kind: InteriorUnit.InteriorCellKind): integer;
begin
  var Count := 0;
  for Cell: InteriorUnit.InteriorCellKind in Map.Cells do
    if Cell = Kind then
      Count := Count + 1;
    end if;
  end for;

  return Count;
end function;

function SkeletonCount(Kinds: array of HostileRules.HostileKind): integer;
begin
  var Count := 0;
  for Kind: HostileRules.HostileKind in Kinds do
    if Kind = HostileRules.HostileKind.RestlessSkeleton then
      Count := Count + 1;
    end if;
  end for;

  return Count;
end function;

// Renders rows, endpoints and placements so any generated difference changes the text.
function MapText(Map: InteriorUnit.InteriorMap): string;
begin
  var Text: string := Map.DisplayName + ' ';
  for Y: integer := 0 to Map.Height - 1 do
    for X: integer := 0 to Map.Width - 1 do
      Text := Text + InteriorUnit.InteriorCellCode(Map.Cells[(Y * Map.Width) + X]);
    end for;

    Text := Text + '/';
  end for;

  Text := Text + 'start=' + Conv.IntToStr(Map.Start.X) + ',' + Conv.IntToStr(Map.Start.Y);
  for Hostile: HostileRules.HostilePlacement in Map.Hostiles do
    Text := Text + ' ' + Hostile.Id + '=' + HostileRules.HostileDisplayName(Hostile.Kind) + '@' +
      Conv.IntToStr(Hostile.Position.X) + ',' + Conv.IntToStr(Hostile.Position.Y);
  end for;

  for Item: ItemRules.ItemPlacement in Map.Items do
    Text := Text + ' ' + Item.ItemId + '=' + ItemRules.ItemDisplayName(Item.Kind) + '@' +
      Conv.IntToStr(Item.Position.X) + ',' + Conv.IntToStr(Item.Position.Y);
  end for;

  return Text;
end function;

function HostilesText(Map: InteriorUnit.InteriorMap): string;
begin
  var Text := '';
  for Hostile: HostileRules.HostilePlacement in Map.Hostiles do
    Text := Text + Hostile.Id + '@' + Conv.IntToStr(Hostile.Position.X) + ',' +
      Conv.IntToStr(Hostile.Position.Y) + ' ';
  end for;

  return Text;
end function;

procedure ContentFormulas();
begin
  for Level: integer := 0 to InteriorUnit.MaxDungeonDepth - 1 do
    const Kinds := Levels.LevelHostileKinds(Level);
    var Expected := 2 + ((Level + 1) div 2);
    if Expected > Levels.MaximumLevelHostiles then
      Expected := Levels.MaximumLevelHostiles;
    end if;

    Test.AssertEquals(Expected, Kinds.Length());
    var Skeletons := 1 + (Level div 2);
    if Skeletons > Expected - 1 then
      Skeletons := Expected - 1;
    end if;

    Test.AssertEquals(Skeletons, SkeletonCount(Kinds));
    // Skeletons first, then rats; at least one rat.
    for Index: integer := 0 to Kinds.Length() - 1 do
      Test.AssertTrue(
        (Kinds[Index] = HostileRules.HostileKind.RestlessSkeleton) = (Index < Skeletons)
      );
    end for;

    Test.AssertTrue(Kinds[Kinds.Length() - 1] = HostileRules.HostileKind.GiantRat);
  end for;

  // The current depth-3 tables.
  Test.AssertEquals(1, SkeletonCount(Levels.LevelHostileKinds(0)));
  Test.AssertEquals(2, Levels.LevelHostileKinds(0).Length());
  Test.AssertEquals(1, SkeletonCount(Levels.LevelHostileKinds(1)));
  Test.AssertEquals(3, Levels.LevelHostileKinds(1).Length());
  Test.AssertEquals(2, SkeletonCount(Levels.LevelHostileKinds(2)));
  Test.AssertEquals(3, Levels.LevelHostileKinds(2).Length());
  // Items: four required on level 0, one potion deeper; optional slots follow.
  Test.AssertEquals(4, Levels.RequiredItemKinds(0).Length());
  Test.AssertEquals(1, Levels.RequiredItemKinds(1).Length());
  Test.AssertTrue(Levels.RequiredItemKinds(2)[0] = ItemRules.ItemKind.HealingPotion);
  Test.AssertEquals(4, Levels.OptionalItemSlots(0)[0]);
  Test.AssertEquals(1, Levels.OptionalItemSlots(1)[0]);
  Test.AssertEquals(2, Levels.OptionalItemSlots(2)[1]);
  Test.AssertEquals(3, Levels.DungeonDepth(12345, 0, 0));
  Test.AssertEquals(3, Levels.DungeonDepth(-1, -500, 77));
  // Deep loot accepts only slots 1/2 below level 0 and is a pure function of its inputs.
  Test.AssertTrue(Content.DeepOptionalLoot(12345, 0, 0, 0, 1) is Error(_));
  Test.AssertTrue(Content.DeepOptionalLoot(12345, 0, 0, 1, 3) is Error(_));
  Test.AssertTrue(Content.DeepOptionalLoot(12345, 0, 0, 1, 0) is Error(_));
  Test.AssertTrue(
    Content.DeepOptionalLoot(12345, 4, -2, 2, 1).Unwrap() =
    Content.DeepOptionalLoot(12345, 4, -2, 2, 1).Unwrap()
  );
end procedure;

procedure ArgumentBounds();
begin
  Test.AssertTrue(Generation.GenerateDungeon(12345, 0, 0, 3, 3, AreaId(0, 0, 3)) is Error(_));
  Test.AssertTrue(Generation.GenerateDungeon(12345, 0, 0, -1, 3, AreaId(0, 0, 0)) is Error(_));
  Test.AssertTrue(Generation.GenerateDungeon(12345, 0, 0, 0, 0, AreaId(0, 0, 0)) is Error(_));
  Test.AssertTrue(Generation.GenerateDungeon(12345, 0, 0, 0, 17, AreaId(0, 0, 0)) is Error(_));
end procedure;

// Level 0 keeps the single-level geometry; a deeper dungeon only adds its stairs down.
procedure LevelZeroStability();
begin
  for RegionX: integer := -3 to 3 do
    const Single := Generated(12345, RegionX, 1, 0, 1);
    const Deep := Generated(12345, RegionX, 1, 0, 3);
    Test.AssertEquals(0, CountCells(Single, InteriorUnit.InteriorCellKind.StairsDown));
    Test.AssertEquals(1, CountCells(Deep, InteriorUnit.InteriorCellKind.StairsDown));
    var Differences := 0;
    for Index: integer := 0 to Single.Cells.Length() - 1 do
      if Single.Cells[Index] <> Deep.Cells[Index] then
        Differences := Differences + 1;
        Test.AssertTrue(Deep.Cells[Index] = InteriorUnit.InteriorCellKind.StairsDown);
      end if;
    end for;

    Test.AssertEquals(1, Differences);
    Test.AssertEquals(HostilesText(Single), HostilesText(Deep));
  end for;
end procedure;

// Checks endpoints, stairs, landing and per-level content of one accepted level.
procedure AssertLevel(Map: InteriorUnit.InteriorMap; Level: integer; Depth: integer);
begin
  Test.AssertTrue(Validation.ValidateGeneratedDungeon(Map) is Ok(_));
  Test.AssertEquals(Level, Map.Level);
  Test.AssertEquals(Depth, Map.Depth);
  Test.AssertTrue(
    InteriorUnit.InteriorCellAt(Map, Map.Arrival).Unwrap() = InteriorUnit.ArrivalCellKind(Level)
  );
  Test.AssertEquals(Map.Arrival.X + 1, Map.Start.X);
  var Exits := 0;
  if Level = 0 then
    Exits := 1;
  end if;

  Test.AssertEquals(Exits, CountCells(Map, InteriorUnit.InteriorCellKind.ExitField));
  Test.AssertEquals(1 - Exits, CountCells(Map, InteriorUnit.InteriorCellKind.StairsUp));
  if Level < Depth - 1 then
    Test.AssertEquals(1, CountCells(Map, InteriorUnit.InteriorCellKind.StairsDown));
    const Landing := InteriorUnit.DescentLanding(Map).Unwrap();
    Test.AssertTrue(
      InteriorUnit.InteriorCellAt(Map, Landing.Position).Unwrap() =
      InteriorUnit.InteriorCellKind.Floor
    );
  else
    Test.AssertEquals(0, CountCells(Map, InteriorUnit.InteriorCellKind.StairsDown));
  end if;
  const Kinds := Levels.LevelHostileKinds(Level);
  Test.AssertEquals(Kinds.Length(), Map.Hostiles.Length());
  for Index: integer := 0 to Kinds.Length() - 1 do
    Test.AssertTrue(Map.Hostiles[Index].Kind = Kinds[Index]);
  end for;
  const Required := Levels.RequiredItemKinds(Level);
  Test.AssertTrue(Map.Items.Length() >= Required.Length());
  Test.AssertTrue(Map.Items.Length() <= Required.Length() + 2);
  for Index: integer := 0 to Required.Length() - 1 do
    Test.AssertTrue(Map.Items[Index].Kind = Required[Index]);
  end for;
end procedure;

procedure DepthsOneThroughFive();
begin
  AssertLevel(Generated(12345, 2, -3, 0, 1), 0, 1);
  for Depth: integer in [2, 3, 5] do
    for Level: integer := 0 to Depth - 1 do
      AssertLevel(Generated(12345, 2, -3, Level, Depth), Level, Depth);
    end for;
  end for;

  // A level depends on level and region but not on depth, except for its stairs down.
  Test.AssertEquals(
    HostilesText(Generated(12345, 2, -3, 2, 3)),
    HostilesText(Generated(12345, 2, -3, 2, 5))
  );
  Test.AssertTrue(MapText(Generated(12345, 2, -3, 1, 3)) <> MapText(Generated(12345, 2, -3, 2, 3)));
  Test.AssertEquals(MapText(Generated(12345, 2, -3, 2, 3)), MapText(Generated(12345, 2, -3, 2, 3)));
end procedure;

// Every region of a 20 by 20 block yields accepted deeper levels for three seeds.
procedure DeepLevelsAccepted();
begin
  for Seed: integer in [12345, -987654321, 9223372036854775807] do
    for RegionY: integer := -10 to 9 do
      for RegionX: integer := -10 to 9 do
        for Level: integer := 1 to 2 do
          AssertLevel(Generated(Seed, RegionX, RegionY, Level, 3), Level, 3);
        end for;
      end for;
    end for;
  end for;
end procedure;

begin
  ContentFormulas();
  ArgumentBounds();
  LevelZeroStability();
  DepthsOneThroughFive();
  DeepLevelsAccepted();
  // Generator 8 output of deeper levels, pinned deliberately with the version bump.
  Test.AssertEquals(
    'Sunken Vault ###############################/#################....##########/###<.....########....##########/###..........................##/###......#######.....#######.##/################.###########.##/################.###########.##/################.##########...#/#####>.....#####.##########...#/#####......#####.##########...#/#####......#####.##########...#/#####......#####.##############/########.#######.##############/########.#######.##############/########.######...#############/########.######...#############/####..............######.....##/####.........................##/####.......####...######.....##/####.......####################/###############################/start=4,2 gen:dungeon:0:0:1:hostile:0=Restless skeleton@8,10 gen:dungeon:0:0:1:hostile:1=Giant rat@26,17 gen:dungeon:0:0:1:hostile:2=Giant rat@7,18 gen:dungeon:0:0:1:item:0=Healing potion@27,7 gen:dungeon:0:0:1:item:1=Healing potion@29,7',
    MapText(Generated(12345, 0, 0, 1, 3))
  );
  Test.AssertEquals(
    'Sunken Vault ###############################/##############.......##########/#....#########.......####....##/#....................####....##/#....######..................##/#....######.#####.#######....##/#....######.#####.#########.###/###.#######.#####.#########.###/###.#######.#####.#########.###/###.#######.#####.#########.###/###.####.....#....#########.###/###.####.....#....<..######.###/###.####.........#............#/###.####.....#####...##.......#/###...........................#/###########.###########.......#/########......#################/########......#################/########......#################/########......#################/###############################/start=19,11 gen:dungeon:0:0:2:hostile:0=Restless skeleton@3,4 gen:dungeon:0:0:2:hostile:1=Restless skeleton@27,4 gen:dungeon:0:0:2:hostile:2=Giant rat@11,18 gen:dungeon:0:0:2:item:0=Healing potion@23,12 gen:dungeon:0:0:2:item:1=Ancient coin@29,12',
    MapText(Generated(12345, 0, 0, 2, 3))
  );
  Test.AssertEquals(
    'Forgotten Crypt ###############################/###############################/###############################/##########....#####...#########/##########....#####...#########/#######..........##...#########/#######.##....##.###.##########/######...#....##.###.###>.....#/######........................#/######...###..................#/#######.#######.......#.......#/#######.#######...............#/#######.#######.......#.#######/#######.########.###.##.#######/#######.######.....#.##.#######/#######.######.....#.......####/####<..............#.......####/####......####.....#.......####/####.......................####/####......##########.......####/###############################/start=5,16 gen:dungeon:3:-9:1:hostile:0=Restless skeleton@27,9 gen:dungeon:3:-9:1:hostile:1=Giant rat@20,4 gen:dungeon:3:-9:1:hostile:2=Giant rat@23,17 gen:dungeon:3:-9:1:item:0=Healing potion@6,7 gen:dungeon:3:-9:1:item:1=Rusty short sword@8,7 gen:dungeon:3:-9:1:item:2=Ancient coin@6,9',
    MapText(Generated(-987654321, 3, -9, 1, 3))
  );
  Test.AssertEquals(
    'Forgotten Crypt ###############################/###############################/###############################/#####################.......###/#...#######....######.......###/#...........................###/#...#######....######.......###/##.#########.###########.#.####/##.#########.###.......#.#.####/#<.....................#.#.####/#....#######.###.......#.#.####/#....#######.#####.#####.#.####/#....#####.....###.#####.#.####/##.#######.....#.....###.#.####/##.#######.....#.....###....###/##...................###....###/##########.....#.....###....###/#########################...###/###############################/###############################/###############################/start=2,9 gen:dungeon:3:-9:2:hostile:0=Restless skeleton@26,16 gen:dungeon:3:-9:2:hostile:1=Restless skeleton@24,5 gen:dungeon:3:-9:2:hostile:2=Giant rat@18,15 gen:dungeon:3:-9:2:item:0=Healing potion@16,8 gen:dungeon:3:-9:2:item:1=Healing potion@22,8',
    MapText(Generated(-987654321, 3, -9, 2, 3))
  );
end.
