// Reproduces missing corridor wall faces at the screenshot positions before and after a step.
program InteriorWallVisibilityTest;

uses Dungeon.Coordinates as Coordinates, Dungeon.Exploration.Sight as Sight, Dungeon.Interior as InteriorUnit, Dungeon.Test.Fixtures as Fixtures, Std.Test as Test;

begin
  const Map: InteriorUnit.InteriorMap := Fixtures.FixtureDungeonMap();
  for X: integer in [1, 2] do
    begin
      const Pose: Coordinates.FirstPersonPose := Coordinates.FirstPersonPose(
        Position := Coordinates.InteriorPosition(X := X, Y := 5),
        Facing := Coordinates.FacingDirection.East
      );
      const Visible: array of boolean := Sight.InteriorVisibility(Map, Pose);
      // The south wall face at (3,6) borders the open corridor. Its center is
      // hidden by the preceding wall cell, but its north face is plainly visible.
      Test.AssertTrue(Visible[6 * Map.Width + 3]);
      Test.AssertTrue(Visible[5 * Map.Width + 4]);
      // A wall face being visible must not reveal the room behind that wall.
      Test.AssertFalse(Visible[5 * Map.Width + 5]);
    end;
  end for;

  // The same exposed-face rule applies along all four boundary corridors.
  for Direction: integer := 0 to 3 do
    begin
      var Pose: Coordinates.FirstPersonPose := Coordinates.FirstPersonPose(
        Position := Coordinates.InteriorPosition(X := 1, Y := 1),
        Facing := Coordinates.FacingDirection.East
      );
      var WallX: integer := 3;
      var WallY: integer := 0;
      if Direction = 1 then
        begin
          Pose.Position := Coordinates.InteriorPosition(X := 9, Y := 7);
          Pose.Facing := Coordinates.FacingDirection.West;
          WallX := 7;
          WallY := 8;
        end;
      end if;

      if Direction = 2 then
        begin
          Pose.Position := Coordinates.InteriorPosition(X := 1, Y := 7);
          Pose.Facing := Coordinates.FacingDirection.North;
          WallX := 0;
          WallY := 5;
        end;
      end if;

      if Direction = 3 then
        begin
          Pose.Position := Coordinates.InteriorPosition(X := 9, Y := 1);
          Pose.Facing := Coordinates.FacingDirection.South;
          WallX := 10;
          WallY := 3;
        end;
      end if;
      const Visible: array of boolean := Sight.InteriorVisibility(Map, Pose);
      Test.AssertTrue(Visible[WallY * Map.Width + WallX]);
    end;
  end for;
end.
