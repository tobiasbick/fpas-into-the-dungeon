// Reproduces missing corridor wall faces at the screenshot positions before and after a step.
program InteriorWallVisibilityTest;

uses
  Dungeon.Coordinates, Dungeon.Exploration.Sight, Dungeon.Interior, Dungeon.Test.Fixtures, Std.Test;

begin
  const Map: InteriorMap := FixtureDungeonMap();
  for X: integer in [1, 2] do
    begin
      const Pose: FirstPersonPose := FirstPersonPose(Position := InteriorPosition(X := X, Y := 5), Facing := FacingDirection.East);
      const Visible: array of boolean := InteriorVisibility(Map, Pose);
      // The south wall face at (3,6) borders the open corridor. Its center is
      // hidden by the preceding wall cell, but its north face is plainly visible.
      AssertTrue(Visible[6 * Map.Width + 3]);
      AssertTrue(Visible[5 * Map.Width + 4]);
      // A wall face being visible must not reveal the room behind that wall.
      AssertFalse(Visible[5 * Map.Width + 5]);
    end;
  end for;

  // The same exposed-face rule applies along all four boundary corridors.
  for Direction: integer := 0 to 3 do
    begin
      var Pose: FirstPersonPose := FirstPersonPose(Position := InteriorPosition(X := 1, Y := 1), Facing := FacingDirection.East);
      var WallX: integer := 3;
      var WallY: integer := 0;
      if Direction = 1 then
        begin
          Pose.Position := InteriorPosition(X := 9, Y := 7);
          Pose.Facing := FacingDirection.West;
          WallX := 7;
          WallY := 8;
        end;
      end if;

      if Direction = 2 then
        begin
          Pose.Position := InteriorPosition(X := 1, Y := 7);
          Pose.Facing := FacingDirection.North;
          WallX := 0;
          WallY := 5;
        end;
      end if;

      if Direction = 3 then
        begin
          Pose.Position := InteriorPosition(X := 9, Y := 1);
          Pose.Facing := FacingDirection.South;
          WallX := 10;
          WallY := 3;
        end;
      end if;
      const Visible: array of boolean := InteriorVisibility(Map, Pose);
      AssertTrue(Visible[WallY * Map.Width + WallX]);
    end;
  end for;
end.
