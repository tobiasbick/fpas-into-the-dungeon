// Verifies the inventory capacity, rejected pickups at capacity, and dropping carried items.
program ItemDropTest;

uses
  Dungeon.Combat, Dungeon.Coordinates, Dungeon.Equipment, Dungeon.GameState, Dungeon.Hostiles,
  Dungeon.Interaction, Dungeon.Interior, Dungeon.Items, Dungeon.Terrain, Dungeon.Test.Fixtures,
  Std.Arrays, Std.Conv, Std.Results, Std.Str, Std.Test;

// Replaces the location of one item without any rule check.
function Located(State: GameState; ItemId: string; Location: ItemLocation): GameState;
begin
  mutable var Items: array of GameItem := State.Items;
  for Index: integer := 0 to Std.Arrays.Length(Items) - 1 do
  begin
    if Items[Index].Id = ItemId then
    begin
      Items[Index] := Items[Index] with Location := Location; end
    end
  end;

  return State with Items := Items; end
end;

// Adds carried coins that belong to no placement; per-intention rules do not check placements.
function Extras(State: GameState; Count: integer): GameState;
begin
  mutable var Items: array of GameItem := State.Items;
  for Index: integer := 1 to Count do
  begin
    Std.Arrays.Push(Items, record
      Id := 'extra:' + IntToStr(Index);
      Kind := ItemKind.AncientCoin;
      Location := ItemLocation.CarriedByPlayer;
    end)
  end;

  return State with Items := Items; end
end;

function Continued(Outcome: TurnOutcome): GameState;
begin
  case Outcome of
    TurnOutcome.Continued(State, Log, Events):
    begin
      return State
    end;
    TurnOutcome.Defeated(Log):
    begin
      panic('expected the game to continue')
    end
  end
end;

function EventCount(Outcome: TurnOutcome): integer;
begin
  case Outcome of
    TurnOutcome.Continued(State, Log, Events):
    begin
      return Std.Arrays.Length(Events)
    end;
    TurnOutcome.Defeated(Log):
    begin
      return -1
    end
  end
end;

function LogContains(Outcome: TurnOutcome; Text: string): boolean;
begin
  case Outcome of
    TurnOutcome.Continued(State, Log, Events):
    begin
      for Entry: string in Log do
      begin
        if Entry = Text then
        begin
          return true
        end
      end
    end
    else
    begin
    end
  end;

  return false
end;

// Summarizes what a turn did to the player and the dice, so two actions can be compared.
function Summary(Outcome: TurnOutcome): string;
begin
  case Outcome of
    TurnOutcome.Continued(State, Log, Events):
    begin
      return (((('continued ' + IntToStr(State.Health)) + ' ') + IntToStr(State.RandomState)) + ' ') +
             IntToStr(Std.Arrays.Length(Events))
    end;
    TurnOutcome.Defeated(Log):
    begin
      return 'defeated ' + IntToStr(Std.Arrays.Length(Log))
    end
  end
end;

function Turn(State: GameState; Action: TurnAction): result of TurnOutcome, string;
begin
  return ResolveTurn(FixtureAreaView(State), State, Action)
end;

begin
  var Map: InteriorMap := FixtureDungeonMap();
  var CoinId: string := Map.Items[0].ItemId;
  var SwordId: string := Map.Items[1].ItemId;
  AssertEquals(64, MaximumInventoryItems);
  // Pickup fills the last free place and is rejected at capacity without changing anything.
  var OnCoin: GameState := FixtureDungeonState(Map.Items[0].Position, FacingDirection.North);
  var Nearly: GameState := Extras(OnCoin, 63);
  AssertFalse(InventoryIsFull(Nearly));
  AssertTrue(Std.Str.Contains(ItemInteractionHint(Nearly), 'Pick up'));
  case Unwrap(Interact(FixtureAreaView(Nearly), Nearly)) of
    InteractionOutcome.StateChanged(Picked):
    begin
      AssertEquals(64, Std.Arrays.Length(InventoryItems(Picked)));
      AssertTrue(InventoryIsFull(Picked))
    end
    else
    begin
      panic('expected the pickup to change the state')
    end
  end;
  var Full: GameState := Extras(OnCoin, 64);
  AssertTrue(InventoryIsFull(Full));
  AssertTrue(Std.Str.Contains(ItemInteractionHint(Full), 'inventory full'));
  AssertTrue(IsOk(ValidateGameState(FixtureAreaView(Full), Full)));
  AssertTrue(IsError(Interact(FixtureAreaView(Full), Full)));
  AssertTrue(IsError(ValidateGameState(FixtureAreaView(OnCoin), Extras(OnCoin, 65))));
  // Worn items count toward the same capacity.
  var WornFull: GameState := Located(Extras(OnCoin, 63), SwordId, ItemLocation.EquippedByPlayer(EquipmentSlot.Weapon));
  AssertTrue(InventoryIsFull(WornFull));
  AssertTrue(IsError(Interact(FixtureAreaView(WornFull), WornFull)));
  // Dropping lays a carried item on the occupied field, takes a turn, and can be undone by pickup.
  var AtStart: GameState := FixtureDungeonState(Map.Start, Map.StartFacing);
  var Holding: GameState := Located(AtStart, CoinId, ItemLocation.CarriedByPlayer);
  var Dropping: TurnOutcome := Unwrap(Turn(Holding, TurnAction.Drop(CoinId)));
  AssertTrue(LogContains(Dropping, 'You drop the ancient coin.'));
  var Dropped: GameState := Continued(Dropping);
  AssertEquals(0, Std.Arrays.Length(InventoryItems(Dropped)));
  case Dropped.Items[0].Location of
    ItemLocation.InInterior(AreaId, Position):
    begin
      AssertEquals(Map.AreaId, AreaId);
      AssertEquals(Map.Start.X, Position.X);
      AssertEquals(Map.Start.Y, Position.Y)
    end
    else
    begin
      panic('expected the dropped item on the floor')
    end
  end;

  AssertTrue(Std.Str.Contains(ItemInteractionHint(Dropped), 'Pick up'));
  case Unwrap(Interact(FixtureAreaView(Dropped), Dropped)) of
    InteractionOutcome.StateChanged(Again):
    begin
      AssertEquals(1, Std.Arrays.Length(InventoryItems(Again)))
    end
    else
    begin
      panic('expected the dropped item to be picked up again')
    end
  end;
  // Dropping frees exactly one place at capacity.
  var Packed: GameState := Extras(Holding, 63);
  AssertTrue(InventoryIsFull(Packed));
  var Relieved: GameState := Continued(Unwrap(Turn(Packed, TurnAction.Drop(CoinId))));
  AssertFalse(InventoryIsFull(Relieved));
  AssertEquals(63, Std.Arrays.Length(InventoryItems(Relieved)));
  // Rejected drops change nothing: unknown, worn, lying, outdoors, on the exit, and onto another item.
  AssertTrue(IsError(Turn(Holding, TurnAction.Drop('unknown-item'))));
  var Wearing: GameState := Located(AtStart, SwordId, ItemLocation.EquippedByPlayer(EquipmentSlot.Weapon));
  AssertTrue(IsError(Turn(Wearing, TurnAction.Drop(SwordId))));
  AssertTrue(IsError(Turn(AtStart, TurnAction.Drop(CoinId))));
  var Metadata: WorldMetadata := FixtureMetadata();
  var Outdoors: GameState := Holding with Area := AreaKind.OutdoorRegion; AreaId := Metadata.OutdoorAreaId; Player := PlayerPosition.Outdoor(Metadata.Spawn); ReturnLocation := ReturnLocation.NoReturnLocation; end;

  AssertTrue(IsError(Turn(Outdoors, TurnAction.Drop(CoinId))));
  var OnExit: GameState := Located(FixtureDungeonState(Map.Exit, FacingDirection.East), CoinId, ItemLocation.CarriedByPlayer);
  AssertTrue(IsError(Turn(OnExit, TurnAction.Drop(CoinId))));
  var OnOtherItem: GameState := Located(OnCoin, SwordId, ItemLocation.CarriedByPlayer);
  AssertTrue(IsError(Turn(OnOtherItem, TurnAction.Drop(SwordId))));
  // A floor item on the exit is invalid state.
  AssertTrue(IsError(ValidateGameState(FixtureAreaView(OnExit), Located(OnExit, CoinId, ItemLocation.InInterior(Map.AreaId, Map.Exit)))));
  // A drop consumes the same turn as waiting: the adjacent opponent acts identically, and defeat ends the game.
  var Beside: GameState := Holding with Player := PlayerPosition.FirstPerson(record
    Position := record
      X := 3;
      Y := 4;
    end;
    Facing := FacingDirection.North;
  end); Hostiles := [Holding.Hostiles[0] with Alerted := true; end]; end;

  AssertTrue(EventCount(Unwrap(Turn(Beside, TurnAction.Drop(CoinId)))) > 0);
  AssertEquals(Summary(Unwrap(Turn(Beside, TurnAction.Wait))), Summary(Unwrap(Turn(Beside, TurnAction.Drop(CoinId)))));
  mutable var Defeats: integer := 0;
  for Seed: integer := 1 to 40 do
  begin
    var Fragile: GameState := Beside with Health := 1; RandomState := Seed; end;
    var DropResult: TurnOutcome := Unwrap(Turn(Fragile, TurnAction.Drop(CoinId)));
    AssertEquals(Summary(Unwrap(Turn(Fragile, TurnAction.Wait))), Summary(DropResult));
    if EventCount(DropResult) < 0 then
    begin
      Defeats := Defeats + 1
    end
  end;

  AssertTrue(Defeats > 0)
end.
