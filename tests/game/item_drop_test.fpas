// Verifies the inventory capacity, rejected pickups at capacity, and dropping carried items.
program ItemDropTest;

uses
  Dungeon.Combat, Dungeon.Coordinates, Dungeon.Equipment, Dungeon.GameState, Dungeon.Hostiles,
  Dungeon.Interaction, Dungeon.Interior, Dungeon.Items, Dungeon.Terrain, Dungeon.Test.Fixtures,
  Std.Conv, Std.Test;

// Replaces the location of one item without any rule check.
function Located(State: GameState; ItemId: string; Location: ItemLocation): GameState;
begin
  var Items: array of GameItem := State.Items;
  for Index: integer := 0 to Items.Length() - 1 do
    begin
      if Items[Index].Id = ItemId then
        begin
          Items[Index] := Items[Index] with Location := Location; end with;
        end;
      end if;
    end;
  end for;

  return State with Items := Items; end with;
end function;

// Adds carried coins that belong to no placement; per-intention rules do not check placements.
function Extras(State: GameState; Count: integer): GameState;
begin
  var Items: array of GameItem := State.Items;
  for Index: integer := 1 to Count do
    begin
      Items.Push(GameItem(Id := 'extra:' + IntToStr(Index), Kind := ItemKind.AncientCoin, Location := ItemLocation.CarriedByPlayer));
    end;
  end for;

  return State with Items := Items; end with;
end function;

function Continued(Outcome: TurnOutcome): GameState;
begin
  case Outcome of
    when TurnOutcome.Continued(const State, const Log, const Events):
      begin
        return State;
      end;
    when TurnOutcome.Defeated(const Log):
      begin
        panic('expected the game to continue');
      end;
  end case;
end function;

function EventCount(Outcome: TurnOutcome): integer;
begin
  case Outcome of
    when TurnOutcome.Continued(const State, const Log, const Events):
      begin
        return Events.Length();
      end;
    when TurnOutcome.Defeated(const Log):
      begin
        return -1;
      end;
  end case;
end function;

function LogContains(Outcome: TurnOutcome; Text: string): boolean;
begin
  if Outcome is TurnOutcome.Continued(const State, const Log, const Events) then
    begin
      for Entry: string in Log do
        begin
          if Entry = Text then
            begin
              return true;
            end;
          end if;
        end;
      end for;
    end;
  else
    begin
      null;
    end;
  end if;

  return false;
end function;

// Summarizes what a turn did to the player and the dice, so two actions can be compared.
function Summary(Outcome: TurnOutcome): string;
begin
  case Outcome of
    when TurnOutcome.Continued(const State, const Log, const Events):
      begin
        return (((('continued ' + IntToStr(State.Health)) + ' ') + IntToStr(State.RandomState)) + ' ') +
               IntToStr(Events.Length());
      end;
    when TurnOutcome.Defeated(const Log):
      begin
        return 'defeated ' + IntToStr(Log.Length());
      end;
  end case;
end function;

function Turn(State: GameState; Action: TurnAction): result of (TurnOutcome, string);
begin
  return ResolveTurn(FixtureAreaView(State), State, Action);
end function;

begin
  const Map: InteriorMap := FixtureDungeonMap();
  const CoinId: string := Map.Items[0].ItemId;
  const SwordId: string := Map.Items[1].ItemId;
  AssertEquals(64, MaximumInventoryItems);
  // Pickup fills the last free place and is rejected at capacity without changing anything.
  const OnCoin: GameState := FixtureDungeonState(Map.Items[0].Position, FacingDirection.North);
  const Nearly: GameState := Extras(OnCoin, 63);
  AssertFalse(InventoryIsFull(Nearly));
  AssertTrue(ItemInteractionHint(Nearly).Contains('Pick up'));
  if Interact(FixtureAreaView(Nearly), Nearly).Unwrap() is InteractionOutcome.StateChanged(const Picked) then
    begin
      AssertEquals(64, InventoryItems(Picked).Length());
      AssertTrue(InventoryIsFull(Picked));
    end;
  else
    begin
      panic('expected the pickup to change the state');
    end;
  end if;
  const Full: GameState := Extras(OnCoin, 64);
  AssertTrue(InventoryIsFull(Full));
  AssertTrue(ItemInteractionHint(Full).Contains('inventory full'));
  AssertTrue(ValidateGameState(FixtureAreaView(Full), Full).IsOk());
  AssertTrue(Interact(FixtureAreaView(Full), Full).IsError());
  AssertTrue(ValidateGameState(FixtureAreaView(OnCoin), Extras(OnCoin, 65)).IsError());
  // Worn items count toward the same capacity.
  const WornFull: GameState := Located(Extras(OnCoin, 63), SwordId, ItemLocation.EquippedByPlayer(EquipmentSlot.Weapon));
  AssertTrue(InventoryIsFull(WornFull));
  AssertTrue(Interact(FixtureAreaView(WornFull), WornFull).IsError());
  // Dropping lays a carried item on the occupied field, takes a turn, and can be undone by pickup.
  const AtStart: GameState := FixtureDungeonState(Map.Start, Map.StartFacing);
  const Holding: GameState := Located(AtStart, CoinId, ItemLocation.CarriedByPlayer);
  const Dropping: TurnOutcome := Turn(Holding, TurnAction.Drop(CoinId)).Unwrap();
  AssertTrue(LogContains(Dropping, 'You drop the ancient coin.'));
  const Dropped: GameState := Continued(Dropping);
  AssertEquals(0, InventoryItems(Dropped).Length());
  if Dropped.Items[0].Location is ItemLocation.InInterior(const AreaId, const Position) then
    begin
      AssertEquals(Map.AreaId, AreaId);
      AssertEquals(Map.Start.X, Position.X);
      AssertEquals(Map.Start.Y, Position.Y);
    end;
  else
    begin
      panic('expected the dropped item on the floor');
    end;
  end if;

  AssertTrue(ItemInteractionHint(Dropped).Contains('Pick up'));
  if Interact(FixtureAreaView(Dropped), Dropped).Unwrap() is InteractionOutcome.StateChanged(const Again) then
    begin
      AssertEquals(1, InventoryItems(Again).Length());
    end;
  else
    begin
      panic('expected the dropped item to be picked up again');
    end;
  end if;
  // Dropping frees exactly one place at capacity.
  const Packed: GameState := Extras(Holding, 63);
  AssertTrue(InventoryIsFull(Packed));
  const Relieved: GameState := Continued(Turn(Packed, TurnAction.Drop(CoinId)).Unwrap());
  AssertFalse(InventoryIsFull(Relieved));
  AssertEquals(63, InventoryItems(Relieved).Length());
  // Rejected drops change nothing: unknown, worn, lying, outdoors, on the exit, and onto another item.
  AssertTrue(Turn(Holding, TurnAction.Drop('unknown-item')).IsError());
  const Wearing: GameState := Located(AtStart, SwordId, ItemLocation.EquippedByPlayer(EquipmentSlot.Weapon));
  AssertTrue(Turn(Wearing, TurnAction.Drop(SwordId)).IsError());
  AssertTrue(Turn(AtStart, TurnAction.Drop(CoinId)).IsError());
  const Metadata: WorldMetadata := FixtureMetadata();
  const Outdoors: GameState := Holding with Area := AreaKind.OutdoorRegion; AreaId := Metadata.OutdoorAreaId; Player := PlayerPosition.Outdoor(Metadata.Spawn); ReturnLocation := ReturnLocation.NoReturnLocation; end with;

  AssertTrue(Turn(Outdoors, TurnAction.Drop(CoinId)).IsError());
  const OnExit: GameState := Located(FixtureDungeonState(Map.Exit, FacingDirection.East), CoinId, ItemLocation.CarriedByPlayer);
  AssertTrue(Turn(OnExit, TurnAction.Drop(CoinId)).IsError());
  const OnOtherItem: GameState := Located(OnCoin, SwordId, ItemLocation.CarriedByPlayer);
  AssertTrue(Turn(OnOtherItem, TurnAction.Drop(SwordId)).IsError());
  // A floor item on the exit is invalid state.
  AssertTrue(ValidateGameState(FixtureAreaView(OnExit), Located(OnExit, CoinId, ItemLocation.InInterior(Map.AreaId, Map.Exit)))
               .IsError());
  // A drop consumes the same turn as waiting: the adjacent opponent acts identically, and defeat ends the game.
  const Beside: GameState := Holding with Player := PlayerPosition.FirstPerson(FirstPersonPose(Position := InteriorPosition(X := 3, Y := 4), Facing := FacingDirection.North)); Hostiles := [
                                                                                                                                                                                              Holding.Hostiles[0] with Alerted := true; end with
                                                                                                                                                                                            ]; end with;

  AssertTrue(EventCount(Turn(Beside, TurnAction.Drop(CoinId)).Unwrap()) > 0);
  AssertEquals(Summary(Turn(Beside, TurnAction.Wait).Unwrap()), Summary(Turn(Beside, TurnAction.Drop(CoinId))
                                                                          .Unwrap()));
  var Defeats: integer := 0;
  for Seed: integer := 1 to 40 do
    begin
      const Fragile: GameState := Beside with Health := 1; RandomState := Seed; end with;
      const DropResult: TurnOutcome := Turn(Fragile, TurnAction.Drop(CoinId)).Unwrap();
      AssertEquals(Summary(Turn(Fragile, TurnAction.Wait).Unwrap()), Summary(DropResult));
      if EventCount(DropResult) < 0 then
        begin
          Defeats := Defeats + 1;
        end;
      end if;
    end;
  end for;

  AssertTrue(Defeats > 0);
end.
