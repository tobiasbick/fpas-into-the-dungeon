// Verifies the inventory capacity, rejected pickups at capacity, and dropping carried items.
program ItemDropTest;

uses Dungeon.Combat as Combat, Dungeon.Coordinates as Coordinates, Dungeon.Equipment as Equipment, Dungeon.GameState as GameState, Dungeon.Hostiles as HostileRules, Dungeon.Interaction as Interaction, Dungeon.Interior as InteriorUnit, Dungeon.Items as ItemRules, Dungeon.Terrain as Terrain, Dungeon.Test.Fixtures as Fixtures, Std.Conv as Conv, Std.Test as Test;

// Replaces the location of one item without any rule check.
function Located(State: GameState.GameState; ItemId: string; Location: ItemRules.ItemLocation): GameState.GameState;
begin
  var Items: array of ItemRules.GameItem := State.Items;
  for Index: integer := 0 to Items.Length() - 1 do
    begin
      if Items[Index].Id = ItemId then
        begin
          Items[Index] := Items[Index] with Location := Location; end with;
        end;
      end if;
    end;
  end for;

  return State with Items := Items; end with;
end function;

// Adds carried coins that belong to no placement; per-intention rules do not check placements.
function Extras(State: GameState.GameState; Count: integer): GameState.GameState;
begin
  var Items: array of ItemRules.GameItem := State.Items;
  for Index: integer := 1 to Count do
    begin
      Items.PushInPlace(
        ItemRules.GameItem(
          Id := 'extra:' + Conv.IntToStr(Index),
          Kind := ItemRules.ItemKind.AncientCoin,
          Location := ItemRules.ItemLocation.CarriedByPlayer
        )
      );
    end;
  end for;

  return State with Items := Items; end with;
end function;

function Continued(Outcome: Combat.TurnOutcome): GameState.GameState;
begin
  case Outcome of
    when Combat.TurnOutcome.Continued(const State, const Log, const Events):
      begin
        return State;
      end;
    when Combat.TurnOutcome.Defeated(const Log):
      begin
        panic('expected the game to continue');
      end;
  end case;
end function;

function EventCount(Outcome: Combat.TurnOutcome): integer;
begin
  case Outcome of
    when Combat.TurnOutcome.Continued(const State, const Log, const Events):
      begin
        return Events.Length();
      end;
    when Combat.TurnOutcome.Defeated(const Log):
      begin
        return -1;
      end;
  end case;
end function;

function LogContains(Outcome: Combat.TurnOutcome; Text: string): boolean;
begin
  case Outcome of
    when Combat.TurnOutcome.Continued(const State, const Log, const Events):
      for Entry: string in Log do
        begin
          if Entry = Text then
            begin
              return true;
            end;
          end if;
        end;
      end for;
    when Combat.TurnOutcome.Defeated(_):
      null;
  end case;

  return false;
end function;

// Summarizes what a turn did to the player and the dice, so two actions can be compared.
function Summary(Outcome: Combat.TurnOutcome): string;
begin
  case Outcome of
    when Combat.TurnOutcome.Continued(const State, const Log, const Events):
      begin
        return (
          ((('continued ' + Conv.IntToStr(State.Health)) + ' ') + Conv.IntToStr(State.RandomState)) +
          ' '
        ) +
          Conv.IntToStr(Events.Length());
      end;
    when Combat.TurnOutcome.Defeated(const Log):
      begin
        return 'defeated ' + Conv.IntToStr(Log.Length());
      end;
  end case;
end function;

function Turn(State: GameState.GameState; Action: Combat.TurnAction): result of (Combat.TurnOutcome, string);
begin
  return Combat.ResolveTurn(Fixtures.FixtureAreaView(State), State, Action);
end function;

begin
  const Map: InteriorUnit.InteriorMap := Fixtures.FixtureDungeonMap();
  const CoinId: string := Map.Items[0].ItemId;
  const SwordId: string := Map.Items[1].ItemId;
  Test.AssertEquals(64, GameState.MaximumInventoryItems);
  // Pickup fills the last free place and is rejected at capacity without changing anything.
  const OnCoin: GameState.GameState := Fixtures.FixtureDungeonState(
    Map.Items[0].Position,
    Coordinates.FacingDirection.North
  );
  const Nearly: GameState.GameState := Extras(OnCoin, 63);
  Test.AssertFalse(GameState.InventoryIsFull(Nearly));
  Test.AssertTrue('Pick up' in Interaction.ItemInteractionHint(Nearly));
  case Interaction.Interact(Fixtures.FixtureAreaView(Nearly), Nearly).Unwrap() of
    when Interaction.InteractionOutcome.StateChanged(const Picked):
      Test.AssertEquals(64, GameState.InventoryItems(Picked).Length());
      Test.AssertTrue(GameState.InventoryIsFull(Picked));
    when Interaction.InteractionOutcome.TransitionRequested(_), Interaction.InteractionOutcome.Described(_, _):
      panic('expected the pickup to change the state');
  end case;
  const Full: GameState.GameState := Extras(OnCoin, 64);
  Test.AssertTrue(GameState.InventoryIsFull(Full));
  Test.AssertTrue('inventory full' in Interaction.ItemInteractionHint(Full));
  Test.AssertTrue(GameState.ValidateGameState(Fixtures.FixtureAreaView(Full), Full) is Ok(_));
  Test.AssertTrue(Interaction.Interact(Fixtures.FixtureAreaView(Full), Full) is Error(_));
  Test.AssertTrue(
    (GameState.ValidateGameState(Fixtures.FixtureAreaView(OnCoin), Extras(OnCoin, 65)) is Error(_))
  );
  // Worn items count toward the same capacity.
  const WornFull: GameState.GameState := Located(
    Extras(OnCoin, 63),
    SwordId,
    ItemRules.ItemLocation.EquippedByPlayer(ItemRules.EquipmentSlot.Weapon)
  );
  Test.AssertTrue(GameState.InventoryIsFull(WornFull));
  Test.AssertTrue(Interaction.Interact(Fixtures.FixtureAreaView(WornFull), WornFull) is Error(_));
  // Dropping lays a carried item on the occupied field, takes a turn, and can be undone by pickup.
  const AtStart: GameState.GameState := Fixtures.FixtureDungeonState(Map.Start, Map.StartFacing);
  const Holding: GameState.GameState := Located(
    AtStart,
    CoinId,
    ItemRules.ItemLocation.CarriedByPlayer
  );
  const Dropping: Combat.TurnOutcome := Turn(Holding, Combat.TurnAction.Drop(CoinId)).Unwrap();
  Test.AssertTrue(LogContains(Dropping, 'You drop the ancient coin.'));
  const Dropped: GameState.GameState := Continued(Dropping);
  Test.AssertEquals(0, GameState.InventoryItems(Dropped).Length());
  case Dropped.Items[0].Location of
    when ItemRules.ItemLocation.InInterior(const AreaId, const Position):
      Test.AssertEquals(Map.AreaId, AreaId);
      Test.AssertEquals(Map.Start.X, Position.X);
      Test.AssertEquals(Map.Start.Y, Position.Y);
    when ItemRules.ItemLocation.CarriedByPlayer, ItemRules.ItemLocation.EquippedByPlayer(_):
      panic('expected the dropped item on the floor');
  end case;

  Test.AssertTrue('Pick up' in Interaction.ItemInteractionHint(Dropped));
  case Interaction.Interact(Fixtures.FixtureAreaView(Dropped), Dropped).Unwrap() of
    when Interaction.InteractionOutcome.StateChanged(const Again):
      Test.AssertEquals(1, GameState.InventoryItems(Again).Length());
    when Interaction.InteractionOutcome.TransitionRequested(_), Interaction.InteractionOutcome.Described(_, _):
      panic('expected the dropped item to be picked up again');
  end case;
  // Dropping frees exactly one place at capacity.
  const Packed: GameState.GameState := Extras(Holding, 63);
  Test.AssertTrue(GameState.InventoryIsFull(Packed));
  const Relieved: GameState.GameState := Continued(
    Turn(Packed, Combat.TurnAction.Drop(CoinId)).Unwrap()
  );
  Test.AssertFalse(GameState.InventoryIsFull(Relieved));
  Test.AssertEquals(63, GameState.InventoryItems(Relieved).Length());
  // Rejected drops change nothing: unknown, worn, lying, outdoors, on the exit, and onto another item.
  Test.AssertTrue(Turn(Holding, Combat.TurnAction.Drop('unknown-item')) is Error(_));
  const Wearing: GameState.GameState := Located(
    AtStart,
    SwordId,
    ItemRules.ItemLocation.EquippedByPlayer(ItemRules.EquipmentSlot.Weapon)
  );
  Test.AssertTrue(Turn(Wearing, Combat.TurnAction.Drop(SwordId)) is Error(_));
  Test.AssertTrue(Turn(AtStart, Combat.TurnAction.Drop(CoinId)) is Error(_));
  const Metadata: Terrain.WorldMetadata := Fixtures.FixtureMetadata();
  const Outdoors: GameState.GameState := Holding with Area := Coordinates.AreaKind.OutdoorRegion; AreaId := Metadata.OutdoorAreaId; Player := Coordinates.PlayerPosition.Outdoor(
    Metadata.Spawn
  ); ReturnLocation := Coordinates.ReturnLocation.NoReturnLocation; end with;

  Test.AssertTrue(Turn(Outdoors, Combat.TurnAction.Drop(CoinId)) is Error(_));
  const OnExit: GameState.GameState := Located(
    Fixtures.FixtureDungeonState(Map.Exit, Coordinates.FacingDirection.East),
    CoinId,
    ItemRules.ItemLocation.CarriedByPlayer
  );
  Test.AssertTrue(Turn(OnExit, Combat.TurnAction.Drop(CoinId)) is Error(_));
  const OnOtherItem: GameState.GameState := Located(
    OnCoin,
    SwordId,
    ItemRules.ItemLocation.CarriedByPlayer
  );
  Test.AssertTrue(Turn(OnOtherItem, Combat.TurnAction.Drop(SwordId)) is Error(_));
  // A floor item on the exit is invalid state.
  Test.AssertTrue(
    (
      GameState.ValidateGameState(
        Fixtures.FixtureAreaView(OnExit),
        Located(OnExit, CoinId, ItemRules.ItemLocation.InInterior(Map.AreaId, Map.Exit))
      ) is Error(_)
    )
  );
  // A drop consumes the same turn as waiting: the adjacent opponent acts identically, and defeat ends the game.
  const Beside: GameState.GameState := Holding with Player := Coordinates.PlayerPosition.FirstPerson(
    Coordinates.FirstPersonPose(
      Position := Coordinates.InteriorPosition(X := 3, Y := 4),
      Facing := Coordinates.FacingDirection.North
    )
  ); Hostiles := [
    Holding.Hostiles[0] with Alerted := true; end with
  ]; end with;

  Test.AssertTrue(EventCount(Turn(Beside, Combat.TurnAction.Drop(CoinId)).Unwrap()) > 0);
  Test.AssertEquals(
    Summary(Turn(Beside, Combat.TurnAction.Wait).Unwrap()),
    Summary(Turn(Beside, Combat.TurnAction.Drop(CoinId)).Unwrap())
  );
  var Defeats: integer := 0;
  for Seed: integer := 1 to 40 do
    begin
      const Fragile: GameState.GameState := Beside with Health := 1; RandomState := Seed; end with;
      const DropResult: Combat.TurnOutcome := Turn(
        Fragile,
        Combat.TurnAction.Drop(CoinId)
      ).Unwrap();
      Test.AssertEquals(
        Summary(Turn(Fragile, Combat.TurnAction.Wait).Unwrap()),
        Summary(DropResult)
      );
      if EventCount(DropResult) < 0 then
        begin
          Defeats := Defeats + 1;
        end;
      end if;
    end;
  end for;

  Test.AssertTrue(Defeats > 0);
end.
