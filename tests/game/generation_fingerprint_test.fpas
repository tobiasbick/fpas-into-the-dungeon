// Pins generator 12 terrain; removing settlement markers recovers the original natural/dungeon vector.
program GenerationFingerprintTest;

uses Dungeon.Terrain.Chunks as ChunksUnit, Dungeon.Coordinates as Coordinates, Dungeon.Terrain as Terrain, Dungeon.Terrain.Generation as TerrainGeneration, Dungeon.Terrain.Placement as PlacementRules, Std.Text.Format as Conv, Std.Test as Test;

function BaseOrdinal(Value: Terrain.BaseTerrainKind): integer;
begin
  case Value of
    when Terrain.BaseTerrainKind.Grass:
      begin
        return 0;
      end;
    when Terrain.BaseTerrainKind.Sand:
      begin
        return 1;
      end;
    when Terrain.BaseTerrainKind.Rock:
      begin
        return 2;
      end;
    when Terrain.BaseTerrainKind.Water:
      begin
        return 3;
      end;
  end case;
end function;

function FeatureOrdinal(Value: Terrain.TerrainFeatureKind): integer;
begin
  case Value of
    when Terrain.TerrainFeatureKind.NoFeature:
      begin
        return 0;
      end;
    when Terrain.TerrainFeatureKind.Tree:
      begin
        return 1;
      end;
    when Terrain.TerrainFeatureKind.Forest:
      begin
        return 2;
      end;
    when Terrain.TerrainFeatureKind.Path:
      begin
        return 3;
      end;
    when Terrain.TerrainFeatureKind.River:
      begin
        return 4;
      end;
    when Terrain.TerrainFeatureKind.Entrance:
      begin
        return 5;
      end;
    when Terrain.TerrainFeatureKind.SettlementGate:
      return 6;
  end case;
end function;

function WaterOrdinal(Value: Terrain.WaterKind): integer;
begin
  case Value of
    when Terrain.WaterKind.NoWater:
      begin
        return 0;
      end;
    when Terrain.WaterKind.Sea:
      begin
        return 1;
      end;
    when Terrain.WaterKind.Lake:
      begin
        return 2;
      end;
    when Terrain.WaterKind.RiverWater:
      begin
        return 3;
      end;
  end case;
end function;

// Encodes every layer of one cell so that no terrain difference can cancel out.
function CellCode(Cell: Terrain.WorldCell): integer;
begin
  return ((BaseOrdinal(Cell.Base) * 100) + (FeatureOrdinal(Cell.Feature) * 10)) +
    WaterOrdinal(Cell.Water);
end function;

function Coordinate(X: integer; Y: integer): Coordinates.ChunkCoordinate;
begin
  return Coordinates.ChunkCoordinate(X := X, Y := Y);
end function;

begin
  const Metadata: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
    'fingerprint',
    12345,
    4
  ).Unwrap();
  // Spawn and spawn-entrance chunks, desert and lake chunks, and a spread of distant and negative chunks.
  const Chunks: array of Coordinates.ChunkCoordinate := [
    Coordinate(
      Coordinates.ChunkForCoordinate(Metadata.Spawn.X),
      Coordinates.ChunkForCoordinate(Metadata.Spawn.Y)
    ),
    Coordinate(
      Coordinates.ChunkForCoordinate(Metadata.SpawnEntrance.X),
      Coordinates.ChunkForCoordinate(Metadata.SpawnEntrance.Y)
    ),
    Coordinate(-1, -1),
    Coordinate(37, -12),
    Coordinate(-80, 45),
    Coordinate(-3, -30),
    Coordinate(-11, -28),
    Coordinate(-27, -27),
    Coordinate(-3000, 2000),
    Coordinate(1, -8),
    Coordinate(-6, -5)
  ];
  // Chunks holding the ordinary entrance sites of regions (0, -2) and (-2, -2).

  var Fingerprint: integer := 17;
  var PreviousFingerprint: integer := 17;
  var Counts: array of integer := array.Fill(0, 400);
  for Chunk: Coordinates.ChunkCoordinate in Chunks do
    begin
      var Index: integer := 0;
      for Cell: Terrain.WorldCell in ChunksUnit.GenerateChunk(Metadata, Chunk).Cells do
        begin
          const Code: integer := CellCode(Cell);
          Fingerprint := ((Fingerprint * 31) + Code) mod 1000000007;
          const Previous: Terrain.WorldCell := if Cell.Feature =
            Terrain.TerrainFeatureKind.SettlementGate then TerrainGeneration.NaturalCell(
              Metadata.Seed,
              Chunk.X * Coordinates.WorldChunkSize + Index mod Coordinates.WorldChunkSize,
              Chunk.Y * Coordinates.WorldChunkSize + Index div Coordinates.WorldChunkSize
            )
            else Cell
            end if;
          PreviousFingerprint := ((PreviousFingerprint * 31) + CellCode(Previous)) mod 1000000007;
          Index := Index + 1;
          Counts[Code] := Counts[Code] + 1;
        end;
      end for;
    end;
  end for;
  var Distribution: string := '';
  for Code: integer := 0 to 399 do
    begin
      if Counts[Code] > 0 then
        begin
          Distribution := ((Distribution + Conv.IntToStr(Code)) + '=') +
            (Conv.IntToStr(Counts[Code]) + ' ');
        end;
      end if;
    end;
  end for;

  Test.AssertEquals(
    '0=102073 10=4084 20=16101 30=712 50=4 60=3 100=3014 130=49 200=15484 301=32768 302=5265 343=667 ',
    Distribution
  );
  Test.AssertEquals(933984742, PreviousFingerprint);
  // Generator 11 adds one grass gate at (-1369,-3531), sample chunk 6, local (39,53).
  // Its +60 at stream index 105127 changes the prior 251932524 by 60 * 31^75096 mod 1000000007.
  Test.AssertEquals(460671082, Fingerprint);
  // The chunk path must agree with independent per-cell generation, including a lake shore.
  const ShoreChunk: Terrain.WorldChunk := ChunksUnit.GenerateChunk(Metadata, Coordinate(-11, -28));
  for LocalY: integer := 0 to Coordinates.WorldChunkSize - 1 do
    begin
      for LocalX: integer := 0 to Coordinates.WorldChunkSize - 1 do
        begin
          Test.AssertEquals(
            CellCode(
              ChunksUnit.GenerateWorldCell(
                Metadata, (-11 * Coordinates.WorldChunkSize) + LocalX,
                (-28 * Coordinates.WorldChunkSize) +
                LocalY
              )
            ), CellCode(Terrain.ChunkCell(ShoreChunk, LocalX, LocalY))
          );
        end;
      end for;
    end;
  end for;
end.
