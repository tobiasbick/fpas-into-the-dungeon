// Protects the daily weather schedule, endpoints, large jumps and signed-seed clock limits.
program WeatherTest;

uses Dungeon.Weather as Weather, Std.Test as Test;

begin
  const Minutes := [0, 359, 360, 480, 719, 720, 1079, 1080, 1439, 1440, 2519, 2520, 2879];
  const Rain := [
    true,
    true,
    false,
    false,
    false,
    false,
    false,
    false,
    false,
    false,
    false,
    true,
    true
  ];
  for Index: integer := 0 to Minutes.Length() - 1 do
    Test.AssertTrue((Weather.At(25, Minutes[Index]) = Weather.WeatherKind.Rain) = Rain[Index]);
  end for;

  Test.AssertTrue(Weather.At(25, 1000000000) = Weather.WeatherKind.Clear);
  Test.AssertTrue(Weather.At(-12345, 1000000000) = Weather.WeatherKind.Rain);
  for Seed: integer in [-2147483648, -12345, 0, 25, 2147483647] do
    for Day: integer in [0, 1, 17, 312, 694443] do
      var RainWindows := 0;
      for Window: integer := 0 to 3 do
        const Start := Day * 1440 + Window * 360;
        const Condition := Weather.At(Seed, Start);
        Test.AssertTrue(Weather.At(Seed, Start + 359) = Condition);
        if Condition = Weather.WeatherKind.Rain then
          RainWindows := RainWindows + 1;
        end if;
      end for;

      Test.AssertEquals(1, RainWindows);
    end for;
  end for;
end.
