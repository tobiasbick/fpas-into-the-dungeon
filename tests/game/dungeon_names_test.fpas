// Pins independent name vectors and validates stored names without changing dungeon identities or geometry.
program DungeonNamesTest;

uses Dungeon.Interior as InteriorUnit, Dungeon.Interior.Generation as Generation, Dungeon.Interior.Generation.Content as Content, Dungeon.Test.Fixtures as Fixtures, Std.Test as Test;

begin
  // Independent integer-arithmetic reference vectors, including normalized negative and extreme inputs.
  Test.AssertEquals('Sunken Depths', Content.DungeonName(0, 0, 0));
  Test.AssertEquals('Sunken Vault', Content.DungeonName(12345, 0, 0));
  Test.AssertEquals('Silent Depths', Content.DungeonName(12345, -7, 4));
  Test.AssertEquals('Forgotten Crypt', Content.DungeonName(-987654321, 3, -9));
  Test.AssertEquals('Broken Tomb', Content.DungeonName(-2147483648, -1, -1));
  Test.AssertEquals('Shrouded Crypt', Content.DungeonName(2147483647, 1, -2));
  Test.AssertEquals(
    'Hollow Halls',
    Content.DungeonName(-9223372036854775807 - 1, -2147483648, 2147483647)
  );
  Test.AssertEquals('Forgotten Crypt', Content.DungeonName(9223372036854775807, -1, 1));
  const First := Generation.GenerateDungeon(12345, -7, 4, 0, 3, 'one:dungeon:-7:4').Unwrap();
  const Second := Generation.GenerateDungeon(12345, -7, 4, 0, 3, 'two:dungeon:-7:4').Unwrap();
  Test.AssertEquals('Silent Depths', First.DisplayName);
  Test.AssertEquals(First.DisplayName, Second.DisplayName);
  Test.AssertTrue(First.AreaId <> Second.AreaId);
  Test.AssertTrue(First.Items[0].ItemId <> Second.Items[0].ItemId);
  Test.AssertEquals(First.Cells.Length(), Second.Cells.Length());
  for Index: integer := 0 to First.Cells.Length() - 1 do
    Test.AssertTrue(First.Cells[Index] = Second.Cells[Index]);
  end for;

  // Querying names never changes the generator stream; repeated display names need not be unique.
  Test.AssertEquals(
    Content.DungeonName(-987654321, 3, -9),
    Content.DungeonName(9223372036854775807, -1, 1)
  );
  Test.AssertEquals(
    First.DisplayName,
    Generation.GenerateDungeon(12345, -7, 4, 0, 3, First.AreaId).Unwrap().DisplayName
  );
  const Map := Fixtures.FixtureDungeonMap();
  for Name: string in ['A', 'A'.RepeatStr(64), 'A "quoted" \\ vault', 'Between two spaces'] do
    Test.AssertEquals(
      Name,
      InteriorUnit.ValidateInteriorMap(Map with DisplayName := Name; end with).Unwrap().DisplayName
    );
  end for;

  for Name: string in [
    '', ' ', ' leading', 'trailing ', 'A'.RepeatStr(65), 'Non-ASCII ä',
    'Bad' + string.Chr(0), 'Bad' + string.Chr(31), 'Bad' + string.Chr(127)
  ] do
    Test.AssertTrue(
      InteriorUnit.ValidateInteriorMap(Map with DisplayName := Name; end with) is Error(_)
    );
  end for;
end.
