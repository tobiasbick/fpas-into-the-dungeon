// Verifies generic interaction targeting, descriptions, and area transitions.
program DungeonInteractionTest;

uses Dungeon.Test.Fixtures as Fixtures, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Interaction as Interaction, Dungeon.Interior as InteriorUnit, Dungeon.Items as ItemRules, Dungeon.Terrain as Terrain, Dungeon.Terrain.Placement as PlacementRules, Std.Test as Test;

function AtEntrance(Metadata: Terrain.WorldMetadata; State: GameState.GameState): GameState.GameState;
begin
  var Value: GameState.GameState := State;
  Value.Player := Coordinates.PlayerPosition.Outdoor(Metadata.SpawnEntrance);
  return Value;
end function;

function AtDungeonPosition(State: GameState.GameState; Position: Coordinates.InteriorPosition; Facing: Coordinates.FacingDirection): GameState.GameState;
begin
  var Value: GameState.GameState := State;
  Value.Player := Coordinates.PlayerPosition.FirstPerson(
    Coordinates.FirstPersonPose(Position := Position, Facing := Facing)
  );
  return Value;
end function;

begin
  const Metadata: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
    'interaction-test',
    9182,
    4
  ).Unwrap();
  const Initial: GameState.GameState := GameState.NewGame(Metadata);
  case Interaction.Interact(Fixtures.FixtureViewFor(Metadata, Initial), Initial).Unwrap() of
    when Interaction.InteractionOutcome.Described(const Title, const Text):
      Test.AssertEquals(Interaction.NoInteractionMessage, Text);
    when Interaction.InteractionOutcome.TransitionRequested(_), Interaction.InteractionOutcome.StateChanged(_):
      panic('expected a no-target description at spawn');
  end case;
  var Entered: GameState.GameState := Initial;
  case Interaction.Interact(
    Fixtures.FixtureViewFor(Metadata, AtEntrance(Metadata, Initial)),
    AtEntrance(Metadata, Initial)
  ).Unwrap() of
    when Interaction.InteractionOutcome.TransitionRequested(const Target):
      Test.AssertEquals(Fixtures.SpawnDungeonAreaId(Metadata), Target);
      const State: GameState.GameState := Fixtures.ActivateFixtureTransition(
        Metadata,
        AtEntrance(Metadata, Initial)
      ).Unwrap();
      Entered := State;
      Test.AssertTrue(State.Area = Coordinates.AreaKind.Dungeon);
    when Interaction.InteractionOutcome.StateChanged(_), Interaction.InteractionOutcome.Described(_, _):
      panic('expected the entrance interaction to change areas');
  end case;
  const Map: InteriorUnit.InteriorMap := Fixtures.FixtureDungeonMapFor(
    Fixtures.SpawnDungeonAreaId(Metadata)
  );
  const CoinField: Coordinates.InteriorPosition := Map.Items[0].Position;
  Test.AssertEquals(8, CoinField.X);
  Test.AssertEquals(1, CoinField.Y);
  Test.AssertTrue(
    InteriorUnit.InteriorCellAt(Map, CoinField).Unwrap() = InteriorUnit.InteriorCellKind.Floor
  );
  Test.AssertEquals(
    '#',
    InteriorUnit.InteriorVisibleCode(Map, Coordinates.InteriorPosition(X := 9, Y := 0)).Unwrap()
  );
  Test.AssertEquals('i', GameState.InteriorVisibleCodeForState(Map, Entered, CoinField).Unwrap());
  Test.AssertEquals(
    '#',
    InteriorUnit.InteriorVisibleCode(Map, Coordinates.InteriorPosition(X := 0, Y := 0)).Unwrap()
  );
  case Interaction.Interact(Fixtures.FixtureViewFor(Metadata, Entered), Entered).Unwrap() of
    when Interaction.InteractionOutcome.Described(const Title, const Text):
      Test.AssertEquals(ItemRules.AncientCoinName, Title);
      Test.AssertEquals(ItemRules.AncientCoinDescription, Text);
      Test.AssertEquals(0, GameState.InventoryItems(Entered).Length());
    when Interaction.InteractionOutcome.TransitionRequested(_), Interaction.InteractionOutcome.StateChanged(_):
      panic('expected the collectible item description from the dungeon start');
  end case;

  case Interaction.Interact(
    Fixtures.FixtureViewFor(
      Metadata,
      AtDungeonPosition(Entered, CoinField, Coordinates.FacingDirection.West)
    ),
    AtDungeonPosition(Entered, CoinField, Coordinates.FacingDirection.West)
  ).Unwrap() of
    when Interaction.InteractionOutcome.StateChanged(const State):
      Entered := State;
      Test.AssertEquals(1, GameState.InventoryItems(State).Length());
      Test.AssertEquals(Map.Items[0].ItemId, GameState.InventoryItems(State)[0].Id);
      Test.AssertEquals('.', GameState.InteriorVisibleCodeForState(Map, State, CoinField).Unwrap());
    when Interaction.InteractionOutcome.TransitionRequested(_), Interaction.InteractionOutcome.Described(_, _):
      panic('expected the occupied item field to add the item to inventory');
  end case;

  case Interaction.Interact(
    Fixtures.FixtureViewFor(
      Metadata,
      AtDungeonPosition(Entered, CoinField, Coordinates.FacingDirection.West)
    ),
    AtDungeonPosition(Entered, CoinField, Coordinates.FacingDirection.West)
  ).Unwrap() of
    when Interaction.InteractionOutcome.Described(const Title, const Text):
      Test.AssertEquals(Interaction.NoInteractionMessage, Text);
      Test.AssertEquals(1, GameState.InventoryItems(Entered).Length());
    when Interaction.InteractionOutcome.TransitionRequested(_), Interaction.InteractionOutcome.StateChanged(_):
      panic('expected repeated pickup to leave the single inventory item unchanged');
  end case;
  const FacingWall: GameState.GameState := AtDungeonPosition(
    Entered,
    Map.Start,
    Coordinates.FacingDirection.North
  );
  case Interaction.Interact(Fixtures.FixtureViewFor(Metadata, FacingWall), FacingWall).Unwrap() of
    when Interaction.InteractionOutcome.Described(const Title, const Text):
      Test.AssertEquals('', Title);
      Test.AssertEquals(Interaction.NoInteractionMessage, Text);
    when Interaction.InteractionOutcome.TransitionRequested(_), Interaction.InteractionOutcome.StateChanged(_):
      panic('expected no interaction with an ordinary wall');
  end case;

  case Interaction.Interact(
    Fixtures.FixtureViewFor(
      Metadata,
      AtDungeonPosition(Entered, Map.Arrival, Coordinates.FacingDirection.West)
    ),
    AtDungeonPosition(Entered, Map.Arrival, Coordinates.FacingDirection.West)
  ).Unwrap() of
    when Interaction.InteractionOutcome.TransitionRequested(const Target):
      Test.AssertEquals(Metadata.OutdoorAreaId, Target);
      const State: GameState.GameState := Fixtures.ActivateFixtureTransition(
        Metadata,
        AtDungeonPosition(Entered, Map.Arrival, Coordinates.FacingDirection.West)
      ).Unwrap();
      Test.AssertTrue(State.Area = Coordinates.AreaKind.OutdoorRegion);
      const Position: Coordinates.WorldPosition := GameState.OutdoorPlayerPosition(State).Unwrap();
      Test.AssertEquals(Metadata.SpawnEntrance.X, Position.X);
      Test.AssertEquals(Metadata.SpawnEntrance.Y, Position.Y);
    when Interaction.InteractionOutcome.StateChanged(_), Interaction.InteractionOutcome.Described(_, _):
      panic('expected the exit interaction to return outdoors');
  end case;
  var Invalid: GameState.GameState := Entered;
  Invalid.ReturnLocation := Coordinates.ReturnLocation.NoReturnLocation;
  Test.AssertTrue(
    (Interaction.Interact(Fixtures.FixtureViewFor(Metadata, Invalid), Invalid) is Error(_))
  );
end.
