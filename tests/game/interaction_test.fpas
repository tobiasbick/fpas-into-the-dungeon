// Verifies generic interaction targeting, descriptions, and area transitions.
program DungeonInteractionTest;

uses
  Dungeon.Test.Fixtures, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interaction,
  Dungeon.Interior, Dungeon.Items, Dungeon.Terrain, Dungeon.Terrain.Placement, Std.Arrays,
  Std.Results, Std.Test;

function AtEntrance(Metadata: WorldMetadata; State: GameState): GameState;
begin
  mutable var Value: GameState := State;
  Value.Player := PlayerPosition.Outdoor(Metadata.SpawnEntrance);
  return Value
end;

function AtDungeonPosition(State: GameState; Position: InteriorPosition; Facing: FacingDirection): GameState;
begin
  mutable var Value: GameState := State;
  Value.Player := PlayerPosition.FirstPerson(record
    Position := Position;
    Facing := Facing;
  end);
  return Value
end;

begin
  var Metadata: WorldMetadata := Unwrap(NewWorldMetadata('interaction-test', 9182, 4));
  var Initial: GameState := NewGame(Metadata);
  case Unwrap(Interact(FixtureViewFor(Metadata, Initial), Initial)) of
    InteractionOutcome.Described(Title, Text):
    begin
      AssertEquals(NoInteractionMessage, Text)
    end
    else
    begin
      panic('expected a no-target description at spawn')
    end
  end;
  mutable var Entered: GameState := Initial;
  case Unwrap(Interact(FixtureViewFor(Metadata, AtEntrance(Metadata, Initial)), AtEntrance(Metadata, Initial))) of
    InteractionOutcome.TransitionRequested(Target):
    begin
      AssertEquals(SpawnDungeonAreaId(Metadata), Target);
      var State: GameState := Unwrap(ActivateFixtureTransition(Metadata, AtEntrance(Metadata, Initial)));
      Entered := State;
      AssertTrue(State.Area = AreaKind.Dungeon)
    end
    else
    begin
      panic('expected the entrance interaction to change areas')
    end
  end;
  var Map: InteriorMap := FixtureDungeonMapFor(SpawnDungeonAreaId(Metadata));
  var CoinField: InteriorPosition := Map.Items[0].Position;
  AssertEquals(8, CoinField.X);
  AssertEquals(1, CoinField.Y);
  AssertTrue(Unwrap(InteriorCellAt(Map, CoinField)) = InteriorCellKind.Floor);
  AssertEquals('#', Unwrap(InteriorVisibleCode(Map, record
    X := 9;
    Y := 0;
  end)));
  AssertEquals('i', Unwrap(InteriorVisibleCodeForState(Map, Entered, CoinField)));
  AssertEquals('#', Unwrap(InteriorVisibleCode(Map, record
    X := 0;
    Y := 0;
  end)));
  case Unwrap(Interact(FixtureViewFor(Metadata, Entered), Entered)) of
    InteractionOutcome.Described(Title, Text):
    begin
      AssertEquals(AncientCoinName, Title);
      AssertEquals(AncientCoinDescription, Text);
      AssertEquals(0, Std.Arrays.Length(InventoryItems(Entered)))
    end
    else
    begin
      panic('expected the collectible item description from the dungeon start')
    end
  end;

  case Unwrap(Interact(FixtureViewFor(Metadata, AtDungeonPosition(Entered, CoinField, FacingDirection.West)), AtDungeonPosition(Entered, CoinField, FacingDirection.West))) of
    InteractionOutcome.StateChanged(State):
    begin
      Entered := State;
      AssertEquals(1, Std.Arrays.Length(InventoryItems(State)));
      AssertEquals(Map.Items[0].ItemId, InventoryItems(State)[0].Id);
      AssertEquals('.', Unwrap(InteriorVisibleCodeForState(Map, State, CoinField)))
    end
    else
    begin
      panic('expected the occupied item field to add the item to inventory')
    end
  end;

  case Unwrap(Interact(FixtureViewFor(Metadata, AtDungeonPosition(Entered, CoinField, FacingDirection.West)), AtDungeonPosition(Entered, CoinField, FacingDirection.West))) of
    InteractionOutcome.Described(Title, Text):
    begin
      AssertEquals(NoInteractionMessage, Text);
      AssertEquals(1, Std.Arrays.Length(InventoryItems(Entered)))
    end
    else
    begin
      panic('expected repeated pickup to leave the single inventory item unchanged')
    end
  end;
  var FacingWall: GameState := AtDungeonPosition(Entered, Map.Start, FacingDirection.North);
  case Unwrap(Interact(FixtureViewFor(Metadata, FacingWall), FacingWall)) of
    InteractionOutcome.Described(Title, Text):
    begin
      AssertEquals('', Title);
      AssertEquals(NoInteractionMessage, Text)
    end
    else
    begin
      panic('expected no interaction with an ordinary wall')
    end
  end;

  case Unwrap(Interact(FixtureViewFor(Metadata, AtDungeonPosition(Entered, Map.Exit, FacingDirection.West)), AtDungeonPosition(Entered, Map.Exit, FacingDirection.West))) of
    InteractionOutcome.TransitionRequested(Target):
    begin
      AssertEquals(Metadata.OutdoorAreaId, Target);
      var State: GameState := Unwrap(ActivateFixtureTransition(Metadata, AtDungeonPosition(Entered, Map.Exit, FacingDirection.West)));
      AssertTrue(State.Area = AreaKind.OutdoorRegion);
      var Position: WorldPosition := Unwrap(OutdoorPlayerPosition(State));
      AssertEquals(Metadata.SpawnEntrance.X, Position.X);
      AssertEquals(Metadata.SpawnEntrance.Y, Position.Y)
    end
    else
    begin
      panic('expected the exit interaction to return outdoors')
    end
  end;
  mutable var Invalid: GameState := Entered;
  Invalid.ReturnLocation := ReturnLocation.NoReturnLocation;
  AssertTrue(IsError(Interact(FixtureViewFor(Metadata, Invalid), Invalid)))
end.
