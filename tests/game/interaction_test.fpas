// Verifies generic interaction targeting, descriptions, and area transitions.
program DungeonInteractionTest;

uses
  Dungeon.Test.Fixtures, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interaction,
  Dungeon.Interior, Dungeon.Items, Dungeon.Terrain, Dungeon.Terrain.Placement, Std.Test;

function AtEntrance(Metadata: WorldMetadata; State: GameState): GameState;
begin
  var Value: GameState := State;
  Value.Player := PlayerPosition.Outdoor(Metadata.SpawnEntrance);
  return Value;
end function;

function AtDungeonPosition(State: GameState; Position: InteriorPosition; Facing: FacingDirection): GameState;
begin
  var Value: GameState := State;
  Value.Player := PlayerPosition.FirstPerson(FirstPersonPose(Position := Position, Facing := Facing));
  return Value;
end function;

begin
  const Metadata: WorldMetadata := NewWorldMetadata('interaction-test', 9182, 4).Unwrap();
  const Initial: GameState := NewGame(Metadata);
  if Interact(FixtureViewFor(Metadata, Initial), Initial).Unwrap() is InteractionOutcome.Described(const Title, const Text) then
    begin
      AssertEquals(NoInteractionMessage, Text);
    end;
  else
    begin
      panic('expected a no-target description at spawn');
    end;
  end if;
  var Entered: GameState := Initial;
  if Interact(FixtureViewFor(Metadata, AtEntrance(Metadata, Initial)), AtEntrance(Metadata, Initial)).Unwrap() is InteractionOutcome.TransitionRequested(const Target) then
    begin
      AssertEquals(SpawnDungeonAreaId(Metadata), Target);
      const State: GameState := ActivateFixtureTransition(Metadata, AtEntrance(Metadata, Initial))
                                  .Unwrap();
      Entered := State;
      AssertTrue(State.Area = AreaKind.Dungeon);
    end;
  else
    begin
      panic('expected the entrance interaction to change areas');
    end;
  end if;
  const Map: InteriorMap := FixtureDungeonMapFor(SpawnDungeonAreaId(Metadata));
  const CoinField: InteriorPosition := Map.Items[0].Position;
  AssertEquals(8, CoinField.X);
  AssertEquals(1, CoinField.Y);
  AssertTrue(InteriorCellAt(Map, CoinField).Unwrap() = InteriorCellKind.Floor);
  AssertEquals('#', InteriorVisibleCode(Map, InteriorPosition(X := 9, Y := 0)).Unwrap());
  AssertEquals('i', InteriorVisibleCodeForState(Map, Entered, CoinField).Unwrap());
  AssertEquals('#', InteriorVisibleCode(Map, InteriorPosition(X := 0, Y := 0)).Unwrap());
  if Interact(FixtureViewFor(Metadata, Entered), Entered).Unwrap() is InteractionOutcome.Described(const Title, const Text) then
    begin
      AssertEquals(AncientCoinName, Title);
      AssertEquals(AncientCoinDescription, Text);
      AssertEquals(0, InventoryItems(Entered).Length());
    end;
  else
    begin
      panic('expected the collectible item description from the dungeon start');
    end;
  end if;

  if Interact(FixtureViewFor(Metadata, AtDungeonPosition(Entered, CoinField, FacingDirection.West)), AtDungeonPosition(Entered, CoinField, FacingDirection.West)).Unwrap() is InteractionOutcome.StateChanged(const State) then
    begin
      Entered := State;
      AssertEquals(1, InventoryItems(State).Length());
      AssertEquals(Map.Items[0].ItemId, InventoryItems(State)[0].Id);
      AssertEquals('.', InteriorVisibleCodeForState(Map, State, CoinField).Unwrap());
    end;
  else
    begin
      panic('expected the occupied item field to add the item to inventory');
    end;
  end if;

  if Interact(FixtureViewFor(Metadata, AtDungeonPosition(Entered, CoinField, FacingDirection.West)), AtDungeonPosition(Entered, CoinField, FacingDirection.West)).Unwrap() is InteractionOutcome.Described(const Title, const Text) then
    begin
      AssertEquals(NoInteractionMessage, Text);
      AssertEquals(1, InventoryItems(Entered).Length());
    end;
  else
    begin
      panic('expected repeated pickup to leave the single inventory item unchanged');
    end;
  end if;
  const FacingWall: GameState := AtDungeonPosition(Entered, Map.Start, FacingDirection.North);
  if Interact(FixtureViewFor(Metadata, FacingWall), FacingWall).Unwrap() is InteractionOutcome.Described(const Title, const Text) then
    begin
      AssertEquals('', Title);
      AssertEquals(NoInteractionMessage, Text);
    end;
  else
    begin
      panic('expected no interaction with an ordinary wall');
    end;
  end if;

  if Interact(FixtureViewFor(Metadata, AtDungeonPosition(Entered, Map.Exit, FacingDirection.West)), AtDungeonPosition(Entered, Map.Exit, FacingDirection.West)).Unwrap() is InteractionOutcome.TransitionRequested(const Target) then
    begin
      AssertEquals(Metadata.OutdoorAreaId, Target);
      const State: GameState := ActivateFixtureTransition(Metadata, AtDungeonPosition(Entered, Map.Exit, FacingDirection.West))
                                  .Unwrap();
      AssertTrue(State.Area = AreaKind.OutdoorRegion);
      const Position: WorldPosition := OutdoorPlayerPosition(State).Unwrap();
      AssertEquals(Metadata.SpawnEntrance.X, Position.X);
      AssertEquals(Metadata.SpawnEntrance.Y, Position.Y);
    end;
  else
    begin
      panic('expected the exit interaction to return outdoors');
    end;
  end if;
  var Invalid: GameState := Entered;
  Invalid.ReturnLocation := ReturnLocation.NoReturnLocation;
  AssertTrue(Interact(FixtureViewFor(Metadata, Invalid), Invalid).IsError());
end.
