// Verifies equipment: placements, derived values, equip rules and turn costs, combat effects, and validation.
program EquipmentTest;

uses Dungeon.Test.Fixtures as Fixtures, Dungeon.Combat as Combat, Dungeon.Coordinates as Coordinates, Dungeon.Equipment as Equipment, Dungeon.Exploration as Exploration, Dungeon.Exploration.Sight as Sight, Dungeon.GameState as GameState, Dungeon.Hostiles as Hostiles, Dungeon.Interaction as Interaction, Dungeon.Interior as Interior, Dungeon.Items as ItemRules, Dungeon.Terrain as Terrain, Dungeon.Terrain.Placement as Placement, Std.Test as Test;

function InDungeon(
  Metadata: Terrain.WorldMetadata;
  State: GameState.GameState;
  X: integer;
  Y: integer;
  Facing: Coordinates.FacingDirection
): GameState.GameState;
begin
  return State with Area := Coordinates.AreaKind.Dungeon; AreaId := Fixtures.SpawnDungeonAreaId(
    Metadata
  ); Player := Coordinates.PlayerPosition.FirstPerson(
    Coordinates.FirstPersonPose(
      Position := Coordinates.InteriorPosition(X := X, Y := Y),
      Facing := Facing
    )
  ); ReturnLocation := Coordinates.ReturnLocation.ReturnTo(
    Metadata.OutdoorAreaId,
    Metadata.SpawnEntrance
  ); end with;
end function;

// Places one item at a new location without any rule check.
function WithLocation(State: GameState.GameState; ItemId: string; Location: ItemRules.ItemLocation): GameState.GameState;
begin
  var Items: array of ItemRules.GameItem := State.Items;
  for Index: integer := 0 to Items.Length() - 1 do
    begin
      if Items[Index].Id = ItemId then
        begin
          Items[Index] := Items[Index] with Location := Location; end with;
        end;
      end if;
    end;
  end for;

  return State with Items := Items; end with;
end function;

function Continued(Outcome: Combat.TurnOutcome): GameState.GameState;
begin
  case Outcome of
    when Combat.TurnOutcome.Continued(const State, const Log, const Events):
      begin
        return State;
      end;
    when Combat.TurnOutcome.Defeated(const Log):
      begin
        panic('expected the game to continue');
      end;
  end case;
end function;

function LogOf(Outcome: Combat.TurnOutcome): array of string;
begin
  case Outcome of
    when Combat.TurnOutcome.Continued(const State, const Log, const Events):
      begin
        return Log;
      end;
    when Combat.TurnOutcome.Defeated(const Log):
      begin
        return Log;
      end;
  end case;
end function;

function EventsOf(Outcome: Combat.TurnOutcome): array of Combat.CombatEvent;
begin
  case Outcome of
    when Combat.TurnOutcome.Continued(const State, const Log, const Events):
      begin
        return Events;
      end;
    when Combat.TurnOutcome.Defeated(const Log):
      begin
        return [];
      end;
  end case;
end function;

function IsWorn(State: GameState.GameState; ItemId: string; Slot: ItemRules.EquipmentSlot): boolean;
begin
  case GameState.EquippedItem(State, Slot) of
    when Some(const Item):
      begin
        return Item.Id = ItemId;
      end;
    when None:
      begin
        return false;
      end;
  end case;
end function;

function Line(State: GameState.GameState; Label: string): Equipment.CharacterValueLine;
begin
  for Entry: Equipment.CharacterValueLine in Equipment.CharacterValueLines(State) do
    begin
      if Entry.Label = Label then
        begin
          return Entry;
        end;
      end if;
    end;
  end for;

  panic('missing character line ' + Label);
end function;

// Counts the skeleton's hits over many turns while the player keeps waiting beside it.
function SkeletonHits(Metadata: Terrain.WorldMetadata; Start: GameState.GameState): integer;
begin
  var State: GameState.GameState := Start;
  var Hits: integer := 0;
  for Turn: integer := 1 to 200 do
    begin
      State := State with Health := GameState.PlayerMaximumHealth; end with;
      const Outcome: Combat.TurnOutcome := Combat.ResolveTurn(
        Fixtures.FixtureViewFor(Metadata, State),
        State,
        Combat.TurnAction.Wait
      ).Unwrap();
      for Entry: Combat.CombatEvent in EventsOf(Outcome) do
        begin
          if Entry.Kind = Combat.CombatEventKind.HostileHit then
            begin
              Hits := Hits + 1;
              Test.AssertTrue((Entry.Amount >= 1) and (Entry.Amount <= 4));
            end;
          end if;
        end;
      end for;

      State := Continued(Outcome);
    end;
  end for;

  return Hits;
end function;

begin
  const Metadata: Terrain.WorldMetadata := Placement.NewWorldMetadata(
    'equipment',
    24680,
    4
  ).Unwrap();
  const Fresh: GameState.GameState := Fixtures.MaterializedFixtureState(Metadata);
  const Map: Interior.InteriorMap := Fixtures.FixtureDungeonMapFor(
    Fixtures.SpawnDungeonAreaId(Metadata)
  );
  // Three items: the coin on the upper corridor, sword and jerkin off the main route.
  Test.AssertEquals(3, Fresh.Items.Length());
  const SwordField: Coordinates.InteriorPosition := Map.Items[1].Position;
  const JerkinField: Coordinates.InteriorPosition := Map.Items[2].Position;
  Test.AssertEquals(7, SwordField.X);
  Test.AssertEquals(4, SwordField.Y);
  Test.AssertEquals(1, JerkinField.X);
  Test.AssertEquals(6, JerkinField.Y);
  // Neither item can be seen from the skeleton's resting field.
  const Rest: Coordinates.InteriorPosition := Fresh.Hostiles[0].Position;
  Test.AssertFalse(
    Sight.HasLineOfSight(Map, Rest, SwordField) or Sight.HasLineOfSight(Map, SwordField, Rest)
  );
  Test.AssertFalse(
    Sight.HasLineOfSight(Map, Rest, JerkinField) or Sight.HasLineOfSight(Map, JerkinField, Rest)
  );
  Test.AssertEquals(
    'w',
    GameState.InteriorVisibleCodeForState(
      Map,
      InDungeon(Metadata, Fresh, 9, 1, Coordinates.FacingDirection.West),
      SwordField
    ).Unwrap()
  );
  Test.AssertEquals(
    'a',
    GameState.InteriorVisibleCodeForState(
      Map,
      InDungeon(Metadata, Fresh, 9, 1, Coordinates.FacingDirection.West),
      JerkinField
    ).Unwrap()
  );
  Test.AssertTrue(ItemRules.ItemSlot(ItemRules.ItemKind.AncientCoin) = None);
  Test.AssertTrue(
    ItemRules.ItemSlot(ItemRules.ItemKind.RustyShortSword).Unwrap() =
    ItemRules.EquipmentSlot.Weapon
  );
  Test.AssertTrue(
    ItemRules.ItemSlot(ItemRules.ItemKind.LeatherJerkin).Unwrap() = ItemRules.EquipmentSlot.Body
  );
  // Picking up the sword carries it without wearing it.
  const OnSword: GameState.GameState := InDungeon(
    Metadata,
    Fresh,
    SwordField.X,
    SwordField.Y,
    Coordinates.FacingDirection.South
  );
  Test.AssertEquals(
    'At your feet: Rusty short sword — Enter: Pick up',
    Interaction.ItemInteractionHint(OnSword)
  );
  var Carrying: GameState.GameState := OnSword;
  case Interaction.Interact(Fixtures.FixtureViewFor(Metadata, OnSword), OnSword).Unwrap() of
    when Interaction.InteractionOutcome.StateChanged(const Changed):
      Carrying := Changed;
    when Interaction.InteractionOutcome.TransitionRequested(_), Interaction.InteractionOutcome.Described(_, _):
      panic('expected the sword to be picked up');
  end case;

  Test.AssertEquals(1, GameState.InventoryItems(Carrying).Length());
  Test.AssertTrue(GameState.EquippedItem(Carrying, ItemRules.EquipmentSlot.Weapon) = None);
  // Unarmed values: d3 damage, base hit threshold, no armor.
  const Unarmed: Equipment.CharacterValues := Equipment.DeriveCharacterValues(Carrying);
  Test.AssertEquals(GameState.PlayerMaximumHealth, Unarmed.MaximumHealth);
  Test.AssertEquals(Equipment.BaseHitThreshold, Unarmed.HitThreshold);
  Test.AssertEquals(3, Unarmed.DamageSides);
  Test.AssertEquals(0, Unarmed.DamageBonus);
  Test.AssertEquals(0, Unarmed.Armor);
  Test.AssertEquals('d3', Line(Carrying, 'Damage').Value);
  Test.AssertEquals('Unarmed', Line(Carrying, 'Damage').Source);
  Test.AssertEquals('75% (d20 ≥ 6)', Line(Carrying, 'Hit chance').Value);
  Test.AssertEquals('None', Line(Carrying, 'Armor').Source);
  Test.AssertEquals(4, Equipment.CharacterValueLines(Carrying).Length());
  // Equipping consumes a turn and reports it; the dice stay untouched outside combat.
  const Wield: Combat.TurnOutcome := Combat.ResolveTurn(
    Fixtures.FixtureViewFor(Metadata, Carrying),
    Carrying,
    Combat.TurnAction.Equip(Fixtures.FixtureSwordId(Metadata))
  ).Unwrap();
  const Armed: GameState.GameState := Continued(Wield);
  Test.AssertEquals('You wield the rusty short sword.', LogOf(Wield)[0]);
  Test.AssertTrue(IsWorn(Armed, Fixtures.FixtureSwordId(Metadata), ItemRules.EquipmentSlot.Weapon));
  Test.AssertEquals(1, GameState.InventoryItems(Armed).Length());
  Test.AssertEquals(6, Equipment.DeriveCharacterValues(Armed).DamageSides);
  Test.AssertEquals(1, Equipment.DeriveCharacterValues(Armed).DamageBonus);
  Test.AssertEquals('d6+1', Line(Armed, 'Damage').Value);
  Test.AssertEquals(ItemRules.RustyShortSwordName, Line(Armed, 'Damage').Source);
  Test.AssertEquals(Carrying.RandomState, Armed.RandomState);
  // Rejections consume nothing: already worn, not worn, cannot be worn, not carried, unknown.
  Test.AssertTrue(
    (
      Combat.ResolveTurn(
        Fixtures.FixtureViewFor(Metadata, Armed),
        Armed,
        Combat.TurnAction.Equip(Fixtures.FixtureSwordId(Metadata))
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      Combat.ResolveTurn(
        Fixtures.FixtureViewFor(Metadata, Carrying),
        Carrying,
        Combat.TurnAction.Unequip(Fixtures.FixtureSwordId(Metadata))
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      Combat.ResolveTurn(
        Fixtures.FixtureViewFor(Metadata, Armed),
        Armed,
        Combat.TurnAction.Equip(Fixtures.FixtureJerkinId(Metadata))
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      Combat.ResolveTurn(
        Fixtures.FixtureViewFor(Metadata, Armed),
        Armed,
        Combat.TurnAction.Equip('unknown:item')
      ) is Error(_)
    )
  );
  const CoinCarried: GameState.GameState := WithLocation(
    Armed,
    Fixtures.FixtureCoinId(Metadata),
    ItemRules.ItemLocation.CarriedByPlayer
  );
  Test.AssertTrue(
    (
      Combat.ResolveTurn(
        Fixtures.FixtureViewFor(Metadata, CoinCarried),
        CoinCarried,
        Combat.TurnAction.Equip(Fixtures.FixtureCoinId(Metadata))
      ) is Error(_)
    )
  );
  // Unequipping returns the sword to the inventory.
  const PutAway: Combat.TurnOutcome := Combat.ResolveTurn(
    Fixtures.FixtureViewFor(Metadata, Armed),
    Armed,
    Combat.TurnAction.Unequip(Fixtures.FixtureSwordId(Metadata))
  ).Unwrap();
  Test.AssertEquals('You put away the rusty short sword.', LogOf(PutAway)[0]);
  Test.AssertTrue(
    GameState.EquippedItem(Continued(PutAway), ItemRules.EquipmentSlot.Weapon) = None
  );
  Test.AssertEquals(1, GameState.InventoryItems(Continued(PutAway)).Length());
  // The jerkin adds armor; its slot is independent of the weapon slot.
  const BothCarried: GameState.GameState := WithLocation(
    Armed,
    Fixtures.FixtureJerkinId(Metadata),
    ItemRules.ItemLocation.CarriedByPlayer
  );
  const Dressed: GameState.GameState := Continued(
    Combat.ResolveTurn(
      Fixtures.FixtureViewFor(Metadata, BothCarried),
      BothCarried,
      Combat.TurnAction.Equip(Fixtures.FixtureJerkinId(Metadata))
    ).Unwrap()
  );
  Test.AssertTrue(
    IsWorn(Dressed, Fixtures.FixtureJerkinId(Metadata), ItemRules.EquipmentSlot.Body)
  );
  Test.AssertTrue(
    IsWorn(Dressed, Fixtures.FixtureSwordId(Metadata), ItemRules.EquipmentSlot.Weapon)
  );
  Test.AssertEquals(2, Equipment.DeriveCharacterValues(Dressed).Armor);
  Test.AssertEquals('2', Line(Dressed, 'Armor').Value);
  Test.AssertEquals(ItemRules.LeatherJerkinName, Line(Dressed, 'Armor').Source);
  const TakenOff: Combat.TurnOutcome := Combat.ResolveTurn(
    Fixtures.FixtureViewFor(Metadata, Dressed),
    Dressed,
    Combat.TurnAction.Unequip(Fixtures.FixtureJerkinId(Metadata))
  ).Unwrap();
  Test.AssertEquals('You take off the leather jerkin.', LogOf(TakenOff)[0]);
  // Equipping outdoors works too; no opponent acts there.
  const Outdoors: GameState.GameState := WithLocation(
    Fresh,
    Fixtures.FixtureSwordId(Metadata),
    ItemRules.ItemLocation.CarriedByPlayer
  );
  Test.AssertTrue(
    IsWorn(
      Continued(
        Combat.ResolveTurn(
          Fixtures.FixtureViewFor(Metadata, Outdoors),
          Outdoors,
          Combat.TurnAction.Equip(Fixtures.FixtureSwordId(Metadata))
        ).Unwrap()
      ),
      Fixtures.FixtureSwordId(Metadata),
      ItemRules.EquipmentSlot.Weapon
    )
  );
  // Changing gear beside an alerted skeleton gives it a turn to strike.
  const Beside: GameState.GameState := InDungeon(
    Metadata,
    BothCarried,
    4,
    3,
    Coordinates.FacingDirection.West
  ) with Hostiles := [
    Fresh.Hostiles[0] with Alerted := true; end with
  ]; end with;
  const Exposed: Combat.TurnOutcome := Combat.ResolveTurn(
    Fixtures.FixtureViewFor(Metadata, Beside),
    Beside,
    Combat.TurnAction.Equip(Fixtures.FixtureJerkinId(Metadata))
  ).Unwrap();
  Test.AssertEquals('You put on the leather jerkin.', LogOf(Exposed)[0]);
  Test.AssertEquals(2, LogOf(Exposed).Length());
  Test.AssertTrue('skeleton' in LogOf(Exposed)[1]);
  Test.AssertEquals(1, EventsOf(Exposed).Length());
  Test.AssertTrue(Continued(Exposed).RandomState <> Beside.RandomState);
  // Armor lowers the skeleton's hits over the same number of turns.
  const Unprotected: GameState.GameState := Beside;
  const Protected: GameState.GameState := Continued(Exposed) with RandomState := Beside.RandomState; end with;
  const HitsWithout: integer := SkeletonHits(Metadata, Unprotected);
  const HitsWith: integer := SkeletonHits(Metadata, Protected);
  Test.AssertTrue(HitsWithout > 0);
  Test.AssertTrue(HitsWith < HitsWithout);
  // Blows report structured events whose damage follows the wielded weapon.
  var SawArmedHit: boolean := false;
  var SawUnarmedHit: boolean := false;
  for Weapon: integer := 0 to 1 do
    begin
      // Beside wears the sword; the unarmed round puts it away first.
      var Attacker: GameState.GameState := Beside;
      if Weapon = 0 then
        begin
          Attacker := WithLocation(
            Beside,
            Fixtures.FixtureSwordId(Metadata),
            ItemRules.ItemLocation.CarriedByPlayer
          );
        end;
      end if;

      for Turn: integer := 1 to 30 do
        begin
          const Target: Hostiles.GameHostile := Attacker.Hostiles[0] with Health := Hostiles.RestlessSkeletonMaximumHealth; end with;

          Attacker := Attacker with Health := GameState.PlayerMaximumHealth; Hostiles := [Target]; end with;
          const Blow: Combat.TurnOutcome := Combat.ResolveTurn(
            Fixtures.FixtureViewFor(Metadata, Attacker),
            Attacker,
            Combat.TurnAction.Attack
          ).Unwrap();
          Test.AssertTrue(EventsOf(Blow).Length() >= 1);
          const First: Combat.CombatEvent := EventsOf(Blow)[0];
          Test.AssertTrue(
            (First.Kind = Combat.CombatEventKind.PlayerHit)
            or
            (First.Kind = Combat.CombatEventKind.PlayerMiss)
          );
          if First.Kind = Combat.CombatEventKind.PlayerHit then
            begin
              if Weapon = 1 then
                begin
                  Test.AssertTrue((First.Amount >= 2) and (First.Amount <= 7));
                  SawArmedHit := true;
                end;
              else
                begin
                  Test.AssertTrue((First.Amount >= 1) and (First.Amount <= 3));
                  SawUnarmedHit := true;
                end;
              end if;
            end;
          else
            begin
              Test.AssertEquals(0, First.Amount);
            end;
          end if;

          Attacker := Continued(Blow);
        end;
      end for;
    end;
  end for;

  Test.AssertTrue(SawArmedHit);
  Test.AssertTrue(SawUnarmedHit);
  // Validation: every known item exactly once, worn only in a fitting and free slot.
  Test.AssertTrue((Fixtures.ValidateFixtureSave(Metadata, Dressed) is Ok(_)));
  Test.AssertTrue(
    (
      Fixtures.ValidateFixtureSave(
        Metadata,
        WithLocation(
          Fresh,
          Fixtures.FixtureCoinId(Metadata),
          ItemRules.ItemLocation.EquippedByPlayer(ItemRules.EquipmentSlot.Weapon)
        )
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      Fixtures.ValidateFixtureSave(
        Metadata,
        WithLocation(
          Fresh,
          Fixtures.FixtureSwordId(Metadata),
          ItemRules.ItemLocation.EquippedByPlayer(ItemRules.EquipmentSlot.Body)
        )
      ) is Error(_)
    )
  );
  const TwoBodies: GameState.GameState := WithLocation(
    WithLocation(
      Fresh,
      Fixtures.FixtureJerkinId(Metadata),
      ItemRules.ItemLocation.EquippedByPlayer(ItemRules.EquipmentSlot.Body)
    ),
    Fixtures.FixtureSwordId(Metadata),
    ItemRules.ItemLocation.EquippedByPlayer(ItemRules.EquipmentSlot.Body)
  );
  Test.AssertTrue((Fixtures.ValidateFixtureSave(Metadata, TwoBodies) is Error(_)));
  Test.AssertTrue(
    (
      Fixtures.ValidateFixtureSave(
        Metadata,
        Fresh with Items := [Fresh.Items[0], Fresh.Items[1]]; end with
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      Fixtures.ValidateFixtureSave(
        Metadata, Fresh with Items := [
          Fresh.Items[0],
          Fresh.Items[1],
          Fresh.Items[1]
        ]; end with
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      Fixtures.ValidateFixtureSave(
        Metadata, Fresh with Items := [
          Fresh.Items[0],
          Fresh.Items[1],
          Fresh.Items[2] with Kind := ItemRules.ItemKind.AncientCoin; end with
        ]; end with
      ) is Error(_)
    )
  );
  Test.AssertTrue(
    (
      Fixtures.ValidateFixtureSave(
        Metadata,
        WithLocation(
          Fresh,
          Fixtures.FixtureSwordId(Metadata),
          ItemRules.ItemLocation.InInterior(Fixtures.SpawnDungeonAreaId(Metadata), JerkinField)
        )
      ) is Error(_)
    )
  );
  // Map validation: placements need distinct floor fields and distinct identities.
  var Crowded: Interior.InteriorMap := Map;
  Crowded.Items := [Map.Items[0], Map.Items[1] with Position := Map.Items[0].Position; end with];
  Test.AssertTrue((Interior.ValidateInteriorMap(Crowded) is Error(_)));
  Crowded.Items := [Map.Items[0], Map.Items[0] with Position := SwordField; end with];
  Test.AssertTrue((Interior.ValidateInteriorMap(Crowded) is Error(_)));
  Crowded.Items := [Map.Items[0] with Position := Map.Hostiles[0].Position; end with];
  Test.AssertTrue((Interior.ValidateInteriorMap(Crowded) is Error(_)));
  Crowded.Items := [Map.Items[0] with Position := Map.Start; end with];
  Test.AssertTrue((Interior.ValidateInteriorMap(Crowded) is Error(_)));
end.
