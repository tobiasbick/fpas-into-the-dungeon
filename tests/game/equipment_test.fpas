// Verifies equipment: placements, derived values, equip rules and turn costs, combat effects, and validation.
program EquipmentTest;

uses
  Dungeon.Test.Fixtures, Dungeon.Combat, Dungeon.Coordinates, Dungeon.Equipment, Dungeon.Exploration,
  Dungeon.Exploration.Sight, Dungeon.GameState, Dungeon.Hostiles, Dungeon.Interaction,
  Dungeon.Interior, Dungeon.Items, Dungeon.Terrain, Dungeon.Terrain.Placement, Std.Test;

function InDungeon(
  Metadata: WorldMetadata;
  State: GameState;
  X: integer;
  Y: integer;
  Facing: FacingDirection
): GameState;
begin
  return State with Area := AreaKind.Dungeon; AreaId := SpawnDungeonAreaId(Metadata); Player := PlayerPosition.FirstPerson(FirstPersonPose(Position := InteriorPosition(X := X, Y := Y), Facing := Facing)); ReturnLocation := ReturnLocation.ReturnTo(Metadata.OutdoorAreaId, Metadata.SpawnEntrance); end with;
end function;

// Places one item at a new location without any rule check.
function WithLocation(State: GameState; ItemId: string; Location: ItemLocation): GameState;
begin
  var Items: array of GameItem := State.Items;
  for Index: integer := 0 to Items.Length() - 1 do
    begin
      if Items[Index].Id = ItemId then
        begin
          Items[Index] := Items[Index] with Location := Location; end with;
        end;
      end if;
    end;
  end for;

  return State with Items := Items; end with;
end function;

function Continued(Outcome: TurnOutcome): GameState;
begin
  case Outcome of
    when TurnOutcome.Continued(const State, const Log, const Events):
      begin
        return State;
      end;
    when TurnOutcome.Defeated(const Log):
      begin
        panic('expected the game to continue');
      end;
  end case;
end function;

function LogOf(Outcome: TurnOutcome): array of string;
begin
  case Outcome of
    when TurnOutcome.Continued(const State, const Log, const Events):
      begin
        return Log;
      end;
    when TurnOutcome.Defeated(const Log):
      begin
        return Log;
      end;
  end case;
end function;

function EventsOf(Outcome: TurnOutcome): array of CombatEvent;
begin
  case Outcome of
    when TurnOutcome.Continued(const State, const Log, const Events):
      begin
        return Events;
      end;
    when TurnOutcome.Defeated(const Log):
      begin
        return [];
      end;
  end case;
end function;

function IsWorn(State: GameState; ItemId: string; Slot: EquipmentSlot): boolean;
begin
  case EquippedItem(State, Slot) of
    when Some(const Item):
      begin
        return Item.Id = ItemId;
      end;
    when None:
      begin
        return false;
      end;
  end case;
end function;

function Line(State: GameState; Label: string): CharacterValueLine;
begin
  for Entry: CharacterValueLine in CharacterValueLines(State) do
    begin
      if Entry.Label = Label then
        begin
          return Entry;
        end;
      end if;
    end;
  end for;

  panic('missing character line ' + Label);
end function;

// Counts the skeleton's hits over many turns while the player keeps waiting beside it.
function SkeletonHits(Metadata: WorldMetadata; Start: GameState): integer;
begin
  var State: GameState := Start;
  var Hits: integer := 0;
  for Turn: integer := 1 to 200 do
    begin
      State := State with Health := PlayerMaximumHealth; end with;
      const Outcome: TurnOutcome := ResolveTurn(FixtureViewFor(Metadata, State), State, TurnAction.Wait)
                                      .Unwrap();
      for Entry: CombatEvent in EventsOf(Outcome) do
        begin
          if Entry.Kind = CombatEventKind.HostileHit then
            begin
              Hits := Hits + 1;
              AssertTrue((Entry.Amount >= 1) and (Entry.Amount <= 4));
            end;
          end if;
        end;
      end for;

      State := Continued(Outcome);
    end;
  end for;

  return Hits;
end function;

begin
  const Metadata: WorldMetadata := NewWorldMetadata('equipment', 24680, 4).Unwrap();
  const Fresh: GameState := MaterializedFixtureState(Metadata);
  const Map: InteriorMap := FixtureDungeonMapFor(SpawnDungeonAreaId(Metadata));
  // Three items: the coin on the upper corridor, sword and jerkin off the main route.
  AssertEquals(3, Fresh.Items.Length());
  const SwordField: InteriorPosition := Map.Items[1].Position;
  const JerkinField: InteriorPosition := Map.Items[2].Position;
  AssertEquals(7, SwordField.X);
  AssertEquals(4, SwordField.Y);
  AssertEquals(1, JerkinField.X);
  AssertEquals(6, JerkinField.Y);
  // Neither item can be seen from the skeleton's resting field.
  const Rest: InteriorPosition := Fresh.Hostiles[0].Position;
  AssertFalse(HasLineOfSight(Map, Rest, SwordField) or HasLineOfSight(Map, SwordField, Rest));
  AssertFalse(HasLineOfSight(Map, Rest, JerkinField) or HasLineOfSight(Map, JerkinField, Rest));
  AssertEquals('w', InteriorVisibleCodeForState(Map, InDungeon(Metadata, Fresh, 9, 1, FacingDirection.West), SwordField)
                      .Unwrap());
  AssertEquals('a', InteriorVisibleCodeForState(Map, InDungeon(Metadata, Fresh, 9, 1, FacingDirection.West), JerkinField)
                      .Unwrap());
  AssertTrue(ItemSlot(ItemKind.AncientCoin) = None);
  AssertTrue(ItemSlot(ItemKind.RustyShortSword).Unwrap() = EquipmentSlot.Weapon);
  AssertTrue(ItemSlot(ItemKind.LeatherJerkin).Unwrap() = EquipmentSlot.Body);
  // Picking up the sword carries it without wearing it.
  const OnSword: GameState := InDungeon(Metadata, Fresh, SwordField.X, SwordField.Y, FacingDirection.South);
  AssertEquals('At your feet: Rusty short sword — Enter: Pick up', ItemInteractionHint(OnSword));
  var Carrying: GameState := OnSword;
  if Interact(FixtureViewFor(Metadata, OnSword), OnSword).Unwrap() is InteractionOutcome.StateChanged(const Changed) then
    begin
      Carrying := Changed;
    end;
  else
    begin
      panic('expected the sword to be picked up');
    end;
  end if;

  AssertEquals(1, InventoryItems(Carrying).Length());
  AssertTrue(EquippedItem(Carrying, EquipmentSlot.Weapon) = None);
  // Unarmed values: d3 damage, base hit threshold, no armor.
  const Unarmed: CharacterValues := DeriveCharacterValues(Carrying);
  AssertEquals(PlayerMaximumHealth, Unarmed.MaximumHealth);
  AssertEquals(BaseHitThreshold, Unarmed.HitThreshold);
  AssertEquals(3, Unarmed.DamageSides);
  AssertEquals(0, Unarmed.DamageBonus);
  AssertEquals(0, Unarmed.Armor);
  AssertEquals('d3', Line(Carrying, 'Damage').Value);
  AssertEquals('Unarmed', Line(Carrying, 'Damage').Source);
  AssertEquals('75% (d20 ≥ 6)', Line(Carrying, 'Hit chance').Value);
  AssertEquals('None', Line(Carrying, 'Armor').Source);
  AssertEquals(4, CharacterValueLines(Carrying).Length());
  // Equipping consumes a turn and reports it; the dice stay untouched outside combat.
  const Wield: TurnOutcome := ResolveTurn(FixtureViewFor(Metadata, Carrying), Carrying, TurnAction.Equip(FixtureSwordId(Metadata)))
                                .Unwrap();
  const Armed: GameState := Continued(Wield);
  AssertEquals('You wield the rusty short sword.', LogOf(Wield)[0]);
  AssertTrue(IsWorn(Armed, FixtureSwordId(Metadata), EquipmentSlot.Weapon));
  AssertEquals(1, InventoryItems(Armed).Length());
  AssertEquals(6, DeriveCharacterValues(Armed).DamageSides);
  AssertEquals(1, DeriveCharacterValues(Armed).DamageBonus);
  AssertEquals('d6+1', Line(Armed, 'Damage').Value);
  AssertEquals(RustyShortSwordName, Line(Armed, 'Damage').Source);
  AssertEquals(Carrying.RandomState, Armed.RandomState);
  // Rejections consume nothing: already worn, not worn, cannot be worn, not carried, unknown.
  AssertTrue(ResolveTurn(FixtureViewFor(Metadata, Armed), Armed, TurnAction.Equip(FixtureSwordId(Metadata)))
               .IsError());
  AssertTrue(ResolveTurn(FixtureViewFor(Metadata, Carrying), Carrying, TurnAction.Unequip(FixtureSwordId(Metadata)))
               .IsError());
  AssertTrue(ResolveTurn(FixtureViewFor(Metadata, Armed), Armed, TurnAction.Equip(FixtureJerkinId(Metadata)))
               .IsError());
  AssertTrue(ResolveTurn(FixtureViewFor(Metadata, Armed), Armed, TurnAction.Equip('unknown:item'))
               .IsError());
  const CoinCarried: GameState := WithLocation(Armed, FixtureCoinId(Metadata), ItemLocation.CarriedByPlayer);
  AssertTrue(ResolveTurn(FixtureViewFor(Metadata, CoinCarried), CoinCarried, TurnAction.Equip(FixtureCoinId(Metadata)))
               .IsError());
  // Unequipping returns the sword to the inventory.
  const PutAway: TurnOutcome := ResolveTurn(FixtureViewFor(Metadata, Armed), Armed, TurnAction.Unequip(FixtureSwordId(Metadata)))
                                  .Unwrap();
  AssertEquals('You put away the rusty short sword.', LogOf(PutAway)[0]);
  AssertTrue(EquippedItem(Continued(PutAway), EquipmentSlot.Weapon) = None);
  AssertEquals(1, InventoryItems(Continued(PutAway)).Length());
  // The jerkin adds armor; its slot is independent of the weapon slot.
  const BothCarried: GameState := WithLocation(Armed, FixtureJerkinId(Metadata), ItemLocation.CarriedByPlayer);
  const Dressed: GameState := Continued(ResolveTurn(FixtureViewFor(Metadata, BothCarried), BothCarried, TurnAction.Equip(FixtureJerkinId(Metadata)))
                                          .Unwrap());
  AssertTrue(IsWorn(Dressed, FixtureJerkinId(Metadata), EquipmentSlot.Body));
  AssertTrue(IsWorn(Dressed, FixtureSwordId(Metadata), EquipmentSlot.Weapon));
  AssertEquals(2, DeriveCharacterValues(Dressed).Armor);
  AssertEquals('2', Line(Dressed, 'Armor').Value);
  AssertEquals(LeatherJerkinName, Line(Dressed, 'Armor').Source);
  const TakenOff: TurnOutcome := ResolveTurn(FixtureViewFor(Metadata, Dressed), Dressed, TurnAction.Unequip(FixtureJerkinId(Metadata)))
                                   .Unwrap();
  AssertEquals('You take off the leather jerkin.', LogOf(TakenOff)[0]);
  // Equipping outdoors works too; no opponent acts there.
  const Outdoors: GameState := WithLocation(Fresh, FixtureSwordId(Metadata), ItemLocation.CarriedByPlayer);
  AssertTrue(IsWorn(Continued(ResolveTurn(FixtureViewFor(Metadata, Outdoors), Outdoors, TurnAction.Equip(FixtureSwordId(Metadata)))
                                .Unwrap()), FixtureSwordId(Metadata), EquipmentSlot.Weapon));
  // Changing gear beside an alerted skeleton gives it a turn to strike.
  const Beside: GameState := InDungeon(Metadata, BothCarried, 4, 3, FacingDirection.West) with Hostiles := [
                                                                                                             Fresh.Hostiles[0] with Alerted := true; end with
                                                                                                           ]; end with;
  const Exposed: TurnOutcome := ResolveTurn(FixtureViewFor(Metadata, Beside), Beside, TurnAction.Equip(FixtureJerkinId(Metadata)))
                                  .Unwrap();
  AssertEquals('You put on the leather jerkin.', LogOf(Exposed)[0]);
  AssertEquals(2, LogOf(Exposed).Length());
  AssertTrue(LogOf(Exposed)[1].Contains('skeleton'));
  AssertEquals(1, EventsOf(Exposed).Length());
  AssertTrue(Continued(Exposed).RandomState <> Beside.RandomState);
  // Armor lowers the skeleton's hits over the same number of turns.
  const Unprotected: GameState := Beside;
  const Protected: GameState := Continued(Exposed) with RandomState := Beside.RandomState; end with;
  const HitsWithout: integer := SkeletonHits(Metadata, Unprotected);
  const HitsWith: integer := SkeletonHits(Metadata, Protected);
  AssertTrue(HitsWithout > 0);
  AssertTrue(HitsWith < HitsWithout);
  // Blows report structured events whose damage follows the wielded weapon.
  var SawArmedHit: boolean := false;
  var SawUnarmedHit: boolean := false;
  for Weapon: integer := 0 to 1 do
    begin
      // Beside wears the sword; the unarmed round puts it away first.
      var Attacker: GameState := Beside;
      if Weapon = 0 then
        begin
          Attacker := WithLocation(Beside, FixtureSwordId(Metadata), ItemLocation.CarriedByPlayer);
        end;
      end if;

      for Turn: integer := 1 to 30 do
        begin
          const Target: GameHostile := Attacker.Hostiles[0] with Health := RestlessSkeletonMaximumHealth; end with;

          Attacker := Attacker with Health := PlayerMaximumHealth; Hostiles := [Target]; end with;
          const Blow: TurnOutcome := ResolveTurn(FixtureViewFor(Metadata, Attacker), Attacker, TurnAction.Attack)
                                       .Unwrap();
          AssertTrue(EventsOf(Blow).Length() >= 1);
          const First: CombatEvent := EventsOf(Blow)[0];
          AssertTrue((First.Kind = CombatEventKind.PlayerHit) or
                     (First.Kind = CombatEventKind.PlayerMiss));
          if First.Kind = CombatEventKind.PlayerHit then
            begin
              if Weapon = 1 then
                begin
                  AssertTrue((First.Amount >= 2) and (First.Amount <= 7));
                  SawArmedHit := true;
                end;
              else
                begin
                  AssertTrue((First.Amount >= 1) and (First.Amount <= 3));
                  SawUnarmedHit := true;
                end;
              end if;
            end;
          else
            begin
              AssertEquals(0, First.Amount);
            end;
          end if;

          Attacker := Continued(Blow);
        end;
      end for;
    end;
  end for;

  AssertTrue(SawArmedHit);
  AssertTrue(SawUnarmedHit);
  // Validation: every known item exactly once, worn only in a fitting and free slot.
  AssertTrue(ValidateFixtureSave(Metadata, Dressed).IsOk());
  AssertTrue(ValidateFixtureSave(Metadata, WithLocation(Fresh, FixtureCoinId(Metadata), ItemLocation.EquippedByPlayer(EquipmentSlot.Weapon)))
               .IsError());
  AssertTrue(ValidateFixtureSave(Metadata, WithLocation(Fresh, FixtureSwordId(Metadata), ItemLocation.EquippedByPlayer(EquipmentSlot.Body)))
               .IsError());
  const TwoBodies: GameState := WithLocation(WithLocation(Fresh, FixtureJerkinId(Metadata), ItemLocation.EquippedByPlayer(EquipmentSlot.Body)), FixtureSwordId(Metadata), ItemLocation.EquippedByPlayer(EquipmentSlot.Body));
  AssertTrue(ValidateFixtureSave(Metadata, TwoBodies).IsError());
  AssertTrue(ValidateFixtureSave(Metadata, Fresh with Items := [Fresh.Items[0], Fresh.Items[1]]; end with)
               .IsError());
  AssertTrue(ValidateFixtureSave(Metadata, Fresh with Items := [
                                                                 Fresh.Items[0],
                                                                 Fresh.Items[1],
                                                                 Fresh.Items[1]
                                                               ]; end with)
               .IsError());
  AssertTrue(ValidateFixtureSave(Metadata, Fresh with Items := [
                                                                 Fresh.Items[0],
                                                                 Fresh.Items[1],
                                                                 Fresh.Items[2] with Kind := ItemKind.AncientCoin; end with
                                                               ]; end with)
               .IsError());
  AssertTrue(ValidateFixtureSave(Metadata, WithLocation(Fresh, FixtureSwordId(Metadata), ItemLocation.InInterior(SpawnDungeonAreaId(Metadata), JerkinField)))
               .IsError());
  // Map validation: placements need distinct floor fields and distinct identities.
  var Crowded: InteriorMap := Map;
  Crowded.Items := [Map.Items[0], Map.Items[1] with Position := Map.Items[0].Position; end with];
  AssertTrue(ValidateInteriorMap(Crowded).IsError());
  Crowded.Items := [Map.Items[0], Map.Items[0] with Position := SwordField; end with];
  AssertTrue(ValidateInteriorMap(Crowded).IsError());
  Crowded.Items := [Map.Items[0] with Position := Map.Hostiles[0].Position; end with];
  AssertTrue(ValidateInteriorMap(Crowded).IsError());
  Crowded.Items := [Map.Items[0] with Position := Map.Start; end with];
  AssertTrue(ValidateInteriorMap(Crowded).IsError());
end.
