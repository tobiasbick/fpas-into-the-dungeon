// Real client adapter delivers world catalogs, creation states, confirmed saves and selection replies.
program WorldClientNetworkTest;

uses
  Dungeon.Client, Dungeon.Protocol, Dungeon.Protocol.Worlds, Dungeon.Server, Dungeon.Server.Config,
  Dungeon.Test.ClientSession, Dungeon.World, Std.Conv, Std.Fs, Std.Net, Std.Tasks, Std.Test,
  Std.Time;

function ServeReported(
  ListenerValue: Listener;
  Config: ServerConfig;
  Outcomes: channel of string;
  Token: CancellationToken
): result of (boolean, string);
begin
  const Client: Connection := try AcceptWithCancellation(ListenerValue, Token);
  const Outcome: result of (boolean, string) := ServeConnection(Client, Config, Token);
  discard Close(Client);
  ReportOutcome(Outcomes, 'server', Outcome);
  return Outcome;
end function;

begin
  const Root: string := '.temp-data/world-adapter-' + IntToStr(TimestampMillis());
  AssertTrue(Std.Fs.CreateDirAll(Root).Unwrap());
  const Config: ServerConfig := ServerConfig(ConfigPath := '', Logs := None, WorldsRoot := Root, WorldId := 'missing', WorldSeed := 12345, DungeonRegionChunks := 4, ChunkCacheLimit := 32, MaximumViewWidth := 80, MaximumViewHeight := 24);
  const Token: CancellationToken := GetCancellationToken(CreateCancellationSource());
  const ListenerValue: Listener := Listen('127.0.0.1', 0).Unwrap();
  const Address: NetworkAddress := ListenerLocalAddress(ListenerValue).Unwrap();
  const Outcomes: channel of string := CreateChannel(4);
  const Requests: channel of ClientMessage := CreateChannel(8);
  const Events: channel of ClientEvent := CreateChannel(8);
  const ServerWorker: task := go ServeReported(ListenerValue, Config, Outcomes, Token);
  const ClientWorker: task := go RunReportedClient('127.0.0.1', Address.Port, 9, 5, Requests, Events, Outcomes, Token);
  if NextClientEvent(Events, Outcomes, 30000) is ClientEvent.Connected(const Catalog) then
    begin
      AssertEquals(0, Catalog.Total);
    end;
  else
    begin
      panic('expected initial catalog');
    end;
  end if;

  AssertTrue(Send(Requests, ClientMessage.CreateWorld(12345, 4)).Unwrap());
  if NextClientEvent(Events, Outcomes, 30000) is ClientEvent.State(const Value) then
    begin
      null;
    end;
  else
    begin
      panic('expected creation state');
    end;
  end if;

  AssertTrue(Send(Requests, ClientMessage.SaveGame).Unwrap());
  if NextClientEvent(Events, Outcomes, 30000) is ClientEvent.SaveCompleted then
    begin
      null;
    end;
  else
    begin
      panic('expected first save');
    end;
  end if;

  AssertTrue(Send(Requests, ClientMessage.SaveGame).Unwrap());
  if NextClientEvent(Events, Outcomes, 30000) is ClientEvent.Rejected(const Code, const Message) then
    begin
      AssertEquals('overwrite_required', Code);
    end;
  else
    begin
      panic('expected overwrite guard');
    end;
  end if;

  AssertTrue(Send(Requests, ClientMessage.OverwriteSaveGame).Unwrap());
  if NextClientEvent(Events, Outcomes, 30000) is ClientEvent.SaveCompleted then
    begin
      null;
    end;
  else
    begin
      panic('expected confirmed save');
    end;
  end if;

  AssertTrue(Send(Requests, ClientMessage.ListWorlds(0, false)).Unwrap());
  if NextClientEvent(Events, Outcomes, 30000) is ClientEvent.Worlds(const Catalog) then
    begin
      AssertEquals(1, Catalog.Total);
      AssertEquals('world-1', Catalog.SelectedId);
    end;
  else
    begin
      panic('expected connected menu');
    end;
  end if;

  AssertTrue(Send(Requests, ClientMessage.SelectWorld('world-1')).Unwrap());
  if NextClientEvent(Events, Outcomes, 30000) is ClientEvent.Worlds(const Catalog) then
    begin
      AssertTrue(CanContinueWorld(Catalog));
    end;
  else
    begin
      panic('expected selection catalog');
    end;
  end if;

  AssertTrue(Send(Requests, ClientMessage.LoadGame).Unwrap());
  if NextClientEvent(Events, Outcomes, 30000) is ClientEvent.State(const Value) then
    begin
      null;
    end;
  else
    begin
      panic('expected continued state');
    end;
  end if;

  AssertTrue(Send(Requests, ClientMessage.Disconnect).Unwrap());
  AssertTrue(Std.Tasks.Wait(ClientWorker).Unwrap());
  AssertTrue(Std.Tasks.Wait(ServerWorker).Unwrap());
  AssertTrue(CloseListener(ListenerValue).Unwrap());
  discard CloseChannel(Requests);
  discard CloseChannel(Events);
  discard CloseChannel(Outcomes);
end.
