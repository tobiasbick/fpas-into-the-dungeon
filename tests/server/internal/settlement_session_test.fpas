// Proves bounded settlement requests, finite projection and atomic dialogue retries on a live socket.
program SettlementSessionTest;

uses
  Dungeon.Settlements.Generation as Villages, Dungeon.Settlements.Sites as Sites, Dungeon.Areas as Areas, Dungeon.Quests.Model as QuestModel, Dungeon.Items as Items, Dungeon.World.Interiors as Interiors, Dungeon.Areas.Identities as Identities, Dungeon.Terrain.Entrances as Entrances, Dungeon.Coordinates as Coordinates, Dungeon.Dialogue as Dialogue, Dungeon.Exploration as Exploration,
  Dungeon.GameState as GameState, Dungeon.Movement as Movement, Dungeon.Protocol as Protocol, Dungeon.Protocol.ClientMessages as Clients,
  Dungeon.Protocol.ServerMessages as Servers, Dungeon.Protocol.Transport as Transport,
  Dungeon.Server.Config as ConfigUnit, Dungeon.Server.Handling as Handling, Dungeon.Server.Projection as Projection,
  Dungeon.Server.Session as SessionUnit, Dungeon.Test.SessionAssertions as Sessions,
  Dungeon.Terrain.Placement as Placement, Dungeon.World as WorldUnit, Std.Json.Fields as JsonFields, Std.Fs as Fs, Std.Net as Net, Std.Tasks as Tasks, Std.Test as Test;

function Recognition(View: GameState.AreaView; State: GameState.GameState): boolean;
begin
  case Dialogue.Start(
    View, State with Player := Coordinates.PlayerPosition.Settlement(
      Coordinates.InteriorPosition(X := 16, Y := 8)
    ); end with
  ).Unwrap() of
    when Dialogue.Outcome.Continued(_, const Frame, _):
      return 'Hearthmoor remembers your help.' in Frame.Text;
    when Dialogue.Outcome.Ended(_):
      panic('expected home recognition dialogue');
  end case;
end function;

function CurrentDialogue(Session: SessionUnit.ServerSession): Dialogue.Frame;
begin
  case Session.ActiveInteraction of
    when Some(SessionUnit.ActiveInteraction.Dialogue(const Frame)):
      return Frame;
    when None, Some(SessionUnit.ActiveInteraction.Trade(_)):
      panic('expected a conversation');
  end case;
end function;

begin
  const Metadata := Placement.NewWorldMetadata('settlement-session', 12345, 4).Unwrap();
  const Entry := Movement.ActivateAreaTransition(
    GameState.AreaView(Metadata := Metadata, Interior := None),
    GameState.NewGame(Metadata) with Player := Coordinates.PlayerPosition.Outdoor(
      Metadata.SettlementGate
    ); end with,
    None
  ).Unwrap();
  const Near := Exploration.RevealCurrentArea(
    Entry.View,
    Entry.State with Player := Coordinates.PlayerPosition.Settlement(
      Coordinates.InteriorPosition(X := 11, Y := 8)
    ); Health := 3; end with
  ).Unwrap();
  const World := WorldUnit.WorldSession(
    Directory := '.temp-data/unused-settlement-projection',
    Metadata := Metadata, Cache := [], Clock := 0, CacheLimit := 32
  );
  Test.AssertEquals(0, Near.Exploration.OutdoorChunks.Length());
  const Whole := Projection.ProjectExplorationMap(Near, Entry.View, -1, -1, 25, 17).Unwrap();
  Test.AssertEquals('Hearthmoor', Whole.LabelText);
  Test.AssertTrue(Whole.View = Protocol.ViewKind.Map);
  Test.AssertEquals('?', Whole.Rows[0][0]);
  Test.AssertEquals('n', Whole.Rows[8][12]);
  Test.AssertEquals('v', Whole.KnowledgeRows[8][12]);
  Test.AssertEquals('x', Whole.Rows[14][12]);
  const Far := Exploration.RevealCurrentArea(
    Entry.View,
    Near with Player := Coordinates.PlayerPosition.Settlement(
      Coordinates.InteriorPosition(X := 1, Y := 1)
    ); end with
  ).Unwrap();
  const Remembered := Projection.ProjectExplorationMap(Far, Entry.View, 11, 7, 1, 1).Unwrap();
  Test.AssertEquals('.', Remembered.Rows[0]);
  Test.AssertEquals('r', Remembered.KnowledgeRows[0]);
  const Projected := Projection.ProjectSession(
    World, Entry.View, Near,
    SessionUnit.ViewportSize(Width := 80, Height := 24), Projection.NoTurnReport()
  ).Unwrap();
  Test.AssertEquals(0, Projected.World.Cache.Length());
  Test.AssertEquals(0, Projected.World.Clock);
  case Projected.State of
    when Protocol.VisibleState.MapState(const Map):
      Test.AssertEquals(23, Map.Width);
      Test.AssertEquals(15, Map.Height);
      Test.AssertEquals(0, Map.OriginX);
      Test.AssertEquals(0, Map.OriginY);
      Test.AssertEquals('Mara — Enter: Talk', Map.Status);
    when Protocol.VisibleState.FirstPersonState(_):
      panic('settlement must stay a map');
  end case;
  const Listener := Net.Listen('127.0.0.1', 0).Unwrap();
  const Client := Net.Connect(
    '127.0.0.1',
    Net.ListenerLocalAddress(Listener).Unwrap().Port,
    5000
  ).Unwrap();
  const Server := Net.Accept(Listener).Unwrap();
  discard Net.CloseListener(Listener).Unwrap();
  discard Net.SetTimeout(Client, 5000).Unwrap();
  const Token := Tasks.GetCancellationToken(Tasks.CreateCancellationSource());
  const Config := ConfigUnit.ServerConfig(
    ConfigPath := '', Logs := None,
    WorldsRoot := '.temp-data/unused-settlement-projection', WorldId := Metadata.Id,
    WorldSeed := 12345, DungeonRegionChunks := 4, ChunkCacheLimit := 32,
    MaximumViewWidth := 80, MaximumViewHeight := 24
  );
  var Session := SessionUnit.ServerSession(
    World := World, WorldSelected := true,
    State := Some(Near), Interior := Entry.View.Interior, Dirty := false,
    LastSavedAt := 42, Finished := false,
    Viewport := SessionUnit.ViewportSize(Width := 23, Height := 15)
  );
  // Untrusted deltas must reject before arithmetic, including values valid in JSON's integer range.
  for Message: Protocol.ClientMessage in [
    Protocol.ClientMessage.Move(-9223372036854775808, 0),
    Protocol.ClientMessage.Move(0, -9223372036854775808),
    Protocol.ClientMessage.Move(8000000000000000000, 8000000000000000000),
    Protocol.ClientMessage.Move(2, 0)
  ] do
    discard Transport.WriteLine(Client, Clients.EncodeClient(Message), Token).Unwrap();
    const Request := Transport.ReadLine(Transport.NewLineReader(Server), Token).Unwrap();
    const Rejected := Handling.HandleSessionMessage(
      Session, Clients.DecodeClient(Request.Line).Unwrap(), Server, Config, Token
    ).Unwrap();
    const Reply := Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
    Test.AssertTrue(
      Servers.DecodeServer(Reply.Line).Unwrap() is Protocol.ServerMessage.Rejected('movement_rejected', 'movement must be one cardinal step')
    );
    Sessions.AssertUnchanged(Session, Rejected);
  end for;

  // A valid interaction on the same socket must still start the conversation after these rejections.
  Session := Handling.HandleSessionMessage(
    Session,
    Protocol.ClientMessage.Interact,
    Server,
    Config,
    Token
  ).Unwrap();
  const Started := Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Test.AssertTrue(
    Servers.DecodeServer(Started.Line).Unwrap() is Protocol.ServerMessage.Dialogue(_, _, true)
  );
  Session.Dirty := false;
  const Frame := CurrentDialogue(Session);
  const Broken := Session with Viewport := SessionUnit.ViewportSize(Width := 0, Height := 1); end with;
  const Failed := Handling.HandleSessionMessage(
    Broken,
    Protocol.ClientMessage.DialogueChoice(Frame.NpcId, 'identity'), Server, Config, Token
  ).Unwrap();
  const Rejection := Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Test.AssertTrue(
    Servers.DecodeServer(Rejection.Line).Unwrap() is Protocol.ServerMessage.Rejected('dialogue_rejected', _)
  );
  Sessions.AssertUnchanged(Broken, Failed);
  const Resized := Handling.HandleSessionMessage(
    Session,
    Protocol.ClientMessage.Viewport(9, 5),
    Server,
    Config,
    Token
  ).Unwrap();
  const ResizeReply := Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Test.AssertTrue(
    Servers.DecodeServer(ResizeReply.Line).Unwrap() is Protocol.ServerMessage.State(_)
  );
  Sessions.AssertUnchanged(Session with Viewport := Resized.Viewport; end with, Resized);
  const Answered := Handling.HandleSessionMessage(
    Resized,
    Protocol.ClientMessage.DialogueChoice(Frame.NpcId, 'identity'), Server, Config, Token
  ).Unwrap();
  const AnswerReply := Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Test.AssertTrue(
    Servers.DecodeServer(AnswerReply.Line).Unwrap() is Protocol.ServerMessage.Dialogue(_, _, false)
  );
  Test.AssertEquals(3, Answered.State.Unwrap().Health);
  Test.AssertEquals(42, Answered.LastSavedAt);
  Test.AssertEquals(Frame.Choices.Length(), CurrentDialogue(Answered).Choices.Length());
  // The offered objective is retained across failed acceptance preparation.
  const Offered := Handling.HandleSessionMessage(
    Answered with Dirty := false; end with,
    Protocol.ClientMessage.DialogueChoice(Frame.NpcId, 'quest'), Server, Config, Token
  ).Unwrap();
  discard Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Test.AssertTrue(CurrentDialogue(Offered).Node is Dialogue.Node.CompassOffer(_));
  Test.AssertFalse(Offered.Dirty);
  const BrokenOffer := Offered with Viewport := SessionUnit.ViewportSize(Width := 0, Height := 1); end with;
  const FailedAccept := Handling.HandleSessionMessage(
    BrokenOffer,
    Protocol.ClientMessage.DialogueChoice(Frame.NpcId, 'quest_accept'), Server, Config, Token
  ).Unwrap();
  discard Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Sessions.AssertUnchanged(BrokenOffer, FailedAccept);
  const Accepted := Handling.HandleSessionMessage(
    Offered,
    Protocol.ClientMessage.DialogueChoice(Frame.NpcId, 'quest_accept'), Server, Config, Token
  ).Unwrap();
  discard Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Test.AssertTrue(Accepted.State.Unwrap().Quest is QuestModel.QuestState.Active(_));
  Test.AssertTrue(Accepted.Dirty);
  // Complete in-memory rule input for report preparation, without claiming a persisted visit.
  var ReadyState := Accepted.State.Unwrap();
  const Region := Entrances.RegionOf(Metadata, Metadata.Spawn);
  for Level: integer := 0 to 2 do
    const Map := Interiors.PreviewLevel(
      World,
      Identities.DungeonAreaId(Metadata, Region, Level),
      3
    ).Unwrap();
    ReadyState := Areas.MaterializeArea(ReadyState, Map);
  end for;

  for Index: integer := 0 to ReadyState.Items.Length() - 1 do
    if ReadyState.Items[Index].Kind = Items.ItemKind.MarasCompass then
      ReadyState.Items[Index].Location := Items.ItemLocation.CarriedByPlayer;
    end if;
  end for;
  var ReadySession := Accepted with State := Some(ReadyState); end with;

  ReadySession := Handling.HandleSessionMessage(
    ReadySession,
    Protocol.ClientMessage.DialogueChoice(Frame.NpcId, 'quest_back'), Server, Config, Token
  ).Unwrap();
  discard Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  ReadySession := Handling.HandleSessionMessage(
    ReadySession,
    Protocol.ClientMessage.DialogueChoice(Frame.NpcId, 'quest'), Server, Config, Token
  ).Unwrap();
  discard Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  ReadySession.Dirty := false;
  const BrokenReport := ReadySession with Viewport := SessionUnit.ViewportSize(
    Width := 0,
    Height := 1
  ); end with;
  const FailedReport := Handling.HandleSessionMessage(
    BrokenReport,
    Protocol.ClientMessage.DialogueChoice(Frame.NpcId, 'quest_report'), Server, Config, Token
  ).Unwrap();
  discard Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Sessions.AssertUnchanged(BrokenReport, FailedReport);
  Test.AssertFalse(Recognition(Entry.View, FailedReport.State.Unwrap()));
  const Rewarded := Handling.HandleSessionMessage(
    ReadySession,
    Protocol.ClientMessage.DialogueChoice(Frame.NpcId, 'quest_report'), Server, Config, Token
  ).Unwrap();
  discard Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Test.AssertTrue(Rewarded.State.Unwrap().Quest is QuestModel.QuestState.Rewarded(_));
  Test.AssertTrue(Rewarded.Dirty);
  Test.AssertTrue(Recognition(Entry.View, Rewarded.State.Unwrap()));
  const DuplicateReport := Handling.HandleSessionMessage(
    Rewarded,
    Protocol.ClientMessage.DialogueChoice(Frame.NpcId, 'quest_report'), Server, Config, Token
  ).Unwrap();
  discard Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Sessions.AssertUnchanged(Rewarded, DuplicateReport);
  // Paid rest and first meeting obey the same prepare/send/install boundary.
  const VillageMetadata := Placement.NewWorldMetadata('village-session', 25, 1).Unwrap();
  const VillageRegion := Coordinates.ChunkCoordinate(X := 85, Y := -83);
  const Village := Villages.GenerateMap(VillageMetadata, VillageRegion).Unwrap();
  const Innkeeper := Village.Npcs[2];
  const VillageState := Areas.MaterializeArea(GameState.NewGame(VillageMetadata), Village) with Area := Coordinates.AreaKind.Settlement; AreaId := Village.AreaId; Player := Coordinates.PlayerPosition.Settlement(
    Coordinates.InteriorPosition(
      X := Innkeeper.Position.X, Y := Innkeeper.Position.Y + 1
    )
  ); ReturnLocation := Coordinates.ReturnLocation.ReturnTo(
    VillageMetadata.OutdoorAreaId,
    Sites.Site(VillageMetadata, VillageRegion).Unwrap()
  ); Health := 3; Coins := 5; WorldMinutes := 2160; end with;
  const VillageSession := Session with World := World with Metadata := VillageMetadata; end with; State := Some(
    VillageState
  ); Interior := Some(Village); ActiveInteraction := None; Dirty := false; end with;
  const BadGreeting := VillageSession with Viewport := Broken.Viewport; end with;
  const FailedGreeting := Handling.HandleSessionMessage(
    BadGreeting, Protocol.ClientMessage.Interact,
    Server, Config, Token
  ).Unwrap();
  discard Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Sessions.AssertUnchanged(BadGreeting, FailedGreeting);
  const Talking := Handling.HandleSessionMessage(
    VillageSession, Protocol.ClientMessage.Interact,
    Server, Config, Token
  ).Unwrap();
  discard Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Test.AssertEquals(Innkeeper.Id, CurrentDialogue(Talking).NpcId);
  const InnOffer := Handling.HandleSessionMessage(
    Talking with Dirty := false; end with,
    Protocol.ClientMessage.DialogueChoice(Innkeeper.Id, 'rest'), Server, Config, Token
  ).Unwrap();
  discard Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Test.AssertFalse(InnOffer.Dirty);
  const BadRest := InnOffer with Viewport := Broken.Viewport; end with;
  const FailedRest := Handling.HandleSessionMessage(
    BadRest,
    Protocol.ClientMessage.DialogueChoice(Innkeeper.Id, 'rest_confirm'), Server, Config, Token
  ).Unwrap();
  discard Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Sessions.AssertUnchanged(BadRest, FailedRest);
  const Rested := Handling.HandleSessionMessage(
    InnOffer,
    Protocol.ClientMessage.DialogueChoice(Innkeeper.Id, 'rest_confirm'), Server, Config, Token
  ).Unwrap();
  const RestReply := Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Test.AssertTrue(
    Servers.DecodeServer(RestReply.Line).Unwrap() is Protocol.ServerMessage.Dialogue(_, _, true)
  );
  Test.AssertEquals(0, Rested.State.Unwrap().Coins);
  Test.AssertEquals(20, Rested.State.Unwrap().Health);
  Test.AssertEquals(2640, Rested.State.Unwrap().WorldMinutes);
  Test.AssertEquals(
    'rain', JsonFields.StringField(
      JsonFields.ObjectField(JsonFields.ParseObject(RestReply.Line).Unwrap(), 'state').Unwrap(),
      'weather'
    ).Unwrap()
  );
  Test.AssertEquals(42, Rested.LastSavedAt);
  const Replay := Handling.HandleSessionMessage(
    Rested,
    Protocol.ClientMessage.DialogueChoice(Innkeeper.Id, 'rest_confirm'), Server, Config, Token
  ).Unwrap();
  discard Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Sessions.AssertUnchanged(Rested, Replay);
  const WrongQuest := Handling.HandleSessionMessage(
    Talking,
    Protocol.ClientMessage.DialogueChoice(Innkeeper.Id, 'quest'), Server, Config, Token
  ).Unwrap();
  const WrongQuestReply := Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Test.AssertTrue(
    Servers.DecodeServer(WrongQuestReply.Line).Unwrap() is Protocol.ServerMessage.Rejected('dialogue_rejected', _)
  );
  Sessions.AssertUnchanged(Talking, WrongQuest);
  // Clock refusal precedes immutable generated-area creation as well as mutable state changes.
  const LimitWorld := WorldUnit.OpenWorld(Test.ScratchDir(), 'clock-limit', 25, 1, 32).Unwrap();
  const LimitState := GameState.NewGame(LimitWorld.Metadata) with WorldMinutes := 1000000000; Player := Coordinates.PlayerPosition.Outdoor(
    Sites.Site(LimitWorld.Metadata, VillageRegion).Unwrap()
  ); end with;
  const AtLimit := VillageSession with World := LimitWorld; State := Some(LimitState); Interior := None; ActiveInteraction := None; end with;

  Test.AssertFalse(Fs.Exists(LimitWorld.Directory + '/settlements'));
  const Refused := Handling.HandleSessionMessage(
    AtLimit, Protocol.ClientMessage.Interact,
    Server, Config, Token
  ).Unwrap();
  const Refusal := Transport.ReadLine(Transport.NewLineReader(Client), Token).Unwrap();
  Test.AssertTrue(
    Servers.DecodeServer(Refusal.Line).Unwrap() is Protocol.ServerMessage.Rejected('interaction_rejected', _)
  );
  Sessions.AssertUnchanged(AtLimit, Refused);
  Test.AssertFalse(Fs.Exists(LimitWorld.Directory + '/settlements'));
  discard Net.Close(Server).Unwrap();
  Test.AssertTrue(
    Handling.HandleSessionMessage(
      InnOffer,
      Protocol.ClientMessage.DialogueChoice(Innkeeper.Id, 'rest_confirm'), Server, Config, Token
    ) is Error(_)
  );
  Test.AssertEquals(3, Talking.State.Unwrap().Health);
  Test.AssertTrue(
    Handling.HandleSessionMessage(
      Resized,
      Protocol.ClientMessage.DialogueChoice(Frame.NpcId, 'identity'), Server, Config, Token
    ) is Error(_)
  );
  Test.AssertEquals(3, Resized.State.Unwrap().Health);
  Test.AssertFalse(Resized.Dirty);
  Test.AssertEquals(Frame.Text, CurrentDialogue(Resized).Text);
  discard Net.Close(Client).Unwrap();
end.
