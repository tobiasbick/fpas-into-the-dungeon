// Verifies retained server geometry across projection, viewport changes, turns, and defeat.
program SessionMapTest;

uses
  Dungeon.Combat, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interior, Dungeon.Protocol,
  Dungeon.Protocol.ServerMessages, Dungeon.Protocol.Transport, Dungeon.Server.Config,
  Dungeon.Server.Handling, Dungeon.Server.Projection, Dungeon.Server.Replies, Dungeon.Server.Session,
  Dungeon.Terrain, Dungeon.Test.Fixtures, Dungeon.World, Std.Net, Std.Tasks, Std.Test;

function Receive(Client: Connection; Token: CancellationToken): ServerMessage;
begin
  const Response: LineRead := ReadLine(NewLineReader(Client), Token).Unwrap();
  return DecodeServer(Response.Line).Unwrap();
end function;

procedure AssertProjectedExit(Value: VisibleState);
begin
  if Value is VisibleState.FirstPersonState(const Fields) then
    begin
      AssertEquals('x', Fields.Rows[2].CharAt(8));
      AssertEquals('Press Enter to return to the outdoor region.', Fields.Status);
    end;
  else
    begin
      panic('expected the retained interior projection');
    end;
  end if;
end procedure;

begin
  const Metadata: WorldMetadata := FixtureMetadata();
  var Map: InteriorMap := FixtureDungeonMap();
  Map.Cells[Map.Exit.Y * Map.Width + Map.Exit.X] := InteriorCellKind.Floor;
  Map.Cells[2 * Map.Width + 8] := InteriorCellKind.ExitField;
  Map.Exit := InteriorPosition(X := 8, Y := 2);
  Map := ValidateInteriorMap(Map).Unwrap();
  const State: GameState := FixtureDungeonState(Map.Exit, FacingDirection.West);
  const World: WorldSession := WorldSession(Directory := '.temp-data/unused-session-map', Metadata := Metadata, Cache := [], Clock := 0, CacheLimit := 32);
  const Session: ServerSession := ServerSession(World := World, WorldSelected := true, Dirty := false, State := Some(State), Interior := Some(Map), Viewport := ViewportSize(Width := 20, Height := 12), Finished := false);
  const View: AreaView := SessionAreaView(Session, State).Unwrap();
  AssertTrue(View.Interior.Unwrap().Exit = Map.Exit);
  const Projected: SessionProjection := ProjectSession(World, View, State, Session.Viewport, NoTurnReport())
                                          .Unwrap();
  AssertProjectedExit(Projected.State);
  const Overlay: ExplorationMapState := ProjectExplorationMap(State, View, 0, 0, Map.Width, Map.Height)
                                          .Unwrap();
  AssertEquals('x', Overlay.Rows[2].CharAt(8));
  AssertTrue(SessionAreaView(Session with Interior := None; end with, State).IsError());
  AssertTrue(SessionAreaView(Session with Interior := Some(Map with AreaId := 'wrong-area'; end with); end with, State)
               .IsError());
  AssertTrue(ProjectSession(World, AreaView(Metadata := Metadata, Interior := None), State, Session.Viewport, NoTurnReport())
               .IsError());
  const ListenerValue: Listener := Listen('127.0.0.1', 0).Unwrap();
  const Address: NetworkAddress := ListenerLocalAddress(ListenerValue).Unwrap();
  const Client: Connection := Connect('127.0.0.1', Address.Port, 2000).Unwrap();
  const Server: Connection := Accept(ListenerValue).Unwrap();
  AssertTrue(CloseListener(ListenerValue).Unwrap());
  AssertTrue(SetTimeout(Client, 2000).Unwrap());
  AssertTrue(SetTimeout(Server, 2000).Unwrap());
  const Source: CancellationSource := CreateCancellationSource();
  const Token: CancellationToken := GetCancellationToken(Source);
  const Config: ServerConfig := ServerConfig(ConfigPath := '', Logs := None, WorldsRoot := '.temp-data/unused-session-map', WorldId := Metadata.Id, WorldSeed := Metadata.Seed, DungeonRegionChunks := 4, ChunkCacheLimit := 32, MaximumViewWidth := 80, MaximumViewHeight := 24);
  const Resized: ServerSession := HandleSessionMessage(Session, ClientMessage.Viewport(40, 20), Server, Config, Token)
                                    .Unwrap();
  AssertEquals(40, Resized.Viewport.Width);
  AssertTrue(Resized.Interior.Unwrap().Exit = Map.Exit);
  if Receive(Client, Token) is ServerMessage.State(const Fields) then
    begin
      AssertProjectedExit(Fields);
    end;
  else
    begin
      panic('viewport update must project the retained map');
    end;
  end if;
  const Committed: ServerSession := CommitState(Resized, State, Server, Token).Unwrap();
  AssertTrue(Committed.Interior.Unwrap().Exit = Map.Exit);
  if Receive(Client, Token) is ServerMessage.State(const Fields) then
    begin
      AssertProjectedExit(Fields);
    end;
  else
    begin
      panic('accepted state must retain the supplied map');
    end;
  end if;
  const Waited: ServerSession := PlayTurn(Committed, TurnAction.Wait, 'wait_rejected', Server, Token, None)
                                   .Unwrap();
  AssertTrue(Waited.Interior.Unwrap().Exit = Map.Exit);
  if Receive(Client, Token) is ServerMessage.State(const Fields) then
    begin
      AssertProjectedExit(Fields);
    end;
  else
    begin
      panic('a turn must retain the supplied map');
    end;
  end if;
  // Find a deterministic fatal opponent turn; assert the complete session cleanup.
  var Fatal: GameState := State with Health := 1; end with;

  Fatal.Hostiles[0] := Fatal.Hostiles[0] with Position := InteriorPosition(X := 7, Y := 2); Alerted := true; end with;
  var Found: boolean := false;
  for Seed: integer := 0 to 100 do
    begin
      if not Found then
        begin
          Fatal := Fatal with RandomState := Seed; end with;

          if ResolveTurn(View, Fatal, TurnAction.Wait).Unwrap() is TurnOutcome.Defeated(const Log) then
            begin
              Found := true;
            end;
          else
            begin
              null;
            end;
          end if;
        end;
      end if;
    end;
  end for;

  AssertTrue(Found);
  const Defeated: ServerSession := PlayTurn(Committed with State := Some(Fatal); end with, TurnAction.Wait, 'wait_rejected', Server, Token, None)
                                     .Unwrap();
  AssertTrue(Defeated.State.IsNone());
  AssertTrue(Defeated.Interior.IsNone());
  if Receive(Client, Token) is ServerMessage.Defeated(const Text) then
    begin
      AssertTrue(Text.Length() > 0);
    end;
  else
    begin
      panic('fatal turn must send defeat');
    end;
  end if;

  AssertTrue(Close(Server).Unwrap());
  AssertTrue(Close(Client).Unwrap());
end.
