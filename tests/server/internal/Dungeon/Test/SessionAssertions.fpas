// Exact comparisons of installed server sessions, including cache and retained geometry.
unit Dungeon.Test.SessionAssertions;

uses Dungeon.Server.Session as SessionUnit, Dungeon.Test.StateComparison as States, Dungeon.World.Interiors.Encoding as Encoding, Std.Test as Test;

// Requires every installed session fact to remain unchanged after a rejected candidate.
public procedure AssertUnchanged(Before: SessionUnit.ServerSession; After: SessionUnit.ServerSession);
begin
  case Before.State of
    when Some(const StateValue):
      Test.AssertTrue(States.SameState(StateValue, After.State.Unwrap()));
    when None:
      Test.AssertTrue(After.State is None);
  end case;

  case Before.ActiveDialogue of
    when None:
      Test.AssertTrue(After.ActiveDialogue is None);
    when Some(const Frame):
      const Actual := After.ActiveDialogue.Unwrap();
      Test.AssertTrue(Frame.Node = Actual.Node);
      Test.AssertEquals(Frame.NpcId, Actual.NpcId);
      Test.AssertEquals(Frame.Speaker, Actual.Speaker);
      Test.AssertEquals(Frame.Text, Actual.Text);
      Test.AssertEquals(Frame.Choices.Length(), Actual.Choices.Length());
      for Index: integer := 0 to Frame.Choices.Length() - 1 do
        Test.AssertTrue(Frame.Choices[Index] = Actual.Choices[Index]);
      end for;
  end case;

  Test.AssertEquals(Before.Dirty, After.Dirty);
  Test.AssertEquals(Before.LastSavedAt, After.LastSavedAt);
  Test.AssertEquals(Before.Finished, After.Finished);
  Test.AssertEquals(Before.WorldSelected, After.WorldSelected);
  Test.AssertEquals(Before.World.Directory, After.World.Directory);
  Test.AssertEquals(Before.World.Clock, After.World.Clock);
  Test.AssertTrue(Before.World.Metadata = After.World.Metadata);
  Test.AssertEquals(Before.World.CacheLimit, After.World.CacheLimit);
  Test.AssertEquals(Before.World.Cache.Length(), After.World.Cache.Length());
  for Index: integer := 0 to Before.World.Cache.Length() - 1 do
    Test.AssertEquals(Before.World.Cache[Index].LastUsed, After.World.Cache[Index].LastUsed);
    const A := Before.World.Cache[Index].Chunk;
    const B := After.World.Cache[Index].Chunk;
    Test.AssertTrue(A.Coordinate = B.Coordinate);
    Test.AssertEquals(A.Cells.Length(), B.Cells.Length());
    for CellIndex: integer := 0 to A.Cells.Length() - 1 do
      Test.AssertTrue(A.Cells[CellIndex] = B.Cells[CellIndex]);
    end for;
  end for;

  Test.AssertTrue(Before.Viewport = After.Viewport);
  case Before.Interior of
    when Some(const Map):
      Test.AssertEquals(
        Encoding.EncodeLevel(Before.World.Metadata, Map),
        Encoding.EncodeLevel(After.World.Metadata, After.Interior.Unwrap())
      );
    when None:
      Test.AssertTrue(After.Interior is None);
  end case;
end procedure;
end unit;
