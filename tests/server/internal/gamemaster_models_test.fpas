// Agent model IDs survive grouped catalogs; missing selectors and substitutions are refused.
program GamemasterModelsTest;

uses Dungeon.Server.Gamemaster.Models as Models, Std.Test as Test;

begin
  const Choices := Models.Decode(
    '{"configOptions":[{"id":"thought_level","options":[]},' +
    '{"id":"model","options":[{"value":"Cloud/Exact-ID","name":"Friendly"},' +
    '{"group":"Local","options":[{"value":"llamacpp/qwen3.5","name":"Local Qwen"}]}]}]}'
  ).Unwrap();
  Test.AssertEquals(2, Choices.Length());
  Test.AssertEquals('Cloud/Exact-ID', Choices[0].Id);
  Test.AssertEquals('Friendly', Choices[0].LabelText);
  Test.AssertTrue(Models.Contains(Choices, 'llamacpp/qwen3.5'));
  Test.AssertFalse(Models.Contains(Choices, 'cloud/exact-id'));
  Test.AssertTrue(Models.Decode('{"configOptions":[]}') is Error(_));
  Test.AssertTrue(Models.Decode('{"configOptions":[{"id":"model","options":[]}]}') is Error(_));
  Test.AssertTrue(
    Models.Decode('{"configOptions":[{"id":"model","options":[{"value":"","name":"Bad"}]}]}') is Error(_)
  );
end.
