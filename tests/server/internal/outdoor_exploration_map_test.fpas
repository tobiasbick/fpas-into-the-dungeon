// Covers the outdoor exploration-map window: cells come from stored chunks, equal the generated
// terrain, leave undiscovered chunks untouched, and refresh the session's chunk cache.
program OutdoorExplorationMapTest;

uses Dungeon.Coordinates as Coordinates, Dungeon.Exploration as Exploration, Dungeon.GameState as GameState, Dungeon.Protocol as Protocol, Dungeon.Server.Projection as Projection, Dungeon.Terrain as Terrain, Dungeon.Terrain.Chunks as ChunksUnit, Dungeon.World as WorldUnit, Std.Conv as Conv, Std.Fs as Fs, Std.Test as Test, Std.Time as Time;

// Reveals the outdoor sight circle at every field of a straight walk east from the spawn.
function Explored(Metadata: Terrain.WorldMetadata; Steps: integer): GameState.GameState;
begin
  var State := GameState.NewGame(Metadata);
  for Step: integer := 0 to Steps do
    State.Exploration := Exploration.RevealOutdoor(
      State.Exploration,
      Coordinates.WorldPosition(X := Metadata.Spawn.X + Step, Y := Metadata.Spawn.Y)
    );
  end for;

  return State;
end function;

// The previous per-field projection, kept here as the reference for equal output.
function ReferenceRows(Metadata: Terrain.WorldMetadata; State: GameState.GameState; OriginX: integer; OriginY: integer; Width: integer; Height: integer): array of string;
begin
  const Player := GameState.OutdoorPlayerPosition(State).Unwrap();
  const Visible := Exploration.OutdoorVisibility(OriginX, OriginY, Width, Height, Player);
  var Rows: array of string := [];
  for Y: integer := 0 to Height - 1 do
    var Row := '';
    for X: integer := 0 to Width - 1 do
      if Exploration.OutdoorIsDiscovered(State.Exploration, OriginX + X, OriginY + Y)
        or
        Visible[(Y * Width) + X]
      then
        Row := Row +
          Terrain.VisibleCellCode(ChunksUnit.GenerateWorldCell(Metadata, OriginX + X, OriginY + Y));
      else
        Row := Row + Protocol.UnknownFieldCode;
      end if;
    end for;

    Rows.PushInPlace(Row);
  end for;

  return Rows;
end function;

begin
  const Root := '.temp-data/outdoor-exploration-map-' + Conv.IntToStr(Time.TimestampMillis());
  const World := WorldUnit.OpenWorld(Root, 'outdoor-map', 12345, 4, 32).Unwrap();
  const Metadata := World.Metadata;
  const State := Explored(Metadata, 300);
  const View := GameState.AreaView(Metadata := Metadata, Interior := None);
  const OriginX := Metadata.Spawn.X - 60;
  const OriginY := Metadata.Spawn.Y - 60;

  // A full-size window equals the per-field reference and fills the session cache.
  const Loaded := Projection.ProjectOutdoorExplorationMap(
    World,
    State,
    View,
    OriginX,
    OriginY,
    240,
    120
  ).Unwrap();
  const Reference := ReferenceRows(Metadata, State, OriginX, OriginY, 240, 120);
  Test.AssertEquals(120, Loaded.Map.Rows.Length());
  for Y: integer := 0 to 119 do
    Test.AssertEquals(Reference[Y], Loaded.Map.Rows[Y]);
  end for;

  Test.AssertTrue(Loaded.Map.PlayerInWindow);
  Test.AssertTrue(WorldUnit.CachedChunkCount(Loaded.World) > WorldUnit.CachedChunkCount(World));
  // A second request is served from the refreshed cache with the same result.
  const Again := Projection.ProjectOutdoorExplorationMap(
    Loaded.World,
    State,
    View,
    OriginX,
    OriginY,
    240,
    120
  ).Unwrap();
  // A densely explored window: every field discovered.
  var Dense := State;
  for Y: integer := 0 to 7 do
    for X: integer := 0 to 15 do
      Dense.Exploration := Exploration.RevealOutdoor(
        Dense.Exploration,
        Coordinates.WorldPosition(X := OriginX + 8 + X * 15, Y := OriginY + 8 + Y * 15)
      );
    end for;
  end for;
  const DenseLoaded := Projection.ProjectOutdoorExplorationMap(
    Loaded.World,
    Dense,
    View,
    OriginX,
    OriginY,
    240,
    120
  ).Unwrap();
  const DenseReference := ReferenceRows(Metadata, Dense, OriginX, OriginY, 240, 120);
  for Y: integer := 0 to 119 do
    Test.AssertEquals(DenseReference[Y], DenseLoaded.Map.Rows[Y]);
  end for;

  Test.AssertEquals(Loaded.Map.Rows[60], Again.Map.Rows[60]);

  // A far window without discovery is unknown and creates no chunk file.
  const FarX := Metadata.Spawn.X + 100000;
  const FarChunk := Coordinates.ChunkCoordinate(
    X := Coordinates.ChunkForCoordinate(FarX),
    Y := Coordinates.ChunkForCoordinate(Metadata.Spawn.Y)
  );
  const Far := Projection.ProjectOutdoorExplorationMap(
    World,
    State,
    View,
    FarX,
    Metadata.Spawn.Y,
    40,
    20
  ).Unwrap();
  for Row: string in Far.Map.Rows do
    Test.AssertEquals(Protocol.UnknownFieldCode.RepeatStr(40), Row);
  end for;

  Test.AssertFalse(Fs.Exists(WorldUnit.WorldChunkPath(World, FarChunk)));
  Test.AssertEquals(WorldUnit.CachedChunkCount(World), WorldUnit.CachedChunkCount(Far.World));

  // Interior projection refuses outdoor windows; the outdoor projection refuses invalid windows.
  Test.AssertTrue(
    Projection.ProjectExplorationMap(State, View, OriginX, OriginY, 10, 10) is Error(_)
  );
  Test.AssertTrue(
    Projection.ProjectOutdoorExplorationMap(World, State, View, OriginX, OriginY, 0, 10) is Error(_)
  );
end.
