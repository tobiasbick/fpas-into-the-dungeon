// Covers the dungeon entry checkpoints: failures before sending keep the session, save, and level files.
program TransitionCheckpointsTest;

uses
  Dungeon.Areas.Identities, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interior,
  Dungeon.Movement, Dungeon.Protocol, Dungeon.Protocol.ServerMessages, Dungeon.Protocol.Transport,
  Dungeon.Server.Config, Dungeon.Server.Failures, Dungeon.Server.Handling, Dungeon.Server.Replies,
  Dungeon.Server.Session, Dungeon.Terrain, Dungeon.Terrain.Entrances, Dungeon.World,
  Dungeon.World.Interiors, Dungeon.World.Savegame, Std.Conv, Std.Fs, Std.Net, Std.Path, Std.Tasks,
  Std.Test, Std.Time, Dungeon.World.Interiors.Errors, Dungeon.World.Savegame.Errors;

function Receive(Client: Connection; Token: CancellationToken): ServerMessage;
begin
  const Response: LineRead := ReadLine(NewLineReader(Client), Token).Unwrap();
  return DecodeServer(Response.Line).Unwrap();
end function;

procedure AssertRejectedWith(Message: ServerMessage; Expected: string);
begin
  if Message is ServerMessage.Rejected(const Code, const Text) then
    begin
      AssertEquals(Expected, Code);
    end;
  else
    begin
      panic('expected a rejection');
    end;
  end if;
end procedure;

// The player is still outside on the entrance, with nothing visited and no retained map.
procedure AssertStillOutside(Session: ServerSession; Entrance: WorldPosition);
begin
  const State: GameState := Session.State.Unwrap();
  AssertTrue(State.Area = AreaKind.OutdoorRegion);
  const Position: WorldPosition := OutdoorPlayerPosition(State).Unwrap();
  AssertEquals(Entrance.X, Position.X);
  AssertEquals(Entrance.Y, Position.Y);
  AssertEquals(0, State.VisitedAreas.Length());
  AssertEquals(0, State.Items.Length());
  AssertEquals(0, State.Exploration.InteriorAreas.Length());
  AssertTrue(Session.Interior.IsNone());
end procedure;

begin
  const Root: string := '.temp-data/transition-checkpoints-' + IntToStr(TimestampMillis());
  const World: WorldSession := OpenWorld(Root, 'checkpoints', 24680, 4, 32).Unwrap();
  const Metadata: WorldMetadata := World.Metadata;
  const Region: RegionCoordinate := RegionOf(Metadata, Metadata.Spawn);
  const AreaId: string := DungeonAreaId(Metadata, Region);
  const LevelDirectory: string := Std.Path.Join([
                                                  World.Directory,
                                                  'dungeons',
                                                  (IntToStr(Region.X) + '_') + IntToStr(Region.Y)
                                                ]);
  const LevelPath: string := Std.Path.Join([LevelDirectory, '0.json']);
  const Outside: GameState := NewGame(Metadata) with Player := PlayerPosition.Outdoor(Metadata.SpawnEntrance); end with;

  AssertTrue(WriteSaveGame(World, Outside).Unwrap());
  const SaveBytes: string := Std.Fs.ReadText(SaveGamePath(World)).Unwrap();
  const Session: ServerSession := ServerSession(World := World, WorldSelected := true, Dirty := false, State := Some(Outside), Interior := None, Viewport := ViewportSize(Width := 20, Height := 12), Finished := false);
  const Config: ServerConfig := ServerConfig(ConfigPath := '', Logs := None, WorldsRoot := Root, WorldId := Metadata.Id, WorldSeed := Metadata.Seed, DungeonRegionChunks := 4, ChunkCacheLimit := 32, MaximumViewWidth := 80, MaximumViewHeight := 24);
  const ListenerValue: Listener := Listen('127.0.0.1', 0).Unwrap();
  const Address: NetworkAddress := ListenerLocalAddress(ListenerValue).Unwrap();
  const Client: Connection := Connect('127.0.0.1', Address.Port, 2000).Unwrap();
  const Server: Connection := Accept(ListenerValue).Unwrap();
  AssertTrue(SetTimeout(Client, 5000).Unwrap());
  AssertTrue(SetTimeout(Server, 5000).Unwrap());
  const Token: CancellationToken := GetCancellationToken(CreateCancellationSource());
  // Invalid interaction away from the entrance: no storage operation at all.
  const AtSpawn: ServerSession := Session with State := Some(NewGame(Metadata)); end with;
  const Ignored: ServerSession := HandleSessionMessage(AtSpawn, ClientMessage.Interact, Server, Config, Token)
                                    .Unwrap();
  if Receive(Client, Token) is ServerMessage.Interaction(const Title, const Text) then
    begin
      null;
    end;
  else
    begin
      panic('expected a plain interaction result away from the entrance');
    end;
  end if;

  AssertFalse(Std.Fs.Exists(Std.Path.Join([World.Directory, 'dungeons'])));
  // Read failure: the level path is not a file.
  AssertTrue(Std.Fs.CreateDirAll(LevelPath).Unwrap());
  const AfterRead: ServerSession := HandleSessionMessage(Session, ClientMessage.Interact, Server, Config, Token)
                                      .Unwrap();
  AssertRejectedWith(Receive(Client, Token), 'storage_error');
  AssertStillOutside(AfterRead, Metadata.SpawnEntrance);
  AssertTrue(Std.Fs.IsDir(LevelPath));
  AssertEquals(SaveBytes, Std.Fs.ReadText(SaveGamePath(World)).Unwrap());
  // Atomic-write failure in a fresh world: the level directory is blocked by a file; nothing is published.
  const BlockedRoot: string := Std.Path.Join([Root, 'blocked']);
  const BlockedWorld: WorldSession := OpenWorld(BlockedRoot, 'checkpoints', 24680, 4, 32).Unwrap();
  const BlockedDirectory: string := Std.Path.Join([
                                                    BlockedWorld.Directory,
                                                    'dungeons',
                                                    (IntToStr(Region.X) + '_') + IntToStr(Region.Y)
                                                  ]);
  AssertTrue(Std.Fs.CreateDirAll(Std.Path.Join([BlockedWorld.Directory, 'dungeons'])).Unwrap());
  AssertTrue(Std.Fs.WriteTextAtomic(BlockedDirectory, 'blocking file').Unwrap());
  const AfterWrite: ServerSession := HandleSessionMessage(Session with World := BlockedWorld; end with, ClientMessage.Interact, Server, Config, Token)
                                       .Unwrap();
  AssertRejectedWith(Receive(Client, Token), 'storage_error');
  AssertStillOutside(AfterWrite, Metadata.SpawnEntrance);
  AssertEquals('blocking file', Std.Fs.ReadText(BlockedDirectory).Unwrap());
  // A published level followed by a candidate failure before sending: rejected, session unchanged,
  // and the valid file may remain for the next entry.
  const CleanRoot: string := Std.Path.Join([Root, 'clean']);
  const CleanWorld: WorldSession := OpenWorld(CleanRoot, 'checkpoints', 24680, 4, 32).Unwrap();
  const CleanSession: ServerSession := Session with World := CleanWorld; end with;
  const Map: InteriorMap := OpenLevelForEntry(CleanWorld, Outside, AreaId).Unwrap();
  const CleanLevelPath: string := Std.Path.Join([
                                                  CleanWorld.Directory,
                                                  'dungeons',
                                                  (IntToStr(Region.X) + '_') + IntToStr(Region.Y),
                                                  '0.json'
                                                ]);
  const Published: string := Std.Fs.ReadText(CleanLevelPath).Unwrap();
  const OutdoorView: AreaView := AreaView(Metadata := Metadata, Interior := None);
  const Transition: AreaTransition := ActivateAreaTransition(OutdoorView, Outside, Some(Map))
                                        .Unwrap();
  const Inconsistent: AreaTransition := Transition with View := OutdoorView; end with;
  const AfterCandidate: ServerSession := CommitTransition(CleanSession, Inconsistent, Server, Token)
                                           .Unwrap();
  AssertRejectedWith(Receive(Client, Token), 'interaction_rejected');
  AssertStillOutside(AfterCandidate, Metadata.SpawnEntrance);
  AssertEquals(Published, Std.Fs.ReadText(CleanLevelPath).Unwrap());
  // Success: state and map are installed together; the previous save is untouched.
  const Entered: ServerSession := HandleSessionMessage(CleanSession, ClientMessage.Interact, Server, Config, Token)
                                    .Unwrap();
  if Receive(Client, Token) is ServerMessage.State(const Value) then
    begin
      null;
    end;
  else
    begin
      panic('expected the entered first-person state');
    end;
  end if;
  const Inside: GameState := Entered.State.Unwrap();
  AssertEquals(AreaId, Inside.AreaId);
  AssertEquals(AreaId, Entered.Interior.Unwrap().AreaId);
  AssertTrue(HasVisitedArea(Inside, AreaId));
  AssertEquals(Published, Std.Fs.ReadText(CleanLevelPath).Unwrap());
  AssertFalse(Std.Fs.Exists(SaveGamePath(CleanWorld)));
  // Leaving and entering again reuses the single stored level.
  const AtExit: ServerSession := Entered with State := Some(Inside with Player := PlayerPosition.FirstPerson(FirstPersonPose(Position := Map.Exit, Facing := Map.StartFacing)); end with); end with;
  const Left: ServerSession := HandleSessionMessage(AtExit, ClientMessage.Interact, Server, Config, Token)
                                 .Unwrap();
  const LeftMessage: ServerMessage := Receive(Client, Token);
  AssertTrue(Left.Interior.IsNone());
  const Again: ServerSession := HandleSessionMessage(Left, ClientMessage.Interact, Server, Config, Token)
                                  .Unwrap();
  const AgainMessage: ServerMessage := Receive(Client, Token);
  AssertTrue(Again.Interior.IsSome());
  AssertEquals(Published, Std.Fs.ReadText(CleanLevelPath).Unwrap());
  // A send failure is an error: the caller closes the connection and discards the unsaved session.
  AssertTrue(Close(Client).Unwrap());
  AssertTrue(Close(Server).Unwrap());
  AssertTrue(CommitTransition(CleanSession, Transition, Server, Token).IsError());
  AssertEquals(SaveBytes, Std.Fs.ReadText(SaveGamePath(World)).Unwrap());
  AssertTrue(CloseListener(ListenerValue).Unwrap());
  // Failure classes map to stable codes; the generator cannot fail for a valid region, so the
  // generation class is checked directly. Messages name world and area but no host path.
  AssertEquals('world_data_error', LevelRejection('w', LevelFailure.Missing('w:dungeon:0:0')).Code);
  AssertEquals('world_data_error', LevelRejection('w', LevelFailure.Invalid('w:dungeon:0:0', 'C:\x'))
                                     .Code);
  AssertEquals('storage_error', LevelRejection('w', LevelFailure.Io('C:\x')).Code);
  AssertEquals('generation_error', LevelRejection('w', LevelFailure.Generation('w:dungeon:0:0', 'defect'))
                                     .Code);
  AssertFalse(LevelRejection('w', LevelFailure.Io('C:\x')).Message.Contains('C:'));
  AssertEquals('save_failed', PersistenceRejection('w', 'save_failed', PersistenceFailure.InvalidState('bad'))
                                .Code);
  AssertEquals('storage_error', PersistenceRejection('w', 'save_failed', PersistenceFailure.Io('disk'))
                                  .Code);
  AssertEquals('world_data_error', PersistenceRejection('w', 'load_failed', PersistenceFailure.Level(LevelFailure.Missing('a')))
                                     .Code);
end.
