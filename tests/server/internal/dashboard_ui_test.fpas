// Real headless keyboard routing, responsive panels, modal guards and small-terminal clipping.
program DashboardUiTest;

uses Dungeon.Server.Console as ConsoleUnit, Dungeon.Server.Console.Model as ModelUnit, Dungeon.Server.Console.Log as LogUnit, Dungeon.Server.Console.Layout as LayoutUnit, Dungeon.Server.Logging as Logging, Dungeon.Server.Gamemaster.Model as Work, Dungeon.RuntimeData as RuntimeData, Dungeon.Ui.Theme as Theme, Std.Console as Console, Std.Text.Format as Conv, Std.Io.Fs as Fs, Std.Tasks as Tasks, Std.Test as Test, Std.Ui.Terminal as Tui;

function HasRole(Snapshot: Tui.TuiSurfaceSnapshot; Role: Tui.TuiStyleRole): boolean;
begin
  for Cell: Tui.TuiCell in Snapshot.Cells do
    if Cell.Role = Role and Cell.ConcreteStyle is None then
      return true;
    end if;
  end for;

  return false;
end function;

function Contains(Snapshot: Tui.TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    if Text in Snapshot.LineAt(Y) then
      return true;
    end if;
  end for;

  return false;
end function;

function Find(Snapshot: Tui.TuiSurfaceSnapshot; Text: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Snapshot.Height - 1 do
    case Snapshot.LineAt(Y).IndexOf(Text) of
      when Some(const X):
        return Tui.TuiPoint.Create(X, Y);
      when None:
        null;
    end case;
  end for;

  panic('dashboard text not found');
end function;

procedure AssertSettingsFrame(Screen: Tui.TuiSurfaceSnapshot; X: integer; Y: integer; Width: integer; Height: integer);
begin
  Test.AssertEquals('╭', Screen.CellAt(X, Y).Glyph);
  Test.AssertEquals('╮', Screen.CellAt(X + Width - 1, Y).Glyph);
  Test.AssertEquals('╰', Screen.CellAt(X, Y + Height - 1).Glyph);
  Test.AssertEquals('╯', Screen.CellAt(X + Width - 1, Y + Height - 1).Glyph);
end procedure;

function Key(Kind: Tui.TuiKeyKind): Console.KeyEvent;
begin
  return Console.KeyEvent(
    kind := Kind,
    ch := '',
    shift := false,
    ctrl := false,
    alt := false,
    meta := false
  );
end function;

function Press(App: Tui.TuiApplication; Model: ModelUnit.ConsoleModel; Kind: Tui.TuiKeyKind): ModelUnit.ConsoleModel;
begin
  App.InjectKeyForTest(Key(Kind));
  return App.RunIterations(
    Model,
    ConsoleUnit.UpdateServerConsole,
    ConsoleUnit.ViewServerConsole,
    1,
    0
  );
end function;

begin
  const Settings := RuntimeData.ServerWorldConfig(
    Id := 'main',
    Seed := 12345,
    DungeonRegionChunks := 4,
    ChunkCacheLimit := 64,
    MaximumViewWidth := 240,
    MaximumViewHeight := 120
  );
  var Model := ModelUnit.NewConsoleModel('', Settings) with Width := 144; Height := 45; Port := 4040; Uptime := 754000; end with;

  Model := ModelUnit.ApplyConsoleLog(
    Model,
    Logging.ServerLogEvent(Kind := 'status', Text := 'Listening', Timestamp := 72000000)
  );
  const Dashboard := Logging.ServerDashboardStatus(
    WorldId := 'main', Seed := 12345, RegionChunks := 4, Generator := 6,
    Area := 'Forgotten dungeon', Active := true, Dirty := true, SavePresent := true,
    LastSavedAt := 72489000
  );
  Model := ModelUnit.ApplyConsoleLog(
    Model,
    Logging.ServerLogEvent(Kind := 'snapshot', Text := '', Snapshot := Some(Dashboard))
  );
  for Index: integer := 0 to 90 do
    var Kind: string := 'world';
    if Index mod 7 = 1 then
      Kind := 'rejected';
    end if;

    if Index mod 7 = 2 then
      Kind := 'error';
    end if;

    Model := ModelUnit.ApplyConsoleLog(
      Model,
      Logging.ServerLogEvent(
        Kind := Kind,
        Text := 'Event ' + Conv.IntToStr(Index),
        Timestamp := 72000000 + Index * 1000
      )
    );
  end for;

  Model := ModelUnit.ApplyConsoleLog(
    Model,
    Logging.ServerLogEvent(Kind := 'world', Text := 'Unicode München 界 é', Timestamp := 72200000)
  );
  const App := Tui.TuiApplication.OpenForTestWithPalette(
    Tui.TuiSize.Create(144, 45),
    Theme.Palette()
  );
  Model := App.RunIterations(
    Model,
    ConsoleUnit.UpdateServerConsole,
    ConsoleUnit.ViewServerConsole,
    0,
    0
  );
  var Screen := App.SurfaceSnapshot();
  for Title: string in [
    'SERVER',
    'SESSION',
    'WORLD',
    'LIVE LOG / UTC',
    'Forgotten dungeon',
    'Unsaved',
    'Event 90',
    'Unicode München',
    'Settings (F2)',
    'Stop server (Alt+X)'
  ] do
    Test.AssertTrue(Contains(Screen, Title));
  end for;

  Test.AssertTrue('RUNNING' in Screen.LineAt(1));
  Test.AssertTrue('SERVER' in Screen.LineAt(3));
  Test.AssertTrue('SESSION' in Screen.LineAt(3));
  Test.AssertTrue('WORLD' in Screen.LineAt(3));
  Test.AssertTrue('Stop server' in Screen.LineAt(43));
  Test.AssertTrue(HasRole(Screen, Tui.TuiStyleRole.PanelNormal));
  Test.AssertEquals(166, Theme.Palette().Frame.Foreground.Red);
  // Retain an actual runtime rendering for visual review, not a hand-drawn mock.
  var Text: string := '';
  for Y: integer := 0 to Screen.Height - 1 do
    Text := Text + Screen.LineAt(Y) + string.Chr(10);
  end for;

  discard Fs.WriteText('.temp-data/dashboard-preview.txt', Text).Unwrap();
  var Colors: string := '';
  for Cell: Tui.TuiCell in Screen.Cells do
    const Style: Tui.TuiStyle := case Cell.ConcreteStyle of
      when Some(const Value): Value;
      when None: Theme.Palette().ForRole(Cell.Role);
    end case;
    Colors := Colors + Conv.IntToStr(Style.Foreground.Red) + ',' +
      Conv.IntToStr(Style.Foreground.Green) + ',' + Conv.IntToStr(Style.Foreground.Blue) + ';' +
      Conv.IntToStr(Style.Background.Red) + ',' + Conv.IntToStr(Style.Background.Green) + ',' +
      Conv.IntToStr(Style.Background.Blue) + string.Chr(10);
  end for;

  discard Fs.WriteText('.temp-data/dashboard-preview-colors.txt', Colors).Unwrap();
  Model := Press(App, Model, Tui.TuiKeyKind.Up);
  Test.AssertFalse(Model.History.Follow);
  const Offset := Model.History.Offset;
  Model := ModelUnit.ApplyConsoleLog(
    Model,
    Logging.ServerLogEvent(Kind := 'world', Text := 'Paused new event', Timestamp := 72200000)
  );
  Test.AssertEquals(Offset, Model.History.Offset);
  Model := Press(App, Model, Tui.TuiKeyKind.EndKey);
  Test.AssertTrue(Model.History.Follow);
  Test.AssertTrue(Contains(App.SurfaceSnapshot(), 'Paused new event'));
  Model := Press(App, Model, Tui.TuiKeyKind.F3);
  Test.AssertTrue(Model.History.Filter = LogUnit.LogFilter.Info);
  Model := Press(App, Model, Tui.TuiKeyKind.F3);
  Test.AssertTrue(Model.History.Filter = LogUnit.LogFilter.Warnings);
  Test.AssertTrue(Contains(App.SurfaceSnapshot(), 'WARN'));
  Test.AssertFalse(Contains(App.SurfaceSnapshot(), 'ERROR'));
  Model := Press(App, Model, Tui.TuiKeyKind.F2);
  Test.AssertTrue(Model.SettingsOpen);
  AssertSettingsFrame(App.SurfaceSnapshot(), 36, 11, 72, 23);
  Test.AssertEquals(70, Model.FocusedControl);
  Test.AssertTrue(Contains(App.SurfaceSnapshot(), 'World defaults'));
  Test.AssertTrue(Contains(App.SurfaceSnapshot(), 'Gamemaster'));
  const WorldTab := Find(App.SurfaceSnapshot(), 'World defaults');
  const GamemasterTab := Find(App.SurfaceSnapshot(), 'Gamemaster');
  const SeedLabel := Find(App.SurfaceSnapshot(), 'Seed:');
  Test.AssertTrue(WorldTab.X < SeedLabel.X);
  Test.AssertEquals(WorldTab.X, GamemasterTab.X);
  Test.AssertEquals(WorldTab.Y + 1, GamemasterTab.Y);
  Test.AssertTrue(
    App.SurfaceSnapshot().CellAt(WorldTab.X, WorldTab.Y).Role = Tui.TuiStyleRole.TabSelectedFocused
  );
  Test.AssertTrue(HasRole(App.SurfaceSnapshot(), Tui.TuiStyleRole.OverlayFocusedFrame));
  Test.AssertTrue(HasRole(App.SurfaceSnapshot(), Tui.TuiStyleRole.OverlayNormal));
  Test.AssertEquals(43, Theme.Palette().ForRole(Tui.TuiStyleRole.OverlayNormal).Background.Red);
  Model := Press(App, Model, Tui.TuiKeyKind.Tab);
  Test.AssertEquals(10, Model.FocusedControl);
  Model := ConsoleUnit.UpdateServerConsole(
    Model, Tui.TuiMsg.TextChanged(Tui.TuiControlId.Create(10), Tui.TuiAction.Create(10), '777', 3),
    Tui.TuiCmdOutput.Create()
  );
  for Index: integer := 1 to 4 do
    Model := Press(App, Model, Tui.TuiKeyKind.Tab);
  end for;

  Test.AssertEquals(70, Model.FocusedControl);
  Model := Press(App, Model, Tui.TuiKeyKind.Down);
  Test.AssertEquals(1, Model.SettingsTab);
  AssertSettingsFrame(App.SurfaceSnapshot(), 36, 11, 72, 23);
  Test.AssertTrue(Model.Gamemaster.Open);
  Test.AssertTrue(Contains(App.SurfaceSnapshot(), 'Connection:'));
  const Revision := Model.Gamemaster.Revision;
  Model := Press(App, Model, Tui.TuiKeyKind.Up);
  Test.AssertEquals(0, Model.SettingsTab);
  Test.AssertEquals('777', Model.SeedText);
  Model := Press(App, Model, Tui.TuiKeyKind.Down);
  Test.AssertEquals(Revision, Model.Gamemaster.Revision);
  Model := Press(App, Model, Tui.TuiKeyKind.Up);
  const Filter := Model.History.Filter;
  Model := Press(App, Model, Tui.TuiKeyKind.F3);
  Test.AssertTrue(Model.History.Filter = Filter);
  Model := Press(App, Model, Tui.TuiKeyKind.Escape);
  Test.AssertFalse(Model.SettingsOpen);
  Model := Press(App, Model, Tui.TuiKeyKind.Tab);
  Test.AssertTrue(Model.FocusedControl <> 20);
  const Cmd := Tui.TuiCmdOutput.Create();
  const OldSeed := Model.SeedText;
  Model := ConsoleUnit.UpdateServerConsole(
    Model,
    Tui.TuiMsg.TextChanged(Tui.TuiControlId.Create(10), Tui.TuiAction.Create(10), '999', 3),
    Cmd
  );
  Test.AssertEquals(OldSeed, Model.SeedText);
  Model := ConsoleUnit.UpdateServerConsole(
    Model,
    Tui.TuiMsg.Action(Tui.TuiControlId.Create(30), Tui.TuiAction.Create(33)),
    Cmd
  );
  Test.AssertTrue(Model.History.Filter = Filter);
  const OldOffset := Model.History.Offset;
  Model := ConsoleUnit.UpdateServerConsole(
    Model,
    Tui.TuiMsg.ScrollChanged(
      Tui.TuiControlId.Create(99),
      Tui.TuiAction.Create(20),
      Tui.TuiPoint.Create(0, 0)
    ),
    Cmd
  );
  Test.AssertEquals(OldOffset, Model.History.Offset);
  Model := ConsoleUnit.UpdateServerConsole(Model, Tui.TuiMsg.Key(Key(Tui.TuiKeyKind.F2)), Cmd);
  const ReopenedSeed := Model.SeedText;
  Model := ConsoleUnit.UpdateServerConsole(
    Model,
    Tui.TuiMsg.TextChanged(Tui.TuiControlId.Create(10), Tui.TuiAction.Create(10), 'abc', -1),
    Cmd
  );
  Test.AssertEquals(ReopenedSeed, Model.SeedText);
  Model := ConsoleUnit.UpdateServerConsole(
    Model,
    Tui.TuiMsg.TextChanged(
      Tui.TuiControlId.Create(10),
      Tui.TuiAction.Create(10),
      'x'.RepeatStr(33),
      33
    ),
    Cmd
  );
  Test.AssertEquals(ReopenedSeed, Model.SeedText);
  App.Close();
  const BeforeFailure := Model.ListenerStatus;
  Model := ConsoleUnit.UpdateServerConsole(
    Model,
    Tui.TuiMsg.BackgroundFailed(99, Tasks.TaskFailureKind.RuntimeError, 'ignored task', 0, 0, 0),
    Cmd
  );
  Test.AssertEquals(BeforeFailure, Model.ListenerStatus);
  Model := ConsoleUnit.UpdateServerConsole(
    Model,
    Tui.TuiMsg.BackgroundFailed(
      1,
      Tasks.TaskFailureKind.RuntimeError,
      'Port already in use',
      0,
      0,
      0
    ), Cmd
  );
  Test.AssertEquals('Stopped', Model.ListenerStatus);
  Test.AssertEquals('Stopped', Model.Status);
  Test.AssertFalse(Model.Connected);
  Test.AssertTrue(Model.Dashboard is None);
  Test.AssertEquals(
    'Port already in use',
    Model.History.Entries[Model.History.Entries.Length() - 1].Text
  );
  Test.AssertTrue(Model.SettingsOpen);
  Model := ConsoleUnit.UpdateServerConsole(Model, Tui.TuiMsg.QuitRequested, Cmd);
  const StoppedApp := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(144, 45));
  Model := StoppedApp.RunIterations(
    Model,
    ConsoleUnit.UpdateServerConsole,
    ConsoleUnit.ViewServerConsole,
    0,
    0
  );
  Test.AssertTrue(Contains(StoppedApp.SurfaceSnapshot(), 'STOPPED'));
  Test.AssertTrue(Contains(StoppedApp.SurfaceSnapshot(), 'Not connected'));
  StoppedApp.Close();
  const Compact := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(40, 12));
  var CompactModel := ModelUnit.NewConsoleModel('', Settings) with Width := 40; Height := 12; end with;

  CompactModel := Compact.RunIterations(
    CompactModel,
    ConsoleUnit.UpdateServerConsole,
    ConsoleUnit.ViewServerConsole,
    0,
    0
  );
  CompactModel := Press(Compact, CompactModel, Tui.TuiKeyKind.F2);
  AssertSettingsFrame(Compact.SurfaceSnapshot(), 0, 0, 40, 12);
  Test.AssertTrue(Contains(Compact.SurfaceSnapshot(), 'Seed:'));
  CompactModel := Press(Compact, CompactModel, Tui.TuiKeyKind.Down);
  AssertSettingsFrame(Compact.SurfaceSnapshot(), 0, 0, 40, 12);
  for Text: string in ['Codex', 'Pi', 'Clear', 'Refresh', 'Models', 'Test', 'Save', 'Cancel'] do
    Test.AssertTrue(Contains(Compact.SurfaceSnapshot(), Text));
  end for;

  for Id: integer in [60, 61, 67, 63, 62, 64, 65, 66] do
    CompactModel := Press(Compact, CompactModel, Tui.TuiKeyKind.Tab);
    Test.AssertEquals(Id, CompactModel.FocusedControl);
  end for;

  CompactModel := Press(Compact, CompactModel, Tui.TuiKeyKind.Enter);
  Test.AssertFalse(CompactModel.Gamemaster.Open);
  Test.AssertEquals(0, CompactModel.SettingsTab);
  CompactModel := Press(Compact, CompactModel, Tui.TuiKeyKind.Down);
  Test.AssertTrue(CompactModel.Gamemaster.Open);

  Compact.InjectResizeForTest(Tui.TuiSize.Create(30, 10));
  CompactModel := Compact.RunIterations(
    CompactModel,
    ConsoleUnit.UpdateServerConsole,
    ConsoleUnit.ViewServerConsole,
    1,
    0
  );
  Test.AssertEquals(70, CompactModel.FocusedControl);
  Test.AssertTrue(Contains(Compact.SurfaceSnapshot(), 'Terminal too small'));
  Test.AssertTrue(Contains(Compact.SurfaceSnapshot(), 'Close'));
  CompactModel := Press(Compact, CompactModel, Tui.TuiKeyKind.Enter);
  Test.AssertFalse(CompactModel.SettingsOpen);
  Test.AssertFalse(CompactModel.Gamemaster.Open);
  Compact.Close();
  const Balanced := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(80, 25));
  var BalancedModel := ModelUnit.NewConsoleModel('', Settings) with Width := 80; Height := 25; end with;

  BalancedModel := Balanced.RunIterations(
    BalancedModel,
    ConsoleUnit.UpdateServerConsole,
    ConsoleUnit.ViewServerConsole,
    0,
    0
  );
  BalancedModel := Press(Balanced, BalancedModel, Tui.TuiKeyKind.F2);
  AssertSettingsFrame(Balanced.SurfaceSnapshot(), 4, 4, 72, 17);
  BalancedModel := Press(Balanced, BalancedModel, Tui.TuiKeyKind.Down);
  AssertSettingsFrame(Balanced.SurfaceSnapshot(), 4, 4, 72, 17);
  for Text: string in [
    'Codex',
    'Pi',
    'Clear',
    'Refresh',
    'Test connection',
    'Save',
    'Cancel'
  ] do
    Test.AssertTrue(Contains(Balanced.SurfaceSnapshot(), Text));
  end for;
  var Choices: array of Work.ModelChoice := [];
  for Index: integer := 0 to 7 do
    Choices.PushInPlace(
      Work.ModelChoice(Id := Conv.IntToStr(Index), LabelText := 'Choice ' + Conv.IntToStr(Index))
    );
  end for;

  BalancedModel.Gamemaster.Choices := Choices;
  BalancedModel := Balanced.RunIterations(
    BalancedModel,
    ConsoleUnit.UpdateServerConsole,
    ConsoleUnit.ViewServerConsole,
    0,
    0
  );
  Test.AssertTrue(Contains(Balanced.SurfaceSnapshot(), 'Choice 0'));
  Test.AssertFalse(Contains(Balanced.SurfaceSnapshot(), 'Choice 2'));
  const BalancedScreen := Balanced.SurfaceSnapshot();
  const ModelsAt := Find(BalancedScreen, 'Models');
  const TestAt := Find(BalancedScreen, 'Test connection');
  const CancelAt := Find(BalancedScreen, 'Cancel');
  Test.AssertTrue(
    BalancedScreen.CellAt(ModelsAt.X, ModelsAt.Y).Role = Tui.TuiStyleRole.OverlayTitle
  );
  Test.AssertTrue(
    BalancedScreen.CellAt(CancelAt.X, CancelAt.Y).ButtonAppearance.Unwrap().Kind =
    Tui.TuiButtonKind.Cancel
  );
  Test.AssertEquals('╭', BalancedScreen.CellAt(ModelsAt.X, ModelsAt.Y + 1).Glyph);
  Test.AssertEquals('╮', BalancedScreen.CellAt(74, ModelsAt.Y + 1).Glyph);
  Test.AssertEquals(ModelsAt.X, TestAt.X - 1);
  Test.AssertEquals(TestAt.Y, CancelAt.Y);
  Test.AssertEquals(74, CancelAt.X + 6);
  for Index: integer := 1 to 5 do
    BalancedModel := Press(Balanced, BalancedModel, Tui.TuiKeyKind.Tab);
  end for;

  Test.AssertEquals(62, BalancedModel.FocusedControl);
  for Index: integer := 1 to 7 do
    BalancedModel := Press(Balanced, BalancedModel, Tui.TuiKeyKind.Down);
    Test.AssertEquals(Index, BalancedModel.Gamemaster.Row);
  end for;

  Test.AssertTrue(Contains(Balanced.SurfaceSnapshot(), 'Choice 7'));
  AssertSettingsFrame(Balanced.SurfaceSnapshot(), 4, 4, 72, 17);
  Balanced.InjectResizeForTest(Tui.TuiSize.Create(120, 40));
  BalancedModel := Balanced.RunIterations(
    BalancedModel,
    ConsoleUnit.UpdateServerConsole,
    ConsoleUnit.ViewServerConsole,
    1,
    0
  );
  AssertSettingsFrame(Balanced.SurfaceSnapshot(), 24, 10, 72, 20);
  Balanced.InjectResizeForTest(Tui.TuiSize.Create(200, 60));
  BalancedModel := Balanced.RunIterations(
    BalancedModel,
    ConsoleUnit.UpdateServerConsole,
    ConsoleUnit.ViewServerConsole,
    1,
    0
  );
  AssertSettingsFrame(Balanced.SurfaceSnapshot(), 50, 15, 100, 30);
  Balanced.InjectResizeForTest(Tui.TuiSize.Create(30, 10));
  BalancedModel := Balanced.RunIterations(
    BalancedModel,
    ConsoleUnit.UpdateServerConsole,
    ConsoleUnit.ViewServerConsole,
    1,
    0
  );
  Test.AssertTrue(Contains(Balanced.SurfaceSnapshot(), 'Terminal too small'));
  Balanced.InjectResizeForTest(Tui.TuiSize.Create(80, 25));
  BalancedModel := Balanced.RunIterations(
    BalancedModel,
    ConsoleUnit.UpdateServerConsole,
    ConsoleUnit.ViewServerConsole,
    1,
    0
  );
  AssertSettingsFrame(Balanced.SurfaceSnapshot(), 4, 4, 72, 17);
  Test.AssertEquals(1, BalancedModel.SettingsTab);
  Test.AssertEquals(70, BalancedModel.FocusedControl);
  Test.AssertTrue(BalancedModel.Gamemaster.Open);
  Balanced.Close();
  for Size: Tui.TuiSize in [
    Tui.TuiSize.Create(80, 40),
    Tui.TuiSize.Create(99, 32),
    Tui.TuiSize.Create(100, 18),
    Tui.TuiSize.Create(80, 24),
    Tui.TuiSize.Create(40, 12),
    Tui.TuiSize.Create(4, 4),
    Tui.TuiSize.Create(1, 1),
    Tui.TuiSize.Create(0, 0)
  ] do
    const Tiny := Tui.TuiApplication.OpenForTest(Size);
    var Small := ConsoleUnit.UpdateServerConsole(
      Model with SettingsOpen := false; FocusedControl := 20; end with,
      Tui.TuiMsg.Resize(Size),
      Cmd
    );
    Small := Tiny.RunIterations(
      Small,
      ConsoleUnit.UpdateServerConsole,
      ConsoleUnit.ViewServerConsole,
      0,
      0
    );
    Test.AssertEquals(Size.Width, Tiny.SurfaceSnapshot().Width);
    if Size.Width >= 40 then
      Test.AssertTrue(Contains(Tiny.SurfaceSnapshot(), 'LIVE LOG'));
      Test.AssertTrue(Contains(Tiny.SurfaceSnapshot(), 'Stop server'));
    end if;

    if (Size.Width = 40) and (Size.Height = 12) then
      Test.AssertEquals('╰', Tiny.SurfaceSnapshot().CellAt(0, 7).Glyph);
    end if;

    Tiny.Close();
  end for;
end.
