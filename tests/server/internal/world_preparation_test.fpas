// Failed catalog, world selection and initial projection preserve the installed session exactly.
program WorldPreparationTest;

uses Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Protocol as Protocol, Dungeon.Protocol.ServerMessages as ServerMessages, Dungeon.Protocol.Transport as Transport, Dungeon.RuntimeData as RuntimeData, Dungeon.Server.Config as ConfigUnit, Dungeon.Server.Handling as Handling, Dungeon.Server.Session as SessionUnit, Dungeon.Server.Worlds as Worlds, Dungeon.World as WorldUnit, Dungeon.World.Catalog as CatalogUnit, Std.Conv as Conv, Std.Fs as Fs, Std.Net as Net, Std.Path as PathOps, Std.Tasks as Tasks, Std.Test as Test, Std.Time as Time;

procedure Rejected(Client: Net.Connection; Token: Tasks.CancellationToken; Expected: string);
begin
  const Reply: Transport.LineRead := Transport.ReadLine(
    Transport.NewLineReader(Client),
    Token
  ).Unwrap();
  case ServerMessages.DecodeServer(Reply.Line).Unwrap() of
    when Protocol.ServerMessage.Rejected(const Code, const Reason):
      Test.AssertEquals(Expected, Code);
    when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
      panic('expected rejection');
  end case;
end procedure;

begin
  const Root: string := '.temp-data/preparation-' + Conv.IntToStr(Time.TimestampMillis());
  const Runtime: RuntimeData.RuntimeSettings := RuntimeData.LoadServerRuntime(Some(Root)).Unwrap();
  const First: WorldUnit.WorldSession := CatalogUnit.CreateWorld(
    Runtime.Paths.Worlds,
    12345,
    4,
    32
  ).Unwrap();
  const Second: WorldUnit.WorldSession := CatalogUnit.CreateWorld(
    Runtime.Paths.Worlds,
    24680,
    4,
    32
  ).Unwrap();
  const Config: ConfigUnit.ServerConfig := ConfigUnit.ServerConfig(
    ConfigPath := Runtime.Paths.ServerConfig,
    Logs := None,
    WorldsRoot := Runtime.Paths.Worlds,
    WorldId := First.Metadata.Id,
    WorldSeed := 12345,
    DungeonRegionChunks := 4,
    ChunkCacheLimit := 32,
    MaximumViewWidth := 80,
    MaximumViewHeight := 24
  );
  // Large catalogs retain unusable worlds and bound every page, including selection at its end.
  for Index: integer := 0 to 64 do
    Test.AssertTrue(
      Fs.CreateDirAll(PathOps.Join([Runtime.Paths.Worlds, 'a-' + Conv.IntToStr(Index)])).Unwrap()
    );
  end for;
  const FirstPage: Protocol.WorldCatalog := Worlds.CatalogFor(
    Config,
    First.Metadata.Id,
    0
  ).Unwrap();
  Test.AssertEquals(67, FirstPage.Total);
  Test.AssertEquals(64, FirstPage.Worlds.Length());
  Test.AssertEquals('incompatible', FirstPage.Worlds[0].Status);
  Test.AssertEquals('unknown', FirstPage.Worlds[0].SaveStatus);
  const SelectedPage: Protocol.WorldCatalog := Worlds.CatalogFor(
    Config,
    First.Metadata.Id,
    -1
  ).Unwrap();
  Test.AssertEquals(65, SelectedPage.Offset);
  Test.AssertEquals(2, SelectedPage.Worlds.Length());
  Test.AssertEquals(First.Metadata.Id, SelectedPage.Worlds[0].Id);
  const FinalPage: Protocol.WorldCatalog := Worlds.CatalogFor(
    Config,
    First.Metadata.Id,
    1000000
  ).Unwrap();
  Test.AssertEquals(64, FinalPage.Offset);
  Test.AssertEquals(3, FinalPage.Worlds.Length());
  const Session: SessionUnit.ServerSession := Worlds.NewServerSession(
    Config,
    SessionUnit.ViewportSize(Width := 9, Height := 5)
  ).Unwrap();
  const ListenerValue: Net.Listener := Net.Listen('127.0.0.1', 0).Unwrap();
  const Address: Net.NetworkAddress := Net.ListenerLocalAddress(ListenerValue).Unwrap();
  const Client: Net.Connection := Net.Connect('127.0.0.1', Address.Port, 5000).Unwrap();
  const Server: Net.Connection := Net.Accept(ListenerValue).Unwrap();
  Test.AssertTrue(Net.SetTimeout(Client, 30000).Unwrap());
  const Token: Tasks.CancellationToken := Tasks.GetCancellationToken(
    Tasks.CreateCancellationSource()
  );
  // Opening candidate metadata succeeds, but its catalog cannot be prepared.
  const Defaults: string := Fs.ReadText(Runtime.Paths.ServerConfig).Unwrap();
  Test.AssertTrue(Fs.WriteTextAtomic(Runtime.Paths.ServerConfig, '{').Unwrap());
  const Unchanged: SessionUnit.ServerSession := Handling.HandleSessionMessage(
    Session,
    Protocol.ClientMessage.SelectWorld(Second.Metadata.Id),
    Server,
    Config,
    Token
  ).Unwrap();
  Rejected(Client, Token, 'storage_error');
  Test.AssertEquals(First.Metadata.Id, Unchanged.World.Metadata.Id);
  Test.AssertTrue(Unchanged.State is None);
  const Active: SessionUnit.ServerSession := Session with State := Some(
    GameState.NewGame(First.Metadata) with Health := 7; end with
  ); Dirty := true; end with;
  const Kept: SessionUnit.ServerSession := Handling.HandleSessionMessage(
    Active,
    Protocol.ClientMessage.ListWorlds(0, true),
    Server,
    Config,
    Token
  ).Unwrap();
  Rejected(Client, Token, 'storage_error');
  Test.AssertTrue(Kept.Dirty);
  Test.AssertEquals(7, Kept.State.Unwrap().Health);
  Test.AssertEquals(First.Metadata.Id, Kept.World.Metadata.Id);
  Test.AssertTrue(Fs.WriteTextAtomic(Runtime.Paths.ServerConfig, Defaults).Unwrap());
  const BadMetadata: string := Fs.ReadText(WorldUnit.WorldMetadataPath(Second)).Unwrap();
  Test.AssertTrue(Fs.WriteTextAtomic(WorldUnit.WorldMetadataPath(Second), '{').Unwrap());
  const Wrong: SessionUnit.ServerSession := Handling.HandleSessionMessage(
    Session,
    Protocol.ClientMessage.SelectWorld(Second.Metadata.Id),
    Server,
    Config,
    Token
  ).Unwrap();
  Rejected(Client, Token, 'world_incompatible');
  Test.AssertEquals(First.Metadata.Id, Wrong.World.Metadata.Id);
  Test.AssertEquals('{', Fs.ReadText(WorldUnit.WorldMetadataPath(Second)).Unwrap());
  Test.AssertTrue(Fs.WriteTextAtomic(WorldUnit.WorldMetadataPath(Second), BadMetadata).Unwrap());
  // A blocked spawn chunk makes projection fail before the candidate state is installed.
  const Chunk: Coordinates.ChunkCoordinate := Coordinates.ChunkCoordinate(
    X := Coordinates.ChunkForCoordinate(First.Metadata.Spawn.X),
    Y := Coordinates.ChunkForCoordinate(First.Metadata.Spawn.Y)
  );
  const Blocked: string := WorldUnit.WorldChunkPath(First, Chunk);
  Test.AssertTrue(Fs.CreateDirAll(Blocked).Unwrap());
  const NotStarted: SessionUnit.ServerSession := Handling.HandleSessionMessage(
    Session,
    Protocol.ClientMessage.StartNewGame,
    Server,
    Config,
    Token
  ).Unwrap();
  Rejected(Client, Token, 'storage_error');
  Test.AssertTrue(NotStarted.State is None);
  Test.AssertFalse(NotStarted.Dirty);
  Test.AssertEquals(First.Metadata.Id, NotStarted.World.Metadata.Id);
  Test.AssertTrue(Fs.IsDir(Blocked));
  Test.AssertTrue(Net.Close(Server).Unwrap());
  Test.AssertTrue(Net.Close(Client).Unwrap());
  Test.AssertTrue(Net.CloseListener(ListenerValue).Unwrap());
end.
