// Failed catalog, world selection and initial projection preserve the installed session exactly.
program WorldPreparationTest;

uses
  Dungeon.Coordinates, Dungeon.GameState, Dungeon.Protocol, Dungeon.Protocol.ServerMessages,
  Dungeon.Protocol.Transport, Dungeon.RuntimeData, Dungeon.Server.Config, Dungeon.Server.Handling,
  Dungeon.Server.Session, Dungeon.Server.Worlds, Dungeon.World, Dungeon.World.Catalog, Std.Conv,
  Std.Fs, Std.Net, Std.Path, Std.Tasks, Std.Test, Std.Time;

procedure Rejected(Client: Connection; Token: CancellationToken; Expected: string);
begin
  const Reply: LineRead := ReadLine(NewLineReader(Client), Token).Unwrap();
  if DecodeServer(Reply.Line).Unwrap() is ServerMessage.Rejected(const Code, const Reason) then
    begin
      AssertEquals(Expected, Code);
    end;
  else
    begin
      panic('expected rejection');
    end;
  end if;
end procedure;

begin
  const Root: string := '.temp-data/preparation-' + IntToStr(TimestampMillis());
  const Runtime: RuntimeSettings := LoadServerRuntime(Some(Root)).Unwrap();
  const First: WorldSession := Dungeon.World.Catalog.CreateWorld(Runtime.Paths.Worlds, 12345, 4, 32)
                                 .Unwrap();
  const Second: WorldSession := Dungeon.World.Catalog.CreateWorld(Runtime.Paths.Worlds, 24680, 4, 32)
                                  .Unwrap();
  const Config: ServerConfig := ServerConfig(ConfigPath := Runtime.Paths.ServerConfig, Logs := None, WorldsRoot := Runtime.Paths.Worlds, WorldId := First.Metadata.Id, WorldSeed := 12345, DungeonRegionChunks := 4, ChunkCacheLimit := 32, MaximumViewWidth := 80, MaximumViewHeight := 24);
  // Large catalogs retain unusable worlds and bound every page, including selection at its end.
  for Index: integer := 0 to 64 do
    AssertTrue(Std.Fs.CreateDirAll(Std.Path.Join([Runtime.Paths.Worlds, 'a-' + IntToStr(Index)]))
                 .Unwrap());
  end for;
  const FirstPage: WorldCatalog := CatalogFor(Config, First.Metadata.Id, 0).Unwrap();
  AssertEquals(67, FirstPage.Total);
  AssertEquals(64, FirstPage.Worlds.Length());
  AssertEquals('incompatible', FirstPage.Worlds[0].Status);
  AssertEquals('unknown', FirstPage.Worlds[0].SaveStatus);
  const SelectedPage: WorldCatalog := CatalogFor(Config, First.Metadata.Id, -1).Unwrap();
  AssertEquals(65, SelectedPage.Offset);
  AssertEquals(2, SelectedPage.Worlds.Length());
  AssertEquals(First.Metadata.Id, SelectedPage.Worlds[0].Id);
  const FinalPage: WorldCatalog := CatalogFor(Config, First.Metadata.Id, 1000000).Unwrap();
  AssertEquals(64, FinalPage.Offset);
  AssertEquals(3, FinalPage.Worlds.Length());
  const Session: ServerSession := NewServerSession(Config, ViewportSize(Width := 9, Height := 5))
                                    .Unwrap();
  const ListenerValue: Listener := Listen('127.0.0.1', 0).Unwrap();
  const Address: NetworkAddress := ListenerLocalAddress(ListenerValue).Unwrap();
  const Client: Connection := Connect('127.0.0.1', Address.Port, 5000).Unwrap();
  const Server: Connection := Accept(ListenerValue).Unwrap();
  AssertTrue(SetTimeout(Client, 30000).Unwrap());
  const Token: CancellationToken := GetCancellationToken(CreateCancellationSource());
  // Opening candidate metadata succeeds, but its catalog cannot be prepared.
  const Defaults: string := Std.Fs.ReadText(Runtime.Paths.ServerConfig).Unwrap();
  AssertTrue(Std.Fs.WriteTextAtomic(Runtime.Paths.ServerConfig, '{').Unwrap());
  const Unchanged: ServerSession := HandleSessionMessage(Session, ClientMessage.SelectWorld(Second.Metadata.Id), Server, Config, Token)
                                      .Unwrap();
  Rejected(Client, Token, 'storage_error');
  AssertEquals(First.Metadata.Id, Unchanged.World.Metadata.Id);
  AssertTrue(Unchanged.State.IsNone());
  const Active: ServerSession := Session with State := Some(NewGame(First.Metadata) with Health := 7; end with); Dirty := true; end with;
  const Kept: ServerSession := HandleSessionMessage(Active, ClientMessage.ListWorlds(0, true), Server, Config, Token)
                                 .Unwrap();
  Rejected(Client, Token, 'storage_error');
  AssertTrue(Kept.Dirty);
  AssertEquals(7, Kept.State.Unwrap().Health);
  AssertEquals(First.Metadata.Id, Kept.World.Metadata.Id);
  AssertTrue(Std.Fs.WriteTextAtomic(Runtime.Paths.ServerConfig, Defaults).Unwrap());
  const BadMetadata: string := Std.Fs.ReadText(WorldMetadataPath(Second)).Unwrap();
  AssertTrue(Std.Fs.WriteTextAtomic(WorldMetadataPath(Second), '{').Unwrap());
  const Wrong: ServerSession := HandleSessionMessage(Session, ClientMessage.SelectWorld(Second.Metadata.Id), Server, Config, Token)
                                  .Unwrap();
  Rejected(Client, Token, 'world_incompatible');
  AssertEquals(First.Metadata.Id, Wrong.World.Metadata.Id);
  AssertEquals('{', Std.Fs.ReadText(WorldMetadataPath(Second)).Unwrap());
  AssertTrue(Std.Fs.WriteTextAtomic(WorldMetadataPath(Second), BadMetadata).Unwrap());
  // A blocked spawn chunk makes projection fail before the candidate state is installed.
  const Chunk: ChunkCoordinate := ChunkCoordinate(X := ChunkForCoordinate(First.Metadata.Spawn.X), Y := ChunkForCoordinate(First.Metadata.Spawn.Y));
  const Blocked: string := WorldChunkPath(First, Chunk);
  AssertTrue(Std.Fs.CreateDirAll(Blocked).Unwrap());
  const NotStarted: ServerSession := HandleSessionMessage(Session, ClientMessage.StartNewGame, Server, Config, Token)
                                       .Unwrap();
  Rejected(Client, Token, 'storage_error');
  AssertTrue(NotStarted.State.IsNone());
  AssertFalse(NotStarted.Dirty);
  AssertEquals(First.Metadata.Id, NotStarted.World.Metadata.Id);
  AssertTrue(Std.Fs.IsDir(Blocked));
  AssertTrue(Close(Server).Unwrap());
  AssertTrue(Close(Client).Unwrap());
  AssertTrue(CloseListener(ListenerValue).Unwrap());
end.
