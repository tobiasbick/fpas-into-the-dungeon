// Game overlays retain their inset and clickable controls at ordinary and compact sizes.
program OverlaySpacingTest;

uses Dungeon.Ui.Overlay as Overlay, Std.Test as Test, Std.Ui.Terminal as Tui;

function View(State: integer): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeDesktop(
    Some(Tui.TuiControlId.Create(1)), [
      Overlay.Create(
        'Info', [
          Tui.TuiElementBuilders.MakeLabel('Content'),
          Tui.TuiElementBuilders.MakeButton(
            Tui.TuiControlId.Create(1),
            'Go',
            Tui.TuiAction.Create(1)
          )
        ]
      )
    ]
  );
end function;

function Update(State: integer; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): integer;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  if Msg is Tui.TuiMsg.Action(_, _) then
    return State + 1;
  end if;

  return State;
end function;

function Find(Screen: Tui.TuiSurfaceSnapshot; Text: string): Tui.TuiPoint;
begin
  for Y: integer := 0 to Screen.Height - 1 do
    case Screen.LineAt(Y).IndexOf(Text) of
      when Some(const X):
        return Tui.TuiPoint.Create(X, Y);
      when None:
        null;
    end case;
  end for;

  panic('overlay text missing');
end function;

begin
  for Size: Tui.TuiSize in [Tui.TuiSize.Create(20, 10), Tui.TuiSize.Create(11, 6)] do
    const App := Tui.TuiApplication.OpenForTest(Size);
    var State := App.RunIterations(0, Update, View, 0, 0);
    const Screen := App.SurfaceSnapshot();
    const Frame := Find(Screen, '╭');
    const Content := Find(Screen, 'Content');
    const Button := Find(Screen, 'Go');
    Test.AssertEquals(Frame.X + 2, Content.X);
    Test.AssertEquals(Frame.Y + 2, Content.Y);
    Test.AssertEquals('╮', Screen.CellAt(Content.X + 8, Frame.Y).Glyph);
    Test.AssertEquals('╰', Screen.CellAt(Frame.X, Button.Y + 2).Glyph);
    Test.AssertEquals(' ', Screen.CellAt(Content.X - 1, Content.Y).Glyph);
    Test.AssertEquals(' ', Screen.CellAt(Content.X + 7, Content.Y).Glyph);
    Test.AssertEquals(' ', Screen.CellAt(Content.X, Content.Y - 1).Glyph);
    Test.AssertEquals(' ', Screen.CellAt(Content.X, Button.Y + 1).Glyph);
    App.InjectPointerForTest(
      Tui.TuiPointerEvent.Create(Tui.TuiPointerAction.Down, Tui.TuiPointerButton.Left, Button)
    );
    State := App.RunIterations(State, Update, View, 1, 0);
    App.InjectPointerForTest(
      Tui.TuiPointerEvent.Create(Tui.TuiPointerAction.Up, Tui.TuiPointerButton.Left, Button)
    );
    State := App.RunIterations(State, Update, View, 1, 0);
    Test.AssertEquals(1, State);
    App.Close();
  end for;
end.
