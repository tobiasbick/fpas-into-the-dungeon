// Plays a three-level dungeon over TCP: down to the deepest level, save, reconnect with an exact
// replay of unsaved turns, climb back to the landings, leave, and continue the final save.
program DungeonLevelsNetworkTest;

uses Dungeon.Coordinates as Coordinates, Dungeon.Interior as InteriorUnit, Dungeon.Protocol as Protocol, Dungeon.Server as Server, Dungeon.Server.Config as ConfigUnit, Dungeon.Terrain as Terrain, Dungeon.Terrain.Entrances as Entrances, Dungeon.Terrain.Placement as PlacementRules, Dungeon.Test.Routes as Routes, Dungeon.Test.Wire as Wire, Dungeon.World as WorldUnit, Dungeon.World.Savegame as Savegame, Std.Conv as Conv, Std.Math as Math, Std.Fs as Fs, Std.Net as Net, Std.Path as PathOps, Std.Tasks as Tasks, Std.Test as Test, Std.Time as Time;

// Renders network failures for the server's text-based session callback.
function FailureMessage(Cause: Net.NetError): string;
begin
  return Cause.Message();
end function;

function TestConfig(WorldsRoot: string): ConfigUnit.ServerConfig;
begin
  return ConfigUnit.ServerConfig(
    ConfigPath := '', Logs := None, WorldsRoot := WorldsRoot, WorldId := 'levels-net',
    WorldSeed := 9462, DungeonRegionChunks := 4, ChunkCacheLimit := 32,
    MaximumViewWidth := 240, MaximumViewHeight := 120
  );
end function;

function ServeOne(ListenerValue: Net.Listener; Config: ConfigUnit.ServerConfig; Token: Tasks.CancellationToken): result of (boolean, string);
begin
  const Client: Net.Connection := try Net.AcceptWithCancellation(
    ListenerValue,
    Token
  ).MapError(FailureMessage);
  const Configured: boolean := try Net.SetTimeout(Client, 120000).MapError(FailureMessage);
  const Outcome: result of (boolean, string) := Server.ServeConnection(Client, Config, Token);
  const Closed: boolean := try Net.Close(Client).MapError(FailureMessage);
  return Outcome;
end function;

// Walks onto the given field and presses Enter there.
function TakeTransition(Client: Wire.WireClient; Map: InteriorUnit.InteriorMap; Field: Coordinates.InteriorPosition; Token: Tasks.CancellationToken): Wire.WireClient;
begin
  const Arrived := Wire.WalkPastOpponents(Client, Map, Field, Token).Unwrap();
  return Wire.Exchange(Arrived, Protocol.ClientMessage.Interact, Token);
end function;

// Renders the replay-relevant parts of a first-person view.
function ViewText(View: Protocol.FirstPersonVisibleState): string;
begin
  var Text := View.Title + '|' + View.Status + '|' + Conv.IntToStr(View.PlayerX) + ',' +
    Conv.IntToStr(View.PlayerY) + '|' +
    Conv.IntToStr(View.Health) + '|';
  for Row: string in View.Rows do
    Text := Text + Row + '/';
  end for;

  return Text;
end function;

function LevelFile(World: WorldUnit.WorldSession; Level: integer): string;
begin
  const Region := Entrances.RegionOf(World.Metadata, World.Metadata.Spawn);
  return PathOps.Join([
    World.Directory, 'dungeons', (Conv.IntToStr(Region.X) + '_') + Conv.IntToStr(Region.Y),
    Conv.IntToStr(Level) + '.json'
  ]);
end function;

begin
  const WorldsRoot: string := '.temp-data/levels-net-' + Conv.IntToStr(Time.TimestampMillis());
  Test.AssertTrue(Fs.CreateDirAll(WorldsRoot).Unwrap());
  const Config := TestConfig(WorldsRoot);
  const Metadata: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
    Config.WorldId,
    Config.WorldSeed,
    4
  ).Unwrap();
  const Level0 := Routes.SpawnDungeonLevel(Metadata, 0);
  const Level1 := Routes.SpawnDungeonLevel(Metadata, 1);
  const Level2 := Routes.SpawnDungeonLevel(Metadata, 2);
  // The server preselects this existing world.
  const World := WorldUnit.OpenWorld(WorldsRoot, Config.WorldId, Config.WorldSeed, 4, 32).Unwrap();
  const Token := Tasks.GetCancellationToken(Tasks.CreateCancellationSource());
  const ListenerValue := Net.Listen('127.0.0.1', 0).Unwrap();
  const Port := Net.ListenerLocalAddress(ListenerValue).Unwrap().Port;
  var SavedView := '';
  var ReplayedView := '';
  // First session: descend to the deepest level and save there, then play unsaved turns.
  scope
    const FirstServer := go ServeOne(ListenerValue, Config, Token);
    var Client := Wire.Exchange(
      Wire.ConnectClient(Port, Token),
      Protocol.ClientMessage.StartNewGame,
      Token
    );
    Test.AssertTrue(Client.Last is Protocol.ServerMessage.State(_));
    Client := Wire.Exchange(
      Wire.WalkOutdoors(Client, Metadata.SpawnEntrance, Token),
      Protocol.ClientMessage.Interact,
      Token
    );
    var View := Wire.FirstPersonOf(Client);
    Test.AssertEquals(0, View.Level);
    Test.AssertEquals(3, View.Depth);
    Test.AssertEquals(Level0.DisplayName + ' — Level 1 of 3', View.Title);
    // Standing on the stairs shows the hint; Enter descends.
    Client := Wire.WalkPastOpponents(
      Client,
      Level0,
      InteriorUnit.StairsDownPosition(Level0).Unwrap(),
      Token
    ).Unwrap();
    Test.AssertEquals('Stairs down — Enter: Go down', Wire.FirstPersonOf(Client).Status);
    Client := Wire.Exchange(Client, Protocol.ClientMessage.Interact, Token);
    View := Wire.FirstPersonOf(Client);
    Test.AssertEquals(1, View.Level);
    Test.AssertEquals(Level1.Start.X, View.PlayerX);
    Test.AssertEquals(Level1.Start.Y, View.PlayerY);
    Client := TakeTransition(
      Client,
      Level1,
      InteriorUnit.StairsDownPosition(Level1).Unwrap(),
      Token
    );
    View := Wire.FirstPersonOf(Client);
    Test.AssertEquals(2, View.Level);
    Test.AssertEquals(Level2.DisplayName + ' — Level 3 of 3', View.Title);
    Wire.RequireSaved(Wire.Exchange(Client, Protocol.ClientMessage.SaveGame, Token));
    // Unsaved turns after the save.
    for Turn: integer := 1 to 4 do
      Client := Wire.Exchange(Client, Protocol.ClientMessage.Wait, Token);
    end for;

    Client := Wire.Exchange(
      Client,
      Protocol.ClientMessage.TurnFirstPerson(Protocol.FirstPersonTurnDirection.Left),
      Token
    );
    SavedView := ViewText(Wire.FirstPersonOf(Client));
    Wire.CloseClient(Client, Token);
    Test.AssertTrue(Tasks.Wait(FirstServer).Unwrap());
  end scope;

  for Level: integer := 0 to 2 do
    Test.AssertTrue(Fs.IsFile(LevelFile(World, Level)));
  end for;
  const LevelBytes := Fs.ReadText(LevelFile(World, 1)).Unwrap();
  // Second session: Continue the save, replay the same turns exactly, then climb out.
  scope
    const SecondServer := go ServeOne(ListenerValue, Config, Token);
    var Client := Wire.Exchange(
      Wire.ConnectClient(Port, Token),
      Protocol.ClientMessage.LoadGame,
      Token
    );
    Test.AssertEquals(2, Wire.FirstPersonOf(Client).Level);
    for Turn: integer := 1 to 4 do
      Client := Wire.Exchange(Client, Protocol.ClientMessage.Wait, Token);
    end for;

    Client := Wire.Exchange(
      Client,
      Protocol.ClientMessage.TurnFirstPerson(Protocol.FirstPersonTurnDirection.Left),
      Token
    );
    ReplayedView := ViewText(Wire.FirstPersonOf(Client));
    Test.AssertEquals(SavedView, ReplayedView);
    // Stairs up lead to the landing east of each stairs down; the exit leads outdoors.
    Client := TakeTransition(Client, Level2, Level2.Arrival, Token);
    var View := Wire.FirstPersonOf(Client);
    Test.AssertEquals(1, View.Level);
    Test.AssertEquals(InteriorUnit.DescentLanding(Level1).Unwrap().Position.X, View.PlayerX);
    Test.AssertEquals(InteriorUnit.DescentLanding(Level1).Unwrap().Position.Y, View.PlayerY);
    Test.AssertTrue(View.Facing = Protocol.FirstPersonFacing.East);
    Client := TakeTransition(Client, Level1, Level1.Arrival, Token);
    View := Wire.FirstPersonOf(Client);
    Test.AssertEquals(0, View.Level);
    // The skeleton that chased the player in the first session now stands on the landing, so the
    // player arrives on the neighboring free field instead of being locked out of level 0.
    const Landing0 := InteriorUnit.DescentLanding(Level0).Unwrap().Position;
    Test.AssertTrue(not ((View.PlayerX = Landing0.X) and (View.PlayerY = Landing0.Y)));
    Test.AssertEquals(1, Math.Abs(View.PlayerX - Landing0.X) + Math.Abs(View.PlayerY - Landing0.Y));
    Client := TakeTransition(Client, Level0, Level0.Arrival, Token);
    const Outdoor := Wire.MapOf(Client);
    Test.AssertEquals(Metadata.SpawnEntrance.X, Outdoor.WorldX);
    Test.AssertEquals(Metadata.SpawnEntrance.Y, Outdoor.WorldY);
    Wire.RequireSaved(Wire.Exchange(Client, Protocol.ClientMessage.OverwriteSaveGame, Token));
    Wire.CloseClient(Client, Token);
    Test.AssertTrue(Tasks.Wait(SecondServer).Unwrap());
  end scope;

  // Third session: Continue resumes outdoors at the entrance.
  scope
    const ThirdServer := go ServeOne(ListenerValue, Config, Token);
    const Client := Wire.Exchange(
      Wire.ConnectClient(Port, Token),
      Protocol.ClientMessage.LoadGame,
      Token
    );
    Test.AssertEquals(Metadata.SpawnEntrance.X, Wire.MapOf(Client).WorldX);
    Test.AssertEquals(Metadata.SpawnEntrance.Y, Wire.MapOf(Client).WorldY);
    Wire.CloseClient(Client, Token);
    Test.AssertTrue(Tasks.Wait(ThirdServer).Unwrap());
  end scope;

  // Revisits and saves never rewrite level files.
  Test.AssertEquals(LevelBytes, Fs.ReadText(LevelFile(World, 1)).Unwrap());
  const SaveText := Fs.ReadText(Savegame.SaveGamePath(World)).Unwrap();
  Test.AssertTrue(('"' + Config.WorldId + ':dungeon:') in SaveText);
  Test.AssertTrue(Net.CloseListener(ListenerValue).Unwrap());
end.
