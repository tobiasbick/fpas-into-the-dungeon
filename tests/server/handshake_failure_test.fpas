// Verifies that missing level data remains visible in the catalog and rejects Continue without deleting saves.
program HandshakeFailureTest;

uses
  Dungeon.Client, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interior, Dungeon.Protocol,
  Dungeon.Protocol.Worlds, Dungeon.Protocol.ClientMessages, Dungeon.Protocol.ServerMessages,
  Dungeon.Protocol.Transport, Dungeon.RuntimeData, Dungeon.Server, Dungeon.Server.Config,
  Dungeon.Terrain, Dungeon.Terrain.Entrances, Dungeon.Test.ClientSession, Dungeon.Test.Levels,
  Dungeon.World, Dungeon.World.Savegame, Std.Conv, Std.Fs, Std.Net, Std.Path, Std.Tasks, Std.Test,
  Std.Time, Std.Tui;

function TestConfig(WorldsRoot: string): ServerConfig;
begin
  return ServerConfig(ConfigPath := '', Logs := None, WorldsRoot := WorldsRoot, WorldId := 'handshake', WorldSeed := 24680, DungeonRegionChunks := 4, ChunkCacheLimit := 32, MaximumViewWidth := 240, MaximumViewHeight := 120);
end function;

function ServeOnce(ListenerValue: Listener; Config: ServerConfig; Token: CancellationToken): result of (boolean, string);
begin
  const Client: Connection := try AcceptWithCancellation(ListenerValue, Token);
  const Configured: boolean := try SetTimeout(Client, 30000);
  const Outcome: result of (boolean, string) := ServeConnection(Client, Config, Token);
  const Closed: boolean := try Close(Client);
  return Outcome;
end function;

function ServeReported(
  ListenerValue: Listener;
  Config: ServerConfig;
  Outcomes: channel of string;
  Token: CancellationToken
): result of (boolean, string);
begin
  const Outcome: result of (boolean, string) := ServeOnce(ListenerValue, Config, Token);
  ReportOutcome(Outcomes, 'server', Outcome);
  return Outcome;
end function;

begin
  const WorldsRoot: string := '.temp-data/handshake-failure-' + IntToStr(TimestampMillis());
  const Config: ServerConfig := TestConfig(WorldsRoot);
  const World: WorldSession := OpenWorld(WorldsRoot, Config.WorldId, Config.WorldSeed, 4, 32)
                                 .Unwrap();
  // A valid save that visited the spawn dungeon, whose level file then disappears.
  const Map: InteriorMap := SpawnLevel(World);
  const Entered: GameState := EnterSpawnLevel(World, NewGame(World.Metadata)).Unwrap();
  AssertTrue(WriteSaveGame(World, Entered).Unwrap());
  const SaveBytes: string := Std.Fs.ReadText(SaveGamePath(World)).Unwrap();
  const Region: RegionCoordinate := RegionOf(World.Metadata, World.Metadata.Spawn);
  const LevelPath: string := Std.Path.Join([
                                             World.Directory,
                                             'dungeons',
                                             (IntToStr(Region.X) + '_') + IntToStr(Region.Y),
                                             '0.json'
                                           ]);
  AssertTrue(Std.Fs.DeleteFile(LevelPath).Unwrap());
  const Source: CancellationSource := CreateCancellationSource();
  const Token: CancellationToken := GetCancellationToken(Source);
  // Raw protocol: Rejected with a world-data code instead of Welcome, then the server closes.
  const ListenerValue: Listener := Listen('127.0.0.1', 0).Unwrap();
  const Address: NetworkAddress := ListenerLocalAddress(ListenerValue).Unwrap();
  const ServerTask: task := go ServeOnce(ListenerValue, Config, Token);
  const Client: Connection := Connect('127.0.0.1', Address.Port, 5000).Unwrap();
  AssertTrue(SetTimeout(Client, 30000).Unwrap());
  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Hello(ProtocolVersion, 20, 10)), Token)
               .Unwrap());
  const Reader: LineReader := NewLineReader(Client);
  const Answer: LineRead := ReadLine(Reader, Token).Unwrap();
  if DecodeServer(Answer.Line).Unwrap() is ServerMessage.Welcome(const Version, const Catalog) then
    begin
      const Selected: WorldSummary := SelectedWorld(Catalog).Unwrap();
      AssertEquals('world_data_error', Selected.SaveStatus);
    end;
  else
    begin
      panic('expected welcome with damaged world data');
    end;
  end if;

  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.LoadGame), Token).Unwrap());
  const Rejected: LineRead := ReadLine(Answer.Reader, Token).Unwrap();
  if DecodeServer(Rejected.Line).Unwrap() is ServerMessage.Rejected(const Code, const Message) then
    begin
      AssertEquals('world_data_error', Code);
      AssertTrue(Message.Contains(Map.AreaId));
      AssertFalse(Message.Contains(WorldsRoot));
    end;
  else
    begin
      panic('expected rejected Continue');
    end;
  end if;

  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Disconnect), Token).Unwrap());
  AssertTrue(Std.Tasks.Wait(ServerTask).Unwrap());
  AssertTrue(Close(Client).Unwrap());
  AssertTrue(CloseListener(ListenerValue).Unwrap());
  // The save survives and the missing level is not regenerated by inspection.
  AssertEquals(SaveBytes, Std.Fs.ReadText(SaveGamePath(World)).Unwrap());
  AssertFalse(Std.Fs.Exists(LevelPath));
  // Real network adapter and headless client: the reason arrives as a connection failure.
  const AdapterListener: Listener := Listen('127.0.0.1', 0).Unwrap();
  const AdapterAddress: NetworkAddress := ListenerLocalAddress(AdapterListener).Unwrap();
  const Outcomes: channel of string := CreateChannel(4);
  const Requests: channel of ClientMessage := CreateChannel(4);
  const Events: channel of ClientEvent := CreateChannel(4);
  const AdapterServer: task := go ServeReported(AdapterListener, Config, Outcomes, Token);
  const AdapterClient: task := go RunReportedClient('127.0.0.1', AdapterAddress.Port, 20, 10, Requests, Events, Outcomes, Token);
  const Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  var Model: ClientModel := NewClientModel('127.0.0.1', AdapterAddress.Port, '', DefaultClientPreferences(), Requests, Events);
  if NextClientEvent(Events, Outcomes, 30000) is ClientEvent.Connected(const Catalog) then
    begin
      Model := UpdateClientEvent(Model, ClientEvent.Connected(Catalog), Cmd);
    end;
  else
    begin
      panic('expected usable world selection');
    end;
  end if;

  AssertTrue(Send(Requests, ClientMessage.LoadGame).Unwrap());
  if NextClientEvent(Events, Outcomes, 30000) is ClientEvent.Rejected(const Code, const Message) then
    begin
      AssertEquals('world_data_error', Code);
      AssertTrue(Message.Contains(Map.AreaId));
      Model := UpdateClientEvent(Model, ClientEvent.Rejected(Code, Message), Cmd);
    end;
  else
    begin
      panic('expected Continue rejection');
    end;
  end if;

  AssertTrue(Model.ConnectionPhase = ClientConnectionPhase.AwaitingSession);
  AssertTrue(Model.Status.Contains(Map.AreaId));
  AssertTrue(Send(Requests, ClientMessage.Disconnect).Unwrap());
  const App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(100, 24));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  App.Close();
  AssertTrue(Std.Tasks.Wait(AdapterClient).Unwrap());
  AssertTrue(Std.Tasks.Wait(AdapterServer).Unwrap());
  AssertTrue(CloseListener(AdapterListener).Unwrap());
  AssertEquals(SaveBytes, Std.Fs.ReadText(SaveGamePath(World)).Unwrap());
  discard CloseChannel(Requests);
  discard CloseChannel(Events);
  discard CloseChannel(Outcomes);
end.
