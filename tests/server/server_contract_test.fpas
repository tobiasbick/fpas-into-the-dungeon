// Verifies structured errors for invalid handshake and framing inputs.
program DungeonServerContractTest;

uses
  Dungeon.GameState, Dungeon.Interior.Generation.Validation, Dungeon.Protocol,
  Dungeon.Protocol.ClientMessages, Dungeon.Protocol.ServerMessages, Dungeon.Protocol.Transport,
  Dungeon.Server, Dungeon.Server.Config, Std.Net, Std.Net.Utf8, Std.Tasks, Std.Test;

function TestConfig(): ServerConfig;
begin
  return ServerConfig(ConfigPath := '', Logs := None, WorldsRoot := '.temp-data/server-worlds-v3', WorldId := 'contract', WorldSeed := 12345, DungeonRegionChunks := 4, ChunkCacheLimit := 16, MaximumViewWidth := 40, MaximumViewHeight := 20);
end function;

function ServeOne(ListenerValue: Listener; Token: CancellationToken): result of (boolean, string);
begin
  const Client: Connection := try AcceptWithCancellation(ListenerValue, Token);
  const Configured: boolean := try SetTimeout(Client, 2000);
  const Outcome: result of (boolean, string) := ServeConnection(Client, TestConfig(), Token);
  const Closed: boolean := try Close(Client);
  return Outcome;
end function;

function SendAll(ConnectionValue: Connection; Text: string): result of (boolean, string);
begin
  const Bytes: array of integer := Std.Net.Utf8.Encode(Text);
  var Offset: integer := 0;
  while Offset < Bytes.Length() do
    begin
      const Remaining: array of integer := Bytes.Slice(Offset, Bytes.Length() - Offset);
      const Written: integer := try SendBytes(ConnectionValue, Remaining);
      if Written <= 0 then
        begin
          return Error('connection stopped while writing contract input');
        end;
      end if;

      Offset := Offset + Written;
    end;
  end while;

  return Ok(true);
end function;

function FirstResponse(Text: string): ServerMessage;
begin
  const ListenerValue: Listener := Listen('127.0.0.1', 0).Unwrap();
  const Address: NetworkAddress := ListenerLocalAddress(ListenerValue).Unwrap();
  const Source: CancellationSource := CreateCancellationSource();
  const Token: CancellationToken := GetCancellationToken(Source);
  const ServerTask: task := go ServeOne(ListenerValue, Token);
  const Client: Connection := Connect('127.0.0.1', Address.Port, 5000).Unwrap();
  AssertTrue(SetTimeout(Client, 2000).Unwrap());
  AssertTrue(SendAll(Client, Text + string.Chr(10)).Unwrap());
  const Reader: LineReader := NewLineReader(Client);
  const Response: LineRead := ReadLine(Reader, Token).Unwrap();
  const Message: ServerMessage := DecodeServer(Response.Line).Unwrap();
  AssertTrue(Close(Client).Unwrap());
  AssertTrue(Std.Tasks.Wait(ServerTask).Unwrap());
  AssertTrue(CloseListener(ListenerValue).Unwrap());
  return Message;
end function;

procedure AssertErrorCode(Message: ServerMessage; ExpectedCode: string);
begin
  if Message is ServerMessage.ErrorMessage(const Code, const Text) then
    begin
      AssertEquals(ExpectedCode, Code);
    end;
  else
    begin
      panic('expected structured server error');
    end;
  end if;
end procedure;

begin
  // The independent protocol bound must agree with the game's inventory capacity.
  AssertEquals(MaximumVisibleInventoryItems, MaximumInventoryItems);
  // Generated placement identities must always fit the visible inventory text bound.
  AssertEquals(MaximumVisibleInventoryTextLength, MaximumPlacementIdLength);
  AssertErrorCode(FirstResponse(EncodeClient(ClientMessage.Hello(ProtocolVersion + 1, 20, 10))), 'unsupported_version');
  AssertErrorCode(FirstResponse(EncodeClient(ClientMessage.Hello(ProtocolVersion - 1, 20, 10))), 'unsupported_version');
  AssertErrorCode(FirstResponse(EncodeClient(ClientMessage.Hello(ProtocolVersion, 0, 10))), 'invalid_viewport');
  AssertErrorCode(FirstResponse(EncodeClient(ClientMessage.StartNewGame)), 'expected_hello');
  AssertErrorCode(FirstResponse(EncodeClient(ClientMessage.LoadGame)), 'expected_hello');
  AssertErrorCode(FirstResponse(EncodeClient(ClientMessage.SaveGame)), 'expected_hello');
  AssertErrorCode(FirstResponse(EncodeClient(ClientMessage.Move(1, 0))), 'expected_hello');
  AssertErrorCode(FirstResponse(EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward))), 'expected_hello');
  AssertErrorCode(FirstResponse(EncodeClient(ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Left))), 'expected_hello');
  AssertErrorCode(FirstResponse('{not-json'), 'invalid_message');
  AssertErrorCode(FirstResponse('x'.RepeatStr(MaximumLineBytes + 1)), 'line_too_long');
  const UndersizedCache: ServerConfig := ServerConfig(ConfigPath := '', Logs := None, WorldsRoot := '.temp-data/server-worlds-v3', WorldId := 'contract', WorldSeed := 12345, DungeonRegionChunks := 4, ChunkCacheLimit := 9, MaximumViewWidth := 240, MaximumViewHeight := 120);
  AssertTrue(RunServer('127.0.0.1', 4040, UndersizedCache).IsError());
end.
