// Verifies titled inspection results cross the real client network adapter.
program DescriptionNetworkTest;

uses
  Dungeon.Client, Dungeon.Protocol, Dungeon.Protocol.ServerMessages, Dungeon.Protocol.Transport,
  Dungeon.Test.ClientSession, Std.Net, Std.Results, Std.Tasks, Std.Test;

function ServeSession(ListenerValue: Listener; Token: CancellationToken): result of boolean, string;
begin
  var ConnectionValue: Connection := try AcceptWithCancellation(ListenerValue, Token);
  var Reader: LineReader := NewLineReader(ConnectionValue);
  var Hello: LineRead := try ReadLine(Reader, Token);
  var Welcomed: boolean := try WriteLine(ConnectionValue, EncodeServer(ServerMessage.Welcome(ProtocolVersion, false, false)), Token);
  var Request: LineRead := try ReadLine(Hello.Reader, Token);
  var Sent: boolean := try WriteLine(ConnectionValue, EncodeServer(ServerMessage.Interaction('Ancient coin', 'A tarnished coin.')), Token);
  var FinalRead: LineRead := try ReadLine(Request.Reader, Token);
  return Close(ConnectionValue)
end;

// Serves the scripted session and publishes its outcome so a stalled test reports the cause.
function ServeDescription(
  ListenerValue: Listener;
  Outcomes: channel of string;
  Token: CancellationToken
): result of boolean, string;
begin
  var Outcome: result of boolean, string := ServeSession(ListenerValue, Token);
  ReportOutcome(Outcomes, 'server', Outcome);
  return Outcome
end;

begin
  var ListenerValue: Listener := Unwrap(Listen('127.0.0.1', 0));
  var Address: NetworkAddress := Unwrap(ListenerLocalAddress(ListenerValue));
  var Source: CancellationSource := CreateCancellationSource();
  var Token: CancellationToken := GetCancellationToken(Source);
  var Requests: channel of ClientMessage := CreateChannel(4);
  var Events: channel of ClientEvent := CreateChannel(4);
  var Outcomes: channel of string := CreateChannel(4);
  var ServerTask: task := go ServeDescription(ListenerValue, Outcomes, Token);
  var ClientTask: task := go RunReportedClient('127.0.0.1', Address.Port, 1, 1, Requests, Events, Outcomes, Token);
  var Welcome: ClientEvent := NextClientEvent(Events, Outcomes, 5000);
  AssertTrue(Unwrap(SendWithTimeout(Requests, ClientMessage.Interact, 1000)));
  case NextClientEvent(Events, Outcomes, 5000) of
    ClientEvent.Interaction(Title, Message):
    begin
      AssertEquals('Ancient coin', Title);
      AssertEquals('A tarnished coin.', Message)
    end
    else
    begin
      panic('expected inspection result')
    end
  end;

  AssertTrue(Unwrap(SendWithTimeout(Requests, ClientMessage.Disconnect, 1000)));
  AssertTrue(Unwrap(Std.Tasks.Wait(ClientTask)));
  AssertTrue(Unwrap(Std.Tasks.Wait(ServerTask)));
  AssertTrue(Unwrap(CloseListener(ListenerValue)));
  CloseChannel(Requests);
  CloseChannel(Events);
  CloseChannel(Outcomes)
end.
