// Verifies titled inspection results cross the real client network adapter.
program DescriptionNetworkTest;

uses Dungeon.Test.Catalog as CatalogUnit, Dungeon.Client as ClientUnit, Dungeon.Protocol as Protocol, Dungeon.Protocol.ServerMessages as ServerMessages, Dungeon.Protocol.Transport as Transport, Dungeon.Test.ClientSession as ClientSession, Std.Net as Net, Std.Tasks as Tasks, Std.Test as Test;

// Renders network failures for the server's text-based session callback.
function FailureMessage(Cause: Net.NetError): string;
begin
  return Cause.Message();
end function;

function ServeSession(ListenerValue: Net.Listener; Token: Tasks.CancellationToken): result of (boolean, string);
begin
  const ConnectionValue: Net.Connection := try Net.AcceptWithCancellation(
    ListenerValue,
    Token
  ).MapError(FailureMessage);
  const Reader: Transport.LineReader := Transport.NewLineReader(ConnectionValue);
  const Hello: Transport.LineRead := try Transport.ReadLine(Reader, Token);
  const Welcomed: boolean := try Transport.WriteLine(
    ConnectionValue,
    ServerMessages.EncodeServer(
      Protocol.ServerMessage.Welcome(
        Protocol.ProtocolVersion,
        CatalogUnit.FixtureCatalog(false, false)
      )
    ),
    Token
  );
  const Request: Transport.LineRead := try Transport.ReadLine(Hello.Reader, Token);
  const Sent: boolean := try Transport.WriteLine(
    ConnectionValue,
    ServerMessages.EncodeServer(
      Protocol.ServerMessage.Interaction('Ancient coin', 'A tarnished coin.')
    ),
    Token
  );
  const FinalRead: Transport.LineRead := try Transport.ReadLine(Request.Reader, Token);
  return Net.Close(ConnectionValue).MapError(FailureMessage);
end function;

// Serves the scripted session and publishes its outcome so a stalled test reports the cause.
function ServeDescription(
  ListenerValue: Net.Listener;
  Outcomes: channel of string;
  Token: Tasks.CancellationToken
): result of (boolean, string);
begin
  const Outcome: result of (boolean, string) := ServeSession(ListenerValue, Token);
  ClientSession.ReportOutcome(Outcomes, 'server', Outcome);
  return Outcome;
end function;

begin
  const ListenerValue: Net.Listener := Net.Listen('127.0.0.1', 0).Unwrap();
  const Address: Net.NetworkAddress := Net.ListenerLocalAddress(ListenerValue).Unwrap();
  const Source: Tasks.CancellationSource := Tasks.CreateCancellationSource();
  const Token: Tasks.CancellationToken := Tasks.GetCancellationToken(Source);
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(4);
  const Events: channel of ClientUnit.ClientEvent := Tasks.CreateChannel(4);
  const Outcomes: channel of string := Tasks.CreateChannel(4);
  scope
    const ServerTask: task of result of (boolean, string) := go ServeDescription(
      ListenerValue,
      Outcomes,
      Token
    );
    const ClientTask: task of result of (boolean, string) := go ClientSession.RunReportedClient(
      '127.0.0.1',
      Address.Port,
      1,
      1,
      Requests,
      Events,
      Outcomes,
      Token
    );
    const Welcome: ClientUnit.ClientEvent := ClientSession.NextClientEvent(Events, Outcomes, 5000);
    Test.AssertTrue(
      Tasks.SendWithTimeout(Requests, Protocol.ClientMessage.Interact, 1000).Unwrap()
    );
    case ClientSession.NextClientEvent(Events, Outcomes, 5000) of
      when ClientUnit.ClientEvent.Interaction(const Title, const Message):
        Test.AssertEquals('Ancient coin', Title);
        Test.AssertEquals('A tarnished coin.', Message);
      when ClientUnit.ClientEvent.Connected(_), ClientUnit.ClientEvent.Worlds(_), ClientUnit.ClientEvent.State(_), ClientUnit.ClientEvent.ExplorationMap(_), ClientUnit.ClientEvent.SaveCompleted, ClientUnit.ClientEvent.Rejected(_, _), ClientUnit.ClientEvent.MapRejected(_, _), ClientUnit.ClientEvent.Defeated(_), ClientUnit.ClientEvent.ViewportState(_), ClientUnit.ClientEvent.Failed(_), ClientUnit.ClientEvent.Dialogue(_, _, _), ClientUnit.ClientEvent.DialogueEnded(_, _), ClientUnit.ClientEvent.Disconnected:
        panic('expected inspection result');
    end case;

    Test.AssertTrue(
      Tasks.SendWithTimeout(Requests, Protocol.ClientMessage.Disconnect, 1000).Unwrap()
    );
    Test.AssertTrue(Tasks.Wait(ClientTask).Unwrap());
    Test.AssertTrue(Tasks.Wait(ServerTask).Unwrap());
  end scope;

  Test.AssertTrue(Net.CloseListener(ListenerValue).Unwrap());
  discard Tasks.CloseChannel(Requests);
  discard Tasks.CloseChannel(Events);
  discard Tasks.CloseChannel(Outcomes);
end.
