// Verifies titled inspection results cross the real client network adapter.
program DescriptionNetworkTest;

uses
  Dungeon.Test.Catalog, Dungeon.Client, Dungeon.Protocol, Dungeon.Protocol.ServerMessages,
  Dungeon.Protocol.Transport, Dungeon.Test.ClientSession, Std.Net, Std.Tasks, Std.Test;

function ServeSession(ListenerValue: Listener; Token: CancellationToken): result of (boolean, string);
begin
  const ConnectionValue: Connection := try AcceptWithCancellation(ListenerValue, Token);
  const Reader: LineReader := NewLineReader(ConnectionValue);
  const Hello: LineRead := try ReadLine(Reader, Token);
  const Welcomed: boolean := try WriteLine(ConnectionValue, EncodeServer(ServerMessage.Welcome(ProtocolVersion, FixtureCatalog(false, false))), Token);
  const Request: LineRead := try ReadLine(Hello.Reader, Token);
  const Sent: boolean := try WriteLine(ConnectionValue, EncodeServer(ServerMessage.Interaction('Ancient coin', 'A tarnished coin.')), Token);
  const FinalRead: LineRead := try ReadLine(Request.Reader, Token);
  return Close(ConnectionValue);
end function;

// Serves the scripted session and publishes its outcome so a stalled test reports the cause.
function ServeDescription(
  ListenerValue: Listener;
  Outcomes: channel of string;
  Token: CancellationToken
): result of (boolean, string);
begin
  const Outcome: result of (boolean, string) := ServeSession(ListenerValue, Token);
  ReportOutcome(Outcomes, 'server', Outcome);
  return Outcome;
end function;

begin
  const ListenerValue: Listener := Listen('127.0.0.1', 0).Unwrap();
  const Address: NetworkAddress := ListenerLocalAddress(ListenerValue).Unwrap();
  const Source: CancellationSource := CreateCancellationSource();
  const Token: CancellationToken := GetCancellationToken(Source);
  const Requests: channel of ClientMessage := CreateChannel(4);
  const Events: channel of ClientEvent := CreateChannel(4);
  const Outcomes: channel of string := CreateChannel(4);
  const ServerTask: task := go ServeDescription(ListenerValue, Outcomes, Token);
  const ClientTask: task := go RunReportedClient('127.0.0.1', Address.Port, 1, 1, Requests, Events, Outcomes, Token);
  const Welcome: ClientEvent := NextClientEvent(Events, Outcomes, 5000);
  AssertTrue(SendWithTimeout(Requests, ClientMessage.Interact, 1000).Unwrap());
  if NextClientEvent(Events, Outcomes, 5000) is ClientEvent.Interaction(const Title, const Message) then
    begin
      AssertEquals('Ancient coin', Title);
      AssertEquals('A tarnished coin.', Message);
    end;
  else
    begin
      panic('expected inspection result');
    end;
  end if;

  AssertTrue(SendWithTimeout(Requests, ClientMessage.Disconnect, 1000).Unwrap());
  AssertTrue(Std.Tasks.Wait(ClientTask).Unwrap());
  AssertTrue(Std.Tasks.Wait(ServerTask).Unwrap());
  AssertTrue(CloseListener(ListenerValue).Unwrap());
  discard CloseChannel(Requests);
  discard CloseChannel(Events);
  discard CloseChannel(Outcomes);
end.
