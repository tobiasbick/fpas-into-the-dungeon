// Real TCP world creation/selection, explicit save/discard guards and reconnect persistence.
program WorldLifecycleTest;

uses
  Dungeon.GameState, Dungeon.Protocol, Dungeon.Protocol.ClientMessages,
  Dungeon.Protocol.ServerMessages, Dungeon.Protocol.Transport, Dungeon.Protocol.Worlds,
  Dungeon.RuntimeData, Dungeon.Server, Dungeon.Server.Config, Dungeon.World, Dungeon.World.Catalog,
  Dungeon.World.Savegame, Std.Conv, Std.Fs, Std.Net, Std.Path, Std.Tasks, Std.Test, Std.Time;

type Exchange = record
  Reader: LineReader;
  Message: ServerMessage;
end record;

function Ask(
  Client: Connection;
  Reader: LineReader;
  Request: ClientMessage;
  Token: CancellationToken
): Exchange;
begin
  AssertTrue(WriteLine(Client, EncodeClient(Request), Token).Unwrap());
  const Response: LineRead := ReadLine(Reader, Token).Unwrap();
  return Exchange(Reader := Response.Reader, Message := DecodeServer(Response.Line).Unwrap());
end function;

function RequireCatalog(Message: ServerMessage): WorldCatalog;
begin
  case Message of
    when ServerMessage.Welcome(const Version, const Catalog):
      begin
        AssertEquals(ProtocolVersion, Version);
        return Catalog;
      end;
    when ServerMessage.Worlds(const Catalog):
      begin
        return Catalog;
      end;
    when servermessage.State(_), servermessage.ExplorationMap(_), servermessage.Interaction(_, _), servermessage.SaveCompleted, servermessage.Defeated(_), servermessage.Rejected(_, _), servermessage.ErrorMessage(_, _):
      begin
        panic('expected catalog');
      end;
  end case;
end function;

function RequireMap(Message: ServerMessage): MapVisibleState;
begin
  if Message is ServerMessage.State(const Visible) then
    begin
      if Visible is VisibleState.MapState(const Value) then
        begin
          return Value;
        end;
      else
        begin
          panic('expected map projection');
        end;
      end if;
    end;
  else
    begin
      panic('expected map state');
    end;
  end if;
end function;

procedure RequireRejected(Message: ServerMessage; Expected: string);
begin
  if Message is ServerMessage.Rejected(const Code, const Reason) then
    begin
      AssertEquals(Expected, Code);
    end;
  else
    begin
      panic('expected rejection ' + Expected);
    end;
  end if;
end procedure;

procedure RequireSaved(Message: ServerMessage);
begin
  if Message is ServerMessage.SaveCompleted then
    begin
      null;
    end;
  else
    begin
      panic('expected save completion');
    end;
  end if;
end procedure;

function ServeOnce(ListenerValue: Listener; Config: ServerConfig; Token: CancellationToken): result of (boolean, string);
begin
  const Client: Connection := try AcceptWithCancellation(ListenerValue, Token);
  const Outcome: result of (boolean, string) := ServeConnection(Client, Config, Token);
  discard Close(Client);
  return Outcome;
end function;

begin
  const Root: string := '.temp-data/lifecycle-' + IntToStr(TimestampMillis());
  AssertTrue(Std.Fs.CreateDirAll(Root).Unwrap());
  const Runtime: RuntimeSettings := LoadServerRuntime(Some(Root + '-settings')).Unwrap();
  const Config: ServerConfig := ServerConfig(ConfigPath := Runtime.Paths.ServerConfig, Logs := None, WorldsRoot := Root, WorldId := 'missing', WorldSeed := 12345, DungeonRegionChunks := 4, ChunkCacheLimit := 32, MaximumViewWidth := 80, MaximumViewHeight := 24);
  const Source: CancellationSource := CreateCancellationSource();
  const Token: CancellationToken := GetCancellationToken(Source);
  const ListenerValue: Listener := Listen('127.0.0.1', 0).Unwrap();
  const Address: NetworkAddress := ListenerLocalAddress(ListenerValue).Unwrap();
  const Worker: task := go ServeOnce(ListenerValue, Config, Token);
  const Client: Connection := Connect('127.0.0.1', Address.Port, 5000).Unwrap();
  AssertTrue(SetTimeout(Client, 30000).Unwrap());
  var Response: Exchange := Ask(Client, NewLineReader(Client), ClientMessage.Hello(ProtocolVersion, 9, 5), Token);
  AssertEquals(0, RequireCatalog(Response.Message).Total);
  AssertFalse(Std.Fs.Exists(Std.Path.Join([Root, 'missing'])));
  Response := Ask(Client, Response.Reader, ClientMessage.SelectWorld('missing'), Token);
  RequireRejected(Response.Message, 'world_missing');
  Response := Ask(Client, Response.Reader, ClientMessage.LoadGame, Token);
  RequireRejected(Response.Message, 'world_unavailable');
  Response := Ask(Client, Response.Reader, ClientMessage.CreateWorld(12345, 4), Token);
  AssertEquals(20, RequireMap(Response.Message).Health);
  const First: WorldSession := OpenExistingWorld(Root, 'world-1', 32).Unwrap();
  Response := Ask(Client, Response.Reader, ClientMessage.SelectWorld('world-1'), Token);
  RequireRejected(Response.Message, 'session_already_started');
  Response := Ask(Client, Response.Reader, ClientMessage.ListWorlds(0, false), Token);
  RequireRejected(Response.Message, 'discard_required');
  Response := Ask(Client, Response.Reader, ClientMessage.SaveGame, Token);
  RequireSaved(Response.Message);
  Response := Ask(Client, Response.Reader, ClientMessage.ListWorlds(0, false), Token);
  AssertEquals('world-1', RequireCatalog(Response.Message).SelectedId);
  // A distinct explicit save demonstrates Continue versus Start over.
  AssertTrue(WriteSaveGame(First, NewGame(First.Metadata) with Health := 7; end with).Unwrap());
  const OldSave: string := Std.Fs.ReadText(SaveGamePath(First)).Unwrap();
  Response := Ask(Client, Response.Reader, ClientMessage.LoadGame, Token);
  AssertEquals(7, RequireMap(Response.Message).Health);
  Response := Ask(Client, Response.Reader, ClientMessage.ListWorlds(0, false), Token);
  discard RequireCatalog(Response.Message);
  Response := Ask(Client, Response.Reader, ClientMessage.StartNewGame, Token);
  AssertEquals(20, RequireMap(Response.Message).Health);
  AssertEquals(OldSave, Std.Fs.ReadText(SaveGamePath(First)).Unwrap());
  Response := Ask(Client, Response.Reader, ClientMessage.SaveGame, Token);
  RequireRejected(Response.Message, 'overwrite_required');
  AssertEquals(OldSave, Std.Fs.ReadText(SaveGamePath(First)).Unwrap());
  Response := Ask(Client, Response.Reader, ClientMessage.OverwriteSaveGame, Token);
  RequireSaved(Response.Message);
  AssertTrue(OldSave <> Std.Fs.ReadText(SaveGamePath(First)).Unwrap());
  Response := Ask(Client, Response.Reader, ClientMessage.ListWorlds(0, false), Token);
  discard RequireCatalog(Response.Message);
  Response := Ask(Client, Response.Reader, ClientMessage.CreateWorld(12345, 4), Token);
  discard RequireMap(Response.Message);
  const Second: WorldSession := OpenExistingWorld(Root, 'world-2', 32).Unwrap();
  AssertEquals(First.Metadata.Seed, Second.Metadata.Seed);
  AssertTrue(First.Metadata.Id <> Second.Metadata.Id);
  Response := Ask(Client, Response.Reader, ClientMessage.ListWorlds(0, true), Token);
  AssertEquals(2, RequireCatalog(Response.Message).Total);
  Response := Ask(Client, Response.Reader, ClientMessage.SelectWorld('world-1'), Token);
  AssertEquals('world-1', RequireCatalog(Response.Message).SelectedId);
  // Storage failure must not discard the installed game, even with explicit discard permission.
  Response := Ask(Client, Response.Reader, ClientMessage.LoadGame, Token);
  discard RequireMap(Response.Message);
  const DefaultsBefore: string := Std.Fs.ReadText(Runtime.Paths.ServerConfig).Unwrap();
  AssertTrue(Std.Fs.WriteTextAtomic(Runtime.Paths.ServerConfig, '{').Unwrap());
  Response := Ask(Client, Response.Reader, ClientMessage.ListWorlds(0, true), Token);
  RequireRejected(Response.Message, 'storage_error');
  AssertTrue(Std.Fs.WriteTextAtomic(Runtime.Paths.ServerConfig, DefaultsBefore).Unwrap());
  // Rejected selection leaves the existing world installed; a viewport request proves it remains playable.
  Response := Ask(Client, Response.Reader, ClientMessage.SelectWorld('missing'), Token);
  RequireRejected(Response.Message, 'session_already_started');
  Response := Ask(Client, Response.Reader, ClientMessage.Viewport(9, 5), Token);
  AssertEquals(20, RequireMap(Response.Message).Health);
  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Disconnect), Token).Unwrap());
  AssertTrue(Close(Client).Unwrap());
  AssertTrue(Std.Tasks.Wait(Worker).Unwrap());
  // Reconnect: startup selection may be missing while saved worlds remain selectable.
  const AgainWorker: task := go ServeOnce(ListenerValue, Config, Token);
  const Again: Connection := Connect('127.0.0.1', Address.Port, 5000).Unwrap();
  AssertTrue(SetTimeout(Again, 30000).Unwrap());
  Response := Ask(Again, NewLineReader(Again), ClientMessage.Hello(ProtocolVersion, 9, 5), Token);
  AssertEquals(2, RequireCatalog(Response.Message).Total);
  Response := Ask(Again, Response.Reader, ClientMessage.SelectWorld('world-2'), Token);
  AssertEquals('missing', SelectedWorld(RequireCatalog(Response.Message)).Unwrap().SaveStatus);
  Response := Ask(Again, Response.Reader, ClientMessage.LoadGame, Token);
  AssertEquals(20, RequireMap(Response.Message).Health);
  Response := Ask(Again, Response.Reader, ClientMessage.ListWorlds(0, true), Token);
  discard RequireCatalog(Response.Message);
  AssertTrue(Std.Fs.WriteTextAtomic(SaveGamePath(First), '{').Unwrap());
  Response := Ask(Again, Response.Reader, ClientMessage.SelectWorld('world-1'), Token);
  AssertEquals('incompatible', SelectedWorld(RequireCatalog(Response.Message)).Unwrap().SaveStatus);
  Response := Ask(Again, Response.Reader, ClientMessage.LoadGame, Token);
  RequireRejected(Response.Message, 'save_incompatible');
  AssertEquals('{', Std.Fs.ReadText(SaveGamePath(First)).Unwrap());
  AssertTrue(WriteLine(Again, EncodeClient(ClientMessage.Disconnect), Token).Unwrap());
  AssertTrue(Close(Again).Unwrap());
  AssertTrue(Std.Tasks.Wait(AgainWorker).Unwrap());
  AssertTrue(CloseListener(ListenerValue).Unwrap());
end.
