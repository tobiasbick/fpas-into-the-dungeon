// Real TCP world creation/selection, explicit save/discard guards and reconnect persistence.
program WorldLifecycleTest;

uses Dungeon.GameState as GameState, Dungeon.Protocol as Protocol, Dungeon.Protocol.ClientMessages as ClientMessages, Dungeon.Protocol.ServerMessages as ServerMessages, Dungeon.Protocol.Transport as Transport, Dungeon.Protocol.Worlds as WorldsUnit, Dungeon.RuntimeData as RuntimeData, Dungeon.Server as Server, Dungeon.Server.Config as ConfigUnit, Dungeon.World as WorldUnit, Dungeon.World.Catalog as CatalogUnit, Dungeon.World.Savegame as Savegame, Std.Conv as Conv, Std.Fs as Fs, Std.Net as Net, Std.Path as PathOps, Std.Tasks as Tasks, Std.Test as Test, Std.Time as Time;

type Exchange = record
  Reader: Transport.LineReader;
  Message: Protocol.ServerMessage;
end record;

function Ask(
  Client: Net.Connection;
  Reader: Transport.LineReader;
  Request: Protocol.ClientMessage;
  Token: Tasks.CancellationToken
): Exchange;
begin
  Test.AssertTrue(
    Transport.WriteLine(Client, ClientMessages.EncodeClient(Request), Token).Unwrap()
  );
  const Response: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
  return Exchange(
    Reader := Response.Reader,
    Message := ServerMessages.DecodeServer(Response.Line).Unwrap()
  );
end function;

function RequireCatalog(Message: Protocol.ServerMessage): Protocol.WorldCatalog;
begin
  case Message of
    when Protocol.ServerMessage.Welcome(const Version, const Catalog):
      begin
        Test.AssertEquals(Protocol.ProtocolVersion, Version);
        return Catalog;
      end;
    when Protocol.ServerMessage.Worlds(const Catalog):
      begin
        return Catalog;
      end;
    when Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
      begin
        panic('expected catalog');
      end;
  end case;
end function;

function RequireMap(Message: Protocol.ServerMessage): Protocol.MapVisibleState;
begin
  case Message of
    when Protocol.ServerMessage.State(const Visible):
      case Visible of
        when Protocol.VisibleState.MapState(const Value):
          return Value;
        when Protocol.VisibleState.FirstPersonState(_):
          panic('expected map projection');
      end case;
    when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
      panic('expected map state');
  end case;
end function;

procedure RequireRejected(Message: Protocol.ServerMessage; Expected: string);
begin
  case Message of
    when Protocol.ServerMessage.Rejected(const Code, const Reason):
      Test.AssertEquals(Expected, Code);
    when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.ErrorMessage(_, _):
      panic('expected rejection ' + Expected);
  end case;
end procedure;

procedure RequireSaved(Message: Protocol.ServerMessage);
begin
  if Message is Protocol.ServerMessage.SaveCompleted then
    begin
      null;
    end;
  else
    begin
      panic('expected save completion');
    end;
  end if;
end procedure;

function ServeOnce(ListenerValue: Net.Listener; Config: ConfigUnit.ServerConfig; Token: Tasks.CancellationToken): result of (boolean, string);
begin
  const Client: Net.Connection := try Net.AcceptWithCancellation(ListenerValue, Token);
  const Outcome: result of (boolean, string) := Server.ServeConnection(Client, Config, Token);
  discard Net.Close(Client);
  return Outcome;
end function;

begin
  const Root: string := '.temp-data/lifecycle-' + Conv.IntToStr(Time.TimestampMillis());
  Test.AssertTrue(Fs.CreateDirAll(Root).Unwrap());
  const Runtime: RuntimeData.RuntimeSettings := RuntimeData.LoadServerRuntime(
    Some(Root + '-settings')
  ).Unwrap();
  const Config: ConfigUnit.ServerConfig := ConfigUnit.ServerConfig(
    ConfigPath := Runtime.Paths.ServerConfig,
    Logs := None,
    WorldsRoot := Root,
    WorldId := 'missing',
    WorldSeed := 12345,
    DungeonRegionChunks := 4,
    ChunkCacheLimit := 32,
    MaximumViewWidth := 80,
    MaximumViewHeight := 24
  );
  const Source: Tasks.CancellationSource := Tasks.CreateCancellationSource();
  const Token: Tasks.CancellationToken := Tasks.GetCancellationToken(Source);
  const ListenerValue: Net.Listener := Net.Listen('127.0.0.1', 0).Unwrap();
  const Address: Net.NetworkAddress := Net.ListenerLocalAddress(ListenerValue).Unwrap();
  scope
    const Worker: task of result of (boolean, string) := go ServeOnce(ListenerValue, Config, Token);
    const Client: Net.Connection := Net.Connect('127.0.0.1', Address.Port, 5000).Unwrap();
    Test.AssertTrue(Net.SetTimeout(Client, 30000).Unwrap());
    var Response: Exchange := Ask(
      Client,
      Transport.NewLineReader(Client),
      Protocol.ClientMessage.Hello(Protocol.ProtocolVersion, 9, 5),
      Token
    );
    Test.AssertEquals(0, RequireCatalog(Response.Message).Total);
    Test.AssertFalse(Fs.Exists(PathOps.Join([Root, 'missing'])));
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.SelectWorld('missing'), Token);
    RequireRejected(Response.Message, 'world_missing');
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.LoadGame, Token);
    RequireRejected(Response.Message, 'world_unavailable');
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.CreateWorld(12345, 4), Token);
    Test.AssertEquals(20, RequireMap(Response.Message).Health);
    const First: WorldUnit.WorldSession := CatalogUnit.OpenExistingWorld(
      Root,
      'world-1',
      32
    ).Unwrap();
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.SelectWorld('world-1'), Token);
    RequireRejected(Response.Message, 'session_already_started');
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.ListWorlds(0, false), Token);
    RequireRejected(Response.Message, 'discard_required');
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.SaveGame, Token);
    RequireSaved(Response.Message);
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.ListWorlds(0, false), Token);
    Test.AssertEquals('world-1', RequireCatalog(Response.Message).SelectedId);
    // A distinct explicit save demonstrates Continue versus Start over.
    Test.AssertTrue(
      Savegame.WriteSaveGame(
        First,
        GameState.NewGame(First.Metadata) with Health := 7; end with
      ).Unwrap()
    );
    const OldSave: string := Fs.ReadText(Savegame.SaveGamePath(First)).Unwrap();
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.LoadGame, Token);
    Test.AssertEquals(7, RequireMap(Response.Message).Health);
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.ListWorlds(0, false), Token);
    discard RequireCatalog(Response.Message);
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.StartNewGame, Token);
    Test.AssertEquals(20, RequireMap(Response.Message).Health);
    Test.AssertEquals(OldSave, Fs.ReadText(Savegame.SaveGamePath(First)).Unwrap());
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.SaveGame, Token);
    RequireRejected(Response.Message, 'overwrite_required');
    Test.AssertEquals(OldSave, Fs.ReadText(Savegame.SaveGamePath(First)).Unwrap());
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.OverwriteSaveGame, Token);
    RequireSaved(Response.Message);
    Test.AssertTrue(OldSave <> Fs.ReadText(Savegame.SaveGamePath(First)).Unwrap());
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.ListWorlds(0, false), Token);
    discard RequireCatalog(Response.Message);
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.CreateWorld(12345, 4), Token);
    discard RequireMap(Response.Message);
    const Second: WorldUnit.WorldSession := CatalogUnit.OpenExistingWorld(
      Root,
      'world-2',
      32
    ).Unwrap();
    Test.AssertEquals(First.Metadata.Seed, Second.Metadata.Seed);
    Test.AssertTrue(First.Metadata.Id <> Second.Metadata.Id);
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.ListWorlds(0, true), Token);
    Test.AssertEquals(2, RequireCatalog(Response.Message).Total);
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.SelectWorld('world-1'), Token);
    Test.AssertEquals('world-1', RequireCatalog(Response.Message).SelectedId);
    // Storage failure must not discard the installed game, even with explicit discard permission.
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.LoadGame, Token);
    discard RequireMap(Response.Message);
    const DefaultsBefore: string := Fs.ReadText(Runtime.Paths.ServerConfig).Unwrap();
    Test.AssertTrue(Fs.WriteTextAtomic(Runtime.Paths.ServerConfig, '{').Unwrap());
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.ListWorlds(0, true), Token);
    RequireRejected(Response.Message, 'storage_error');
    Test.AssertTrue(Fs.WriteTextAtomic(Runtime.Paths.ServerConfig, DefaultsBefore).Unwrap());
    // Rejected selection leaves the existing world installed; a viewport request proves it remains playable.
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.SelectWorld('missing'), Token);
    RequireRejected(Response.Message, 'session_already_started');
    Response := Ask(Client, Response.Reader, Protocol.ClientMessage.Viewport(9, 5), Token);
    Test.AssertEquals(20, RequireMap(Response.Message).Health);
    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Disconnect),
        Token
      ).Unwrap()
    );
    Test.AssertTrue(Net.Close(Client).Unwrap());
    Test.AssertTrue(Tasks.Wait(Worker).Unwrap());
    // Reconnect: startup selection may be missing while saved worlds remain selectable.
    const AgainWorker: task of result of (boolean, string) := go ServeOnce(
      ListenerValue,
      Config,
      Token
    );
    const Again: Net.Connection := Net.Connect('127.0.0.1', Address.Port, 5000).Unwrap();
    Test.AssertTrue(Net.SetTimeout(Again, 30000).Unwrap());
    Response := Ask(
      Again,
      Transport.NewLineReader(Again),
      Protocol.ClientMessage.Hello(Protocol.ProtocolVersion, 9, 5),
      Token
    );
    Test.AssertEquals(2, RequireCatalog(Response.Message).Total);
    Response := Ask(Again, Response.Reader, Protocol.ClientMessage.SelectWorld('world-2'), Token);
    Test.AssertEquals(
      'missing',
      WorldsUnit.SelectedWorld(RequireCatalog(Response.Message)).Unwrap().SaveStatus
    );
    Response := Ask(Again, Response.Reader, Protocol.ClientMessage.LoadGame, Token);
    Test.AssertEquals(20, RequireMap(Response.Message).Health);
    Response := Ask(Again, Response.Reader, Protocol.ClientMessage.ListWorlds(0, true), Token);
    discard RequireCatalog(Response.Message);
    Test.AssertTrue(Fs.WriteTextAtomic(Savegame.SaveGamePath(First), '{').Unwrap());
    Response := Ask(Again, Response.Reader, Protocol.ClientMessage.SelectWorld('world-1'), Token);
    Test.AssertEquals(
      'incompatible',
      WorldsUnit.SelectedWorld(RequireCatalog(Response.Message)).Unwrap().SaveStatus
    );
    Response := Ask(Again, Response.Reader, Protocol.ClientMessage.LoadGame, Token);
    RequireRejected(Response.Message, 'save_incompatible');
    Test.AssertEquals('{', Fs.ReadText(Savegame.SaveGamePath(First)).Unwrap());
    Test.AssertTrue(
      Transport.WriteLine(
        Again,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Disconnect),
        Token
      ).Unwrap()
    );
    Test.AssertTrue(Net.Close(Again).Unwrap());
    Test.AssertTrue(Tasks.Wait(AgainWorker).Unwrap());
    Test.AssertTrue(Net.CloseListener(ListenerValue).Unwrap());
  end scope;
end.
