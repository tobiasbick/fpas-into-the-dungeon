// Real headless listener: one-player admission, reuse after disconnect and cancellation shutdown.
program ServerAdmissionTest;

uses
  Dungeon.Protocol, Dungeon.Protocol.ClientMessages, Dungeon.Protocol.ServerMessages,
  Dungeon.Protocol.Transport, Dungeon.Server, Dungeon.Server.Config, Dungeon.Server.Logging,
  Std.Conv, Std.Fs, Std.Net, Std.Tasks, Std.Test, Std.Time;

procedure WaitLog(Logs: channel of ServerLogEvent; Kind: string);
begin
  var Found: boolean := false;
  while not Found do
    const Value: ServerLogEvent := ReceiveWithTimeout(Logs, 30000).Unwrap();
    if Value.Kind = 'error' then
      panic(Value.Text);
    end if;

    Found := Value.Kind = Kind;
  end while;
end procedure;

function RunReported(Config: ServerConfig; Port: integer; Token: CancellationToken): result of (boolean, string);
begin
  const Outcome: result of (boolean, string) := RunServerWithCancellation('127.0.0.1', Port, Config, Token);
  if Outcome is Error(const Reason) then
    begin
      LogServer(Config.Logs, 'error', Reason);
    end;
  else
    begin
      null;
    end;
  end if;

  return Outcome;
end function;

begin
  const Root: string := '.temp-data/admission-' + IntToStr(TimestampMillis());
  const Reservation: Listener := Listen('127.0.0.1', 0).Unwrap();
  const Address: NetworkAddress := ListenerLocalAddress(Reservation).Unwrap();
  AssertTrue(CloseListener(Reservation).Unwrap());
  const Logs: channel of ServerLogEvent := CreateChannel(256);
  const Config: ServerConfig := ServerConfig(ConfigPath := '', Logs := Some(Logs), WorldsRoot := Root, WorldId := 'absent', WorldSeed := 12345, DungeonRegionChunks := 4, ChunkCacheLimit := 32, MaximumViewWidth := 80, MaximumViewHeight := 24);
  const Stop: CancellationSource := CreateCancellationSource();
  const Token: CancellationToken := GetCancellationToken(Stop);
  const Worker: task := go RunReported(Config, Address.Port, Token);
  WaitLog(Logs, 'status');
  AssertTrue(Std.Fs.IsDir(Root));
  const Client: Connection := Connect('127.0.0.1', Address.Port, 5000).Unwrap();
  AssertTrue(SetTimeout(Client, 30000).Unwrap());
  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Hello(ProtocolVersion, 9, 5)), Token)
               .Unwrap());
  const Welcome: LineRead := ReadLine(NewLineReader(Client), Token).Unwrap();
  if DecodeServer(Welcome.Line).Unwrap() is ServerMessage.Welcome(const Version, const Catalog) then
    begin
      AssertEquals(0, Catalog.Total);
    end;
  else
    begin
      panic('expected first admitted client');
    end;
  end if;

  AssertFalse(Std.Fs.Exists(Root + '/absent'));
  // Busy rejection arrives promptly even while the first player has an idle connection.
  const Second: Connection := Connect('127.0.0.1', Address.Port, 5000).Unwrap();
  AssertTrue(SetTimeout(Second, 30000).Unwrap());
  const Busy: LineRead := ReadLine(NewLineReader(Second), Token).Unwrap();
  if DecodeServer(Busy.Line).Unwrap() is ServerMessage.Rejected(const Code, const Reason) then
    begin
      AssertEquals('server_busy', Code);
    end;
  else
    begin
      panic('expected busy rejection');
    end;
  end if;

  AssertTrue(Close(Second).Unwrap());
  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Disconnect), Token).Unwrap());
  WaitLog(Logs, 'disconnected');
  AssertTrue(Close(Client).Unwrap());
  const Third: Connection := Connect('127.0.0.1', Address.Port, 5000).Unwrap();
  AssertTrue(SetTimeout(Third, 30000).Unwrap());
  AssertTrue(WriteLine(Third, EncodeClient(ClientMessage.Hello(ProtocolVersion, 9, 5)), Token)
               .Unwrap());
  const Again: LineRead := ReadLine(NewLineReader(Third), Token).Unwrap();
  if DecodeServer(Again.Line).Unwrap() is ServerMessage.Welcome(const Version, const Catalog) then
    begin
      AssertEquals(0, Catalog.Total);
    end;
  else
    begin
      panic('expected admission after disconnect');
    end;
  end if;

  // Console shutdown uses the same external cancellation path, joining an idle connected session.
  discard Cancel(Stop);
  AssertTrue(Std.Tasks.Wait(Worker).Unwrap());
  AssertTrue(Close(Third).Unwrap());
  AssertTrue(Connect('127.0.0.1', Address.Port, 100).IsError());
  discard CloseChannel(Logs);
end.
