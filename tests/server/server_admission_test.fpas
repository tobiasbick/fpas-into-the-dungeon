// Real headless listener: one-player admission, reuse after disconnect and cancellation shutdown.
program ServerAdmissionTest;

uses Dungeon.Protocol as Protocol, Dungeon.Protocol.ClientMessages as ClientMessages, Dungeon.Protocol.ServerMessages as ServerMessages, Dungeon.Protocol.Transport as Transport, Dungeon.Server as Server, Dungeon.Server.Config as ConfigUnit, Dungeon.Server.Logging as Logging, Std.Conv as Conv, Std.Fs as Fs, Std.Net as Net, Std.Tasks as Tasks, Std.Test as Test, Std.Time as Time;

procedure WaitLog(Logs: channel of Logging.ServerLogEvent; Kind: string);
begin
  var Found: boolean := false;
  while not Found do
    const Value: Logging.ServerLogEvent := Tasks.ReceiveWithTimeout(Logs, 30000).Unwrap();
    if Value.Kind = 'error' then
      panic(Value.Text);
    end if;

    Found := Value.Kind = Kind;
  end while;
end procedure;

function RunReported(Config: ConfigUnit.ServerConfig; Port: integer; Token: Tasks.CancellationToken): result of (boolean, string);
begin
  const Outcome: result of (boolean, string) := Server.RunServerWithCancellation(
    '127.0.0.1',
    Port,
    Config,
    Token
  );
  case Outcome of
    when Error(const Reason):
      Logging.LogServer(Config.Logs, 'error', Reason);
    when Ok(_):
      null;
  end case;

  return Outcome;
end function;

begin
  const Root: string := '.temp-data/admission-' + Conv.IntToStr(Time.TimestampMillis());
  const Reservation: Net.Listener := Net.Listen('127.0.0.1', 0).Unwrap();
  const Address: Net.NetworkAddress := Net.ListenerLocalAddress(Reservation).Unwrap();
  Test.AssertTrue(Net.CloseListener(Reservation).Unwrap());
  const Logs: channel of Logging.ServerLogEvent := Tasks.CreateChannel(256);
  const Config: ConfigUnit.ServerConfig := ConfigUnit.ServerConfig(
    ConfigPath := '',
    Logs := Some(Logs),
    WorldsRoot := Root,
    WorldId := 'absent',
    WorldSeed := 12345,
    DungeonRegionChunks := 4,
    ChunkCacheLimit := 32,
    MaximumViewWidth := 80,
    MaximumViewHeight := 24
  );
  const Stop: Tasks.CancellationSource := Tasks.CreateCancellationSource();
  const Token: Tasks.CancellationToken := Tasks.GetCancellationToken(Stop);
  scope
    const Worker: task of result of (boolean, string) := go RunReported(
      Config,
      Address.Port,
      Token
    );
    WaitLog(Logs, 'status');
    Test.AssertTrue(Fs.IsDir(Root));
    const Client: Net.Connection := Net.Connect('127.0.0.1', Address.Port, 5000).Unwrap();
    Test.AssertTrue(Net.SetTimeout(Client, 30000).Unwrap());
    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Hello(Protocol.ProtocolVersion, 9, 5)),
        Token
      ).Unwrap()
    );
    const Welcome: Transport.LineRead := Transport.ReadLine(
      Transport.NewLineReader(Client),
      Token
    ).Unwrap();
    case ServerMessages.DecodeServer(Welcome.Line).Unwrap() of
      when Protocol.ServerMessage.Welcome(const Version, const Catalog):
        Test.AssertEquals(0, Catalog.Total);
      when Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected first admitted client');
    end case;

    Test.AssertFalse(Fs.Exists(Root + '/absent'));
    // Busy rejection arrives promptly even while the first player has an idle connection.
    const Second: Net.Connection := Net.Connect('127.0.0.1', Address.Port, 5000).Unwrap();
    Test.AssertTrue(Net.SetTimeout(Second, 30000).Unwrap());
    const Busy: Transport.LineRead := Transport.ReadLine(
      Transport.NewLineReader(Second),
      Token
    ).Unwrap();
    case ServerMessages.DecodeServer(Busy.Line).Unwrap() of
      when Protocol.ServerMessage.Rejected(const Code, const Reason):
        Test.AssertEquals('server_busy', Code);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected busy rejection');
    end case;

    Test.AssertTrue(Net.Close(Second).Unwrap());
    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Disconnect),
        Token
      ).Unwrap()
    );
    WaitLog(Logs, 'disconnected');
    Test.AssertTrue(Net.Close(Client).Unwrap());
    const Third: Net.Connection := Net.Connect('127.0.0.1', Address.Port, 5000).Unwrap();
    Test.AssertTrue(Net.SetTimeout(Third, 30000).Unwrap());
    Test.AssertTrue(
      Transport.WriteLine(
        Third,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Hello(Protocol.ProtocolVersion, 9, 5)),
        Token
      ).Unwrap()
    );
    const Again: Transport.LineRead := Transport.ReadLine(
      Transport.NewLineReader(Third),
      Token
    ).Unwrap();
    case ServerMessages.DecodeServer(Again.Line).Unwrap() of
      when Protocol.ServerMessage.Welcome(const Version, const Catalog):
        Test.AssertEquals(0, Catalog.Total);
      when Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected admission after disconnect');
    end case;

    // Console shutdown uses the same external cancellation path, joining an idle connected session.
    discard Tasks.Cancel(Stop);
    Test.AssertTrue(Tasks.Wait(Worker).Unwrap());
    Test.AssertTrue(Net.Close(Third).Unwrap());
    Test.AssertTrue((Net.Connect('127.0.0.1', Address.Port, 100) is Error(_)));
    discard Tasks.CloseChannel(Logs);
  end scope;
end.
