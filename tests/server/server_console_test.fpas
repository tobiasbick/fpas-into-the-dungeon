// Console log/status bounds and validated, non-destructive atomic creation-default updates.
program ServerConsoleTest;

uses Dungeon.RuntimeData as RuntimeData, Dungeon.Server.Console as Console, Dungeon.Server.Console.Model as ModelUnit, Dungeon.Server.Logging as Logging, Dungeon.World as WorldUnit, Std.Conv as Conv, Std.Fs as Fs, Std.Tasks as Tasks, Std.Test as Test, Std.Time as Time, Std.Tui as Tui;

function StaticUpdate(State: ModelUnit.ConsoleModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ModelUnit.ConsoleModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  return State;
end function;

function ContainsScreen(Snapshot: Tui.TuiSurfaceSnapshot; Text: string): boolean;
begin
  for Row: integer := 0 to Snapshot.Height - 1 do
    if Text in Snapshot.LineAt(Row) then
      return true;
    end if;
  end for;

  return false;
end function;

begin
  const Root: string := '.temp-data/console-' + Conv.IntToStr(Time.TimestampMillis());
  const Runtime: RuntimeData.RuntimeSettings := RuntimeData.LoadServerRuntime(Some(Root)).Unwrap();
  const World: WorldUnit.WorldSession := WorldUnit.OpenWorld(
    Runtime.Paths.Worlds,
    'kept',
    24680,
    4,
    16
  ).Unwrap();
  const MetadataBefore: string := Fs.ReadText(WorldUnit.WorldMetadataPath(World)).Unwrap();
  const Before: string := Fs.ReadText(Runtime.Paths.ServerConfig).Unwrap();
  var Model: ModelUnit.ConsoleModel := ModelUnit.NewConsoleModel(
    Runtime.Paths.ServerConfig,
    Runtime.World
  );
  Test.AssertFalse(Model.Connected);
  Model := ModelUnit.ApplyConsoleLog(
    Model,
    Logging.ServerLogEvent(Kind := 'connected', Text := 'Player connected')
  );
  Test.AssertTrue(Model.Connected);
  Model := ModelUnit.ApplyConsoleLog(
    Model,
    Logging.ServerLogEvent(Kind := 'world', Text := 'Playing world kept')
  );
  Test.AssertEquals('Playing world kept', Model.Status);
  for Index: integer := 0 to 150 do
    Model := ModelUnit.ApplyConsoleLog(
      Model,
      Logging.ServerLogEvent(Kind := 'rejected', Text := Conv.IntToStr(Index))
    );
  end for;

  Test.AssertEquals(ModelUnit.MaximumConsoleLines, Model.Lines.Length());
  Test.AssertEquals('rejected: 150', Model.Lines[ModelUnit.MaximumConsoleLines - 1]);
  Model := ModelUnit.ApplyConsoleLog(
    Model,
    Logging.ServerLogEvent(Kind := 'disconnected', Text := 'Player disconnected')
  );
  Test.AssertFalse(Model.Connected);
  const Queue: channel of Logging.ServerLogEvent := Tasks.CreateChannel(2);
  for Index: integer := 0 to 3 do
    Logging.LogServer(Some(Queue), 'world', Conv.IntToStr(Index));
  end for;

  Test.AssertEquals('2', Tasks.ReceiveWithTimeout(Queue, 0).Unwrap().Text);
  Test.AssertEquals('3', Tasks.ReceiveWithTimeout(Queue, 0).Unwrap().Text);
  discard Tasks.CloseChannel(Queue);
  // Invalid text, overflow and range errors preserve both published defaults and exact file bytes.
  for Text: string in ['', 'abc', '9223372036854775808', '2147483648', '-2147483649'] do
    Model := ModelUnit.StoreConsoleSettings(
      Model with SettingsOpen := true; SeedText := Text; end with
    );
    Test.AssertTrue(Model.SettingsOpen);
    Test.AssertEquals(Runtime.World.Seed, Model.Seed);
    Test.AssertTrue(Model.SettingsError <> '');
    Test.AssertEquals(Before, Fs.ReadText(Runtime.Paths.ServerConfig).Unwrap());
  end for;

  for Text: string in ['0', '17', 'abc'] do
    Model := ModelUnit.StoreConsoleSettings(
      Model with SeedText := '0'; RegionText := Text; end with
    );
    Test.AssertTrue(Model.SettingsOpen);
    Test.AssertEquals(Before, Fs.ReadText(Runtime.Paths.ServerConfig).Unwrap());
  end for;

  Model := ModelUnit.StoreConsoleSettings(
    Model with SeedText := '-2147483648'; RegionText := '16'; end with
  );
  Test.AssertFalse(Model.SettingsOpen);
  Test.AssertEquals(-2147483648, Model.Seed);
  Test.AssertEquals(16, Model.RegionChunks);
  const Settings: RuntimeData.ServerWorldConfig := RuntimeData.ReadServerDefaults(
    Runtime.Paths.ServerConfig
  ).Unwrap();
  Test.AssertEquals(Model.Seed, Settings.Seed);
  Test.AssertEquals(Model.RegionChunks, Settings.DungeonRegionChunks);
  Test.AssertEquals(Runtime.World.Id, Settings.Id);
  Test.AssertEquals(Runtime.World.ChunkCacheLimit, Settings.ChunkCacheLimit);
  Test.AssertEquals(Runtime.World.MaximumViewWidth, Settings.MaximumViewWidth);
  Test.AssertEquals(Runtime.World.MaximumViewHeight, Settings.MaximumViewHeight);
  Test.AssertEquals(MetadataBefore, Fs.ReadText(WorldUnit.WorldMetadataPath(World)).Unwrap());
  const App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(100, 26));
  Model := App.RunIterations(Model, StaticUpdate, Console.ViewServerConsole, 0, 0);
  Test.AssertTrue(ContainsScreen(App.SurfaceSnapshot(), 'Dungeon server'));
  Model.SettingsOpen := true;
  Model := App.RunIterations(Model, StaticUpdate, Console.ViewServerConsole, 0, 0);
  Test.AssertTrue(ContainsScreen(App.SurfaceSnapshot(), 'Defaults for new worlds'));
  Test.AssertTrue(ContainsScreen(App.SurfaceSnapshot(), '1 through 16'));
  App.Close();
  Model := ModelUnit.StoreConsoleSettings(
    Model with ConfigPath := Runtime.Paths.Config; SeedText := '17'; RegionText := '4'; end with
  );
  Test.AssertTrue(Model.SettingsOpen);
  Test.AssertEquals(-2147483648, Model.Seed);
  Test.AssertEquals(16, Model.RegionChunks);
  Test.AssertTrue(Model.SettingsError <> '');
  Test.AssertEquals(
    -2147483648,
    RuntimeData.ReadServerDefaults(Runtime.Paths.ServerConfig).Unwrap().Seed
  );
end.
