// Verifies that an atomic save failure preserves active state and leaves the connection usable.
program DungeonServerSaveFailureTest;

uses
  Dungeon.Test.Catalog, Dungeon.Protocol, Dungeon.Protocol.ClientMessages,
  Dungeon.Protocol.ServerMessages, Dungeon.Protocol.Transport, Dungeon.Server, Dungeon.Server.Config,
  Dungeon.World, Std.Conv, Std.Fs, Std.Net, Std.Path, Std.Tasks, Std.Test, Std.Time;

function TestConfig(WorldsRoot: string): ServerConfig;
begin
  return ServerConfig(ConfigPath := '', Logs := None, WorldsRoot := WorldsRoot, WorldId := 'save-failure', WorldSeed := 45678, DungeonRegionChunks := 4, ChunkCacheLimit := 32, MaximumViewWidth := 80, MaximumViewHeight := 24);
end function;

function EnsureDirectory(Path: string): boolean;
begin
  if Std.Fs.IsDir(Path) then
    begin
      return true;
    end;
  end if;

  if Std.Fs.CreateDir(Path) is Ok(const Created) then
    begin
      return true;
    end;
  else
    begin
      return Std.Fs.IsDir(Path);
    end;
  end if;
end function;

function ServeOne(ListenerValue: Listener; Config: ServerConfig; Token: CancellationToken): result of (boolean, string);
begin
  const Client: Connection := try AcceptWithCancellation(ListenerValue, Token);
  const Configured: boolean := try SetTimeout(Client, 2000);
  const Outcome: result of (boolean, string) := ServeConnection(Client, Config, Token);
  const Closed: boolean := try Close(Client);
  return Outcome;
end function;

function RequireMap(Value: VisibleState): MapVisibleState;
begin
  if Value is VisibleState.MapState(const MapValue) then
    begin
      return MapValue;
    end;
  else
    begin
      panic('expected map visible state');
    end;
  end if;
end function;

begin
  AssertTrue(EnsureDirectory('.temp-data'));
  const WorldsRoot: string := '.temp-data/server-save-failure-' + IntToStr(TimestampMillis());
  AssertTrue(EnsureDirectory(WorldsRoot));
  const Config: ServerConfig := TestConfig(WorldsRoot);
  const World: WorldSession := OpenWorld(WorldsRoot, Config.WorldId, Config.WorldSeed, 4, Config.ChunkCacheLimit)
                                 .Unwrap();
  const BlockingPath: string := Std.Path.Join([World.Directory, 'saves']);
  AssertTrue(Std.Fs.WriteTextAtomic(BlockingPath, 'not a directory').Unwrap());
  const ListenerValue: Listener := Listen('127.0.0.1', 0).Unwrap();
  const Address: NetworkAddress := ListenerLocalAddress(ListenerValue).Unwrap();
  const Source: CancellationSource := CreateCancellationSource();
  const Token: CancellationToken := GetCancellationToken(Source);
  const ServerTask: task := go ServeOne(ListenerValue, Config, Token);
  const Client: Connection := Connect('127.0.0.1', Address.Port, 5000).Unwrap();
  AssertTrue(SetTimeout(Client, 120000).Unwrap());
  var Reader: LineReader := NewLineReader(Client);
  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Hello(ProtocolVersion, 13, 7)), Token)
               .Unwrap());
  const WelcomeRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := WelcomeRead.Reader;
  if DecodeServer(WelcomeRead.Line).Unwrap() is ServerMessage.Welcome(const Version, const Catalog) then
    begin
      AssertEquals(ProtocolVersion, Version);
      AssertFalse(FixtureSaveAvailable(Catalog));
      AssertFalse(FixtureInvalidSave(Catalog));
    end;
  else
    begin
      panic('expected welcome before save-failure test');
    end;
  end if;

  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.StartNewGame), Token).Unwrap());
  const InitialRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := InitialRead.Reader;
  var InitialMap: MapVisibleState := MapVisibleState(OriginX := 0, OriginY := 0, Width := 0, Height := 0, Rows := [], KnowledgeRows := [], PlayerX := 0, PlayerY := 0, WorldX := 0, WorldY := 0, Inventory := [], Health := 20, MaxHealth := 20, Character := []);
  if DecodeServer(InitialRead.Line).Unwrap() is ServerMessage.State(const Value) then
    begin
      InitialMap := RequireMap(Value);
    end;
  else
    begin
      panic('expected initial game state');
    end;
  end if;

  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.SaveGame), Token).Unwrap());
  const SaveRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := SaveRead.Reader;
  if DecodeServer(SaveRead.Line).Unwrap() is ServerMessage.Rejected(const Code, const Message) then
    begin
      // A filesystem failure while saving is a storage error; the session stays usable.
      AssertEquals('storage_error', Code);
    end;
  else
    begin
      panic('expected recoverable save failure');
    end;
  end if;

  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Viewport(15, 9)), Token).Unwrap());
  const AfterFailureRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := AfterFailureRead.Reader;
  if DecodeServer(AfterFailureRead.Line).Unwrap() is ServerMessage.State(const Value) then
    begin
      const MapValue: MapVisibleState := RequireMap(Value);
      AssertEquals(InitialMap.WorldX, MapValue.WorldX);
      AssertEquals(InitialMap.WorldY, MapValue.WorldY);
      AssertEquals(15, MapValue.Width);
      AssertEquals(9, MapValue.Height);
    end;
  else
    begin
      panic('expected usable connection and unchanged state after save failure');
    end;
  end if;

  AssertEquals('not a directory', Std.Fs.ReadText(BlockingPath).Unwrap());
  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Disconnect), Token).Unwrap());
  AssertTrue(Close(Client).Unwrap());
  AssertTrue(Std.Tasks.Wait(ServerTask).Unwrap());
  AssertTrue(CloseListener(ListenerValue).Unwrap());
end.
