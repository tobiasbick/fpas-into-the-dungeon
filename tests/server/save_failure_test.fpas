// Verifies that an atomic save failure preserves active state and leaves the connection usable.
program DungeonServerSaveFailureTest;

uses Dungeon.Test.Catalog as CatalogUnit, Dungeon.Protocol as Protocol, Dungeon.Protocol.ClientMessages as ClientMessages, Dungeon.Protocol.ServerMessages as ServerMessages, Dungeon.Protocol.Transport as Transport, Dungeon.Server as Server, Dungeon.Server.Config as ConfigUnit, Dungeon.World as WorldUnit, Std.Conv as Conv, Std.Fs as Fs, Std.Net as Net, Std.Path as PathOps, Std.Tasks as Tasks, Std.Test as Test, Std.Time as Time;

// Renders network failures for the server's text-based session callback.
function FailureMessage(Cause: Net.NetError): string;
begin
  return Cause.Message();
end function;

function TestConfig(WorldsRoot: string): ConfigUnit.ServerConfig;
begin
  return ConfigUnit.ServerConfig(
    ConfigPath := '',
    Logs := None,
    WorldsRoot := WorldsRoot,
    WorldId := 'save-failure',
    WorldSeed := 45678,
    DungeonRegionChunks := 4,
    ChunkCacheLimit := 32,
    MaximumViewWidth := 80,
    MaximumViewHeight := 24
  );
end function;

function EnsureDirectory(Path: string): boolean;
begin
  if Fs.IsDir(Path) then
    begin
      return true;
    end;
  end if;

  case Fs.CreateDir(Path) of
    when Ok(const Created):
      return true;
    when Error(_):
      return Fs.IsDir(Path);
  end case;
end function;

function ServeOne(ListenerValue: Net.Listener; Config: ConfigUnit.ServerConfig; Token: Tasks.CancellationToken): result of (boolean, string);
begin
  const Client: Net.Connection := try Net.AcceptWithCancellation(
    ListenerValue,
    Token
  ).MapError(FailureMessage);
  const Configured: boolean := try Net.SetTimeout(Client, 2000).MapError(FailureMessage);
  const Outcome: result of (boolean, string) := Server.ServeConnection(Client, Config, Token);
  const Closed: boolean := try Net.Close(Client).MapError(FailureMessage);
  return Outcome;
end function;

function RequireMap(Value: Protocol.VisibleState): Protocol.MapVisibleState;
begin
  case Value of
    when Protocol.VisibleState.MapState(const MapValue):
      return MapValue;
    when Protocol.VisibleState.FirstPersonState(_):
      panic('expected map visible state');
  end case;
end function;

begin
  Test.AssertTrue(EnsureDirectory('.temp-data'));
  const WorldsRoot: string := '.temp-data/server-save-failure-' +
    Conv.IntToStr(Time.TimestampMillis());
  Test.AssertTrue(EnsureDirectory(WorldsRoot));
  const Config: ConfigUnit.ServerConfig := TestConfig(WorldsRoot);
  const World: WorldUnit.WorldSession := WorldUnit.OpenWorld(
    WorldsRoot,
    Config.WorldId,
    Config.WorldSeed,
    4,
    Config.ChunkCacheLimit
  ).Unwrap();
  const BlockingPath: string := PathOps.Join([World.Directory, 'saves']);
  Test.AssertTrue(Fs.WriteTextAtomic(BlockingPath, 'not a directory').Unwrap());
  const ListenerValue: Net.Listener := Net.Listen('127.0.0.1', 0).Unwrap();
  const Address: Net.NetworkAddress := Net.ListenerLocalAddress(ListenerValue).Unwrap();
  const Source: Tasks.CancellationSource := Tasks.CreateCancellationSource();
  const Token: Tasks.CancellationToken := Tasks.GetCancellationToken(Source);
  scope
    const ServerTask: task of result of (boolean, string) := go ServeOne(
      ListenerValue,
      Config,
      Token
    );
    const Client: Net.Connection := Net.Connect('127.0.0.1', Address.Port, 5000).Unwrap();
    Test.AssertTrue(Net.SetTimeout(Client, 120000).Unwrap());
    var Reader: Transport.LineReader := Transport.NewLineReader(Client);
    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Hello(Protocol.ProtocolVersion, 13, 7)),
        Token
      ).Unwrap()
    );
    const WelcomeRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
    Reader := WelcomeRead.Reader;
    case ServerMessages.DecodeServer(WelcomeRead.Line).Unwrap() of
      when Protocol.ServerMessage.Welcome(const Version, const Catalog):
        Test.AssertEquals(Protocol.ProtocolVersion, Version);
        Test.AssertFalse(CatalogUnit.FixtureSaveAvailable(Catalog));
        Test.AssertFalse(CatalogUnit.FixtureInvalidSave(Catalog));
      when Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected welcome before save-failure test');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.StartNewGame),
        Token
      ).Unwrap()
    );
    const InitialRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
    Reader := InitialRead.Reader;
    var InitialMap: Protocol.MapVisibleState := Protocol.MapVisibleState(
      OriginX := 0,
      OriginY := 0,
      Width := 0,
      Height := 0,
      Rows := [],
      KnowledgeRows := [],
      PlayerX := 0,
      PlayerY := 0,
      WorldX := 0,
      WorldY := 0,
      Inventory := [],
      Health := 20,
      MaxHealth := 20,
      Character := [], Journal := []
    );
    case ServerMessages.DecodeServer(InitialRead.Line).Unwrap() of
      when Protocol.ServerMessage.State(const Value):
        InitialMap := RequireMap(Value);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected initial game state');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.SaveGame),
        Token
      ).Unwrap()
    );
    const SaveRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
    Reader := SaveRead.Reader;
    case ServerMessages.DecodeServer(SaveRead.Line).Unwrap() of
      when Protocol.ServerMessage.Rejected(const Code, const Message):
        // A filesystem failure while saving is a storage error; the session stays usable.
        Test.AssertEquals('storage_error', Code);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected recoverable save failure');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Viewport(15, 9)),
        Token
      ).Unwrap()
    );
    const AfterFailureRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
    Reader := AfterFailureRead.Reader;
    case ServerMessages.DecodeServer(AfterFailureRead.Line).Unwrap() of
      when Protocol.ServerMessage.State(const Value):
        const MapValue: Protocol.MapVisibleState := RequireMap(Value);
        Test.AssertEquals(InitialMap.WorldX, MapValue.WorldX);
        Test.AssertEquals(InitialMap.WorldY, MapValue.WorldY);
        Test.AssertEquals(15, MapValue.Width);
        Test.AssertEquals(9, MapValue.Height);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected usable connection and unchanged state after save failure');
    end case;

    Test.AssertEquals('not a directory', Fs.ReadText(BlockingPath).Unwrap());
    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Disconnect),
        Token
      ).Unwrap()
    );
    Test.AssertTrue(Net.Close(Client).Unwrap());
    Test.AssertTrue(Tasks.Wait(ServerTask).Unwrap());
  end scope;

  Test.AssertTrue(Net.CloseListener(ListenerValue).Unwrap());
end.
