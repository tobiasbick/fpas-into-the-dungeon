// Verifies handshake, state transfer, movement, and disconnect over loopback TCP.
program DungeonServerLoopbackTest;

uses
  Dungeon.Game, Dungeon.Protocol, Dungeon.Protocol.Transport, Dungeon.Server, Std.Conv, Std.Fs,
  Std.Net, Std.Path, Std.Results, Std.Task, Std.Test;

function TestConfig(): ServerConfig;
begin
  return record
    WorldsRoot := '.temp-data/server-loopback-generator-v' + IntToStr(WorldGeneratorVersion);
    WorldId := 'loopback';
    WorldSeed := 12345;
    ChunkCacheLimit := 32;
    MaximumViewWidth := 240;
    MaximumViewHeight := 20;
  end
end;

function RequireMap(Value: VisibleState): MapVisibleState;
begin
  case Value of
    VisibleState.MapState(MapValue):
    begin
      return MapValue
    end
    else
    begin
      panic('expected map visible state')
    end
  end
end;

function RequireFirstPerson(Value: VisibleState): FirstPersonVisibleState;
begin
  case Value of
    VisibleState.FirstPersonState(FirstPersonValue):
    begin
      return FirstPersonValue
    end
    else
    begin
      panic('expected first-person visible state')
    end
  end
end;

function EnsureDirectory(Path: string): boolean;
begin
  if Std.Fs.IsDir(Path) then
  begin
    return true
  end;

  case Std.Fs.CreateDir(Path) of
    Ok(Created):
    begin
      return true
    end
    else
    begin
      return Std.Fs.IsDir(Path)
    end
  end
end;

procedure EnsureWorldRoot();
begin
  AssertTrue(EnsureDirectory('.temp-data'));
  AssertTrue(EnsureDirectory(TestConfig().WorldsRoot))
end;

function ServeOne(ListenerValue: Listener; Token: CancellationToken): result of boolean, string;
begin
  var Client: Connection := try AcceptWithCancellation(ListenerValue, Token);
  var Configured: boolean := try SetTimeout(Client, 2000);
  var Outcome: result of boolean, string := ServeConnection(Client, TestConfig(), Token);
  var Closed: boolean := try Close(Client);
  return Outcome
end;

begin
  EnsureWorldRoot();
  var Metadata: WorldMetadata := Unwrap(NewWorldMetadata(TestConfig().WorldId, TestConfig()
                                                                                 .WorldSeed));
  var ListenerValue: Listener := Unwrap(Listen('127.0.0.1', 0));
  var Address: NetworkAddress := Unwrap(ListenerLocalAddress(ListenerValue));
  var Source: CancellationSource := CreateCancellationSource();
  var Token: CancellationToken := GetCancellationToken(Source);
  var ServerTask: task := go ServeOne(ListenerValue, Token);
  var Client: Connection := Unwrap(Connect('127.0.0.1', Address.Port, 5000));
  AssertTrue(Unwrap(SetTimeout(Client, 30000)));
  mutable var Reader: LineReader := NewLineReader(Client);
  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Hello(ProtocolVersion, 13, 7)), Token)));
  var WelcomeRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := WelcomeRead.Reader;
  case DecodeServer(WelcomeRead.Line) of
    Ok(WelcomeMessage):
    begin
      case WelcomeMessage of
        ServerMessage.Welcome(Version):
        begin
          AssertEquals(ProtocolVersion, Version)
        end
        else
        begin
          AssertTrue(false)
        end
      end
    end
    else
    begin
      panic('unexpected welcome: ' + WelcomeRead.Line)
    end
  end;
  var InitialRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := InitialRead.Reader;
  case DecodeServer(InitialRead.Line) of
    Ok(InitialMessage):
    begin
      case InitialMessage of
        ServerMessage.State(Value):
        begin
          var MapValue: MapVisibleState := RequireMap(Value);
          AssertEquals(13, MapValue.Width);
          AssertEquals(7, MapValue.Height);
          AssertEquals(Metadata.Spawn.X - 6, MapValue.OriginX);
          AssertEquals(Metadata.Spawn.Y - 3, MapValue.OriginY);
          AssertEquals(6, MapValue.PlayerX);
          AssertEquals(3, MapValue.PlayerY);
          AssertEquals(Metadata.Spawn.X, MapValue.WorldX);
          AssertEquals(Metadata.Spawn.Y, MapValue.WorldY)
        end
        else
        begin
          AssertTrue(false)
        end
      end
    end
    else
    begin
      panic('unexpected initial state: ' + InitialRead.Line)
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.ActivateAreaTransition), Token)));
  var EarlyActivationRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := EarlyActivationRead.Reader;
  case Unwrap(DecodeServer(EarlyActivationRead.Line)) of
    ServerMessage.Rejected(Code, Message):
    begin
      AssertEquals('transition_rejected', Code);
      AssertEquals('player is not standing on an entrance', Message)
    end
    else
    begin
      panic('expected activation rejection away from entrance')
    end
  end;
  mutable var CurrentX: integer := Metadata.Spawn.X;
  mutable var CurrentY: integer := Metadata.Spawn.Y;
  for Step: integer := 1 to 3 do
  begin
    mutable var DeltaX: integer := 0;
    mutable var DeltaY: integer := 0;
    if CurrentX < Metadata.Entrance.X then
    begin
      DeltaX := 1
    end
    else if CurrentX > Metadata.Entrance.X then
    begin
      DeltaX := -1
    end
    else if CurrentY < Metadata.Entrance.Y then
    begin
      DeltaY := 1
    end
    else
    begin
      DeltaY := -1
    end;

    AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Move(DeltaX, DeltaY)), Token)));
    var MovedRead: LineRead := Unwrap(ReadLine(Reader, Token));
    Reader := MovedRead.Reader;
    case Unwrap(DecodeServer(MovedRead.Line)) of
      ServerMessage.State(Value):
      begin
        CurrentX := CurrentX + DeltaX;
        CurrentY := CurrentY + DeltaY;
        var MapValue: MapVisibleState := RequireMap(Value);
        AssertEquals(CurrentX, MapValue.WorldX);
        AssertEquals(CurrentY, MapValue.WorldY)
      end
      else
      begin
        panic('expected map state after entrance movement')
      end
    end
  end;

  AssertEquals(Metadata.Entrance.X, CurrentX);
  AssertEquals(Metadata.Entrance.Y, CurrentY);
  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.ActivateAreaTransition), Token)));
  var EnteredRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := EnteredRead.Reader;
  case Unwrap(DecodeServer(EnteredRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals(Metadata.DungeonAreaLabel, FirstPersonValue.Title);
      AssertEquals('Find the gold exit field.', FirstPersonValue.Status);
      AssertEquals(11, FirstPersonValue.Width);
      AssertEquals(9, FirstPersonValue.Height);
      AssertEquals(9, FirstPersonValue.PlayerX);
      AssertEquals(1, FirstPersonValue.PlayerY);
      AssertTrue(FirstPersonValue.Facing = FirstPersonFacing.West);
      AssertEquals('###########', FirstPersonValue.Rows[0]);
      AssertEquals('#x........#', FirstPersonValue.Rows[7])
    end
    else
    begin
      panic('expected first-person state after entry')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Move(1, 0)), Token)));
  var DungeonMoveRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := DungeonMoveRead.Reader;
  case Unwrap(DecodeServer(DungeonMoveRead.Line)) of
    ServerMessage.Rejected(Code, Message):
    begin
      AssertEquals('movement_rejected', Code);
      AssertEquals('movement is unavailable in the current area', Message)
    end
    else
    begin
      panic('expected dungeon movement rejection')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Viewport(1000, 1000)), Token)));
  var DungeonViewportRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := DungeonViewportRead.Reader;
  case Unwrap(DecodeServer(DungeonViewportRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals(Metadata.DungeonAreaLabel, FirstPersonValue.Title);
      AssertEquals(11, FirstPersonValue.Width);
      AssertEquals(9, FirstPersonValue.Height);
      AssertEquals(9, FirstPersonValue.PlayerX);
      AssertEquals(1, FirstPersonValue.PlayerY)
    end
    else
    begin
      panic('viewport must retain the first-person geometry')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Left)), Token)));
  var StrafeLeftRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := StrafeLeftRead.Reader;
  case Unwrap(DecodeServer(StrafeLeftRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals(9, FirstPersonValue.PlayerX);
      AssertEquals(2, FirstPersonValue.PlayerY)
    end
    else
    begin
      panic('expected first-person state after left step')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Right)), Token)));
  var StrafeRightRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := StrafeRightRead.Reader;
  case Unwrap(DecodeServer(StrafeRightRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals(9, FirstPersonValue.PlayerX);
      AssertEquals(1, FirstPersonValue.PlayerY)
    end
    else
    begin
      panic('expected first-person state after right step')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Right)), Token)));
  var TurnNorthRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := TurnNorthRead.Reader;
  case Unwrap(DecodeServer(TurnNorthRead.Line)) of
    ServerMessage.State(Value):
    begin
      AssertTrue(RequireFirstPerson(Value).Facing = FirstPersonFacing.North)
    end
    else
    begin
      panic('expected first-person state after right turn')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward)), Token)));
  var WallRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := WallRead.Reader;
  case Unwrap(DecodeServer(WallRead.Line)) of
    ServerMessage.Rejected(Code, Message):
    begin
      AssertEquals('movement_rejected', Code);
      AssertEquals('a wall blocks the way', Message)
    end
    else
    begin
      panic('expected wall collision rejection')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Left)), Token)));
  var TurnWestRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := TurnWestRead.Reader;
  case Unwrap(DecodeServer(TurnWestRead.Line)) of
    ServerMessage.State(Value):
    begin
      AssertTrue(RequireFirstPerson(Value).Facing = FirstPersonFacing.West)
    end
    else
    begin
      panic('expected valid action after rejected wall step')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Left)), Token)));
  var TurnSouthRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := TurnSouthRead.Reader;
  case Unwrap(DecodeServer(TurnSouthRead.Line)) of
    ServerMessage.State(Value):
    begin
      AssertTrue(RequireFirstPerson(Value).Facing = FirstPersonFacing.South)
    end
    else
    begin
      panic('expected south-facing state')
    end
  end;

  for InteriorStep: integer := 1 to 6 do
  begin
    AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward)), Token)));
    var StepRead: LineRead := Unwrap(ReadLine(Reader, Token));
    Reader := StepRead.Reader;
    case Unwrap(DecodeServer(StepRead.Line)) of
      ServerMessage.State(Value):
      begin
        var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
        AssertEquals(9, FirstPersonValue.PlayerX);
        AssertEquals(1 + InteriorStep, FirstPersonValue.PlayerY)
      end
      else
      begin
        panic('expected first-person state while walking south')
      end
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Right)), Token)));
  var ExitTurnRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := ExitTurnRead.Reader;
  case Unwrap(DecodeServer(ExitTurnRead.Line)) of
    ServerMessage.State(Value):
    begin
      AssertTrue(RequireFirstPerson(Value).Facing = FirstPersonFacing.West)
    end
    else
    begin
      panic('expected west-facing state before exit corridor')
    end
  end;

  for InteriorStep: integer := 1 to 8 do
  begin
    AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward)), Token)));
    var StepRead: LineRead := Unwrap(ReadLine(Reader, Token));
    Reader := StepRead.Reader;
    case Unwrap(DecodeServer(StepRead.Line)) of
      ServerMessage.State(Value):
      begin
        var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
        AssertEquals(9 - InteriorStep, FirstPersonValue.PlayerX);
        AssertEquals(7, FirstPersonValue.PlayerY)
      end
      else
      begin
        panic('expected first-person state while walking to exit')
      end
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Backward)), Token)));
  var BackwardRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := BackwardRead.Reader;
  case Unwrap(DecodeServer(BackwardRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals(2, FirstPersonValue.PlayerX);
      AssertEquals(7, FirstPersonValue.PlayerY);
      AssertEquals('Find the gold exit field.', FirstPersonValue.Status)
    end
    else
    begin
      panic('expected one-field backward movement')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward)), Token)));
  var ReturnToExitRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := ReturnToExitRead.Reader;
  case Unwrap(DecodeServer(ReturnToExitRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals(1, FirstPersonValue.PlayerX);
      AssertEquals(7, FirstPersonValue.PlayerY);
      AssertEquals('Press Enter to return to the outdoor region.', FirstPersonValue.Status)
    end
    else
    begin
      panic('expected exit-field state')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.ActivateAreaTransition), Token)));
  var LeftRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := LeftRead.Reader;
  case Unwrap(DecodeServer(LeftRead.Line)) of
    ServerMessage.State(Value):
    begin
      var MapValue: MapVisibleState := RequireMap(Value);
      AssertEquals(Metadata.Entrance.X, MapValue.WorldX);
      AssertEquals(Metadata.Entrance.Y, MapValue.WorldY)
    end
    else
    begin
      panic('expected restored map after leaving dungeon')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Viewport(1000, 1000)), Token)));
  var ResizedRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := ResizedRead.Reader;
  case Unwrap(DecodeServer(ResizedRead.Line)) of
    ServerMessage.State(Value):
    begin
      var MapValue: MapVisibleState := RequireMap(Value);
      AssertEquals(240, MapValue.Width);
      AssertEquals(20, MapValue.Height);
      AssertEquals(Metadata.Entrance.X, MapValue.WorldX)
    end
    else
    begin
      panic('expected clamped viewport state')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Move(1, 1)), Token)));
  var RejectedRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := RejectedRead.Reader;
  case Unwrap(DecodeServer(RejectedRead.Line)) of
    ServerMessage.Rejected(Code, Message):
    begin
      AssertEquals('movement_rejected', Code);
      AssertEquals('movement must be one cardinal step', Message)
    end
    else
    begin
      panic('expected rejected movement')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Disconnect), Token)));
  AssertTrue(Unwrap(Close(Client)));
  AssertTrue(Unwrap(Wait(ServerTask)));
  AssertTrue(Unwrap(CloseListener(ListenerValue)));
  var WorldPath: string := Std.Path.Join([TestConfig().WorldsRoot, TestConfig().WorldId]);
  var MetadataPath: string := Std.Path.Join([WorldPath, 'world.json']);
  var ChunkPath: string := Std.Path.Join([
                                           WorldPath,
                                           'chunks',
                                           'x_' + IntToStr(ChunkForCoordinate(Metadata.Spawn.X - 6)),
                                           ('y_' + IntToStr(ChunkForCoordinate(Metadata.Spawn.Y - 3))) + '.json'
                                         ]);
  var MetadataBefore: string := Unwrap(Std.Fs.ReadText(MetadataPath));
  var ChunkBefore: string := Unwrap(Std.Fs.ReadText(ChunkPath));
  var RestartListener: Listener := Unwrap(Listen('127.0.0.1', 0));
  var RestartAddress: NetworkAddress := Unwrap(ListenerLocalAddress(RestartListener));
  var RestartTask: task := go ServeOne(RestartListener, Token);
  var RestartClient: Connection := Unwrap(Connect('127.0.0.1', RestartAddress.Port, 5000));
  AssertTrue(Unwrap(SetTimeout(RestartClient, 30000)));
  mutable var RestartReader: LineReader := NewLineReader(RestartClient);
  AssertTrue(Unwrap(WriteLine(RestartClient, EncodeClient(ClientMessage.Hello(ProtocolVersion, 1, 1)), Token)));
  var RestartWelcome: LineRead := Unwrap(ReadLine(RestartReader, Token));
  RestartReader := RestartWelcome.Reader;
  var RestartState: LineRead := Unwrap(ReadLine(RestartReader, Token));
  RestartReader := RestartState.Reader;
  case Unwrap(DecodeServer(RestartState.Line)) of
    ServerMessage.State(Value):
    begin
      var MapValue: MapVisibleState := RequireMap(Value);
      AssertEquals(Metadata.Spawn.X, MapValue.WorldX);
      AssertEquals(Metadata.Spawn.Y, MapValue.WorldY)
    end
    else
    begin
      panic('expected state after server-session restart')
    end
  end;

  AssertTrue(Unwrap(WriteLine(RestartClient, EncodeClient(ClientMessage.Disconnect), Token)));
  AssertTrue(Unwrap(Close(RestartClient)));
  AssertTrue(Unwrap(Wait(RestartTask)));
  AssertTrue(Unwrap(CloseListener(RestartListener)));
  AssertEquals(MetadataBefore, Unwrap(Std.Fs.ReadText(MetadataPath)));
  AssertEquals(ChunkBefore, Unwrap(Std.Fs.ReadText(ChunkPath)))
end.
