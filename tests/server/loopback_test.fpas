// Verifies handshake, state transfer, movement, and disconnect over loopback TCP.
program DungeonServerLoopbackTest;

uses
  Dungeon.Test.Catalog, Dungeon.Test.Fixtures, Dungeon.Test.Routes, Dungeon.Areas.Identities,
  Dungeon.Coordinates, Dungeon.Hostiles, Dungeon.Interior, Dungeon.Interior.Generation.Validation,
  Dungeon.Interaction, Dungeon.Items, Dungeon.Protocol, Dungeon.Protocol.ClientMessages,
  Dungeon.Protocol.ServerMessages, Dungeon.Protocol.Transport, Dungeon.Server, Dungeon.Server.Config,
  Dungeon.Terrain, Dungeon.Terrain.Placement, Dungeon.World, Dungeon.World.Savegame, Std.Conv,
  Std.Fs, Std.Net, Std.Path, Std.Tasks, Std.Test, Std.Time;

function TestConfig(WorldsRoot: string): ServerConfig;
begin
  return ServerConfig(ConfigPath := '', Logs := None, WorldsRoot := WorldsRoot, WorldId := 'loopback', WorldSeed := 56789, DungeonRegionChunks := 4, ChunkCacheLimit := 32, MaximumViewWidth := 240, MaximumViewHeight := 20);
end function;

// This seed places the spawn on a signed chunk boundary so restart coverage
// also proves discovery persistence across adjacent outdoor chunks.

function RequireMap(Value: VisibleState): MapVisibleState;
begin
  if Value is VisibleState.MapState(const MapValue) then
    begin
      return MapValue;
    end;
  else
    begin
      panic('expected map visible state');
    end;
  end if;
end function;

function RequireFirstPerson(Value: VisibleState): FirstPersonVisibleState;
begin
  if Value is VisibleState.FirstPersonState(const FirstPersonValue) then
    begin
      return FirstPersonValue;
    end;
  else
    begin
      panic('expected first-person visible state');
    end;
  end if;
end function;

// One response line and the reader positioned after it.
type Exchanged = record
  Reader: LineReader;
  Message: ServerMessage;
end record;

// Sends one client message and decodes the single response.
function Ask(
  Client: Connection;
  Reader: LineReader;
  Message: ClientMessage;
  Token: CancellationToken
): Exchanged;
begin
  AssertTrue(WriteLine(Client, EncodeClient(Message), Token).Unwrap());
  const LineValue: LineRead := ReadLine(Reader, Token).Unwrap();
  return Exchanged(Reader := LineValue.Reader, Message := DecodeServer(LineValue.Line).Unwrap());
end function;

function RequireState(Message: ServerMessage): VisibleState;
begin
  if Message is ServerMessage.State(const Value) then
    begin
      return Value;
    end;
  else
    begin
      panic('expected a state message');
    end;
  end if;
end function;

procedure RequireSaved(Message: ServerMessage);
begin
  if Message is ServerMessage.SaveCompleted then
    begin
      null;
    end;
  else
    begin
      panic('expected save completion');
    end;
  end if;
end procedure;

function EnsureDirectory(Path: string): boolean;
begin
  if Std.Fs.IsDir(Path) then
    begin
      return true;
    end;
  end if;

  if Std.Fs.CreateDir(Path) is Ok(const Created) then
    begin
      return true;
    end;
  else
    begin
      return Std.Fs.IsDir(Path);
    end;
  end if;
end function;

procedure EnsureWorldRoot(Config: ServerConfig);
begin
  AssertTrue(EnsureDirectory('.temp-data'));
  AssertTrue(EnsureDirectory(Config.WorldsRoot));
  const Fixture: WorldSession := OpenWorld(Config.WorldsRoot, Config.WorldId, Config.WorldSeed, Config.DungeonRegionChunks, Config.ChunkCacheLimit)
                                   .Unwrap();
end procedure;

function ServeOne(ListenerValue: Listener; Config: ServerConfig; Token: CancellationToken): result of (boolean, string);
begin
  const Client: Connection := try AcceptWithCancellation(ListenerValue, Token);
  const Configured: boolean := try SetTimeout(Client, 2000);
  const Outcome: result of (boolean, string) := ServeConnection(Client, Config, Token);
  const Closed: boolean := try Close(Client);
  return Outcome;
end function;

begin
  const WorldsRoot: string := '.temp-data/server-loopback-' + IntToStr(TimestampMillis());
  const Config: ServerConfig := TestConfig(WorldsRoot);
  EnsureWorldRoot(Config);
  const Metadata: WorldMetadata := NewWorldMetadata(Config.WorldId, Config.WorldSeed, 4).Unwrap();
  AssertEquals(0, LocalForCoordinate(Metadata.Spawn.X));
  const ListenerValue: Listener := Listen('127.0.0.1', 0).Unwrap();
  const Address: NetworkAddress := ListenerLocalAddress(ListenerValue).Unwrap();
  const Source: CancellationSource := CreateCancellationSource();
  const Token: CancellationToken := GetCancellationToken(Source);
  const ServerTask: task := go ServeOne(ListenerValue, Config, Token);
  const Client: Connection := Connect('127.0.0.1', Address.Port, 5000).Unwrap();
  AssertTrue(SetTimeout(Client, 120000).Unwrap());
  var Reader: LineReader := NewLineReader(Client);
  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Hello(ProtocolVersion, 13, 7)), Token)
               .Unwrap());
  const WelcomeRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := WelcomeRead.Reader;
  if DecodeServer(WelcomeRead.Line) is Ok(const WelcomeMessage) then
    begin
      if WelcomeMessage is ServerMessage.Welcome(const Version, const Catalog) then
        begin
          AssertEquals(ProtocolVersion, Version);
          AssertFalse(FixtureSaveAvailable(Catalog));
          AssertFalse(FixtureInvalidSave(Catalog));
        end;
      else
        begin
          AssertTrue(false);
        end;
      end if;
    end;
  else
    begin
      panic('unexpected welcome: ' + WelcomeRead.Line);
    end;
  end if;

  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Move(1, 0)), Token).Unwrap());
  const BeforeSessionRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := BeforeSessionRead.Reader;
  if DecodeServer(BeforeSessionRead.Line).Unwrap() is ServerMessage.Rejected(const Code, const Message) then
    begin
      AssertEquals('session_not_started', Code);
    end;
  else
    begin
      panic('expected movement rejection before session selection');
    end;
  end if;

  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.SaveGame), Token).Unwrap());
  const BeforeSessionSaveRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := BeforeSessionSaveRead.Reader;
  if DecodeServer(BeforeSessionSaveRead.Line).Unwrap() is ServerMessage.Rejected(const Code, const Message) then
    begin
      AssertEquals('session_not_started', Code);
    end;
  else
    begin
      panic('expected save rejection before session selection');
    end;
  end if;

  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Viewport(20, 10)), Token).Unwrap());
  const BeforeSessionViewportRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := BeforeSessionViewportRead.Reader;
  if DecodeServer(BeforeSessionViewportRead.Line).Unwrap() is ServerMessage.Rejected(const Code, const Message) then
    begin
      AssertEquals('session_not_started', Code);
    end;
  else
    begin
      panic('expected viewport rejection before session selection');
    end;
  end if;

  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Left)), Token)
               .Unwrap());
  const BeforeSessionTurnRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := BeforeSessionTurnRead.Reader;
  if DecodeServer(BeforeSessionTurnRead.Line).Unwrap() is ServerMessage.Rejected(const Code, const Message) then
    begin
      AssertEquals('session_not_started', Code);
    end;
  else
    begin
      panic('expected turn rejection before session selection');
    end;
  end if;

  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Interact), Token).Unwrap());
  const BeforeSessionTransitionRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := BeforeSessionTransitionRead.Reader;
  if DecodeServer(BeforeSessionTransitionRead.Line).Unwrap() is ServerMessage.Rejected(const Code, const Message) then
    begin
      AssertEquals('session_not_started', Code);
    end;
  else
    begin
      panic('expected transition rejection before session selection');
    end;
  end if;

  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.ExplorationMap(0, 0, 5, 5)), Token)
               .Unwrap());
  const BeforeSessionMapRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := BeforeSessionMapRead.Reader;
  if DecodeServer(BeforeSessionMapRead.Line).Unwrap() is ServerMessage.Rejected(const Code, const Message) then
    begin
      AssertEquals('session_not_started', Code);
    end;
  else
    begin
      panic('expected exploration-map rejection before session selection');
    end;
  end if;

  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.StartNewGame), Token).Unwrap());
  const InitialRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := InitialRead.Reader;
  if DecodeServer(InitialRead.Line) is Ok(const InitialMessage) then
    begin
      if InitialMessage is ServerMessage.State(const Value) then
        begin
          const MapValue: MapVisibleState := RequireMap(Value);
          AssertEquals(13, MapValue.Width);
          AssertEquals(7, MapValue.Height);
          AssertEquals(Metadata.Spawn.X - 6, MapValue.OriginX);
          AssertEquals(Metadata.Spawn.Y - 3, MapValue.OriginY);
          AssertEquals(6, MapValue.PlayerX);
          AssertEquals(3, MapValue.PlayerY);
          AssertEquals(Metadata.Spawn.X, MapValue.WorldX);
          AssertEquals(Metadata.Spawn.Y, MapValue.WorldY);
          AssertEquals('vvvvvvvvvvvvv', MapValue.KnowledgeRows[0]);
          AssertFalse(MapValue.Rows[0].Contains('?'));
        end;
      else
        begin
          AssertTrue(false);
        end;
      end if;
    end;
  else
    begin
      panic('unexpected initial state: ' + InitialRead.Line);
    end;
  end if;
  const FarOriginX: integer := 1280000;
  const FarOriginY: integer := -1280000;
  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.ExplorationMap(FarOriginX, FarOriginY, 3, 2)), Token)
               .Unwrap());
  const FarMapRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := FarMapRead.Reader;
  if DecodeServer(FarMapRead.Line).Unwrap() is ServerMessage.ExplorationMap(const Value) then
    begin
      AssertEquals('???', Value.Rows[0]);
      AssertEquals('???', Value.Rows[1]);
      AssertEquals('uuu', Value.KnowledgeRows[0]);
      AssertFalse(Value.PlayerInWindow);
      AssertEquals(Metadata.Spawn.X, Value.PlayerWorldX);
      AssertEquals(Metadata.Spawn.Y, Value.PlayerWorldY);
    end;
  else
    begin
      panic('expected undiscovered exploration-map window');
    end;
  end if;
  const InspectionWorld: WorldSession := OpenWorld(WorldsRoot, Config.WorldId, Config.WorldSeed, 4, Config.ChunkCacheLimit)
                                           .Unwrap();
  AssertFalse(Std.Fs.Exists(WorldChunkPath(InspectionWorld, ChunkCoordinate(X := ChunkForCoordinate(FarOriginX), Y := ChunkForCoordinate(FarOriginY)))));
  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.StartNewGame), Token).Unwrap());
  const SecondStartRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := SecondStartRead.Reader;
  if DecodeServer(SecondStartRead.Line).Unwrap() is ServerMessage.Rejected(const Code, const Message) then
    begin
      AssertEquals('session_already_started', Code);
    end;
  else
    begin
      panic('expected repeated session selection to be rejected');
    end;
  end if;

  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Interact), Token).Unwrap());
  const EarlyActivationRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := EarlyActivationRead.Reader;
  if DecodeServer(EarlyActivationRead.Line).Unwrap() is ServerMessage.Interaction(const Title, const Message) then
    begin
      AssertEquals(NoInteractionMessage, Message);
    end;
  else
    begin
      panic('expected a no-target interaction result away from the entrance');
    end;
  end if;
  var CurrentX: integer := Metadata.Spawn.X;
  var CurrentY: integer := Metadata.Spawn.Y;
  for Step: integer := 1 to 3 do
    begin
      var DeltaX: integer := 0;
      var DeltaY: integer := 0;
      if CurrentX < Metadata.SpawnEntrance.X then
        begin
          DeltaX := 1;
        end;
      else
        if CurrentX > Metadata.SpawnEntrance.X then
          begin
            DeltaX := -1;
          end;
        else
          if CurrentY < Metadata.SpawnEntrance.Y then
            begin
              DeltaY := 1;
            end;
          else
            begin
              DeltaY := -1;
            end;
          end if;
        end if;
      end if;

      AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Move(DeltaX, DeltaY)), Token).Unwrap());
      const MovedRead: LineRead := ReadLine(Reader, Token).Unwrap();
      Reader := MovedRead.Reader;
      if DecodeServer(MovedRead.Line).Unwrap() is ServerMessage.State(const Value) then
        begin
          CurrentX := CurrentX + DeltaX;
          CurrentY := CurrentY + DeltaY;
          const MapValue: MapVisibleState := RequireMap(Value);
          AssertEquals(CurrentX, MapValue.WorldX);
          AssertEquals(CurrentY, MapValue.WorldY);
        end;
      else
        begin
          panic('expected map state after entrance movement');
        end;
      end if;
    end;
  end for;

  AssertEquals(Metadata.SpawnEntrance.X, CurrentX);
  AssertEquals(Metadata.SpawnEntrance.Y, CurrentY);
  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Interact), Token).Unwrap());
  const EnteredRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := EnteredRead.Reader;
  // Entry: the generated 31 by 21 spawn dungeon, at its start facing east with the exit behind.
  const Map: InteriorMap := SpawnDungeonMap(Metadata);
  var Avoid: array of InteriorPosition := [];
  for Hostile: HostilePlacement in Map.Hostiles do
    begin
      Avoid.Push(Hostile.Position);
    end;
  end for;
  const Entered: FirstPersonVisibleState := RequireFirstPerson(RequireState(DecodeServer(EnteredRead.Line)
                                                                              .Unwrap()));
  AssertEquals(GeneratedDungeonLabel, Entered.Title);
  AssertEquals(GeneratedDungeonWidth, Entered.Width);
  AssertEquals(GeneratedDungeonHeight, Entered.Height);
  AssertEquals(Map.Start.X, Entered.PlayerX);
  AssertEquals(Map.Start.Y, Entered.PlayerY);
  AssertTrue(Entered.Facing = FirstPersonFacing.East);
  AssertEquals(0, Entered.Inventory.Length());
  AssertEquals('v', Entered.KnowledgeRows[Map.Start.Y].CharAt(Map.Start.X));
  // Both immediate lateral fields reach the client; the exit behind the player stays undiscovered.
  for Side: integer in [-1, 1] do
    begin
      const Lateral: InteriorPosition := InteriorPosition(X := Map.Start.X, Y := Map.Start.Y + Side);
      AssertEquals('v', Entered.KnowledgeRows[Lateral.Y].CharAt(Lateral.X));
      AssertEquals(InteriorCellCode(InteriorCellAt(Map, Lateral).Unwrap()), Entered.Rows[Lateral.Y].CharAt(Lateral.X));
    end;
  end for;

  AssertEquals('?', Entered.Rows[Map.Exit.Y].CharAt(Map.Exit.X));
  AssertEquals('u', Entered.KnowledgeRows[Map.Exit.Y].CharAt(Map.Exit.X));
  // The test server caps windows at 20 rows; generated exits lie inside the outer wall.
  var Answer: Exchanged := Ask(Client, Reader, ClientMessage.ExplorationMap(0, 0, GeneratedDungeonWidth, 20), Token);
  Reader := Answer.Reader;
  if Answer.Message is ServerMessage.ExplorationMap(const Value) then
    begin
      AssertTrue(Value.View = ViewKind.FirstPerson);
      AssertEquals(GeneratedDungeonLabel, Value.LabelText);
      AssertTrue(Value.PlayerInWindow);
      AssertEquals(Map.Start.X, Value.PlayerWorldX);
      AssertEquals(Map.Start.Y, Value.PlayerWorldY);
      AssertEquals('?', Value.Rows[Map.Exit.Y].CharAt(Map.Exit.X));
      AssertEquals('u', Value.KnowledgeRows[Map.Exit.Y].CharAt(Map.Exit.X));
    end;
  else
    begin
      panic('expected current interior exploration map');
    end;
  end if;
  // Walk up to the coin, inspect it from the field before, then step onto it and pick it up.
  const CoinField: InteriorPosition := Map.Items[0].Position;
  const CoinId: string := ItemPlacementId(SpawnDungeonAreaId(Metadata), 0);
  const CoinRoute: array of RouteMove := RouteTo(Map, VisiblePose(Entered), CoinField, Avoid);
  var View: FirstPersonVisibleState := Entered;
  for Index: integer := 0 to CoinRoute.Length() - 2 do
    begin
      Answer := Ask(Client, Reader, RouteMessage(CoinRoute[Index]), Token);
      Reader := Answer.Reader;
      View := RequireFirstPerson(RequireState(Answer.Message));
    end;
  end for;
  const BeforeCoin: InteriorPosition := VisiblePose(View).Position;
  AssertTrue(SamePosition(FieldAhead(View), CoinField));
  AssertEquals('i', View.Rows[CoinField.Y].CharAt(CoinField.X));
  Answer := Ask(Client, Reader, ClientMessage.Interact, Token);
  Reader := Answer.Reader;
  if Answer.Message is ServerMessage.Interaction(const Title, const Message) then
    begin
      AssertEquals(AncientCoinName, Title);
      AssertEquals(AncientCoinDescription, Message);
    end;
  else
    begin
      panic('expected item inspection before pickup');
    end;
  end if;

  Answer := Ask(Client, Reader, ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward), Token);
  Reader := Answer.Reader;
  View := RequireFirstPerson(RequireState(Answer.Message));
  AssertEquals('At your feet: Ancient coin — Enter: Pick up', View.Status);
  AssertEquals(CoinField.X, View.PlayerX);
  AssertEquals(CoinField.Y, View.PlayerY);
  AssertEquals(0, View.Inventory.Length());
  Answer := Ask(Client, Reader, ClientMessage.Interact, Token);
  Reader := Answer.Reader;
  View := RequireFirstPerson(RequireState(Answer.Message));
  AssertEquals(1, View.Inventory.Length());
  AssertEquals(CoinId, View.Inventory[0].Id);
  AssertEquals(AncientCoinName, View.Inventory[0].Name);
  AssertEquals('.', View.Rows[CoinField.Y].CharAt(CoinField.X));
  // The coin is gone from the field: picking up again finds no second item at the player's feet.
  AssertFalse(View.Status.Contains('Pick up'));
  Answer := Ask(Client, Reader, ClientMessage.StepFirstPerson(FirstPersonStepDirection.Backward), Token);
  Reader := Answer.Reader;
  View := RequireFirstPerson(RequireState(Answer.Message));
  AssertEquals(BeforeCoin.X, View.PlayerX);
  AssertEquals(BeforeCoin.Y, View.PlayerY);
  AssertEquals(1, View.Inventory.Length());
  Answer := Ask(Client, Reader, ClientMessage.Move(1, 0), Token);
  Reader := Answer.Reader;
  if Answer.Message is ServerMessage.Rejected(const Code, const Message) then
    begin
      AssertEquals('movement_rejected', Code);
      AssertEquals('movement is unavailable in the current area', Message);
    end;
  else
    begin
      panic('expected dungeon movement rejection');
    end;
  end if;

  Answer := Ask(Client, Reader, ClientMessage.Viewport(1000, 1000), Token);
  Reader := Answer.Reader;
  View := RequireFirstPerson(RequireState(Answer.Message));
  AssertEquals(GeneratedDungeonLabel, View.Title);
  AssertEquals(GeneratedDungeonWidth, View.Width);
  AssertEquals(GeneratedDungeonHeight, View.Height);
  AssertEquals(BeforeCoin.X, View.PlayerX);
  AssertEquals(BeforeCoin.Y, View.PlayerY);
  // Sideways steps move one field without turning, or are rejected by a wall.
  for Direction: FirstPersonStepDirection in [
                                               FirstPersonStepDirection.Left,
                                               FirstPersonStepDirection.Right
                                             ] do
    begin
      const Pose: FirstPersonPose := VisiblePose(View);
      var Relative: RelativeStep := RelativeStep.Left;
      if Direction = FirstPersonStepDirection.Right then
        begin
          Relative := RelativeStep.Right;
        end;
      end if;
      const Offset: InteriorPosition := StepOffset(Pose.Facing, Relative);
      const Side: InteriorPosition := InteriorPosition(X := Pose.Position.X + Offset.X, Y := Pose.Position.Y +
                                                                                             Offset.Y);
      Answer := Ask(Client, Reader, ClientMessage.StepFirstPerson(Direction), Token);
      Reader := Answer.Reader;
      if InteriorCellAt(Map, Side).Unwrap() = InteriorCellKind.Wall then
        begin
          if Answer.Message is ServerMessage.Rejected(const Code, const Message) then
            begin
              AssertEquals('movement_rejected', Code);
            end;
          else
            begin
              panic('expected a sideways step into a wall to be rejected');
            end;
          end if;
        end;
      else
        begin
          View := RequireFirstPerson(RequireState(Answer.Message));
          AssertEquals(Side.X, View.PlayerX);
          AssertEquals(Side.Y, View.PlayerY);
          AssertTrue(VisiblePose(View).Facing = Pose.Facing);
        end;
      end if;
    end;
  end for;
  // Turn until a wall stands ahead: it offers no interaction and blocks a step.
  var Turns: integer := 0;
  while (InteriorCellAt(Map, FieldAhead(View)).Unwrap() <> InteriorCellKind.Wall) and (Turns < 4) do
    begin
      Answer := Ask(Client, Reader, ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Right), Token);
      Reader := Answer.Reader;
      View := RequireFirstPerson(RequireState(Answer.Message));
      Turns := Turns + 1;
    end;
  end while;

  AssertTrue(InteriorCellAt(Map, FieldAhead(View)).Unwrap() = InteriorCellKind.Wall);
  Answer := Ask(Client, Reader, ClientMessage.Interact, Token);
  Reader := Answer.Reader;
  if Answer.Message is ServerMessage.Interaction(const Title, const Message) then
    begin
      AssertEquals('', Title);
      AssertEquals(NoInteractionMessage, Message);
    end;
  else
    begin
      panic('expected no interaction with an ordinary wall');
    end;
  end if;

  Answer := Ask(Client, Reader, ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward), Token);
  Reader := Answer.Reader;
  if Answer.Message is ServerMessage.Rejected(const Code, const Message) then
    begin
      AssertEquals('movement_rejected', Code);
      AssertEquals('a wall blocks the way', Message);
    end;
  else
    begin
      panic('expected wall collision rejection');
    end;
  end if;
  // Head for the exit: save halfway, take one more move, and replace that save.
  const ExitRoute: array of RouteMove := RouteTo(Map, VisiblePose(View), Map.Exit, Avoid);
  AssertTrue(ExitRoute.Length() >= 3);
  const Halfway: integer := ExitRoute.Length() div 2;
  for Index: integer := 0 to Halfway - 1 do
    begin
      Answer := Ask(Client, Reader, RouteMessage(ExitRoute[Index]), Token);
      Reader := Answer.Reader;
      View := RequireFirstPerson(RequireState(Answer.Message));
    end;
  end for;

  Answer := Ask(Client, Reader, ClientMessage.SaveGame, Token);
  Reader := Answer.Reader;
  RequireSaved(Answer.Message);
  Answer := Ask(Client, Reader, RouteMessage(ExitRoute[Halfway]), Token);
  Reader := Answer.Reader;
  View := RequireFirstPerson(RequireState(Answer.Message));
  const SavedPose: FirstPersonPose := VisiblePose(View);
  // The entry field was seen before and stays discovered.
  AssertFalse(View.KnowledgeRows[Map.Start.Y].CharAt(Map.Start.X) = 'u');
  AssertFalse(View.Rows[Map.Start.Y].CharAt(Map.Start.X) = '?');
  Answer := Ask(Client, Reader, ClientMessage.OverwriteSaveGame, Token);
  Reader := Answer.Reader;
  RequireSaved(Answer.Message);
  for Index: integer := Halfway + 1 to ExitRoute.Length() - 1 do
    begin
      Answer := Ask(Client, Reader, RouteMessage(ExitRoute[Index]), Token);
      Reader := Answer.Reader;
      View := RequireFirstPerson(RequireState(Answer.Message));
    end;
  end for;

  AssertTrue(SamePosition(VisiblePose(View).Position, Map.Exit));
  // One step back and forward again shows the exit hint only on the exit field.
  Answer := Ask(Client, Reader, ClientMessage.StepFirstPerson(FirstPersonStepDirection.Backward), Token);
  Reader := Answer.Reader;
  View := RequireFirstPerson(RequireState(Answer.Message));
  AssertFalse(SamePosition(VisiblePose(View).Position, Map.Exit));
  AssertFalse(View.Status = 'Press Enter to return to the outdoor region.');
  Answer := Ask(Client, Reader, ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward), Token);
  Reader := Answer.Reader;
  View := RequireFirstPerson(RequireState(Answer.Message));
  AssertTrue(SamePosition(VisiblePose(View).Position, Map.Exit));
  AssertEquals('Press Enter to return to the outdoor region.', View.Status);
  Answer := Ask(Client, Reader, ClientMessage.Interact, Token);
  Reader := Answer.Reader;
  const LeftMap: MapVisibleState := RequireMap(RequireState(Answer.Message));
  AssertEquals(Metadata.SpawnEntrance.X, LeftMap.WorldX);
  AssertEquals(Metadata.SpawnEntrance.Y, LeftMap.WorldY);
  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Viewport(1000, 1000)), Token).Unwrap());
  const ResizedRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := ResizedRead.Reader;
  if DecodeServer(ResizedRead.Line).Unwrap() is ServerMessage.State(const Value) then
    begin
      const MapValue: MapVisibleState := RequireMap(Value);
      AssertEquals(240, MapValue.Width);
      AssertEquals(20, MapValue.Height);
      AssertEquals(Metadata.SpawnEntrance.X, MapValue.WorldX);
    end;
  else
    begin
      panic('expected clamped viewport state');
    end;
  end if;

  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Move(1, 1)), Token).Unwrap());
  const RejectedRead: LineRead := ReadLine(Reader, Token).Unwrap();
  Reader := RejectedRead.Reader;
  if DecodeServer(RejectedRead.Line).Unwrap() is ServerMessage.Rejected(const Code, const Message) then
    begin
      AssertEquals('movement_rejected', Code);
      AssertEquals('movement must be one cardinal step', Message);
    end;
  else
    begin
      panic('expected rejected movement');
    end;
  end if;

  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Disconnect), Token).Unwrap());
  AssertTrue(Close(Client).Unwrap());
  AssertTrue(Std.Tasks.Wait(ServerTask).Unwrap());
  AssertTrue(CloseListener(ListenerValue).Unwrap());
  const WorldPath: string := Std.Path.Join([Config.WorldsRoot, Config.WorldId]);
  const MetadataPath: string := Std.Path.Join([WorldPath, 'world.json']);
  const ChunkPath: string := Std.Path.Join([
                                             WorldPath,
                                             'chunks',
                                             'x_' + IntToStr(ChunkForCoordinate(Metadata.Spawn.X - 6)),
                                             ('y_' + IntToStr(ChunkForCoordinate(Metadata.Spawn.Y - 3))) + '.json'
                                           ]);
  const MetadataBefore: string := Std.Fs.ReadText(MetadataPath).Unwrap();
  const ChunkBefore: string := Std.Fs.ReadText(ChunkPath).Unwrap();
  const RestartListener: Listener := Listen('127.0.0.1', 0).Unwrap();
  const RestartAddress: NetworkAddress := ListenerLocalAddress(RestartListener).Unwrap();
  const RestartTask: task := go ServeOne(RestartListener, Config, Token);
  const RestartClient: Connection := Connect('127.0.0.1', RestartAddress.Port, 5000).Unwrap();
  AssertTrue(SetTimeout(RestartClient, 120000).Unwrap());
  var RestartReader: LineReader := NewLineReader(RestartClient);
  AssertTrue(WriteLine(RestartClient, EncodeClient(ClientMessage.Hello(ProtocolVersion, 1, 1)), Token)
               .Unwrap());
  const RestartWelcome: LineRead := ReadLine(RestartReader, Token).Unwrap();
  RestartReader := RestartWelcome.Reader;
  if DecodeServer(RestartWelcome.Line).Unwrap() is ServerMessage.Welcome(const Version, const Catalog) then
    begin
      AssertEquals(ProtocolVersion, Version);
      AssertTrue(FixtureSaveAvailable(Catalog));
      AssertFalse(FixtureInvalidSave(Catalog));
    end;
  else
    begin
      panic('expected restart welcome with saved-game availability');
    end;
  end if;

  AssertTrue(WriteLine(RestartClient, EncodeClient(ClientMessage.LoadGame), Token).Unwrap());
  const RestartState: LineRead := ReadLine(RestartReader, Token).Unwrap();
  RestartReader := RestartState.Reader;
  var RestartView: FirstPersonVisibleState := RequireFirstPerson(RequireState(DecodeServer(RestartState.Line)
                                                                                .Unwrap()));
  AssertTrue(SamePosition(VisiblePose(RestartView).Position, SavedPose.Position));
  AssertTrue(VisiblePose(RestartView).Facing = SavedPose.Facing);
  AssertEquals(1, RestartView.Inventory.Length());
  AssertEquals(CoinId, RestartView.Inventory[0].Id);
  // The loaded game continues in the stored level: walk to the exit and leave with the coin.
  for Move: RouteMove in RouteTo(Map, SavedPose, Map.Exit, Avoid) do
    begin
      Answer := Ask(RestartClient, RestartReader, RouteMessage(Move), Token);
      RestartReader := Answer.Reader;
      RestartView := RequireFirstPerson(RequireState(Answer.Message));
    end;
  end for;

  Answer := Ask(RestartClient, RestartReader, ClientMessage.Interact, Token);
  RestartReader := Answer.Reader;
  const LoadedExit: MapVisibleState := RequireMap(RequireState(Answer.Message));
  AssertEquals(Metadata.SpawnEntrance.X, LoadedExit.WorldX);
  AssertEquals(Metadata.SpawnEntrance.Y, LoadedExit.WorldY);
  AssertEquals(1, LoadedExit.Inventory.Length());
  AssertEquals(CoinId, LoadedExit.Inventory[0].Id);
  AssertTrue(WriteLine(RestartClient, EncodeClient(ClientMessage.OverwriteSaveGame), Token).Unwrap());
  const OutdoorSavedRead: LineRead := ReadLine(RestartReader, Token).Unwrap();
  RestartReader := OutdoorSavedRead.Reader;
  if DecodeServer(OutdoorSavedRead.Line).Unwrap() is ServerMessage.SaveCompleted then
    begin
      null;
    end;
  else
    begin
      panic('expected outdoor save completion after leaving loaded interior');
    end;
  end if;

  AssertTrue(WriteLine(RestartClient, EncodeClient(ClientMessage.Disconnect), Token).Unwrap());
  AssertTrue(Close(RestartClient).Unwrap());
  AssertTrue(Std.Tasks.Wait(RestartTask).Unwrap());
  AssertTrue(CloseListener(RestartListener).Unwrap());
  const OutdoorRestartListener: Listener := Listen('127.0.0.1', 0).Unwrap();
  const OutdoorRestartAddress: NetworkAddress := ListenerLocalAddress(OutdoorRestartListener)
                                                   .Unwrap();
  const OutdoorRestartTask: task := go ServeOne(OutdoorRestartListener, Config, Token);
  const OutdoorRestartClient: Connection := Connect('127.0.0.1', OutdoorRestartAddress.Port, 5000)
                                              .Unwrap();
  AssertTrue(SetTimeout(OutdoorRestartClient, 120000).Unwrap());
  var OutdoorRestartReader: LineReader := NewLineReader(OutdoorRestartClient);
  AssertTrue(WriteLine(OutdoorRestartClient, EncodeClient(ClientMessage.Hello(ProtocolVersion, 13, 7)), Token)
               .Unwrap());
  const OutdoorRestartWelcome: LineRead := ReadLine(OutdoorRestartReader, Token).Unwrap();
  OutdoorRestartReader := OutdoorRestartWelcome.Reader;
  if DecodeServer(OutdoorRestartWelcome.Line).Unwrap() is ServerMessage.Welcome(const Version, const Catalog) then
    begin
      AssertEquals(ProtocolVersion, Version);
      AssertTrue(FixtureSaveAvailable(Catalog));
      AssertFalse(FixtureInvalidSave(Catalog));
    end;
  else
    begin
      panic('expected outdoor restart welcome with saved-game availability');
    end;
  end if;

  AssertTrue(WriteLine(OutdoorRestartClient, EncodeClient(ClientMessage.LoadGame), Token).Unwrap());
  const OutdoorRestartState: LineRead := ReadLine(OutdoorRestartReader, Token).Unwrap();
  OutdoorRestartReader := OutdoorRestartState.Reader;
  if DecodeServer(OutdoorRestartState.Line).Unwrap() is ServerMessage.State(const Value) then
    begin
      const MapValue: MapVisibleState := RequireMap(Value);
      AssertEquals(Metadata.SpawnEntrance.X, MapValue.WorldX);
      AssertEquals(Metadata.SpawnEntrance.Y, MapValue.WorldY);
      AssertEquals(1, MapValue.Inventory.Length());
      AssertEquals(ItemPlacementId(SpawnDungeonAreaId(Metadata), 0), MapValue.Inventory[0].Id);
    end;
  else
    begin
      panic('expected exact saved outdoor position after another server restart');
    end;
  end if;

  AssertTrue(WriteLine(OutdoorRestartClient, EncodeClient(ClientMessage.ExplorationMap(Metadata.Spawn.X -
                                                                                       8, Metadata.Spawn.Y -
                                                                                          8, 17, 17)), Token)
               .Unwrap());
  const OutdoorMapRead: LineRead := ReadLine(OutdoorRestartReader, Token).Unwrap();
  OutdoorRestartReader := OutdoorMapRead.Reader;
  if DecodeServer(OutdoorMapRead.Line).Unwrap() is ServerMessage.ExplorationMap(const Value) then
    begin
      var HasRemembered: boolean := false;
      for KnowledgeRow: string in Value.KnowledgeRows do
        begin
          if KnowledgeRow.Contains('r') then
            begin
              HasRemembered := true;
            end;
          end if;
        end;
      end for;

      AssertTrue(HasRemembered);
      AssertEquals(Metadata.SpawnEntrance.X, Value.PlayerWorldX);
      AssertEquals(Metadata.SpawnEntrance.Y, Value.PlayerWorldY);
    end;
  else
    begin
      panic('expected persisted outdoor discovery after restart');
    end;
  end if;

  AssertTrue(WriteLine(OutdoorRestartClient, EncodeClient(ClientMessage.Disconnect), Token).Unwrap());
  AssertTrue(Close(OutdoorRestartClient).Unwrap());
  AssertTrue(Std.Tasks.Wait(OutdoorRestartTask).Unwrap());
  AssertTrue(CloseListener(OutdoorRestartListener).Unwrap());
  const SavedWorld: WorldSession := OpenWorld(Config.WorldsRoot, Config.WorldId, Config.WorldSeed, 4, Config.ChunkCacheLimit)
                                      .Unwrap();
  const SavePath: string := SaveGamePath(SavedWorld);
  const SavedBeforeNewGame: string := Std.Fs.ReadText(SavePath).Unwrap();
  const NewGameListener: Listener := Listen('127.0.0.1', 0).Unwrap();
  const NewGameAddress: NetworkAddress := ListenerLocalAddress(NewGameListener).Unwrap();
  const NewGameTask: task := go ServeOne(NewGameListener, Config, Token);
  const NewGameClient: Connection := Connect('127.0.0.1', NewGameAddress.Port, 5000).Unwrap();
  AssertTrue(SetTimeout(NewGameClient, 120000).Unwrap());
  var NewGameReader: LineReader := NewLineReader(NewGameClient);
  AssertTrue(WriteLine(NewGameClient, EncodeClient(ClientMessage.Hello(ProtocolVersion, 13, 7)), Token)
               .Unwrap());
  const NewGameWelcome: LineRead := ReadLine(NewGameReader, Token).Unwrap();
  NewGameReader := NewGameWelcome.Reader;
  if DecodeServer(NewGameWelcome.Line).Unwrap() is ServerMessage.Welcome(const Version, const Catalog) then
    begin
      AssertEquals(ProtocolVersion, Version);
      AssertTrue(FixtureSaveAvailable(Catalog));
      AssertFalse(FixtureInvalidSave(Catalog));
    end;
  else
    begin
      panic('expected existing save before starting a separate new game');
    end;
  end if;

  AssertTrue(WriteLine(NewGameClient, EncodeClient(ClientMessage.StartNewGame), Token).Unwrap());
  const NewGameStateRead: LineRead := ReadLine(NewGameReader, Token).Unwrap();
  NewGameReader := NewGameStateRead.Reader;
  if DecodeServer(NewGameStateRead.Line).Unwrap() is ServerMessage.State(const Value) then
    begin
      const MapValue: MapVisibleState := RequireMap(Value);
      AssertEquals(Metadata.Spawn.X, MapValue.WorldX);
      AssertEquals(Metadata.Spawn.Y, MapValue.WorldY);
    end;
  else
    begin
      panic('expected independent new-game state while a save exists');
    end;
  end if;

  AssertTrue(WriteLine(NewGameClient, EncodeClient(ClientMessage.Disconnect), Token).Unwrap());
  AssertTrue(Close(NewGameClient).Unwrap());
  AssertTrue(Std.Tasks.Wait(NewGameTask).Unwrap());
  AssertTrue(CloseListener(NewGameListener).Unwrap());
  AssertEquals(SavedBeforeNewGame, Std.Fs.ReadText(SavePath).Unwrap());
  const KeepPath: string := Std.Path.Join([SavedWorld.Directory, 'saves', 'keep.txt']);
  AssertTrue(Std.Fs.WriteTextAtomic(KeepPath, 'keep').Unwrap());
  AssertTrue(Std.Fs.WriteTextAtomic(SavePath, '{"format_version":2,"world_id":"loopback","area_kind":"outdoor_region","area_id":"loopback:outdoor","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none"},"exploration":{"outdoor_chunks":[{"chunk_x":0,"chunk_y":0,"rows":["1"]}],"interior_areas":[]}}')
               .Unwrap());
  const InvalidSaveText: string := Std.Fs.ReadText(SavePath).Unwrap();
  const InvalidListener: Listener := Listen('127.0.0.1', 0).Unwrap();
  const InvalidAddress: NetworkAddress := ListenerLocalAddress(InvalidListener).Unwrap();
  const InvalidTask: task := go ServeOne(InvalidListener, Config, Token);
  const InvalidClient: Connection := Connect('127.0.0.1', InvalidAddress.Port, 5000).Unwrap();
  AssertTrue(SetTimeout(InvalidClient, 120000).Unwrap());
  var InvalidReader: LineReader := NewLineReader(InvalidClient);
  AssertTrue(WriteLine(InvalidClient, EncodeClient(ClientMessage.Hello(ProtocolVersion, 13, 7)), Token)
               .Unwrap());
  const InvalidWelcome: LineRead := ReadLine(InvalidReader, Token).Unwrap();
  InvalidReader := InvalidWelcome.Reader;
  if DecodeServer(InvalidWelcome.Line).Unwrap() is ServerMessage.Welcome(const Version, const Catalog) then
    begin
      AssertEquals(ProtocolVersion, Version);
      AssertFalse(FixtureSaveAvailable(Catalog));
      AssertTrue(FixtureInvalidSave(Catalog));
    end;
  else
    begin
      panic('expected invalid-save preservation in welcome');
    end;
  end if;

  AssertEquals(InvalidSaveText, Std.Fs.ReadText(SavePath).Unwrap());
  AssertEquals(MetadataBefore, Std.Fs.ReadText(MetadataPath).Unwrap());
  AssertEquals(ChunkBefore, Std.Fs.ReadText(ChunkPath).Unwrap());
  AssertEquals('keep', Std.Fs.ReadText(KeepPath).Unwrap());
  AssertTrue(WriteLine(InvalidClient, EncodeClient(ClientMessage.LoadGame), Token).Unwrap());
  const MissingRead: LineRead := ReadLine(InvalidReader, Token).Unwrap();
  InvalidReader := MissingRead.Reader;
  if DecodeServer(MissingRead.Line).Unwrap() is ServerMessage.Rejected(const Code, const Message) then
    begin
      AssertEquals('save_incompatible', Code);
    end;
  else
    begin
      panic('expected load to remain unavailable with an incompatible save');
    end;
  end if;

  AssertTrue(WriteLine(InvalidClient, EncodeClient(ClientMessage.StartNewGame), Token).Unwrap());
  const FreshStateRead: LineRead := ReadLine(InvalidReader, Token).Unwrap();
  InvalidReader := FreshStateRead.Reader;
  if DecodeServer(FreshStateRead.Line).Unwrap() is ServerMessage.State(const Value) then
    begin
      const MapValue: MapVisibleState := RequireMap(Value);
      AssertEquals(Metadata.Spawn.X, MapValue.WorldX);
      AssertEquals(Metadata.Spawn.Y, MapValue.WorldY);
    end;
  else
    begin
      panic('expected a fresh outdoor state after invalid-save preservation');
    end;
  end if;

  AssertTrue(WriteLine(InvalidClient, EncodeClient(ClientMessage.OverwriteSaveGame), Token).Unwrap());
  const FreshSavedRead: LineRead := ReadLine(InvalidReader, Token).Unwrap();
  InvalidReader := FreshSavedRead.Reader;
  if DecodeServer(FreshSavedRead.Line).Unwrap() is ServerMessage.SaveCompleted then
    begin
      null;
    end;
  else
    begin
      panic('expected a fresh save after invalid-save preservation');
    end;
  end if;

  AssertTrue(WriteLine(InvalidClient, EncodeClient(ClientMessage.Disconnect), Token).Unwrap());
  AssertTrue(Close(InvalidClient).Unwrap());
  AssertTrue(Std.Tasks.Wait(InvalidTask).Unwrap());
  AssertTrue(CloseListener(InvalidListener).Unwrap());
  const FreshRestartListener: Listener := Listen('127.0.0.1', 0).Unwrap();
  const FreshRestartAddress: NetworkAddress := ListenerLocalAddress(FreshRestartListener).Unwrap();
  const FreshRestartTask: task := go ServeOne(FreshRestartListener, Config, Token);
  const FreshRestartClient: Connection := Connect('127.0.0.1', FreshRestartAddress.Port, 5000)
                                            .Unwrap();
  AssertTrue(SetTimeout(FreshRestartClient, 120000).Unwrap());
  var FreshRestartReader: LineReader := NewLineReader(FreshRestartClient);
  AssertTrue(WriteLine(FreshRestartClient, EncodeClient(ClientMessage.Hello(ProtocolVersion, 13, 7)), Token)
               .Unwrap());
  const FreshRestartWelcome: LineRead := ReadLine(FreshRestartReader, Token).Unwrap();
  FreshRestartReader := FreshRestartWelcome.Reader;
  if DecodeServer(FreshRestartWelcome.Line).Unwrap() is ServerMessage.Welcome(const Version, const Catalog) then
    begin
      AssertEquals(ProtocolVersion, Version);
      AssertTrue(FixtureSaveAvailable(Catalog));
      AssertFalse(FixtureInvalidSave(Catalog));
    end;
  else
    begin
      panic('expected fresh save availability after restart');
    end;
  end if;

  AssertTrue(WriteLine(FreshRestartClient, EncodeClient(ClientMessage.LoadGame), Token).Unwrap());
  const FreshLoadedRead: LineRead := ReadLine(FreshRestartReader, Token).Unwrap();
  FreshRestartReader := FreshLoadedRead.Reader;
  if DecodeServer(FreshLoadedRead.Line).Unwrap() is ServerMessage.State(const Value) then
    begin
      const MapValue: MapVisibleState := RequireMap(Value);
      AssertEquals(Metadata.Spawn.X, MapValue.WorldX);
      AssertEquals(Metadata.Spawn.Y, MapValue.WorldY);
    end;
  else
    begin
      panic('expected fresh save to load after restart');
    end;
  end if;

  AssertTrue(WriteLine(FreshRestartClient, EncodeClient(ClientMessage.Disconnect), Token).Unwrap());
  AssertTrue(Close(FreshRestartClient).Unwrap());
  AssertTrue(Std.Tasks.Wait(FreshRestartTask).Unwrap());
  AssertTrue(CloseListener(FreshRestartListener).Unwrap());
  AssertEquals(MetadataBefore, Std.Fs.ReadText(MetadataPath).Unwrap());
  AssertEquals(ChunkBefore, Std.Fs.ReadText(ChunkPath).Unwrap());
  AssertEquals('keep', Std.Fs.ReadText(KeepPath).Unwrap());
end.
