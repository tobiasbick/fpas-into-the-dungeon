// Verifies handshake, state transfer, movement, and disconnect over loopback TCP.
program DungeonServerLoopbackTest;

uses Dungeon.Test.Catalog as CatalogUnit, Dungeon.Test.Fixtures as Fixtures, Dungeon.Test.Routes as Routes, Dungeon.Coordinates as Coordinates, Dungeon.Hostiles as HostileRules, Dungeon.Interior as InteriorUnit, Dungeon.Interior.Generation.Validation as Validation, Dungeon.Interaction as Interaction, Dungeon.Items as ItemRules, Dungeon.Protocol as Protocol, Dungeon.Protocol.ClientMessages as ClientMessages, Dungeon.Protocol.ServerMessages as ServerMessages, Dungeon.Protocol.Transport as Transport, Dungeon.Server as Server, Dungeon.Server.Config as ConfigUnit, Dungeon.Terrain as Terrain, Dungeon.Terrain.Placement as PlacementRules, Dungeon.World as WorldUnit, Dungeon.World.Savegame as Savegame, Std.Conv as Conv, Std.Fs as Fs, Std.Net as Net, Std.Path as PathOps, Std.Tasks as Tasks, Std.Test as Test, Std.Time as Time;

// Renders network failures for the server's text-based session callback.
function FailureMessage(Cause: Net.NetError): string;
begin
  return Cause.Message();
end function;

function TestConfig(WorldsRoot: string): ConfigUnit.ServerConfig;
begin
  return ConfigUnit.ServerConfig(
    ConfigPath := '',
    Logs := None,
    WorldsRoot := WorldsRoot,
    WorldId := 'loopback',
    WorldSeed := 56789,
    DungeonRegionChunks := 4,
    ChunkCacheLimit := 32,
    MaximumViewWidth := 240,
    MaximumViewHeight := 20
  );
end function;

// This seed places the spawn on a signed chunk boundary so restart coverage
// also proves discovery persistence across adjacent outdoor chunks.

function RequireMap(Value: Protocol.VisibleState): Protocol.MapVisibleState;
begin
  case Value of
    when Protocol.VisibleState.MapState(const MapValue):
      return MapValue;
    when Protocol.VisibleState.FirstPersonState(_):
      panic('expected map visible state');
  end case;
end function;

function RequireFirstPerson(Value: Protocol.VisibleState): Protocol.FirstPersonVisibleState;
begin
  case Value of
    when Protocol.VisibleState.FirstPersonState(const FirstPersonValue):
      return FirstPersonValue;
    when Protocol.VisibleState.MapState(_):
      panic('expected first-person visible state');
  end case;
end function;

// One response line and the reader positioned after it.
type Exchanged = record
  Reader: Transport.LineReader;
  Message: Protocol.ServerMessage;
end record;

// Sends one client message and decodes the single response.
function Ask(
  Client: Net.Connection;
  Reader: Transport.LineReader;
  Message: Protocol.ClientMessage;
  Token: Tasks.CancellationToken
): Exchanged;
begin
  Test.AssertTrue(
    Transport.WriteLine(Client, ClientMessages.EncodeClient(Message), Token).Unwrap()
  );
  const LineValue: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
  return Exchanged(
    Reader := LineValue.Reader,
    Message := ServerMessages.DecodeServer(LineValue.Line).Unwrap()
  );
end function;

function RequireState(Message: Protocol.ServerMessage): Protocol.VisibleState;
begin
  case Message of
    when Protocol.ServerMessage.State(const Value):
      return Value;
    when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
      panic('expected a state message');
  end case;
end function;

procedure RequireSaved(Message: Protocol.ServerMessage);
begin
  if Message is Protocol.ServerMessage.SaveCompleted then
    begin
      null;
    end;
  else
    begin
      panic('expected save completion');
    end;
  end if;
end procedure;

function EnsureDirectory(Path: string): boolean;
begin
  if Fs.IsDir(Path) then
    begin
      return true;
    end;
  end if;

  case Fs.CreateDir(Path) of
    when Ok(const Created):
      return true;
    when Error(_):
      return Fs.IsDir(Path);
  end case;
end function;

procedure EnsureWorldRoot(Config: ConfigUnit.ServerConfig);
begin
  Test.AssertTrue(EnsureDirectory('.temp-data'));
  Test.AssertTrue(EnsureDirectory(Config.WorldsRoot));
  const Fixture: WorldUnit.WorldSession := WorldUnit.OpenWorld(
    Config.WorldsRoot,
    Config.WorldId,
    Config.WorldSeed,
    Config.DungeonRegionChunks,
    Config.ChunkCacheLimit
  ).Unwrap();
end procedure;

function ServeOne(ListenerValue: Net.Listener; Config: ConfigUnit.ServerConfig; Token: Tasks.CancellationToken): result of (boolean, string);
begin
  const Client: Net.Connection := try Net.AcceptWithCancellation(
    ListenerValue,
    Token
  ).MapError(FailureMessage);
  const Configured: boolean := try Net.SetTimeout(Client, 2000).MapError(FailureMessage);
  const Outcome: result of (boolean, string) := Server.ServeConnection(Client, Config, Token);
  const Closed: boolean := try Net.Close(Client).MapError(FailureMessage);
  return Outcome;
end function;

begin
  const WorldsRoot: string := '.temp-data/server-loopback-' + Conv.IntToStr(Time.TimestampMillis());
  const Config: ConfigUnit.ServerConfig := TestConfig(WorldsRoot);
  EnsureWorldRoot(Config);
  const Metadata: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
    Config.WorldId,
    Config.WorldSeed,
    4
  ).Unwrap();
  Test.AssertEquals(0, Coordinates.LocalForCoordinate(Metadata.Spawn.X));
  const ListenerValue: Net.Listener := Net.Listen('127.0.0.1', 0).Unwrap();
  const Address: Net.NetworkAddress := Net.ListenerLocalAddress(ListenerValue).Unwrap();
  const Source: Tasks.CancellationSource := Tasks.CreateCancellationSource();
  const Token: Tasks.CancellationToken := Tasks.GetCancellationToken(Source);
  scope
    const ServerTask: task of result of (boolean, string) := go ServeOne(
      ListenerValue,
      Config,
      Token
    );
    const Client: Net.Connection := Net.Connect('127.0.0.1', Address.Port, 5000).Unwrap();
    Test.AssertTrue(Net.SetTimeout(Client, 120000).Unwrap());
    var Reader: Transport.LineReader := Transport.NewLineReader(Client);
    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Hello(Protocol.ProtocolVersion, 13, 7)),
        Token
      ).Unwrap()
    );
    const WelcomeRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
    Reader := WelcomeRead.Reader;
    case ServerMessages.DecodeServer(WelcomeRead.Line) of
      when Ok(const WelcomeMessage):
        case WelcomeMessage of
          when Protocol.ServerMessage.Welcome(const Version, const Catalog):
            Test.AssertEquals(Protocol.ProtocolVersion, Version);
            Test.AssertFalse(CatalogUnit.FixtureSaveAvailable(Catalog));
            Test.AssertFalse(CatalogUnit.FixtureInvalidSave(Catalog));
          when Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
            Test.AssertTrue(false);
        end case;
      when Error(_):
        panic('unexpected welcome: ' + WelcomeRead.Line);
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Move(1, 0)),
        Token
      ).Unwrap()
    );
    const BeforeSessionRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
    Reader := BeforeSessionRead.Reader;
    case ServerMessages.DecodeServer(BeforeSessionRead.Line).Unwrap() of
      when Protocol.ServerMessage.Rejected(const Code, const Message):
        Test.AssertEquals('session_not_started', Code);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected movement rejection before session selection');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.SaveGame),
        Token
      ).Unwrap()
    );
    const BeforeSessionSaveRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
    Reader := BeforeSessionSaveRead.Reader;
    case ServerMessages.DecodeServer(BeforeSessionSaveRead.Line).Unwrap() of
      when Protocol.ServerMessage.Rejected(const Code, const Message):
        Test.AssertEquals('session_not_started', Code);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected save rejection before session selection');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Viewport(20, 10)),
        Token
      ).Unwrap()
    );
    const BeforeSessionViewportRead: Transport.LineRead := Transport.ReadLine(
      Reader,
      Token
    ).Unwrap();
    Reader := BeforeSessionViewportRead.Reader;
    case ServerMessages.DecodeServer(BeforeSessionViewportRead.Line).Unwrap() of
      when Protocol.ServerMessage.Rejected(const Code, const Message):
        Test.AssertEquals('session_not_started', Code);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected viewport rejection before session selection');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(
          Protocol.ClientMessage.TurnFirstPerson(Protocol.FirstPersonTurnDirection.Left)
        ),
        Token
      ).Unwrap()
    );
    const BeforeSessionTurnRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
    Reader := BeforeSessionTurnRead.Reader;
    case ServerMessages.DecodeServer(BeforeSessionTurnRead.Line).Unwrap() of
      when Protocol.ServerMessage.Rejected(const Code, const Message):
        Test.AssertEquals('session_not_started', Code);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected turn rejection before session selection');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Interact),
        Token
      ).Unwrap()
    );
    const BeforeSessionTransitionRead: Transport.LineRead := Transport.ReadLine(
      Reader,
      Token
    ).Unwrap();
    Reader := BeforeSessionTransitionRead.Reader;
    case ServerMessages.DecodeServer(BeforeSessionTransitionRead.Line).Unwrap() of
      when Protocol.ServerMessage.Rejected(const Code, const Message):
        Test.AssertEquals('session_not_started', Code);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected transition rejection before session selection');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.ExplorationMap(0, 0, 5, 5)),
        Token
      ).Unwrap()
    );
    const BeforeSessionMapRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
    Reader := BeforeSessionMapRead.Reader;
    case ServerMessages.DecodeServer(BeforeSessionMapRead.Line).Unwrap() of
      when Protocol.ServerMessage.Rejected(const Code, const Message):
        Test.AssertEquals('session_not_started', Code);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected exploration-map rejection before session selection');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.StartNewGame),
        Token
      ).Unwrap()
    );
    const InitialRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
    Reader := InitialRead.Reader;
    case ServerMessages.DecodeServer(InitialRead.Line) of
      when Ok(const InitialMessage):
        case InitialMessage of
          when Protocol.ServerMessage.State(const Value):
            const MapValue: Protocol.MapVisibleState := RequireMap(Value);
            Test.AssertEquals(13, MapValue.Width);
            Test.AssertEquals(7, MapValue.Height);
            Test.AssertEquals(Metadata.Spawn.X - 6, MapValue.OriginX);
            Test.AssertEquals(Metadata.Spawn.Y - 3, MapValue.OriginY);
            Test.AssertEquals(6, MapValue.PlayerX);
            Test.AssertEquals(3, MapValue.PlayerY);
            Test.AssertEquals(Metadata.Spawn.X, MapValue.WorldX);
            Test.AssertEquals(Metadata.Spawn.Y, MapValue.WorldY);
            Test.AssertEquals('vvvvvvvvvvvvv', MapValue.KnowledgeRows[0]);
            Test.AssertFalse('?' in MapValue.Rows[0]);
          when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
            Test.AssertTrue(false);
        end case;
      when Error(_):
        panic('unexpected initial state: ' + InitialRead.Line);
    end case;
    const FarOriginX: integer := 1280000;
    const FarOriginY: integer := -1280000;
    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(
          Protocol.ClientMessage.ExplorationMap(FarOriginX, FarOriginY, 3, 2)
        ),
        Token
      ).Unwrap()
    );
    const FarMapRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
    Reader := FarMapRead.Reader;
    case ServerMessages.DecodeServer(FarMapRead.Line).Unwrap() of
      when Protocol.ServerMessage.ExplorationMap(const Value):
        Test.AssertEquals('???', Value.Rows[0]);
        Test.AssertEquals('???', Value.Rows[1]);
        Test.AssertEquals('uuu', Value.KnowledgeRows[0]);
        Test.AssertFalse(Value.PlayerInWindow);
        Test.AssertEquals(Metadata.Spawn.X, Value.PlayerWorldX);
        Test.AssertEquals(Metadata.Spawn.Y, Value.PlayerWorldY);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected undiscovered exploration-map window');
    end case;
    const InspectionWorld: WorldUnit.WorldSession := WorldUnit.OpenWorld(
      WorldsRoot,
      Config.WorldId,
      Config.WorldSeed,
      4,
      Config.ChunkCacheLimit
    ).Unwrap();
    Test.AssertFalse(
      Fs.Exists(
        WorldUnit.WorldChunkPath(
          InspectionWorld,
          Coordinates.ChunkCoordinate(
            X := Coordinates.ChunkForCoordinate(FarOriginX),
            Y := Coordinates.ChunkForCoordinate(FarOriginY)
          )
        )
      )
    );
    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.StartNewGame),
        Token
      ).Unwrap()
    );
    const SecondStartRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
    Reader := SecondStartRead.Reader;
    case ServerMessages.DecodeServer(SecondStartRead.Line).Unwrap() of
      when Protocol.ServerMessage.Rejected(const Code, const Message):
        Test.AssertEquals('session_already_started', Code);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected repeated session selection to be rejected');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Interact),
        Token
      ).Unwrap()
    );
    const EarlyActivationRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
    Reader := EarlyActivationRead.Reader;
    case ServerMessages.DecodeServer(EarlyActivationRead.Line).Unwrap() of
      when Protocol.ServerMessage.Interaction(const Title, const Message):
        Test.AssertEquals(Interaction.NoInteractionMessage, Message);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected a no-target interaction result away from the entrance');
    end case;
    var CurrentX: integer := Metadata.Spawn.X;
    var CurrentY: integer := Metadata.Spawn.Y;
    for Step: integer := 1 to 3 do
      begin
        var DeltaX: integer := 0;
        var DeltaY: integer := 0;
        if CurrentX < Metadata.SpawnEntrance.X then
          begin
            DeltaX := 1;
          end;
        else
          if CurrentX > Metadata.SpawnEntrance.X then
            begin
              DeltaX := -1;
            end;
          else
            if CurrentY < Metadata.SpawnEntrance.Y then
              begin
                DeltaY := 1;
              end;
            else
              begin
                DeltaY := -1;
              end;
            end if;
          end if;
        end if;

        Test.AssertTrue(
          Transport.WriteLine(
            Client,
            ClientMessages.EncodeClient(Protocol.ClientMessage.Move(DeltaX, DeltaY)),
            Token
          ).Unwrap()
        );
        const MovedRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
        Reader := MovedRead.Reader;
        case ServerMessages.DecodeServer(MovedRead.Line).Unwrap() of
          when Protocol.ServerMessage.State(const Value):
            CurrentX := CurrentX + DeltaX;
            CurrentY := CurrentY + DeltaY;
            const MapValue: Protocol.MapVisibleState := RequireMap(Value);
            Test.AssertEquals(CurrentX, MapValue.WorldX);
            Test.AssertEquals(CurrentY, MapValue.WorldY);
          when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
            panic('expected map state after entrance movement');
        end case;
      end;
    end for;

    Test.AssertEquals(Metadata.SpawnEntrance.X, CurrentX);
    Test.AssertEquals(Metadata.SpawnEntrance.Y, CurrentY);
    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Interact),
        Token
      ).Unwrap()
    );
    const EnteredRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
    Reader := EnteredRead.Reader;
    // Entry: the generated 31 by 21 spawn dungeon, at its start facing east with the exit behind.
    const Map: InteriorUnit.InteriorMap := Routes.SpawnDungeonMap(Metadata);
    var Avoid: array of Coordinates.InteriorPosition := [];
    for Hostile: HostileRules.HostilePlacement in Map.Hostiles do
      begin
        Avoid.PushInPlace(Hostile.Position);
      end;
    end for;
    const Entered: Protocol.FirstPersonVisibleState := RequireFirstPerson(
      RequireState(ServerMessages.DecodeServer(EnteredRead.Line).Unwrap())
    );
    Test.AssertEquals(Map.DisplayName + ' — Level 1 of 3', Entered.Title);
    Test.AssertEquals(Validation.GeneratedDungeonWidth, Entered.Width);
    Test.AssertEquals(Validation.GeneratedDungeonHeight, Entered.Height);
    Test.AssertEquals(Map.Start.X, Entered.PlayerX);
    Test.AssertEquals(Map.Start.Y, Entered.PlayerY);
    Test.AssertTrue(Entered.Facing = Protocol.FirstPersonFacing.East);
    Test.AssertEquals(0, Entered.Inventory.Length());
    Test.AssertEquals('v', Entered.KnowledgeRows[Map.Start.Y][Map.Start.X]);
    // Both immediate lateral fields reach the client; the exit behind the player stays undiscovered.
    for Side: integer in [-1, 1] do
      begin
        const Lateral: Coordinates.InteriorPosition := Coordinates.InteriorPosition(
          X := Map.Start.X,
          Y := Map.Start.Y + Side
        );
        Test.AssertEquals('v', Entered.KnowledgeRows[Lateral.Y][Lateral.X]);
        Test.AssertEquals(
          InteriorUnit.InteriorCellCode(InteriorUnit.InteriorCellAt(Map, Lateral).Unwrap()),
          Entered.Rows[Lateral.Y][Lateral.X]
        );
      end;
    end for;

    Test.AssertEquals('?', Entered.Rows[Map.Arrival.Y][Map.Arrival.X]);
    Test.AssertEquals('u', Entered.KnowledgeRows[Map.Arrival.Y][Map.Arrival.X]);
    // The test server caps windows at 20 rows; generated exits lie inside the outer wall.
    var Answer: Exchanged := Ask(
      Client,
      Reader,
      Protocol.ClientMessage.ExplorationMap(0, 0, Validation.GeneratedDungeonWidth, 20),
      Token
    );
    Reader := Answer.Reader;
    case Answer.Message of
      when Protocol.ServerMessage.ExplorationMap(const Value):
        Test.AssertTrue(Value.View = Protocol.ViewKind.FirstPerson);
        Test.AssertEquals(Map.DisplayName, Value.LabelText);
        Test.AssertTrue(Value.PlayerInWindow);
        Test.AssertEquals(Map.Start.X, Value.PlayerWorldX);
        Test.AssertEquals(Map.Start.Y, Value.PlayerWorldY);
        Test.AssertEquals('?', Value.Rows[Map.Arrival.Y][Map.Arrival.X]);
        Test.AssertEquals('u', Value.KnowledgeRows[Map.Arrival.Y][Map.Arrival.X]);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected current interior exploration map');
    end case;
    // Walk up to the coin, inspect it from the field before, then step onto it and pick it up.
    const CoinField: Coordinates.InteriorPosition := Map.Items[0].Position;
    const CoinId: string := ItemRules.ItemPlacementId(Fixtures.SpawnDungeonAreaId(Metadata), 0);
    const CoinRoute: array of Fixtures.RouteMove := Fixtures.RouteTo(
      Map,
      Routes.VisiblePose(Entered),
      CoinField,
      Avoid
    );
    var View: Protocol.FirstPersonVisibleState := Entered;
    for Index: integer := 0 to CoinRoute.Length() - 2 do
      begin
        Answer := Ask(Client, Reader, Routes.RouteMessage(CoinRoute[Index]), Token);
        Reader := Answer.Reader;
        View := RequireFirstPerson(RequireState(Answer.Message));
      end;
    end for;
    const BeforeCoin: Coordinates.InteriorPosition := Routes.VisiblePose(View).Position;
    Test.AssertTrue(Coordinates.SamePosition(Routes.FieldAhead(View), CoinField));
    Test.AssertEquals('i', View.Rows[CoinField.Y][CoinField.X]);
    Answer := Ask(Client, Reader, Protocol.ClientMessage.Interact, Token);
    Reader := Answer.Reader;
    case Answer.Message of
      when Protocol.ServerMessage.Interaction(const Title, const Message):
        Test.AssertEquals(ItemRules.AncientCoinName, Title);
        Test.AssertEquals(ItemRules.AncientCoinDescription, Message);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected item inspection before pickup');
    end case;

    Answer := Ask(
      Client,
      Reader,
      Protocol.ClientMessage.StepFirstPerson(Protocol.FirstPersonStepDirection.Forward),
      Token
    );
    Reader := Answer.Reader;
    View := RequireFirstPerson(RequireState(Answer.Message));
    Test.AssertEquals('At your feet: Ancient coin — Enter: Pick up', View.Status);
    Test.AssertEquals(CoinField.X, View.PlayerX);
    Test.AssertEquals(CoinField.Y, View.PlayerY);
    Test.AssertEquals(0, View.Inventory.Length());
    Answer := Ask(Client, Reader, Protocol.ClientMessage.Interact, Token);
    Reader := Answer.Reader;
    View := RequireFirstPerson(RequireState(Answer.Message));
    Test.AssertEquals(1, View.Inventory.Length());
    Test.AssertEquals(CoinId, View.Inventory[0].Id);
    Test.AssertEquals(ItemRules.AncientCoinName, View.Inventory[0].Name);
    Test.AssertEquals('.', View.Rows[CoinField.Y][CoinField.X]);
    // The coin is gone from the field: picking up again finds no second item at the player's feet.
    Test.AssertFalse('Pick up' in View.Status);
    Answer := Ask(
      Client,
      Reader,
      Protocol.ClientMessage.StepFirstPerson(Protocol.FirstPersonStepDirection.Backward),
      Token
    );
    Reader := Answer.Reader;
    View := RequireFirstPerson(RequireState(Answer.Message));
    Test.AssertEquals(BeforeCoin.X, View.PlayerX);
    Test.AssertEquals(BeforeCoin.Y, View.PlayerY);
    Test.AssertEquals(1, View.Inventory.Length());
    Answer := Ask(Client, Reader, Protocol.ClientMessage.Move(1, 0), Token);
    Reader := Answer.Reader;
    case Answer.Message of
      when Protocol.ServerMessage.Rejected(const Code, const Message):
        Test.AssertEquals('movement_rejected', Code);
        Test.AssertEquals('movement is unavailable in the current area', Message);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected dungeon movement rejection');
    end case;

    Answer := Ask(Client, Reader, Protocol.ClientMessage.Viewport(1000, 1000), Token);
    Reader := Answer.Reader;
    View := RequireFirstPerson(RequireState(Answer.Message));
    Test.AssertEquals(Map.DisplayName + ' — Level 1 of 3', View.Title);
    Test.AssertEquals(Validation.GeneratedDungeonWidth, View.Width);
    Test.AssertEquals(Validation.GeneratedDungeonHeight, View.Height);
    Test.AssertEquals(BeforeCoin.X, View.PlayerX);
    Test.AssertEquals(BeforeCoin.Y, View.PlayerY);
    // Sideways steps move one field without turning, or are rejected by a wall.
    for Direction: Protocol.FirstPersonStepDirection in [
      Protocol.FirstPersonStepDirection.Left,
      Protocol.FirstPersonStepDirection.Right
    ] do
      begin
        const Pose: Coordinates.FirstPersonPose := Routes.VisiblePose(View);
        var Relative: Coordinates.RelativeStep := Coordinates.RelativeStep.Left;
        if Direction = Protocol.FirstPersonStepDirection.Right then
          begin
            Relative := Coordinates.RelativeStep.Right;
          end;
        end if;
        const Offset: Coordinates.InteriorPosition := Coordinates.StepOffset(Pose.Facing, Relative);
        const Side: Coordinates.InteriorPosition := Coordinates.InteriorPosition(
          X := Pose.Position.X + Offset.X, Y := Pose.Position.Y +
          Offset.Y
        );
        Answer := Ask(Client, Reader, Protocol.ClientMessage.StepFirstPerson(Direction), Token);
        Reader := Answer.Reader;
        if InteriorUnit.InteriorCellAt(Map, Side).Unwrap() = InteriorUnit.InteriorCellKind.Wall then
          begin
            case Answer.Message of
              when Protocol.ServerMessage.Rejected(const Code, const Message):
                Test.AssertEquals('movement_rejected', Code);
              when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
                panic('expected a sideways step into a wall to be rejected');
            end case;
          end;
        else
          begin
            View := RequireFirstPerson(RequireState(Answer.Message));
            Test.AssertEquals(Side.X, View.PlayerX);
            Test.AssertEquals(Side.Y, View.PlayerY);
            Test.AssertTrue(Routes.VisiblePose(View).Facing = Pose.Facing);
          end;
        end if;
      end;
    end for;
    // Turn until a wall stands ahead: it offers no interaction and blocks a step.
    var Turns: integer := 0;
    while (
      InteriorUnit.InteriorCellAt(Map, Routes.FieldAhead(View)).Unwrap() <>
      InteriorUnit.InteriorCellKind.Wall
    ) and (Turns < 4) do
      begin
        Answer := Ask(
          Client,
          Reader,
          Protocol.ClientMessage.TurnFirstPerson(Protocol.FirstPersonTurnDirection.Right),
          Token
        );
        Reader := Answer.Reader;
        View := RequireFirstPerson(RequireState(Answer.Message));
        Turns := Turns + 1;
      end;
    end while;

    Test.AssertTrue(
      InteriorUnit.InteriorCellAt(Map, Routes.FieldAhead(View)).Unwrap() =
      InteriorUnit.InteriorCellKind.Wall
    );
    Answer := Ask(Client, Reader, Protocol.ClientMessage.Interact, Token);
    Reader := Answer.Reader;
    case Answer.Message of
      when Protocol.ServerMessage.Interaction(const Title, const Message):
        Test.AssertEquals('', Title);
        Test.AssertEquals(Interaction.NoInteractionMessage, Message);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected no interaction with an ordinary wall');
    end case;

    Answer := Ask(
      Client,
      Reader,
      Protocol.ClientMessage.StepFirstPerson(Protocol.FirstPersonStepDirection.Forward),
      Token
    );
    Reader := Answer.Reader;
    case Answer.Message of
      when Protocol.ServerMessage.Rejected(const Code, const Message):
        Test.AssertEquals('movement_rejected', Code);
        Test.AssertEquals('a wall blocks the way', Message);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected wall collision rejection');
    end case;
    // Head for the exit: save halfway, take one more move, and replace that save.
    const ExitRoute: array of Fixtures.RouteMove := Fixtures.RouteTo(
      Map,
      Routes.VisiblePose(View),
      Map.Arrival,
      Avoid
    );
    Test.AssertTrue(ExitRoute.Length() >= 3);
    const Halfway: integer := ExitRoute.Length() div 2;
    for Index: integer := 0 to Halfway - 1 do
      begin
        Answer := Ask(Client, Reader, Routes.RouteMessage(ExitRoute[Index]), Token);
        Reader := Answer.Reader;
        View := RequireFirstPerson(RequireState(Answer.Message));
      end;
    end for;

    Answer := Ask(Client, Reader, Protocol.ClientMessage.SaveGame, Token);
    Reader := Answer.Reader;
    RequireSaved(Answer.Message);
    Answer := Ask(Client, Reader, Routes.RouteMessage(ExitRoute[Halfway]), Token);
    Reader := Answer.Reader;
    View := RequireFirstPerson(RequireState(Answer.Message));
    const SavedPose: Coordinates.FirstPersonPose := Routes.VisiblePose(View);
    // The entry field was seen before and stays discovered.
    Test.AssertFalse(View.KnowledgeRows[Map.Start.Y][Map.Start.X] = 'u');
    Test.AssertFalse(View.Rows[Map.Start.Y][Map.Start.X] = '?');
    Answer := Ask(Client, Reader, Protocol.ClientMessage.OverwriteSaveGame, Token);
    Reader := Answer.Reader;
    RequireSaved(Answer.Message);
    for Index: integer := Halfway + 1 to ExitRoute.Length() - 1 do
      begin
        Answer := Ask(Client, Reader, Routes.RouteMessage(ExitRoute[Index]), Token);
        Reader := Answer.Reader;
        View := RequireFirstPerson(RequireState(Answer.Message));
      end;
    end for;

    Test.AssertTrue(Coordinates.SamePosition(Routes.VisiblePose(View).Position, Map.Arrival));
    // One step back and forward again shows the exit hint only on the exit field.
    Answer := Ask(
      Client,
      Reader,
      Protocol.ClientMessage.StepFirstPerson(Protocol.FirstPersonStepDirection.Backward),
      Token
    );
    Reader := Answer.Reader;
    View := RequireFirstPerson(RequireState(Answer.Message));
    Test.AssertFalse(Coordinates.SamePosition(Routes.VisiblePose(View).Position, Map.Arrival));
    Test.AssertFalse(View.Status = 'Press Enter to return to the outdoor region.');
    Answer := Ask(
      Client,
      Reader,
      Protocol.ClientMessage.StepFirstPerson(Protocol.FirstPersonStepDirection.Forward),
      Token
    );
    Reader := Answer.Reader;
    View := RequireFirstPerson(RequireState(Answer.Message));
    Test.AssertTrue(Coordinates.SamePosition(Routes.VisiblePose(View).Position, Map.Arrival));
    Test.AssertEquals('Press Enter to return to the outdoor region.', View.Status);
    Answer := Ask(Client, Reader, Protocol.ClientMessage.Interact, Token);
    Reader := Answer.Reader;
    const LeftMap: Protocol.MapVisibleState := RequireMap(RequireState(Answer.Message));
    Test.AssertEquals(Metadata.SpawnEntrance.X, LeftMap.WorldX);
    Test.AssertEquals(Metadata.SpawnEntrance.Y, LeftMap.WorldY);
    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Viewport(1000, 1000)),
        Token
      ).Unwrap()
    );
    const ResizedRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
    Reader := ResizedRead.Reader;
    case ServerMessages.DecodeServer(ResizedRead.Line).Unwrap() of
      when Protocol.ServerMessage.State(const Value):
        const MapValue: Protocol.MapVisibleState := RequireMap(Value);
        Test.AssertEquals(240, MapValue.Width);
        Test.AssertEquals(20, MapValue.Height);
        Test.AssertEquals(Metadata.SpawnEntrance.X, MapValue.WorldX);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected clamped viewport state');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Move(1, 1)),
        Token
      ).Unwrap()
    );
    const RejectedRead: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
    Reader := RejectedRead.Reader;
    case ServerMessages.DecodeServer(RejectedRead.Line).Unwrap() of
      when Protocol.ServerMessage.Rejected(const Code, const Message):
        Test.AssertEquals('movement_rejected', Code);
        Test.AssertEquals('movement must be one cardinal step', Message);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected rejected movement');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Disconnect),
        Token
      ).Unwrap()
    );
    Test.AssertTrue(Net.Close(Client).Unwrap());
    Test.AssertTrue(Tasks.Wait(ServerTask).Unwrap());
    Test.AssertTrue(Net.CloseListener(ListenerValue).Unwrap());
    const WorldPath: string := PathOps.Join([Config.WorldsRoot, Config.WorldId]);
    const MetadataPath: string := PathOps.Join([WorldPath, 'world.json']);
    const ChunkPath: string := PathOps.Join([
      WorldPath,
      'chunks',
      'x_' + Conv.IntToStr(Coordinates.ChunkForCoordinate(Metadata.Spawn.X - 6)),
      ('y_' + Conv.IntToStr(Coordinates.ChunkForCoordinate(Metadata.Spawn.Y - 3))) + '.json'
    ]);
    const MetadataBefore: string := Fs.ReadText(MetadataPath).Unwrap();
    const ChunkBefore: string := Fs.ReadText(ChunkPath).Unwrap();
    const RestartListener: Net.Listener := Net.Listen('127.0.0.1', 0).Unwrap();
    const RestartAddress: Net.NetworkAddress := Net.ListenerLocalAddress(RestartListener).Unwrap();
    const RestartTask: task of result of (boolean, string) := go ServeOne(
      RestartListener,
      Config,
      Token
    );
    const RestartClient: Net.Connection := Net.Connect(
      '127.0.0.1',
      RestartAddress.Port,
      5000
    ).Unwrap();
    Test.AssertTrue(Net.SetTimeout(RestartClient, 120000).Unwrap());
    var RestartReader: Transport.LineReader := Transport.NewLineReader(RestartClient);
    Test.AssertTrue(
      Transport.WriteLine(
        RestartClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Hello(Protocol.ProtocolVersion, 1, 1)),
        Token
      ).Unwrap()
    );
    const RestartWelcome: Transport.LineRead := Transport.ReadLine(RestartReader, Token).Unwrap();
    RestartReader := RestartWelcome.Reader;
    case ServerMessages.DecodeServer(RestartWelcome.Line).Unwrap() of
      when Protocol.ServerMessage.Welcome(const Version, const Catalog):
        Test.AssertEquals(Protocol.ProtocolVersion, Version);
        Test.AssertTrue(CatalogUnit.FixtureSaveAvailable(Catalog));
        Test.AssertFalse(CatalogUnit.FixtureInvalidSave(Catalog));
      when Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected restart welcome with saved-game availability');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        RestartClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.LoadGame),
        Token
      ).Unwrap()
    );
    const RestartState: Transport.LineRead := Transport.ReadLine(RestartReader, Token).Unwrap();
    RestartReader := RestartState.Reader;
    var RestartView: Protocol.FirstPersonVisibleState := RequireFirstPerson(
      RequireState(ServerMessages.DecodeServer(RestartState.Line).Unwrap())
    );
    Test.AssertTrue(
      Coordinates.SamePosition(Routes.VisiblePose(RestartView).Position, SavedPose.Position)
    );
    Test.AssertTrue(Routes.VisiblePose(RestartView).Facing = SavedPose.Facing);
    Test.AssertEquals(1, RestartView.Inventory.Length());
    Test.AssertEquals(CoinId, RestartView.Inventory[0].Id);
    // The loaded game continues in the stored level: walk to the exit and leave with the coin.
    for Move: Fixtures.RouteMove in Fixtures.RouteTo(Map, SavedPose, Map.Arrival, Avoid) do
      begin
        Answer := Ask(RestartClient, RestartReader, Routes.RouteMessage(Move), Token);
        RestartReader := Answer.Reader;
        RestartView := RequireFirstPerson(RequireState(Answer.Message));
      end;
    end for;

    Answer := Ask(RestartClient, RestartReader, Protocol.ClientMessage.Interact, Token);
    RestartReader := Answer.Reader;
    const LoadedExit: Protocol.MapVisibleState := RequireMap(RequireState(Answer.Message));
    Test.AssertEquals(Metadata.SpawnEntrance.X, LoadedExit.WorldX);
    Test.AssertEquals(Metadata.SpawnEntrance.Y, LoadedExit.WorldY);
    Test.AssertEquals(1, LoadedExit.Inventory.Length());
    Test.AssertEquals(CoinId, LoadedExit.Inventory[0].Id);
    Test.AssertTrue(
      Transport.WriteLine(
        RestartClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.OverwriteSaveGame),
        Token
      ).Unwrap()
    );
    const OutdoorSavedRead: Transport.LineRead := Transport.ReadLine(RestartReader, Token).Unwrap();
    RestartReader := OutdoorSavedRead.Reader;
    if ServerMessages.DecodeServer(OutdoorSavedRead.Line).Unwrap() is Protocol.ServerMessage.SaveCompleted then
      begin
        null;
      end;
    else
      begin
        panic('expected outdoor save completion after leaving loaded interior');
      end;
    end if;

    Test.AssertTrue(
      Transport.WriteLine(
        RestartClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Disconnect),
        Token
      ).Unwrap()
    );
    Test.AssertTrue(Net.Close(RestartClient).Unwrap());
    Test.AssertTrue(Tasks.Wait(RestartTask).Unwrap());
    Test.AssertTrue(Net.CloseListener(RestartListener).Unwrap());
    const OutdoorRestartListener: Net.Listener := Net.Listen('127.0.0.1', 0).Unwrap();
    const OutdoorRestartAddress: Net.NetworkAddress := Net.ListenerLocalAddress(
      OutdoorRestartListener
    ).Unwrap();
    const OutdoorRestartTask: task of result of (boolean, string) := go ServeOne(
      OutdoorRestartListener,
      Config,
      Token
    );
    const OutdoorRestartClient: Net.Connection := Net.Connect(
      '127.0.0.1',
      OutdoorRestartAddress.Port,
      5000
    ).Unwrap();
    Test.AssertTrue(Net.SetTimeout(OutdoorRestartClient, 120000).Unwrap());
    var OutdoorRestartReader: Transport.LineReader := Transport.NewLineReader(OutdoorRestartClient);
    Test.AssertTrue(
      Transport.WriteLine(
        OutdoorRestartClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Hello(Protocol.ProtocolVersion, 13, 7)),
        Token
      ).Unwrap()
    );
    const OutdoorRestartWelcome: Transport.LineRead := Transport.ReadLine(
      OutdoorRestartReader,
      Token
    ).Unwrap();
    OutdoorRestartReader := OutdoorRestartWelcome.Reader;
    case ServerMessages.DecodeServer(OutdoorRestartWelcome.Line).Unwrap() of
      when Protocol.ServerMessage.Welcome(const Version, const Catalog):
        Test.AssertEquals(Protocol.ProtocolVersion, Version);
        Test.AssertTrue(CatalogUnit.FixtureSaveAvailable(Catalog));
        Test.AssertFalse(CatalogUnit.FixtureInvalidSave(Catalog));
      when Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected outdoor restart welcome with saved-game availability');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        OutdoorRestartClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.LoadGame),
        Token
      ).Unwrap()
    );
    const OutdoorRestartState: Transport.LineRead := Transport.ReadLine(
      OutdoorRestartReader,
      Token
    ).Unwrap();
    OutdoorRestartReader := OutdoorRestartState.Reader;
    case ServerMessages.DecodeServer(OutdoorRestartState.Line).Unwrap() of
      when Protocol.ServerMessage.State(const Value):
        const MapValue: Protocol.MapVisibleState := RequireMap(Value);
        Test.AssertEquals(Metadata.SpawnEntrance.X, MapValue.WorldX);
        Test.AssertEquals(Metadata.SpawnEntrance.Y, MapValue.WorldY);
        Test.AssertEquals(1, MapValue.Inventory.Length());
        Test.AssertEquals(
          ItemRules.ItemPlacementId(Fixtures.SpawnDungeonAreaId(Metadata), 0),
          MapValue.Inventory[0].Id
        );
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected exact saved outdoor position after another server restart');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        OutdoorRestartClient, ClientMessages.EncodeClient(
          Protocol.ClientMessage.ExplorationMap(
            Metadata.Spawn.X -
            8, Metadata.Spawn.Y -
            8, 17, 17
          )
        ), Token
      ).Unwrap()
    );
    const OutdoorMapRead: Transport.LineRead := Transport.ReadLine(
      OutdoorRestartReader,
      Token
    ).Unwrap();
    OutdoorRestartReader := OutdoorMapRead.Reader;
    case ServerMessages.DecodeServer(OutdoorMapRead.Line).Unwrap() of
      when Protocol.ServerMessage.ExplorationMap(const Value):
        var HasRemembered: boolean := false;
        for KnowledgeRow: string in Value.KnowledgeRows do
          begin
            if 'r' in KnowledgeRow then
              begin
                HasRemembered := true;
              end;
            end if;
          end;
        end for;

        Test.AssertTrue(HasRemembered);
        Test.AssertEquals(Metadata.SpawnEntrance.X, Value.PlayerWorldX);
        Test.AssertEquals(Metadata.SpawnEntrance.Y, Value.PlayerWorldY);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected persisted outdoor discovery after restart');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        OutdoorRestartClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Disconnect),
        Token
      ).Unwrap()
    );
    Test.AssertTrue(Net.Close(OutdoorRestartClient).Unwrap());
    Test.AssertTrue(Tasks.Wait(OutdoorRestartTask).Unwrap());
    Test.AssertTrue(Net.CloseListener(OutdoorRestartListener).Unwrap());
    const SavedWorld: WorldUnit.WorldSession := WorldUnit.OpenWorld(
      Config.WorldsRoot,
      Config.WorldId,
      Config.WorldSeed,
      4,
      Config.ChunkCacheLimit
    ).Unwrap();
    const SavePath: string := Savegame.SaveGamePath(SavedWorld);
    const SavedBeforeNewGame: string := Fs.ReadText(SavePath).Unwrap();
    const NewGameListener: Net.Listener := Net.Listen('127.0.0.1', 0).Unwrap();
    const NewGameAddress: Net.NetworkAddress := Net.ListenerLocalAddress(NewGameListener).Unwrap();
    const NewGameTask: task of result of (boolean, string) := go ServeOne(
      NewGameListener,
      Config,
      Token
    );
    const NewGameClient: Net.Connection := Net.Connect(
      '127.0.0.1',
      NewGameAddress.Port,
      5000
    ).Unwrap();
    Test.AssertTrue(Net.SetTimeout(NewGameClient, 120000).Unwrap());
    var NewGameReader: Transport.LineReader := Transport.NewLineReader(NewGameClient);
    Test.AssertTrue(
      Transport.WriteLine(
        NewGameClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Hello(Protocol.ProtocolVersion, 13, 7)),
        Token
      ).Unwrap()
    );
    const NewGameWelcome: Transport.LineRead := Transport.ReadLine(NewGameReader, Token).Unwrap();
    NewGameReader := NewGameWelcome.Reader;
    case ServerMessages.DecodeServer(NewGameWelcome.Line).Unwrap() of
      when Protocol.ServerMessage.Welcome(const Version, const Catalog):
        Test.AssertEquals(Protocol.ProtocolVersion, Version);
        Test.AssertTrue(CatalogUnit.FixtureSaveAvailable(Catalog));
        Test.AssertFalse(CatalogUnit.FixtureInvalidSave(Catalog));
      when Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected existing save before starting a separate new game');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        NewGameClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.StartNewGame),
        Token
      ).Unwrap()
    );
    const NewGameStateRead: Transport.LineRead := Transport.ReadLine(NewGameReader, Token).Unwrap();
    NewGameReader := NewGameStateRead.Reader;
    case ServerMessages.DecodeServer(NewGameStateRead.Line).Unwrap() of
      when Protocol.ServerMessage.State(const Value):
        const MapValue: Protocol.MapVisibleState := RequireMap(Value);
        Test.AssertEquals(Metadata.Spawn.X, MapValue.WorldX);
        Test.AssertEquals(Metadata.Spawn.Y, MapValue.WorldY);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected independent new-game state while a save exists');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        NewGameClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Disconnect),
        Token
      ).Unwrap()
    );
    Test.AssertTrue(Net.Close(NewGameClient).Unwrap());
    Test.AssertTrue(Tasks.Wait(NewGameTask).Unwrap());
    Test.AssertTrue(Net.CloseListener(NewGameListener).Unwrap());
    Test.AssertEquals(SavedBeforeNewGame, Fs.ReadText(SavePath).Unwrap());
    const KeepPath: string := PathOps.Join([SavedWorld.Directory, 'saves', 'keep.txt']);
    Test.AssertTrue(Fs.WriteTextAtomic(KeepPath, 'keep').Unwrap());
    Test.AssertTrue(
      Fs.WriteTextAtomic(
        SavePath,
        '{"format_version":2,"world_id":"loopback","area_kind":"outdoor_region","area_id":"loopback:outdoor","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none"},"exploration":{"outdoor_chunks":[{"chunk_x":0,"chunk_y":0,"rows":["1"]}],"interior_areas":[]}}'
      ).Unwrap()
    );
    const InvalidSaveText: string := Fs.ReadText(SavePath).Unwrap();
    const InvalidListener: Net.Listener := Net.Listen('127.0.0.1', 0).Unwrap();
    const InvalidAddress: Net.NetworkAddress := Net.ListenerLocalAddress(InvalidListener).Unwrap();
    const InvalidTask: task of result of (boolean, string) := go ServeOne(
      InvalidListener,
      Config,
      Token
    );
    const InvalidClient: Net.Connection := Net.Connect(
      '127.0.0.1',
      InvalidAddress.Port,
      5000
    ).Unwrap();
    Test.AssertTrue(Net.SetTimeout(InvalidClient, 120000).Unwrap());
    var InvalidReader: Transport.LineReader := Transport.NewLineReader(InvalidClient);
    Test.AssertTrue(
      Transport.WriteLine(
        InvalidClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Hello(Protocol.ProtocolVersion, 13, 7)),
        Token
      ).Unwrap()
    );
    const InvalidWelcome: Transport.LineRead := Transport.ReadLine(InvalidReader, Token).Unwrap();
    InvalidReader := InvalidWelcome.Reader;
    case ServerMessages.DecodeServer(InvalidWelcome.Line).Unwrap() of
      when Protocol.ServerMessage.Welcome(const Version, const Catalog):
        Test.AssertEquals(Protocol.ProtocolVersion, Version);
        Test.AssertFalse(CatalogUnit.FixtureSaveAvailable(Catalog));
        Test.AssertTrue(CatalogUnit.FixtureInvalidSave(Catalog));
      when Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected invalid-save preservation in welcome');
    end case;

    Test.AssertEquals(InvalidSaveText, Fs.ReadText(SavePath).Unwrap());
    Test.AssertEquals(MetadataBefore, Fs.ReadText(MetadataPath).Unwrap());
    Test.AssertEquals(ChunkBefore, Fs.ReadText(ChunkPath).Unwrap());
    Test.AssertEquals('keep', Fs.ReadText(KeepPath).Unwrap());
    Test.AssertTrue(
      Transport.WriteLine(
        InvalidClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.LoadGame),
        Token
      ).Unwrap()
    );
    const MissingRead: Transport.LineRead := Transport.ReadLine(InvalidReader, Token).Unwrap();
    InvalidReader := MissingRead.Reader;
    case ServerMessages.DecodeServer(MissingRead.Line).Unwrap() of
      when Protocol.ServerMessage.Rejected(const Code, const Message):
        Test.AssertEquals('save_incompatible', Code);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected load to remain unavailable with an incompatible save');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        InvalidClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.StartNewGame),
        Token
      ).Unwrap()
    );
    const FreshStateRead: Transport.LineRead := Transport.ReadLine(InvalidReader, Token).Unwrap();
    InvalidReader := FreshStateRead.Reader;
    case ServerMessages.DecodeServer(FreshStateRead.Line).Unwrap() of
      when Protocol.ServerMessage.State(const Value):
        const MapValue: Protocol.MapVisibleState := RequireMap(Value);
        Test.AssertEquals(Metadata.Spawn.X, MapValue.WorldX);
        Test.AssertEquals(Metadata.Spawn.Y, MapValue.WorldY);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected a fresh outdoor state after invalid-save preservation');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        InvalidClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.OverwriteSaveGame),
        Token
      ).Unwrap()
    );
    const FreshSavedRead: Transport.LineRead := Transport.ReadLine(InvalidReader, Token).Unwrap();
    InvalidReader := FreshSavedRead.Reader;
    if ServerMessages.DecodeServer(FreshSavedRead.Line).Unwrap() is Protocol.ServerMessage.SaveCompleted then
      begin
        null;
      end;
    else
      begin
        panic('expected a fresh save after invalid-save preservation');
      end;
    end if;

    Test.AssertTrue(
      Transport.WriteLine(
        InvalidClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Disconnect),
        Token
      ).Unwrap()
    );
    Test.AssertTrue(Net.Close(InvalidClient).Unwrap());
    Test.AssertTrue(Tasks.Wait(InvalidTask).Unwrap());
    Test.AssertTrue(Net.CloseListener(InvalidListener).Unwrap());
    const FreshRestartListener: Net.Listener := Net.Listen('127.0.0.1', 0).Unwrap();
    const FreshRestartAddress: Net.NetworkAddress := Net.ListenerLocalAddress(
      FreshRestartListener
    ).Unwrap();
    const FreshRestartTask: task of result of (boolean, string) := go ServeOne(
      FreshRestartListener,
      Config,
      Token
    );
    const FreshRestartClient: Net.Connection := Net.Connect(
      '127.0.0.1',
      FreshRestartAddress.Port,
      5000
    ).Unwrap();
    Test.AssertTrue(Net.SetTimeout(FreshRestartClient, 120000).Unwrap());
    var FreshRestartReader: Transport.LineReader := Transport.NewLineReader(FreshRestartClient);
    Test.AssertTrue(
      Transport.WriteLine(
        FreshRestartClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Hello(Protocol.ProtocolVersion, 13, 7)),
        Token
      ).Unwrap()
    );
    const FreshRestartWelcome: Transport.LineRead := Transport.ReadLine(
      FreshRestartReader,
      Token
    ).Unwrap();
    FreshRestartReader := FreshRestartWelcome.Reader;
    case ServerMessages.DecodeServer(FreshRestartWelcome.Line).Unwrap() of
      when Protocol.ServerMessage.Welcome(const Version, const Catalog):
        Test.AssertEquals(Protocol.ProtocolVersion, Version);
        Test.AssertTrue(CatalogUnit.FixtureSaveAvailable(Catalog));
        Test.AssertFalse(CatalogUnit.FixtureInvalidSave(Catalog));
      when Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected fresh save availability after restart');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        FreshRestartClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.LoadGame),
        Token
      ).Unwrap()
    );
    const FreshLoadedRead: Transport.LineRead := Transport.ReadLine(
      FreshRestartReader,
      Token
    ).Unwrap();
    FreshRestartReader := FreshLoadedRead.Reader;
    case ServerMessages.DecodeServer(FreshLoadedRead.Line).Unwrap() of
      when Protocol.ServerMessage.State(const Value):
        const MapValue: Protocol.MapVisibleState := RequireMap(Value);
        Test.AssertEquals(Metadata.Spawn.X, MapValue.WorldX);
        Test.AssertEquals(Metadata.Spawn.Y, MapValue.WorldY);
      when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
        panic('expected fresh save to load after restart');
    end case;

    Test.AssertTrue(
      Transport.WriteLine(
        FreshRestartClient,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Disconnect),
        Token
      ).Unwrap()
    );
    Test.AssertTrue(Net.Close(FreshRestartClient).Unwrap());
    Test.AssertTrue(Tasks.Wait(FreshRestartTask).Unwrap());
    Test.AssertTrue(Net.CloseListener(FreshRestartListener).Unwrap());
    Test.AssertEquals(MetadataBefore, Fs.ReadText(MetadataPath).Unwrap());
    Test.AssertEquals(ChunkBefore, Fs.ReadText(ChunkPath).Unwrap());
    Test.AssertEquals('keep', Fs.ReadText(KeepPath).Unwrap());
  end scope;
end.
