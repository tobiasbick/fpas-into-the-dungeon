// Verifies handshake, state transfer, movement, and disconnect over loopback TCP.
program DungeonServerLoopbackTest;

uses
  Dungeon.Game, Dungeon.Protocol, Dungeon.Protocol.Transport, Dungeon.Server, Dungeon.World,
  Dungeon.World.Savegame, Std.Arrays, Std.Conv, Std.Fs, Std.Net, Std.Path, Std.Results, Std.Str,
  Std.Task, Std.Test, Std.Time;

function TestConfig(WorldsRoot: string): ServerConfig;
begin
  return record
    WorldsRoot := WorldsRoot;
    WorldId := 'loopback';
    WorldSeed := 56789;
    ChunkCacheLimit := 32;
    MaximumViewWidth := 240;
    MaximumViewHeight := 20;
  end
end;

// This seed places the spawn on a signed chunk boundary so restart coverage
// also proves discovery persistence across adjacent outdoor chunks.

function RequireMap(Value: VisibleState): MapVisibleState;
begin
  case Value of
    VisibleState.MapState(MapValue):
    begin
      return MapValue
    end
    else
    begin
      panic('expected map visible state')
    end
  end
end;

function RequireFirstPerson(Value: VisibleState): FirstPersonVisibleState;
begin
  case Value of
    VisibleState.FirstPersonState(FirstPersonValue):
    begin
      return FirstPersonValue
    end
    else
    begin
      panic('expected first-person visible state')
    end
  end
end;

function EnsureDirectory(Path: string): boolean;
begin
  if Std.Fs.IsDir(Path) then
  begin
    return true
  end;

  case Std.Fs.CreateDir(Path) of
    Ok(Created):
    begin
      return true
    end
    else
    begin
      return Std.Fs.IsDir(Path)
    end
  end
end;

procedure EnsureWorldRoot(Config: ServerConfig);
begin
  AssertTrue(EnsureDirectory('.temp-data'));
  AssertTrue(EnsureDirectory(Config.WorldsRoot))
end;

function ServeOne(ListenerValue: Listener; Config: ServerConfig; Token: CancellationToken): result of boolean, string;
begin
  var Client: Connection := try AcceptWithCancellation(ListenerValue, Token);
  var Configured: boolean := try SetTimeout(Client, 2000);
  var Outcome: result of boolean, string := ServeConnection(Client, Config, Token);
  var Closed: boolean := try Close(Client);
  return Outcome
end;

begin
  var WorldsRoot: string := '.temp-data/server-loopback-' + IntToStr(TimestampMillis());
  var Config: ServerConfig := TestConfig(WorldsRoot);
  EnsureWorldRoot(Config);
  var Metadata: WorldMetadata := Unwrap(NewWorldMetadata(Config.WorldId, Config.WorldSeed));
  AssertEquals(0, LocalForCoordinate(Metadata.Spawn.X));
  var ListenerValue: Listener := Unwrap(Listen('127.0.0.1', 0));
  var Address: NetworkAddress := Unwrap(ListenerLocalAddress(ListenerValue));
  var Source: CancellationSource := CreateCancellationSource();
  var Token: CancellationToken := GetCancellationToken(Source);
  var ServerTask: task := go ServeOne(ListenerValue, Config, Token);
  var Client: Connection := Unwrap(Connect('127.0.0.1', Address.Port, 5000));
  AssertTrue(Unwrap(SetTimeout(Client, 120000)));
  mutable var Reader: LineReader := NewLineReader(Client);
  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Hello(ProtocolVersion, 13, 7)), Token)));
  var WelcomeRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := WelcomeRead.Reader;
  case DecodeServer(WelcomeRead.Line) of
    Ok(WelcomeMessage):
    begin
      case WelcomeMessage of
        ServerMessage.Welcome(Version, SaveAvailable, InvalidSaveRemoved):
        begin
          AssertEquals(ProtocolVersion, Version);
          AssertFalse(SaveAvailable);
          AssertFalse(InvalidSaveRemoved)
        end
        else
        begin
          AssertTrue(false)
        end
      end
    end
    else
    begin
      panic('unexpected welcome: ' + WelcomeRead.Line)
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Move(1, 0)), Token)));
  var BeforeSessionRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := BeforeSessionRead.Reader;
  case Unwrap(DecodeServer(BeforeSessionRead.Line)) of
    ServerMessage.Rejected(Code, Message):
    begin
      AssertEquals('session_not_started', Code)
    end
    else
    begin
      panic('expected movement rejection before session selection')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.SaveGame), Token)));
  var BeforeSessionSaveRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := BeforeSessionSaveRead.Reader;
  case Unwrap(DecodeServer(BeforeSessionSaveRead.Line)) of
    ServerMessage.Rejected(Code, Message):
    begin
      AssertEquals('session_not_started', Code)
    end
    else
    begin
      panic('expected save rejection before session selection')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Viewport(20, 10)), Token)));
  var BeforeSessionViewportRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := BeforeSessionViewportRead.Reader;
  case Unwrap(DecodeServer(BeforeSessionViewportRead.Line)) of
    ServerMessage.Rejected(Code, Message):
    begin
      AssertEquals('session_not_started', Code)
    end
    else
    begin
      panic('expected viewport rejection before session selection')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Left)), Token)));
  var BeforeSessionTurnRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := BeforeSessionTurnRead.Reader;
  case Unwrap(DecodeServer(BeforeSessionTurnRead.Line)) of
    ServerMessage.Rejected(Code, Message):
    begin
      AssertEquals('session_not_started', Code)
    end
    else
    begin
      panic('expected turn rejection before session selection')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Interact), Token)));
  var BeforeSessionTransitionRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := BeforeSessionTransitionRead.Reader;
  case Unwrap(DecodeServer(BeforeSessionTransitionRead.Line)) of
    ServerMessage.Rejected(Code, Message):
    begin
      AssertEquals('session_not_started', Code)
    end
    else
    begin
      panic('expected transition rejection before session selection')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.ExplorationMap(0, 0, 5, 5)), Token)));
  var BeforeSessionMapRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := BeforeSessionMapRead.Reader;
  case Unwrap(DecodeServer(BeforeSessionMapRead.Line)) of
    ServerMessage.Rejected(Code, Message):
    begin
      AssertEquals('session_not_started', Code)
    end
    else
    begin
      panic('expected exploration-map rejection before session selection')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StartNewGame), Token)));
  var InitialRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := InitialRead.Reader;
  case DecodeServer(InitialRead.Line) of
    Ok(InitialMessage):
    begin
      case InitialMessage of
        ServerMessage.State(Value):
        begin
          var MapValue: MapVisibleState := RequireMap(Value);
          AssertEquals(13, MapValue.Width);
          AssertEquals(7, MapValue.Height);
          AssertEquals(Metadata.Spawn.X - 6, MapValue.OriginX);
          AssertEquals(Metadata.Spawn.Y - 3, MapValue.OriginY);
          AssertEquals(6, MapValue.PlayerX);
          AssertEquals(3, MapValue.PlayerY);
          AssertEquals(Metadata.Spawn.X, MapValue.WorldX);
          AssertEquals(Metadata.Spawn.Y, MapValue.WorldY);
          AssertEquals('vvvvvvvvvvvvv', MapValue.KnowledgeRows[0]);
          AssertFalse(Std.Str.Contains(MapValue.Rows[0], '?'))
        end
        else
        begin
          AssertTrue(false)
        end
      end
    end
    else
    begin
      panic('unexpected initial state: ' + InitialRead.Line)
    end
  end;
  var FarOriginX: integer := 1280000;
  var FarOriginY: integer := -1280000;
  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.ExplorationMap(FarOriginX, FarOriginY, 3, 2)), Token)));
  var FarMapRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := FarMapRead.Reader;
  case Unwrap(DecodeServer(FarMapRead.Line)) of
    ServerMessage.ExplorationMap(Value):
    begin
      AssertEquals('???', Value.Rows[0]);
      AssertEquals('???', Value.Rows[1]);
      AssertEquals('uuu', Value.KnowledgeRows[0]);
      AssertFalse(Value.PlayerInWindow);
      AssertEquals(Metadata.Spawn.X, Value.PlayerWorldX);
      AssertEquals(Metadata.Spawn.Y, Value.PlayerWorldY)
    end
    else
    begin
      panic('expected undiscovered exploration-map window')
    end
  end;
  var InspectionWorld: WorldSession := Unwrap(OpenWorld(WorldsRoot, Config.WorldId, Config.WorldSeed, Config.ChunkCacheLimit));
  AssertFalse(Std.Fs.Exists(WorldChunkPath(InspectionWorld, record
    X := ChunkForCoordinate(FarOriginX);
    Y := ChunkForCoordinate(FarOriginY);
  end)));
  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StartNewGame), Token)));
  var SecondStartRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := SecondStartRead.Reader;
  case Unwrap(DecodeServer(SecondStartRead.Line)) of
    ServerMessage.Rejected(Code, Message):
    begin
      AssertEquals('session_already_started', Code)
    end
    else
    begin
      panic('expected repeated session selection to be rejected')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Interact), Token)));
  var EarlyActivationRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := EarlyActivationRead.Reader;
  case Unwrap(DecodeServer(EarlyActivationRead.Line)) of
    ServerMessage.Interaction(Title, Message):
    begin
      AssertEquals(NoInteractionMessage, Message)
    end
    else
    begin
      panic('expected a no-target interaction result away from the entrance')
    end
  end;
  mutable var CurrentX: integer := Metadata.Spawn.X;
  mutable var CurrentY: integer := Metadata.Spawn.Y;
  for Step: integer := 1 to 3 do
  begin
    mutable var DeltaX: integer := 0;
    mutable var DeltaY: integer := 0;
    if CurrentX < Metadata.Entrance.X then
    begin
      DeltaX := 1
    end
    else if CurrentX > Metadata.Entrance.X then
    begin
      DeltaX := -1
    end
    else if CurrentY < Metadata.Entrance.Y then
    begin
      DeltaY := 1
    end
    else
    begin
      DeltaY := -1
    end;

    AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Move(DeltaX, DeltaY)), Token)));
    var MovedRead: LineRead := Unwrap(ReadLine(Reader, Token));
    Reader := MovedRead.Reader;
    case Unwrap(DecodeServer(MovedRead.Line)) of
      ServerMessage.State(Value):
      begin
        CurrentX := CurrentX + DeltaX;
        CurrentY := CurrentY + DeltaY;
        var MapValue: MapVisibleState := RequireMap(Value);
        AssertEquals(CurrentX, MapValue.WorldX);
        AssertEquals(CurrentY, MapValue.WorldY)
      end
      else
      begin
        panic('expected map state after entrance movement')
      end
    end
  end;

  AssertEquals(Metadata.Entrance.X, CurrentX);
  AssertEquals(Metadata.Entrance.Y, CurrentY);
  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Interact), Token)));
  var EnteredRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := EnteredRead.Reader;
  case Unwrap(DecodeServer(EnteredRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals(Metadata.DungeonAreaLabel, FirstPersonValue.Title);
      AssertEquals('Ancient coin — Enter: Examine', FirstPersonValue.Status);
      AssertEquals(11, FirstPersonValue.Width);
      AssertEquals(9, FirstPersonValue.Height);
      AssertEquals(9, FirstPersonValue.PlayerX);
      AssertEquals(1, FirstPersonValue.PlayerY);
      AssertTrue(FirstPersonValue.Facing = FirstPersonFacing.West);
      AssertEquals(0, Std.Arrays.Length(FirstPersonValue.Inventory));
      AssertEquals('i', Std.Str.CharAt(FirstPersonValue.Rows[1], 8));
      AssertTrue(Std.Str.Contains(FirstPersonValue.Rows[0], '?'));
      AssertEquals('v', Std.Str.CharAt(FirstPersonValue.KnowledgeRows[1], 9));
      AssertEquals('?', Std.Str.CharAt(FirstPersonValue.Rows[7], 1));
      AssertEquals('u', Std.Str.CharAt(FirstPersonValue.KnowledgeRows[7], 1))
    end
    else
    begin
      panic('expected first-person state after entry')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.ExplorationMap(0, 0, 11, 9)), Token)));
  var InteriorMapRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := InteriorMapRead.Reader;
  case Unwrap(DecodeServer(InteriorMapRead.Line)) of
    ServerMessage.ExplorationMap(Value):
    begin
      AssertTrue(Value.View = ViewKind.FirstPerson);
      AssertEquals(Metadata.DungeonAreaLabel, Value.LabelText);
      AssertTrue(Value.PlayerInWindow);
      AssertEquals(9, Value.PlayerWorldX);
      AssertEquals(1, Value.PlayerWorldY);
      AssertEquals('i', Std.Str.CharAt(Value.Rows[1], 8));
      AssertEquals('?', Std.Str.CharAt(Value.Rows[7], 1));
      AssertEquals('u', Std.Str.CharAt(Value.KnowledgeRows[7], 1))
    end
    else
    begin
      panic('expected current interior exploration map')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Interact), Token)));
  var InspectedItemRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := InspectedItemRead.Reader;
  case Unwrap(DecodeServer(InspectedItemRead.Line)) of
    ServerMessage.Interaction(Title, Message):
    begin
      AssertEquals(InitialDungeonItemName, Title);
      AssertEquals(InitialDungeonItemDescription, Message)
    end
    else
    begin
      panic('expected item inspection before pickup')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward)), Token)));
  var ItemStepRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := ItemStepRead.Reader;
  case Unwrap(DecodeServer(ItemStepRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals('At your feet: Ancient coin — Enter: Pick up', FirstPersonValue.Status);
      AssertEquals(8, FirstPersonValue.PlayerX);
      AssertEquals(1, FirstPersonValue.PlayerY);
      AssertEquals(0, Std.Arrays.Length(FirstPersonValue.Inventory));
      AssertEquals('i', Std.Str.CharAt(FirstPersonValue.Rows[1], 8))
    end
    else
    begin
      panic('expected movement onto the item field')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Interact), Token)));
  var PickedUpItemRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := PickedUpItemRead.Reader;
  case Unwrap(DecodeServer(PickedUpItemRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals(1, Std.Arrays.Length(FirstPersonValue.Inventory));
      AssertEquals(InitialDungeonItemId, FirstPersonValue.Inventory[0].Id);
      AssertEquals(InitialDungeonItemName, FirstPersonValue.Inventory[0].Name);
      AssertEquals('.', Std.Str.CharAt(FirstPersonValue.Rows[1], 8))
    end
    else
    begin
      panic('expected state projection after item pickup')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Interact), Token)));
  var RepeatedPickupRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := RepeatedPickupRead.Reader;
  case Unwrap(DecodeServer(RepeatedPickupRead.Line)) of
    ServerMessage.Interaction(Title, Message):
    begin
      AssertEquals('', Title);
      AssertEquals(NoInteractionMessage, Message)
    end
    else
    begin
      panic('expected repeated pickup to find no second item')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Backward)), Token)));
  var RestoredStartRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := RestoredStartRead.Reader;
  case Unwrap(DecodeServer(RestoredStartRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals(9, FirstPersonValue.PlayerX);
      AssertEquals(1, FirstPersonValue.PlayerY);
      AssertEquals(1, Std.Arrays.Length(FirstPersonValue.Inventory))
    end
    else
    begin
      panic('expected return to the initial dungeon position after pickup')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Move(1, 0)), Token)));
  var DungeonMoveRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := DungeonMoveRead.Reader;
  case Unwrap(DecodeServer(DungeonMoveRead.Line)) of
    ServerMessage.Rejected(Code, Message):
    begin
      AssertEquals('movement_rejected', Code);
      AssertEquals('movement is unavailable in the current area', Message)
    end
    else
    begin
      panic('expected dungeon movement rejection')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Viewport(1000, 1000)), Token)));
  var DungeonViewportRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := DungeonViewportRead.Reader;
  case Unwrap(DecodeServer(DungeonViewportRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals(Metadata.DungeonAreaLabel, FirstPersonValue.Title);
      AssertEquals(11, FirstPersonValue.Width);
      AssertEquals(9, FirstPersonValue.Height);
      AssertEquals(9, FirstPersonValue.PlayerX);
      AssertEquals(1, FirstPersonValue.PlayerY)
    end
    else
    begin
      panic('viewport must retain the first-person geometry')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Left)), Token)));
  var StrafeLeftRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := StrafeLeftRead.Reader;
  case Unwrap(DecodeServer(StrafeLeftRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals(9, FirstPersonValue.PlayerX);
      AssertEquals(2, FirstPersonValue.PlayerY)
    end
    else
    begin
      panic('expected first-person state after left step')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Right)), Token)));
  var StrafeRightRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := StrafeRightRead.Reader;
  case Unwrap(DecodeServer(StrafeRightRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals(9, FirstPersonValue.PlayerX);
      AssertEquals(1, FirstPersonValue.PlayerY)
    end
    else
    begin
      panic('expected first-person state after right step')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Right)), Token)));
  var TurnNorthRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := TurnNorthRead.Reader;
  case Unwrap(DecodeServer(TurnNorthRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertTrue(FirstPersonValue.Facing = FirstPersonFacing.North);
      AssertEquals('t', Std.Str.CharAt(FirstPersonValue.Rows[0], 9))
    end
    else
    begin
      panic('expected first-person state after right turn')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Interact), Token)));
  var TabletRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := TabletRead.Reader;
  case Unwrap(DecodeServer(TabletRead.Line)) of
    ServerMessage.Interaction(Title, Message):
    begin
      AssertEquals(StoneTabletDescription, Message)
    end
    else
    begin
      panic('expected a read-only stone tablet interaction')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward)), Token)));
  var WallRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := WallRead.Reader;
  case Unwrap(DecodeServer(WallRead.Line)) of
    ServerMessage.Rejected(Code, Message):
    begin
      AssertEquals('movement_rejected', Code);
      AssertEquals('a wall blocks the way', Message)
    end
    else
    begin
      panic('expected wall collision rejection')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Left)), Token)));
  var TurnWestRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := TurnWestRead.Reader;
  case Unwrap(DecodeServer(TurnWestRead.Line)) of
    ServerMessage.State(Value):
    begin
      AssertTrue(RequireFirstPerson(Value).Facing = FirstPersonFacing.West)
    end
    else
    begin
      panic('expected valid action after rejected wall step')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Left)), Token)));
  var TurnSouthRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := TurnSouthRead.Reader;
  case Unwrap(DecodeServer(TurnSouthRead.Line)) of
    ServerMessage.State(Value):
    begin
      AssertTrue(RequireFirstPerson(Value).Facing = FirstPersonFacing.South)
    end
    else
    begin
      panic('expected south-facing state')
    end
  end;

  for InteriorStep: integer := 1 to 6 do
  begin
    AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward)), Token)));
    var StepRead: LineRead := Unwrap(ReadLine(Reader, Token));
    Reader := StepRead.Reader;
    case Unwrap(DecodeServer(StepRead.Line)) of
      ServerMessage.State(Value):
      begin
        var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
        AssertEquals(9, FirstPersonValue.PlayerX);
        AssertEquals(1 + InteriorStep, FirstPersonValue.PlayerY)
      end
      else
      begin
        panic('expected first-person state while walking south')
      end
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.SaveGame), Token)));
  var SavedRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := SavedRead.Reader;
  case Unwrap(DecodeServer(SavedRead.Line)) of
    ServerMessage.SaveCompleted:
    begin
    end
    else
    begin
      panic('expected save completion after atomic persistence')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Right)), Token)));
  var ExitTurnRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := ExitTurnRead.Reader;
  case Unwrap(DecodeServer(ExitTurnRead.Line)) of
    ServerMessage.State(Value):
    begin
      AssertTrue(RequireFirstPerson(Value).Facing = FirstPersonFacing.West)
    end
    else
    begin
      panic('expected west-facing state before exit corridor')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward)), Token)));
  var BeforeReplacementSaveRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := BeforeReplacementSaveRead.Reader;
  case Unwrap(DecodeServer(BeforeReplacementSaveRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals(8, FirstPersonValue.PlayerX);
      AssertEquals(7, FirstPersonValue.PlayerY);
      AssertTrue(FirstPersonValue.Facing = FirstPersonFacing.West);
      AssertEquals('r', Std.Str.CharAt(FirstPersonValue.KnowledgeRows[1], 9));
      AssertFalse(Std.Str.CharAt(FirstPersonValue.Rows[1], 9) = '?')
    end
    else
    begin
      panic('expected state before replacement save')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.SaveGame), Token)));
  var ReplacementSavedRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := ReplacementSavedRead.Reader;
  case Unwrap(DecodeServer(ReplacementSavedRead.Line)) of
    ServerMessage.SaveCompleted:
    begin
    end
    else
    begin
      panic('expected second save completion after atomic replacement')
    end
  end;

  for InteriorStep: integer := 1 to 7 do
  begin
    AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward)), Token)));
    var StepRead: LineRead := Unwrap(ReadLine(Reader, Token));
    Reader := StepRead.Reader;
    case Unwrap(DecodeServer(StepRead.Line)) of
      ServerMessage.State(Value):
      begin
        var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
        AssertEquals(8 - InteriorStep, FirstPersonValue.PlayerX);
        AssertEquals(7, FirstPersonValue.PlayerY)
      end
      else
      begin
        panic('expected first-person state while walking to exit')
      end
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Backward)), Token)));
  var BackwardRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := BackwardRead.Reader;
  case Unwrap(DecodeServer(BackwardRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals(2, FirstPersonValue.PlayerX);
      AssertEquals(7, FirstPersonValue.PlayerY);
      AssertEquals('Find the gold exit field.', FirstPersonValue.Status)
    end
    else
    begin
      panic('expected one-field backward movement')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward)), Token)));
  var ReturnToExitRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := ReturnToExitRead.Reader;
  case Unwrap(DecodeServer(ReturnToExitRead.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals(1, FirstPersonValue.PlayerX);
      AssertEquals(7, FirstPersonValue.PlayerY);
      AssertEquals('Press Enter to return to the outdoor region.', FirstPersonValue.Status)
    end
    else
    begin
      panic('expected exit-field state')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Interact), Token)));
  var LeftRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := LeftRead.Reader;
  case Unwrap(DecodeServer(LeftRead.Line)) of
    ServerMessage.State(Value):
    begin
      var MapValue: MapVisibleState := RequireMap(Value);
      AssertEquals(Metadata.Entrance.X, MapValue.WorldX);
      AssertEquals(Metadata.Entrance.Y, MapValue.WorldY)
    end
    else
    begin
      panic('expected restored map after leaving dungeon')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Viewport(1000, 1000)), Token)));
  var ResizedRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := ResizedRead.Reader;
  case Unwrap(DecodeServer(ResizedRead.Line)) of
    ServerMessage.State(Value):
    begin
      var MapValue: MapVisibleState := RequireMap(Value);
      AssertEquals(240, MapValue.Width);
      AssertEquals(20, MapValue.Height);
      AssertEquals(Metadata.Entrance.X, MapValue.WorldX)
    end
    else
    begin
      panic('expected clamped viewport state')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Move(1, 1)), Token)));
  var RejectedRead: LineRead := Unwrap(ReadLine(Reader, Token));
  Reader := RejectedRead.Reader;
  case Unwrap(DecodeServer(RejectedRead.Line)) of
    ServerMessage.Rejected(Code, Message):
    begin
      AssertEquals('movement_rejected', Code);
      AssertEquals('movement must be one cardinal step', Message)
    end
    else
    begin
      panic('expected rejected movement')
    end
  end;

  AssertTrue(Unwrap(WriteLine(Client, EncodeClient(ClientMessage.Disconnect), Token)));
  AssertTrue(Unwrap(Close(Client)));
  AssertTrue(Unwrap(Wait(ServerTask)));
  AssertTrue(Unwrap(CloseListener(ListenerValue)));
  var WorldPath: string := Std.Path.Join([Config.WorldsRoot, Config.WorldId]);
  var MetadataPath: string := Std.Path.Join([WorldPath, 'world.json']);
  var ChunkPath: string := Std.Path.Join([
                                           WorldPath,
                                           'chunks',
                                           'x_' + IntToStr(ChunkForCoordinate(Metadata.Spawn.X - 6)),
                                           ('y_' + IntToStr(ChunkForCoordinate(Metadata.Spawn.Y - 3))) + '.json'
                                         ]);
  var MetadataBefore: string := Unwrap(Std.Fs.ReadText(MetadataPath));
  var ChunkBefore: string := Unwrap(Std.Fs.ReadText(ChunkPath));
  var RestartListener: Listener := Unwrap(Listen('127.0.0.1', 0));
  var RestartAddress: NetworkAddress := Unwrap(ListenerLocalAddress(RestartListener));
  var RestartTask: task := go ServeOne(RestartListener, Config, Token);
  var RestartClient: Connection := Unwrap(Connect('127.0.0.1', RestartAddress.Port, 5000));
  AssertTrue(Unwrap(SetTimeout(RestartClient, 120000)));
  mutable var RestartReader: LineReader := NewLineReader(RestartClient);
  AssertTrue(Unwrap(WriteLine(RestartClient, EncodeClient(ClientMessage.Hello(ProtocolVersion, 1, 1)), Token)));
  var RestartWelcome: LineRead := Unwrap(ReadLine(RestartReader, Token));
  RestartReader := RestartWelcome.Reader;
  case Unwrap(DecodeServer(RestartWelcome.Line)) of
    ServerMessage.Welcome(Version, SaveAvailable, InvalidSaveRemoved):
    begin
      AssertEquals(ProtocolVersion, Version);
      AssertTrue(SaveAvailable);
      AssertFalse(InvalidSaveRemoved)
    end
    else
    begin
      panic('expected restart welcome with saved-game availability')
    end
  end;

  AssertTrue(Unwrap(WriteLine(RestartClient, EncodeClient(ClientMessage.LoadGame), Token)));
  var RestartState: LineRead := Unwrap(ReadLine(RestartReader, Token));
  RestartReader := RestartState.Reader;
  case Unwrap(DecodeServer(RestartState.Line)) of
    ServerMessage.State(Value):
    begin
      var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
      AssertEquals(8, FirstPersonValue.PlayerX);
      AssertEquals(7, FirstPersonValue.PlayerY);
      AssertTrue(FirstPersonValue.Facing = FirstPersonFacing.West);
      AssertEquals(1, Std.Arrays.Length(FirstPersonValue.Inventory));
      AssertEquals(InitialDungeonItemId, FirstPersonValue.Inventory[0].Id)
    end
    else
    begin
      panic('expected saved first-person state after server restart')
    end
  end;

  for LoadedStep: integer := 1 to 7 do
  begin
    AssertTrue(Unwrap(WriteLine(RestartClient, EncodeClient(ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward)), Token)));
    var LoadedStepRead: LineRead := Unwrap(ReadLine(RestartReader, Token));
    RestartReader := LoadedStepRead.Reader;
    case Unwrap(DecodeServer(LoadedStepRead.Line)) of
      ServerMessage.State(Value):
      begin
        var FirstPersonValue: FirstPersonVisibleState := RequireFirstPerson(Value);
        AssertEquals(8 - LoadedStep, FirstPersonValue.PlayerX);
        AssertEquals(7, FirstPersonValue.PlayerY)
      end
      else
      begin
        panic('expected loaded interior movement toward exit')
      end
    end
  end;

  AssertTrue(Unwrap(WriteLine(RestartClient, EncodeClient(ClientMessage.Interact), Token)));
  var LoadedExitRead: LineRead := Unwrap(ReadLine(RestartReader, Token));
  RestartReader := LoadedExitRead.Reader;
  case Unwrap(DecodeServer(LoadedExitRead.Line)) of
    ServerMessage.State(Value):
    begin
      var MapValue: MapVisibleState := RequireMap(Value);
      AssertEquals(Metadata.Entrance.X, MapValue.WorldX);
      AssertEquals(Metadata.Entrance.Y, MapValue.WorldY);
      AssertEquals(1, Std.Arrays.Length(MapValue.Inventory));
      AssertEquals(InitialDungeonItemId, MapValue.Inventory[0].Id)
    end
    else
    begin
      panic('expected loaded interior to return to saved outdoor location')
    end
  end;

  AssertTrue(Unwrap(WriteLine(RestartClient, EncodeClient(ClientMessage.SaveGame), Token)));
  var OutdoorSavedRead: LineRead := Unwrap(ReadLine(RestartReader, Token));
  RestartReader := OutdoorSavedRead.Reader;
  case Unwrap(DecodeServer(OutdoorSavedRead.Line)) of
    ServerMessage.SaveCompleted:
    begin
    end
    else
    begin
      panic('expected outdoor save completion after leaving loaded interior')
    end
  end;

  AssertTrue(Unwrap(WriteLine(RestartClient, EncodeClient(ClientMessage.Disconnect), Token)));
  AssertTrue(Unwrap(Close(RestartClient)));
  AssertTrue(Unwrap(Wait(RestartTask)));
  AssertTrue(Unwrap(CloseListener(RestartListener)));
  var OutdoorRestartListener: Listener := Unwrap(Listen('127.0.0.1', 0));
  var OutdoorRestartAddress: NetworkAddress := Unwrap(ListenerLocalAddress(OutdoorRestartListener));
  var OutdoorRestartTask: task := go ServeOne(OutdoorRestartListener, Config, Token);
  var OutdoorRestartClient: Connection := Unwrap(Connect('127.0.0.1', OutdoorRestartAddress.Port, 5000));
  AssertTrue(Unwrap(SetTimeout(OutdoorRestartClient, 120000)));
  mutable var OutdoorRestartReader: LineReader := NewLineReader(OutdoorRestartClient);
  AssertTrue(Unwrap(WriteLine(OutdoorRestartClient, EncodeClient(ClientMessage.Hello(ProtocolVersion, 13, 7)), Token)));
  var OutdoorRestartWelcome: LineRead := Unwrap(ReadLine(OutdoorRestartReader, Token));
  OutdoorRestartReader := OutdoorRestartWelcome.Reader;
  case Unwrap(DecodeServer(OutdoorRestartWelcome.Line)) of
    ServerMessage.Welcome(Version, SaveAvailable, InvalidSaveRemoved):
    begin
      AssertEquals(ProtocolVersion, Version);
      AssertTrue(SaveAvailable);
      AssertFalse(InvalidSaveRemoved)
    end
    else
    begin
      panic('expected outdoor restart welcome with saved-game availability')
    end
  end;

  AssertTrue(Unwrap(WriteLine(OutdoorRestartClient, EncodeClient(ClientMessage.LoadGame), Token)));
  var OutdoorRestartState: LineRead := Unwrap(ReadLine(OutdoorRestartReader, Token));
  OutdoorRestartReader := OutdoorRestartState.Reader;
  case Unwrap(DecodeServer(OutdoorRestartState.Line)) of
    ServerMessage.State(Value):
    begin
      var MapValue: MapVisibleState := RequireMap(Value);
      AssertEquals(Metadata.Entrance.X, MapValue.WorldX);
      AssertEquals(Metadata.Entrance.Y, MapValue.WorldY);
      AssertEquals(1, Std.Arrays.Length(MapValue.Inventory));
      AssertEquals(InitialDungeonItemId, MapValue.Inventory[0].Id)
    end
    else
    begin
      panic('expected exact saved outdoor position after another server restart')
    end
  end;

  AssertTrue(Unwrap(WriteLine(OutdoorRestartClient, EncodeClient(ClientMessage.ExplorationMap(Metadata.Spawn.X -
                                                                                              8, Metadata.Spawn.Y -
                                                                                                 8, 17, 17)), Token)));
  var OutdoorMapRead: LineRead := Unwrap(ReadLine(OutdoorRestartReader, Token));
  OutdoorRestartReader := OutdoorMapRead.Reader;
  case Unwrap(DecodeServer(OutdoorMapRead.Line)) of
    ServerMessage.ExplorationMap(Value):
    begin
      mutable var HasRemembered: boolean := false;
      for KnowledgeRow: string in Value.KnowledgeRows do
      begin
        if Std.Str.Contains(KnowledgeRow, 'r') then
        begin
          HasRemembered := true
        end
      end;

      AssertTrue(HasRemembered);
      AssertEquals(Metadata.Entrance.X, Value.PlayerWorldX);
      AssertEquals(Metadata.Entrance.Y, Value.PlayerWorldY)
    end
    else
    begin
      panic('expected persisted outdoor discovery after restart')
    end
  end;

  AssertTrue(Unwrap(WriteLine(OutdoorRestartClient, EncodeClient(ClientMessage.Disconnect), Token)));
  AssertTrue(Unwrap(Close(OutdoorRestartClient)));
  AssertTrue(Unwrap(Wait(OutdoorRestartTask)));
  AssertTrue(Unwrap(CloseListener(OutdoorRestartListener)));
  var SavedWorld: WorldSession := Unwrap(OpenWorld(Config.WorldsRoot, Config.WorldId, Config.WorldSeed, Config.ChunkCacheLimit));
  var SavePath: string := SaveGamePath(SavedWorld);
  var SavedBeforeNewGame: string := Unwrap(Std.Fs.ReadText(SavePath));
  var NewGameListener: Listener := Unwrap(Listen('127.0.0.1', 0));
  var NewGameAddress: NetworkAddress := Unwrap(ListenerLocalAddress(NewGameListener));
  var NewGameTask: task := go ServeOne(NewGameListener, Config, Token);
  var NewGameClient: Connection := Unwrap(Connect('127.0.0.1', NewGameAddress.Port, 5000));
  AssertTrue(Unwrap(SetTimeout(NewGameClient, 120000)));
  mutable var NewGameReader: LineReader := NewLineReader(NewGameClient);
  AssertTrue(Unwrap(WriteLine(NewGameClient, EncodeClient(ClientMessage.Hello(ProtocolVersion, 13, 7)), Token)));
  var NewGameWelcome: LineRead := Unwrap(ReadLine(NewGameReader, Token));
  NewGameReader := NewGameWelcome.Reader;
  case Unwrap(DecodeServer(NewGameWelcome.Line)) of
    ServerMessage.Welcome(Version, SaveAvailable, InvalidSaveRemoved):
    begin
      AssertEquals(ProtocolVersion, Version);
      AssertTrue(SaveAvailable);
      AssertFalse(InvalidSaveRemoved)
    end
    else
    begin
      panic('expected existing save before starting a separate new game')
    end
  end;

  AssertTrue(Unwrap(WriteLine(NewGameClient, EncodeClient(ClientMessage.StartNewGame), Token)));
  var NewGameStateRead: LineRead := Unwrap(ReadLine(NewGameReader, Token));
  NewGameReader := NewGameStateRead.Reader;
  case Unwrap(DecodeServer(NewGameStateRead.Line)) of
    ServerMessage.State(Value):
    begin
      var MapValue: MapVisibleState := RequireMap(Value);
      AssertEquals(Metadata.Spawn.X, MapValue.WorldX);
      AssertEquals(Metadata.Spawn.Y, MapValue.WorldY)
    end
    else
    begin
      panic('expected independent new-game state while a save exists')
    end
  end;

  AssertTrue(Unwrap(WriteLine(NewGameClient, EncodeClient(ClientMessage.Disconnect), Token)));
  AssertTrue(Unwrap(Close(NewGameClient)));
  AssertTrue(Unwrap(Wait(NewGameTask)));
  AssertTrue(Unwrap(CloseListener(NewGameListener)));
  AssertEquals(SavedBeforeNewGame, Unwrap(Std.Fs.ReadText(SavePath)));
  var KeepPath: string := Std.Path.Join([SavedWorld.Directory, 'saves', 'keep.txt']);
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(KeepPath, 'keep')));
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(SavePath, '{"format_version":2,"world_id":"loopback","area_kind":"outdoor_region","area_id":"loopback:outdoor","player":{"kind":"outdoor","x":0,"y":0},"return_location":{"kind":"none"},"exploration":{"outdoor_chunks":[{"chunk_x":0,"chunk_y":0,"rows":["1"]}],"interior_areas":[]}}')));
  var InvalidListener: Listener := Unwrap(Listen('127.0.0.1', 0));
  var InvalidAddress: NetworkAddress := Unwrap(ListenerLocalAddress(InvalidListener));
  var InvalidTask: task := go ServeOne(InvalidListener, Config, Token);
  var InvalidClient: Connection := Unwrap(Connect('127.0.0.1', InvalidAddress.Port, 5000));
  AssertTrue(Unwrap(SetTimeout(InvalidClient, 120000)));
  mutable var InvalidReader: LineReader := NewLineReader(InvalidClient);
  AssertTrue(Unwrap(WriteLine(InvalidClient, EncodeClient(ClientMessage.Hello(ProtocolVersion, 13, 7)), Token)));
  var InvalidWelcome: LineRead := Unwrap(ReadLine(InvalidReader, Token));
  InvalidReader := InvalidWelcome.Reader;
  case Unwrap(DecodeServer(InvalidWelcome.Line)) of
    ServerMessage.Welcome(Version, SaveAvailable, InvalidSaveRemoved):
    begin
      AssertEquals(ProtocolVersion, Version);
      AssertFalse(SaveAvailable);
      AssertTrue(InvalidSaveRemoved)
    end
    else
    begin
      panic('expected invalid-save removal in welcome')
    end
  end;

  AssertFalse(Std.Fs.Exists(SavePath));
  AssertEquals(MetadataBefore, Unwrap(Std.Fs.ReadText(MetadataPath)));
  AssertEquals(ChunkBefore, Unwrap(Std.Fs.ReadText(ChunkPath)));
  AssertEquals('keep', Unwrap(Std.Fs.ReadText(KeepPath)));
  AssertTrue(Unwrap(WriteLine(InvalidClient, EncodeClient(ClientMessage.LoadGame), Token)));
  var MissingRead: LineRead := Unwrap(ReadLine(InvalidReader, Token));
  InvalidReader := MissingRead.Reader;
  case Unwrap(DecodeServer(MissingRead.Line)) of
    ServerMessage.Rejected(Code, Message):
    begin
      AssertEquals('save_unavailable', Code)
    end
    else
    begin
      panic('expected load to remain unavailable after removal')
    end
  end;

  AssertTrue(Unwrap(WriteLine(InvalidClient, EncodeClient(ClientMessage.StartNewGame), Token)));
  var FreshStateRead: LineRead := Unwrap(ReadLine(InvalidReader, Token));
  InvalidReader := FreshStateRead.Reader;
  case Unwrap(DecodeServer(FreshStateRead.Line)) of
    ServerMessage.State(Value):
    begin
      var MapValue: MapVisibleState := RequireMap(Value);
      AssertEquals(Metadata.Spawn.X, MapValue.WorldX);
      AssertEquals(Metadata.Spawn.Y, MapValue.WorldY)
    end
    else
    begin
      panic('expected a fresh outdoor state after invalid-save removal')
    end
  end;

  AssertTrue(Unwrap(WriteLine(InvalidClient, EncodeClient(ClientMessage.SaveGame), Token)));
  var FreshSavedRead: LineRead := Unwrap(ReadLine(InvalidReader, Token));
  InvalidReader := FreshSavedRead.Reader;
  case Unwrap(DecodeServer(FreshSavedRead.Line)) of
    ServerMessage.SaveCompleted:
    begin
    end
    else
    begin
      panic('expected a fresh save after invalid-save removal')
    end
  end;

  AssertTrue(Unwrap(WriteLine(InvalidClient, EncodeClient(ClientMessage.Disconnect), Token)));
  AssertTrue(Unwrap(Close(InvalidClient)));
  AssertTrue(Unwrap(Wait(InvalidTask)));
  AssertTrue(Unwrap(CloseListener(InvalidListener)));
  var FreshRestartListener: Listener := Unwrap(Listen('127.0.0.1', 0));
  var FreshRestartAddress: NetworkAddress := Unwrap(ListenerLocalAddress(FreshRestartListener));
  var FreshRestartTask: task := go ServeOne(FreshRestartListener, Config, Token);
  var FreshRestartClient: Connection := Unwrap(Connect('127.0.0.1', FreshRestartAddress.Port, 5000));
  AssertTrue(Unwrap(SetTimeout(FreshRestartClient, 120000)));
  mutable var FreshRestartReader: LineReader := NewLineReader(FreshRestartClient);
  AssertTrue(Unwrap(WriteLine(FreshRestartClient, EncodeClient(ClientMessage.Hello(ProtocolVersion, 13, 7)), Token)));
  var FreshRestartWelcome: LineRead := Unwrap(ReadLine(FreshRestartReader, Token));
  FreshRestartReader := FreshRestartWelcome.Reader;
  case Unwrap(DecodeServer(FreshRestartWelcome.Line)) of
    ServerMessage.Welcome(Version, SaveAvailable, InvalidSaveRemoved):
    begin
      AssertEquals(ProtocolVersion, Version);
      AssertTrue(SaveAvailable);
      AssertFalse(InvalidSaveRemoved)
    end
    else
    begin
      panic('expected fresh save availability after restart')
    end
  end;

  AssertTrue(Unwrap(WriteLine(FreshRestartClient, EncodeClient(ClientMessage.LoadGame), Token)));
  var FreshLoadedRead: LineRead := Unwrap(ReadLine(FreshRestartReader, Token));
  FreshRestartReader := FreshLoadedRead.Reader;
  case Unwrap(DecodeServer(FreshLoadedRead.Line)) of
    ServerMessage.State(Value):
    begin
      var MapValue: MapVisibleState := RequireMap(Value);
      AssertEquals(Metadata.Spawn.X, MapValue.WorldX);
      AssertEquals(Metadata.Spawn.Y, MapValue.WorldY)
    end
    else
    begin
      panic('expected fresh save to load after restart')
    end
  end;

  AssertTrue(Unwrap(WriteLine(FreshRestartClient, EncodeClient(ClientMessage.Disconnect), Token)));
  AssertTrue(Unwrap(Close(FreshRestartClient)));
  AssertTrue(Unwrap(Wait(FreshRestartTask)));
  AssertTrue(Unwrap(CloseListener(FreshRestartListener)));
  AssertEquals(MetadataBefore, Unwrap(Std.Fs.ReadText(MetadataPath)));
  AssertEquals(ChunkBefore, Unwrap(Std.Fs.ReadText(ChunkPath)));
  AssertEquals('keep', Unwrap(Std.Fs.ReadText(KeepPath)))
end.
