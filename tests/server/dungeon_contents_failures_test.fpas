// Verifies incompatible content and inert potion/save failures through production TCP sessions without repairing files.
program DungeonContentsFailuresTest;

uses Dungeon.GameState as GameState, Dungeon.Items as Items, Dungeon.Protocol as Protocol, Dungeon.Protocol.ServerMessages as Messages, Dungeon.Server as Server, Dungeon.Server.Config as ConfigUnit, Dungeon.Server.Logging as Logging, Dungeon.Terrain.Entrances as Entrances, Dungeon.Test.Levels as Levels, Dungeon.Test.Wire as Wire, Dungeon.World as WorldUnit, Dungeon.World.Savegame as Savegame, Std.Conv as Conv, Std.Fs as Fs, Std.Net as Net, Std.Tasks as Tasks, Std.Test as Test, Std.Time as Time;

function ServeOne(Listener: Net.Listener; Config: ConfigUnit.ServerConfig; Token: Tasks.CancellationToken): result of (boolean, string);
begin
  const Connection := try Net.AcceptWithCancellation(Listener, Token);
  const Served := Server.ServeConnection(Connection, Config, Token);
  const Closed := try Net.Close(Connection);
  return Served;
end function;

procedure Rejected(Client: Wire.WireClient; Expected: string);
begin
  case Client.Last of
    when Protocol.ServerMessage.Rejected(const Code, const Reason):
      Test.AssertEquals(Expected, Code);
      Test.AssertTrue(Reason.Length() > 0);
    when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.ErrorMessage(_, _):
      panic('expected classified rejection, got ' + Messages.EncodeServer(Client.Last));
  end case;
end procedure;

begin
  const Root := '.temp-data/contents-failures-' + Conv.IntToStr(Time.TimestampMillis());
  const World := WorldUnit.OpenWorld(Root, 'failures', 12345, 4, 32).Unwrap();
  const Map := Levels.SpawnLevel(World);
  var State := Levels.EnterSpawnLevel(World, GameState.NewGame(World.Metadata)).Unwrap();
  State.Items[3] := State.Items[3] with Location := Items.ItemLocation.CarriedByPlayer; end with;

  for Index: integer := 0 to State.Hostiles.Length() - 1 do
    State.Hostiles[Index] := State.Hostiles[Index] with Health := 0; end with;
  end for;

  Test.AssertTrue(Savegame.WriteSaveGame(World, State).Unwrap());
  const SavePath := Savegame.SaveGamePath(World);
  const SaveText := Fs.ReadText(SavePath).Unwrap();
  const MetadataPath := WorldUnit.WorldMetadataPath(World);
  const MetadataText := Fs.ReadText(MetadataPath).Unwrap();
  const Region := Entrances.RegionOf(World.Metadata, World.Metadata.Spawn);
  const LevelPath := World.Directory + '/dungeons/' + Conv.IntToStr(Region.X) + '_' +
    Conv.IntToStr(Region.Y) + '/0.json';
  const LevelText := Fs.ReadText(LevelPath).Unwrap();
  const Logs: channel of Logging.ServerLogEvent := Tasks.CreateChannel(256);
  const Config := ConfigUnit.ServerConfig(
    ConfigPath := '', Logs := Some(Logs), WorldsRoot := Root, WorldId := World.Metadata.Id,
    WorldSeed := 12345, DungeonRegionChunks := 4, ChunkCacheLimit := 32,
    MaximumViewWidth := 240, MaximumViewHeight := 120
  );
  const Token := Tasks.GetCancellationToken(Tasks.CreateCancellationSource());
  const Listener := Net.Listen('127.0.0.1', 0).Unwrap();
  const Port := Net.ListenerLocalAddress(Listener).Unwrap().Port;
  // Old world formats/generators, old level formats/generators and old saves are preserved intact.
  for Variant: integer := 0 to 4 do
    var Expected := 'save_incompatible';
    var WorldBytes := MetadataText;
    var LevelBytes := LevelText;
    var SaveBytes := SaveText;
    if Variant = 0 then
      WorldBytes := MetadataText.Replace('"version":3', '"version":2');
    end if;

    if Variant = 1 then
      WorldBytes := MetadataText.Replace('"generator_version":7', '"generator_version":6');
    end if;

    if Variant = 2 then
      LevelBytes := LevelText.Replace('"format_version":2', '"format_version":1');
    end if;

    if Variant = 3 then
      LevelBytes := LevelText.Replace('"generator_version":7', '"generator_version":6');
    end if;

    if Variant = 4 then
      SaveBytes := SaveText.Replace('"format_version":9', '"format_version":8');
    end if;

    Test.AssertTrue(
      (WorldBytes <> MetadataText) or (LevelBytes <> LevelText) or (SaveBytes <> SaveText)
    );
    Test.AssertTrue(Fs.WriteTextAtomic(MetadataPath, WorldBytes).Unwrap());
    Test.AssertTrue(Fs.WriteTextAtomic(LevelPath, LevelBytes).Unwrap());
    Test.AssertTrue(Fs.WriteTextAtomic(SavePath, SaveBytes).Unwrap());
    scope
      const Worker := go ServeOne(Listener, Config, Token);
      var Client := Wire.ConnectClient(Port, Token);
      Test.AssertTrue(Client.Last is Protocol.ServerMessage.Welcome(15, _));
      if Variant < 2 then
        Client := Wire.Exchange(
          Client,
          Protocol.ClientMessage.SelectWorld(World.Metadata.Id),
          Token
        );
        Rejected(Client, 'world_incompatible');
        Expected := 'world_unavailable';
      elsif Variant < 4 then
        Expected := 'world_data_error';
      end if;

      Client := Wire.Exchange(Client, Protocol.ClientMessage.LoadGame, Token);
      Rejected(Client, Expected);
      Client := Wire.Exchange(Client, Protocol.ClientMessage.Viewport(20, 10), Token);
      Rejected(Client, 'session_not_started');
      Wire.CloseClient(Client, Token);
      Test.AssertTrue(Tasks.Wait(Worker).Unwrap());
    end scope;

    Test.AssertEquals(WorldBytes, Fs.ReadText(MetadataPath).Unwrap());
    Test.AssertEquals(LevelBytes, Fs.ReadText(LevelPath).Unwrap());
    Test.AssertEquals(SaveBytes, Fs.ReadText(SavePath).Unwrap());
  end for;

  Test.AssertTrue(Fs.WriteTextAtomic(MetadataPath, MetadataText).Unwrap());
  Test.AssertTrue(Fs.WriteTextAtomic(LevelPath, LevelText).Unwrap());
  Test.AssertTrue(Fs.WriteTextAtomic(SavePath, SaveText).Unwrap());
  scope
    const Worker := go ServeOne(Listener, Config, Token);
    var Client := Wire.Exchange(
      Wire.ConnectClient(Port, Token),
      Protocol.ClientMessage.LoadGame,
      Token
    );
    const Before := Messages.EncodeServer(Client.Last);
    Test.AssertEquals(20, Wire.FirstPersonOf(Client).Health);
    Test.AssertTrue(Wire.FirstPersonOf(Client).Inventory[0].Usable);
    for Id: string in [Map.Items[3].ItemId, 'foreign:dungeon:0:0:item:3'] do
      Client := Wire.Exchange(Client, Protocol.ClientMessage.UseItem(Id), Token);
      Rejected(Client, 'item_use_rejected');
      Client := Wire.Exchange(Client, Protocol.ClientMessage.Viewport(20, 10), Token);
      Test.AssertEquals(Before, Messages.EncodeServer(Client.Last));
    end for;

    // Make the game dirty, then break its referenced level: failed save retains installed state and old save.
    Client := Wire.Exchange(Client, Protocol.ClientMessage.Wait, Token);
    Test.AssertTrue(
      Fs.WriteTextAtomic(
        LevelPath,
        LevelText.Replace('"format_version":2', '"format_version":1')
      ).Unwrap()
    );
    Client := Wire.Exchange(Client, Protocol.ClientMessage.OverwriteSaveGame, Token);
    Rejected(Client, 'world_data_error');
    Client := Wire.Exchange(Client, Protocol.ClientMessage.ListWorlds(0, false), Token);
    Rejected(Client, 'discard_required');
    Client := Wire.Exchange(Client, Protocol.ClientMessage.Viewport(20, 10), Token);
    Test.AssertEquals(Before, Messages.EncodeServer(Client.Last));
    Test.AssertEquals(SaveText, Fs.ReadText(SavePath).Unwrap());
    Test.AssertEquals(
      LevelText.Replace('"format_version":2', '"format_version":1'),
      Fs.ReadText(LevelPath).Unwrap()
    );
    Test.AssertTrue(Fs.WriteTextAtomic(LevelPath, LevelText).Unwrap());
    Wire.RequireSaved(Wire.Exchange(Client, Protocol.ClientMessage.OverwriteSaveGame, Token));
    const After := Levels.DecodeStoredSave(World, Fs.ReadText(SavePath).Unwrap()).Unwrap();
    Test.AssertEquals(State.RandomState, After.RandomState);
    Test.AssertEquals(State.Health, After.Health);
    for Index: integer := 0 to State.Items.Length() - 1 do
      Test.AssertTrue(State.Items[Index] = After.Items[Index]);
    end for;

    Wire.CloseClient(Client, Token);
    Test.AssertTrue(Tasks.Wait(Worker).Unwrap());
  end scope;

  Test.AssertEquals(MetadataText, Fs.ReadText(MetadataPath).Unwrap());
  Test.AssertEquals(LevelText, Fs.ReadText(LevelPath).Unwrap());
  Test.AssertTrue(Net.CloseListener(Listener).Unwrap());
  Test.AssertTrue(Tasks.CloseChannel(Logs));
end.
