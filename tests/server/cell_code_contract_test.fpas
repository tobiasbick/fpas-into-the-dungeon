// Verifies that every cell code produced by the game rules belongs to the protocol wire alphabet.
program CellCodeContractTest;

uses
  Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interior, Dungeon.Interior.InitialDungeon,
  Dungeon.Items, Dungeon.Protocol, Dungeon.Terrain, Dungeon.Terrain.Placement, Std.Results,
  Std.Test;

function WorldCellOf(Base: BaseTerrainKind; Feature: TerrainFeatureKind; Water: WaterKind): WorldCell;
begin
  return record
    Base := Base;
    Feature := Feature;
    Water := Water;
  end
end;

begin
  var Bases: array of BaseTerrainKind := [
                                           BaseTerrainKind.Grass,
                                           BaseTerrainKind.Sand,
                                           BaseTerrainKind.Rock,
                                           BaseTerrainKind.Water
                                         ];
  var Features: array of TerrainFeatureKind := [
                                                 TerrainFeatureKind.NoFeature,
                                                 TerrainFeatureKind.Tree,
                                                 TerrainFeatureKind.Forest,
                                                 TerrainFeatureKind.Path,
                                                 TerrainFeatureKind.River,
                                                 TerrainFeatureKind.Entrance
                                               ];
  var Waters: array of WaterKind := [
                                      WaterKind.NoWater,
                                      WaterKind.Sea,
                                      WaterKind.Lake,
                                      WaterKind.RiverWater
                                    ];
  for Base: BaseTerrainKind in Bases do
  begin
    for Feature: TerrainFeatureKind in Features do
    begin
      for Water: WaterKind in Waters do
      begin
        AssertTrue(IsMapCellCode(VisibleCellCode(WorldCellOf(Base, Feature, Water))))
      end
    end
  end;

  // Spot-check the named mapping so a swapped code cannot pass as merely valid.
  AssertEquals(MapGrassCode, VisibleCellCode(WorldCellOf(BaseTerrainKind.Grass, TerrainFeatureKind.NoFeature, WaterKind.NoWater)));
  AssertEquals(MapDesertCode, VisibleCellCode(WorldCellOf(BaseTerrainKind.Sand, TerrainFeatureKind.NoFeature, WaterKind.NoWater)));
  AssertEquals(MapMountainCode, VisibleCellCode(WorldCellOf(BaseTerrainKind.Rock, TerrainFeatureKind.NoFeature, WaterKind.NoWater)));
  AssertEquals(MapTreeCode, VisibleCellCode(WorldCellOf(BaseTerrainKind.Grass, TerrainFeatureKind.Tree, WaterKind.NoWater)));
  AssertEquals(MapForestCode, VisibleCellCode(WorldCellOf(BaseTerrainKind.Grass, TerrainFeatureKind.Forest, WaterKind.NoWater)));
  AssertEquals(MapPathCode, VisibleCellCode(WorldCellOf(BaseTerrainKind.Grass, TerrainFeatureKind.Path, WaterKind.NoWater)));
  AssertEquals(MapEntranceCode, VisibleCellCode(WorldCellOf(BaseTerrainKind.Grass, TerrainFeatureKind.Entrance, WaterKind.NoWater)));
  AssertEquals(MapRiverCode, VisibleCellCode(WorldCellOf(BaseTerrainKind.Water, TerrainFeatureKind.River, WaterKind.RiverWater)));
  AssertEquals(MapSeaCode, VisibleCellCode(WorldCellOf(BaseTerrainKind.Water, TerrainFeatureKind.NoFeature, WaterKind.Sea)));
  AssertEquals(MapLakeCode, VisibleCellCode(WorldCellOf(BaseTerrainKind.Water, TerrainFeatureKind.NoFeature, WaterKind.Lake)));
  AssertEquals(InteriorWallCode, InteriorCellCode(InteriorCellKind.Wall));
  AssertEquals(InteriorFloorCode, InteriorCellCode(InteriorCellKind.Floor));
  AssertEquals(InteriorExitCode, InteriorCellCode(InteriorCellKind.ExitField));
  // Dynamic overlays of the initial dungeon: tablet, items, and NPC.
  var Metadata: WorldMetadata := Unwrap(NewWorldMetadata('cell-code-contract', 12345));
  var Map: InteriorMap := Unwrap(InitialDungeonMap());
  var Dungeon: GameState := NewGame(Metadata) with Area := AreaKind.Dungeon; AreaId := Metadata.DungeonAreaId; end;

  AssertEquals(InteriorTabletCode, Unwrap(InteriorVisibleCode(Map, Map.Tablet)));
  AssertEquals(InteriorItemCode, Unwrap(InteriorVisibleCodeForState(Map, Dungeon, Unwrap(InitialItemPosition(Map, InitialDungeonItemId)))));
  AssertEquals(InteriorWeaponCode, Unwrap(InteriorVisibleCodeForState(Map, Dungeon, Unwrap(InitialItemPosition(Map, RustyShortSwordId)))));
  AssertEquals(InteriorArmorCode, Unwrap(InteriorVisibleCodeForState(Map, Dungeon, Unwrap(InitialItemPosition(Map, LeatherJerkinId)))));
  AssertEquals(InteriorNpcCode, Unwrap(InteriorVisibleCodeForState(Map, Dungeon, Map.Npc)));
  for Y: integer := 0 to Map.Height - 1 do
  begin
    for X: integer := 0 to Map.Width - 1 do
    begin
      AssertTrue(IsInteriorCellCode(Unwrap(InteriorVisibleCodeForState(Map, Dungeon, record
        X := X;
        Y := Y;
      end))))
    end
  end
end.
