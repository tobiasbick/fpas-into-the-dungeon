// Verifies that every cell code produced by the game rules belongs to the protocol wire alphabet.
program CellCodeContractTest;

uses Dungeon.Test.Fixtures as Fixtures, Dungeon.Areas as Areas, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Interior as InteriorUnit, Dungeon.Items as ItemRules, Dungeon.Protocol as Protocol, Dungeon.Terrain as Terrain, Dungeon.Terrain.Placement as PlacementRules, Std.Test as Test;

function WorldCellOf(Base: Terrain.BaseTerrainKind; Feature: Terrain.TerrainFeatureKind; Water: Terrain.WaterKind): Terrain.WorldCell;
begin
  return Terrain.WorldCell(Base := Base, Feature := Feature, Water := Water);
end function;

begin
  const Bases: array of Terrain.BaseTerrainKind := [
    Terrain.BaseTerrainKind.Grass,
    Terrain.BaseTerrainKind.Sand,
    Terrain.BaseTerrainKind.Rock,
    Terrain.BaseTerrainKind.Water
  ];
  const Features: array of Terrain.TerrainFeatureKind := [
    Terrain.TerrainFeatureKind.NoFeature,
    Terrain.TerrainFeatureKind.Tree,
    Terrain.TerrainFeatureKind.Forest,
    Terrain.TerrainFeatureKind.Path,
    Terrain.TerrainFeatureKind.River,
    Terrain.TerrainFeatureKind.Entrance
  ];
  const Waters: array of Terrain.WaterKind := [
    Terrain.WaterKind.NoWater,
    Terrain.WaterKind.Sea,
    Terrain.WaterKind.Lake,
    Terrain.WaterKind.RiverWater
  ];
  for Base: Terrain.BaseTerrainKind in Bases do
    begin
      for Feature: Terrain.TerrainFeatureKind in Features do
        begin
          for Water: Terrain.WaterKind in Waters do
            begin
              Test.AssertTrue(
                Protocol.IsMapCellCode(Terrain.VisibleCellCode(WorldCellOf(Base, Feature, Water)))
              );
            end;
          end for;
        end;
      end for;
    end;
  end for;

  // Spot-check the named mapping so a swapped code cannot pass as merely valid.
  Test.AssertEquals(
    Protocol.MapGrassCode,
    Terrain.VisibleCellCode(
      WorldCellOf(
        Terrain.BaseTerrainKind.Grass,
        Terrain.TerrainFeatureKind.NoFeature,
        Terrain.WaterKind.NoWater
      )
    )
  );
  Test.AssertEquals(
    Protocol.MapDesertCode,
    Terrain.VisibleCellCode(
      WorldCellOf(
        Terrain.BaseTerrainKind.Sand,
        Terrain.TerrainFeatureKind.NoFeature,
        Terrain.WaterKind.NoWater
      )
    )
  );
  Test.AssertEquals(
    Protocol.MapMountainCode,
    Terrain.VisibleCellCode(
      WorldCellOf(
        Terrain.BaseTerrainKind.Rock,
        Terrain.TerrainFeatureKind.NoFeature,
        Terrain.WaterKind.NoWater
      )
    )
  );
  Test.AssertEquals(
    Protocol.MapTreeCode,
    Terrain.VisibleCellCode(
      WorldCellOf(
        Terrain.BaseTerrainKind.Grass,
        Terrain.TerrainFeatureKind.Tree,
        Terrain.WaterKind.NoWater
      )
    )
  );
  Test.AssertEquals(
    Protocol.MapForestCode,
    Terrain.VisibleCellCode(
      WorldCellOf(
        Terrain.BaseTerrainKind.Grass,
        Terrain.TerrainFeatureKind.Forest,
        Terrain.WaterKind.NoWater
      )
    )
  );
  Test.AssertEquals(
    Protocol.MapPathCode,
    Terrain.VisibleCellCode(
      WorldCellOf(
        Terrain.BaseTerrainKind.Grass,
        Terrain.TerrainFeatureKind.Path,
        Terrain.WaterKind.NoWater
      )
    )
  );
  Test.AssertEquals(
    Protocol.MapEntranceCode,
    Terrain.VisibleCellCode(
      WorldCellOf(
        Terrain.BaseTerrainKind.Grass,
        Terrain.TerrainFeatureKind.Entrance,
        Terrain.WaterKind.NoWater
      )
    )
  );
  Test.AssertEquals(
    Protocol.MapRiverCode,
    Terrain.VisibleCellCode(
      WorldCellOf(
        Terrain.BaseTerrainKind.Water,
        Terrain.TerrainFeatureKind.River,
        Terrain.WaterKind.RiverWater
      )
    )
  );
  Test.AssertEquals(
    Protocol.MapSeaCode,
    Terrain.VisibleCellCode(
      WorldCellOf(
        Terrain.BaseTerrainKind.Water,
        Terrain.TerrainFeatureKind.NoFeature,
        Terrain.WaterKind.Sea
      )
    )
  );
  Test.AssertEquals(
    Protocol.MapLakeCode,
    Terrain.VisibleCellCode(
      WorldCellOf(
        Terrain.BaseTerrainKind.Water,
        Terrain.TerrainFeatureKind.NoFeature,
        Terrain.WaterKind.Lake
      )
    )
  );
  Test.AssertEquals(
    Protocol.InteriorWallCode,
    InteriorUnit.InteriorCellCode(InteriorUnit.InteriorCellKind.Wall)
  );
  Test.AssertEquals(
    Protocol.InteriorFloorCode,
    InteriorUnit.InteriorCellCode(InteriorUnit.InteriorCellKind.Floor)
  );
  Test.AssertEquals(
    Protocol.InteriorExitCode,
    InteriorUnit.InteriorCellCode(InteriorUnit.InteriorCellKind.ExitField)
  );
  Test.AssertFalse(Protocol.IsInteriorCellCode('t'));
  // Dynamic overlays of the initial dungeon: items and opponents.
  const Metadata: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
    'cell-code-contract',
    12345,
    4
  ).Unwrap();
  const Map: InteriorUnit.InteriorMap := Fixtures.FixtureDungeonMapFor(
    Fixtures.SpawnDungeonAreaId(Metadata)
  );
  const Dungeon: GameState.GameState := Areas.MaterializeArea(GameState.NewGame(Metadata), Map) with Area := Coordinates.AreaKind.Dungeon; AreaId := Fixtures.SpawnDungeonAreaId(
    Metadata
  ); end with;

  Test.AssertEquals(
    Protocol.InteriorWallCode,
    InteriorUnit.InteriorVisibleCode(Map, Coordinates.InteriorPosition(X := 9, Y := 0)).Unwrap()
  );
  Test.AssertEquals(
    Protocol.InteriorItemCode,
    GameState.InteriorVisibleCodeForState(Map, Dungeon, Map.Items[0].Position).Unwrap()
  );
  Test.AssertEquals(
    Protocol.InteriorWeaponCode,
    GameState.InteriorVisibleCodeForState(Map, Dungeon, Map.Items[1].Position).Unwrap()
  );
  Test.AssertEquals(
    Protocol.InteriorArmorCode,
    GameState.InteriorVisibleCodeForState(Map, Dungeon, Map.Items[2].Position).Unwrap()
  );
  for Y: integer := 0 to Map.Height - 1 do
    begin
      for X: integer := 0 to Map.Width - 1 do
        begin
          Test.AssertTrue(
            Protocol.IsInteriorCellCode(
              GameState.InteriorVisibleCodeForState(
                Map,
                Dungeon,
                Coordinates.InteriorPosition(X := X, Y := Y)
              ).Unwrap()
            )
          );
        end;
      end for;
    end;
  end for;
end.
