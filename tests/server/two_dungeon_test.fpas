// Carries an item between two generated dungeons over TCP, across a server restart, and back again.
// A deliberately edited but valid stored level proves that revisits read the file, not the generator.
program TwoDungeonTest;

uses
  Dungeon.Areas.Identities, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Hostiles,
  Dungeon.Interior, Dungeon.Interior.Generation, Dungeon.Items, Dungeon.Protocol, Dungeon.Server,
  Dungeon.Server.Config, Dungeon.Terrain, Dungeon.Terrain.Entrances, Dungeon.Terrain.Placement,
  Dungeon.Test.Fixtures, Dungeon.Test.Levels, Dungeon.Test.Routes, Dungeon.Test.Wire, Dungeon.World,
  Dungeon.World.Interiors.Encoding, Dungeon.World.Savegame, Std.Conv, Std.Fs, Std.Math, Std.Net,
  Std.Path, Std.Tasks, Std.Test, Std.Time;

// A second entrance site reachable on foot from the spawn entrance.
type SecondSite = record
  Region: RegionCoordinate;
  Site: WorldPosition;
  Route: array of WorldPosition;
end record;

function TestConfig(WorldsRoot: string): ServerConfig;
begin
  return ServerConfig(ConfigPath := '', Logs := None, WorldsRoot := WorldsRoot, WorldId := 'two-dungeons', WorldSeed := 9462, DungeonRegionChunks := 1, ChunkCacheLimit := 32, MaximumViewWidth := 240, MaximumViewHeight := 120);
end function;

function ServeOne(ListenerValue: Listener; Config: ServerConfig; Token: CancellationToken): result of (boolean, string);
begin
  const Client: Connection := try AcceptWithCancellation(ListenerValue, Token);
  const Configured: boolean := try SetTimeout(Client, 120000);
  const Outcome: result of (boolean, string) := ServeConnection(Client, Config, Token);
  const Closed: boolean := try Close(Client);
  return Outcome;
end function;

// Finds the nearest other entrance site, ring by ring around the spawn region, reachable on foot.
function FindSecondSite(Metadata: WorldMetadata): SecondSite;
begin
  const Spawn: RegionCoordinate := RegionOf(Metadata, Metadata.Spawn);
  for Ring: integer := 1 to 4 do
    begin
      for DeltaY: integer := - Ring to Ring do
        begin
          for DeltaX: integer := - Ring to Ring do
            begin
              if Std.Math.Max(Std.Math.Abs(DeltaX), Std.Math.Abs(DeltaY)) = Ring then
                begin
                  const Region: RegionCoordinate := RegionCoordinate(X := Spawn.X + DeltaX, Y := Spawn.Y +
                                                                                                 DeltaY);
                  if EntranceSite(Metadata, Region) is Some(const Site) then
                    begin
                      const Route: array of WorldPosition := OutdoorRoute(Metadata, Metadata.SpawnEntrance, Site, 16);
                      if Route.Length() > 0 then
                        begin
                          return SecondSite(Region := Region, Site := Site, Route := Route);
                        end;
                      end if;
                    end;
                  else
                    begin
                      null;
                    end;
                  end if;
                end;
              end if;
            end;
          end for;
        end;
      end for;
    end;
  end for;

  panic('no second entrance site is reachable near the spawn');
end function;

function Chebyshev(Left: InteriorPosition; Right: InteriorPosition): integer;
begin
  return Std.Math.Max(Std.Math.Abs(Left.X - Right.X), Std.Math.Abs(Left.Y - Right.Y));
end function;

// Picks an inner wall field next to a floor field, too far from the start to affect the sight rule.
// Opening it keeps the level structurally valid but makes it differ from generated output.
function EditableWall(Map: InteriorMap): array of InteriorPosition;
begin
  for Y: integer := 2 to Map.Height - 3 do
    begin
      for X: integer := 2 to Map.Width - 3 do
        begin
          const Wall: InteriorPosition := InteriorPosition(X := X, Y := Y);
          const Below: InteriorPosition := InteriorPosition(X := X, Y := Y + 1);
          if ((InteriorCellAt(Map, Wall).Unwrap() = InteriorCellKind.Wall) and (InteriorCellAt(Map, Below).Unwrap() = InteriorCellKind.Floor)) and
             ((Chebyshev(Wall, Map.Start) > 8) and (Chebyshev(Below, Map.Start) > 8)) then
            begin
              return [Wall, Below];
            end;
          end if;
        end;
      end for;
    end;
  end for;

  panic('no editable wall in the second dungeon');
end function;

function RowsJson(Map: InteriorMap): string;
begin
  var Text: string := '"rows":[';
  for Y: integer := 0 to Map.Height - 1 do
    begin
      var Row: string := '';
      for X: integer := 0 to Map.Width - 1 do
        begin
          Row := Row + InteriorCellCode(Map.Cells[(Y * Map.Width) + X]);
        end;
      end for;

      if Y > 0 then
        begin
          Text := Text + ',';
        end;
      end if;

      Text := ((Text + '"') + Row) + '"';
    end;
  end for;

  return Text + ']';
end function;

function ItemCount(State: GameState; Id: string): integer;
begin
  var Count: integer := 0;
  for Item: GameItem in State.Items do
    begin
      if Item.Id = Id then
        begin
          Count := Count + 1;
        end;
      end if;
    end;
  end for;

  return Count;
end function;

begin
  const WorldsRoot: string := '.temp-data/two-dungeons-' + IntToStr(TimestampMillis());
  AssertTrue(Std.Fs.CreateDirAll(WorldsRoot).Unwrap());
  const Config: ServerConfig := TestConfig(WorldsRoot);
  const Fixture: WorldSession := OpenWorld(Config.WorldsRoot, Config.WorldId, Config.WorldSeed, Config.DungeonRegionChunks, Config.ChunkCacheLimit)
                                   .Unwrap();
  const Metadata: WorldMetadata := NewWorldMetadata(Config.WorldId, Config.WorldSeed, 1).Unwrap();
  const First: InteriorMap := SpawnDungeonMap(Metadata);
  const Second: SecondSite := FindSecondSite(Metadata);
  const SecondId: string := DungeonAreaId(Metadata, Second.Region);
  const SecondMap: InteriorMap := GenerateDungeon(Metadata.Seed, Second.Region.X, Second.Region.Y, SecondId)
                                    .Unwrap();
  const Coin: ItemPlacement := First.Items[0];
  const Edit: array of InteriorPosition := EditableWall(SecondMap);
  const Token: CancellationToken := GetCancellationToken(CreateCancellationSource());
  const ListenerValue: Listener := Listen('127.0.0.1', 0).Unwrap();
  const Port: integer := ListenerLocalAddress(ListenerValue).Unwrap().Port;
  // First session: take the coin in the spawn dungeon, walk to the second dungeon, drop it there.
  const FirstServer: task := go ServeOne(ListenerValue, Config, Token);
  var Client: WireClient := Exchange(ConnectClient(Port, Token), ClientMessage.StartNewGame, Token);
  Client := Exchange(WalkOutdoors(Client, Metadata.SpawnEntrance, Token), ClientMessage.Interact, Token);
  Client := WalkTo(Client, First, Coin.Position, Token).Unwrap();
  Client := Exchange(Client, ClientMessage.Interact, Token);
  AssertEquals(Coin.ItemId, FirstPersonOf(Client).Inventory[0].Id);
  Client := WalkTo(Client, First, First.Exit, Token).Unwrap();
  Client := Exchange(Client, ClientMessage.Interact, Token);
  Client := Exchange(WalkOutdoorRoute(Client, Second.Route, Token), ClientMessage.Interact, Token);
  AssertEquals(SecondMap.Start.X, FirstPersonOf(Client).PlayerX);
  Client := Exchange(Client, ClientMessage.DropItem(Coin.ItemId), Token);
  AssertEquals(0, FirstPersonOf(Client).Inventory.Length());
  // Stand next to the wall that will be edited, facing it, and save there.
  Client := WalkTo(Client, SecondMap, Edit[1], Token).Unwrap();
  var Turns: integer := 0;
  while (not SamePosition(FieldAhead(FirstPersonOf(Client)), Edit[0])) and (Turns < 4) do
    begin
      Client := Exchange(Client, ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Right), Token);
      Turns := Turns + 1;
    end;
  end while;

  AssertEquals('#', FirstPersonOf(Client).Rows[Edit[0].Y].CharAt(Edit[0].X));
  RequireSaved(Exchange(Client, ClientMessage.SaveGame, Token));
  CloseClient(Client, Token);
  AssertTrue(Std.Tasks.Wait(FirstServer).Unwrap());
  // Edit the stored second level: still valid, but no longer the generator's output.
  const World: WorldSession := OpenWorld(WorldsRoot, Config.WorldId, Config.WorldSeed, 1, 32)
                                 .Unwrap();
  const SecondPath: string := Std.Path.Join([
                                              World.Directory,
                                              'dungeons',
                                              (IntToStr(Second.Region.X) + '_') + IntToStr(Second.Region.Y),
                                              '0.json'
                                            ]);
  var Edited: InteriorMap := SecondMap;
  Edited.Cells[(Edit[0].Y * Edited.Width) + Edit[0].X] := InteriorCellKind.Floor;
  const Stored: string := Std.Fs.ReadText(SecondPath).Unwrap();
  AssertTrue(Stored.Contains(RowsJson(SecondMap)));
  const EditedText: string := Stored.Replace(RowsJson(SecondMap), RowsJson(Edited));
  AssertTrue(DecodeLevel(EditedText, World.Metadata, SecondId).IsOk());
  AssertTrue(Std.Fs.WriteTextAtomic(SecondPath, EditedText).Unwrap());
  // After a restart, loading shows the edited field: the stored level is used, not regenerated.
  const SecondServer: task := go ServeOne(ListenerValue, Config, Token);
  Client := Exchange(ConnectClient(Port, Token), ClientMessage.LoadGame, Token);
  AssertEquals('.', FirstPersonOf(Client).Rows[Edit[0].Y].CharAt(Edit[0].X));
  // The dropped coin lies once at the drop field and can be picked up again.
  Client := WalkTo(Client, Edited, SecondMap.Start, Token).Unwrap();
  AssertEquals('At your feet: Ancient coin — Enter: Pick up', FirstPersonOf(Client).Status);
  Client := Exchange(Client, ClientMessage.Interact, Token);
  AssertEquals(Coin.ItemId, FirstPersonOf(Client).Inventory[0].Id);
  // Revisit the spawn dungeon with the coin; its origin field stays empty.
  Client := WalkTo(Client, Edited, SecondMap.Exit, Token).Unwrap();
  Client := Exchange(Client, ClientMessage.Interact, Token);
  var Back: array of WorldPosition := OutdoorRoute(Metadata, Second.Site, Metadata.SpawnEntrance, 16);
  Client := Exchange(WalkOutdoorRoute(Client, Back, Token), ClientMessage.Interact, Token);
  AssertEquals(First.Start.X, FirstPersonOf(Client).PlayerX);
  Client := WalkTo(Client, First, Coin.Position, Token).Unwrap();
  AssertFalse(FirstPersonOf(Client).Status.Contains('Pick up'));
  RequireSaved(Exchange(Client, ClientMessage.OverwriteSaveGame, Token));
  CloseClient(Client, Token);
  AssertTrue(Std.Tasks.Wait(SecondServer).Unwrap());
  AssertTrue(CloseListener(ListenerValue).Unwrap());
  const Saved: GameState := DecodeStoredSave(World, Std.Fs.ReadText(SaveGamePath(World)).Unwrap())
                              .Unwrap();
  AssertEquals(2, Saved.VisitedAreas.Length());
  AssertEquals(1, ItemCount(Saved, Coin.ItemId));
  AssertEquals(First.Items.Length() + SecondMap.Items.Length(), Saved.Items.Length());
  AssertEquals(1, InventoryItems(Saved).Length());
  AssertEquals(EditedText, Std.Fs.ReadText(SecondPath).Unwrap());
end.
