// Carries an item between two generated dungeons over TCP, across a server restart, and back again.
// A deliberately edited but valid stored level proves that revisits read the file, not the generator.
program TwoDungeonTest;

uses
  Dungeon.Areas.Identities, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Hostiles,
  Dungeon.Interior, Dungeon.Interior.Generation, Dungeon.Items, Dungeon.Protocol, Dungeon.Server,
  Dungeon.Server.Config, Dungeon.Terrain, Dungeon.Terrain.Entrances, Dungeon.Terrain.Placement,
  Dungeon.Test.Fixtures, Dungeon.Test.Levels, Dungeon.Test.Routes, Dungeon.Test.Wire, Dungeon.World,
  Dungeon.World.Interiors.Encoding, Dungeon.World.Savegame, Std.Arrays, Std.Conv, Std.Fs, Std.Math,
  Std.Net, Std.Path, Std.Results, Std.Str, Std.Tasks, Std.Test, Std.Time;

type
  // A second entrance site reachable on foot from the spawn entrance.
  SecondSite = record
    Region: RegionCoordinate;
    Site: WorldPosition;
    Route: array of WorldPosition;
  end record;

function TestConfig(WorldsRoot: string): ServerConfig;
begin
  return record
    ConfigPath := '';
    Logs := None;
    WorldsRoot := WorldsRoot;
    WorldId := 'two-dungeons';
    WorldSeed := 9462;
    DungeonRegionChunks := 1;
    ChunkCacheLimit := 32;
    MaximumViewWidth := 240;
    MaximumViewHeight := 120;
  end;
end function;

function ServeOne(ListenerValue: Listener; Config: ServerConfig; Token: CancellationToken): result of boolean, string;
begin
  var Client: Connection := try AcceptWithCancellation(ListenerValue, Token);
  var Configured: boolean := try SetTimeout(Client, 120000);
  var Outcome: result of boolean, string := ServeConnection(Client, Config, Token);
  var Closed: boolean := try Close(Client);
  return Outcome;
end function;

// Finds the nearest other entrance site, ring by ring around the spawn region, reachable on foot.
function FindSecondSite(Metadata: WorldMetadata): SecondSite;
begin
  var Spawn: RegionCoordinate := RegionOf(Metadata, Metadata.Spawn);
  for Ring: integer := 1 to 4 do
    begin
      for DeltaY: integer := - Ring to Ring do
        begin
          for DeltaX: integer := - Ring to Ring do
            begin
              if Std.Math.Max(Std.Math.Abs(DeltaX), Std.Math.Abs(DeltaY)) = Ring then
                begin
                  var Region: RegionCoordinate := record
                    X := Spawn.X + DeltaX;
                    Y := Spawn.Y + DeltaY;
                  end;

                  case EntranceSite(Metadata, Region) of
                    when Some(Site):
                      begin
                        var Route: array of WorldPosition := OutdoorRoute(Metadata, Metadata.SpawnEntrance, Site, 16);
                        if Std.Arrays.Length(Route) > 0 then
                          begin
                            return record
                              Region := Region;
                              Site := Site;
                              Route := Route;
                            end;
                          end;
                        end if;
                      end;
                    else
                      begin
                        null;
                      end;
                  end case;
                end;
              end if;
            end;
          end for;
        end;
      end for;
    end;
  end for;

  panic('no second entrance site is reachable near the spawn');
end function;

function Chebyshev(Left: InteriorPosition; Right: InteriorPosition): integer;
begin
  return Std.Math.Max(Std.Math.Abs(Left.X - Right.X), Std.Math.Abs(Left.Y - Right.Y));
end function;

// Picks an inner wall field next to a floor field, too far from the start to affect the sight rule.
// Opening it keeps the level structurally valid but makes it differ from generated output.
function EditableWall(Map: InteriorMap): array of InteriorPosition;
begin
  for Y: integer := 2 to Map.Height - 3 do
    begin
      for X: integer := 2 to Map.Width - 3 do
        begin
          var Wall: InteriorPosition := record
            X := X;
            Y := Y;
          end;
          var Below: InteriorPosition := record
            X := X;
            Y := Y + 1;
          end;

          if ((Unwrap(InteriorCellAt(Map, Wall)) = InteriorCellKind.Wall) and (Unwrap(InteriorCellAt(Map, Below)) = InteriorCellKind.Floor)) and
             ((Chebyshev(Wall, Map.Start) > 8) and (Chebyshev(Below, Map.Start) > 8)) then
            begin
              return [Wall, Below];
            end;
          end if;
        end;
      end for;
    end;
  end for;

  panic('no editable wall in the second dungeon');
end function;

function RowsJson(Map: InteriorMap): string;
begin
  mutable var Text: string := '"rows":[';
  for Y: integer := 0 to Map.Height - 1 do
    begin
      mutable var Row: string := '';
      for X: integer := 0 to Map.Width - 1 do
        begin
          Row := Row + InteriorCellCode(Map.Cells[(Y * Map.Width) + X]);
        end;
      end for;

      if Y > 0 then
        begin
          Text := Text + ',';
        end;
      end if;

      Text := ((Text + '"') + Row) + '"';
    end;
  end for;

  return Text + ']';
end function;

function ItemCount(State: GameState; Id: string): integer;
begin
  mutable var Count: integer := 0;
  for Item: GameItem in State.Items do
    begin
      if Item.Id = Id then
        begin
          Count := Count + 1;
        end;
      end if;
    end;
  end for;

  return Count;
end function;

begin
  var WorldsRoot: string := '.temp-data/two-dungeons-' + IntToStr(TimestampMillis());
  AssertTrue(Unwrap(Std.Fs.CreateDirAll(WorldsRoot)));
  var Config: ServerConfig := TestConfig(WorldsRoot);
  var Fixture: WorldSession := Unwrap(OpenWorld(Config.WorldsRoot, Config.WorldId, Config.WorldSeed, Config.DungeonRegionChunks, Config.ChunkCacheLimit));
  var Metadata: WorldMetadata := Unwrap(NewWorldMetadata(Config.WorldId, Config.WorldSeed, 1));
  var First: InteriorMap := SpawnDungeonMap(Metadata);
  var Second: SecondSite := FindSecondSite(Metadata);
  var SecondId: string := DungeonAreaId(Metadata, Second.Region);
  var SecondMap: InteriorMap := Unwrap(GenerateDungeon(Metadata.Seed, Second.Region.X, Second.Region.Y, SecondId));
  var Coin: ItemPlacement := First.Items[0];
  var Edit: array of InteriorPosition := EditableWall(SecondMap);
  var Token: CancellationToken := GetCancellationToken(CreateCancellationSource());
  var ListenerValue: Listener := Unwrap(Listen('127.0.0.1', 0));
  var Port: integer := Unwrap(ListenerLocalAddress(ListenerValue)).Port;
  // First session: take the coin in the spawn dungeon, walk to the second dungeon, drop it there.
  var FirstServer: task := go ServeOne(ListenerValue, Config, Token);
  mutable var Client: WireClient := Exchange(ConnectClient(Port, Token), ClientMessage.StartNewGame, Token);
  Client := Exchange(WalkOutdoors(Client, Metadata.SpawnEntrance, Token), ClientMessage.Interact, Token);
  Client := Unwrap(WalkTo(Client, First, Coin.Position, Token));
  Client := Exchange(Client, ClientMessage.Interact, Token);
  AssertEquals(Coin.ItemId, FirstPersonOf(Client).Inventory[0].Id);
  Client := Unwrap(WalkTo(Client, First, First.Exit, Token));
  Client := Exchange(Client, ClientMessage.Interact, Token);
  Client := Exchange(WalkOutdoorRoute(Client, Second.Route, Token), ClientMessage.Interact, Token);
  AssertEquals(SecondMap.Start.X, FirstPersonOf(Client).PlayerX);
  Client := Exchange(Client, ClientMessage.DropItem(Coin.ItemId), Token);
  AssertEquals(0, Std.Arrays.Length(FirstPersonOf(Client).Inventory));
  // Stand next to the wall that will be edited, facing it, and save there.
  Client := Unwrap(WalkTo(Client, SecondMap, Edit[1], Token));
  mutable var Turns: integer := 0;
  while (not SamePosition(FieldAhead(FirstPersonOf(Client)), Edit[0])) and (Turns < 4) do
    begin
      Client := Exchange(Client, ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Right), Token);
      Turns := Turns + 1;
    end;
  end while;

  AssertEquals('#', Std.Str.CharAt(FirstPersonOf(Client).Rows[Edit[0].Y], Edit[0].X));
  RequireSaved(Exchange(Client, ClientMessage.SaveGame, Token));
  CloseClient(Client, Token);
  AssertTrue(Unwrap(Std.Tasks.Wait(FirstServer)));
  // Edit the stored second level: still valid, but no longer the generator's output.
  var World: WorldSession := Unwrap(OpenWorld(WorldsRoot, Config.WorldId, Config.WorldSeed, 1, 32));
  var SecondPath: string := Std.Path.Join([
                                            World.Directory,
                                            'dungeons',
                                            (IntToStr(Second.Region.X) + '_') + IntToStr(Second.Region.Y),
                                            '0.json'
                                          ]);
  mutable var Edited: InteriorMap := SecondMap;
  Edited.Cells[(Edit[0].Y * Edited.Width) + Edit[0].X] := InteriorCellKind.Floor;
  var Stored: string := Unwrap(Std.Fs.ReadText(SecondPath));
  AssertTrue(Std.Str.Contains(Stored, RowsJson(SecondMap)));
  var EditedText: string := Std.Str.Replace(Stored, RowsJson(SecondMap), RowsJson(Edited));
  AssertTrue(IsOk(DecodeLevel(EditedText, World.Metadata, SecondId)));
  AssertTrue(Unwrap(Std.Fs.WriteTextAtomic(SecondPath, EditedText)));
  // After a restart, loading shows the edited field: the stored level is used, not regenerated.
  var SecondServer: task := go ServeOne(ListenerValue, Config, Token);
  Client := Exchange(ConnectClient(Port, Token), ClientMessage.LoadGame, Token);
  AssertEquals('.', Std.Str.CharAt(FirstPersonOf(Client).Rows[Edit[0].Y], Edit[0].X));
  // The dropped coin lies once at the drop field and can be picked up again.
  Client := Unwrap(WalkTo(Client, Edited, SecondMap.Start, Token));
  AssertEquals('At your feet: Ancient coin — Enter: Pick up', FirstPersonOf(Client).Status);
  Client := Exchange(Client, ClientMessage.Interact, Token);
  AssertEquals(Coin.ItemId, FirstPersonOf(Client).Inventory[0].Id);
  // Revisit the spawn dungeon with the coin; its origin field stays empty.
  Client := Unwrap(WalkTo(Client, Edited, SecondMap.Exit, Token));
  Client := Exchange(Client, ClientMessage.Interact, Token);
  mutable var Back: array of WorldPosition := OutdoorRoute(Metadata, Second.Site, Metadata.SpawnEntrance, 16);
  Client := Exchange(WalkOutdoorRoute(Client, Back, Token), ClientMessage.Interact, Token);
  AssertEquals(First.Start.X, FirstPersonOf(Client).PlayerX);
  Client := Unwrap(WalkTo(Client, First, Coin.Position, Token));
  AssertFalse(Std.Str.Contains(FirstPersonOf(Client).Status, 'Pick up'));
  RequireSaved(Exchange(Client, ClientMessage.OverwriteSaveGame, Token));
  CloseClient(Client, Token);
  AssertTrue(Unwrap(Std.Tasks.Wait(SecondServer)));
  AssertTrue(Unwrap(CloseListener(ListenerValue)));
  var Saved: GameState := Unwrap(DecodeStoredSave(World, Unwrap(Std.Fs.ReadText(SaveGamePath(World)))));
  AssertEquals(2, Std.Arrays.Length(Saved.VisitedAreas));
  AssertEquals(1, ItemCount(Saved, Coin.ItemId));
  AssertEquals(Std.Arrays.Length(First.Items) + Std.Arrays.Length(SecondMap.Items), Std.Arrays.Length(Saved.Items));
  AssertEquals(1, Std.Arrays.Length(InventoryItems(Saved)));
  AssertEquals(EditedText, Unwrap(Std.Fs.ReadText(SecondPath)));
end.
