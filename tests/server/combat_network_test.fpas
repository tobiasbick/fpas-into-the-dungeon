// Verifies combat over TCP: health projection, turn log, rejections, and a fight to its end.
program DungeonCombatNetworkTest;

uses
  Dungeon.World, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interior, Dungeon.Test.Fixtures,
  Dungeon.Test.Routes, Dungeon.Protocol, Dungeon.Protocol.ClientMessages,
  Dungeon.Protocol.ServerMessages, Dungeon.Protocol.Transport, Dungeon.Server, Dungeon.Server.Config,
  Dungeon.Terrain, Dungeon.Terrain.Placement, Std.Conv, Std.Fs, Std.Net, Std.Tasks, Std.Test,
  Std.Time;

type ExchangeResult = record
  Reader: LineReader;
  Message: ServerMessage;
end record;

function TestConfig(WorldsRoot: string): ServerConfig;
begin
  return ServerConfig(ConfigPath := '', Logs := None, WorldsRoot := WorldsRoot, WorldId := 'combat-network', WorldSeed := 9462, DungeonRegionChunks := 4, ChunkCacheLimit := 32, MaximumViewWidth := 240, MaximumViewHeight := 120);
end function;

function ServeOne(ListenerValue: Listener; Config: ServerConfig; Token: CancellationToken): result of (boolean, string);
begin
  const Client: Connection := try AcceptWithCancellation(ListenerValue, Token);
  const Configured: boolean := try SetTimeout(Client, 30000);
  const Outcome: result of (boolean, string) := ServeConnection(Client, Config, Token);
  const Closed: boolean := try Close(Client);
  return Outcome;
end function;

function Exchange(
  Client: Connection;
  Reader: LineReader;
  Message: ClientMessage;
  Token: CancellationToken
): ExchangeResult;
begin
  AssertTrue(WriteLine(Client, EncodeClient(Message), Token).Unwrap());
  const LineValue: LineRead := ReadLine(Reader, Token).Unwrap();
  return ExchangeResult(Reader := LineValue.Reader, Message := DecodeServer(LineValue.Line).Unwrap());
end function;

function RequireFirstPerson(Message: ServerMessage): FirstPersonVisibleState;
begin
  if Message is ServerMessage.State(const Value) then
    begin
      if Value is VisibleState.FirstPersonState(const FirstPersonValue) then
        begin
          return FirstPersonValue;
        end;
      else
        begin
          panic('expected first-person visible state');
        end;
      end if;
    end;
  else
    begin
      panic('expected first-person state');
    end;
  end if;
end function;

function RequireMap(Message: ServerMessage): MapVisibleState;
begin
  if Message is ServerMessage.State(const Value) then
    begin
      if Value is VisibleState.MapState(const MapValue) then
        begin
          return MapValue;
        end;
      else
        begin
          panic('expected map visible state');
        end;
      end if;
    end;
  else
    begin
      panic('expected map state');
    end;
  end if;
end function;

procedure AssertRejected(Message: ServerMessage; ExpectedCode: string);
begin
  if Message is ServerMessage.Rejected(const Code, const Text) then
    begin
      AssertEquals(ExpectedCode, Code);
      AssertFalse(Text = '');
    end;
  else
    begin
      panic('expected rejected server message');
    end;
  end if;
end procedure;

function LogContains(Log: array of string; Text: string): boolean;
begin
  for Entry: string in Log do
    begin
      if Entry.Contains(Text) then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

begin
  const WorldsRoot: string := '.temp-data/combat-network-' + IntToStr(TimestampMillis());
  AssertTrue(Std.Fs.CreateDirAll(WorldsRoot).Unwrap());
  const Config: ServerConfig := TestConfig(WorldsRoot);
  const Fixture: WorldSession := OpenWorld(Config.WorldsRoot, Config.WorldId, Config.WorldSeed, Config.DungeonRegionChunks, Config.ChunkCacheLimit)
                                   .Unwrap();
  const Metadata: WorldMetadata := NewWorldMetadata(Config.WorldId, Config.WorldSeed, 4).Unwrap();
  const Source: CancellationSource := CreateCancellationSource();
  const Token: CancellationToken := GetCancellationToken(Source);
  const ListenerValue: Listener := Listen('127.0.0.1', 0).Unwrap();
  const Address: NetworkAddress := ListenerLocalAddress(ListenerValue).Unwrap();
  const ServerTask: task := go ServeOne(ListenerValue, Config, Token);
  const Client: Connection := Connect('127.0.0.1', Address.Port, 5000).Unwrap();
  AssertTrue(SetTimeout(Client, 120000).Unwrap());
  var Reader: LineReader := NewLineReader(Client);
  var Response: ExchangeResult := Exchange(Client, Reader, ClientMessage.Hello(ProtocolVersion, 13, 9), Token);
  Reader := Response.Reader;
  Response := Exchange(Client, Reader, ClientMessage.StartNewGame, Token);
  Reader := Response.Reader;
  const Outdoor: MapVisibleState := RequireMap(Response.Message);
  AssertEquals(PlayerMaximumHealth, Outdoor.Health);
  AssertEquals(PlayerMaximumHealth, Outdoor.MaxHealth);
  // Attacking outdoors is rejected without consuming anything.
  Response := Exchange(Client, Reader, ClientMessage.Attack, Token);
  Reader := Response.Reader;
  AssertRejected(Response.Message, 'attack_rejected');
  var CurrentX: integer := Outdoor.WorldX;
  var CurrentY: integer := Outdoor.WorldY;
  for Step: integer := 1 to 3 do
    begin
      var DeltaX: integer := 0;
      var DeltaY: integer := 0;
      if CurrentX < Metadata.SpawnEntrance.X then
        begin
          DeltaX := 1;
        end;
      else
        if CurrentX > Metadata.SpawnEntrance.X then
          begin
            DeltaX := -1;
          end;
        else
          if CurrentY < Metadata.SpawnEntrance.Y then
            begin
              DeltaY := 1;
            end;
          else
            if CurrentY > Metadata.SpawnEntrance.Y then
              begin
                DeltaY := -1;
              end;
            end if;
          end if;
        end if;
      end if;

      if (DeltaX <> 0) or (DeltaY <> 0) then
        begin
          Response := Exchange(Client, Reader, ClientMessage.Move(DeltaX, DeltaY), Token);
          Reader := Response.Reader;
          CurrentX := RequireMap(Response.Message).WorldX;
          CurrentY := RequireMap(Response.Message).WorldY;
        end;
      end if;
    end;
  end for;

  Response := Exchange(Client, Reader, ClientMessage.Interact, Token);
  Reader := Response.Reader;
  const Entered: FirstPersonVisibleState := RequireFirstPerson(Response.Message);
  AssertEquals(PlayerMaximumHealth, Entered.Health);
  AssertEquals(0, Entered.CombatLog.Length());
  // No opponent stands ahead at the start; generated dungeons keep skeletons out of its sight.
  Response := Exchange(Client, Reader, ClientMessage.Attack, Token);
  Reader := Response.Reader;
  AssertRejected(Response.Message, 'attack_rejected');
  Response := Exchange(Client, Reader, ClientMessage.Wait, Token);
  Reader := Response.Reader;
  AssertTrue(LogContains(RequireFirstPerson(Response.Message).CombatLog, 'You wait.'));
  // Walk towards the skeleton's room in the generated spawn dungeon until it stands ahead.
  const Map: InteriorMap := SpawnDungeonMap(Metadata);
  const Skeleton: InteriorPosition := Map.Hostiles[0].Position;
  var View: FirstPersonVisibleState := RequireFirstPerson(Response.Message);
  for Move: RouteMove in RouteTo(Map, VisiblePose(View), Skeleton, []) do
    begin
      if not HostileAhead(View) then
        begin
          if not ((Move = RouteMove.RouteForward) and SamePosition(FieldAhead(View), Skeleton)) then
            begin
              Response := Exchange(Client, Reader, RouteMessage(Move), Token);
              Reader := Response.Reader;
              View := RequireFirstPerson(Response.Message);
            end;
          end if;
        end;
      end if;
    end;
  end for;
  // Turning is free; waiting lets an alerted skeleton close in until it stands ahead.
  var Waited: integer := 0;
  while (not HostileAhead(View)) and (Waited < 8) do
    begin
      Response := Exchange(Client, Reader, ClientMessage.Wait, Token);
      Reader := Response.Reader;
      View := RequireFirstPerson(Response.Message);
      Waited := Waited + 1;
    end;
  end while;

  AssertTrue(HostileAhead(View));
  AssertTrue(View.Status.Contains('Space: Attack'));
  const FightField: InteriorPosition := FieldAhead(View);
  Response := Exchange(Client, Reader, ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward), Token);
  Reader := Response.Reader;
  AssertRejected(Response.Message, 'movement_rejected');
  // Fight until one side falls; the dice are deterministic, but the test accepts either end.
  var Finished: boolean := false;
  var Victory: boolean := false;
  var Blows: integer := 0;
  while (not Finished) and (Blows < 80) do
    begin
      Response := Exchange(Client, Reader, ClientMessage.Attack, Token);
      Reader := Response.Reader;
      Blows := Blows + 1;
      case Response.Message of
        when ServerMessage.Defeated(const Summary):
          begin
            AssertTrue(Summary.Contains('You have fallen.'));
            Finished := true;
          end;
        when ServerMessage.State(const Value):
          begin
            const Fighting: FirstPersonVisibleState := RequireFirstPerson(Response.Message);
            AssertTrue(Fighting.CombatLog.Length() > 0);
            AssertTrue((Fighting.Health >= 1) and (Fighting.Health <= Fighting.MaxHealth));
            if LogContains(Fighting.CombatLog, 'collapses') then
              begin
                AssertTrue(Fighting.Rows[FightField.Y].CharAt(FightField.X) <> InteriorHostileCode);
                Victory := true;
                Finished := true;
              end;
            end if;
          end;
        when servermessage.Welcome(_, _), servermessage.Worlds(_), servermessage.ExplorationMap(_), servermessage.Interaction(_, _), servermessage.SaveCompleted, servermessage.Rejected(_, _), servermessage.ErrorMessage(_, _):
          begin
            panic('expected a state or defeat after an attack');
          end;
      end case;
    end;
  end while;

  AssertTrue(Finished);
  if Victory then
    begin
      // With the skeleton gone the passage is open again.
      Response := Exchange(Client, Reader, ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward), Token);
      Reader := Response.Reader;
      AssertEquals(FightField.X, RequireFirstPerson(Response.Message).PlayerX);
      AssertEquals(FightField.Y, RequireFirstPerson(Response.Message).PlayerY);
    end;
  else
    begin
      // Defeat ended the session but kept the connection: a new game can start at once.
      Response := Exchange(Client, Reader, ClientMessage.Wait, Token);
      Reader := Response.Reader;
      AssertRejected(Response.Message, 'session_not_started');
      Response := Exchange(Client, Reader, ClientMessage.StartNewGame, Token);
      Reader := Response.Reader;
      AssertEquals(PlayerMaximumHealth, RequireMap(Response.Message).Health);
    end;
  end if;

  AssertTrue(WriteLine(Client, EncodeClient(ClientMessage.Disconnect), Token).Unwrap());
  AssertTrue(Std.Tasks.Wait(ServerTask).Unwrap());
  AssertTrue(Close(Client).Unwrap());
  AssertTrue(CloseListener(ListenerValue).Unwrap());
end.
