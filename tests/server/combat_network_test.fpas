// Verifies combat over TCP: health projection, turn log, rejections, and a fight to its end.
program DungeonCombatNetworkTest;

uses Dungeon.World as WorldUnit, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Interior as InteriorUnit, Dungeon.Test.Fixtures as Fixtures, Dungeon.Test.Routes as Routes, Dungeon.Protocol as Protocol, Dungeon.Protocol.ClientMessages as ClientMessages, Dungeon.Protocol.ServerMessages as ServerMessages, Dungeon.Protocol.Transport as Transport, Dungeon.Server as Server, Dungeon.Server.Config as ConfigUnit, Dungeon.Terrain as Terrain, Dungeon.Terrain.Placement as PlacementRules, Std.Conv as Conv, Std.Fs as Fs, Std.Net as Net, Std.Tasks as Tasks, Std.Test as Test, Std.Time as Time;

// Renders network failures for the server's text-based session callback.
function FailureMessage(Cause: Net.NetError): string;
begin
  return Cause.Message();
end function;

type ExchangeResult = record
  Reader: Transport.LineReader;
  Message: Protocol.ServerMessage;
end record;

function TestConfig(WorldsRoot: string): ConfigUnit.ServerConfig;
begin
  return ConfigUnit.ServerConfig(
    ConfigPath := '',
    Logs := None,
    WorldsRoot := WorldsRoot,
    WorldId := 'combat-network',
    WorldSeed := 9462,
    DungeonRegionChunks := 4,
    ChunkCacheLimit := 32,
    MaximumViewWidth := 240,
    MaximumViewHeight := 120
  );
end function;

function ServeOne(ListenerValue: Net.Listener; Config: ConfigUnit.ServerConfig; Token: Tasks.CancellationToken): result of (boolean, string);
begin
  const Client: Net.Connection := try Net.AcceptWithCancellation(
    ListenerValue,
    Token
  ).MapError(FailureMessage);
  const Configured: boolean := try Net.SetTimeout(Client, 30000).MapError(FailureMessage);
  const Outcome: result of (boolean, string) := Server.ServeConnection(Client, Config, Token);
  const Closed: boolean := try Net.Close(Client).MapError(FailureMessage);
  return Outcome;
end function;

function Exchange(
  Client: Net.Connection;
  Reader: Transport.LineReader;
  Message: Protocol.ClientMessage;
  Token: Tasks.CancellationToken
): ExchangeResult;
begin
  Test.AssertTrue(
    Transport.WriteLine(Client, ClientMessages.EncodeClient(Message), Token).Unwrap()
  );
  const LineValue: Transport.LineRead := Transport.ReadLine(Reader, Token).Unwrap();
  return ExchangeResult(
    Reader := LineValue.Reader,
    Message := ServerMessages.DecodeServer(LineValue.Line).Unwrap()
  );
end function;

function RequireFirstPerson(Message: Protocol.ServerMessage): Protocol.FirstPersonVisibleState;
begin
  case Message of
    when Protocol.ServerMessage.State(const Value):
      case Value of
        when Protocol.VisibleState.FirstPersonState(const FirstPersonValue):
          return FirstPersonValue;
        when Protocol.VisibleState.MapState(_):
          panic('expected first-person visible state');
      end case;
    when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
      panic('expected first-person state');
  end case;
end function;

function RequireMap(Message: Protocol.ServerMessage): Protocol.MapVisibleState;
begin
  case Message of
    when Protocol.ServerMessage.State(const Value):
      case Value of
        when Protocol.VisibleState.MapState(const MapValue):
          return MapValue;
        when Protocol.VisibleState.FirstPersonState(_):
          panic('expected map visible state');
      end case;
    when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
      panic('expected map state');
  end case;
end function;

procedure AssertRejected(Message: Protocol.ServerMessage; ExpectedCode: string);
begin
  case Message of
    when Protocol.ServerMessage.Rejected(const Code, const Text):
      Test.AssertEquals(ExpectedCode, Code);
      Test.AssertFalse(Text = '');
    when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
      panic('expected rejected server message');
  end case;
end procedure;

function LogContains(Log: array of string; Text: string): boolean;
begin
  for Entry: string in Log do
    begin
      if Text in Entry then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

begin
  const WorldsRoot: string := '.temp-data/combat-network-' + Conv.IntToStr(Time.TimestampMillis());
  Test.AssertTrue(Fs.CreateDirAll(WorldsRoot).Unwrap());
  const Config: ConfigUnit.ServerConfig := TestConfig(WorldsRoot);
  const Fixture: WorldUnit.WorldSession := WorldUnit.OpenWorld(
    Config.WorldsRoot,
    Config.WorldId,
    Config.WorldSeed,
    Config.DungeonRegionChunks,
    Config.ChunkCacheLimit
  ).Unwrap();
  const Metadata: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
    Config.WorldId,
    Config.WorldSeed,
    4
  ).Unwrap();
  const Source: Tasks.CancellationSource := Tasks.CreateCancellationSource();
  const Token: Tasks.CancellationToken := Tasks.GetCancellationToken(Source);
  const ListenerValue: Net.Listener := Net.Listen('127.0.0.1', 0).Unwrap();
  const Address: Net.NetworkAddress := Net.ListenerLocalAddress(ListenerValue).Unwrap();
  scope
    const ServerTask: task of result of (boolean, string) := go ServeOne(
      ListenerValue,
      Config,
      Token
    );
    const Client: Net.Connection := Net.Connect('127.0.0.1', Address.Port, 5000).Unwrap();
    Test.AssertTrue(Net.SetTimeout(Client, 120000).Unwrap());
    var Reader: Transport.LineReader := Transport.NewLineReader(Client);
    var Response: ExchangeResult := Exchange(
      Client,
      Reader,
      Protocol.ClientMessage.Hello(Protocol.ProtocolVersion, 13, 9),
      Token
    );
    Reader := Response.Reader;
    Response := Exchange(Client, Reader, Protocol.ClientMessage.StartNewGame, Token);
    Reader := Response.Reader;
    const Outdoor: Protocol.MapVisibleState := RequireMap(Response.Message);
    Test.AssertEquals(GameState.PlayerMaximumHealth, Outdoor.Health);
    Test.AssertEquals(GameState.PlayerMaximumHealth, Outdoor.MaxHealth);
    // Attacking outdoors is rejected without consuming anything.
    Response := Exchange(Client, Reader, Protocol.ClientMessage.Attack, Token);
    Reader := Response.Reader;
    AssertRejected(Response.Message, 'attack_rejected');
    var CurrentX: integer := Outdoor.WorldX;
    var CurrentY: integer := Outdoor.WorldY;
    for Step: integer := 1 to 3 do
      begin
        var DeltaX: integer := 0;
        var DeltaY: integer := 0;
        if CurrentX < Metadata.SpawnEntrance.X then
          begin
            DeltaX := 1;
          end;
        else
          if CurrentX > Metadata.SpawnEntrance.X then
            begin
              DeltaX := -1;
            end;
          else
            if CurrentY < Metadata.SpawnEntrance.Y then
              begin
                DeltaY := 1;
              end;
            else
              if CurrentY > Metadata.SpawnEntrance.Y then
                begin
                  DeltaY := -1;
                end;
              end if;
            end if;
          end if;
        end if;

        if (DeltaX <> 0) or (DeltaY <> 0) then
          begin
            Response := Exchange(
              Client,
              Reader,
              Protocol.ClientMessage.Move(DeltaX, DeltaY),
              Token
            );
            Reader := Response.Reader;
            CurrentX := RequireMap(Response.Message).WorldX;
            CurrentY := RequireMap(Response.Message).WorldY;
          end;
        end if;
      end;
    end for;

    Response := Exchange(Client, Reader, Protocol.ClientMessage.Interact, Token);
    Reader := Response.Reader;
    const Entered: Protocol.FirstPersonVisibleState := RequireFirstPerson(Response.Message);
    Test.AssertEquals(GameState.PlayerMaximumHealth, Entered.Health);
    Test.AssertEquals(0, Entered.CombatLog.Length());
    // No opponent stands ahead at the start; generated dungeons keep skeletons out of its sight.
    Response := Exchange(Client, Reader, Protocol.ClientMessage.Attack, Token);
    Reader := Response.Reader;
    AssertRejected(Response.Message, 'attack_rejected');
    Response := Exchange(Client, Reader, Protocol.ClientMessage.Wait, Token);
    Reader := Response.Reader;
    Test.AssertTrue(LogContains(RequireFirstPerson(Response.Message).CombatLog, 'You wait.'));
    // Walk towards the skeleton's room in the generated spawn dungeon until it stands ahead.
    const Map: InteriorUnit.InteriorMap := Routes.SpawnDungeonMap(Metadata);
    const Skeleton: Coordinates.InteriorPosition := Map.Hostiles[0].Position;
    var View: Protocol.FirstPersonVisibleState := RequireFirstPerson(Response.Message);
    for Move: Fixtures.RouteMove in Fixtures.RouteTo(Map, Routes.VisiblePose(View), Skeleton, []) do
      begin
        if not Routes.HostileAhead(View) then
          begin
            if not (
              (Move = Fixtures.RouteMove.RouteForward)
              and
              Coordinates.SamePosition(Routes.FieldAhead(View), Skeleton)
            )
            then
              begin
                Response := Exchange(Client, Reader, Routes.RouteMessage(Move), Token);
                Reader := Response.Reader;
                View := RequireFirstPerson(Response.Message);
              end;
            end if;
          end;
        end if;
      end;
    end for;
    // Turning is free; waiting lets an alerted skeleton close in until it stands ahead.
    var Waited: integer := 0;
    while (not Routes.HostileAhead(View)) and (Waited < 8) do
      begin
        Response := Exchange(Client, Reader, Protocol.ClientMessage.Wait, Token);
        Reader := Response.Reader;
        View := RequireFirstPerson(Response.Message);
        Waited := Waited + 1;
      end;
    end while;

    Test.AssertTrue(Routes.HostileAhead(View));
    Test.AssertTrue('Space: Attack' in View.Status);
    const FightField: Coordinates.InteriorPosition := Routes.FieldAhead(View);
    Response := Exchange(
      Client,
      Reader,
      Protocol.ClientMessage.StepFirstPerson(Protocol.FirstPersonStepDirection.Forward),
      Token
    );
    Reader := Response.Reader;
    AssertRejected(Response.Message, 'movement_rejected');
    // Fight until one side falls; the dice are deterministic, but the test accepts either end.
    var Finished: boolean := false;
    var Victory: boolean := false;
    var Blows: integer := 0;
    while (not Finished) and (Blows < 80) do
      begin
        Response := Exchange(Client, Reader, Protocol.ClientMessage.Attack, Token);
        Reader := Response.Reader;
        Blows := Blows + 1;
        case Response.Message of
          when Protocol.ServerMessage.Defeated(const Summary):
            begin
              Test.AssertTrue('You have fallen.' in Summary);
              Finished := true;
            end;
          when Protocol.ServerMessage.State(const Value):
            begin
              const Fighting: Protocol.FirstPersonVisibleState := RequireFirstPerson(
                Response.Message
              );
              Test.AssertTrue(Fighting.CombatLog.Length() > 0);
              Test.AssertTrue((Fighting.Health >= 1) and (Fighting.Health <= Fighting.MaxHealth));
              if LogContains(Fighting.CombatLog, 'collapses') then
                begin
                  Test.AssertTrue(
                    Fighting.Rows[FightField.Y][FightField.X] <> Protocol.InteriorHostileCode
                  );
                  Victory := true;
                  Finished := true;
                end;
              end if;
            end;
          when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Rejected(_, _), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.Trade(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
            begin
              panic('expected a state or defeat after an attack');
            end;
        end case;
      end;
    end while;

    Test.AssertTrue(Finished);
    if Victory then
      begin
        // With the skeleton gone the passage is open again.
        Response := Exchange(
          Client,
          Reader,
          Protocol.ClientMessage.StepFirstPerson(Protocol.FirstPersonStepDirection.Forward),
          Token
        );
        Reader := Response.Reader;
        Test.AssertEquals(FightField.X, RequireFirstPerson(Response.Message).PlayerX);
        Test.AssertEquals(FightField.Y, RequireFirstPerson(Response.Message).PlayerY);
      end;
    else
      begin
        // Defeat ended the session but kept the connection: a new game can start at once.
        Response := Exchange(Client, Reader, Protocol.ClientMessage.Wait, Token);
        Reader := Response.Reader;
        AssertRejected(Response.Message, 'session_not_started');
        Response := Exchange(Client, Reader, Protocol.ClientMessage.StartNewGame, Token);
        Reader := Response.Reader;
        Test.AssertEquals(GameState.PlayerMaximumHealth, RequireMap(Response.Message).Health);
      end;
    end if;

    Test.AssertTrue(
      Transport.WriteLine(
        Client,
        ClientMessages.EncodeClient(Protocol.ClientMessage.Disconnect),
        Token
      ).Unwrap()
    );
    Test.AssertTrue(Tasks.Wait(ServerTask).Unwrap());
    Test.AssertTrue(Net.Close(Client).Unwrap());
  end scope;

  Test.AssertTrue(Net.CloseListener(ListenerValue).Unwrap());
end.
