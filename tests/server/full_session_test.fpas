// Verifies the real client adapter, server world session, and colored TUI projection together.
program DungeonFullSessionTest;

uses
  Dungeon.Client, Dungeon.Game, Dungeon.Protocol, Dungeon.RuntimeData, Dungeon.Server, Std.Conv,
  Std.Fs, Std.Net, Std.Options, Std.Results, Std.Str, Std.Task, Std.Test, Std.Time, Std.Tui;

function TestConfig(WorldsRoot: string): ServerConfig;
begin
  return record
    WorldsRoot := WorldsRoot;
    WorldId := 'fresh-world';
    WorldSeed := 12345;
    ChunkCacheLimit := 32;
    MaximumViewWidth := 240;
    MaximumViewHeight := 120;
  end
end;

function EnsureDirectory(Path: string): boolean;
begin
  if Std.Fs.IsDir(Path) then
  begin
    return true
  end;

  case Std.Fs.CreateDir(Path) of
    Ok(Created):
    begin
      return true
    end
    else
    begin
      return Std.Fs.IsDir(Path)
    end
  end
end;

procedure EnsureWorldRoot(WorldsRoot: string);
begin
  AssertTrue(EnsureDirectory('.temp-data'));
  AssertTrue(EnsureDirectory(WorldsRoot))
end;

function ServeOne(ListenerValue: Listener; Config: ServerConfig; Token: CancellationToken): result of boolean, string;
begin
  var Client: Connection := try AcceptWithCancellation(ListenerValue, Token);
  var Configured: boolean := try SetTimeout(Client, 30000);
  var Outcome: result of boolean, string := ServeConnection(Client, Config, Token);
  var Closed: boolean := try Close(Client);
  return Outcome
end;

begin
  var WorldsRoot: string := '.temp-data/full-session-' + IntToStr(TimestampMillis());
  EnsureWorldRoot(WorldsRoot);
  var Config: ServerConfig := TestConfig(WorldsRoot);
  var ExpectedMetadata: WorldMetadata := Std.Results.Unwrap(NewWorldMetadata(Config.WorldId, Config.WorldSeed));
  var ListenerValue: Listener := Std.Results.Unwrap(Listen('127.0.0.1', 0));
  var Address: NetworkAddress := Std.Results.Unwrap(ListenerLocalAddress(ListenerValue));
  var Source: CancellationSource := CreateCancellationSource();
  var Token: CancellationToken := GetCancellationToken(Source);
  var ServerTask: task := go ServeOne(ListenerValue, Config, Token);
  var Requests: channel of ClientMessage := CreateChannel(4);
  var Events: channel of ClientEvent := CreateChannel(8);
  var ClientTask: task := go RunNetwork('127.0.0.1', Address.Port, 13, 7, Requests, Events, Token);
  var Cmd: TuiCmdOutput := TuiCmdOutput.Create();
  mutable var Model: ClientModel := NewClientModel('127.0.0.1', Address.Port, '', DefaultClientPreferences(), Requests, Events);
  case Std.Results.Unwrap(ReceiveWithTimeout(Events, 120000)) of
    ClientEvent.Connected(SaveAvailable, InvalidSaveRemoved):
    begin
      AssertFalse(SaveAvailable);
      AssertFalse(InvalidSaveRemoved);
      Model := UpdateClientEvent(Model, ClientEvent.Connected(SaveAvailable, InvalidSaveRemoved), Cmd)
    end
    else
    begin
      panic('expected connected event')
    end
  end;

  AssertTrue(Std.Results.Unwrap(SendWithTimeout(Requests, ClientMessage.StartNewGame, 1000)));
  case Std.Results.Unwrap(ReceiveWithTimeout(Events, 120000)) of
    ClientEvent.State(Value):
    begin
      case Value of
        VisibleState.MapState(MapValue):
        begin
          AssertEquals(13, MapValue.Width);
          AssertEquals(7, MapValue.Height);
          AssertEquals(ExpectedMetadata.Spawn.X, MapValue.WorldX);
          AssertEquals(ExpectedMetadata.Spawn.Y, MapValue.WorldY)
        end
        else
        begin
          panic('expected map state')
        end
      end;

      Model := UpdateClientEvent(Model, ClientEvent.State(Value), Cmd)
    end
    else
    begin
      panic('expected generated initial state')
    end
  end;
  var App: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 24));
  Model := App.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(Std.Options.Unwrap(App.SurfaceSnapshot().CellAt(1, 1).ConcreteStyle).Background.Kind =
             TuiColorKind.Rgb);
  App.Close();
  AssertTrue(Std.Results.Unwrap(SendWithTimeout(Requests, ClientMessage.Viewport(240, 20), 1000)));
  case Std.Results.Unwrap(ReceiveWithTimeout(Events, 120000)) of
    ClientEvent.State(Value):
    begin
      case Value of
        VisibleState.MapState(MapValue):
        begin
          AssertEquals(240, MapValue.Width);
          AssertEquals(20, MapValue.Height);
          AssertEquals(ExpectedMetadata.Spawn.X, MapValue.WorldX);
          AssertTrue(Std.Str.Contains(MapValue.Rows[0], '?'));
          AssertTrue(Std.Str.Contains(MapValue.KnowledgeRows[0], 'u'))
        end
        else
        begin
          panic('expected resized map state')
        end
      end
    end
    else
    begin
      panic('expected resized generated state')
    end
  end;
  mutable var CurrentX: integer := ExpectedMetadata.Spawn.X;
  mutable var CurrentY: integer := ExpectedMetadata.Spawn.Y;
  mutable var SawRemembered: boolean := false;
  mutable var SawVisible: boolean := false;
  mutable var SawUndiscovered: boolean := false;
  for Step: integer := 1 to 3 do
  begin
    mutable var DeltaX: integer := 0;
    mutable var DeltaY: integer := 0;
    if CurrentX < ExpectedMetadata.Entrance.X then
    begin
      DeltaX := 1
    end
    else if CurrentX > ExpectedMetadata.Entrance.X then
    begin
      DeltaX := -1
    end
    else if CurrentY < ExpectedMetadata.Entrance.Y then
    begin
      DeltaY := 1
    end
    else
    begin
      DeltaY := -1
    end;

    AssertTrue(Std.Results.Unwrap(SendWithTimeout(Requests, ClientMessage.Move(DeltaX, DeltaY), 1000)));
    case Std.Results.Unwrap(ReceiveWithTimeout(Events, 120000)) of
      ClientEvent.State(VisibleValue):
      begin
        case VisibleValue of
          VisibleState.MapState(MapValue):
          begin
            CurrentX := CurrentX + DeltaX;
            CurrentY := CurrentY + DeltaY;
            AssertEquals(CurrentX, MapValue.WorldX);
            AssertEquals(CurrentY, MapValue.WorldY);
            for KnowledgeRow: string in MapValue.KnowledgeRows do
            begin
              SawRemembered := SawRemembered or Std.Str.Contains(KnowledgeRow, 'r');
              SawVisible := SawVisible or Std.Str.Contains(KnowledgeRow, 'v');
              SawUndiscovered := SawUndiscovered or Std.Str.Contains(KnowledgeRow, 'u')
            end
          end
          else
          begin
            panic('expected map state while approaching entrance')
          end
        end
      end
      else
      begin
        panic('expected movement state')
      end
    end
  end;

  AssertTrue(SawRemembered);
  AssertTrue(SawVisible);
  AssertTrue(SawUndiscovered);
  AssertTrue(Std.Results.Unwrap(SendWithTimeout(Requests, ClientMessage.Interact, 1000)));
  case Std.Results.Unwrap(ReceiveWithTimeout(Events, 120000)) of
    ClientEvent.State(VisibleValue):
    begin
      case VisibleValue of
        VisibleState.FirstPersonState(FirstPersonValue):
        begin
          AssertEquals(ExpectedMetadata.DungeonAreaLabel, FirstPersonValue.Title);
          AssertEquals(11, FirstPersonValue.Width);
          AssertEquals(9, FirstPersonValue.Height);
          AssertEquals(9, FirstPersonValue.PlayerX);
          AssertEquals(1, FirstPersonValue.PlayerY);
          AssertTrue(FirstPersonValue.Facing = FirstPersonFacing.West);
          Model := UpdateClientEvent(Model, ClientEvent.State(VisibleValue), Cmd)
        end
        else
        begin
          panic('expected first-person client event')
        end
      end
    end
    else
    begin
      panic('expected entry state')
    end
  end;
  var FirstPersonApp: TuiApplication := TuiApplication.OpenForTest(TuiSize.Create(80, 24));
  Model := FirstPersonApp.RunIterations(Model, UpdateClient, ViewClient, 0, 0);
  AssertTrue(Std.Options.Unwrap(FirstPersonApp.SurfaceSnapshot().CellAt(1, 1).ConcreteStyle).Background.Kind =
             TuiColorKind.Rgb);
  FirstPersonApp.Close();
  AssertTrue(Std.Results.Unwrap(SendWithTimeout(Requests, ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Right), 1000)));
  case Std.Results.Unwrap(ReceiveWithTimeout(Events, 120000)) of
    ClientEvent.State(VisibleValue):
    begin
      case VisibleValue of
        VisibleState.FirstPersonState(FirstPersonValue):
        begin
          AssertTrue(FirstPersonValue.Facing = FirstPersonFacing.North);
          AssertEquals('t', Std.Str.CharAt(FirstPersonValue.Rows[0], 9))
        end
        else
        begin
          panic('expected north-facing state before tablet interaction')
        end
      end
    end
    else
    begin
      panic('expected turn event before tablet interaction')
    end
  end;

  AssertTrue(Std.Results.Unwrap(SendWithTimeout(Requests, ClientMessage.Interact, 1000)));
  case Std.Results.Unwrap(ReceiveWithTimeout(Events, 120000)) of
    ClientEvent.Interaction(Title, Message):
    begin
      AssertEquals(StoneTabletDescription, Message);
      Model := UpdateClientEvent(Model, ClientEvent.Interaction(Title, Message), Cmd);
      AssertTrue(Model.Overlay = ClientOverlay.DescriptionOverlay);
      AssertEquals('Stone tablet', Model.DescriptionTitle);
      AssertEquals(StoneTabletDescription, Model.DescriptionText)
    end
    else
    begin
      panic('expected tablet interaction client event')
    end
  end;

  AssertTrue(Std.Results.Unwrap(SendWithTimeout(Requests, ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Left), 1000)));
  case Std.Results.Unwrap(ReceiveWithTimeout(Events, 120000)) of
    ClientEvent.State(VisibleValue):
    begin
      case VisibleValue of
        VisibleState.FirstPersonState(FirstPersonValue):
        begin
          AssertTrue(FirstPersonValue.Facing = FirstPersonFacing.West)
        end
        else
        begin
          panic('expected west-facing state after tablet interaction')
        end
      end
    end
    else
    begin
      panic('expected turn event after tablet interaction')
    end
  end;

  AssertTrue(Std.Results.Unwrap(SendWithTimeout(Requests, ClientMessage.SaveGame, 1000)));
  case Std.Results.Unwrap(ReceiveWithTimeout(Events, 120000)) of
    ClientEvent.SaveCompleted:
    begin
      Model := UpdateClientEvent(Model, ClientEvent.SaveCompleted, Cmd);
      AssertTrue(Model.SaveAvailable);
      AssertEquals('Game saved.', Model.Status)
    end
    else
    begin
      panic('expected client save-completed event')
    end
  end;

  AssertTrue(Std.Results.Unwrap(SendWithTimeout(Requests, ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Left), 1000)));
  case Std.Results.Unwrap(ReceiveWithTimeout(Events, 120000)) of
    ClientEvent.State(VisibleValue):
    begin
      case VisibleValue of
        VisibleState.FirstPersonState(FirstPersonValue):
        begin
          AssertTrue(FirstPersonValue.Facing = FirstPersonFacing.South)
        end
        else
        begin
          panic('expected first-person turn state')
        end
      end
    end
    else
    begin
      panic('expected first-person turn event')
    end
  end;

  for InteriorStep: integer := 1 to 6 do
  begin
    AssertTrue(Std.Results.Unwrap(SendWithTimeout(Requests, ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward), 1000)));
    case Std.Results.Unwrap(ReceiveWithTimeout(Events, 120000)) of
      ClientEvent.State(VisibleValue):
      begin
        case VisibleValue of
          VisibleState.FirstPersonState(FirstPersonValue):
          begin
            AssertEquals(9, FirstPersonValue.PlayerX);
            AssertEquals(1 + InteriorStep, FirstPersonValue.PlayerY)
          end
          else
          begin
            panic('expected first-person south-step state')
          end
        end
      end
      else
      begin
        panic('expected first-person south-step event')
      end
    end
  end;

  AssertTrue(Std.Results.Unwrap(SendWithTimeout(Requests, ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Right), 1000)));
  case Std.Results.Unwrap(ReceiveWithTimeout(Events, 120000)) of
    ClientEvent.State(VisibleValue):
    begin
      case VisibleValue of
        VisibleState.FirstPersonState(FirstPersonValue):
        begin
          AssertTrue(FirstPersonValue.Facing = FirstPersonFacing.West)
        end
        else
        begin
          panic('expected first-person exit-corridor turn state')
        end
      end
    end
    else
    begin
      panic('expected first-person exit-corridor turn event')
    end
  end;

  for InteriorStep: integer := 1 to 8 do
  begin
    AssertTrue(Std.Results.Unwrap(SendWithTimeout(Requests, ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward), 1000)));
    case Std.Results.Unwrap(ReceiveWithTimeout(Events, 120000)) of
      ClientEvent.State(VisibleValue):
      begin
        case VisibleValue of
          VisibleState.FirstPersonState(FirstPersonValue):
          begin
            AssertEquals(9 - InteriorStep, FirstPersonValue.PlayerX);
            AssertEquals(7, FirstPersonValue.PlayerY)
          end
          else
          begin
            panic('expected first-person west-step state')
          end
        end
      end
      else
      begin
        panic('expected first-person west-step event')
      end
    end
  end;

  AssertTrue(Std.Results.Unwrap(SendWithTimeout(Requests, ClientMessage.Interact, 1000)));
  case Std.Results.Unwrap(ReceiveWithTimeout(Events, 120000)) of
    ClientEvent.State(VisibleValue):
    begin
      case VisibleValue of
        VisibleState.MapState(MapValue):
        begin
          AssertEquals(ExpectedMetadata.Entrance.X, MapValue.WorldX);
          AssertEquals(ExpectedMetadata.Entrance.Y, MapValue.WorldY)
        end
        else
        begin
          panic('expected restored map client event')
        end
      end
    end
    else
    begin
      panic('expected exit state')
    end
  end;

  AssertTrue(Std.Results.Unwrap(SendWithTimeout(Requests, ClientMessage.Disconnect, 1000)));
  AssertTrue(Std.Results.Unwrap(Wait(ClientTask)));
  AssertTrue(Std.Results.Unwrap(Wait(ServerTask)));
  AssertTrue(Std.Results.Unwrap(CloseListener(ListenerValue)));
  CloseChannel(Requests);
  CloseChannel(Events)
end.
