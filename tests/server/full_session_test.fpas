// Verifies the real client adapter, server world session, and colored TUI projection together.
program DungeonFullSessionTest;

uses Dungeon.Test.Catalog as CatalogUnit, Dungeon.Client as ClientUnit, Dungeon.Coordinates as Coordinates, Dungeon.Hostiles as HostileRules, Dungeon.Interior as InteriorUnit, Dungeon.Interior.Generation.Validation as Validation, Dungeon.Test.Fixtures as Fixtures, Dungeon.Test.Routes as Routes, Dungeon.Interaction as Interaction, Dungeon.Protocol as Protocol, Dungeon.RuntimeData as RuntimeData, Dungeon.Server as Server, Dungeon.Server.Config as ConfigUnit, Dungeon.Terrain as Terrain, Dungeon.World as WorldUnit, Dungeon.Test.ClientSession as ClientSession, Dungeon.Terrain.Placement as PlacementRules, Std.Conv as Conv, Std.Fs as Fs, Std.Net as Net, Std.Tasks as Tasks, Std.Test as Test, Std.Time as Time, Std.Tui as Tui;

// Renders network failures for the server's text-based session callback.
function FailureMessage(Cause: Net.NetError): string;
begin
  return Cause.Message();
end function;

function TestConfig(WorldsRoot: string): ConfigUnit.ServerConfig;
begin
  return ConfigUnit.ServerConfig(
    ConfigPath := '',
    Logs := None,
    WorldsRoot := WorldsRoot,
    WorldId := 'fresh-world',
    WorldSeed := 12345,
    DungeonRegionChunks := 4,
    ChunkCacheLimit := 32,
    MaximumViewWidth := 240,
    MaximumViewHeight := 120
  );
end function;

function EnsureDirectory(Path: string): boolean;
begin
  if Fs.IsDir(Path) then
    begin
      return true;
    end;
  end if;

  case Fs.CreateDir(Path) of
    when Ok(const Created):
      return true;
    when Error(_):
      return Fs.IsDir(Path);
  end case;
end function;

procedure EnsureWorldRoot(WorldsRoot: string);
begin
  Test.AssertTrue(EnsureDirectory('.temp-data'));
  Test.AssertTrue(EnsureDirectory(WorldsRoot));
end procedure;

function ServeSession(ListenerValue: Net.Listener; Config: ConfigUnit.ServerConfig; Token: Tasks.CancellationToken): result of (boolean, string);
begin
  const Client: Net.Connection := try Net.AcceptWithCancellation(
    ListenerValue,
    Token
  ).MapError(FailureMessage);
  const Configured: boolean := try Net.SetTimeout(Client, 30000).MapError(FailureMessage);
  const Outcome: result of (boolean, string) := Server.ServeConnection(Client, Config, Token);
  const Closed: boolean := try Net.Close(Client).MapError(FailureMessage);
  return Outcome;
end function;

// Serves one session and publishes its outcome so a stalled test reports the cause.
function ServeOne(
  ListenerValue: Net.Listener;
  Config: ConfigUnit.ServerConfig;
  Outcomes: channel of string;
  Token: Tasks.CancellationToken
): result of (boolean, string);
begin
  const Outcome: result of (boolean, string) := ServeSession(ListenerValue, Config, Token);
  ClientSession.ReportOutcome(Outcomes, 'server', Outcome);
  return Outcome;
end function;

function RequireFirstPersonEvent(Received: ClientUnit.ClientEvent): Protocol.FirstPersonVisibleState;
begin
  case Received of
    when ClientUnit.ClientEvent.State(const VisibleValue):
      case VisibleValue of
        when Protocol.VisibleState.FirstPersonState(const FirstPersonValue):
          return FirstPersonValue;
        when Protocol.VisibleState.MapState(_):
          panic('expected a first-person state');
      end case;
    when ClientUnit.ClientEvent.Connected(_), ClientUnit.ClientEvent.Worlds(_), ClientUnit.ClientEvent.ExplorationMap(_), ClientUnit.ClientEvent.Interaction(_, _), ClientUnit.ClientEvent.SaveCompleted, ClientUnit.ClientEvent.Rejected(_, _), ClientUnit.ClientEvent.MapRejected(_, _), ClientUnit.ClientEvent.Defeated(_), ClientUnit.ClientEvent.ViewportState(_), ClientUnit.ClientEvent.Failed(_), ClientUnit.ClientEvent.Dialogue(_, _, _), ClientUnit.ClientEvent.DialogueEnded(_, _), ClientUnit.ClientEvent.Disconnected:
      panic('expected a state event');
  end case;
end function;

function AheadOf(Pose: Coordinates.FirstPersonPose): Coordinates.InteriorPosition;
begin
  const Offset: Coordinates.InteriorPosition := Coordinates.StepOffset(
    Pose.Facing,
    Coordinates.RelativeStep.Forward
  );
  return Coordinates.InteriorPosition(
    X := Pose.Position.X + Offset.X,
    Y := Pose.Position.Y + Offset.Y
  );
end function;

begin
  const WorldsRoot: string := '.temp-data/full-session-' + Conv.IntToStr(Time.TimestampMillis());
  EnsureWorldRoot(WorldsRoot);
  const Config: ConfigUnit.ServerConfig := TestConfig(WorldsRoot);
  const Fixture: WorldUnit.WorldSession := WorldUnit.OpenWorld(
    Config.WorldsRoot,
    Config.WorldId,
    Config.WorldSeed,
    4,
    Config.ChunkCacheLimit
  ).Unwrap();
  const ExpectedMetadata: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
    Config.WorldId,
    Config.WorldSeed,
    4
  ).Unwrap();
  const Map: InteriorUnit.InteriorMap := Routes.SpawnDungeonMap(ExpectedMetadata);
  var Pose: Coordinates.FirstPersonPose := Coordinates.FirstPersonPose(
    Position := Map.Start,
    Facing := Map.StartFacing
  );
  const ListenerValue: Net.Listener := Net.Listen('127.0.0.1', 0).Unwrap();
  const Address: Net.NetworkAddress := Net.ListenerLocalAddress(ListenerValue).Unwrap();
  const Source: Tasks.CancellationSource := Tasks.CreateCancellationSource();
  const Token: Tasks.CancellationToken := Tasks.GetCancellationToken(Source);
  const Outcomes: channel of string := Tasks.CreateChannel(4);
  scope
    const ServerTask: task of result of (boolean, string) := go ServeOne(
      ListenerValue,
      Config,
      Outcomes,
      Token
    );
    const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(4);
    const Events: channel of ClientUnit.ClientEvent := Tasks.CreateChannel(8);
    const ClientTask: task of result of (boolean, string) := go ClientSession.RunReportedClient(
      '127.0.0.1',
      Address.Port,
      13,
      7,
      Requests,
      Events,
      Outcomes,
      Token
    );
    const Cmd: Tui.TuiCmdOutput := Tui.TuiCmdOutput.Create();
    const UiEvents: channel of ClientUnit.ConnectionEvent := Tasks.CreateChannel(8);
    var Model: ClientUnit.ClientModel := ClientUnit.NewClientModel(
      '127.0.0.1',
      Address.Port,
      '',
      RuntimeData.DefaultClientPreferences(),
      Requests,
      UiEvents
    );
    case ClientSession.NextClientEvent(Events, Outcomes, 120000) of
      when ClientUnit.ClientEvent.Connected(const Catalog):
        Test.AssertFalse(CatalogUnit.FixtureSaveAvailable(Catalog));
        Test.AssertFalse(CatalogUnit.FixtureInvalidSave(Catalog));
        Model := ClientUnit.UpdateClientEvent(
          Model,
          ClientUnit.ClientEvent.Connected(Catalog),
          Cmd
        );
      when ClientUnit.ClientEvent.Worlds(_), ClientUnit.ClientEvent.State(_), ClientUnit.ClientEvent.ExplorationMap(_), ClientUnit.ClientEvent.Interaction(_, _), ClientUnit.ClientEvent.SaveCompleted, ClientUnit.ClientEvent.Rejected(_, _), ClientUnit.ClientEvent.MapRejected(_, _), ClientUnit.ClientEvent.Defeated(_), ClientUnit.ClientEvent.ViewportState(_), ClientUnit.ClientEvent.Failed(_), ClientUnit.ClientEvent.Dialogue(_, _, _), ClientUnit.ClientEvent.DialogueEnded(_, _), ClientUnit.ClientEvent.Disconnected:
        panic('expected connected event');
    end case;

    Test.AssertTrue(
      Tasks.SendWithTimeout(Requests, Protocol.ClientMessage.StartNewGame, 1000).Unwrap()
    );
    case ClientSession.NextClientEvent(Events, Outcomes, 120000) of
      when ClientUnit.ClientEvent.State(const Value):
        case Value of
          when Protocol.VisibleState.MapState(const MapValue):
            Test.AssertEquals(13, MapValue.Width);
            Test.AssertEquals(7, MapValue.Height);
            Test.AssertEquals(ExpectedMetadata.Spawn.X, MapValue.WorldX);
            Test.AssertEquals(ExpectedMetadata.Spawn.Y, MapValue.WorldY);
          when Protocol.VisibleState.FirstPersonState(_):
            panic('expected map state');
        end case;

        Model := ClientUnit.UpdateClientEvent(Model, ClientUnit.ClientEvent.State(Value), Cmd);
      when ClientUnit.ClientEvent.Connected(_), ClientUnit.ClientEvent.Worlds(_), ClientUnit.ClientEvent.ExplorationMap(_), ClientUnit.ClientEvent.Interaction(_, _), ClientUnit.ClientEvent.SaveCompleted, ClientUnit.ClientEvent.Rejected(_, _), ClientUnit.ClientEvent.MapRejected(_, _), ClientUnit.ClientEvent.Defeated(_), ClientUnit.ClientEvent.ViewportState(_), ClientUnit.ClientEvent.Failed(_), ClientUnit.ClientEvent.Dialogue(_, _, _), ClientUnit.ClientEvent.DialogueEnded(_, _), ClientUnit.ClientEvent.Disconnected:
        panic('expected generated initial state');
    end case;
    const App: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(Tui.TuiSize.Create(80, 24));
    Model := App.RunIterations(Model, ClientUnit.UpdateClient, ClientUnit.ViewClient, 0, 0);
    Test.AssertTrue(
      App.SurfaceSnapshot().CellAt(1, 1).ConcreteStyle.Unwrap().Background.Kind =
      Tui.TuiColorKind.Rgb
    );
    App.Close();
    Test.AssertTrue(
      Tasks.SendWithTimeout(Requests, Protocol.ClientMessage.Viewport(240, 20), 1000).Unwrap()
    );
    case ClientSession.NextClientEvent(Events, Outcomes, 120000) of
      when ClientUnit.ClientEvent.ViewportState(const Value):
        case Value of
          when Protocol.VisibleState.MapState(const MapValue):
            Test.AssertEquals(240, MapValue.Width);
            Test.AssertEquals(20, MapValue.Height);
            Test.AssertEquals(ExpectedMetadata.Spawn.X, MapValue.WorldX);
            Test.AssertTrue('?' in MapValue.Rows[0]);
            Test.AssertTrue('u' in MapValue.KnowledgeRows[0]);
          when Protocol.VisibleState.FirstPersonState(_):
            panic('expected resized map state');
        end case;
      when ClientUnit.ClientEvent.Connected(_), ClientUnit.ClientEvent.Worlds(_), ClientUnit.ClientEvent.ExplorationMap(_), ClientUnit.ClientEvent.Interaction(_, _), ClientUnit.ClientEvent.SaveCompleted, ClientUnit.ClientEvent.Rejected(_, _), ClientUnit.ClientEvent.MapRejected(_, _), ClientUnit.ClientEvent.Defeated(_), ClientUnit.ClientEvent.State(_), ClientUnit.ClientEvent.Failed(_), ClientUnit.ClientEvent.Dialogue(_, _, _), ClientUnit.ClientEvent.DialogueEnded(_, _), ClientUnit.ClientEvent.Disconnected:
        panic('expected resized generated state');
    end case;
    var CurrentX: integer := ExpectedMetadata.Spawn.X;
    var CurrentY: integer := ExpectedMetadata.Spawn.Y;
    var SawRemembered: boolean := false;
    var SawVisible: boolean := false;
    var SawUndiscovered: boolean := false;
    for Step: integer := 1 to 3 do
      begin
        var DeltaX: integer := 0;
        var DeltaY: integer := 0;
        if CurrentX < ExpectedMetadata.SpawnEntrance.X then
          begin
            DeltaX := 1;
          end;
        else
          if CurrentX > ExpectedMetadata.SpawnEntrance.X then
            begin
              DeltaX := -1;
            end;
          else
            if CurrentY < ExpectedMetadata.SpawnEntrance.Y then
              begin
                DeltaY := 1;
              end;
            else
              begin
                DeltaY := -1;
              end;
            end if;
          end if;
        end if;

        Test.AssertTrue(
          Tasks.SendWithTimeout(
            Requests,
            Protocol.ClientMessage.Move(DeltaX, DeltaY),
            1000
          ).Unwrap()
        );
        case ClientSession.NextClientEvent(Events, Outcomes, 120000) of
          when ClientUnit.ClientEvent.State(const VisibleValue):
            case VisibleValue of
              when Protocol.VisibleState.MapState(const MapValue):
                CurrentX := CurrentX + DeltaX;
                CurrentY := CurrentY + DeltaY;
                Test.AssertEquals(CurrentX, MapValue.WorldX);
                Test.AssertEquals(CurrentY, MapValue.WorldY);
                for KnowledgeRow: string in MapValue.KnowledgeRows do
                  begin
                    SawRemembered := SawRemembered or 'r' in KnowledgeRow;
                    SawVisible := SawVisible or 'v' in KnowledgeRow;
                    SawUndiscovered := SawUndiscovered or 'u' in KnowledgeRow;
                  end;
                end for;
              when Protocol.VisibleState.FirstPersonState(_):
                panic('expected map state while approaching entrance');
            end case;
          when ClientUnit.ClientEvent.Connected(_), ClientUnit.ClientEvent.Worlds(_), ClientUnit.ClientEvent.ExplorationMap(_), ClientUnit.ClientEvent.Interaction(_, _), ClientUnit.ClientEvent.SaveCompleted, ClientUnit.ClientEvent.Rejected(_, _), ClientUnit.ClientEvent.MapRejected(_, _), ClientUnit.ClientEvent.Defeated(_), ClientUnit.ClientEvent.ViewportState(_), ClientUnit.ClientEvent.Failed(_), ClientUnit.ClientEvent.Dialogue(_, _, _), ClientUnit.ClientEvent.DialogueEnded(_, _), ClientUnit.ClientEvent.Disconnected:
            panic('expected movement state');
        end case;
      end;
    end for;

    Test.AssertTrue(SawRemembered);
    Test.AssertTrue(SawVisible);
    Test.AssertTrue(SawUndiscovered);
    Test.AssertTrue(
      Tasks.SendWithTimeout(Requests, Protocol.ClientMessage.Interact, 1000).Unwrap()
    );
    case ClientSession.NextClientEvent(Events, Outcomes, 120000) of
      when ClientUnit.ClientEvent.State(const VisibleValue):
        case VisibleValue of
          when Protocol.VisibleState.FirstPersonState(const FirstPersonValue):
            Test.AssertEquals(Map.DisplayName + ' — Level 1 of 3', FirstPersonValue.Title);
            Test.AssertEquals(Validation.GeneratedDungeonWidth, FirstPersonValue.Width);
            Test.AssertEquals(Validation.GeneratedDungeonHeight, FirstPersonValue.Height);
            Test.AssertEquals(Map.Start.X, FirstPersonValue.PlayerX);
            Test.AssertEquals(Map.Start.Y, FirstPersonValue.PlayerY);
            Test.AssertTrue(FirstPersonValue.Facing = Protocol.FirstPersonFacing.East);
            Pose := Routes.VisiblePose(FirstPersonValue);
            Model := ClientUnit.UpdateClientEvent(
              Model,
              ClientUnit.ClientEvent.State(VisibleValue),
              Cmd
            );
          when Protocol.VisibleState.MapState(_):
            panic('expected first-person client event');
        end case;
      when ClientUnit.ClientEvent.Connected(_), ClientUnit.ClientEvent.Worlds(_), ClientUnit.ClientEvent.ExplorationMap(_), ClientUnit.ClientEvent.Interaction(_, _), ClientUnit.ClientEvent.SaveCompleted, ClientUnit.ClientEvent.Rejected(_, _), ClientUnit.ClientEvent.MapRejected(_, _), ClientUnit.ClientEvent.Defeated(_), ClientUnit.ClientEvent.ViewportState(_), ClientUnit.ClientEvent.Failed(_), ClientUnit.ClientEvent.Dialogue(_, _, _), ClientUnit.ClientEvent.DialogueEnded(_, _), ClientUnit.ClientEvent.Disconnected:
        panic('expected entry state');
    end case;
    const FirstPersonApp: Tui.TuiApplication := Tui.TuiApplication.OpenForTest(
      Tui.TuiSize.Create(80, 24)
    );
    Test.AssertEquals(Map.DisplayName + ' — Level 1 of 3', Model.PrimaryTitle);
    Model := FirstPersonApp.RunIterations(
      Model,
      ClientUnit.UpdateClient,
      ClientUnit.ViewClient,
      0,
      0
    );
    Test.AssertTrue(
      FirstPersonApp.SurfaceSnapshot().CellAt(1, 1).ConcreteStyle.Unwrap().Background.Kind =
      Tui.TuiColorKind.Rgb
    );
    FirstPersonApp.Close();
    // Turn right until a wall stands ahead; turning is free and an ordinary wall offers nothing.
    var Turns: integer := 0;
    while (
      InteriorUnit.InteriorCellAt(Map, AheadOf(Pose)).Unwrap() <>
      InteriorUnit.InteriorCellKind.Wall
    )
      and
      (Turns < 4) do
      begin
        Test.AssertTrue(
          Tasks.SendWithTimeout(
            Requests,
            Protocol.ClientMessage.TurnFirstPerson(Protocol.FirstPersonTurnDirection.Right),
            1000
          ).Unwrap()
        );
        Pose := Routes.VisiblePose(
          RequireFirstPersonEvent(ClientSession.NextClientEvent(Events, Outcomes, 120000))
        );
        Turns := Turns + 1;
      end;
    end while;

    Test.AssertTrue(
      InteriorUnit.InteriorCellAt(Map, AheadOf(Pose)).Unwrap() = InteriorUnit.InteriorCellKind.Wall
    );
    Test.AssertTrue(
      Tasks.SendWithTimeout(Requests, Protocol.ClientMessage.Interact, 1000).Unwrap()
    );
    case ClientSession.NextClientEvent(Events, Outcomes, 120000) of
      when ClientUnit.ClientEvent.Interaction(const Title, const Message):
        Test.AssertEquals('', Title);
        Test.AssertEquals(Interaction.NoInteractionMessage, Message);
        Model := ClientUnit.UpdateClientEvent(
          Model,
          ClientUnit.ClientEvent.Interaction(Title, Message),
          Cmd
        );
        Test.AssertFalse(Model.Overlay = ClientUnit.ClientOverlay.DescriptionOverlay);
      when ClientUnit.ClientEvent.Connected(_), ClientUnit.ClientEvent.Worlds(_), ClientUnit.ClientEvent.State(_), ClientUnit.ClientEvent.ExplorationMap(_), ClientUnit.ClientEvent.SaveCompleted, ClientUnit.ClientEvent.Rejected(_, _), ClientUnit.ClientEvent.MapRejected(_, _), ClientUnit.ClientEvent.Defeated(_), ClientUnit.ClientEvent.ViewportState(_), ClientUnit.ClientEvent.Failed(_), ClientUnit.ClientEvent.Dialogue(_, _, _), ClientUnit.ClientEvent.DialogueEnded(_, _), ClientUnit.ClientEvent.Disconnected:
        panic('expected ordinary wall interaction response');
    end case;

    Test.AssertTrue(
      Tasks.SendWithTimeout(Requests, Protocol.ClientMessage.SaveGame, 1000).Unwrap()
    );
    if ClientSession.NextClientEvent(Events, Outcomes, 120000) is ClientUnit.ClientEvent.SaveCompleted then
      begin
        Model := ClientUnit.UpdateClientEvent(Model, ClientUnit.ClientEvent.SaveCompleted, Cmd);
        Test.AssertTrue(Model.SaveAvailable);
        Test.AssertEquals('Game saved.', Model.Status);
      end;
    else
      begin
        panic('expected client save-completed event');
      end;
    end if;
    // Walk back to the exit of the generated dungeon around any resting skeleton.
    var Avoid: array of Coordinates.InteriorPosition := [];
    for Hostile: HostileRules.HostilePlacement in Map.Hostiles do
      begin
        Avoid.PushInPlace(Hostile.Position);
      end;
    end for;

    for Move: Fixtures.RouteMove in Fixtures.RouteTo(Map, Pose, Map.Arrival, Avoid) do
      begin
        Test.AssertTrue(Tasks.SendWithTimeout(Requests, Routes.RouteMessage(Move), 1000).Unwrap());
        Pose := Routes.VisiblePose(
          RequireFirstPersonEvent(ClientSession.NextClientEvent(Events, Outcomes, 120000))
        );
      end;
    end for;

    Test.AssertTrue(Coordinates.SamePosition(Pose.Position, Map.Arrival));
    Test.AssertTrue(
      Tasks.SendWithTimeout(Requests, Protocol.ClientMessage.Interact, 1000).Unwrap()
    );
    case ClientSession.NextClientEvent(Events, Outcomes, 120000) of
      when ClientUnit.ClientEvent.State(const VisibleValue):
        case VisibleValue of
          when Protocol.VisibleState.MapState(const MapValue):
            Test.AssertEquals(ExpectedMetadata.SpawnEntrance.X, MapValue.WorldX);
            Test.AssertEquals(ExpectedMetadata.SpawnEntrance.Y, MapValue.WorldY);
          when Protocol.VisibleState.FirstPersonState(_):
            panic('expected restored map client event');
        end case;
      when ClientUnit.ClientEvent.Connected(_), ClientUnit.ClientEvent.Worlds(_), ClientUnit.ClientEvent.ExplorationMap(_), ClientUnit.ClientEvent.Interaction(_, _), ClientUnit.ClientEvent.SaveCompleted, ClientUnit.ClientEvent.Rejected(_, _), ClientUnit.ClientEvent.MapRejected(_, _), ClientUnit.ClientEvent.Defeated(_), ClientUnit.ClientEvent.ViewportState(_), ClientUnit.ClientEvent.Failed(_), ClientUnit.ClientEvent.Dialogue(_, _, _), ClientUnit.ClientEvent.DialogueEnded(_, _), ClientUnit.ClientEvent.Disconnected:
        panic('expected exit state');
    end case;

    Test.AssertTrue(
      Tasks.SendWithTimeout(Requests, Protocol.ClientMessage.Disconnect, 1000).Unwrap()
    );
    Test.AssertTrue(Tasks.Wait(ClientTask).Unwrap());
    Test.AssertTrue(Tasks.Wait(ServerTask).Unwrap());
    discard Tasks.CloseChannel(Requests);
    discard Tasks.CloseChannel(Events);
    discard Tasks.CloseChannel(Outcomes);
    discard Tasks.CloseChannel(UiEvents);
  end scope;

  Test.AssertTrue(Net.CloseListener(ListenerValue).Unwrap());
end.
