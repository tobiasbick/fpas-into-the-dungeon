// Network test helpers for walking generated dungeons: routes as client intentions and pose reading.
unit Dungeon.Test.Routes;

uses
  Dungeon.Areas.Identities, Dungeon.Coordinates, Dungeon.Interior, Dungeon.Interior.Generation,
  Dungeon.Protocol, Dungeon.Terrain, Dungeon.Terrain.Entrances, Dungeon.Test.Fixtures, Std.Arrays,
  Std.Results, Std.Str;

// The spawn dungeon a server generates and stores for this world on first entry.
public function SpawnDungeonMap(Metadata: WorldMetadata): InteriorMap;
begin
  var Region: RegionCoordinate := RegionOf(Metadata, Metadata.Spawn);
  return Std.Results.Unwrap(GenerateDungeon(Metadata.Seed, Region.X, Region.Y, SpawnDungeonAreaId(Metadata)))
end;

// Converts one route move into the client intention that performs it.
public function RouteMessage(Move: RouteMove): ClientMessage;
begin
  case Move of
    RouteMove.RouteTurnLeft:
    begin
      return ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Left)
    end;
    RouteMove.RouteTurnRight:
    begin
      return ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Right)
    end;
    RouteMove.RouteForward:
    begin
      return ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward)
    end
  end
end;

// Reads the player's pose from a first-person projection.
public function VisiblePose(View: FirstPersonVisibleState): FirstPersonPose;
begin
  mutable var Facing: FacingDirection := FacingDirection.North;
  case View.Facing of
    FirstPersonFacing.East:
    begin
      Facing := FacingDirection.East
    end;
    FirstPersonFacing.South:
    begin
      Facing := FacingDirection.South
    end;
    FirstPersonFacing.West:
    begin
      Facing := FacingDirection.West
    end
    else
    begin
    end
  end;

  return record
    Position := record
      X := View.PlayerX;
      Y := View.PlayerY;
    end;
    Facing := Facing;
  end
end;

// Returns the field directly ahead of a projected player.
public function FieldAhead(View: FirstPersonVisibleState): InteriorPosition;
begin
  var Pose: FirstPersonPose := VisiblePose(View);
  var Offset: InteriorPosition := StepOffset(Pose.Facing, RelativeStep.Forward);
  return record
    X := Pose.Position.X + Offset.X;
    Y := Pose.Position.Y + Offset.Y;
  end
end;

// Returns whether a visible opponent stands on the field directly ahead.
public function HostileAhead(View: FirstPersonVisibleState): boolean;
begin
  var Ahead: InteriorPosition := FieldAhead(View);
  return Std.Str.CharAt(View.Rows[Ahead.Y], Ahead.X) = InteriorHostileCode
end;
