// Network test helpers for walking generated dungeons: routes as client intentions and pose reading.
unit Dungeon.Test.Routes;

uses Dungeon.Areas.Identities as Identities, Dungeon.Coordinates as Coordinates, Dungeon.Interior as InteriorUnit, Dungeon.Interior.Generation as Generation, Dungeon.Protocol as Protocol, Dungeon.Terrain as Terrain, Dungeon.Terrain.Chunks as ChunksUnit, Dungeon.Terrain.Entrances as Entrances, Dungeon.Test.Fixtures as Fixtures, Std.Math as Math;

// The spawn dungeon a server generates and stores for this world on first entry.
public function SpawnDungeonMap(Metadata: Terrain.WorldMetadata): InteriorUnit.InteriorMap;
begin
  const Region: Entrances.RegionCoordinate := Entrances.RegionOf(Metadata, Metadata.Spawn);
  return Generation.GenerateDungeon(
    Metadata.Seed,
    Region.X,
    Region.Y,
    Fixtures.SpawnDungeonAreaId(Metadata)
  ).Unwrap();
end function;

// Converts one route move into the client intention that performs it.
public function RouteMessage(Move: Fixtures.RouteMove): Protocol.ClientMessage;
begin
  case Move of
    when Fixtures.RouteMove.RouteTurnLeft:
      begin
        return Protocol.ClientMessage.TurnFirstPerson(Protocol.FirstPersonTurnDirection.Left);
      end;
    when Fixtures.RouteMove.RouteTurnRight:
      begin
        return Protocol.ClientMessage.TurnFirstPerson(Protocol.FirstPersonTurnDirection.Right);
      end;
    when Fixtures.RouteMove.RouteForward:
      begin
        return Protocol.ClientMessage.StepFirstPerson(Protocol.FirstPersonStepDirection.Forward);
      end;
  end case;
end function;

// Reads the player's pose from a first-person projection.
public function VisiblePose(View: Protocol.FirstPersonVisibleState): Coordinates.FirstPersonPose;
begin
  var Facing: Coordinates.FacingDirection := Coordinates.FacingDirection.North;
  case View.Facing of
    when Protocol.FirstPersonFacing.East:
      begin
        Facing := Coordinates.FacingDirection.East;
      end;
    when Protocol.FirstPersonFacing.South:
      begin
        Facing := Coordinates.FacingDirection.South;
      end;
    when Protocol.FirstPersonFacing.West:
      begin
        Facing := Coordinates.FacingDirection.West;
      end;
    when Protocol.FirstPersonFacing.North:
      begin
        null;
      end;
  end case;

  return Coordinates.FirstPersonPose(
    Position := Coordinates.InteriorPosition(X := View.PlayerX, Y := View.PlayerY),
    Facing := Facing
  );
end function;

// Returns the field directly ahead of a projected player.
public function FieldAhead(View: Protocol.FirstPersonVisibleState): Coordinates.InteriorPosition;
begin
  const Pose: Coordinates.FirstPersonPose := VisiblePose(View);
  const Offset: Coordinates.InteriorPosition := Coordinates.StepOffset(
    Pose.Facing,
    Coordinates.RelativeStep.Forward
  );
  return Coordinates.InteriorPosition(
    X := Pose.Position.X + Offset.X,
    Y := Pose.Position.Y + Offset.Y
  );
end function;

// Returns every field on which a projection shows a standing opponent.
public function VisibleHostiles(View: Protocol.FirstPersonVisibleState): array of Coordinates.InteriorPosition;
begin
  var Fields: array of Coordinates.InteriorPosition := [];
  for Y: integer := 0 to View.Rows.Length() - 1 do
    begin
      for X: integer := 0 to View.Rows[Y].Length() - 1 do
        begin
          if View.Rows[Y][X] = Protocol.InteriorHostileCode then
            begin
              Fields.PushInPlace(Coordinates.InteriorPosition(X := X, Y := Y));
            end;
          end if;
        end;
      end for;
    end;
  end for;

  return Fields;
end function;

// Returns whether a visible opponent stands on the field directly ahead.
public function HostileAhead(View: Protocol.FirstPersonVisibleState): boolean;
begin
  const Ahead: Coordinates.InteriorPosition := FieldAhead(View);
  return View.Rows[Ahead.Y][Ahead.X] = Protocol.InteriorHostileCode;
end function;

// Returns the walkable outdoor fields from From (exclusive) to Target along a shortest cardinal
// path inside the bounding box of both fields grown by Margin; empty when none exists there.
public function OutdoorRoute(
  Metadata: Terrain.WorldMetadata;
  From: Coordinates.WorldPosition;
  Target: Coordinates.WorldPosition;
  Margin: integer
): array of Coordinates.WorldPosition;
begin
  const Left: integer := Math.Min(From.X, Target.X) - Margin;
  const Top: integer := Math.Min(From.Y, Target.Y) - Margin;
  const Width: integer := ((Math.Max(From.X, Target.X) + Margin) - Left) + 1;
  const Height: integer := ((Math.Max(From.Y, Target.Y) + Margin) - Top) + 1;
  var Previous: array of integer := array.Fill(-1, Width * Height);
  const StartIndex: integer := ((From.Y - Top) * Width) + (From.X - Left);
  Previous[StartIndex] := StartIndex;
  var Queue: array of Coordinates.WorldPosition := [From];
  var ReadIndex: integer := 0;
  const TargetIndex: integer := ((Target.Y - Top) * Width) + (Target.X - Left);
  while (ReadIndex < Queue.Length()) and (Previous[TargetIndex] < 0) do
    begin
      const Current: Coordinates.WorldPosition := Queue[ReadIndex];
      ReadIndex := ReadIndex + 1;
      for Offset: Coordinates.WorldPosition in [
        Coordinates.WorldPosition(X := 1, Y := 0),
        Coordinates.WorldPosition(X := -1, Y := 0),
        Coordinates.WorldPosition(X := 0, Y := 1),
        Coordinates.WorldPosition(X := 0, Y := -1)
      ] do
        begin
          const Next: Coordinates.WorldPosition := Coordinates.WorldPosition(
            X := Current.X + Offset.X, Y := Current.Y +
            Offset.Y
          );
          if ((Next.X >= Left) and (Next.X < Left + Width))
            and
            ((Next.Y >= Top) and (Next.Y < Top + Height))
          then
            begin
              const Index: integer := ((Next.Y - Top) * Width) + (Next.X - Left);
              if Previous[Index] < 0 then
                begin
                  if Terrain.IsWalkable(ChunksUnit.GenerateWorldCell(Metadata, Next.X, Next.Y)) then
                    begin
                      Previous[Index] := ((Current.Y - Top) * Width) + (Current.X - Left);
                      Queue.PushInPlace(Next);
                    end;
                  end if;
                end;
              end if;
            end;
          end if;
        end;
      end for;
    end;
  end while;
  var Reversed: array of Coordinates.WorldPosition := [];
  if Previous[TargetIndex] < 0 then
    begin
      return Reversed;
    end;
  end if;
  var Index: integer := TargetIndex;
  while Index <> StartIndex do
    begin
      Reversed.PushInPlace(
        Coordinates.WorldPosition(X := Left + (Index mod Width), Y := Top + (Index div Width))
      );
      Index := Previous[Index];
    end;
  end while;
  var Path: array of Coordinates.WorldPosition := [];
  for Step: integer := Reversed.Length() - 1 downto 0 do
    begin
      Path.PushInPlace(Reversed[Step]);
    end;
  end for;

  return Path;
end function;
end unit;
