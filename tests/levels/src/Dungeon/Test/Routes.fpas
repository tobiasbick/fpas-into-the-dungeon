// Network test helpers for walking generated dungeons: routes as client intentions and pose reading.
unit Dungeon.Test.Routes;

uses
  Dungeon.Areas.Identities, Dungeon.Coordinates, Dungeon.Interior, Dungeon.Interior.Generation,
  Dungeon.Protocol, Dungeon.Terrain, Dungeon.Terrain.Chunks, Dungeon.Terrain.Entrances,
  Dungeon.Test.Fixtures, Std.Math;

// The spawn dungeon a server generates and stores for this world on first entry.
public function SpawnDungeonMap(Metadata: WorldMetadata): InteriorMap;
begin
  const Region: RegionCoordinate := RegionOf(Metadata, Metadata.Spawn);
  return GenerateDungeon(Metadata.Seed, Region.X, Region.Y, SpawnDungeonAreaId(Metadata)).Unwrap();
end function;

// Converts one route move into the client intention that performs it.
public function RouteMessage(Move: RouteMove): ClientMessage;
begin
  case Move of
    when RouteMove.RouteTurnLeft:
      begin
        return ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Left);
      end;
    when RouteMove.RouteTurnRight:
      begin
        return ClientMessage.TurnFirstPerson(FirstPersonTurnDirection.Right);
      end;
    when RouteMove.RouteForward:
      begin
        return ClientMessage.StepFirstPerson(FirstPersonStepDirection.Forward);
      end;
  end case;
end function;

// Reads the player's pose from a first-person projection.
public function VisiblePose(View: FirstPersonVisibleState): FirstPersonPose;
begin
  var Facing: FacingDirection := FacingDirection.North;
  case View.Facing of
    when FirstPersonFacing.East:
      begin
        Facing := FacingDirection.East;
      end;
    when FirstPersonFacing.South:
      begin
        Facing := FacingDirection.South;
      end;
    when FirstPersonFacing.West:
      begin
        Facing := FacingDirection.West;
      end;
    when firstpersonfacing.North:
      begin
        null;
      end;
  end case;

  return FirstPersonPose(Position := InteriorPosition(X := View.PlayerX, Y := View.PlayerY), Facing := Facing);
end function;

// Returns the field directly ahead of a projected player.
public function FieldAhead(View: FirstPersonVisibleState): InteriorPosition;
begin
  const Pose: FirstPersonPose := VisiblePose(View);
  const Offset: InteriorPosition := StepOffset(Pose.Facing, RelativeStep.Forward);
  return InteriorPosition(X := Pose.Position.X + Offset.X, Y := Pose.Position.Y + Offset.Y);
end function;

// Returns every field on which a projection shows a standing opponent.
public function VisibleHostiles(View: FirstPersonVisibleState): array of InteriorPosition;
begin
  var Fields: array of InteriorPosition := [];
  for Y: integer := 0 to View.Rows.Length() - 1 do
    begin
      for X: integer := 0 to View.Rows[Y].Length() - 1 do
        begin
          if View.Rows[Y].CharAt(X) = InteriorHostileCode then
            begin
              Fields.Push(InteriorPosition(X := X, Y := Y));
            end;
          end if;
        end;
      end for;
    end;
  end for;

  return Fields;
end function;

// Returns whether a visible opponent stands on the field directly ahead.
public function HostileAhead(View: FirstPersonVisibleState): boolean;
begin
  const Ahead: InteriorPosition := FieldAhead(View);
  return View.Rows[Ahead.Y].CharAt(Ahead.X) = InteriorHostileCode;
end function;

// Returns the walkable outdoor fields from From (exclusive) to Target along a shortest cardinal
// path inside the bounding box of both fields grown by Margin; empty when none exists there.
public function OutdoorRoute(
  Metadata: WorldMetadata;
  From: WorldPosition;
  Target: WorldPosition;
  Margin: integer
): array of WorldPosition;
begin
  const Left: integer := Std.Math.Min(From.X, Target.X) - Margin;
  const Top: integer := Std.Math.Min(From.Y, Target.Y) - Margin;
  const Width: integer := ((Std.Math.Max(From.X, Target.X) + Margin) - Left) + 1;
  const Height: integer := ((Std.Math.Max(From.Y, Target.Y) + Margin) - Top) + 1;
  var Previous: array of integer := array.Fill(-1, Width * Height);
  const StartIndex: integer := ((From.Y - Top) * Width) + (From.X - Left);
  Previous[StartIndex] := StartIndex;
  var Queue: array of WorldPosition := [From];
  var ReadIndex: integer := 0;
  const TargetIndex: integer := ((Target.Y - Top) * Width) + (Target.X - Left);
  while (ReadIndex < Queue.Length()) and (Previous[TargetIndex] < 0) do
    begin
      const Current: WorldPosition := Queue[ReadIndex];
      ReadIndex := ReadIndex + 1;
      for Offset: WorldPosition in [
                                     WorldPosition(X := 1, Y := 0),
                                     WorldPosition(X := -1, Y := 0),
                                     WorldPosition(X := 0, Y := 1),
                                     WorldPosition(X := 0, Y := -1)
                                   ] do
        begin
          const Next: WorldPosition := WorldPosition(X := Current.X + Offset.X, Y := Current.Y +
                                                                                     Offset.Y);
          if ((Next.X >= Left) and (Next.X < Left + Width)) and
             ((Next.Y >= Top) and (Next.Y < Top + Height)) then
            begin
              const Index: integer := ((Next.Y - Top) * Width) + (Next.X - Left);
              if Previous[Index] < 0 then
                begin
                  if IsWalkable(GenerateWorldCell(Metadata, Next.X, Next.Y)) then
                    begin
                      Previous[Index] := ((Current.Y - Top) * Width) + (Current.X - Left);
                      Queue.Push(Next);
                    end;
                  end if;
                end;
              end if;
            end;
          end if;
        end;
      end for;
    end;
  end while;
  var Reversed: array of WorldPosition := [];
  if Previous[TargetIndex] < 0 then
    begin
      return Reversed;
    end;
  end if;
  var Index: integer := TargetIndex;
  while Index <> StartIndex do
    begin
      Reversed.Push(WorldPosition(X := Left + (Index mod Width), Y := Top + (Index div Width)));
      Index := Previous[Index];
    end;
  end while;
  var Path: array of WorldPosition := [];
  for Step: integer := Reversed.Length() - 1 downto 0 do
    begin
      Path.Push(Reversed[Step]);
    end;
  end for;

  return Path;
end function;
end unit;
