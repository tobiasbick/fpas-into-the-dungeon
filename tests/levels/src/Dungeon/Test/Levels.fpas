// Test helpers that enter and validate against stored generated dungeon levels of a real world.
unit Dungeon.Test.Levels;

uses Dungeon.Areas as Areas, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Interior as Interior, Dungeon.Movement as Movement, Dungeon.Terrain as Terrain, Dungeon.Test.Fixtures as Fixtures, Dungeon.World as WorldUnit, Dungeon.World.Interiors as Interiors, Dungeon.World.Interiors.Errors as Errors, Dungeon.World.Savegame as Savegame;

// Returns the stored spawn dungeon level, generating and storing it on first use; panics on failure.
public function SpawnLevel(World: WorldUnit.WorldSession): Interior.InteriorMap;
begin
  const AtEntrance: GameState.GameState := GameState.NewGame(World.Metadata) with Player := Coordinates.PlayerPosition.Outdoor(
    World.Metadata.SpawnEntrance
  ); end with;

  case Interiors.OpenLevelForEntry(World, AtEntrance, Fixtures.SpawnDungeonAreaId(World.Metadata)) of
    when Ok(const Map):
      return Map;
    when Error(_):
      panic('the spawn dungeon level must be available');
  end case;
end function;

// Builds the area view of a state with the given stored level as its dungeon map, or none outdoors.
public function LevelView(World: WorldUnit.WorldSession; State: GameState.GameState; Map: Interior.InteriorMap): GameState.AreaView;
begin
  if State.Area = Coordinates.AreaKind.Dungeon then
    begin
      return GameState.AreaView(Metadata := World.Metadata, Interior := Some(Map));
    end;
  end if;

  return GameState.AreaView(Metadata := World.Metadata, Interior := None);
end function;

// Enters the spawn dungeon through the spawn entrance; the state's player is moved onto the entrance.
public function EnterSpawnLevel(World: WorldUnit.WorldSession; State: GameState.GameState): result of (GameState.GameState, string);
begin
  const AtEntrance: GameState.GameState := State with Player := Coordinates.PlayerPosition.Outdoor(
    World.Metadata.SpawnEntrance
  ); end with;
  const Map: Interior.InteriorMap := SpawnLevel(World);
  const Transition: Movement.AreaTransition := try Movement.ActivateAreaTransition(
    LevelView(World, AtEntrance, Map),
    AtEntrance,
    Some(Map)
  );
  return Ok(Transition.State);
end function;

// Leaves a dungeon whose stored level is Map; the player must stand on its exit.
public function LeaveLevel(World: WorldUnit.WorldSession; State: GameState.GameState; Map: Interior.InteriorMap): result of (GameState.GameState, string);
begin
  const Transition: Movement.AreaTransition := try Movement.ActivateAreaTransition(
    LevelView(World, State, Map),
    State,
    None
  );
  return Ok(Transition.State);
end function;

// Fully validates save text against the world's stored levels without touching the save file.
public function DecodeStoredSave(World: WorldUnit.WorldSession; Text: string): result of (GameState.GameState, string);
begin
  const State: GameState.GameState := try Savegame.DecodeSaveGameState(Text, World.Metadata);
  case Interiors.ReadVisitedLevels(World, State) of
    when Ok(const Maps):
      return Areas.ValidateSavedGame(World.Metadata, State, Maps);
    when Error(_):
      return Error('a visited level of the save is not readable');
  end case;
end function;
end unit;
