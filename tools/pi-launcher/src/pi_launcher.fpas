// Transparently starts Pi RPC with process-scoped trust for one marked game-owned directory.
program DungeonPiLauncher;

uses Std.Os.Args as Args, Std.Os.Env as Env, Std.Io.Fs as Fs, Std.Io.Path as Path, Std.Os.Proc as Proc;

begin
  const Root := Fs.CurrentDir().Unwrap();
  const Marker := Path.Join([Root, '.gamemaster-session']);
  const Expected := Env.Get('DUNGEON_PI_SESSION').Unwrap();
  if (Expected = '') or not Fs.IsFile(Marker) or Fs.IsSymLink(Marker) then
    panic('Pi launcher requires a game-owned session directory');
  end if;

  if Fs.ReadText(Marker).Unwrap() <> Expected then
    panic('Pi launcher session does not match');
  end if;
  var Arguments: array of string := [];
  case Env.Get('DUNGEON_PI_ENTRY') of
    when Some(const Entry):
      Arguments.PushInPlace(Entry);
    when None:
      null;
  end case;

  Arguments.PushInPlace('--approve');
  for Index: integer := 0 to Args.ParamCount() - 1 do
    Arguments.PushInPlace(Args.ParamStr(Index));
  end for;
  const ExitCode := Proc.Run(Env.Get('DUNGEON_PI_COMMAND').Unwrap(), Arguments).Unwrap();
  if ExitCode <> 0 then
    panic('Pi exited unsuccessfully');
  end if;
end.
