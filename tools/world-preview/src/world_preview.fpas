// Prints sampled terrain or one normalized generator field around a world's natural spawn.
program DungeonWorldPreview;

uses Dungeon.Game, Std.Args, Std.Console, Std.Conv;

function Shade(Value: integer): string;
begin
  if Value < 100 then
  begin
    return ' '
  end;

  if Value < 200 then
  begin
    return '.'
  end;

  if Value < 300 then
  begin
    return ':'
  end;

  if Value < 400 then
  begin
    return '-'
  end;

  if Value < 500 then
  begin
    return '='
  end;

  if Value < 600 then
  begin
    return '+'
  end;

  if Value < 700 then
  begin
    return '*'
  end;

  if Value < 800 then
  begin
    return '#'
  end;

  if Value < 900 then
  begin
    return '%'
  end;

  return '@'
end;

function FieldValue(Field: string; Sample: TerrainGenerationSample): integer;
begin
  if Field = 'continentalness' then
  begin
    return Sample.Continentalness
  end;

  if Field = 'land' then
  begin
    return Sample.LandScore
  end;

  if Field = 'elevation' then
  begin
    return Sample.Elevation
  end;

  if Field = 'ruggedness' then
  begin
    return Sample.Ruggedness
  end;

  if Field = 'moisture' then
  begin
    return Sample.Moisture
  end;

  if Field = 'vegetation' then
  begin
    return Sample.Vegetation
  end;

  if Field = 'lake-shape' then
  begin
    return Sample.LakeShape
  end;

  if Field = 'bridge' then
  begin
    return Sample.LandBridge
  end;

  panic('field must be terrain, continentalness, land, elevation, ruggedness, moisture, vegetation, lake-shape, or bridge')
end;

begin
  mutable var Field: string := 'terrain';
  mutable var Seed: integer := 12345;
  mutable var Step: integer := 256;
  mutable var Width: integer := 65;
  mutable var Height: integer := 33;
  mutable var CenterX: integer := 0;
  mutable var CenterY: integer := 0;
  if ParamCount() > 0 then
  begin
    Field := ParamStr(0)
  end;

  if ParamCount() > 1 then
  begin
    Seed := StrToInt(ParamStr(1))
  end;

  if ParamCount() > 2 then
  begin
    Step := StrToInt(ParamStr(2))
  end;

  if ParamCount() > 3 then
  begin
    Width := StrToInt(ParamStr(3))
  end;

  if ParamCount() > 4 then
  begin
    Height := StrToInt(ParamStr(4))
  end;

  if ParamCount() > 5 then
  begin
    CenterX := StrToInt(ParamStr(5))
  end;

  if ParamCount() > 6 then
  begin
    CenterY := StrToInt(ParamStr(6))
  end;

  if (ParamCount() = 6) or (ParamCount() > 7) then
  begin
    panic('usage: world-preview -- [FIELD [SEED [STEP [WIDTH [HEIGHT [CENTER_X CENTER_Y]]]]]]]')
  end;

  if (Step < 1) or ((Width < 1) or (Height < 1)) then
  begin
    panic('step, width, and height must be positive')
  end;
  var Metadata: WorldMetadata := NewWorldMetadata('preview', Seed);
  if ParamCount() < 6 then
  begin
    CenterX := Metadata.Spawn.X;
    CenterY := Metadata.Spawn.Y
  end;

  WriteLn((((('field=' + Field) + ' seed=') + IntToStr(Seed)) + ' step=') + IntToStr(Step));
  WriteLn(((('spawn=') + IntToStr(Metadata.Spawn.X)) + ',') + IntToStr(Metadata.Spawn.Y));
  for Row: integer := 0 to Height - 1 do
  begin
    mutable var Text: string := '';
    var Y: integer := CenterY + ((Row - (Height div 2)) * Step);
    for Column: integer := 0 to Width - 1 do
    begin
      var X: integer := CenterX + ((Column - (Width div 2)) * Step);
      if Field = 'terrain' then
      begin
        Text := Text + VisibleCellCode(GenerateWorldCell(Metadata, X, Y))
      end
      else
      begin
        Text := Text + Shade(FieldValue(Field, SampleWorldGeneration(Metadata, X, Y)))
      end
    end;

    WriteLn(Text)
  end
end.
