// Prints sampled terrain or one normalized generator field around a world's natural spawn.
program DungeonWorldPreview;

uses Dungeon.Terrain as Terrain, Dungeon.Terrain.Chunks as ChunksUnit, Dungeon.Terrain.Generation as TerrainGeneration, Dungeon.Terrain.Placement as PlacementRules, Std.Args as Args, Std.Console as Console, Std.Conv as Conv, Std.Parse as Parse;

function Shade(Value: integer): string;
begin
  if Value < 100 then
    begin
      return ' ';
    end;
  end if;

  if Value < 200 then
    begin
      return '.';
    end;
  end if;

  if Value < 300 then
    begin
      return ':';
    end;
  end if;

  if Value < 400 then
    begin
      return '-';
    end;
  end if;

  if Value < 500 then
    begin
      return '=';
    end;
  end if;

  if Value < 600 then
    begin
      return '+';
    end;
  end if;

  if Value < 700 then
    begin
      return '*';
    end;
  end if;

  if Value < 800 then
    begin
      return '#';
    end;
  end if;

  if Value < 900 then
    begin
      return '%';
    end;
  end if;

  return '@';
end function;

function FieldValue(Field: string; Sample: Terrain.TerrainGenerationSample): integer;
begin
  if Field = 'continentalness' then
    begin
      return Sample.Continentalness;
    end;
  end if;

  if Field = 'land' then
    begin
      return Sample.LandScore;
    end;
  end if;

  if Field = 'elevation' then
    begin
      return Sample.Elevation;
    end;
  end if;

  if Field = 'ruggedness' then
    begin
      return Sample.Ruggedness;
    end;
  end if;

  if Field = 'moisture' then
    begin
      return Sample.Moisture;
    end;
  end if;

  if Field = 'vegetation' then
    begin
      return Sample.Vegetation;
    end;
  end if;

  if Field = 'lake-shape' then
    begin
      return Sample.LakeShape;
    end;
  end if;

  if Field = 'bridge' then
    begin
      return Sample.LandBridge;
    end;
  end if;

  panic(
    'field must be terrain, continentalness, land, elevation, ruggedness, moisture, vegetation, lake-shape, or bridge'
  );
end function;

begin
  var Field: string := 'terrain';
  var Seed: integer := 12345;
  var Step: integer := 256;
  var Width: integer := 65;
  var Height: integer := 33;
  var CenterX: integer := 0;
  var CenterY: integer := 0;
  if Args.ParamCount() > 0 then
    begin
      Field := Args.ParamStr(0);
    end;
  end if;

  if Args.ParamCount() > 1 then
    begin
      Seed := Parse.Int(Args.ParamStr(1)).Unwrap();
    end;
  end if;

  if Args.ParamCount() > 2 then
    begin
      Step := Parse.Int(Args.ParamStr(2)).Unwrap();
    end;
  end if;

  if Args.ParamCount() > 3 then
    begin
      Width := Parse.Int(Args.ParamStr(3)).Unwrap();
    end;
  end if;

  if Args.ParamCount() > 4 then
    begin
      Height := Parse.Int(Args.ParamStr(4)).Unwrap();
    end;
  end if;

  if Args.ParamCount() > 5 then
    begin
      CenterX := Parse.Int(Args.ParamStr(5)).Unwrap();
    end;
  end if;

  if Args.ParamCount() > 6 then
    begin
      CenterY := Parse.Int(Args.ParamStr(6)).Unwrap();
    end;
  end if;

  if (Args.ParamCount() = 6) or (Args.ParamCount() > 7) then
    begin
      panic('usage: world-preview -- [FIELD [SEED [STEP [WIDTH [HEIGHT [CENTER_X CENTER_Y]]]]]]]');
    end;
  end if;

  if (Step < 1) or ((Width < 1) or (Height < 1)) then
    begin
      panic('step, width, and height must be positive');
    end;
  end if;
  const Metadata: Terrain.WorldMetadata := PlacementRules.NewWorldMetadata(
    'preview',
    Seed,
    4
  ).Unwrap();
  if Args.ParamCount() < 6 then
    begin
      CenterX := Metadata.Spawn.X;
      CenterY := Metadata.Spawn.Y;
    end;
  end if;

  Console.WriteLn(
    (((('field=' + Field) + ' seed=') + Conv.IntToStr(Seed)) + ' step=') + Conv.IntToStr(Step)
  );
  Console.WriteLn(
    ((('spawn=') + Conv.IntToStr(Metadata.Spawn.X)) + ',') + Conv.IntToStr(Metadata.Spawn.Y)
  );
  for Row: integer := 0 to Height - 1 do
    begin
      var Text: string := '';
      const Y: integer := CenterY + ((Row - (Height div 2)) * Step);
      for Column: integer := 0 to Width - 1 do
        begin
          const X: integer := CenterX + ((Column - (Width div 2)) * Step);
          if Field = 'terrain' then
            begin
              Text := Text + Terrain.VisibleCellCode(ChunksUnit.GenerateWorldCell(Metadata, X, Y));
            end;
          else
            begin
              Text := Text +
                Shade(FieldValue(Field, TerrainGeneration.SampleWorldGeneration(Metadata, X, Y)));
            end;
          end if;
        end;
      end for;

      Console.WriteLn(Text);
    end;
  end for;
end.
