// Measures first-entry level creation and complete save and load for a chosen number of visited dungeons.
// Usage: fpas run tools/persistence-bench/persistence-bench.fpasprj -- <visited dungeons> [repetitions]
program PersistenceBench;

uses
  Dungeon.Areas.Identities, Dungeon.Coordinates, Dungeon.Exploration, Dungeon.GameState,
  Dungeon.Interior, Dungeon.Items, Dungeon.Movement, Dungeon.Terrain, Dungeon.Terrain.Entrances,
  Dungeon.Terrain.Placement, Dungeon.World, Dungeon.World.Interiors, Dungeon.World.Savegame,
  Std.Arrays, Std.Args, Std.Console, Std.Conv, Std.Fs, Std.Math, Std.Path, Std.Results, Std.Str,
  Std.Time;

// Returns the first Count entrance regions, ring by ring around the spawn region.
function EntranceRegions(Metadata: WorldMetadata; Count: integer): array of RegionCoordinate;
begin
  var Spawn: RegionCoordinate := RegionOf(Metadata, Metadata.Spawn);
  mutable var Regions: array of RegionCoordinate := [Spawn];
  mutable var Ring: integer := 1;
  while Std.Arrays.Length(Regions) < Count do
  begin
    for DeltaY: integer := - Ring to Ring do
    begin
      for DeltaX: integer := - Ring to Ring do
      begin
        if (Std.Math.Max(Std.Math.Abs(DeltaX), Std.Math.Abs(DeltaY)) = Ring) and
           (Std.Arrays.Length(Regions) < Count) then
        begin
          var Region: RegionCoordinate := record
            X := Spawn.X + DeltaX;
            Y := Spawn.Y + DeltaY;
          end;

          case EntranceSite(Metadata, Region) of
            Some(Site):
            begin
              Std.Arrays.Push(Regions, Region)
            end
            else
            begin
            end
          end
        end
      end
    end;

    Ring := Ring + 1
  end;

  return Regions
end;

function SiteOf(Metadata: WorldMetadata; Region: RegionCoordinate): WorldPosition;
begin
  case EntranceSite(Metadata, Region) of
    Some(Site):
    begin
      return Site
    end
    else
    begin
      panic('region lost its entrance site')
    end
  end
end;

function ItemIndex(State: GameState; Id: string): integer;
begin
  for Index: integer := 0 to Std.Arrays.Length(State.Items) - 1 do
  begin
    if State.Items[Index].Id = Id then
    begin
      return Index
    end
  end;

  panic('item not found')
end;

begin
  var Count: integer := StrToInt(ParamStr(0));
  mutable var Repetitions: integer := 3;
  if ParamCount() > 1 then
  begin
    Repetitions := StrToInt(ParamStr(1))
  end;
  var Root: string := Std.Path.Join([
                                      '.temp-data',
                                      'persistence-bench-' + IntToStr(TimestampMillis())
                                    ]);
  var World: WorldSession := Unwrap(OpenWorld(Root, 'bench', 24680, 1, 64));
  var Metadata: WorldMetadata := World.Metadata;
  var Regions: array of RegionCoordinate := EntranceRegions(Metadata, Count);
  mutable var State: GameState := NewGame(Metadata);
  mutable var Maps: array of InteriorMap := [];
  mutable var EntryMillis: integer := 0;
  // Visit every dungeon once: discovery, a destroyed or surviving opponent, carried coins, and swords
  // transferred onto the next dungeon's entry field.
  for Index: integer := 0 to Std.Arrays.Length(Regions) - 1 do
  begin
    var AreaId: string := DungeonAreaId(Metadata, Regions[Index]);
    var Outside: GameState := State with Player := PlayerPosition.Outdoor(SiteOf(Metadata, Regions[Index])); end;
    var Started: integer := MonotonicMillis();
    var Map: InteriorMap := Unwrap(OpenLevelForEntry(World, Outside, AreaId));
    EntryMillis := EntryMillis + ElapsedMillis(Started);
    Std.Arrays.Push(Maps, Map);
    var OutdoorView: AreaView := record
      Metadata := Metadata;
      Interior := None;
    end;
    var Entered: AreaTransition := Unwrap(ActivateAreaTransition(OutdoorView, Outside, Some(Map)));
    mutable var Inside: GameState := Unwrap(RevealCurrentArea(Entered.View, Entered.State));
    if Index mod 2 = 0 then
    begin
      for HostileIndex: integer := 0 to Std.Arrays.Length(Inside.Hostiles) - 1 do
      begin
        if Inside.Hostiles[HostileIndex].Id = Map.Hostiles[0].Id then
        begin
          Inside.Hostiles[HostileIndex] := Inside.Hostiles[HostileIndex] with Health := 0; end
        end
      end
    end;

    if Std.Arrays.Length(InventoryItems(Inside)) < MaximumInventoryItems then
    begin
      var Coin: integer := ItemIndex(Inside, Map.Items[0].ItemId);
      Inside.Items[Coin] := Inside.Items[Coin] with Location := ItemLocation.CarriedByPlayer; end
    end;

    if Index > 0 then
    begin
      var Sword: integer := ItemIndex(Inside, Maps[Index - 1].Items[1].ItemId);
      Inside.Items[Sword] := Inside.Items[Sword] with Location := ItemLocation.InInterior(AreaId, Map.Start); end
    end;
    var AtExit: GameState := Inside with Player := PlayerPosition.FirstPerson(record
      Position := Map.Exit;
      Facing := Map.StartFacing;
    end); end;

    State := Unwrap(ActivateAreaTransition(Entered.View, AtExit, None)).State
  end;

  WriteLn((((('visited=' + IntToStr(Count)) + ' items=') + IntToStr(Std.Arrays.Length(State.Items))) + ' first_entry_total_ms=') +
          IntToStr(EntryMillis));
  for Round: integer := 1 to Repetitions do
  begin
    var SaveStarted: integer := MonotonicMillis();
    var Written: boolean := Unwrap(WriteSaveGame(World, State));
    var SaveMillis: integer := ElapsedMillis(SaveStarted);
    var LoadStarted: integer := MonotonicMillis();
    var Loaded: SaveGameLoad := Unwrap(LoadSaveGame(World));
    var LoadMillis: integer := ElapsedMillis(LoadStarted);
    case Loaded of
      SaveGameLoad.Loaded(LoadedState, View):
      begin
        WriteLn((((('round=' + IntToStr(Round)) + ' save_ms=') + IntToStr(SaveMillis)) + ' load_ms=') +
                IntToStr(LoadMillis))
      end
      else
      begin
        panic('the saved state must load')
      end
    end
  end;
  var SaveBytes: integer := Std.Str.Length(Unwrap(Std.Fs.ReadText(SaveGamePath(World))));
  WriteLn('save_bytes=' + IntToStr(SaveBytes))
end.
