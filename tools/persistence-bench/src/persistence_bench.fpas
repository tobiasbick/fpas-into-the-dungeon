// Measures first-entry level creation and complete save and load for a chosen number of visited dungeons.
// Usage: fpas run tools/persistence-bench/persistence-bench.fpasprj -- <visited dungeons> [repetitions]
program PersistenceBench;

uses
  Dungeon.Areas.Identities, Dungeon.Coordinates, Dungeon.Exploration, Dungeon.GameState,
  Dungeon.Interior, Dungeon.Items, Dungeon.Movement, Dungeon.Terrain, Dungeon.Terrain.Entrances,
  Dungeon.Terrain.Placement, Dungeon.World, Dungeon.World.Interiors, Dungeon.World.Savegame,
  Std.Args, Std.Console, Std.Conv, Std.Fs, Std.Math, Std.Path, Std.Time;

// Returns the first Count entrance regions, ring by ring around the spawn region.
function EntranceRegions(Metadata: WorldMetadata; Count: integer): array of RegionCoordinate;
begin
  const Spawn: RegionCoordinate := RegionOf(Metadata, Metadata.Spawn);
  var Regions: array of RegionCoordinate := [Spawn];
  var Ring: integer := 1;
  while Regions.Length() < Count do
    begin
      for DeltaY: integer := - Ring to Ring do
        begin
          for DeltaX: integer := - Ring to Ring do
            begin
              if (Std.Math.Max(Std.Math.Abs(DeltaX), Std.Math.Abs(DeltaY)) = Ring) and
                 (Regions.Length() < Count) then
                begin
                  const Region: RegionCoordinate := RegionCoordinate(X := Spawn.X + DeltaX, Y := Spawn.Y +
                                                                                                 DeltaY);
                  if EntranceSite(Metadata, Region) is Some(const Site) then
                    begin
                      Regions.Push(Region);
                    end;
                  else
                    begin
                      null;
                    end;
                  end if;
                end;
              end if;
            end;
          end for;
        end;
      end for;

      Ring := Ring + 1;
    end;
  end while;

  return Regions;
end function;

function SiteOf(Metadata: WorldMetadata; Region: RegionCoordinate): WorldPosition;
begin
  if EntranceSite(Metadata, Region) is Some(const Site) then
    begin
      return Site;
    end;
  else
    begin
      panic('region lost its entrance site');
    end;
  end if;
end function;

function ItemIndex(State: GameState; Id: string): integer;
begin
  for Index: integer := 0 to State.Items.Length() - 1 do
    begin
      if State.Items[Index].Id = Id then
        begin
          return Index;
        end;
      end if;
    end;
  end for;

  panic('item not found');
end function;

begin
  const Count: integer := StrToInt(ParamStr(0));
  var Repetitions: integer := 3;
  if ParamCount() > 1 then
    begin
      Repetitions := StrToInt(ParamStr(1));
    end;
  end if;
  const Root: string := Std.Path.Join([
                                        '.temp-data',
                                        'persistence-bench-' + IntToStr(TimestampMillis())
                                      ]);
  const World: WorldSession := OpenWorld(Root, 'bench', 24680, 1, 64).Unwrap();
  const Metadata: WorldMetadata := World.Metadata;
  const Regions: array of RegionCoordinate := EntranceRegions(Metadata, Count);
  var State: GameState := NewGame(Metadata);
  var Maps: array of InteriorMap := [];
  var EntryMillis: integer := 0;
  // Visit every dungeon once: discovery, a destroyed or surviving opponent, carried coins, and swords
  // transferred onto the next dungeon's entry field.
  for Index: integer := 0 to Regions.Length() - 1 do
    begin
      const AreaId: string := DungeonAreaId(Metadata, Regions[Index]);
      const Outside: GameState := State with Player := PlayerPosition.Outdoor(SiteOf(Metadata, Regions[Index])); end with;
      const Started: integer := MonotonicMillis();
      const Map: InteriorMap := OpenLevelForEntry(World, Outside, AreaId).Unwrap();
      EntryMillis := EntryMillis + ElapsedMillis(Started);
      Maps.Push(Map);
      const OutdoorView: AreaView := AreaView(Metadata := Metadata, Interior := None);
      const Entered: AreaTransition := ActivateAreaTransition(OutdoorView, Outside, Some(Map))
                                         .Unwrap();
      var Inside: GameState := RevealCurrentArea(Entered.View, Entered.State).Unwrap();
      if Index mod 2 = 0 then
        begin
          for HostileIndex: integer := 0 to Inside.Hostiles.Length() - 1 do
            begin
              if Inside.Hostiles[HostileIndex].Id = Map.Hostiles[0].Id then
                begin
                  Inside.Hostiles[HostileIndex] := Inside.Hostiles[HostileIndex] with Health := 0; end with;
                end;
              end if;
            end;
          end for;
        end;
      end if;

      if InventoryItems(Inside).Length() < MaximumInventoryItems then
        begin
          const Coin: integer := ItemIndex(Inside, Map.Items[0].ItemId);
          Inside.Items[Coin] := Inside.Items[Coin] with Location := ItemLocation.CarriedByPlayer; end with;
        end;
      end if;

      if Index > 0 then
        begin
          const Sword: integer := ItemIndex(Inside, Maps[Index - 1].Items[1].ItemId);
          Inside.Items[Sword] := Inside.Items[Sword] with Location := ItemLocation.InInterior(AreaId, Map.Start); end with;
        end;
      end if;
      const AtExit: GameState := Inside with Player := PlayerPosition.FirstPerson(FirstPersonPose(Position := Map.Exit, Facing := Map.StartFacing)); end with;

      State := ActivateAreaTransition(Entered.View, AtExit, None).Unwrap().State;
    end;
  end for;

  WriteLn((((('visited=' + IntToStr(Count)) + ' items=') + IntToStr(State.Items.Length())) + ' first_entry_total_ms=') +
          IntToStr(EntryMillis));
  for Round: integer := 1 to Repetitions do
    begin
      const SaveStarted: integer := MonotonicMillis();
      const Written: boolean := WriteSaveGame(World, State).Unwrap();
      const SaveMillis: integer := ElapsedMillis(SaveStarted);
      const LoadStarted: integer := MonotonicMillis();
      const Loaded: SaveGameLoad := LoadSaveGame(World).Unwrap();
      const LoadMillis: integer := ElapsedMillis(LoadStarted);
      if Loaded is SaveGameLoad.Loaded(const LoadedState, const View) then
        begin
          WriteLn((((('round=' + IntToStr(Round)) + ' save_ms=') + IntToStr(SaveMillis)) + ' load_ms=') +
                  IntToStr(LoadMillis));
        end;
      else
        begin
          panic('the saved state must load');
        end;
      end if;
    end;
  end for;
  const SaveBytes: integer := Std.Fs.ReadText(SaveGamePath(World)).Unwrap().Length();
  WriteLn('save_bytes=' + IntToStr(SaveBytes));
end.
