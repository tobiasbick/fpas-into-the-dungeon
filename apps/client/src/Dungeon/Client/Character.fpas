// Inventory overlay, character sheet, and equipment summaries built from server projections.
unit Dungeon.Client.Character;

uses Dungeon.Client.Model as Model, Dungeon.Protocol as Protocol, Std.Conv as Conv, Std.Tui as Tui;

function SlotLabel(Slot: Protocol.VisibleItemSlot): string;
begin
  case Slot of
    when Protocol.VisibleItemSlot.Weapon:
      begin
        return 'Weapon';
      end;
    when Protocol.VisibleItemSlot.Body:
      begin
        return 'Body';
      end;
    when Protocol.VisibleItemSlot.NoSlot:
      begin
        return '';
      end;
  end case;
end function;

// Returns one line per worn item, such as `Weapon: Rusty short sword`, or `Nothing worn`.
public function EquipmentLines(Inventory: array of Protocol.VisibleInventoryItem): array of string;
begin
  var Lines: array of string := [];
  for Item: Protocol.VisibleInventoryItem in Inventory do
    begin
      if Item.Equipped then
        begin
          Lines.PushInPlace((SlotLabel(Item.Slot) + ': ') + Item.Name);
        end;
      end if;
    end;
  end for;

  if Lines.Length() = 0 then
    begin
      return ['Nothing worn'];
    end;
  end if;

  return Lines;
end function;

// Returns the names of carried items that are not worn, in projection order.
public function CarriedItemNames(Inventory: array of Protocol.VisibleInventoryItem): array of string;
begin
  var Names: array of string := [];
  for Item: Protocol.VisibleInventoryItem in Inventory do
    begin
      if not Item.Equipped then
        begin
          Names.PushInPlace(Item.Name);
        end;
      end if;
    end;
  end for;

  return Names;
end function;

// Moves the inventory selection by Delta, wrapping at both ends; an empty inventory selects 0.
public function MoveInventorySelection(State: Model.ClientModel; Delta: integer): Model.ClientModel;
begin
  const Count: integer := State.Inventory.Length();
  var Next: Model.ClientModel := State;
  if Count = 0 then
    begin
      Next.InventorySelection := 0;
      return Next;
    end;
  end if;
  var Selection: integer := (State.InventorySelection + Delta) mod Count;
  if Selection < 0 then
    begin
      Selection := Selection + Count;
    end;
  end if;

  Next.InventorySelection := Selection;
  return Next;
end function;

// Keeps the selected identity across an authoritative refresh; if removed, clamps its old index.
// Explicit navigation still wraps through MoveInventorySelection; an empty inventory selects 0.
public function ReconcileInventorySelection(Previous: Model.ClientModel; Updated: Model.ClientModel): Model.ClientModel;
begin
  var Next := Updated;
  if (Previous.InventorySelection >= 0)
    and
    (Previous.InventorySelection < Previous.Inventory.Length())
  then
    const Id := Previous.Inventory[Previous.InventorySelection].Id;
    for Index: integer := 0 to Updated.Inventory.Length() - 1 do
      if Updated.Inventory[Index].Id = Id then
        Next.InventorySelection := Index;
        return Next;
      end if;
    end for;
  end if;

  Next.InventorySelection := Previous.InventorySelection;
  if Next.InventorySelection >= Updated.Inventory.Length() then
    Next.InventorySelection := Updated.Inventory.Length() - 1;
  end if;

  if Next.InventorySelection < 0 then
    Next.InventorySelection := 0;
  end if;

  return Next;
end function;

// Returns Enter's server intention from projected capability: use, then remove or wear.
// No name or health rule is inferred here; the server validates every request.
public function SelectedItemRequest(State: Model.ClientModel): option of Protocol.ClientMessage;
begin
  if (State.InventorySelection < 0) or (State.InventorySelection >= State.Inventory.Length()) then
    begin
      return None;
    end;
  end if;
  const Item: Protocol.VisibleInventoryItem := State.Inventory[State.InventorySelection];
  if Item.Usable then
    return Some(Protocol.ClientMessage.UseItem(Item.Id));
  end if;

  if Item.Equipped then
    begin
      return Some(Protocol.ClientMessage.Unequip(Item.Id));
    end;
  end if;

  if Item.Slot <> Protocol.VisibleItemSlot.NoSlot then
    begin
      return Some(Protocol.ClientMessage.Equip(Item.Id));
    end;
  end if;

  return None;
end function;

// Returns the intention for D on the selected item; the server decides whether it may be dropped.
public function SelectedDropRequest(State: Model.ClientModel): option of Protocol.ClientMessage;
begin
  if (State.InventorySelection < 0) or (State.InventorySelection >= State.Inventory.Length()) then
    begin
      return None;
    end;
  end if;

  return Some(Protocol.ClientMessage.DropItem(State.Inventory[State.InventorySelection].Id));
end function;

function InventoryEntry(Item: Protocol.VisibleInventoryItem; Selected: boolean): string;
begin
  var Prefix: string := '  ';
  if Selected then
    begin
      Prefix := '> ';
    end;
  end if;

  if Item.Usable then
    return Prefix + Item.Name + ' — usable';
  end if;

  if Item.Equipped then
    begin
      return ((Prefix + Item.Name) + ' — worn as ') + SlotLabel(Item.Slot);
    end;
  end if;

  if Item.Slot = Protocol.VisibleItemSlot.NoSlot then
    begin
      return (Prefix + Item.Name) + ' — no Enter action';
    end;
  end if;

  return ((Prefix + Item.Name) + ' — ') + SlotLabel(Item.Slot);
end function;

function SelectedActionLabel(State: Model.ClientModel): string;
begin
  if (State.InventorySelection < 0) or (State.InventorySelection >= State.Inventory.Length()) then
    return 'Enter: No action';
  end if;
  const Item := State.Inventory[State.InventorySelection];
  if Item.Usable then
    return 'Enter: Use';
  end if;

  if Item.Equipped then
    return 'Enter: Remove';
  end if;

  if Item.Slot <> Protocol.VisibleItemSlot.NoSlot then
    return 'Enter: Wear';
  end if;

  return 'Enter: No action';
end function;

// Renders the inventory overlay with the current selection and its controls.
public function ViewInventory(State: Model.ClientModel): Tui.TuiElement;
begin
  var Content: array of Tui.TuiElement := [];
  if State.Inventory.Length() = 0 then
    begin
      Content.PushInPlace(Tui.TuiElementBuilders.MakeLabel('You carry nothing.'));
    end;
  else
    begin
      for Index: integer := 0 to State.Inventory.Length() - 1 do
        begin
          Content.PushInPlace(
            Tui.TuiElementBuilders.MakeLabel(
              InventoryEntry(
                State.Inventory[Index], Index =
                State.InventorySelection
              )
            )
          );
        end;
      end for;
    end;
  end if;

  Content.PushInPlace(Tui.TuiElementBuilders.MakeLabel(''));
  Content.PushInPlace(
    Tui.TuiElementBuilders.MakeLabel(
      'Health ' + Conv.IntToStr(State.Health) + '/' + Conv.IntToStr(State.MaxHealth)
    )
  );
  Content.PushInPlace(Tui.TuiElementBuilders.MakeLabel(SelectedActionLabel(State)));
  Content.PushInPlace(
    Tui.TuiElementBuilders.MakeLabel('W/S or arrows select  D drop  Esc close')
  );
  Content.PushInPlace(
    Tui.TuiElementBuilders.MakeLabel('Using, changing or dropping an item takes one turn.')
  );
  return Tui.TuiElementBuilders.MakeOverlay(
    'Inventory',
    [Tui.TuiElementBuilders.MakeColumn(Content)]
  );
end function;

// Renders the character sheet: health, derived values with their sources, and the equipment.
public function ViewCharacterSheet(State: Model.ClientModel): Tui.TuiElement;
begin
  var Content: array of Tui.TuiElement := [
    Tui.TuiElementBuilders.MakeLabel(
      (('Health         ' + Conv.IntToStr(State.Health)) + '/') +
      Conv.IntToStr(State.MaxHealth)
    )
  ];
  for Line: Protocol.VisibleCharacterValue in State.Character do
    begin
      var Label: string := Line.Label;
      while Label.Length() < 15 do
        begin
          Label := Label + ' ';
        end;
      end while;

      Content.PushInPlace(
        Tui.TuiElementBuilders.MakeLabel(((Label + Line.Value) + '  · ') + Line.Source)
      );
    end;
  end for;

  Content.PushInPlace(Tui.TuiElementBuilders.MakeRule('Equipment'));
  for Line: string in EquipmentLines(State.Inventory) do
    begin
      Content.PushInPlace(Tui.TuiElementBuilders.MakeLabel(Line));
    end;
  end for;

  Content.PushInPlace(Tui.TuiElementBuilders.MakeLabel(''));
  Content.PushInPlace(Tui.TuiElementBuilders.MakeLabel('I inventory  Esc close'));
  return Tui.TuiElementBuilders.MakeOverlay(
    'Character',
    [Tui.TuiElementBuilders.MakeColumn(Content)]
  );
end function;
end unit;
