// Functional Pascal TUI state transitions and rendering for the dungeon client.
unit Dungeon.Client.Ui;

uses
  Dungeon.Client.Model, Dungeon.Client.Network, Dungeon.Client.Raycast, Dungeon.Protocol,
  Dungeon.RuntimeData, Std.Arrays, Std.Console, Std.Conv, Std.Options, Std.Str, Std.Task, Std.Tui;

const
  NetworkSubscriptionId: integer := 1;
  ConnectControlId: integer := 1;
  StartInformationControlId: integer := 2;
  StartQuitControlId: integer := 3;
  NewGameControlId: integer := 4;
  LoadGameControlId: integer := 5;
  StartDisconnectControlId: integer := 6;
  ResumeControlId: integer := 10;
  SystemInformationControlId: integer := 11;
  DisconnectControlId: integer := 12;
  SystemQuitControlId: integer := 13;
  SaveControlId: integer := 14;
  OverlayBackControlId: integer := 20;
  PanelCloseControlId: integer := 21;
  ConfirmSaveControlId: integer := 30;
  CancelSaveControlId: integer := 31;
  ConnectAction: integer := 101;
  InformationAction: integer := 102;
  QuitAction: integer := 103;
  NewGameAction: integer := 104;
  LoadGameAction: integer := 105;
  ResumeAction: integer := 110;
  DisconnectAction: integer := 111;
  SaveAction: integer := 112;
  BackAction: integer := 120;
  ClosePanelAction: integer := 121;
  ConfirmSaveAction: integer := 130;
  CancelSaveAction: integer := 131;
  MinimumDockedContextWidth: integer := 72;
  MinimumDockedMessagesHeight: integer := 18;
  MaximumMessages: integer := 8;
  DockedMessageLines: integer := 4;
  MessagePanelHeight: integer := 6;
  StatusPanelHeight: integer := 3;

type
  WorldViewport = record
    Width: integer;
    Height: integer;
  end;

function AppendMessage(State: ClientModel; Text: string): ClientModel;
begin
  mutable var Next: ClientModel := State;
  mutable var Values: array of string := Std.Arrays.Concat(State.Messages, [Text]);
  if Std.Arrays.Length(Values) > MaximumMessages then
  begin
    Values := Std.Arrays.Slice(Values, Std.Arrays.Length(Values) - MaximumMessages, MaximumMessages)
  end;

  Next.Messages := Values;
  return Next
end;

function HasCharacter(Key: TuiKeyEvent; Lower: string; Upper: string): boolean;
begin
  return (Key.kind = TuiKeyKind.Character) and ((Key.ch = Lower) or (Key.ch = Upper))
end;

function IsCtrlCharacter(Key: TuiKeyEvent; Lower: string; Upper: string): boolean;
begin
  return (HasCharacter(Key, Lower, Upper) and Key.ctrl) and not Key.alt
end;

function IsAltCharacter(Key: TuiKeyEvent; Lower: string; Upper: string): boolean;
begin
  return (HasCharacter(Key, Lower, Upper) and Key.alt) and not Key.ctrl
end;

function ContextCanDock(State: ClientModel): boolean;
begin
  return State.ViewportWidth >= MinimumDockedContextWidth
end;

function MessagesCanDock(State: ClientModel): boolean;
begin
  return State.ViewportHeight >= MinimumDockedMessagesHeight
end;

function PrimaryTerminalWidth(State: ClientModel): integer;
begin
  if State.ContextPanelVisible and ContextCanDock(State) then
  begin
    return (State.ViewportWidth * 2) div 3
  end;

  return State.ViewportWidth
end;

function DesiredWorldViewport(State: ClientModel): WorldViewport;
begin
  var PrimaryWidth: integer := PrimaryTerminalWidth(State);
  mutable var PrimaryHeight: integer := State.ViewportHeight - StatusPanelHeight;
  if State.MessagePanelVisible and MessagesCanDock(State) then
  begin
    PrimaryHeight := PrimaryHeight - MessagePanelHeight
  end;
  mutable var Width: integer := PrimaryWidth - 2;
  if not State.HasVisibleState or (State.View = ViewKind.Map) then
  begin
    Width := Width div 2
  end;
  mutable var Height: integer := PrimaryHeight - 2;
  if Width < 1 then
  begin
    Width := 1
  end;

  if Height < 1 then
  begin
    Height := 1
  end;

  return record
    Width := Width;
    Height := Height;
  end
end;

function QueueViewport(State: ClientModel): ClientModel;
begin
  if (State.ConnectionPhase <> ClientConnectionPhase.Active) or State.Pending then
  begin
    return State
  end;
  var Desired: WorldViewport := DesiredWorldViewport(State);
  if (Desired.Width = State.RequestedWorldWidth) and (Desired.Height = State.RequestedWorldHeight) then
  begin
    return State
  end;

  case TrySend(State.Requests, ClientMessage.Viewport(Desired.Width, Desired.Height)) of
    Ok(Queued):
    begin
      if not Queued then
      begin
        return State
      end;
      mutable var Next: ClientModel := State;
      Next.RequestedWorldWidth := Desired.Width;
      Next.RequestedWorldHeight := Desired.Height;
      Next.Pending := true;
      Next.Status := 'Updating view...';
      return Next
    end
    else
    begin
      return State
    end
  end
end;

function CloseOverlay(State: ClientModel): ClientModel;
begin
  mutable var Next: ClientModel := State;
  if State.Overlay = ClientOverlay.SaveConfirmationOverlay then
  begin
    Next.Overlay := ClientOverlay.SystemMenuOverlay;
    Next.FocusedControl := SaveControlId;
    return Next
  end;

  if State.Overlay = ClientOverlay.InformationOverlay then
  begin
    if State.Screen = ClientScreen.StartScreen then
    begin
      if State.ConnectionPhase = ClientConnectionPhase.AwaitingSession then
      begin
        Next.FocusedControl := NewGameControlId
      end
      else
      begin
        Next.FocusedControl := ConnectControlId
      end
    end
    else
    begin
      Next.Overlay := ClientOverlay.SystemMenuOverlay;
      Next.FocusedControl := ResumeControlId;
      return Next
    end
  end;

  Next.Overlay := ClientOverlay.NoOverlay;
  Next.FocusedControl := 0;
  if State.Screen = ClientScreen.StartScreen then
  begin
    if State.ConnectionPhase = ClientConnectionPhase.AwaitingSession then
    begin
      Next.FocusedControl := NewGameControlId
    end
    else
    begin
      Next.FocusedControl := ConnectControlId
    end
  end;

  return Next
end;

function RequestQuit(State: ClientModel; Cmd: TuiCmdOutput): ClientModel;
begin
  if ((State.ConnectionPhase = ClientConnectionPhase.Active) or (State.ConnectionPhase = ClientConnectionPhase.AwaitingSession)) or
     (State.ConnectionPhase = ClientConnectionPhase.Connecting) then
  begin
    TrySend(State.Requests, ClientMessage.Disconnect)
  end;

  Cmd.Set(TuiCmd.Quit);
  return State
end;

function StartConnection(State: ClientModel; Cmd: TuiCmdOutput): ClientModel;
begin
  var Host: string := State.Host;
  var Port: integer := State.Port;
  var Requests: channel of ClientMessage := State.Requests;
  var Events: channel of ClientEvent := State.Events;
  var Viewport: WorldViewport := DesiredWorldViewport(State);
  Cmd.ReplaceSubscription(NetworkSubscriptionId, function(Token: CancellationToken): result of boolean, string begin
    return Dungeon.Client.Network.RunNetwork(Host, Port, Viewport.Width, Viewport.Height, Requests, Events, Token)
  end);
  mutable var Next: ClientModel := State;
  Next.Screen := ClientScreen.StartScreen;
  Next.Overlay := ClientOverlay.NoOverlay;
  Next.ConnectionPhase := ClientConnectionPhase.Connecting;
  Next.FocusedControl := 0;
  Next.Pending := false;
  Next.RequestedWorldWidth := Viewport.Width;
  Next.RequestedWorldHeight := Viewport.Height;
  Next.HasVisibleState := false;
  Next.Status := ('Connecting to ' + Host) + (':' + IntToStr(Port));
  return AppendMessage(Next, Next.Status)
end;

function ReturnToStart(State: ClientModel; Cmd: TuiCmdOutput): ClientModel;
begin
  if ((State.ConnectionPhase = ClientConnectionPhase.Active) or (State.ConnectionPhase = ClientConnectionPhase.AwaitingSession)) or
     (State.ConnectionPhase = ClientConnectionPhase.Connecting) then
  begin
    TrySend(State.Requests, ClientMessage.Disconnect);
    Cmd.CancelSubscription(NetworkSubscriptionId)
  end;
  mutable var Next: ClientModel := State;
  Next.Screen := ClientScreen.StartScreen;
  Next.Overlay := ClientOverlay.NoOverlay;
  Next.ConnectionPhase := ClientConnectionPhase.Offline;
  Next.FocusedControl := ConnectControlId;
  Next.Pending := false;
  Next.HasVisibleState := false;
  Next.SaveAvailable := false;
  Next.Status := 'Ready';
  return Next
end;

function QueueSessionChoice(State: ClientModel; Message: ClientMessage; Status: string): ClientModel;
begin
  if (State.ConnectionPhase <> ClientConnectionPhase.AwaitingSession) or State.Pending then
  begin
    return State
  end;

  case TrySend(State.Requests, Message) of
    Ok(Queued):
    begin
      if not Queued then
      begin
        return State
      end;
      mutable var Next: ClientModel := State;
      Next.Pending := true;
      Next.FocusedControl := 0;
      Next.Status := Status;
      return Next
    end
    else
    begin
      return State
    end
  end
end;

function QueueSave(State: ClientModel): ClientModel;
begin
  if ((State.ConnectionPhase <> ClientConnectionPhase.Active) or State.Pending) or
     not State.HasVisibleState then
  begin
    return State
  end;

  case TrySend(State.Requests, ClientMessage.SaveGame) of
    Ok(Queued):
    begin
      if not Queued then
      begin
        return State
      end;
      mutable var Next: ClientModel := State;
      Next.Overlay := ClientOverlay.NoOverlay;
      Next.FocusedControl := 0;
      Next.Pending := true;
      Next.Status := 'Saving game...';
      return Next
    end
    else
    begin
      return State
    end
  end
end;

function PersistPanelPreferences(State: ClientModel): ClientModel;
begin
  if Std.Str.Length(State.ClientConfigPath) = 0 then
  begin
    return State
  end;

  case SaveClientPreferences(State.ClientConfigPath, record
    ContextPanelVisible := State.ContextPanelVisible;
    MessagePanelVisible := State.MessagePanelVisible;
  end) of
    Ok(Written):
    begin
      return State
    end;
    Error(Message):
    begin
      mutable var Next: ClientModel := State;
      Next.Status := 'Cannot save client preferences: ' + Message;
      return AppendMessage(Next, Next.Status)
    end
  end
end;

function QueueMove(State: ClientModel; DeltaX: integer; DeltaY: integer): ClientModel;
begin
  if (State.ConnectionPhase <> ClientConnectionPhase.Active) or State.Pending then
  begin
    return State
  end;

  case TrySend(State.Requests, ClientMessage.Move(DeltaX, DeltaY)) of
    Ok(Queued):
    begin
      if not Queued then
      begin
        return State
      end;
      mutable var Next: ClientModel := State;
      Next.Pending := true;
      Next.Status := 'Moving...';
      return Next
    end
    else
    begin
      return State
    end
  end
end;

function QueueFirstPersonStep(State: ClientModel; Direction: FirstPersonStepDirection): ClientModel;
begin
  if (State.ConnectionPhase <> ClientConnectionPhase.Active) or State.Pending then
  begin
    return State
  end;

  case TrySend(State.Requests, ClientMessage.StepFirstPerson(Direction)) of
    Ok(Queued):
    begin
      if not Queued then
      begin
        return State
      end;
      mutable var Next: ClientModel := State;
      Next.Pending := true;
      Next.Status := 'Moving one field...';
      return Next
    end
    else
    begin
      return State
    end
  end
end;

function QueueFirstPersonTurn(State: ClientModel; Direction: FirstPersonTurnDirection): ClientModel;
begin
  if (State.ConnectionPhase <> ClientConnectionPhase.Active) or State.Pending then
  begin
    return State
  end;

  case TrySend(State.Requests, ClientMessage.TurnFirstPerson(Direction)) of
    Ok(Queued):
    begin
      if not Queued then
      begin
        return State
      end;
      mutable var Next: ClientModel := State;
      Next.Pending := true;
      Next.Status := 'Turning...';
      return Next
    end
    else
    begin
      return State
    end
  end
end;

function QueueAreaTransition(State: ClientModel): ClientModel;
begin
  if (State.ConnectionPhase <> ClientConnectionPhase.Active) or State.Pending then
  begin
    return State
  end;

  case TrySend(State.Requests, ClientMessage.ActivateAreaTransition) of
    Ok(Queued):
    begin
      if not Queued then
      begin
        return State
      end;
      mutable var Next: ClientModel := State;
      Next.Pending := true;
      Next.Status := 'Activating entrance...';
      return Next
    end
    else
    begin
      return State
    end
  end
end;

function ToggleContext(State: ClientModel): ClientModel;
begin
  mutable var Next: ClientModel := State;
  if ContextCanDock(State) then
  begin
    Next.ContextPanelVisible := not State.ContextPanelVisible;
    Next := QueueViewport(Next);
    return PersistPanelPreferences(Next)
  end;

  if State.Overlay = ClientOverlay.ContextOverlay then
  begin
    return CloseOverlay(State)
  end;

  Next.Overlay := ClientOverlay.ContextOverlay;
  Next.FocusedControl := PanelCloseControlId;
  return Next
end;

function ToggleMessages(State: ClientModel): ClientModel;
begin
  mutable var Next: ClientModel := State;
  if MessagesCanDock(State) then
  begin
    Next.MessagePanelVisible := not State.MessagePanelVisible;
    Next := QueueViewport(Next);
    return PersistPanelPreferences(Next)
  end;

  if State.Overlay = ClientOverlay.MessageOverlay then
  begin
    return CloseOverlay(State)
  end;

  Next.Overlay := ClientOverlay.MessageOverlay;
  Next.FocusedControl := PanelCloseControlId;
  return Next
end;

function HandleAction(State: ClientModel; Action: TuiAction; Cmd: TuiCmdOutput): ClientModel;
begin
  if Action.Value = ConnectAction then
  begin
    return StartConnection(State, Cmd)
  end;

  if Action.Value = InformationAction then
  begin
    mutable var Next: ClientModel := State;
    Next.Overlay := ClientOverlay.InformationOverlay;
    Next.FocusedControl := OverlayBackControlId;
    return Next
  end;

  if Action.Value = NewGameAction then
  begin
    return QueueSessionChoice(State, ClientMessage.StartNewGame, 'Starting new game...')
  end;

  if Action.Value = LoadGameAction then
  begin
    if not State.SaveAvailable then
    begin
      return State
    end;

    return QueueSessionChoice(State, ClientMessage.LoadGame, 'Loading game...')
  end;

  if Action.Value = QuitAction then
  begin
    return RequestQuit(State, Cmd)
  end;

  if Action.Value = ResumeAction then
  begin
    return CloseOverlay(State)
  end;

  if Action.Value = SaveAction then
  begin
    if State.SaveAvailable then
    begin
      mutable var Next: ClientModel := State;
      Next.Overlay := ClientOverlay.SaveConfirmationOverlay;
      Next.FocusedControl := ConfirmSaveControlId;
      return Next
    end;

    return QueueSave(State)
  end;

  if Action.Value = ConfirmSaveAction then
  begin
    return QueueSave(State)
  end;

  if Action.Value = CancelSaveAction then
  begin
    mutable var Next: ClientModel := State;
    Next.Overlay := ClientOverlay.SystemMenuOverlay;
    Next.FocusedControl := SaveControlId;
    return Next
  end;

  if Action.Value = DisconnectAction then
  begin
    return ReturnToStart(State, Cmd)
  end;

  if Action.Value = BackAction then
  begin
    return CloseOverlay(State)
  end;

  if Action.Value = ClosePanelAction then
  begin
    return CloseOverlay(State)
  end;

  return State
end;

function HandleKey(State: ClientModel; Key: TuiKeyEvent; Cmd: TuiCmdOutput): ClientModel;
begin
  if IsAltCharacter(Key, 'x', 'X') then
  begin
    return RequestQuit(State, Cmd)
  end;

  if State.Screen <> ClientScreen.GameScreen then
  begin
    return State
  end;

  if IsCtrlCharacter(Key, 'p', 'P') then
  begin
    if State.Overlay = ClientOverlay.SystemMenuOverlay then
    begin
      return CloseOverlay(State)
    end;
    mutable var Next: ClientModel := State;
    Next.Overlay := ClientOverlay.SystemMenuOverlay;
    Next.FocusedControl := ResumeControlId;
    return Next
  end;

  if Key.kind = TuiKeyKind.F2 then
  begin
    return ToggleContext(State)
  end;

  if Key.kind = TuiKeyKind.F3 then
  begin
    return ToggleMessages(State)
  end;

  if State.Overlay <> ClientOverlay.NoOverlay then
  begin
    return State
  end;

  if Key.kind = TuiKeyKind.Enter then
  begin
    return QueueAreaTransition(State)
  end;

  if HasCharacter(Key, 'a', 'A') then
  begin
    if State.HasVisibleState and (State.View = ViewKind.FirstPerson) then
    begin
      return QueueFirstPersonStep(State, FirstPersonStepDirection.Left)
    end;

    return QueueMove(State, -1, 0)
  end;

  if HasCharacter(Key, 'd', 'D') then
  begin
    if State.HasVisibleState and (State.View = ViewKind.FirstPerson) then
    begin
      return QueueFirstPersonStep(State, FirstPersonStepDirection.Right)
    end;

    return QueueMove(State, 1, 0)
  end;

  if HasCharacter(Key, 'w', 'W') then
  begin
    if State.HasVisibleState and (State.View = ViewKind.FirstPerson) then
    begin
      return QueueFirstPersonStep(State, FirstPersonStepDirection.Forward)
    end;

    return QueueMove(State, 0, -1)
  end;

  if HasCharacter(Key, 's', 'S') then
  begin
    if State.HasVisibleState and (State.View = ViewKind.FirstPerson) then
    begin
      return QueueFirstPersonStep(State, FirstPersonStepDirection.Backward)
    end;

    return QueueMove(State, 0, 1)
  end;

  if State.HasVisibleState and (State.View = ViewKind.FirstPerson) then
  begin
    if HasCharacter(Key, 'q', 'Q') then
    begin
      return QueueFirstPersonTurn(State, FirstPersonTurnDirection.Left)
    end;

    if HasCharacter(Key, 'e', 'E') then
    begin
      return QueueFirstPersonTurn(State, FirstPersonTurnDirection.Right)
    end
  end;

  return State
end;

// Handles terminal lifecycle, screen navigation, overlays, panels, and player input.
public function UpdateClient(State: ClientModel; Msg: TuiMsg; Cmd: TuiCmdOutput): ClientModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    TuiMsg.Started:
    begin
      mutable var Next: ClientModel := State;
      Next.ViewportWidth := ScreenWidth();
      Next.ViewportHeight := ScreenHeight();
      return QueueViewport(Next)
    end;
    TuiMsg.Resize(Size):
    begin
      mutable var Next: ClientModel := State;
      Next.ViewportWidth := Size.Width;
      Next.ViewportHeight := Size.Height;
      if (State.Overlay = ClientOverlay.ContextOverlay) and ContextCanDock(Next) then
      begin
        Next.Overlay := ClientOverlay.NoOverlay;
        Next.FocusedControl := 0
      end;

      if (State.Overlay = ClientOverlay.MessageOverlay) and MessagesCanDock(Next) then
      begin
        Next.Overlay := ClientOverlay.NoOverlay;
        Next.FocusedControl := 0
      end;

      return QueueViewport(Next)
    end;
    TuiMsg.FocusChanged(Previous, Current):
    begin
      case Current of
        Some(Id):
        begin
          mutable var Next: ClientModel := State;
          Next.FocusedControl := Id.Value;
          return Next
        end;
        None:
        begin
          mutable var Next: ClientModel := State;
          Next.FocusedControl := 0;
          return Next
        end
      end
    end;
    TuiMsg.Action(Source, Action):
    begin
      return HandleAction(State, Action, Cmd)
    end;
    TuiMsg.Key(Key):
    begin
      return HandleKey(State, Key, Cmd)
    end;
    TuiMsg.BackgroundFailed(Id, Kind, Message, Code, Line, Column):
    begin
      mutable var Next: ClientModel := State;
      Next.ConnectionPhase := ClientConnectionPhase.Failed;
      Next.Pending := false;
      Next.Status := 'Connection failed: ' + Message;
      return AppendMessage(Next, Next.Status)
    end;
    TuiMsg.QuitRequested:
    begin
      if State.Overlay <> ClientOverlay.NoOverlay then
      begin
        return CloseOverlay(State)
      end;

      return State
    end
    else
    begin
      return State
    end
  end
end;

// Applies authoritative messages emitted by the network task.
public function UpdateClientEvent(State: ClientModel; Value: ClientEvent; Cmd: TuiCmdOutput): ClientModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  mutable var Next: ClientModel := State;
  case Value of
    ClientEvent.Connected(SaveAvailable, InvalidSaveRemoved):
    begin
      Next.Screen := ClientScreen.StartScreen;
      Next.ConnectionPhase := ClientConnectionPhase.AwaitingSession;
      Next.SaveAvailable := SaveAvailable;
      Next.FocusedControl := NewGameControlId;
      if InvalidSaveRemoved then
      begin
        Next.Status := 'Invalid saved game was removed. Start a new game.';
        return AppendMessage(Next, Next.Status)
      end;

      Next.Status := 'Connected. Choose a game session.';
      return AppendMessage(Next, 'Connected')
    end;
    ClientEvent.State(Value):
    begin
      Next.Screen := ClientScreen.GameScreen;
      Next.ConnectionPhase := ClientConnectionPhase.Active;
      Next.FocusedControl := 0;
      Next.HasVisibleState := true;
      Next.View := ViewForVisibleState(Value);
      case Value of
        VisibleState.MapState(MapValue):
        begin
          Next.OriginX := MapValue.OriginX;
          Next.OriginY := MapValue.OriginY;
          Next.Width := MapValue.Width;
          Next.Height := MapValue.Height;
          Next.Rows := MapValue.Rows;
          Next.PlayerX := MapValue.PlayerX;
          Next.PlayerY := MapValue.PlayerY;
          Next.WorldX := MapValue.WorldX;
          Next.WorldY := MapValue.WorldY;
          Next.PrimaryTitle := '';
          Next.PrimaryStatus := ''
        end;
        VisibleState.FirstPersonState(FirstPersonValue):
        begin
          Next.OriginX := 0;
          Next.OriginY := 0;
          Next.Width := FirstPersonValue.Width;
          Next.Height := FirstPersonValue.Height;
          Next.Rows := FirstPersonValue.Rows;
          Next.PlayerX := FirstPersonValue.PlayerX;
          Next.PlayerY := FirstPersonValue.PlayerY;
          Next.WorldX := 0;
          Next.WorldY := 0;
          Next.FirstPersonFacing := FirstPersonValue.Facing;
          Next.PrimaryTitle := FirstPersonValue.Title;
          Next.PrimaryStatus := FirstPersonValue.Status
        end
      end;

      Next.Pending := false;
      if Next.View = ViewKind.FirstPerson then
      begin
        Next.Status := Next.PrimaryStatus
      end
      else
      begin
        Next.Status := 'Connected'
      end;

      return QueueViewport(Next)
    end;
    ClientEvent.SaveCompleted:
    begin
      Next.Pending := false;
      Next.SaveAvailable := true;
      Next.Status := 'Game saved.';
      return AppendMessage(Next, Next.Status)
    end;
    ClientEvent.Rejected(Code, Message):
    begin
      Next.Pending := false;
      if Code = 'save_removed' then
      begin
        Next.SaveAvailable := false;
        Next.FocusedControl := NewGameControlId
      end;

      Next.Status := Message;
      return AppendMessage(Next, 'Rejected: ' + Message)
    end;
    ClientEvent.Failed(Message):
    begin
      Next.ConnectionPhase := ClientConnectionPhase.Failed;
      Next.Pending := false;
      Next.Status := 'Connection failed: ' + Message;
      return AppendMessage(Next, Next.Status)
    end;
    ClientEvent.Disconnected:
    begin
      Next.ConnectionPhase := ClientConnectionPhase.Disconnected;
      Next.Pending := false;
      Next.Status := 'Disconnected';
      return AppendMessage(Next, 'Disconnected')
    end
  end
end;

function ColoredCell(
  Glyph: string;
  ForegroundRed: integer;
  ForegroundGreen: integer;
  ForegroundBlue: integer;
  BackgroundRed: integer;
  BackgroundGreen: integer;
  BackgroundBlue: integer
): TuiCell;
begin
  return TuiCell.Styled(Glyph, TuiStyle.FromColors(TuiColor.FromRgb(ForegroundRed, ForegroundGreen, ForegroundBlue), TuiColor.FromRgb(BackgroundRed, BackgroundGreen, BackgroundBlue)))
end;

function TerrainCell(Code: string; SecondColumn: boolean): TuiCell;
begin
  mutable var Glyph: string := ' ';
  if not SecondColumn then
  begin
    case Code of
      'g':
      begin
        Glyph := '·'
      end;
      't':
      begin
        Glyph := '♣'
      end;
      'f':
      begin
        Glyph := '░'
      end;
      'd':
      begin
        Glyph := '·'
      end;
      'm':
      begin
        Glyph := '▲'
      end;
      'o':
      begin
        Glyph := '≈'
      end;
      'r':
      begin
        Glyph := '≈'
      end;
      'l':
      begin
        Glyph := '∼'
      end;
      'p':
      begin
        Glyph := '·'
      end;
      'e':
      begin
        Glyph := '◆'
      end
      else
      begin
        Glyph := '?'
      end
    end
  end;

  case Code of
    'g':
    begin
      return ColoredCell(Glyph, 136, 186, 110, 40, 92, 52)
    end;
    't':
    begin
      return ColoredCell(Glyph, 78, 166, 85, 40, 92, 52)
    end;
    'f':
    begin
      return ColoredCell(Glyph, 102, 173, 101, 24, 67, 40)
    end;
    'd':
    begin
      return ColoredCell(Glyph, 235, 207, 128, 151, 116, 58)
    end;
    'm':
    begin
      return ColoredCell(Glyph, 224, 228, 232, 82, 89, 96)
    end;
    'o':
    begin
      return ColoredCell(Glyph, 116, 184, 255, 18, 65, 122)
    end;
    'r':
    begin
      return ColoredCell(Glyph, 189, 231, 255, 30, 112, 171)
    end;
    'l':
    begin
      return ColoredCell(Glyph, 176, 235, 255, 35, 125, 156)
    end;
    'p':
    begin
      return ColoredCell(Glyph, 236, 210, 156, 116, 83, 47)
    end;
    'e':
    begin
      return ColoredCell(Glyph, 255, 221, 112, 72, 42, 92)
    end
    else
    begin
      return ColoredCell(Glyph, 255, 255, 255, 80, 0, 80)
    end
  end
end;

function PlayerCell(SecondColumn: boolean): TuiCell;
begin
  if SecondColumn then
  begin
    return ColoredCell(' ', 255, 245, 190, 150, 68, 24)
  end;

  return ColoredCell('●', 255, 250, 210, 150, 68, 24)
end;

function MapGrid(State: ClientModel): TuiCellGrid;
begin
  mutable var Cells: array of TuiCell := [];
  for Y: integer := 0 to State.Height - 1 do
  begin
    for X: integer := 0 to State.Width - 1 do
    begin
      var IsPlayer: boolean := (X = State.PlayerX) and (Y = State.PlayerY);
      var Code: string := Std.Str.CharAt(State.Rows[Y], X);
      if IsPlayer then
      begin
        Std.Arrays.Push(Cells, PlayerCell(false));
        Std.Arrays.Push(Cells, PlayerCell(true))
      end
      else
      begin
        Std.Arrays.Push(Cells, TerrainCell(Code, false));
        Std.Arrays.Push(Cells, TerrainCell(Code, true))
      end
    end
  end;

  return TuiCellGrid.Create(State.Width * 2, State.Height, Cells)
end;

function ViewMap(State: ClientModel): TuiElement;
begin
  mutable var Elements: array of TuiElement := [];
  if State.HasVisibleState then
  begin
    Std.Arrays.Push(Elements, TuiElementBuilders.MakeCellGrid(MapGrid(State)))
  end
  else
  begin
    Std.Arrays.Push(Elements, TuiElementBuilders.MakeLabel('Waiting for world...'))
  end;

  return TuiElementBuilders.MakePanel('World', [TuiElementBuilders.MakeColumn(Elements)])
end;

function ViewFirstPerson(State: ClientModel): TuiElement;
begin
  var Viewport: WorldViewport := DesiredWorldViewport(State);
  var Value: FirstPersonVisibleState := record
    Title := State.PrimaryTitle;
    Status := State.PrimaryStatus;
    Width := State.Width;
    Height := State.Height;
    Rows := State.Rows;
    PlayerX := State.PlayerX;
    PlayerY := State.PlayerY;
    Facing := State.FirstPersonFacing;
  end;

  return TuiElementBuilders.MakePanel(State.PrimaryTitle, [
                                                            TuiElementBuilders.MakeCellGrid(RenderFirstPersonGrid(Value, Viewport.Width, Viewport.Height))
                                                          ])
end;

function ViewPrimary(State: ClientModel): TuiElement;
begin
  if State.HasVisibleState and (State.View = ViewKind.FirstPerson) then
  begin
    return ViewFirstPerson(State)
  end;

  return ViewMap(State)
end;

function FacingLabel(Value: FirstPersonFacing): string;
begin
  case Value of
    FirstPersonFacing.North:
    begin
      return 'north'
    end;
    FirstPersonFacing.East:
    begin
      return 'east'
    end;
    FirstPersonFacing.South:
    begin
      return 'south'
    end;
    FirstPersonFacing.West:
    begin
      return 'west'
    end
  end
end;

function ViewContext(State: ClientModel): TuiElement;
begin
  mutable var Position: string := 'Not available';
  mutable var Location: string := 'Outdoor region';
  if State.HasVisibleState then
  begin
    if State.View = ViewKind.Map then
    begin
      Position := (IntToStr(State.WorldX) + ', ') + IntToStr(State.WorldY)
    end
    else
    begin
      Location := State.PrimaryTitle;
      Position := (((IntToStr(State.PlayerX) + ', ') + IntToStr(State.PlayerY)) + ' facing ') +
                  FacingLabel(State.FirstPersonFacing)
    end
  end;

  return TuiElementBuilders.MakeColumn([
                                         TuiElementBuilders.MakeLabel('Character'),
                                         TuiElementBuilders.MakeLabel('Adventurer'),
                                         TuiElementBuilders.MakeLabel(''),
                                         TuiElementBuilders.MakeLabel('Location'),
                                         TuiElementBuilders.MakeLabel(Location),
                                         TuiElementBuilders.MakeLabel('Position: ' + Position),
                                         TuiElementBuilders.MakeLabel(''),
                                         TuiElementBuilders.MakeLabel('Equipment'),
                                         TuiElementBuilders.MakeLabel('Not available'),
                                         TuiElementBuilders.MakeLabel(''),
                                         TuiElementBuilders.MakeLabel('Quick inventory'),
                                         TuiElementBuilders.MakeLabel('Not available')
                                       ])
end;

function ViewMessages(State: ClientModel): TuiElement;
begin
  mutable var Elements: array of TuiElement := [];
  if Std.Arrays.Length(State.Messages) = 0 then
  begin
    Std.Arrays.Push(Elements, TuiElementBuilders.MakeLabel('No messages'))
  end
  else
  begin
    for Message: string in State.Messages do
    begin
      Std.Arrays.Push(Elements, TuiElementBuilders.MakeLabel(Message))
    end
  end;

  return TuiElementBuilders.MakeColumn(Elements)
end;

function ViewDockedMessages(State: ClientModel): TuiElement;
begin
  mutable var Elements: array of TuiElement := [];
  if Std.Arrays.Length(State.Messages) = 0 then
  begin
    Std.Arrays.Push(Elements, TuiElementBuilders.MakeLabel('No messages'))
  end;

  if Std.Arrays.Length(State.Messages) > 0 then
  begin
    mutable var Start: integer := Std.Arrays.Length(State.Messages) - DockedMessageLines;
    if Start < 0 then
    begin
      Start := 0
    end;

    for Index: integer := Start to Std.Arrays.Length(State.Messages) - 1 do
    begin
      Std.Arrays.Push(Elements, TuiElementBuilders.MakeLabel(State.Messages[Index]))
    end
  end;

  while Std.Arrays.Length(Elements) < DockedMessageLines do
  begin
    Std.Arrays.Push(Elements, TuiElementBuilders.MakeLabel(''))
  end;

  return TuiElementBuilders.MakeColumn(Elements)
end;

function Expanding(Stretch: integer): TuiLayoutSettings;
begin
  return TuiLayoutSettings.Create(TuiMargins.Uniform(0), TuiSizePolicy.Expanding(), TuiAlignment.Fill(), Stretch)
end;

function GameStatusItems(State: ClientModel): array of TuiStatusItem;
begin
  return [
           TuiStatusItemBuilders.MakeKeyHint('ctrl-p', '|'),
           TuiStatusItemBuilders.MakeHint(State.Status)
         ]
end;

function ViewGameShell(State: ClientModel): TuiElement;
begin
  mutable var PrimarySettings: TuiLayoutSettings := Expanding(2);
  if State.ContextPanelVisible and ContextCanDock(State) then
  begin
    PrimarySettings := PrimarySettings.WithFixedWidth(PrimaryTerminalWidth(State))
  end;
  var Primary: TuiElement := TuiElementBuilders.MakeLayout(PrimarySettings, ViewPrimary(State));
  mutable var MainRow: TuiElement := TuiElementBuilders.MakeRow([Primary]);
  if State.ContextPanelVisible and ContextCanDock(State) then
  begin
    MainRow := TuiElementBuilders.MakeRow([
                                            Primary,
                                            TuiElementBuilders.MakeLayout(Expanding(1), TuiElementBuilders.MakePanel('Context', [
                                                                                                                                  ViewContext(State)
                                                                                                                                ]))
                                          ])
  end;
  mutable var Rows: array of TuiElement := [TuiElementBuilders.MakeLayout(Expanding(1), MainRow)];
  if State.MessagePanelVisible and MessagesCanDock(State) then
  begin
    var MessageSettings: TuiLayoutSettings := TuiLayoutSettings.Create(TuiMargins.Uniform(0), TuiSizePolicy.Create(TuiSizePolicyKind.Expanding, TuiSizePolicyKind.Fixed), TuiAlignment.Fill(), 1)
                                                .WithFixedHeight(MessagePanelHeight);
    Std.Arrays.Push(Rows, TuiElementBuilders.MakeLayout(MessageSettings, TuiElementBuilders.MakePanel('Messages', [
                                                                                                                    ViewDockedMessages(State)
                                                                                                                  ])))
  end;
  var StatusSettings: TuiLayoutSettings := TuiLayoutSettings.Create(TuiMargins.Uniform(0), TuiSizePolicy.Create(TuiSizePolicyKind.Expanding, TuiSizePolicyKind.Fixed), TuiAlignment.Fill(), 1)
                                             .WithFixedHeight(StatusPanelHeight);
  Std.Arrays.Push(Rows, TuiElementBuilders.MakeLayout(StatusSettings, TuiElementBuilders.MakePanel('Status', [
                                                                                                               TuiElementBuilders.MakeStatusLine(GameStatusItems(State))
                                                                                                             ])));
  return TuiElementBuilders.MakeColumn(Rows)
end;

function ViewInformation(): TuiElement;
begin
  return TuiElementBuilders.MakeOverlay('Information', [
                                                         TuiElementBuilders.MakeColumn([
                                                                                         TuiElementBuilders.MakeLabel('Into the Dungeon'),
                                                                                         TuiElementBuilders.MakeLabel('A Functional Pascal client-server RPG.'),
                                                                                         TuiElementBuilders.MakeLabel(''),
                                                                                         TuiElementBuilders.MakeButton(TuiControlId.Create(OverlayBackControlId), 'Back', TuiAction.Create(BackAction))
                                                                                       ])
                                                       ])
end;

function ViewStartScreen(State: ClientModel): TuiElement;
begin
  mutable var Items: array of TuiElement := [];
  if State.ConnectionPhase = ClientConnectionPhase.Connecting then
  begin
    Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel(State.Status))
  end
  else if State.ConnectionPhase = ClientConnectionPhase.AwaitingSession then
  begin
    Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel(State.Status));
    Std.Arrays.Push(Items, TuiElementBuilders.MakeDefaultButton(TuiControlId.Create(NewGameControlId), 'New game', '', TuiAction.Create(NewGameAction)));
    if State.SaveAvailable then
    begin
      Std.Arrays.Push(Items, TuiElementBuilders.MakeButton(TuiControlId.Create(LoadGameControlId), 'Load', TuiAction.Create(LoadGameAction)))
    end;

    Std.Arrays.Push(Items, TuiElementBuilders.MakeButton(TuiControlId.Create(StartDisconnectControlId), 'Disconnect', TuiAction.Create(DisconnectAction)))
  end
  else
  begin
    Std.Arrays.Push(Items, TuiElementBuilders.MakeDefaultButton(TuiControlId.Create(ConnectControlId), 'Connect', '', TuiAction.Create(ConnectAction)))
  end;

  Std.Arrays.Push(Items, TuiElementBuilders.MakeButton(TuiControlId.Create(StartInformationControlId), 'Information', TuiAction.Create(InformationAction)));
  Std.Arrays.Push(Items, TuiElementBuilders.MakeButton(TuiControlId.Create(StartQuitControlId), 'Quit', TuiAction.Create(QuitAction)));
  return TuiElementBuilders.MakeOverlay('INTO THE DUNGEON', [TuiElementBuilders.MakeColumn(Items)])
end;

function ViewSystemMenu(State: ClientModel): TuiElement;
begin
  mutable var Items: array of TuiElement := [
                                              TuiElementBuilders.MakeButton(TuiControlId.Create(ResumeControlId), 'Resume', TuiAction.Create(ResumeAction)),
                                              TuiElementBuilders.MakeButton(TuiControlId.Create(SystemInformationControlId), 'Information', TuiAction.Create(InformationAction)),
                                              TuiElementBuilders.MakeButton(TuiControlId.Create(SaveControlId), 'Save', TuiAction.Create(SaveAction)),
                                              TuiElementBuilders.MakeRule('Key bindings')
                                            ];
  if not State.HasVisibleState or (State.View = ViewKind.Map) then
  begin
    Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel('WASD   Move'))
  end
  else
  begin
    Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel('W/S    Forward/back one field'));
    Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel('A/D    Left/right one field'));
    Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel('Q/E    Turn left/right 90 degrees'))
  end;

  Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel('Enter  Enter/leave'));
  Items := Std.Arrays.Concat(Items, [
                                      TuiElementBuilders.MakeLabel('F2     Context'),
                                      TuiElementBuilders.MakeLabel('F3     Messages'),
                                      TuiElementBuilders.MakeLabel('Ctrl+P Menu'),
                                      TuiElementBuilders.MakeLabel('Alt+X  Quit')
                                    ]);
  if (State.ConnectionPhase = ClientConnectionPhase.Active) or
     (State.ConnectionPhase = ClientConnectionPhase.Connecting) then
  begin
    Std.Arrays.Push(Items, TuiElementBuilders.MakeButton(TuiControlId.Create(DisconnectControlId), 'Disconnect', TuiAction.Create(DisconnectAction)))
  end
  else
  begin
    Std.Arrays.Push(Items, TuiElementBuilders.MakeButton(TuiControlId.Create(DisconnectControlId), 'Return to start', TuiAction.Create(DisconnectAction)))
  end;

  Std.Arrays.Push(Items, TuiElementBuilders.MakeButton(TuiControlId.Create(SystemQuitControlId), 'Quit', TuiAction.Create(QuitAction)));
  return TuiElementBuilders.MakeOverlay('System menu', [TuiElementBuilders.MakeColumn(Items)])
end;

function ViewSaveConfirmation(): TuiElement;
begin
  return TuiElementBuilders.MakeOverlay('Overwrite save?', [
                                                             TuiElementBuilders.MakeColumn([
                                                                                             TuiElementBuilders.MakeLabel('The existing save for this world will be replaced.'),
                                                                                             TuiElementBuilders.MakeDefaultButton(TuiControlId.Create(ConfirmSaveControlId), 'Overwrite', '', TuiAction.Create(ConfirmSaveAction)),
                                                                                             TuiElementBuilders.MakeButton(TuiControlId.Create(CancelSaveControlId), 'Cancel', TuiAction.Create(CancelSaveAction))
                                                                                           ])
                                                           ])
end;

function ViewPanelOverlay(State: ClientModel; Title: string; Content: TuiElement): TuiElement;
begin
  return TuiElementBuilders.MakeOverlay(Title, [
                                                 Content,
                                                 TuiElementBuilders.MakeButton(TuiControlId.Create(PanelCloseControlId), 'Close', TuiAction.Create(ClosePanelAction))
                                               ])
end;

function ViewOverlay(State: ClientModel): TuiElement;
begin
  case State.Overlay of
    ClientOverlay.InformationOverlay:
    begin
      return ViewInformation()
    end;
    ClientOverlay.SystemMenuOverlay:
    begin
      return ViewSystemMenu(State)
    end;
    ClientOverlay.SaveConfirmationOverlay:
    begin
      return ViewSaveConfirmation()
    end;
    ClientOverlay.ContextOverlay:
    begin
      return ViewPanelOverlay(State, 'Context', ViewContext(State))
    end;
    ClientOverlay.MessageOverlay:
    begin
      return ViewPanelOverlay(State, 'Messages', ViewMessages(State))
    end;
    ClientOverlay.NoOverlay:
    begin
      return TuiElementBuilders.MakeEmpty()
    end
  end
end;

function Focus(State: ClientModel): option of TuiControlId;
begin
  if State.FocusedControl > 0 then
  begin
    return Some(TuiControlId.Create(State.FocusedControl))
  end;

  return None
end;

// Renders the start screen or game screen with any active modal overlay.
public function ViewClient(State: ClientModel): TuiElement;
begin
  if State.Screen = ClientScreen.StartScreen then
  begin
    if State.Overlay = ClientOverlay.InformationOverlay then
    begin
      return TuiElementBuilders.MakeDesktop(Focus(State), [ViewInformation()])
    end;

    return TuiElementBuilders.MakeDesktop(Focus(State), [ViewStartScreen(State)])
  end;

  return TuiElementBuilders.MakeDesktop(Focus(State), [ViewGameShell(State), ViewOverlay(State)])
end;
