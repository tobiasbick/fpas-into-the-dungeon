// Functional Pascal TUI update and view entry points of the dungeon client.
unit Dungeon.Client.Ui;

uses Dungeon.Client.Ui.Trade as Trade, Dungeon.Client.Journal as Journal, Dungeon.Client.Ui.Dialogue as Dialogue, Dungeon.Client.Ui.Backdrop as BackdropUnit, Dungeon.Client.Ui.Controls as Controls, Dungeon.Client.Ui.GameView as GameView, Dungeon.Client.Ui.Input as Input, Dungeon.Client.Ui.Intentions as Intentions, Dungeon.Client.Ui.Layout as Layout, Dungeon.Client.Ui.Overlays as Overlays, Dungeon.Client.Ui.Worlds as UiWorlds, Dungeon.Client.Ui.Playback as Playback, Dungeon.Client.Ui.Session as Session, Dungeon.Client.CharacterSheet as CharacterSheet, Dungeon.Client.Model as Model, Std.Console as Console, Std.Ui.Terminal as Tui;

// Handles terminal lifecycle, screen navigation, overlays, panels, and player input.
public function UpdateClient(State: Model.ClientModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): Model.ClientModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  case Msg of
    when Tui.TuiMsg.Started:
      begin
        var Next: Model.ClientModel := State;
        Next.ViewportWidth := Console.ScreenWidth();
        Next.ViewportHeight := Console.ScreenHeight();
        return Intentions.QueueViewport(Next);
      end;
    when Tui.TuiMsg.Resize(const Size):
      begin
        var Next: Model.ClientModel := State;
        Next.ViewportWidth := Size.Width;
        Next.ViewportHeight := Size.Height;
        if (State.Overlay = Model.ClientOverlay.SystemMenuOverlay) and (Size.Height < 10) then
          Next.FocusedControl := Controls.ResumeControlId;
        end if;

        Next.DescriptionOffset := 0;
        Next := CharacterSheet.ClampOffset(Next);
        Next := Journal.ClampOffset(Next);
        if (State.Overlay = Model.ClientOverlay.ContextOverlay) and Layout.ContextCanDock(Next) then
          begin
            Next.Overlay := Model.ClientOverlay.NoOverlay;
            Next.FocusedControl := 0;
          end;
        end if;

        if (State.Overlay = Model.ClientOverlay.MessageOverlay) and Layout.MessagesCanDock(Next) then
          begin
            Next.Overlay := Model.ClientOverlay.NoOverlay;
            Next.FocusedControl := 0;
          end;
        end if;

        return Intentions.QueueViewport(UiWorlds.ReconcileWorldCursor(Next));
      end;
    when Tui.TuiMsg.TextChanged(const Source, const Action, const Text, const Caret):
      begin
        return UiWorlds.ChangeWorldText(State, Source, Action, Text, Caret);
      end;
    when Tui.TuiMsg.SelectionChanged(const Source, const Action, const Selected):
      begin
        if (Source.Value = Controls.DialogueListControlId)
          and
          (Action.Value = Controls.DialogueSelectAction)
        then
          return Dialogue.SelectRow(State, Selected);
        end if;

        if (Source.Value = Controls.TradeListControlId)
          and
          (Action.Value = Controls.TradeSelectAction)
        then
          return Trade.SelectRow(State, Selected);
        end if;

        if (State.Overlay = Model.ClientOverlay.InventoryOverlay) and not State.Pending
          and
          (Source.Value = Controls.InventoryListControlId)
          and
          (Action.Value = Controls.InventorySelectAction)
          and
          (Selected >= 0) and (Selected < State.Inventory.Length())
          and
          Layout.InventoryCanFit(State)
        then
          return State with InventorySelection := Selected; end with;
        end if;

        return UiWorlds.SelectWorldRow(State, Source, Action, Selected);
      end;
    when Tui.TuiMsg.ScrollChanged(const Source, const Action, const Offset):
      if (State.Overlay = Model.ClientOverlay.NewWorldOverlay)
        and
        (Source.Value = Controls.WorldStatusControlId)
        and
        (Action.Value = Controls.WorldStatusScrollAction) and (Offset.X = 0) and (Offset.Y >= 0)
      then
        return State with DialogScrollOffset := Offset.Y; end with;
      end if;

      if (Source.Value = Controls.DialogScrollControlId)
        and
        (Action.Value = Controls.DialogScrollAction)
        and
        (
          (State.Overlay = Model.ClientOverlay.ContextOverlay)
          or
          (State.Overlay = Model.ClientOverlay.MessageOverlay)
          or
          (State.Overlay = Model.ClientOverlay.SystemMenuOverlay)
          or
          (
            (State.ConnectionPhase = Model.ClientConnectionPhase.AwaitingSession)
            and
            not State.Pending
          )
        )
        and
        (Offset.X = 0) and (Offset.Y >= 0)
      then
        return State with DialogScrollOffset := Offset.Y; end with;
      end if;

      return State;
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      begin
        case Current of
          when Some(const Id):
            begin
              var Next: Model.ClientModel := State;
              Next.FocusedControl := Id.Value;
              return Next;
            end;
          when None:
            begin
              var Next: Model.ClientModel := State;
              Next.FocusedControl := 0;
              return Next;
            end;
        end case;
      end;
    when Tui.TuiMsg.Action(const Source, const Action):
      begin
        if (
          (Source.Value = Controls.InventoryListControlId)
          and
          (Action.Value = Controls.InventoryActivateAction)
          and
          (State.Overlay = Model.ClientOverlay.InventoryOverlay)
        )
          or
          (
            (Source.Value = Controls.TradeListControlId)
            and
            (Action.Value = Controls.TradeActivateAction) and (State.ActiveTrade is Some(_))
          )
          or
          (
            (Source.Value = Controls.DialogueListControlId)
            and
            (Action.Value = Controls.DialogueActivateAction) and (State.ActiveDialogue is Some(_))
          )
        then
          return Input.HandleKey(
            State,
            Tui.TuiKeyEvent(
              kind := Tui.TuiKeyKind.Enter,
              ch := '',
              shift := false,
              ctrl := false,
              alt := false,
              meta := false
            ),
            Cmd
          );
        end if;

        return Input.HandleAction(State, Action, Cmd);
      end;
    when Tui.TuiMsg.Key(const Key):
      begin
        // A key press completes a running animation first, so fast play never waits for it.
        return Input.HandleKey(Playback.StopAnimation(State), Key, Cmd);
      end;
    when Tui.TuiMsg.Tick(const Elapsed):
      begin
        return Playback.AdvanceCombatAnimation(State, Elapsed, Cmd);
      end;
    when Tui.TuiMsg.BackgroundFailed(const Id, const Kind, const Message, const Code, const Line, const Column):
      begin
        var Next := Playback.StopAnimation(State);
        Next.ActiveDialogue := None;
        Next.ActiveTrade := None;
        Next.Screen := Model.ClientScreen.StartScreen;
        Next.HasVisibleState := false;
        Next.ConnectionPhase := Model.ClientConnectionPhase.Failed;
        Next.Overlay := Model.ClientOverlay.NoOverlay;
        Next.FocusedControl := Controls.ConnectControlId;
        Next.Pending := false;
        Next.Status := 'Connection failed: ' + Message;
        return Session.AppendMessage(Next, Next.Status);
      end;
    when Tui.TuiMsg.QuitRequested:
      begin
        if State.ActiveTrade is Some(_) then
          return Trade.HandleKey(
            State, Tui.TuiKeyEvent(
              kind := Tui.TuiKeyKind.Escape, ch := '', shift := false,
              ctrl := false, alt := false, meta := false
            )
          );
        end if;

        if State.ActiveDialogue is Some(_) then
          return Dialogue.HandleKey(
            State, Tui.TuiKeyEvent(
              kind := Tui.TuiKeyKind.Escape, ch := '', shift := false,
              ctrl := false, alt := false, meta := false
            )
          );
        end if;

        if State.Overlay <> Model.ClientOverlay.NoOverlay then
          begin
            return Session.CloseOverlay(State);
          end;
        end if;

        return State;
      end;
    when Tui.TuiMsg.Pointer(_), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _):
      begin
        return State;
      end;
  end case;
end function;

function Focus(State: Model.ClientModel): option of Tui.TuiControlId;
begin
  // These windows retain their complete gameplay key maps; their native lists handle pointer input.
  if State.ActiveDialogue is Some(_) then
    return Some(Tui.TuiControlId.Create(Controls.DialogueListControlId));
  end if;

  if State.ActiveTrade is Some(_) then
    if (State.ViewportWidth < 40) or (State.ViewportHeight < 12) then
      return None;
    end if;

    return Some(Tui.TuiControlId.Create(Controls.TradeListControlId));
  end if;

  if (State.Overlay = Model.ClientOverlay.InventoryOverlay) and Layout.InventoryCanFit(State)
    and
    (State.Inventory.Length() > 0)
  then
    return Some(Tui.TuiControlId.Create(Controls.InventoryListControlId));
  end if;

  if (State.Overlay = Model.ClientOverlay.NewWorldOverlay)
    and
    (
      ((State.ViewportWidth > 0) and (State.ViewportWidth < 40))
      or
      ((State.ViewportHeight > 0) and (State.ViewportHeight < 12))
    )
  then
    return Some(Tui.TuiControlId.Create(Controls.OverlayBackControlId));
  end if;

  if (State.ConnectionPhase = Model.ClientConnectionPhase.AwaitingSession) and not State.Pending
    and
    (State.Overlay = Model.ClientOverlay.NoOverlay)
    and
    (
      ((State.ViewportWidth > 0) and (State.ViewportWidth < 40))
      or
      ((State.ViewportHeight > 0) and (State.ViewportHeight < 12))
    )
  then
    return Some(Tui.TuiControlId.Create(Controls.StartDisconnectControlId));
  end if;

  if State.FocusedControl > 0 then
    begin
      return Some(Tui.TuiControlId.Create(State.FocusedControl));
    end;
  end if;

  return None;
end function;

// Renders the start screen or game screen with any active modal overlay.
function ClientView(State: Model.ClientModel; Cached: boolean): Tui.TuiElement;
begin
  if State.Screen = Model.ClientScreen.StartScreen then
    begin
      const Backdrop: Tui.TuiElement := BackdropUnit.ViewStartBackdrop(State);
      if State.Overlay = Model.ClientOverlay.InformationOverlay then
        begin
          return Tui.TuiElementBuilders.MakeDesktop(
            Focus(State),
            [Backdrop, Overlays.ViewInformation(State)]
          );
        end;
      end if;

      // Confirmations and the defeat report stay above the session choices they lead back to.
      if (State.Overlay = Model.ClientOverlay.SessionCancelConfirmationOverlay)
        or
        (State.Overlay = Model.ClientOverlay.DefeatOverlay)
        or
        (State.Overlay = Model.ClientOverlay.NewWorldOverlay)
      then
        begin
          return Tui.TuiElementBuilders.MakeDesktop(
            Focus(State), [
              Backdrop,
              Overlays.ViewStartScreen(State),
              Overlays.ViewOverlay(State)
            ]
          );
        end;
      end if;

      return Tui.TuiElementBuilders.MakeDesktop(
        Focus(State),
        [Backdrop, Overlays.ViewStartScreen(State)]
      );
    end;
  end if;
  var Game: Tui.TuiElement := Tui.TuiElement.Empty;
  if Cached then
    Game := GameView.ViewGameShellCached(State);
  else
    Game := GameView.ViewGameShell(State);
  end if;

  return Tui.TuiElementBuilders.MakeDesktop(
    Focus(State),
    [Game, Overlays.ViewOverlay(State)]
  );
end function;

// Renders without a host, including standalone callers and inspection.
public function ViewClient(State: Model.ClientModel): Tui.TuiElement;
begin
  return ClientView(State, false);
end function;

// Renders inside a TUI host with cached unchanged game content.
public function ViewClientCached(State: Model.ClientModel): Tui.TuiElement;
begin
  return ClientView(State, true);
end function;
end unit;
