// Functional Pascal TUI update and view entry points of the dungeon client.
unit Dungeon.Client.Ui;

uses
  Dungeon.Client.Ui.Backdrop, Dungeon.Client.Ui.Controls, Dungeon.Client.Ui.GameView,
  Dungeon.Client.Ui.Input, Dungeon.Client.Ui.Intentions, Dungeon.Client.Ui.Layout,
  Dungeon.Client.Ui.Overlays, Dungeon.Client.Ui.Playback, Dungeon.Client.Ui.Session,
  Dungeon.Client.Model, Std.Console, Std.Tui;

// Handles terminal lifecycle, screen navigation, overlays, panels, and player input.
public function UpdateClient(State: ClientModel; Msg: TuiMsg; Cmd: TuiCmdOutput): ClientModel;
begin
  Cmd.Set(TuiCmd.NoCommand);
  case Msg of
    TuiMsg.Started:
    begin
      mutable var Next: ClientModel := State;
      Next.ViewportWidth := ScreenWidth();
      Next.ViewportHeight := ScreenHeight();
      return QueueViewport(Next)
    end;
    TuiMsg.Resize(Size):
    begin
      mutable var Next: ClientModel := State;
      Next.ViewportWidth := Size.Width;
      Next.ViewportHeight := Size.Height;
      Next.DescriptionOffset := 0;
      if (State.Overlay = ClientOverlay.ContextOverlay) and ContextCanDock(Next) then
      begin
        Next.Overlay := ClientOverlay.NoOverlay;
        Next.FocusedControl := 0
      end;

      if (State.Overlay = ClientOverlay.MessageOverlay) and MessagesCanDock(Next) then
      begin
        Next.Overlay := ClientOverlay.NoOverlay;
        Next.FocusedControl := 0
      end;

      return QueueViewport(Next)
    end;
    TuiMsg.FocusChanged(Previous, Current):
    begin
      case Current of
        Some(Id):
        begin
          mutable var Next: ClientModel := State;
          Next.FocusedControl := Id.Value;
          return Next
        end;
        None:
        begin
          mutable var Next: ClientModel := State;
          Next.FocusedControl := 0;
          return Next
        end
      end
    end;
    TuiMsg.Action(Source, Action):
    begin
      return HandleAction(State, Action, Cmd)
    end;
    TuiMsg.Key(Key):
    begin
      // A key press completes a running animation first, so fast play never waits for it.
      return HandleKey(StopAnimation(State, Cmd), Key, Cmd)
    end;
    TuiMsg.Tick(Elapsed):
    begin
      return AdvanceCombatAnimation(State, Elapsed, Cmd)
    end;
    TuiMsg.BackgroundFailed(Id, Kind, Message, Code, Line, Column):
    begin
      mutable var Next: ClientModel := State;
      Next.ConnectionPhase := ClientConnectionPhase.Failed;
      Next.Overlay := ClientOverlay.NoOverlay;
      Next.FocusedControl := ConnectControlId;
      Next.Pending := false;
      Next.Status := 'Connection failed: ' + Message;
      return AppendMessage(Next, Next.Status)
    end;
    TuiMsg.QuitRequested:
    begin
      if State.Overlay <> ClientOverlay.NoOverlay then
      begin
        return CloseOverlay(State)
      end;

      return State
    end
    else
    begin
      return State
    end
  end
end;

function Focus(State: ClientModel): option of TuiControlId;
begin
  if State.FocusedControl > 0 then
  begin
    return Some(TuiControlId.Create(State.FocusedControl))
  end;

  return None
end;

// Renders the start screen or game screen with any active modal overlay.
public function ViewClient(State: ClientModel): TuiElement;
begin
  if State.Screen = ClientScreen.StartScreen then
  begin
    var Backdrop: TuiElement := ViewStartBackdrop(State.ViewportWidth, State.ViewportHeight);
    if State.Overlay = ClientOverlay.InformationOverlay then
    begin
      return TuiElementBuilders.MakeDesktop(Focus(State), [Backdrop, ViewInformation()])
    end;

    // Confirmations and the defeat report stay above the session choices they lead back to.
    if (State.Overlay = ClientOverlay.SessionCancelConfirmationOverlay) or
       (State.Overlay = ClientOverlay.DefeatOverlay) then
    begin
      return TuiElementBuilders.MakeDesktop(Focus(State), [
                                                            Backdrop,
                                                            ViewStartScreen(State),
                                                            ViewOverlay(State)
                                                          ])
    end;

    return TuiElementBuilders.MakeDesktop(Focus(State), [Backdrop, ViewStartScreen(State)])
  end;

  return TuiElementBuilders.MakeDesktop(Focus(State), [ViewGameShell(State), ViewOverlay(State)])
end;
