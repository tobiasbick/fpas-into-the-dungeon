// Applies authoritative network events to the client model.
unit Dungeon.Client.Ui.Events;

uses Dungeon.Client.Journal as Journal, Dungeon.Client.Ui.Controls as Controls, Dungeon.Client.Ui.Intentions as Intentions, Dungeon.Client.Ui.Playback as Playback, Dungeon.Client.Ui.Session as Session, Dungeon.Client.Character as Character, Dungeon.Client.CharacterSheet as CharacterSheet, Dungeon.Client.Model as Model, Dungeon.Protocol as Protocol, Dungeon.Client.Ui.Worlds as UiWorlds, Std.Tui as Tui;

// Applies authoritative messages emitted by the network task.
public function UpdateClientEvent(State: Model.ClientModel; Value: Model.ClientEvent; Cmd: Tui.TuiCmdOutput): Model.ClientModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  const ViewportResponse := Value is Model.ClientEvent.ViewportState(_);
  var Next: Model.ClientModel := State;
  if (Value is Model.ClientEvent.Connected(_)) or (Value is Model.ClientEvent.Worlds(_))
    or
    (Value is Model.ClientEvent.Failed(_)) or (Value is Model.ClientEvent.Disconnected)
    or
    (Value is Model.ClientEvent.Defeated(_))
  then
    Next.ActiveDialogue := None;
    Next.DialogueSelection := 0;
    Next.DialogueOffset := 0;
  end if;

  case Value of
    when Model.ClientEvent.Dialogue(const Projection, const Frame, const Dirty):
      var DialogState := UpdateClientEvent(
        State with PendingChangesProgress := false; Overlay := Model.ClientOverlay.NoOverlay; end with,
        Model.ClientEvent.State(Projection), Cmd
      );
      DialogState.ActiveDialogue := Some(Frame);
      DialogState.DialogueSelection := 0;
      DialogState.DialogueOffset := 0;
      DialogState.Dirty := Dirty;
      DialogState.Status := 'Talking to ' + Frame.Speaker + '.';
      return DialogState;
    when Model.ClientEvent.DialogueEnded(const Projection, const Dirty):
      var Ended := UpdateClientEvent(
        State with PendingChangesProgress := false; Overlay := Model.ClientOverlay.NoOverlay; end with,
        Model.ClientEvent.State(Projection), Cmd
      );
      Ended.ActiveDialogue := None;
      Ended.DialogueSelection := 0;
      Ended.DialogueOffset := 0;
      Ended.Dirty := Dirty;
      return Ended;
    when Model.ClientEvent.Connected(const Catalog), Model.ClientEvent.Worlds(const Catalog):
      begin
        const Installed: Model.ClientModel := UiWorlds.InstallCatalog(Next, Catalog);
        if State.Overlay = Model.ClientOverlay.DefeatOverlay then
          return Installed with Overlay := Model.ClientOverlay.DefeatOverlay; FocusedControl := Controls.OverlayBackControlId; Status := 'You have fallen.'; end with;
        end if;

        return Installed;
      end;
    when Model.ClientEvent.State(const Value), Model.ClientEvent.ViewportState(const Value):
      begin
        Next.Screen := Model.ClientScreen.GameScreen;
        if not ViewportResponse then
          Next.ActiveDialogue := None;
        end if;

        Next.Overlay := if ViewportResponse then State.Overlay
          else Model.ClientOverlay.NoOverlay
          end if;
        // A viewport response during reading must not dismiss the description.
        if State.Overlay = Model.ClientOverlay.DescriptionOverlay then
          begin
            Next.Overlay := Model.ClientOverlay.DescriptionOverlay;
          end;
        end if;

        // Item actions answer with a state; the overlays stay open to show the result.
        if (State.Overlay = Model.ClientOverlay.InventoryOverlay)
          or
          (State.Overlay = Model.ClientOverlay.CharacterSheetOverlay)
          or
          (State.Overlay = Model.ClientOverlay.JournalOverlay)
        then
          begin
            Next.Overlay := State.Overlay;
          end;
        end if;

        Next.ConnectionPhase := Model.ClientConnectionPhase.Active;
        Next.FocusedControl := if ViewportResponse then State.FocusedControl else 0 end if;
        Next.HasVisibleState := true;
        Next.Dirty := State.Dirty or State.PendingChangesProgress;
        if State.PendingCreatedWorld then
          Next.SaveAvailable := false;
          Next.Catalog := State.Catalog with SelectedId := ''; SelectionReason := ''; end with;
        end if;

        Next.PendingChangesProgress := false;
        Next.PendingCreatedWorld := false;
        Next.View := Protocol.ViewForVisibleState(Value);
        case Value of
          when Protocol.VisibleState.MapState(const MapValue):
            begin
              Next.OriginX := MapValue.OriginX;
              Next.OriginY := MapValue.OriginY;
              Next.Width := MapValue.Width;
              Next.Height := MapValue.Height;
              Next.Rows := MapValue.Rows;
              Next.KnowledgeRows := MapValue.KnowledgeRows;
              Next.PlayerX := MapValue.PlayerX;
              Next.PlayerY := MapValue.PlayerY;
              Next.WorldX := MapValue.WorldX;
              Next.WorldY := MapValue.WorldY;
              Next.Inventory := MapValue.Inventory;
              Next.Character := MapValue.Character;
              Next.Journal := MapValue.Journal;
              Next.PrimaryTitle := MapValue.Title;
              Next.PrimaryLevel := 0;
              Next.PrimaryDepth := 1;
              Next.PrimaryStatus := MapValue.Status;
            end;
          when Protocol.VisibleState.FirstPersonState(const FirstPersonValue):
            begin
              Next.OriginX := 0;
              Next.OriginY := 0;
              Next.Width := FirstPersonValue.Width;
              Next.Height := FirstPersonValue.Height;
              Next.Rows := FirstPersonValue.Rows;
              Next.KnowledgeRows := FirstPersonValue.KnowledgeRows;
              Next.PlayerX := FirstPersonValue.PlayerX;
              Next.PlayerY := FirstPersonValue.PlayerY;
              Next.WorldX := 0;
              Next.WorldY := 0;
              Next.FirstPersonFacing := FirstPersonValue.Facing;
              Next.Inventory := FirstPersonValue.Inventory;
              Next.Character := FirstPersonValue.Character;
              Next.Journal := FirstPersonValue.Journal;
              Next.PrimaryTitle := FirstPersonValue.Title;
              Next.PrimaryLevel := FirstPersonValue.Level;
              Next.PrimaryDepth := FirstPersonValue.Depth;
              Next.PrimaryStatus := FirstPersonValue.Status;
            end;
        end case;

        Next.Pending := false;
        var Health: integer := 0;
        var MaxHealth: integer := 0;
        var CombatLog: array of string := [];
        var CombatEvents: array of Protocol.VisibleCombatEvent := [];
        case Value of
          when Protocol.VisibleState.MapState(const MapValue):
            begin
              Health := MapValue.Health;
              MaxHealth := MapValue.MaxHealth;
            end;
          when Protocol.VisibleState.FirstPersonState(const FirstPersonValue):
            begin
              Health := FirstPersonValue.Health;
              MaxHealth := FirstPersonValue.MaxHealth;
              CombatLog := FirstPersonValue.CombatLog;
              CombatEvents := FirstPersonValue.CombatEvents;
            end;
        end case;

        Next := Character.ReconcileInventorySelection(State, Next);
        // Refreshed lines keep the sheet position where possible.
        Next := CharacterSheet.ClampOffset(Next);
        Next := Journal.ClampOffset(Next);
        // Only a drop within one running game flashes; loading or starting never does.
        Next.DamageTaken := (State.HasVisibleState and (State.Health > 0))
          and
          (Health < State.Health);
        Next.Health := Health;
        Next.MaxHealth := MaxHealth;
        for Entry: string in CombatLog do
          begin
            Next := Session.AppendMessage(Next, Entry);
          end;
        end for;

        if Next.View = Protocol.ViewKind.FirstPerson then
          begin
            // A newly carried identity confirms pickup until the next authoritative update.
            // Initial/load projections do not announce existing inventory as a new pickup.
            if State.HasVisibleState then
              begin
                const Carried: array of Protocol.VisibleInventoryItem := Next.Inventory;
                for Item: Protocol.VisibleInventoryItem in Carried do
                  begin
                    var Known: boolean := false;
                    for Previous: Protocol.VisibleInventoryItem in State.Inventory do
                      begin
                        if Previous.Id = Item.Id then
                          begin
                            Known := true;
                          end;
                        end if;
                      end;
                    end for;

                    if not Known then
                      begin
                        Next.PrimaryStatus := 'Picked up: ' + Item.Name;
                      end;
                    end if;
                  end;
                end for;
              end;
            end if;
          end;
        end if;

        Next.Status := 'Connected';
        if CombatLog.Length() > 0 then
          begin
            Next.Status := CombatLog[CombatLog.Length() - 1];
          end;
        end if;

        if Next.View = Protocol.ViewKind.FirstPerson then
          begin
            Next := Playback.StartCombatAnimation(Next, CombatEvents, Cmd);
          end;
        else
          begin
            Next := Playback.StopAnimation(Next);
          end;
        end if;

        return Intentions.QueueViewport(Next);
      end;
    when Model.ClientEvent.ExplorationMap(const Value):
      begin
        Next.MapRequestPending := false;
        Next.MapHasState := true;
        Next.MapView := Value.View;
        Next.MapLabel := Value.LabelText;
        Next.MapOriginX := Value.OriginX;
        Next.MapOriginY := Value.OriginY;
        Next.MapWidth := Value.Width;
        Next.MapHeight := Value.Height;
        Next.MapRows := Value.Rows;
        Next.MapKnowledgeRows := Value.KnowledgeRows;
        Next.MapPlayerWorldX := Value.PlayerWorldX;
        Next.MapPlayerWorldY := Value.PlayerWorldY;
        Next.MapPlayerInWindow := Value.PlayerInWindow;
        Next.Status := 'Map ready.';
        if (Next.Overlay = Model.ClientOverlay.ExplorationMapOverlay)
          and
          (
            (
              (Next.MapDesiredOriginX <> Value.OriginX)
              or
              (Next.MapDesiredOriginY <> Value.OriginY)
            ) or ((Next.MapDesiredWidth <> Value.Width) or (Next.MapDesiredHeight <> Value.Height))
          )
        then
          begin
            return Intentions.QueueExplorationMap(Next);
          end;
        end if;

        return Next;
      end;
    when Model.ClientEvent.Interaction(const Title, const Message):
      begin
        Next.Pending := false;
        Next.PendingChangesProgress := false;
        if Title <> '' then
          begin
            Next.DescriptionTitle := Title;
            Next.DescriptionText := Message;
            Next.DescriptionOffset := 0;
            Next.Overlay := Model.ClientOverlay.DescriptionOverlay;
            Next.FocusedControl := 0;
            Next.Status := 'Reading...';
          end;
        else
          begin
            Next.Status := Message;
          end;
        end if;

        return Session.AppendMessage(Next, Message);
      end;
    when Model.ClientEvent.SaveCompleted:
      begin
        Next.Pending := false;
        Next.SaveAvailable := true;
        Next.Dirty := false;
        Next.Status := 'Game saved.';
        return Session.AppendMessage(Next, Next.Status);
      end;
    when Model.ClientEvent.Defeated(const Message):
      begin
        // The server ended the game session; the connection stays ready for a new session choice.
        Next := Playback.StopAnimation(Next);
        Next.Screen := Model.ClientScreen.StartScreen;
        Next.ConnectionPhase := Model.ClientConnectionPhase.AwaitingSession;
        Next.Overlay := Model.ClientOverlay.DefeatOverlay;
        Next.FocusedControl := Controls.OverlayBackControlId;
        Next.Pending := false;
        Next.MapRequestPending := false;
        Next.HasVisibleState := false;
        Next.DamageTaken := false;
        Next.DefeatMessage := Message;
        Next.Dirty := false;
        Next := UiWorlds.QueueWorldList(Next, 0, false);
        Next.Status := 'You have fallen.';
        return Session.AppendMessage(Next, Message);
      end;
    when Model.ClientEvent.MapRejected(const Code, const Message):
      begin
        Next.MapRequestPending := false;
        Next.Status := Message;
        return Session.AppendMessage(Next, 'Rejected: ' + Message);
      end;
    when Model.ClientEvent.Rejected(const Code, const Message):
      begin
        Next.Pending := false;
        Next.PendingChangesProgress := false;
        Next.PendingCreatedWorld := false;
        if State.PendingCreatedWorld then
          Next.Overlay := Model.ClientOverlay.NewWorldOverlay;
          Next.FocusedControl := Controls.SubmitWorldControlId;
        end if;

        if Code = 'overwrite_required' then
          Next.SaveAvailable := true;
          Next.Overlay := Model.ClientOverlay.SaveConfirmationOverlay;
          Next.FocusedControl := Controls.CancelSaveControlId;
        end if;

        if Code = 'discard_required' then
          Next.Dirty := true;
          Next.Overlay := Model.ClientOverlay.DiscardConfirmationOverlay;
          Next.FocusedControl := Controls.OverlayBackControlId;
        end if;

        if Next.Overlay = Model.ClientOverlay.SessionCancelConfirmationOverlay then
          begin
            Next.Overlay := Model.ClientOverlay.NoOverlay;
            Next.FocusedControl := Controls.NewGameControlId;
          end;
        end if;

        Next.Status := Message;
        return Session.AppendMessage(Next, 'Rejected: ' + Message);
      end;
    when Model.ClientEvent.Failed(const Message):
      begin
        Next := Playback.StopAnimation(Next);
        Next.Screen := Model.ClientScreen.StartScreen;
        Next.HasVisibleState := false;
        Next.ConnectionPhase := Model.ClientConnectionPhase.Failed;
        Next.Overlay := Model.ClientOverlay.NoOverlay;
        Next.FocusedControl := Controls.ConnectControlId;
        Next.Pending := false;
        Next.Status := 'Connection failed: ' + Message;
        return Session.AppendMessage(Next, Next.Status);
      end;
    when Model.ClientEvent.Disconnected:
      begin
        Next := Playback.StopAnimation(Next);
        Next.Screen := Model.ClientScreen.StartScreen;
        Next.HasVisibleState := false;
        Next.ConnectionPhase := Model.ClientConnectionPhase.Disconnected;
        Next.Overlay := Model.ClientOverlay.NoOverlay;
        Next.FocusedControl := Controls.ConnectControlId;
        Next.Pending := false;
        Next.Status := 'Disconnected';
        return Session.AppendMessage(Next, 'Disconnected');
      end;
  end case;
end function;
end unit;
