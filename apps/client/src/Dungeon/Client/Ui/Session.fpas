// Client session lifecycle: connecting, session choice, saving, quitting, overlays, panels, and the message log.
unit Dungeon.Client.Ui.Session;

uses Dungeon.Client.Ui.Controls as Controls, Dungeon.Client.Ui.Intentions as Intentions, Dungeon.Client.Ui.Layout as Layout, Dungeon.Client.Model as Model, Dungeon.Client.Network as Network, Dungeon.Protocol as Protocol, Dungeon.Protocol.Worlds as WorldsUnit, Dungeon.RuntimeData as RuntimeData, Std.Conv as Conv, Std.Tasks as Tasks, Std.Tui as Tui;

// Appends one entry to the bounded message history, dropping the oldest.
public function AppendMessage(State: Model.ClientModel; Text: string): Model.ClientModel;
begin
  var Next: Model.ClientModel := State;
  var Values: array of string := State.Messages.Concat([Text]);
  if Values.Length() > Layout.MaximumMessages then
    begin
      Values := Values.Slice(Values.Length() - Layout.MaximumMessages, Layout.MaximumMessages);
    end;
  end if;

  Next.Messages := Values;
  return Next;
end function;

// Closes the active overlay and restores the focus that belongs to the screen below it.
public function CloseOverlay(State: Model.ClientModel): Model.ClientModel;
begin
  var Next: Model.ClientModel := State;
  Next.CharacterSheetOffset := 0;
  Next.JournalOffset := 0;
  if State.Overlay = Model.ClientOverlay.DescriptionOverlay then
    begin
      Next.Status := 'Ready';
      Next.DescriptionTitle := '';
      Next.DescriptionText := '';
      Next.DescriptionOffset := 0;
    end;
  end if;

  if State.Overlay = Model.ClientOverlay.SessionCancelConfirmationOverlay then
    begin
      Next.Overlay := Model.ClientOverlay.NoOverlay;
      Next.FocusedControl := Controls.CancelSessionStartControlId;
      return Next;
    end;
  end if;

  if (State.Overlay = Model.ClientOverlay.SaveConfirmationOverlay)
    or
    (State.Overlay = Model.ClientOverlay.DiscardConfirmationOverlay)
  then
    begin
      Next.Overlay := Model.ClientOverlay.SystemMenuOverlay;
      Next.FocusedControl := Controls.SaveControlId;
      return Next;
    end;
  end if;

  if State.Overlay = Model.ClientOverlay.InformationOverlay then
    begin
      if State.Screen = Model.ClientScreen.StartScreen then
        begin
          if State.ConnectionPhase = Model.ClientConnectionPhase.AwaitingSession then
            begin
              Next.FocusedControl := Controls.NewGameControlId;
            end;
          else
            begin
              Next.FocusedControl := Controls.ConnectControlId;
            end;
          end if;
        end;
      else
        begin
          Next.Overlay := Model.ClientOverlay.SystemMenuOverlay;
          Next.FocusedControl := Controls.ResumeControlId;
          return Next;
        end;
      end if;
    end;
  end if;

  Next.Overlay := Model.ClientOverlay.NoOverlay;
  Next.FocusedControl := 0;
  if State.Screen = Model.ClientScreen.StartScreen then
    begin
      if State.ConnectionPhase = Model.ClientConnectionPhase.AwaitingSession then
        begin
          // A closed defeat report may reveal a catalog request that is still pending.
          Next.FocusedControl := if State.Pending then Controls.CancelSessionStartControlId
            else Controls.NewGameControlId
            end if;
        end;
      else
        begin
          Next.FocusedControl := Controls.ConnectControlId;
        end;
      end if;
    end;
  end if;

  return Next;
end function;

// Invalidates the current attempt, closes its request queue and cancels it before quitting.
public function RequestQuit(State: Model.ClientModel; Cmd: Tui.TuiCmdOutput): Model.ClientModel;
begin
  discard Tasks.CloseChannel(State.Requests);
  Cmd.CancelSubscription(Controls.NetworkSubscriptionId);
  Cmd.Set(Tui.TuiCmd.Quit);
  return State with ConnectionGeneration := State.ConnectionGeneration + 1; end with;
end function;

// Starts the network subscription and shows the connecting start screen.
public function StartConnection(State: Model.ClientModel; Cmd: Tui.TuiCmdOutput): Model.ClientModel;
begin
  const Host: string := State.Host;
  const Port: integer := State.Port;
  discard Tasks.CloseChannel(State.Requests);
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(1);
  const Events := State.Events;
  const Generation := State.ConnectionGeneration + 1;
  const Viewport: Layout.WorldViewport := Layout.DesiredWorldViewport(State);
  Cmd.ReplaceSubscription(
    Controls.NetworkSubscriptionId,
    function(Token: Tasks.CancellationToken): result of (boolean, string) begin
      const PublishEvent: Network.EventPublisher := function(Value: Model.ClientEvent): result of (boolean, string) begin
        return Tasks.SendWithCancellation(
          Events, Model.ConnectionEvent(Generation := Generation, Value := Value), Token
        );
      end function;

      case Network.RunNetworkPublishing(
        Host,
        Port,
        Viewport.Width,
        Viewport.Height,
        Requests,
        PublishEvent,
        Token
      ) of
        when Ok(const Completed):
          return Ok(Completed);
        when Error(const Reason):
          // The host silently reaps ordinary task results; deliver failures through its typed inbox.
          return PublishEvent(Model.ClientEvent.Failed(Reason));
      end case;
    end function
  );
  var Next: Model.ClientModel := State;
  Next.Requests := Requests;
  Next.ConnectionGeneration := Generation;
  Next.Screen := Model.ClientScreen.StartScreen;
  Next.Overlay := Model.ClientOverlay.NoOverlay;
  Next.ConnectionPhase := Model.ClientConnectionPhase.Connecting;
  Next.FocusedControl := 0;
  Next.Pending := false;
  Next.RequestedWorldWidth := Viewport.Width;
  Next.RequestedWorldHeight := Viewport.Height;
  Next.HasVisibleState := false;
  Next.Status := ('Connecting to ' + Host) + (':' + Conv.IntToStr(Port));
  return AppendMessage(Next, Next.Status);
end function;

// Invalidates the attempt before the host cancels it; queued old events cannot restore gameplay.
public function ReturnToStart(State: Model.ClientModel; Cmd: Tui.TuiCmdOutput): Model.ClientModel;
begin
  discard Tasks.CloseChannel(State.Requests);
  Cmd.CancelSubscription(Controls.NetworkSubscriptionId);
  var Next: Model.ClientModel := State;
  Next.ConnectionGeneration := State.ConnectionGeneration + 1;
  Next.Screen := Model.ClientScreen.StartScreen;
  Next.Overlay := Model.ClientOverlay.NoOverlay;
  Next.ConnectionPhase := Model.ClientConnectionPhase.Offline;
  Next.FocusedControl := Controls.ConnectControlId;
  Next.Pending := false;
  Next.HasVisibleState := false;
  Next.SaveAvailable := false;
  Next.CharacterSheetOffset := 0;
  Next.JournalOffset := 0;
  Next.Status := 'Ready';
  return Next;
end function;

// Sends a new-game or load request while the server awaits a session choice.
public function QueueSessionChoice(State: Model.ClientModel; Message: Protocol.ClientMessage; Status: string): Model.ClientModel;
begin
  if (State.ConnectionPhase <> Model.ClientConnectionPhase.AwaitingSession) or State.Pending then
    begin
      return State;
    end;
  end if;

  case Tasks.TrySend(State.Requests, Message) of
    when Ok(const Queued):
      if not Queued then
        begin
          return State;
        end;
      end if;
      var Next: Model.ClientModel := State;
      Next.Pending := true;
      Next.PendingCreatedWorld := false;
      Next.PendingChangesProgress := Message = Protocol.ClientMessage.StartNewGame;
      case Message of
        when Protocol.ClientMessage.CreateWorld(const Seed, const RegionChunks):
          begin
            Next.PendingCreatedWorld := true;
            Next.PendingChangesProgress := true;
          end;
        when Protocol.ClientMessage.LoadGame:
          begin
            Next.PendingChangesProgress := not WorldsUnit.CatalogHasSave(State.Catalog);
          end;
        when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
          begin
            null;
          end;
      end case;

      Next.FocusedControl := Controls.CancelSessionStartControlId;
      Next.Status := Status;
      return Next;
    when Error(_):
      return State;
  end case;
end function;

// Sends a save request during an active game with nothing pending.
public function QueueSave(State: Model.ClientModel): Model.ClientModel;
begin
  if (
    (State.ConnectionPhase <> Model.ClientConnectionPhase.Active) or State.Pending
    or
    State.MapRequestPending
  )
    or
    not State.HasVisibleState
  then
    begin
      return State;
    end;
  end if;
  var Message: Protocol.ClientMessage := Protocol.ClientMessage.SaveGame;
  if State.Overlay = Model.ClientOverlay.SaveConfirmationOverlay then
    Message := Protocol.ClientMessage.OverwriteSaveGame;
  end if;

  case Tasks.TrySend(State.Requests, Message) of
    when Ok(const Queued):
      if not Queued then
        begin
          return State;
        end;
      end if;
      var Next: Model.ClientModel := State;
      Next.Overlay := Model.ClientOverlay.NoOverlay;
      Next.FocusedControl := 0;
      Next.Pending := true;
      Next.Status := 'Saving game...';
      return Next;
    when Error(_):
      return State;
  end case;
end function;

function PersistPanelPreferences(State: Model.ClientModel): Model.ClientModel;
begin
  if State.ClientConfigPath.Length() = 0 then
    begin
      return State;
    end;
  end if;

  case RuntimeData.SaveClientPreferences(
    State.ClientConfigPath,
    RuntimeData.ClientPreferences(
      ContextPanelVisible := State.ContextPanelVisible,
      MessagePanelVisible := State.MessagePanelVisible
    )
  ) of
    when Ok(const Written):
      begin
        return State;
      end;
    when Error(const Message):
      begin
        var Next: Model.ClientModel := State;
        Next.Status := 'Cannot save client preferences: ' + Message;
        return AppendMessage(Next, Next.Status);
      end;
  end case;
end function;

// Shows or hides the context panel, docked or as an overlay, and stores the preference.
public function ToggleContext(State: Model.ClientModel): Model.ClientModel;
begin
  var Next: Model.ClientModel := State;
  if Layout.ContextCanDock(State) then
    begin
      Next.ContextPanelVisible := not State.ContextPanelVisible;
      Next := Intentions.QueueViewport(Next);
      return PersistPanelPreferences(Next);
    end;
  end if;

  if State.Overlay = Model.ClientOverlay.ContextOverlay then
    begin
      return CloseOverlay(State);
    end;
  end if;

  Next.Overlay := Model.ClientOverlay.ContextOverlay;
  Next.FocusedControl := Controls.PanelCloseControlId;
  return Next;
end function;

// Shows or hides the message panel, docked or as an overlay, and stores the preference.
public function ToggleMessages(State: Model.ClientModel): Model.ClientModel;
begin
  var Next: Model.ClientModel := State;
  if Layout.MessagesCanDock(State) then
    begin
      Next.MessagePanelVisible := not State.MessagePanelVisible;
      Next := Intentions.QueueViewport(Next);
      return PersistPanelPreferences(Next);
    end;
  end if;

  if State.Overlay = Model.ClientOverlay.MessageOverlay then
    begin
      return CloseOverlay(State);
    end;
  end if;

  Next.Overlay := Model.ClientOverlay.MessageOverlay;
  Next.FocusedControl := Controls.PanelCloseControlId;
  return Next;
end function;
end unit;
