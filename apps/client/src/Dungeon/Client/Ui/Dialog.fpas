// Shared client dialog geometry, bounded content, semantic actions and bottom-aligned footers.
unit Dungeon.Client.Ui.Dialog;

uses
  Dungeon.Client.Model as Model, Dungeon.Client.Ui.Controls as Controls,
  Dungeon.Ui.Overlay as Overlay, Std.Math as Math, Std.Ui.Terminal as Tui;

// Client dialogs follow the same baseline and viewport-relative margins as server settings.
public function Rule(): Tui.TuiOverlaySizeRule;
begin
  return Tui.TuiOverlaySizeRule.Create(Tui.TuiSize.Create(72, 17), 4, 25);
end function;

// Before the first terminal event, render against the baseline terminal rather than a zero viewport.
public function Size(State: Model.ClientModel): Tui.TuiSize;
begin
  return Rule().Resolve(
    Tui.TuiSize.Create(
      if State.ViewportWidth > 0 then State.ViewportWidth else 80 end if,
      if State.ViewportHeight > 0 then State.ViewportHeight else 25 end if
    )
  );
end function;

// Usable width inside the frame and one-cell inset.
public function Width(State: Model.ClientModel): integer;
begin
  return Math.Max(1, Size(State).Width - 4);
end function;

// On short terminals spacing contracts before the action row or content is hidden.
function Gap(State: Model.ClientModel): integer;
begin
  return if Size(State).Height >= 12 then 1 else 0 end if;
end function;

// Content height excludes the frame, inset, optional gap and all reserved footer rows.
public function BodyRows(State: Model.ClientModel; FooterRows: integer): integer;
begin
  return Math.Max(1, Size(State).Height - 4 - FooterRows - Gap(State));
end function;

// Left secondary actions and right primary/cancel actions share the content width.
public function Actions(Left: array of Tui.TuiElement; Right: array of Tui.TuiElement): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeRow([
    Tui.TuiElementBuilders.MakeRowSpaced(Left, 1),
    Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Expanding(0)),
    Tui.TuiElementBuilders.MakeRowSpaced(Right, 1)
  ]);
end function;

// Closing a local modal retains the existing ClosePanelAction routing and keyboard shortcuts.
public function CloseButton(): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeButtonOfKind(
    Tui.TuiControlId.Create(Controls.PanelCloseControlId), 'Close',
    Tui.TuiAction.Create(Controls.ClosePanelAction), Tui.TuiButtonKind.Cancel
  );
end function;

// Keyboard-controlled game windows retain their own key routing and show closing shortcuts as hints.
public function Hint(Text: string): Tui.TuiElement;
begin
  return Tui.TuiElement.Label(Tui.TuiLabel(Text := Text, Role := Tui.TuiStyleRole.Disabled));
end function;

// Lists have their own continuous frame and reserve two rows for its edges.
public function ListFrame(Content: Tui.TuiElement; Rows: integer; Width: integer): Tui.TuiElement;
begin
  const Fill := Tui.TuiLayoutSettings.Default() with SizePolicy := Tui.TuiSizePolicy.Expanding(); end with;

  return Tui.TuiElementBuilders.MakeLayout(
    Tui.TuiLayoutSettings.Default().WithFixedWidth(Width).WithFixedHeight(Rows + 2),
    Tui.TuiElementBuilders.MakePanel(
      '', [
        Tui.TuiElementBuilders.MakeLayout(
          Fill.WithFixedWidth(Math.Max(1, Width - 2)).WithFixedHeight(Rows),
          Content
        )
      ]
    )
  );
end function;

// Fixed body and footer bounds prevent long or changing content from moving the actions.
public function View(
  State: Model.ClientModel; Title: string;
  Body: array of Tui.TuiElement; Footer: array of Tui.TuiElement
): Tui.TuiElement;
begin
  return Overlay.Responsive(
    Title, Rule(), [
      Tui.TuiElementBuilders.MakeLayout(
        Tui.TuiLayoutSettings.Default().WithFixedWidth(
          Width(State)
        ).WithFixedHeight(BodyRows(State, Footer.Length())),
        Tui.TuiElementBuilders.MakeColumn(Body)
      ),
      Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Fixed(Gap(State))),
      Tui.TuiElementBuilders.MakeLayout(
        Tui.TuiLayoutSettings.Default().WithFixedWidth(
          Width(State)
        ).WithFixedHeight(Footer.Length()),
        Tui.TuiElementBuilders.MakeColumn(Footer)
      )
    ]
  );
end function;

// Read-only overflowing bodies scroll independently of their fixed action rows.
public function Scrollable(
  State: Model.ClientModel; Title: string;
  Content: Tui.TuiElement; Footer: array of Tui.TuiElement
): Tui.TuiElement;
begin
  return View(
    State, Title, [
      Tui.TuiElementBuilders.MakeLayout(
        Tui.TuiLayoutSettings.Default().WithFixedWidth(
          Width(State)
        ).WithFixedHeight(BodyRows(State, Footer.Length())),
        Tui.TuiElementBuilders.MakeScroll(
          Tui.TuiControlId.Create(Controls.DialogScrollControlId),
          Tui.TuiPoint.Create(0, State.DialogScrollOffset),
          Tui.TuiAction.Create(Controls.DialogScrollAction), Content
        )
      )
    ], Footer
  );
end function;
end unit;
