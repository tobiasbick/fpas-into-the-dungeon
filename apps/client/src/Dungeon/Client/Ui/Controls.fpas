// Stable control, action, and background subscription identities of the client TUI.
unit Dungeon.Client.Ui.Controls;

uses Dungeon.Protocol as Protocol, Dungeon.Protocol.Worlds as Worlds;

// Background session that owns the TCP connection.
public const NetworkSubscriptionId: integer := 1;
// Focusable controls of the start screen; values are unique across all screens.
public const ConnectControlId: integer := 1;
public const StartInformationControlId: integer := 2;
public const StartQuitControlId: integer := 3;
public const NewGameControlId: integer := 4;
public const LoadGameControlId: integer := 5;
public const StartDisconnectControlId: integer := 6;
public const CancelSessionStartControlId: integer := 7;
// Controls of the system menu.
public const ResumeControlId: integer := 10;
public const SystemInformationControlId: integer := 11;
public const DisconnectControlId: integer := 12;
public const SystemQuitControlId: integer := 13;
public const SaveControlId: integer := 14;
// Shared overlay controls: leave an overlay or close a panel overlay.
public const OverlayBackControlId: integer := 20;
public const PanelCloseControlId: integer := 21;
// Scrollable dialog bodies retain their own offset above the fixed action row.
public const DialogScrollControlId: integer := 22;
// Native lists keep gameplay keyboard ownership while accepting pointer selection/activation.
public const InventoryListControlId: integer := 23;
public const TradeListControlId: integer := 24;
public const DialogueListControlId: integer := 25;
// Form diagnostics must have a distinct identity from the catalog rendered behind the modal.
public const WorldStatusControlId: integer := 26;
public const WorldStatusScrollAction: integer := 129;
public const InventorySelectAction: integer := 123;
public const TradeSelectAction: integer := 124;
public const DialogueSelectAction: integer := 125;
public const InventoryActivateAction: integer := 126;
public const TradeActivateAction: integer := 127;
public const DialogueActivateAction: integer := 128;
// Controls of the save and session-cancel confirmations.
public const ConfirmSaveControlId: integer := 30;
public const CancelSaveControlId: integer := 31;
public const ConfirmCancelSessionControlId: integer := 32;
public const ContinueSessionStartControlId: integer := 33;
// Actions emitted by the controls above; HandleAction interprets them.
public const ConnectAction: integer := 101;
public const InformationAction: integer := 102;
public const QuitAction: integer := 103;
public const NewGameAction: integer := 104;
public const LoadGameAction: integer := 105;
public const ResumeAction: integer := 110;
public const DisconnectAction: integer := 111;
public const SaveAction: integer := 112;
public const BackAction: integer := 120;
public const ClosePanelAction: integer := 121;
public const DialogScrollAction: integer := 122;
public const ConfirmSaveAction: integer := 130;
public const CancelSaveAction: integer := 131;
public const RequestCancelSessionAction: integer := 132;
public const ConfirmCancelSessionAction: integer := 133;
public const ContinueSessionStartAction: integer := 134;
// World catalog navigation and parameter-editor identities.
public const WorldListControlId: integer := 40;
public const CreateWorldControlId: integer := 41;
public const SeedControlId: integer := 42;
public const RegionControlId: integer := 43;
public const SubmitWorldControlId: integer := 44;
public const WorldSelectionControlId: integer := 45;
public const DiscardControlId: integer := 46;
public const PreviousWorldsControlId: integer := 47;
public const NextWorldsControlId: integer := 48;
public const RefreshWorldsControlId: integer := 49;
// Four adjacent seed-preset buttons use identical control and action IDs.
public const FirstSeedPresetControlId: integer := 50;
public const CreateWorldAction: integer := 140;
public const SeedChangedAction: integer := 141;
public const RegionChangedAction: integer := 142;
public const SubmitWorldAction: integer := 143;
public const WorldSelectionAction: integer := 144;
public const ConfirmDiscardAction: integer := 145;
public const PreviousWorldsAction: integer := 146;
public const NextWorldsAction: integer := 147;
public const SelectWorldAction: integer := 148;
public const RefreshWorldsAction: integer := 149;

// Chooses a catalog button that exists even without a compatible selected world.
public function CatalogFocus(Catalog: Protocol.WorldCatalog): integer;
begin
  case Worlds.SelectedWorld(Catalog) of
    when Some(const World):
      if World.Status = 'ready' then
        return NewGameControlId;
      end if;
    when None:
      null;
  end case;

  return CreateWorldControlId;
end function;
end unit;
