// Stable control, action, and background subscription identities of the client TUI.
unit Dungeon.Client.Ui.Controls;

public const
  // Background session that owns the TCP connection.
  NetworkSubscriptionId: integer := 1;
  // Focusable controls of the start screen; values are unique across all screens.
  ConnectControlId: integer := 1;
  StartInformationControlId: integer := 2;
  StartQuitControlId: integer := 3;
  NewGameControlId: integer := 4;
  LoadGameControlId: integer := 5;
  StartDisconnectControlId: integer := 6;
  CancelSessionStartControlId: integer := 7;
  // Controls of the system menu.
  ResumeControlId: integer := 10;
  SystemInformationControlId: integer := 11;
  DisconnectControlId: integer := 12;
  SystemQuitControlId: integer := 13;
  SaveControlId: integer := 14;
  // Shared overlay controls: leave an overlay or close a panel overlay.
  OverlayBackControlId: integer := 20;
  PanelCloseControlId: integer := 21;
  // Controls of the save and session-cancel confirmations.
  ConfirmSaveControlId: integer := 30;
  CancelSaveControlId: integer := 31;
  ConfirmCancelSessionControlId: integer := 32;
  ContinueSessionStartControlId: integer := 33;
  // Actions emitted by the controls above; HandleAction interprets them.
  ConnectAction: integer := 101;
  InformationAction: integer := 102;
  QuitAction: integer := 103;
  NewGameAction: integer := 104;
  LoadGameAction: integer := 105;
  ResumeAction: integer := 110;
  DisconnectAction: integer := 111;
  SaveAction: integer := 112;
  BackAction: integer := 120;
  ClosePanelAction: integer := 121;
  ConfirmSaveAction: integer := 130;
  CancelSaveAction: integer := 131;
  RequestCancelSessionAction: integer := 132;
  ConfirmCancelSessionAction: integer := 133;
  ContinueSessionStartAction: integer := 134;
  // World catalog navigation and parameter-editor identities.
  WorldListControlId: integer := 40;
  CreateWorldControlId: integer := 41;
  SeedControlId: integer := 42;
  RegionControlId: integer := 43;
  SubmitWorldControlId: integer := 44;
  WorldSelectionControlId: integer := 45;
  DiscardControlId: integer := 46;
  PreviousWorldsControlId: integer := 47;
  NextWorldsControlId: integer := 48;
  RefreshWorldsControlId: integer := 49;
  CreateWorldAction: integer := 140;
  SeedChangedAction: integer := 141;
  RegionChangedAction: integer := 142;
  SubmitWorldAction: integer := 143;
  WorldSelectionAction: integer := 144;
  ConfirmDiscardAction: integer := 145;
  PreviousWorldsAction: integer := 146;
  NextWorldsAction: integer := 147;
  SelectWorldAction: integer := 148;
  RefreshWorldsAction: integer := 149;
end unit;
