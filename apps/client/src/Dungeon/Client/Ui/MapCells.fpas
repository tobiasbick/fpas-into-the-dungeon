// Colored terminal cells for map rows, Fog of War, and the player marker.
unit Dungeon.Client.Ui.MapCells;

uses Dungeon.Client.Model as Model, Dungeon.Protocol as Protocol, Std.Tui as Tui;

// Builds one terminal cell from a glyph and foreground and background RGB colors.
public function ColoredCell(
  Glyph: string;
  ForegroundRed: integer;
  ForegroundGreen: integer;
  ForegroundBlue: integer;
  BackgroundRed: integer;
  BackgroundGreen: integer;
  BackgroundBlue: integer
): Tui.TuiCell;
begin
  return Tui.TuiCell.Styled(
    Glyph,
    Tui.TuiStyle.FromColors(
      Tui.TuiColor.FromRgb(ForegroundRed, ForegroundGreen, ForegroundBlue),
      Tui.TuiColor.FromRgb(BackgroundRed, BackgroundGreen, BackgroundBlue)
    )
  );
end function;

function TerrainCell(Code: string; SecondColumn: boolean): Tui.TuiCell;
begin
  var Glyph: string := ' ';
  if not SecondColumn then
    begin
      case Code of
        when Protocol.MapGrassCode:
          begin
            Glyph := '·';
          end;
        when Protocol.MapTreeCode:
          begin
            Glyph := '♣';
          end;
        when Protocol.MapForestCode:
          begin
            Glyph := '░';
          end;
        when Protocol.MapDesertCode:
          begin
            Glyph := '·';
          end;
        when Protocol.MapMountainCode:
          begin
            Glyph := '▲';
          end;
        when Protocol.MapSeaCode:
          begin
            Glyph := '≈';
          end;
        when Protocol.MapRiverCode:
          begin
            Glyph := '≈';
          end;
        when Protocol.MapLakeCode:
          begin
            Glyph := '∼';
          end;
        when Protocol.MapPathCode:
          begin
            Glyph := '·';
          end;
        when Protocol.MapEntranceCode:
          begin
            Glyph := '◆';
          end;
        when Protocol.MapSettlementGateCode:
          Glyph := '⌂';
        when Protocol.InteriorWallCode:
          Glyph := '▩';
        when Protocol.InteriorFloorCode:
          Glyph := '·';
        when Protocol.InteriorExitCode:
          Glyph := '⌂';
        when Protocol.MapNpcCode:
          Glyph := 'M';
        else
          begin
            Glyph := '?';
          end;
      end case;
    end;
  end if;

  case Code of
    when Protocol.MapGrassCode:
      begin
        return ColoredCell(Glyph, 136, 186, 110, 40, 92, 52);
      end;
    when Protocol.MapTreeCode:
      begin
        return ColoredCell(Glyph, 78, 166, 85, 40, 92, 52);
      end;
    when Protocol.MapForestCode:
      begin
        return ColoredCell(Glyph, 102, 173, 101, 24, 67, 40);
      end;
    when Protocol.MapDesertCode:
      begin
        return ColoredCell(Glyph, 235, 207, 128, 151, 116, 58);
      end;
    when Protocol.MapMountainCode:
      begin
        return ColoredCell(Glyph, 224, 228, 232, 82, 89, 96);
      end;
    when Protocol.MapSeaCode:
      begin
        return ColoredCell(Glyph, 116, 184, 255, 18, 65, 122);
      end;
    when Protocol.MapRiverCode:
      begin
        return ColoredCell(Glyph, 189, 231, 255, 30, 112, 171);
      end;
    when Protocol.MapLakeCode:
      begin
        return ColoredCell(Glyph, 176, 235, 255, 35, 125, 156);
      end;
    when Protocol.MapPathCode:
      begin
        return ColoredCell(Glyph, 236, 210, 156, 116, 83, 47);
      end;
    when Protocol.MapEntranceCode:
      begin
        return ColoredCell(Glyph, 255, 221, 112, 72, 42, 92);
      end;
    when Protocol.InteriorWallCode:
      return ColoredCell(Glyph, 216, 207, 190, 74, 67, 59);
    when Protocol.InteriorFloorCode:
      return ColoredCell(Glyph, 180, 169, 143, 56, 65, 51);
    when Protocol.InteriorExitCode:
      return ColoredCell(Glyph, 255, 221, 112, 92, 66, 38);
    when Protocol.MapNpcCode:
      return ColoredCell(Glyph, 238, 190, 255, 69, 42, 88);
    when Protocol.MapSettlementGateCode:
      return ColoredCell(Glyph, 255, 232, 170, 92, 66, 38);
    else
      begin
        return ColoredCell(Glyph, 255, 255, 255, 80, 0, 80);
      end;
  end case;
end function;

function PlayerCell(SecondColumn: boolean): Tui.TuiCell;
begin
  if SecondColumn then
    begin
      return ColoredCell(' ', 255, 245, 190, 150, 68, 24);
    end;
  end if;

  return ColoredCell('●', 255, 250, 210, 150, 68, 24);
end function;

function KnowledgeCell(Cell: Tui.TuiCell; KnowledgeCode: string): Tui.TuiCell;
begin
  if KnowledgeCode = Protocol.KnowledgeUndiscoveredCode then
    begin
      return ColoredCell(' ', 52, 58, 64, 9, 12, 16);
    end;
  end if;

  if KnowledgeCode = Protocol.KnowledgeRememberedCode then
    begin
      case Cell.ConcreteStyle of
        when Some(const Style):
          var RememberedStyle: Tui.TuiStyle := Style;
          // Dim both halves of a terrain cell independently of terminal dim support.
          RememberedStyle.Foreground := Tui.TuiColor.FromRgb(
            Style.Foreground.Red div 2, Style.Foreground.Green div
            2, Style.Foreground.Blue div
            2
          );
          RememberedStyle.Background := Tui.TuiColor.FromRgb(
            Style.Background.Red div 2, Style.Background.Green div
            2, Style.Background.Blue div
            2
          );
          RememberedStyle.Dim := false;
          return Tui.TuiCell.Styled(Cell.Glyph, RememberedStyle);
        when None:
          return Cell;
      end case;
    end;
  end if;

  return Cell;
end function;

function InteriorMapCell(Code: string): Tui.TuiCell;
begin
  case Code of
    when Protocol.InteriorWallCode:
      begin
        return ColoredCell('█', 184, 178, 168, 62, 58, 55);
      end;
    when Protocol.InteriorFloorCode:
      begin
        return ColoredCell('·', 136, 130, 118, 30, 28, 27);
      end;
    when Protocol.InteriorExitCode:
      begin
        return ColoredCell('◆', 255, 221, 112, 72, 42, 92);
      end;
    when Protocol.InteriorStairsUpCode:
      return ColoredCell('<', 236, 226, 196, 84, 76, 62);
    when Protocol.InteriorStairsDownCode:
      return ColoredCell('>', 236, 226, 196, 40, 34, 30);
    when Protocol.InteriorItemCode:
      begin
        return ColoredCell('●', 255, 220, 96, 78, 57, 24);
      end;
    when Protocol.InteriorWeaponCode:
      begin
        return ColoredCell('†', 214, 222, 232, 58, 58, 64);
      end;
    when Protocol.InteriorArmorCode:
      begin
        return ColoredCell('▼', 214, 160, 104, 70, 46, 28);
      end;
    when Protocol.InteriorPotionCode:
      return ColoredCell('!', 244, 84, 112, 66, 22, 36);
    when Protocol.InteriorHostileCode:
      begin
        return ColoredCell('☠', 255, 214, 204, 110, 24, 24);
      end;
    when Protocol.InteriorRatCode:
      return ColoredCell('r', 202, 164, 132, 60, 38, 30);
    else
      begin
        return ColoredCell(' ', 52, 58, 64, 9, 12, 16);
      end;
  end case;
end function;

// Darkens map backgrounds at night; glyphs and marker foregrounds remain readable.
function NightCell(Cell: Tui.TuiCell; Phase: Protocol.DayPhase): Tui.TuiCell;
begin
  if Phase = Protocol.DayPhase.Night then
    case Cell.ConcreteStyle of
      when Some(const Style):
        var Night := Style;
        Night.Background := Tui.TuiColor.FromRgb(
          Style.Background.Red div 2,
          Style.Background.Green div 2, Style.Background.Blue div 2
        );
        return Tui.TuiCell.Styled(Cell.Glyph, Night);
      when None:
        return Cell;
    end case;
  end if;

  return Cell;
end function;

// Renders the primary map view from the projected rows with Fog of War and server-authored phase.
public function MapGrid(State: Model.ClientModel): Tui.TuiCellGrid;
begin
  var Cells: array of Tui.TuiCell := [];
  for Y: integer := 0 to State.Height - 1 do
    begin
      for X: integer := 0 to State.Width - 1 do
        begin
          const IsPlayer: boolean := (X = State.PlayerX) and (Y = State.PlayerY);
          const Code: string := State.Rows[Y][X];
          const Knowledge: string := State.KnowledgeRows[Y][X];
          if IsPlayer then
            begin
              Cells.PushInPlace(PlayerCell(false));
              Cells.PushInPlace(PlayerCell(true));
            end;
          else
            begin
              Cells.PushInPlace(
                KnowledgeCell(NightCell(TerrainCell(Code, false), State.DayPhase), Knowledge)
              );
              Cells.PushInPlace(
                KnowledgeCell(NightCell(TerrainCell(Code, true), State.DayPhase), Knowledge)
              );
            end;
          end if;
        end;
      end for;
    end;
  end for;

  return Tui.TuiCellGrid.Create(State.Width * 2, State.Height, Cells);
end function;

// Renders the exploration-map window, one terminal cell per field.
public function ExplorationMapGrid(State: Model.ClientModel): Tui.TuiCellGrid;
begin
  var Cells: array of Tui.TuiCell := [];
  for Y: integer := 0 to State.MapHeight - 1 do
    begin
      for X: integer := 0 to State.MapWidth - 1 do
        begin
          const WorldX: integer := State.MapOriginX + X;
          const WorldY: integer := State.MapOriginY + Y;
          const IsPlayer: boolean := (State.MapPlayerInWindow and (WorldX = State.MapPlayerWorldX))
            and
            (WorldY = State.MapPlayerWorldY);
          const Code: string := State.MapRows[Y][X];
          const Knowledge: string := State.MapKnowledgeRows[Y][X];
          if IsPlayer then
            begin
              Cells.PushInPlace(PlayerCell(false));
            end;
          else
            if State.MapView = Protocol.ViewKind.Map then
              begin
                Cells.PushInPlace(
                  KnowledgeCell(NightCell(TerrainCell(Code, false), State.DayPhase), Knowledge)
                );
              end;
            else
              begin
                Cells.PushInPlace(KnowledgeCell(InteriorMapCell(Code), Knowledge));
              end;
            end if;
          end if;
        end;
      end for;
    end;
  end for;

  return Tui.TuiCellGrid.Create(State.MapWidth, State.MapHeight, Cells);
end function;
end unit;
