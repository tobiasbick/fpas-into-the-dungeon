// Queues one turn-consuming combat intention such as attack or wait.
public function QueueCombatAction(State: ClientModel; Message: ClientMessage; Status: string): ClientModel;
begin
  if (State.ConnectionPhase <> ClientConnectionPhase.Active) or State.Pending then
  begin
    return State
  end;

  case TrySend(State.Requests, Message) of
    Ok(Queued):
    begin
      if not Queued then
      begin
        return State
      end;
      mutable var Next: ClientModel := State;
      Next.Pending := true;
      Next.Status := Status;
      return Next
    end
    else
    begin
      return State
    end
  end
end;

