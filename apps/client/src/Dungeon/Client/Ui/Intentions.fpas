// Sends the selected dialogue choice while the dialogue overlay is open and nothing is pending.
public function QueueDialogueChoice(State: ClientModel): ClientModel;
begin
  if ((State.Overlay <> ClientOverlay.DialogueOverlay) or State.Pending) or
     ((State.DialogueSelection < 0) or (State.DialogueSelection >= Std.Arrays.Length(State.DialogueChoices))) then
  begin
    return State
  end;
  var Choice: VisibleDialogueChoice := State.DialogueChoices[State.DialogueSelection];
  case TrySend(State.Requests, ClientMessage.DialogueChoice(Choice.Id)) of
    Ok(Queued):
    begin
      if not Queued then
      begin
        return State
      end;
      mutable var Next: ClientModel := State;
      Next.Pending := true;
      Next.Status := 'Responding...';
      return Next
    end
    else
    begin
      return State
    end
  end
end;

// Asks the server to end the open dialogue while nothing is pending.
public function QueueDialogueEnd(State: ClientModel): ClientModel;
begin
  if (State.Overlay <> ClientOverlay.DialogueOverlay) or State.Pending then
  begin
    return State
  end;

  case TrySend(State.Requests, ClientMessage.EndDialogue) of
    Ok(Queued):
    begin
      if not Queued then
      begin
        return State
      end;
      mutable var Next: ClientModel := State;
      Next.Pending := true;
      Next.Status := 'Ending conversation...';
      return Next
    end
    else
    begin
      return State
    end
  end
end;
