// Queues player intentions and map requests to the network task while no conflicting request is pending.
unit Dungeon.Client.Ui.Intentions;

uses Dungeon.Client.Ui.Layout as Layout, Dungeon.Client.Model as Model, Dungeon.Protocol as Protocol, Std.Tasks as Tasks;

// Sends the desired world viewport while a game is active and no request is pending.
public function QueueViewport(State: Model.ClientModel): Model.ClientModel;
begin
  if (State.ConnectionPhase <> Model.ClientConnectionPhase.Active) or State.Pending then
    begin
      return State;
    end;
  end if;
  const Desired: Layout.WorldViewport := Layout.DesiredWorldViewport(State);
  if (Desired.Width = State.RequestedWorldWidth) and (Desired.Height = State.RequestedWorldHeight) then
    begin
      return State;
    end;
  end if;

  case Tasks.TrySend(
    State.Requests,
    Protocol.ClientMessage.Viewport(Desired.Width, Desired.Height)
  ) of
    when Ok(const Queued):
      if not Queued then
        begin
          return State;
        end;
      end if;
      var Next: Model.ClientModel := State;
      Next.RequestedWorldWidth := Desired.Width;
      Next.RequestedWorldHeight := Desired.Height;
      Next.Pending := true;
      Next.PendingChangesProgress := false;
      Next.Status := 'Updating view...';
      return Next;
    when Error(_):
      return State;
  end case;
end function;

// Requests the desired exploration-map window unless a map request is already pending.
public function QueueExplorationMap(State: Model.ClientModel): Model.ClientModel;
begin
  if (State.ConnectionPhase <> Model.ClientConnectionPhase.Active) or State.MapRequestPending then
    begin
      return State;
    end;
  end if;

  case Tasks.TrySend(
    State.Requests,
    Protocol.ClientMessage.ExplorationMap(
      State.MapDesiredOriginX,
      State.MapDesiredOriginY,
      State.MapDesiredWidth,
      State.MapDesiredHeight
    )
  ) of
    when Ok(const Queued):
      if not Queued then
        begin
          return State;
        end;
      end if;
      var Next: Model.ClientModel := State;
      Next.MapRequestPending := true;
      Next.Status := 'Loading map...';
      if State.MapHasState then
        begin
          Next.Status := 'Updating map...';
        end;
      end if;

      return Next;
    when Error(_):
      return State;
  end case;
end function;

// Centers the exploration-map window on the player and requests it.
public function CenterMap(State: Model.ClientModel): Model.ClientModel;
begin
  var Next: Model.ClientModel := State;
  const Size: Layout.WorldViewport := Layout.DesiredMapViewport(State);
  Next.MapDesiredWidth := Size.Width;
  Next.MapDesiredHeight := Size.Height;
  var PlayerX: integer := State.WorldX;
  var PlayerY: integer := State.WorldY;
  if State.View = Protocol.ViewKind.FirstPerson then
    begin
      PlayerX := State.PlayerX;
      PlayerY := State.PlayerY;
    end;
  end if;

  Next.MapDesiredOriginX := PlayerX - (Size.Width div 2);
  Next.MapDesiredOriginY := PlayerY - (Size.Height div 2);
  return QueueExplorationMap(Next);
end function;

// Opens the exploration map centered on the player during an active game.
public function OpenExplorationMap(State: Model.ClientModel): Model.ClientModel;
begin
  if (State.ConnectionPhase <> Model.ClientConnectionPhase.Active) or not State.HasVisibleState then
    begin
      return State;
    end;
  end if;
  var Next: Model.ClientModel := State;
  Next.Overlay := Model.ClientOverlay.ExplorationMapOverlay;
  Next.FocusedControl := 0;
  Next.MapHasState := false;
  return CenterMap(Next);
end function;

// Moves the desired map window by one step; pending requests coalesce into the latest window.
public function PanExplorationMap(State: Model.ClientModel; DeltaX: integer; DeltaY: integer): Model.ClientModel;
begin
  var Next: Model.ClientModel := State;
  Next.MapDesiredOriginX := State.MapDesiredOriginX + DeltaX;
  Next.MapDesiredOriginY := State.MapDesiredOriginY + DeltaY;
  if State.MapRequestPending then
    begin
      Next.Status := 'Map update queued.';
      return Next;
    end;
  end if;

  return QueueExplorationMap(Next);
end function;

// Sends one outdoor movement intention while a game is active and no request is pending.
public function QueueMove(State: Model.ClientModel; DeltaX: integer; DeltaY: integer): Model.ClientModel;
begin
  if (State.ConnectionPhase <> Model.ClientConnectionPhase.Active) or State.Pending then
    begin
      return State;
    end;
  end if;

  case Tasks.TrySend(State.Requests, Protocol.ClientMessage.Move(DeltaX, DeltaY)) of
    when Ok(const Queued):
      if not Queued then
        begin
          return State;
        end;
      end if;
      var Next: Model.ClientModel := State;
      Next.Pending := true;
      Next.PendingChangesProgress := true;
      Next.Status := 'Moving...';
      return Next;
    when Error(_):
      return State;
  end case;
end function;

// Sends one first-person step while a game is active and no request is pending.
public function QueueFirstPersonStep(State: Model.ClientModel; Direction: Protocol.FirstPersonStepDirection): Model.ClientModel;
begin
  if (State.ConnectionPhase <> Model.ClientConnectionPhase.Active) or State.Pending then
    begin
      return State;
    end;
  end if;

  case Tasks.TrySend(State.Requests, Protocol.ClientMessage.StepFirstPerson(Direction)) of
    when Ok(const Queued):
      if not Queued then
        begin
          return State;
        end;
      end if;
      var Next: Model.ClientModel := State;
      Next.Pending := true;
      Next.PendingChangesProgress := true;
      Next.Status := 'Moving one field...';
      return Next;
    when Error(_):
      return State;
  end case;
end function;

// Queues one turn-consuming intention such as attack, wait or an inventory action.
public function QueueCombatAction(State: Model.ClientModel; Message: Protocol.ClientMessage; Status: string): Model.ClientModel;
begin
  if (State.ConnectionPhase <> Model.ClientConnectionPhase.Active) or State.Pending
    or
    not State.HasVisibleState
  then
    begin
      return State;
    end;
  end if;

  case Tasks.TrySend(State.Requests, Message) of
    when Ok(const Queued):
      if not Queued then
        begin
          return State;
        end;
      end if;
      var Next: Model.ClientModel := State;
      Next.Pending := true;
      Next.PendingChangesProgress := true;
      Next.Status := Status;
      return Next;
    when Error(_):
      return State;
  end case;
end function;

// Sends one first-person turn while a game is active and no request is pending.
public function QueueFirstPersonTurn(State: Model.ClientModel; Direction: Protocol.FirstPersonTurnDirection): Model.ClientModel;
begin
  if (State.ConnectionPhase <> Model.ClientConnectionPhase.Active) or State.Pending then
    begin
      return State;
    end;
  end if;

  case Tasks.TrySend(State.Requests, Protocol.ClientMessage.TurnFirstPerson(Direction)) of
    when Ok(const Queued):
      if not Queued then
        begin
          return State;
        end;
      end if;
      var Next: Model.ClientModel := State;
      Next.Pending := true;
      Next.PendingChangesProgress := true;
      Next.Status := 'Turning...';
      return Next;
    when Error(_):
      return State;
  end case;
end function;

// Sends the Enter interaction while a game is active and no request is pending.
public function QueueInteraction(State: Model.ClientModel): Model.ClientModel;
begin
  if (State.ConnectionPhase <> Model.ClientConnectionPhase.Active) or State.Pending then
    begin
      return State;
    end;
  end if;

  case Tasks.TrySend(State.Requests, Protocol.ClientMessage.Interact) of
    when Ok(const Queued):
      if not Queued then
        begin
          return State;
        end;
      end if;
      var Next: Model.ClientModel := State;
      Next.Pending := true;
      Next.PendingChangesProgress := true;
      Next.Status := 'Interacting...';
      return Next;
    when Error(_):
      return State;
  end case;
end function;
end unit;
