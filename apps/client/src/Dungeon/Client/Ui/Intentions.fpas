// Queues player intentions and map requests to the network task while no conflicting request is pending.
unit Dungeon.Client.Ui.Intentions;

uses Dungeon.Client.Ui.Layout, Dungeon.Client.Model, Dungeon.Protocol, Std.Arrays, Std.Task;

// Sends the desired world viewport while a game is active and no request is pending.
public function QueueViewport(State: ClientModel): ClientModel;
begin
  if (State.ConnectionPhase <> ClientConnectionPhase.Active) or State.Pending then
  begin
    return State
  end;
  var Desired: WorldViewport := DesiredWorldViewport(State);
  if (Desired.Width = State.RequestedWorldWidth) and (Desired.Height = State.RequestedWorldHeight) then
  begin
    return State
  end;

  case TrySend(State.Requests, ClientMessage.Viewport(Desired.Width, Desired.Height)) of
    Ok(Queued):
    begin
      if not Queued then
      begin
        return State
      end;
      mutable var Next: ClientModel := State;
      Next.RequestedWorldWidth := Desired.Width;
      Next.RequestedWorldHeight := Desired.Height;
      Next.Pending := true;
      Next.Status := 'Updating view...';
      return Next
    end
    else
    begin
      return State
    end
  end
end;

// Requests the desired exploration-map window unless a map request is already pending.
public function QueueExplorationMap(State: ClientModel): ClientModel;
begin
  if (State.ConnectionPhase <> ClientConnectionPhase.Active) or State.MapRequestPending then
  begin
    return State
  end;

  case TrySend(State.Requests, ClientMessage.ExplorationMap(State.MapDesiredOriginX, State.MapDesiredOriginY, State.MapDesiredWidth, State.MapDesiredHeight)) of
    Ok(Queued):
    begin
      if not Queued then
      begin
        return State
      end;
      mutable var Next: ClientModel := State;
      Next.MapRequestPending := true;
      Next.Status := 'Loading map...';
      if State.MapHasState then
      begin
        Next.Status := 'Updating map...'
      end;

      return Next
    end
    else
    begin
      return State
    end
  end
end;

// Centers the exploration-map window on the player and requests it.
public function CenterMap(State: ClientModel): ClientModel;
begin
  mutable var Next: ClientModel := State;
  var Size: WorldViewport := DesiredMapViewport(State);
  Next.MapDesiredWidth := Size.Width;
  Next.MapDesiredHeight := Size.Height;
  mutable var PlayerX: integer := State.WorldX;
  mutable var PlayerY: integer := State.WorldY;
  if State.View = ViewKind.FirstPerson then
  begin
    PlayerX := State.PlayerX;
    PlayerY := State.PlayerY
  end;

  Next.MapDesiredOriginX := PlayerX - (Size.Width div 2);
  Next.MapDesiredOriginY := PlayerY - (Size.Height div 2);
  return QueueExplorationMap(Next)
end;

// Opens the exploration map centered on the player during an active game.
public function OpenExplorationMap(State: ClientModel): ClientModel;
begin
  if (State.ConnectionPhase <> ClientConnectionPhase.Active) or not State.HasVisibleState then
  begin
    return State
  end;
  mutable var Next: ClientModel := State;
  Next.Overlay := ClientOverlay.ExplorationMapOverlay;
  Next.FocusedControl := 0;
  Next.MapHasState := false;
  return CenterMap(Next)
end;

// Moves the desired map window by one step; pending requests coalesce into the latest window.
public function PanExplorationMap(State: ClientModel; DeltaX: integer; DeltaY: integer): ClientModel;
begin
  mutable var Next: ClientModel := State;
  Next.MapDesiredOriginX := State.MapDesiredOriginX + DeltaX;
  Next.MapDesiredOriginY := State.MapDesiredOriginY + DeltaY;
  if State.MapRequestPending then
  begin
    Next.Status := 'Map update queued.';
    return Next
  end;

  return QueueExplorationMap(Next)
end;

// Sends one outdoor movement intention while a game is active and no request is pending.
public function QueueMove(State: ClientModel; DeltaX: integer; DeltaY: integer): ClientModel;
begin
  if (State.ConnectionPhase <> ClientConnectionPhase.Active) or State.Pending then
  begin
    return State
  end;

  case TrySend(State.Requests, ClientMessage.Move(DeltaX, DeltaY)) of
    Ok(Queued):
    begin
      if not Queued then
      begin
        return State
      end;
      mutable var Next: ClientModel := State;
      Next.Pending := true;
      Next.Status := 'Moving...';
      return Next
    end
    else
    begin
      return State
    end
  end
end;

