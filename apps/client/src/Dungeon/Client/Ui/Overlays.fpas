// The start screen and every modal overlay: menus, confirmations, map, description, and defeat.
unit Dungeon.Client.Ui.Overlays;

uses
  Dungeon.Client.Ui.Controls, Dungeon.Client.Ui.GameView, Dungeon.Client.Ui.Layout,
  Dungeon.Client.Ui.MapCells, Dungeon.Client.Character, Dungeon.Client.Model, Dungeon.Protocol,
  Std.Arrays, Std.Tui;

// Renders the information overlay about the game and its controls.
public function ViewInformation(): TuiElement;
begin
  return TuiElementBuilders.MakeOverlay('Information', [
                                                         TuiElementBuilders.MakeColumn([
                                                                                         TuiElementBuilders.MakeLabel('Into the Dungeon'),
                                                                                         TuiElementBuilders.MakeLabel('A Functional Pascal client-server RPG.'),
                                                                                         TuiElementBuilders.MakeLabel(''),
                                                                                         TuiElementBuilders.MakeButton(TuiControlId.Create(OverlayBackControlId), 'Back', TuiAction.Create(BackAction))
                                                                                       ])
                                                       ])
end;

// Renders the start screen with connection and session choices for the current phase.
public function ViewStartScreen(State: ClientModel): TuiElement;
begin
  mutable var Items: array of TuiElement := [];
  if State.ConnectionPhase = ClientConnectionPhase.Connecting then
  begin
    Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel(State.Status))
  end
  else if State.ConnectionPhase = ClientConnectionPhase.AwaitingSession then
  begin
    Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel(State.Status));
    if State.Pending then
    begin
      Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel('Please wait.'));
      Std.Arrays.Push(Items, TuiElementBuilders.MakeButton(TuiControlId.Create(CancelSessionStartControlId), 'Cancel', TuiAction.Create(RequestCancelSessionAction)))
    end
    else
    begin
      Std.Arrays.Push(Items, TuiElementBuilders.MakeDefaultButton(TuiControlId.Create(NewGameControlId), 'New game', '', TuiAction.Create(NewGameAction)));
      if State.SaveAvailable then
      begin
        Std.Arrays.Push(Items, TuiElementBuilders.MakeButton(TuiControlId.Create(LoadGameControlId), 'Load', TuiAction.Create(LoadGameAction)))
      end;

      Std.Arrays.Push(Items, TuiElementBuilders.MakeButton(TuiControlId.Create(StartDisconnectControlId), 'Disconnect', TuiAction.Create(DisconnectAction)))
    end
  end
  else
  begin
    Std.Arrays.Push(Items, TuiElementBuilders.MakeDefaultButton(TuiControlId.Create(ConnectControlId), 'Connect', '', TuiAction.Create(ConnectAction)))
  end;

  if not State.Pending then
  begin
    Std.Arrays.Push(Items, TuiElementBuilders.MakeButton(TuiControlId.Create(StartInformationControlId), 'Information', TuiAction.Create(InformationAction)));
    Std.Arrays.Push(Items, TuiElementBuilders.MakeButton(TuiControlId.Create(StartQuitControlId), 'Quit', TuiAction.Create(QuitAction)))
  end;

  return TuiElementBuilders.MakeOverlay('INTO THE DUNGEON', [TuiElementBuilders.MakeColumn(Items)])
end;

function ViewSystemMenu(State: ClientModel): TuiElement;
begin
  mutable var Items: array of TuiElement := [
                                              TuiElementBuilders.MakeButton(TuiControlId.Create(ResumeControlId), 'Resume', TuiAction.Create(ResumeAction)),
                                              TuiElementBuilders.MakeButton(TuiControlId.Create(SystemInformationControlId), 'Information', TuiAction.Create(InformationAction)),
                                              TuiElementBuilders.MakeButton(TuiControlId.Create(SaveControlId), 'Save', TuiAction.Create(SaveAction)),
                                              TuiElementBuilders.MakeRule('Key bindings')
                                            ];
  if not State.HasVisibleState or (State.View = ViewKind.Map) then
  begin
    Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel('WASD   Move'))
  end
  else
  begin
    Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel('W/S    Forward/back one field'));
    Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel('A/D    Left/right one field'));
    Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel('Q/E    Turn left/right 90 degrees'));
    Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel('Space  Attack ahead'));
    Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel('Z      Wait one turn'))
  end;

  Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel('Enter  Interact'));
  Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel('I      Inventory'));
  Std.Arrays.Push(Items, TuiElementBuilders.MakeLabel('C      Character'));
  Items := Std.Arrays.Concat(Items, [
                                      TuiElementBuilders.MakeLabel('M      Map'),
                                      TuiElementBuilders.MakeLabel('F2     Context'),
                                      TuiElementBuilders.MakeLabel('F3     Messages'),
                                      TuiElementBuilders.MakeLabel('Ctrl+P Menu'),
                                      TuiElementBuilders.MakeLabel('Alt+X  Quit')
                                    ]);
  if (State.ConnectionPhase = ClientConnectionPhase.Active) or
     (State.ConnectionPhase = ClientConnectionPhase.Connecting) then
  begin
    Std.Arrays.Push(Items, TuiElementBuilders.MakeButton(TuiControlId.Create(DisconnectControlId), 'Disconnect', TuiAction.Create(DisconnectAction)))
  end
  else
  begin
    Std.Arrays.Push(Items, TuiElementBuilders.MakeButton(TuiControlId.Create(DisconnectControlId), 'Return to start', TuiAction.Create(DisconnectAction)))
  end;

  Std.Arrays.Push(Items, TuiElementBuilders.MakeButton(TuiControlId.Create(SystemQuitControlId), 'Quit', TuiAction.Create(QuitAction)));
  return TuiElementBuilders.MakeOverlay('System menu', [TuiElementBuilders.MakeColumn(Items)])
end;

function ViewSaveConfirmation(): TuiElement;
begin
  return TuiElementBuilders.MakeOverlay('Overwrite save?', [
                                                             TuiElementBuilders.MakeColumn([
                                                                                             TuiElementBuilders.MakeLabel('The existing save for this world will be replaced.'),
                                                                                             TuiElementBuilders.MakeDefaultButton(TuiControlId.Create(ConfirmSaveControlId), 'Overwrite', '', TuiAction.Create(ConfirmSaveAction)),
                                                                                             TuiElementBuilders.MakeButton(TuiControlId.Create(CancelSaveControlId), 'Cancel', TuiAction.Create(CancelSaveAction))
                                                                                           ])
                                                           ])
end;

function ViewSessionCancelConfirmation(): TuiElement;
begin
  return TuiElementBuilders.MakeOverlay('Cancel session start?', [
                                                                   TuiElementBuilders.MakeColumn([
                                                                                                   TuiElementBuilders.MakeLabel('The connection will be closed.'),
                                                                                                   TuiElementBuilders.MakeDefaultButton(TuiControlId.Create(ContinueSessionStartControlId), 'Continue waiting', '', TuiAction.Create(ContinueSessionStartAction)),
                                                                                                   TuiElementBuilders.MakeButton(TuiControlId.Create(ConfirmCancelSessionControlId), 'Cancel and disconnect', TuiAction.Create(ConfirmCancelSessionAction))
                                                                                                 ])
                                                                 ])
end;

function ViewPanelOverlay(State: ClientModel; Title: string; Content: TuiElement): TuiElement;
begin
  return TuiElementBuilders.MakeOverlay(Title, [
                                                 Content,
                                                 TuiElementBuilders.MakeButton(TuiControlId.Create(PanelCloseControlId), 'Close', TuiAction.Create(ClosePanelAction))
                                               ])
end;

function ViewExplorationMap(State: ClientModel): TuiElement;
begin
  mutable var Content: array of TuiElement := [];
  if State.MapHasState then
  begin
    Std.Arrays.Push(Content, TuiElementBuilders.MakeCellGrid(ExplorationMapGrid(State)))
  end
  else
  begin
    Std.Arrays.Push(Content, TuiElementBuilders.MakeLabel('Loading map...'))
  end;

  Std.Arrays.Push(Content, TuiElementBuilders.MakeLabel('WASD/arrows pan  Home center  M/Esc close'));
  mutable var Title: string := 'Map';
  if State.MapLabel <> '' then
  begin
    Title := 'Map - ' + State.MapLabel
  end;

  return TuiElementBuilders.MakeOverlay(Title, [TuiElementBuilders.MakeColumn(Content)])
end;

function ViewDescription(State: ClientModel): TuiElement;
begin
  var Lines: array of string := DescriptionLines(State);
  var PageHeight: integer := DescriptionPageHeight(State);
  mutable var Offset: integer := State.DescriptionOffset;
  if Offset + PageHeight > Std.Arrays.Length(Lines) then
  begin
    Offset := Std.Arrays.Length(Lines) - PageHeight
  end;

  if Offset < 0 then
  begin
    Offset := 0
  end;
  mutable var Content: array of TuiElement := [];
  for I: integer := Offset to Std.Arrays.Length(Lines) - 1 do
  begin
    if I < Offset + PageHeight then
    begin
      Std.Arrays.Push(Content, TuiElementBuilders.MakeLabel(Lines[I]))
    end
  end;

  Std.Arrays.Push(Content, TuiElementBuilders.MakeLabel(''));
  Std.Arrays.Push(Content, TuiElementBuilders.MakeLabel('Enter/Esc close'));
  if Std.Arrays.Length(Lines) > PageHeight then
  begin
    Std.Arrays.Push(Content, TuiElementBuilders.MakeLabel('Up/Down scroll'))
  end;

  return TuiElementBuilders.MakeOverlay(State.DescriptionTitle, [
                                                                  TuiElementBuilders.MakeColumn(Content)
                                                                ])
end;

function ViewDefeat(State: ClientModel): TuiElement;
begin
  return TuiElementBuilders.MakeOverlay('You have fallen', [
                                                             TuiElementBuilders.MakeColumn([
                                                                                             TuiElementBuilders.MakeLabel(State.DefeatMessage),
                                                                                             TuiElementBuilders.MakeLabel(''),
                                                                                             TuiElementBuilders.MakeLabel('Load your last save or start a new game.'),
                                                                                             TuiElementBuilders.MakeLabel(''),
                                                                                             TuiElementBuilders.MakeButton(TuiControlId.Create(OverlayBackControlId), 'Continue', TuiAction.Create(BackAction))
                                                                                           ])
                                                           ])
end;

// Renders the active overlay, or nothing when none is open.
public function ViewOverlay(State: ClientModel): TuiElement;
begin
  case State.Overlay of
    ClientOverlay.DescriptionOverlay:
    begin
      return ViewDescription(State)
    end;
    ClientOverlay.InformationOverlay:
    begin
      return ViewInformation()
    end;
    ClientOverlay.SystemMenuOverlay:
    begin
      return ViewSystemMenu(State)
    end;
    ClientOverlay.SaveConfirmationOverlay:
    begin
      return ViewSaveConfirmation()
    end;
    ClientOverlay.SessionCancelConfirmationOverlay:
    begin
      return ViewSessionCancelConfirmation()
    end;
    ClientOverlay.ContextOverlay:
    begin
      return ViewPanelOverlay(State, 'Sidebar', ViewSidebar(State))
    end;
    ClientOverlay.MessageOverlay:
    begin
      return ViewPanelOverlay(State, 'Messages', ViewMessages(State))
    end;
    ClientOverlay.ExplorationMapOverlay:
    begin
      return ViewExplorationMap(State)
    end;
    ClientOverlay.DefeatOverlay:
    begin
      return ViewDefeat(State)
    end;
    ClientOverlay.InventoryOverlay:
    begin
      return ViewInventory(State)
    end;
    ClientOverlay.CharacterSheetOverlay:
    begin
      return ViewCharacterSheet(State)
    end;
    ClientOverlay.NoOverlay:
    begin
      return TuiElementBuilders.MakeEmpty()
    end
  end
end;
