// The start screen and every modal overlay: menus, confirmations, map, description, and defeat.
unit Dungeon.Client.Ui.Overlays;

uses Dungeon.Client.Ui.Trade as Trade, Dungeon.Client.Journal as Journal, Dungeon.Client.Ui.Dialogue as Dialogue, Dungeon.Client.Ui.Controls as Controls, Dungeon.Client.Ui.GameView as GameView, Dungeon.Client.Ui.Layout as Layout, Dungeon.Client.Ui.MapCells as MapCells, Dungeon.Client.Ui.Worlds.View as WorldView, Dungeon.Client.Character as Character, Dungeon.Client.CharacterSheet as CharacterSheet, Dungeon.Client.Model as Model, Dungeon.Protocol as Protocol, Std.Ui.Terminal as Tui;

// Renders the information overlay about the game and its controls.
public function ViewInformation(): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeOverlay(
    'Information', [
      Tui.TuiElementBuilders.MakeColumn([
        Tui.TuiElementBuilders.MakeLabel('Into the Dungeon'),
        Tui.TuiElementBuilders.MakeLabel('A Functional Pascal client-server RPG.'),
        Tui.TuiElementBuilders.MakeLabel(''),
        Tui.TuiElementBuilders.MakeButton(
          Tui.TuiControlId.Create(Controls.OverlayBackControlId),
          'Back',
          Tui.TuiAction.Create(Controls.BackAction)
        )
      ])
    ]
  );
end function;

// Renders the start screen with connection and session choices for the current phase.
public function ViewStartScreen(State: Model.ClientModel): Tui.TuiElement;
begin
  var Items: array of Tui.TuiElement := [];
  if State.ConnectionPhase = Model.ClientConnectionPhase.Connecting then
    begin
      Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel(State.Status));
    end;
  else
    if State.ConnectionPhase = Model.ClientConnectionPhase.AwaitingSession then
      begin
        Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel(State.Status));
        if State.Pending then
          begin
            Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Please wait.'));
            Items.PushInPlace(
              Tui.TuiElementBuilders.MakeButton(
                Tui.TuiControlId.Create(Controls.CancelSessionStartControlId),
                'Cancel',
                Tui.TuiAction.Create(Controls.RequestCancelSessionAction)
              )
            );
          end;
        else
          begin
            Items := Items.Concat(WorldView.ViewWorldChoices(State));
            Items.PushInPlace(
              Tui.TuiElementBuilders.MakeButton(
                Tui.TuiControlId.Create(Controls.StartDisconnectControlId),
                'Disconnect',
                Tui.TuiAction.Create(Controls.DisconnectAction)
              )
            );
          end;
        end if;
      end;
    else
      begin
        Items.PushInPlace(
          Tui.TuiElementBuilders.MakeDefaultButton(
            Tui.TuiControlId.Create(Controls.ConnectControlId),
            'Connect',
            '',
            Tui.TuiAction.Create(Controls.ConnectAction)
          )
        );
      end;
    end if;
  end if;

  if not State.Pending then
    begin
      Items.PushInPlace(
        Tui.TuiElementBuilders.MakeButton(
          Tui.TuiControlId.Create(Controls.StartInformationControlId),
          'Information',
          Tui.TuiAction.Create(Controls.InformationAction)
        )
      );
      Items.PushInPlace(
        Tui.TuiElementBuilders.MakeButton(
          Tui.TuiControlId.Create(Controls.StartQuitControlId),
          'Quit',
          Tui.TuiAction.Create(Controls.QuitAction)
        )
      );
    end;
  end if;

  return Tui.TuiElementBuilders.MakeOverlay(
    'INTO THE DUNGEON',
    [Tui.TuiElementBuilders.MakeColumn(Items)]
  );
end function;

function ViewSystemMenu(State: Model.ClientModel): Tui.TuiElement;
begin
  var Items: array of Tui.TuiElement := [
    Tui.TuiElementBuilders.MakeButton(
      Tui.TuiControlId.Create(Controls.ResumeControlId),
      'Resume',
      Tui.TuiAction.Create(Controls.ResumeAction)
    ),
    Tui.TuiElementBuilders.MakeButton(
      Tui.TuiControlId.Create(Controls.SystemInformationControlId),
      'Information',
      Tui.TuiAction.Create(Controls.InformationAction)
    ),
    Tui.TuiElementBuilders.MakeButton(
      Tui.TuiControlId.Create(Controls.SaveControlId),
      'Save',
      Tui.TuiAction.Create(Controls.SaveAction)
    ),
    Tui.TuiElementBuilders.MakeRule('Key bindings')
  ];
  if not State.HasVisibleState or (State.View = Protocol.ViewKind.Map) then
    begin
      Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('WASD   Move'));
    end;
  else
    begin
      Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('W/S    Forward/back one field'));
      Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('A/D    Left/right one field'));
      Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Q/E    Turn left/right 90 degrees'));
      Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Space  Attack ahead'));
      Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Z      Wait one turn'));
    end;
  end if;

  Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Enter  Interact'));
  Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('I      Inventory'));
  Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('C      Character'));
  Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('J      Journal'));
  Items := Items.Concat([
    Tui.TuiElementBuilders.MakeLabel('M      Map'),
    Tui.TuiElementBuilders.MakeLabel('F2     Context'),
    Tui.TuiElementBuilders.MakeLabel('F3     Messages'),
    Tui.TuiElementBuilders.MakeLabel('Ctrl+P Menu'),
    Tui.TuiElementBuilders.MakeLabel('Alt+X  Quit')
  ]);
  if (State.ConnectionPhase = Model.ClientConnectionPhase.Active)
    or
    (State.ConnectionPhase = Model.ClientConnectionPhase.Connecting)
  then
    begin
      Items.PushInPlace(
        Tui.TuiElementBuilders.MakeButton(
          Tui.TuiControlId.Create(Controls.DisconnectControlId),
          'Disconnect',
          Tui.TuiAction.Create(Controls.DisconnectAction)
        )
      );
    end;
  else
    begin
      Items.PushInPlace(
        Tui.TuiElementBuilders.MakeButton(
          Tui.TuiControlId.Create(Controls.DisconnectControlId),
          'Return to start',
          Tui.TuiAction.Create(Controls.DisconnectAction)
        )
      );
    end;
  end if;

  Items.PushInPlace(
    Tui.TuiElementBuilders.MakeButton(
      Tui.TuiControlId.Create(Controls.WorldSelectionControlId),
      'Choose world',
      Tui.TuiAction.Create(Controls.WorldSelectionAction)
    )
  );
  Items.PushInPlace(
    Tui.TuiElementBuilders.MakeButton(
      Tui.TuiControlId.Create(Controls.SystemQuitControlId),
      'Quit',
      Tui.TuiAction.Create(Controls.QuitAction)
    )
  );
  return Tui.TuiElementBuilders.MakeOverlay(
    'System menu',
    [Tui.TuiElementBuilders.MakeColumn(Items)]
  );
end function;

function ViewSaveConfirmation(): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeOverlay(
    'Overwrite save?', [
      Tui.TuiElementBuilders.MakeColumn([
        Tui.TuiElementBuilders.MakeLabel('The existing save for this world will be replaced.'),
        Tui.TuiElementBuilders.MakeDefaultButton(
          Tui.TuiControlId.Create(Controls.ConfirmSaveControlId),
          'Overwrite',
          '',
          Tui.TuiAction.Create(Controls.ConfirmSaveAction)
        ),
        Tui.TuiElementBuilders.MakeButton(
          Tui.TuiControlId.Create(Controls.CancelSaveControlId),
          'Cancel',
          Tui.TuiAction.Create(Controls.CancelSaveAction)
        )
      ])
    ]
  );
end function;

function ViewSessionCancelConfirmation(): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeOverlay(
    'Cancel session start?', [
      Tui.TuiElementBuilders.MakeColumn([
        Tui.TuiElementBuilders.MakeLabel('The connection will be closed.'),
        Tui.TuiElementBuilders.MakeDefaultButton(
          Tui.TuiControlId.Create(Controls.ContinueSessionStartControlId),
          'Continue waiting',
          '',
          Tui.TuiAction.Create(Controls.ContinueSessionStartAction)
        ),
        Tui.TuiElementBuilders.MakeButton(
          Tui.TuiControlId.Create(Controls.ConfirmCancelSessionControlId),
          'Cancel and disconnect',
          Tui.TuiAction.Create(Controls.ConfirmCancelSessionAction)
        )
      ])
    ]
  );
end function;

function ViewPanelOverlay(State: Model.ClientModel; Title: string; Content: Tui.TuiElement): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeOverlay(
    Title, [
      Content,
      Tui.TuiElementBuilders.MakeButton(
        Tui.TuiControlId.Create(Controls.PanelCloseControlId),
        'Close',
        Tui.TuiAction.Create(Controls.ClosePanelAction)
      )
    ]
  );
end function;

function ViewExplorationMap(State: Model.ClientModel): Tui.TuiElement;
begin
  var Content: array of Tui.TuiElement := [];
  if State.MapHasState then
    begin
      Content.PushInPlace(Tui.TuiElementBuilders.MakeCellGrid(MapCells.ExplorationMapGrid(State)));
    end;
  else
    begin
      Content.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Loading map...'));
    end;
  end if;

  Content.PushInPlace(
    Tui.TuiElementBuilders.MakeLabel('WASD/arrows pan  Home center  M/Esc close')
  );
  var Title: string := 'Map';
  if State.MapLabel <> '' then
    begin
      Title := 'Map - ' + State.MapLabel;
    end;
  end if;

  return Tui.TuiElementBuilders.MakeOverlay(Title, [Tui.TuiElementBuilders.MakeColumn(Content)]);
end function;

function ViewDescription(State: Model.ClientModel): Tui.TuiElement;
begin
  const Lines: array of string := Layout.DescriptionLines(State);
  const PageHeight: integer := Layout.DescriptionPageHeight(State);
  var Offset: integer := State.DescriptionOffset;
  if Offset + PageHeight > Lines.Length() then
    begin
      Offset := Lines.Length() - PageHeight;
    end;
  end if;

  if Offset < 0 then
    begin
      Offset := 0;
    end;
  end if;
  var Content: array of Tui.TuiElement := [];
  for I: integer := Offset to Lines.Length() - 1 do
    begin
      if I < Offset + PageHeight then
        begin
          Content.PushInPlace(Tui.TuiElementBuilders.MakeLabel(Lines[I]));
        end;
      end if;
    end;
  end for;

  Content.PushInPlace(Tui.TuiElementBuilders.MakeLabel(''));
  Content.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Enter/Esc close'));
  if Lines.Length() > PageHeight then
    begin
      Content.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Up/Down scroll'));
    end;
  end if;

  return Tui.TuiElementBuilders.MakeOverlay(
    State.DescriptionTitle, [
      Tui.TuiElementBuilders.MakeColumn(Content)
    ]
  );
end function;

function ViewDefeat(State: Model.ClientModel): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeOverlay(
    'You have fallen', [
      Tui.TuiElementBuilders.MakeColumn([
        Tui.TuiElementBuilders.MakeLabel(State.DefeatMessage),
        Tui.TuiElementBuilders.MakeLabel(''),
        Tui.TuiElementBuilders.MakeLabel('Load your last save or start a new game.'),
        Tui.TuiElementBuilders.MakeLabel(''),
        Tui.TuiElementBuilders.MakeButton(
          Tui.TuiControlId.Create(Controls.OverlayBackControlId),
          'Continue',
          Tui.TuiAction.Create(Controls.BackAction)
        )
      ])
    ]
  );
end function;

// Renders the active overlay, or nothing when none is open.
public function ViewOverlay(State: Model.ClientModel): Tui.TuiElement;
begin
  if State.ActiveTrade is Some(_) then
    return Trade.View(State);
  end if;

  if State.ActiveDialogue is Some(_) then
    return Dialogue.View(State);
  end if;

  case State.Overlay of
    when Model.ClientOverlay.NewWorldOverlay:
      begin
        return WorldView.ViewNewWorld(State);
      end;
    when Model.ClientOverlay.DiscardConfirmationOverlay:
      begin
        return WorldView.ViewDiscardConfirmation();
      end;
    when Model.ClientOverlay.DescriptionOverlay:
      begin
        return ViewDescription(State);
      end;
    when Model.ClientOverlay.InformationOverlay:
      begin
        return ViewInformation();
      end;
    when Model.ClientOverlay.SystemMenuOverlay:
      begin
        return ViewSystemMenu(State);
      end;
    when Model.ClientOverlay.SaveConfirmationOverlay:
      begin
        return ViewSaveConfirmation();
      end;
    when Model.ClientOverlay.SessionCancelConfirmationOverlay:
      begin
        return ViewSessionCancelConfirmation();
      end;
    when Model.ClientOverlay.ContextOverlay:
      begin
        return ViewPanelOverlay(State, 'Sidebar', GameView.ViewSidebar(State));
      end;
    when Model.ClientOverlay.MessageOverlay:
      begin
        return ViewPanelOverlay(State, 'Messages', GameView.ViewMessages(State));
      end;
    when Model.ClientOverlay.ExplorationMapOverlay:
      begin
        return ViewExplorationMap(State);
      end;
    when Model.ClientOverlay.DefeatOverlay:
      begin
        return ViewDefeat(State);
      end;
    when Model.ClientOverlay.InventoryOverlay:
      begin
        return Character.ViewInventory(State);
      end;
    when Model.ClientOverlay.JournalOverlay:
      return Journal.View(State);
    when Model.ClientOverlay.CharacterSheetOverlay:
      begin
        return CharacterSheet.ViewCharacterSheet(State);
      end;
    when Model.ClientOverlay.NoOverlay:
      begin
        return Tui.TuiElementBuilders.MakeEmpty();
      end;
  end case;
end function;
end unit;
