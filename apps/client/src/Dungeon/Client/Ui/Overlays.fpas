// The start screen and every modal overlay: menus, confirmations, map, description, and defeat.
unit Dungeon.Client.Ui.Overlays;

uses Dungeon.Client.Ui.Trade as Trade, Dungeon.Client.Journal as Journal, Dungeon.Client.Ui.Dialogue as Dialogue, Dungeon.Client.Ui.Dialog as Dialog, Dungeon.Client.Ui.Controls as Controls, Dungeon.Client.Ui.GameView as GameView, Dungeon.Client.Ui.Layout as Layout, Dungeon.Client.Ui.MapCells as MapCells, Dungeon.Client.Ui.Worlds.View as WorldView, Dungeon.Client.Character as Character, Dungeon.Client.CharacterSheet as CharacterSheet, Dungeon.Client.Model as Model, Dungeon.Ui.Overlay as Overlay, Dungeon.Protocol as Protocol, Std.Ui.Terminal as Tui;

function Wrapped(State: Model.ClientModel; Text: string; Role: Tui.TuiStyleRole): array of Tui.TuiElement;
begin
  var Items: array of Tui.TuiElement := [];
  for Line: string in Layout.WrappedLines(Text, Dialog.Width(State)) do
    Items.PushInPlace(Tui.TuiElement.Label(Tui.TuiLabel(Text := Line, Role := Role)));
  end for;

  return Items;
end function;

// Renders the information overlay about the game and its controls.
public function ViewInformation(State: Model.ClientModel): Tui.TuiElement;
begin
  return Dialog.View(
    State,
    'Information', [
      Tui.TuiElementBuilders.MakeHeading('Into the Dungeon'),
      Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Fixed(1))
    ].Concat(Wrapped(State, 'A Functional Pascal client-server RPG.', Tui.TuiStyleRole.Normal)), [
      Dialog.Actions(
        [], [
          Tui.TuiElementBuilders.MakeButtonOfKind(
            Tui.TuiControlId.Create(Controls.OverlayBackControlId),
            'Back',
            Tui.TuiAction.Create(Controls.BackAction), Tui.TuiButtonKind.Cancel
          )
        ]
      )
    ]
  );
end function;

// Renders the start screen with connection and session choices for the current phase.
public function ViewStartScreen(State: Model.ClientModel): Tui.TuiElement;
begin
  if State.ConnectionPhase = Model.ClientConnectionPhase.AwaitingSession then
    if not State.Pending then
      return WorldView.ViewCatalog(State);
    end if;

    return Dialog.View(
      State, 'INTO THE DUNGEON', [
        Tui.TuiElementBuilders.MakeLabel(Layout.FitLine(State.Status, Dialog.Width(State))),
        Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Fixed(1)),
        Tui.TuiElementBuilders.MakeLabel('Please wait.')
      ], [
        Dialog.Actions(
          [], [
            Tui.TuiElementBuilders.MakeButtonOfKind(
              Tui.TuiControlId.Create(Controls.CancelSessionStartControlId), 'Cancel',
              Tui.TuiAction.Create(Controls.RequestCancelSessionAction), Tui.TuiButtonKind.Cancel
            )
          ]
        )
      ]
    );
  end if;

  if State.ConnectionPhase = Model.ClientConnectionPhase.Failed then
    return Dialog.View(
      State, 'Connection failed', Wrapped(State, State.Status, Tui.TuiStyleRole.Failure), [
        Dialog.Actions(
          [
            Tui.TuiElementBuilders.MakeButton(
              Tui.TuiControlId.Create(Controls.StartInformationControlId),
              if Dialog.Width(State) < 44 then 'Info' else 'Information' end if,
              Tui.TuiAction.Create(Controls.InformationAction)
            )
          ], [
            Tui.TuiElement.Button(
              Tui.TuiButtonSpec.DefaultButton(
                Tui.TuiControlId.Create(Controls.ConnectControlId), 'Connect', '',
                Tui.TuiAction.Create(Controls.ConnectAction)
              ) with Kind := Tui.TuiButtonKind.Primary; end with
            ),
            Tui.TuiElementBuilders.MakeButtonOfKind(
              Tui.TuiControlId.Create(Controls.StartQuitControlId),
              'Quit', Tui.TuiAction.Create(Controls.QuitAction), Tui.TuiButtonKind.Cancel
            )
          ]
        )
      ]
    );
  end if;
  var Items: array of Tui.TuiElement := [];
  if State.ConnectionPhase = Model.ClientConnectionPhase.Connecting then
    begin
      Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel(State.Status));
    end;
  else
    begin
      Items.PushInPlace(
        Tui.TuiElement.Button(
          Tui.TuiButtonSpec.DefaultButton(
            Tui.TuiControlId.Create(Controls.ConnectControlId),
            'Connect',
            '',
            Tui.TuiAction.Create(Controls.ConnectAction)
          ) with Kind := Tui.TuiButtonKind.Primary; end with
        )
      );
    end;
  end if;

  if not State.Pending then
    begin
      Items.PushInPlace(
        Tui.TuiElementBuilders.MakeButton(
          Tui.TuiControlId.Create(Controls.StartInformationControlId),
          'Information',
          Tui.TuiAction.Create(Controls.InformationAction)
        )
      );
      Items.PushInPlace(
        Tui.TuiElementBuilders.MakeButton(
          Tui.TuiControlId.Create(Controls.StartQuitControlId),
          'Quit',
          Tui.TuiAction.Create(Controls.QuitAction)
        )
      );
    end;
  end if;

  return Overlay.Responsive(
    'INTO THE DUNGEON',
    Tui.TuiOverlaySizeRule.Create(Tui.TuiSize.Create(32, 9), 4, 25),
    [Tui.TuiElementBuilders.MakeColumn(Items)]
  );
end function;

function ViewSystemMenu(State: Model.ClientModel): Tui.TuiElement;
begin
  if State.ViewportHeight < 10 then
    return Dialog.View(
      State,
      'System menu', [Tui.TuiElementBuilders.MakeLabel('Resize to 32x10')],
      [
        Dialog.Actions(
          [], [
            Tui.TuiElementBuilders.MakeButtonOfKind(
              Tui.TuiControlId.Create(Controls.ResumeControlId),
              'Back', Tui.TuiAction.Create(Controls.ResumeAction), Tui.TuiButtonKind.Cancel
            )
          ]
        )
      ]
    );
  end if;
  var Items: array of Tui.TuiElement := [
    Tui.TuiElementBuilders.MakeHeading('Key bindings'),
    Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Fixed(1))
  ];
  if not State.HasVisibleState or (State.View = Protocol.ViewKind.Map) then
    begin
      Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('WASD   Move'));
    end;
  else
    begin
      Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('W/S    Forward/back one field'));
      Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('A/D    Left/right one field'));
      Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Q/E    Turn left/right 90 degrees'));
      Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Space  Attack ahead'));
      Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Z      Wait one turn'));
    end;
  end if;

  Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Enter  Interact'));
  Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('I      Inventory'));
  Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('C      Character'));
  Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('J      Journal'));
  Items := Items.Concat([
    Tui.TuiElementBuilders.MakeLabel('M      Map'),
    Tui.TuiElementBuilders.MakeLabel('F2     Context'),
    Tui.TuiElementBuilders.MakeLabel('F3     Messages'),
    Tui.TuiElementBuilders.MakeLabel('Ctrl+P Menu'),
    Tui.TuiElementBuilders.MakeLabel('Alt+X  Quit')
  ]);
  const Compact := Dialog.Width(State) < 50;
  return Dialog.Scrollable(
    State, 'System menu', Tui.TuiElementBuilders.MakeColumn(Items), [
      Dialog.Actions(
        [
          Tui.TuiElementBuilders.MakeButton(
            Tui.TuiControlId.Create(Controls.SystemInformationControlId),
            if Compact then 'Info' else 'Information' end if,
            Tui.TuiAction.Create(Controls.InformationAction)
          ),
          Tui.TuiElementBuilders.MakeButton(
            Tui.TuiControlId.Create(Controls.WorldSelectionControlId),
            if Compact then 'Worlds' else 'Choose world' end if,
            Tui.TuiAction.Create(Controls.WorldSelectionAction)
          ),
          Tui.TuiElementBuilders.MakeButton(
            Tui.TuiControlId.Create(Controls.DisconnectControlId),
            if State.ConnectionPhase = Model.ClientConnectionPhase.Active then 'Disconnect'
              else 'Return to start'
              end if,
            Tui.TuiAction.Create(Controls.DisconnectAction)
          )
        ], []
      ),
      Dialog.Actions(
        [
          Tui.TuiElementBuilders.MakeButtonOfKind(
            Tui.TuiControlId.Create(Controls.SystemQuitControlId),
            'Quit', Tui.TuiAction.Create(Controls.QuitAction), Tui.TuiButtonKind.Warning
          )
        ], [
          Tui.TuiElementBuilders.MakeButtonOfKind(
            Tui.TuiControlId.Create(Controls.SaveControlId),
            'Save', Tui.TuiAction.Create(Controls.SaveAction), Tui.TuiButtonKind.Primary
          ),
          Tui.TuiElementBuilders.MakeButtonOfKind(
            Tui.TuiControlId.Create(Controls.ResumeControlId),
            'Resume', Tui.TuiAction.Create(Controls.ResumeAction), Tui.TuiButtonKind.Cancel
          )
        ]
      )
    ]
  );
end function;

function ViewSaveConfirmation(State: Model.ClientModel): Tui.TuiElement;
begin
  return Dialog.View(
    State,
    'Overwrite save?',
    Wrapped(State, 'The existing save for this world will be replaced.', Tui.TuiStyleRole.Normal),
    [
      Dialog.Actions(
        [], [
          Tui.TuiElement.Button(
            Tui.TuiButtonSpec.DefaultButton(
              Tui.TuiControlId.Create(Controls.ConfirmSaveControlId),
              'Overwrite',
              '',
              Tui.TuiAction.Create(Controls.ConfirmSaveAction)
            ) with Kind := Tui.TuiButtonKind.Dangerous; end with
          ),
          Tui.TuiElementBuilders.MakeButtonOfKind(
            Tui.TuiControlId.Create(Controls.CancelSaveControlId),
            'Cancel',
            Tui.TuiAction.Create(Controls.CancelSaveAction), Tui.TuiButtonKind.Cancel
          )
        ]
      )
    ]
  );
end function;

function ViewSessionCancelConfirmation(State: Model.ClientModel): Tui.TuiElement;
begin
  return Dialog.View(
    State,
    'Cancel session start?',
    Wrapped(State, 'The connection will be closed.', Tui.TuiStyleRole.Normal), [
      Dialog.Actions(
        [], [
          Tui.TuiElement.Button(
            Tui.TuiButtonSpec.DefaultButton(
              Tui.TuiControlId.Create(Controls.ContinueSessionStartControlId),
              'Continue waiting',
              '',
              Tui.TuiAction.Create(Controls.ContinueSessionStartAction)
            ) with Kind := Tui.TuiButtonKind.Primary; end with
          ),
          Tui.TuiElementBuilders.MakeButtonOfKind(
            Tui.TuiControlId.Create(Controls.ConfirmCancelSessionControlId),
            if Dialog.Width(State) < 44 then 'Disconnect' else 'Cancel and disconnect' end if,
            Tui.TuiAction.Create(Controls.ConfirmCancelSessionAction), Tui.TuiButtonKind.Warning
          )
        ]
      )
    ]
  );
end function;

function ViewPanelOverlay(State: Model.ClientModel; Title: string; Content: Tui.TuiElement): Tui.TuiElement;
begin
  return Dialog.Scrollable(State, Title, Content, [Dialog.Actions([], [Dialog.CloseButton()])]);
end function;

function ViewExplorationMap(State: Model.ClientModel): Tui.TuiElement;
begin
  var Content: array of Tui.TuiElement := [];
  if State.MapHasState then
    begin
      Content.PushInPlace(Tui.TuiElementBuilders.MakeCellGrid(MapCells.ExplorationMapGrid(State)));
    end;
  else
    begin
      Content.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Loading map...'));
    end;
  end if;
  var Title: string := 'Map';
  if State.MapLabel <> '' then
    begin
      Title := 'Map - ' + State.MapLabel;
    end;
  end if;
  const Expected := Layout.DesiredMapViewport(State);
  const Rule := Tui.TuiOverlaySizeRule.Create(
    Tui.TuiSize.Create(Expected.Width + 4, Expected.Height + 6),
    4,
    10
  );
  return Overlay.Responsive(
    Title, Rule, [
      Tui.TuiElementBuilders.MakeLayout(
        Tui.TuiLayoutSettings.Default().WithFixedWidth(
          Expected.Width
        ).WithFixedHeight(Expected.Height),
        Tui.TuiElementBuilders.MakeColumn(Content)
      ),
      Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Fixed(1)),
      Dialog.Actions(
        [
          Dialog.Hint(
            if Expected.Width < 44 then 'WASD pan' else 'WASD/arrows pan  Home center' end if
          )
        ],
        [Dialog.Hint('M/Esc close')]
      )
    ]
  );
end function;

function ViewDescription(State: Model.ClientModel): Tui.TuiElement;
begin
  const Lines: array of string := Layout.DescriptionLines(State);
  const PageHeight: integer := Layout.DescriptionPageHeight(State);
  var Offset: integer := State.DescriptionOffset;
  if Offset + PageHeight > Lines.Length() then
    begin
      Offset := Lines.Length() - PageHeight;
    end;
  end if;

  if Offset < 0 then
    begin
      Offset := 0;
    end;
  end if;
  var Content: array of Tui.TuiElement := [];
  for I: integer := Offset to Lines.Length() - 1 do
    begin
      if I < Offset + PageHeight then
        begin
          Content.PushInPlace(Tui.TuiElementBuilders.MakeLabel(Lines[I]));
        end;
      end if;
    end;
  end for;

  return Dialog.View(
    State, State.DescriptionTitle, Content, [
      Dialog.Actions(
        [
          Dialog.Hint(if Lines.Length() > PageHeight then 'Up/Down scroll' else '' end if)
        ], [Dialog.Hint('Enter/Esc close')]
      )
    ]
  );
end function;

function ViewDefeat(State: Model.ClientModel): Tui.TuiElement;
begin
  return Dialog.View(
    State,
    'You have fallen', [
      Tui.TuiElement.Label(
        Tui.TuiLabel(
          Text := Layout.FitLine(State.DefeatMessage, Dialog.Width(State)),
          Role := Tui.TuiStyleRole.Failure
        )
      ),
      Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Fixed(1)),
      Tui.TuiElementBuilders.MakeLabel('Load your last save or start a new game.')
    ], [
      Dialog.Actions(
        [], [
          Tui.TuiElementBuilders.MakeButtonOfKind(
            Tui.TuiControlId.Create(Controls.OverlayBackControlId),
            'Continue',
            Tui.TuiAction.Create(Controls.BackAction), Tui.TuiButtonKind.Primary
          )
        ]
      )
    ]
  );
end function;

// Renders the active overlay, or nothing when none is open.
public function ViewOverlay(State: Model.ClientModel): Tui.TuiElement;
begin
  if State.ActiveTrade is Some(_) then
    return Trade.View(State);
  end if;

  if State.ActiveDialogue is Some(_) then
    return Dialogue.View(State);
  end if;

  case State.Overlay of
    when Model.ClientOverlay.NewWorldOverlay:
      begin
        return WorldView.ViewNewWorld(State);
      end;
    when Model.ClientOverlay.DiscardConfirmationOverlay:
      begin
        return WorldView.ViewDiscardConfirmation(State);
      end;
    when Model.ClientOverlay.DescriptionOverlay:
      begin
        return ViewDescription(State);
      end;
    when Model.ClientOverlay.InformationOverlay:
      begin
        return ViewInformation(State);
      end;
    when Model.ClientOverlay.SystemMenuOverlay:
      begin
        return ViewSystemMenu(State);
      end;
    when Model.ClientOverlay.SaveConfirmationOverlay:
      begin
        return ViewSaveConfirmation(State);
      end;
    when Model.ClientOverlay.SessionCancelConfirmationOverlay:
      begin
        return ViewSessionCancelConfirmation(State);
      end;
    when Model.ClientOverlay.ContextOverlay:
      begin
        return ViewPanelOverlay(State, 'Sidebar', GameView.ViewSidebar(State));
      end;
    when Model.ClientOverlay.MessageOverlay:
      begin
        return ViewPanelOverlay(State, 'Messages', GameView.ViewMessages(State));
      end;
    when Model.ClientOverlay.ExplorationMapOverlay:
      begin
        return ViewExplorationMap(State);
      end;
    when Model.ClientOverlay.DefeatOverlay:
      begin
        return ViewDefeat(State);
      end;
    when Model.ClientOverlay.InventoryOverlay:
      begin
        return Character.ViewInventory(State);
      end;
    when Model.ClientOverlay.JournalOverlay:
      return Journal.View(State);
    when Model.ClientOverlay.CharacterSheetOverlay:
      begin
        return CharacterSheet.ViewCharacterSheet(State);
      end;
    when Model.ClientOverlay.NoOverlay:
      begin
        return Tui.TuiElementBuilders.MakeEmpty();
      end;
  end case;
end function;
end unit;
