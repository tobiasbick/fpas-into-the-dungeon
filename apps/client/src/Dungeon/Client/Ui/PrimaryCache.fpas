// Compares the exact client state needed by a cached still primary view.
unit Dungeon.Client.Ui.PrimaryCache;

uses Dungeon.Client.Model as Model, Dungeon.Client.Ui.Layout as Layout, Dungeon.Protocol as Protocol;

function SameRows(Left: array of string; Right: array of string): boolean;
begin
  if Left.Length() <> Right.Length() then
    return false;
  end if;

  for Index: integer := 0 to Left.Length() - 1 do
    if Left[Index] <> Right[Index] then
      return false;
    end if;
  end for;

  return true;
end function;

// Equal values produce the same still primary panel, including title, map and status.
public function SamePrimary(Left: Model.ClientModel; Right: Model.ClientModel): boolean;
begin
  if (Left.HasVisibleState <> Right.HasVisibleState) or (Left.View <> Right.View)
    or
    (Left.PrimaryTitle <> Right.PrimaryTitle)
    or
    (Left.WorldDay <> Right.WorldDay) or (Left.MinuteOfDay <> Right.MinuteOfDay)
    or
    (Left.Weather <> Right.Weather)
    or
    (
      (Left.ContextPanelVisible and Layout.ContextCanDock(Left)) <>
      (Right.ContextPanelVisible and Layout.ContextCanDock(Right))
    )
  then
    return false;
  end if;

  if not Left.HasVisibleState then
    return true;
  end if;

  if (Left.Width <> Right.Width) or (Left.Height <> Right.Height)
    or
    (Left.PlayerX <> Right.PlayerX) or (Left.PlayerY <> Right.PlayerY)
    or
    not SameRows(Left.Rows, Right.Rows) or not SameRows(Left.KnowledgeRows, Right.KnowledgeRows)
  then
    return false;
  end if;

  if Left.View = Protocol.ViewKind.FirstPerson then
    return (Layout.DesiredWorldViewport(Left) = Layout.DesiredWorldViewport(Right))
      and
      (Left.FirstPersonFacing = Right.FirstPersonFacing)
      and
      (Left.PrimaryStatus = Right.PrimaryStatus) and (Left.Overlay = Right.Overlay)
      and
      (Left.DamageTaken = Right.DamageTaken);
  end if;

  return Left.DayPhase = Right.DayPhase;
end function;
end unit;
