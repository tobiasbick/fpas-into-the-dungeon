// Presents server-owned dialogue frames and queues choices without deriving game rules.
unit Dungeon.Client.Ui.Dialogue;

uses
  Dungeon.Client.Model as Model, Dungeon.Client.Ui.Layout as Layout, Dungeon.Client.Ui.Dialog as Dialog, Dungeon.Client.Ui.Controls as Controls,
  Dungeon.Protocol as Protocol, Std.Math as Math, Std.Tasks as Tasks, Std.Ui.Terminal as Tui;

function Width(State: Model.ClientModel): integer;
begin
  return Math.Max(1, Dialog.Width(State) - 4);
end function;

function PageHeight(State: Model.ClientModel): integer;
begin
  return Math.Max(1, Dialog.BodyRows(State, 1) - 2);
end function;

function Lines(State: Model.ClientModel; Frame: Protocol.DialogueFrame): array of string;
begin
  var Values := Layout.WrappedLines(Frame.Text, Width(State));
  Values.PushInPlace('');
  for Index: integer := 0 to Frame.Choices.Length() - 1 do
    for Line: string in Layout.WrappedLines(Frame.Choices[Index].Text, Width(State)) do
      Values.PushInPlace(Line);
    end for;
  end for;

  return Values;
end function;

function SelectedLine(State: Model.ClientModel; Frame: Protocol.DialogueFrame): integer;
begin
  var Line := Layout.WrappedLines(Frame.Text, Width(State)).Length() + 1;
  for Index: integer := 0 to State.DialogueSelection - 1 do
    Line := Line + Layout.WrappedLines(Frame.Choices[Index].Text, Width(State)).Length();
  end for;

  return Line;
end function;

// Pointer rows map back to exact server choice identities, including wrapped continuation lines.
public function SelectRow(State: Model.ClientModel; Row: integer): Model.ClientModel;
begin
  if State.Pending or (State.ActiveDialogue is None) then
    return State;
  end if;
  const Frame := State.ActiveDialogue.Unwrap();
  var First := Layout.WrappedLines(Frame.Text, Width(State)).Length() + 1;
  for Index: integer := 0 to Frame.Choices.Length() - 1 do
    const Count := Layout.WrappedLines(Frame.Choices[Index].Text, Width(State)).Length();
    if (Row >= First) and (Row < First + Count) then
      return State with DialogueSelection := Index; DialoguePointerRow := Row; end with;
    end if;

    First := First + Count;
  end for;

  return State;
end function;

function Queue(State: Model.ClientModel; Message: Protocol.ClientMessage): Model.ClientModel;
begin
  if State.Pending or (State.ConnectionPhase <> Model.ClientConnectionPhase.Active) then
    return State;
  end if;

  case Tasks.TrySend(State.Requests, Message) of
    when Ok(true):
      return State with Pending := true; PendingChangesProgress := false; Status := 'Talking...'; end with;
    when Ok(false), Error(_):
      return State;
  end case;
end function;

// Owns all keys while the modal is open; Escape waits for the server's end acknowledgement.
public function HandleKey(State: Model.ClientModel; Key: Tui.TuiKeyEvent): Model.ClientModel;
begin
  const Frame := State.ActiveDialogue.Unwrap();
  if State.Pending then
    return State;
  end if;

  if Key.kind = Tui.TuiKeyKind.Escape then
    return Queue(State, Protocol.ClientMessage.EndDialogue);
  end if;

  if Key.kind = Tui.TuiKeyKind.Enter then
    return Queue(
      State,
      Protocol.ClientMessage.DialogueChoice(Frame.NpcId, Frame.Choices[State.DialogueSelection].Id)
    );
  end if;
  var Delta := 0;
  if (Key.kind = Tui.TuiKeyKind.Up)
    or
    ((Key.kind = Tui.TuiKeyKind.Character) and ((Key.ch = 'w') or (Key.ch = 'W')))
  then
    Delta := -1;
  end if;

  if (Key.kind = Tui.TuiKeyKind.Down)
    or
    ((Key.kind = Tui.TuiKeyKind.Character) and ((Key.ch = 's') or (Key.ch = 'S')))
  then
    Delta := 1;
  end if;
  var Next := State;
  const Maximum := Math.Max(0, Lines(State, Frame).Length() - PageHeight(State));
  if Delta <> 0 then
    Next.DialoguePointerRow := -1;
    Next.DialogueSelection := (State.DialogueSelection + Delta + Frame.Choices.Length()) mod
      Frame.Choices.Length();
    const Line := SelectedLine(Next, Frame);
    if Line < Next.DialogueOffset then
      Next.DialogueOffset := Line;
    end if;

    if Line >= Next.DialogueOffset + PageHeight(State) then
      Next.DialogueOffset := Line - PageHeight(State) + 1;
    end if;
  end if;

  if Key.kind = Tui.TuiKeyKind.PageUp then
    Next.DialogueOffset := Next.DialogueOffset - PageHeight(State);
  end if;

  if Key.kind = Tui.TuiKeyKind.PageDown then
    Next.DialogueOffset := Next.DialogueOffset + PageHeight(State);
  end if;

  Next.DialogueOffset := Math.Clamp(Next.DialogueOffset, 0, Maximum);
  return Next;
end function;

// Wraps the complete frame into a scrollable page so narrow terminals retain every topic and answer.
public function View(State: Model.ClientModel): Tui.TuiElement;
begin
  const Frame := State.ActiveDialogue.Unwrap();
  const Values := Lines(State, Frame);
  const Offset := Math.Clamp(
    State.DialogueOffset,
    0,
    Math.Max(0, Values.Length() - PageHeight(State))
  );
  var Roles: array of Tui.TuiStyleRole := [];
  var Disabled: array of boolean := [];
  const Selected := SelectedLine(State, Frame);
  const SelectedRows := Layout.WrappedLines(
    Frame.Choices[State.DialogueSelection].Text,
    Width(State)
  ).Length();
  const FirstChoice := Layout.WrappedLines(Frame.Text, Width(State)).Length() + 1;
  for Index: integer := 0 to Values.Length() - 1 do
    Roles.PushInPlace(
      if (Index >= Selected) and (Index < Selected + SelectedRows) then Tui.TuiStyleRole.Focused
        else Tui.TuiStyleRole.Normal
        end if
    );
    Disabled.PushInPlace(Index < FirstChoice);
  end for;
  const PointerRow := if (State.DialoguePointerRow >= Selected)
    and
    (State.DialoguePointerRow < Selected + SelectedRows) then State.DialoguePointerRow
    else Selected
    end if;

  return Dialog.View(
    State, Frame.Speaker, [
      Dialog.ListFrame(
        Tui.TuiElement.List(
          Tui.TuiControlId.Create(Controls.DialogueListControlId), Values, PointerRow,
          Tui.TuiListActions(
            Change := Tui.TuiAction.Create(Controls.DialogueSelectAction),
            Activate := Some(Tui.TuiAction.Create(Controls.DialogueActivateAction)),
            ItemRoles := Some(Roles), DisabledItems := Some(Disabled), FirstRow := Some(Offset),
            HandleKeys := false
          )
        ), PageHeight(State), Dialog.Width(State)
      )
    ], [
      Dialog.Actions(
        [
          Tui.TuiElementBuilders.MakeLabel(
            Layout.FitLine(
              if State.Pending then 'Waiting for ' + Frame.Speaker + '...'
                elsif Width(State) < 44 then 'W/S select  Enter choose'
                else 'W/S: select  Enter: choose  PgUp/PgDn: scroll'
                end if, Math.Max(1, Width(State) - 8)
            )
          )
        ], [Dialog.Hint('Esc: end')]
      )
    ]
  );
end function;
end unit;
