// Keyboard and control-action handling for screens, overlays, and gameplay.
unit Dungeon.Client.Ui.Input;

uses Dungeon.Client.Journal as Journal, Dungeon.Client.Ui.Dialogue as Dialogue, Dungeon.Client.Ui.Controls as Controls, Dungeon.Client.Ui.Intentions as Intentions, Dungeon.Client.Ui.Layout as Layout, Dungeon.Client.Ui.Session as Session, Dungeon.Client.Ui.Worlds as UiWorlds, Dungeon.Protocol.Worlds as WorldsUnit, Dungeon.Client.Character as Character, Dungeon.Client.CharacterSheet as CharacterSheet, Dungeon.Client.Model as Model, Dungeon.Protocol as Protocol, Std.Tui as Tui;

function HasCharacter(Key: Tui.TuiKeyEvent; Lower: string; Upper: string): boolean;
begin
  return (Key.kind = Tui.TuiKeyKind.Character) and ((Key.ch = Lower) or (Key.ch = Upper));
end function;

function IsCtrlCharacter(Key: Tui.TuiKeyEvent; Lower: string; Upper: string): boolean;
begin
  return (HasCharacter(Key, Lower, Upper) and Key.ctrl) and not Key.alt;
end function;

function IsAltCharacter(Key: Tui.TuiKeyEvent; Lower: string; Upper: string): boolean;
begin
  return (HasCharacter(Key, Lower, Upper) and Key.alt) and not Key.ctrl;
end function;

// Applies one activated button action; actions arrive only from visible controls.
public function HandleAction(State: Model.ClientModel; Action: Tui.TuiAction; Cmd: Tui.TuiCmdOutput): Model.ClientModel;
begin
  if (State.ActiveDialogue is Some(_)) and (Action.Value <> Controls.QuitAction) then
    return State;
  end if;

  case UiWorlds.HandleWorldAction(State, Action) of
    when Some(const Next):
      begin
        return Next;
      end;
    when None:
      begin
        null;
      end;
  end case;

  if Action.Value = Controls.ConnectAction then
    begin
      return Session.StartConnection(State, Cmd);
    end;
  end if;

  if Action.Value = Controls.InformationAction then
    begin
      var Next: Model.ClientModel := State;
      Next.Overlay := Model.ClientOverlay.InformationOverlay;
      Next.FocusedControl := Controls.OverlayBackControlId;
      return Next;
    end;
  end if;

  if Action.Value = Controls.NewGameAction then
    begin
      case WorldsUnit.SelectedWorld(State.Catalog) of
        when Some(const World):
          begin
            if World.Status <> 'ready' then
              return State;
            end if;
          end;
        when None:
          begin
            return State;
          end;
      end case;

      return Session.QueueSessionChoice(
        State,
        Protocol.ClientMessage.StartNewGame,
        'Starting over...'
      );
    end;
  end if;

  if Action.Value = Controls.LoadGameAction then
    begin
      if not WorldsUnit.CanContinueWorld(State.Catalog) then
        begin
          return State;
        end;
      end if;

      return Session.QueueSessionChoice(State, Protocol.ClientMessage.LoadGame, 'Loading game...');
    end;
  end if;

  if Action.Value = Controls.RequestCancelSessionAction then
    begin
      if (
        (State.Screen <> Model.ClientScreen.StartScreen)
        or
        (State.ConnectionPhase <> Model.ClientConnectionPhase.AwaitingSession)
      )
        or
        not State.Pending
      then
        begin
          return State;
        end;
      end if;
      var Next: Model.ClientModel := State;
      Next.Overlay := Model.ClientOverlay.SessionCancelConfirmationOverlay;
      Next.FocusedControl := Controls.ContinueSessionStartControlId;
      return Next;
    end;
  end if;

  if Action.Value = Controls.ConfirmCancelSessionAction then
    begin
      if (State.Overlay <> Model.ClientOverlay.SessionCancelConfirmationOverlay)
        or
        not State.Pending
      then
        begin
          return State;
        end;
      end if;

      return Session.ReturnToStart(State, Cmd);
    end;
  end if;

  if Action.Value = Controls.ContinueSessionStartAction then
    begin
      if State.Overlay <> Model.ClientOverlay.SessionCancelConfirmationOverlay then
        begin
          return State;
        end;
      end if;

      return Session.CloseOverlay(State);
    end;
  end if;

  if Action.Value = Controls.QuitAction then
    begin
      return Session.RequestQuit(State, Cmd);
    end;
  end if;

  if Action.Value = Controls.ResumeAction then
    begin
      return Session.CloseOverlay(State);
    end;
  end if;

  if Action.Value = Controls.SaveAction then
    begin
      if State.Pending or State.MapRequestPending or not State.HasVisibleState
        or
        (State.ConnectionPhase <> Model.ClientConnectionPhase.Active)
      then
        return State;
      end if;

      if State.SaveAvailable then
        begin
          var Next: Model.ClientModel := State;
          Next.Overlay := Model.ClientOverlay.SaveConfirmationOverlay;
          Next.FocusedControl := Controls.ConfirmSaveControlId;
          return Next;
        end;
      end if;

      return Session.QueueSave(State);
    end;
  end if;

  if Action.Value = Controls.ConfirmSaveAction then
    begin
      if State.Overlay <> Model.ClientOverlay.SaveConfirmationOverlay then
        return State;
      end if;

      return Session.QueueSave(State);
    end;
  end if;

  if Action.Value = Controls.CancelSaveAction then
    begin
      var Next: Model.ClientModel := State;
      Next.Overlay := Model.ClientOverlay.SystemMenuOverlay;
      Next.FocusedControl := Controls.SaveControlId;
      return Next;
    end;
  end if;

  if Action.Value = Controls.DisconnectAction then
    begin
      return Session.ReturnToStart(State, Cmd);
    end;
  end if;

  if Action.Value = Controls.BackAction then
    begin
      return Session.CloseOverlay(State);
    end;
  end if;

  if Action.Value = Controls.ClosePanelAction then
    begin
      return Session.CloseOverlay(State);
    end;
  end if;

  return State;
end function;

// Routes one key press to the active overlay first, then to game controls.
public function HandleKey(State: Model.ClientModel; Key: Tui.TuiKeyEvent; Cmd: Tui.TuiCmdOutput): Model.ClientModel;
begin
  if IsAltCharacter(Key, 'x', 'X') then
    begin
      return Session.RequestQuit(State, Cmd);
    end;
  end if;

  if State.ActiveDialogue is Some(_) then
    return Dialogue.HandleKey(State, Key);
  end if;

  if State.Screen <> Model.ClientScreen.GameScreen then
    begin
      return State;
    end;
  end if;

  if State.Overlay = Model.ClientOverlay.DescriptionOverlay then
    begin
      if (Key.kind = Tui.TuiKeyKind.Enter) or (Key.kind = Tui.TuiKeyKind.Escape) then
        begin
          return Session.CloseOverlay(State);
        end;
      end if;
      var Next: Model.ClientModel := State;
      if (Key.kind = Tui.TuiKeyKind.Up) and (Next.DescriptionOffset > 0) then
        begin
          Next.DescriptionOffset := Next.DescriptionOffset - 1;
        end;
      end if;

      if (Key.kind = Tui.TuiKeyKind.Down)
        and
        (
          Next.DescriptionOffset + Layout.DescriptionPageHeight(State) <
          Layout.DescriptionLines(State).Length()
        )
      then
        begin
          Next.DescriptionOffset := Next.DescriptionOffset + 1;
        end;
      end if;

      return Next;
    end;
  end if;

  if State.Overlay = Model.ClientOverlay.InventoryOverlay then
    begin
      if (Key.kind = Tui.TuiKeyKind.Escape) or HasCharacter(Key, 'i', 'I') then
        begin
          return Session.CloseOverlay(State);
        end;
      end if;

      if (Key.kind = Tui.TuiKeyKind.Up) or HasCharacter(Key, 'w', 'W') then
        begin
          return Character.MoveInventorySelection(State, -1);
        end;
      end if;

      if (Key.kind = Tui.TuiKeyKind.Down) or HasCharacter(Key, 's', 'S') then
        begin
          return Character.MoveInventorySelection(State, 1);
        end;
      end if;

      if Key.kind = Tui.TuiKeyKind.Enter then
        begin
          case Character.SelectedItemRequest(State) of
            when Some(const Request):
              begin
                const Status := if Request is Protocol.ClientMessage.UseItem(_) then 'Using item...'
                  else 'Changing gear...'
                  end if;
                return Intentions.QueueCombatAction(State, Request, Status);
              end;
            when None:
              begin
                var Next: Model.ClientModel := State;
                Next.Status := 'No item action available.';
                return Next;
              end;
          end case;
        end;
      end if;

      if HasCharacter(Key, 'd', 'D') then
        begin
          case Character.SelectedDropRequest(State) of
            when Some(const Request):
              return Intentions.QueueCombatAction(State, Request, 'Dropping...');
            when None:
              return State;
          end case;
        end;
      end if;

      return State;
    end;
  end if;

  if State.Overlay = Model.ClientOverlay.JournalOverlay then
    if (Key.kind = Tui.TuiKeyKind.Escape) or HasCharacter(Key, 'j', 'J') then
      return Session.CloseOverlay(State);
    end if;

    if (Key.kind = Tui.TuiKeyKind.Up) or HasCharacter(Key, 'w', 'W') then
      return Journal.Scroll(State, -1);
    end if;

    if (Key.kind = Tui.TuiKeyKind.Down) or HasCharacter(Key, 's', 'S') then
      return Journal.Scroll(State, 1);
    end if;

    if Key.kind = Tui.TuiKeyKind.PageUp then
      return Journal.Scroll(State, - Journal.PageHeight(State));
    end if;

    if Key.kind = Tui.TuiKeyKind.PageDown then
      return Journal.Scroll(State, Journal.PageHeight(State));
    end if;

    return State;
  end if;

  if State.Overlay = Model.ClientOverlay.CharacterSheetOverlay then
    begin
      if (Key.kind = Tui.TuiKeyKind.Escape) or HasCharacter(Key, 'c', 'C') then
        begin
          return Session.CloseOverlay(State);
        end;
      end if;

      if HasCharacter(Key, 'i', 'I') then
        begin
          var Next: Model.ClientModel := State;
          Next.Overlay := Model.ClientOverlay.InventoryOverlay;
          return Character.MoveInventorySelection(Next, 0);
        end;
      end if;

      // The sheet owns all other keys: scrolling is local and nothing reaches the game.
      if (Key.kind = Tui.TuiKeyKind.Up) or HasCharacter(Key, 'w', 'W') then
        return CharacterSheet.Scroll(State, -1);
      end if;

      if (Key.kind = Tui.TuiKeyKind.Down) or HasCharacter(Key, 's', 'S') then
        return CharacterSheet.Scroll(State, 1);
      end if;

      return State;
    end;
  end if;

  if IsCtrlCharacter(Key, 'p', 'P') then
    begin
      if State.Overlay = Model.ClientOverlay.SystemMenuOverlay then
        begin
          return Session.CloseOverlay(State);
        end;
      end if;
      var Next: Model.ClientModel := State;
      Next.Overlay := Model.ClientOverlay.SystemMenuOverlay;
      Next.FocusedControl := Controls.ResumeControlId;
      return Next;
    end;
  end if;

  if HasCharacter(Key, 'm', 'M') then
    begin
      if State.Overlay = Model.ClientOverlay.ExplorationMapOverlay then
        begin
          return Session.CloseOverlay(State);
        end;
      end if;

      if State.Overlay = Model.ClientOverlay.NoOverlay then
        begin
          return Intentions.OpenExplorationMap(State);
        end;
      end if;

      return State;
    end;
  end if;

  if (State.Overlay = Model.ClientOverlay.NoOverlay) and State.HasVisibleState then
    begin
      if HasCharacter(Key, 'i', 'I') then
        begin
          var Next: Model.ClientModel := State;
          Next.Overlay := Model.ClientOverlay.InventoryOverlay;
          Next.FocusedControl := 0;
          return Character.MoveInventorySelection(Next, 0);
        end;
      end if;

      if HasCharacter(Key, 'j', 'J') then
        return State with Overlay := Model.ClientOverlay.JournalOverlay; FocusedControl := 0; JournalOffset := 0; end with;
      end if;

      if HasCharacter(Key, 'c', 'C') then
        begin
          var Next: Model.ClientModel := State;
          Next.Overlay := Model.ClientOverlay.CharacterSheetOverlay;
          Next.FocusedControl := 0;
          Next.CharacterSheetOffset := 0;
          return Next;
        end;
      end if;
    end;
  end if;

  if State.Overlay = Model.ClientOverlay.ExplorationMapOverlay then
    begin
      if Key.kind = Tui.TuiKeyKind.Escape then
        begin
          return Session.CloseOverlay(State);
        end;
      end if;

      if Key.kind = Tui.TuiKeyKind.Home then
        begin
          return Intentions.CenterMap(State);
        end;
      end if;

      if (Key.kind = Tui.TuiKeyKind.Left) or HasCharacter(Key, 'a', 'A') then
        begin
          return Intentions.PanExplorationMap(State, -1, 0);
        end;
      end if;

      if (Key.kind = Tui.TuiKeyKind.Right) or HasCharacter(Key, 'd', 'D') then
        begin
          return Intentions.PanExplorationMap(State, 1, 0);
        end;
      end if;

      if (Key.kind = Tui.TuiKeyKind.Up) or HasCharacter(Key, 'w', 'W') then
        begin
          return Intentions.PanExplorationMap(State, 0, -1);
        end;
      end if;

      if (Key.kind = Tui.TuiKeyKind.Down) or HasCharacter(Key, 's', 'S') then
        begin
          return Intentions.PanExplorationMap(State, 0, 1);
        end;
      end if;

      return State;
    end;
  end if;

  if Key.kind = Tui.TuiKeyKind.F2 then
    begin
      return Session.ToggleContext(State);
    end;
  end if;

  if Key.kind = Tui.TuiKeyKind.F3 then
    begin
      return Session.ToggleMessages(State);
    end;
  end if;

  if State.Overlay <> Model.ClientOverlay.NoOverlay then
    begin
      return State;
    end;
  end if;

  if Key.kind = Tui.TuiKeyKind.Enter then
    begin
      return Intentions.QueueInteraction(State);
    end;
  end if;

  if HasCharacter(Key, 'a', 'A')
    or
    ((Key.kind = Tui.TuiKeyKind.Left) and (State.View = Protocol.ViewKind.Map))
  then
    begin
      if State.HasVisibleState and (State.View = Protocol.ViewKind.FirstPerson) then
        begin
          return Intentions.QueueFirstPersonStep(State, Protocol.FirstPersonStepDirection.Left);
        end;
      end if;

      return Intentions.QueueMove(State, -1, 0);
    end;
  end if;

  if HasCharacter(Key, 'd', 'D')
    or
    ((Key.kind = Tui.TuiKeyKind.Right) and (State.View = Protocol.ViewKind.Map))
  then
    begin
      if State.HasVisibleState and (State.View = Protocol.ViewKind.FirstPerson) then
        begin
          return Intentions.QueueFirstPersonStep(State, Protocol.FirstPersonStepDirection.Right);
        end;
      end if;

      return Intentions.QueueMove(State, 1, 0);
    end;
  end if;

  if HasCharacter(Key, 'w', 'W')
    or
    ((Key.kind = Tui.TuiKeyKind.Up) and (State.View = Protocol.ViewKind.Map))
  then
    begin
      if State.HasVisibleState and (State.View = Protocol.ViewKind.FirstPerson) then
        begin
          return Intentions.QueueFirstPersonStep(State, Protocol.FirstPersonStepDirection.Forward);
        end;
      end if;

      return Intentions.QueueMove(State, 0, -1);
    end;
  end if;

  if HasCharacter(Key, 's', 'S')
    or
    ((Key.kind = Tui.TuiKeyKind.Down) and (State.View = Protocol.ViewKind.Map))
  then
    begin
      if State.HasVisibleState and (State.View = Protocol.ViewKind.FirstPerson) then
        begin
          return Intentions.QueueFirstPersonStep(State, Protocol.FirstPersonStepDirection.Backward);
        end;
      end if;

      return Intentions.QueueMove(State, 0, 1);
    end;
  end if;

  if State.HasVisibleState and (State.View = Protocol.ViewKind.FirstPerson) then
    begin
      if HasCharacter(Key, 'q', 'Q') then
        begin
          return Intentions.QueueFirstPersonTurn(State, Protocol.FirstPersonTurnDirection.Left);
        end;
      end if;

      if HasCharacter(Key, 'e', 'E') then
        begin
          return Intentions.QueueFirstPersonTurn(State, Protocol.FirstPersonTurnDirection.Right);
        end;
      end if;

      // Terminals report Space as its own key kind, not as a character.
      if Key.kind = Tui.TuiKeyKind.Space then
        begin
          return Intentions.QueueCombatAction(State, Protocol.ClientMessage.Attack, 'Attacking...');
        end;
      end if;

      if HasCharacter(Key, 'z', 'Z') then
        begin
          return Intentions.QueueCombatAction(State, Protocol.ClientMessage.Wait, 'Waiting...');
        end;
      end if;
    end;
  end if;

  return State;
end function;
end unit;
