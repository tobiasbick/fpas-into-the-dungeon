// Keyboard and control-action handling for screens, overlays, and gameplay.
unit Dungeon.Client.Ui.Input;

uses
  Dungeon.Client.Ui.Controls, Dungeon.Client.Ui.Intentions, Dungeon.Client.Ui.Layout,
  Dungeon.Client.Ui.Session, Dungeon.Client.Ui.Worlds, Dungeon.Protocol.Worlds,
  Dungeon.Client.Character, Dungeon.Client.Model, Dungeon.Protocol, Std.Arrays, Std.Console,
  Std.Tui;

function HasCharacter(Key: TuiKeyEvent; Lower: string; Upper: string): boolean;
begin
  return (Key.kind = TuiKeyKind.Character) and ((Key.ch = Lower) or (Key.ch = Upper));
end function;

function IsCtrlCharacter(Key: TuiKeyEvent; Lower: string; Upper: string): boolean;
begin
  return (HasCharacter(Key, Lower, Upper) and Key.ctrl) and not Key.alt;
end function;

function IsAltCharacter(Key: TuiKeyEvent; Lower: string; Upper: string): boolean;
begin
  return (HasCharacter(Key, Lower, Upper) and Key.alt) and not Key.ctrl;
end function;

// Applies one activated button action; actions arrive only from visible controls.
public function HandleAction(State: ClientModel; Action: TuiAction; Cmd: TuiCmdOutput): ClientModel;
begin
  case HandleWorldAction(State, Action) of
    when Some(Next):
      begin
        return Next;
      end;
    when None:
      begin
        null;
      end;
  end case;

  if Action.Value = ConnectAction then
    begin
      return StartConnection(State, Cmd);
    end;
  end if;

  if Action.Value = InformationAction then
    begin
      mutable var Next: ClientModel := State;
      Next.Overlay := ClientOverlay.InformationOverlay;
      Next.FocusedControl := OverlayBackControlId;
      return Next;
    end;
  end if;

  if Action.Value = NewGameAction then
    begin
      case SelectedWorld(State.Catalog) of
        when Some(World):
          begin
            if World.Status <> 'ready' then
              return State;
            end if;
          end;
        when None:
          begin
            return State;
          end;
      end case;

      return QueueSessionChoice(State, ClientMessage.StartNewGame, 'Starting over...');
    end;
  end if;

  if Action.Value = LoadGameAction then
    begin
      if not CanContinueWorld(State.Catalog) then
        begin
          return State;
        end;
      end if;

      return QueueSessionChoice(State, ClientMessage.LoadGame, 'Loading game...');
    end;
  end if;

  if Action.Value = RequestCancelSessionAction then
    begin
      if ((State.Screen <> ClientScreen.StartScreen) or (State.ConnectionPhase <> ClientConnectionPhase.AwaitingSession)) or
         not State.Pending then
        begin
          return State;
        end;
      end if;
      mutable var Next: ClientModel := State;
      Next.Overlay := ClientOverlay.SessionCancelConfirmationOverlay;
      Next.FocusedControl := ContinueSessionStartControlId;
      return Next;
    end;
  end if;

  if Action.Value = ConfirmCancelSessionAction then
    begin
      if (State.Overlay <> ClientOverlay.SessionCancelConfirmationOverlay) or not State.Pending then
        begin
          return State;
        end;
      end if;

      return ReturnToStart(State, Cmd);
    end;
  end if;

  if Action.Value = ContinueSessionStartAction then
    begin
      if State.Overlay <> ClientOverlay.SessionCancelConfirmationOverlay then
        begin
          return State;
        end;
      end if;

      return CloseOverlay(State);
    end;
  end if;

  if Action.Value = QuitAction then
    begin
      return RequestQuit(State, Cmd);
    end;
  end if;

  if Action.Value = ResumeAction then
    begin
      return CloseOverlay(State);
    end;
  end if;

  if Action.Value = SaveAction then
    begin
      if State.Pending or State.MapRequestPending or not State.HasVisibleState or
         (State.ConnectionPhase <> ClientConnectionPhase.Active) then
        return State;
      end if;

      if State.SaveAvailable then
        begin
          mutable var Next: ClientModel := State;
          Next.Overlay := ClientOverlay.SaveConfirmationOverlay;
          Next.FocusedControl := ConfirmSaveControlId;
          return Next;
        end;
      end if;

      return QueueSave(State);
    end;
  end if;

  if Action.Value = ConfirmSaveAction then
    begin
      if State.Overlay <> ClientOverlay.SaveConfirmationOverlay then
        return State;
      end if;

      return QueueSave(State);
    end;
  end if;

  if Action.Value = CancelSaveAction then
    begin
      mutable var Next: ClientModel := State;
      Next.Overlay := ClientOverlay.SystemMenuOverlay;
      Next.FocusedControl := SaveControlId;
      return Next;
    end;
  end if;

  if Action.Value = DisconnectAction then
    begin
      return ReturnToStart(State, Cmd);
    end;
  end if;

  if Action.Value = BackAction then
    begin
      return CloseOverlay(State);
    end;
  end if;

  if Action.Value = ClosePanelAction then
    begin
      return CloseOverlay(State);
    end;
  end if;

  return State;
end function;

// Routes one key press to the active overlay first, then to game controls.
public function HandleKey(State: ClientModel; Key: TuiKeyEvent; Cmd: TuiCmdOutput): ClientModel;
begin
  if IsAltCharacter(Key, 'x', 'X') then
    begin
      return RequestQuit(State, Cmd);
    end;
  end if;

  if State.Screen <> ClientScreen.GameScreen then
    begin
      return State;
    end;
  end if;

  if State.Overlay = ClientOverlay.DescriptionOverlay then
    begin
      if (Key.kind = TuiKeyKind.Enter) or (Key.kind = TuiKeyKind.Escape) then
        begin
          return CloseOverlay(State);
        end;
      end if;
      mutable var Next: ClientModel := State;
      if (Key.kind = TuiKeyKind.Up) and (Next.DescriptionOffset > 0) then
        begin
          Next.DescriptionOffset := Next.DescriptionOffset - 1;
        end;
      end if;

      if (Key.kind = TuiKeyKind.Down) and
         (Next.DescriptionOffset + DescriptionPageHeight(State) < Std.Arrays.Length(DescriptionLines(State))) then
        begin
          Next.DescriptionOffset := Next.DescriptionOffset + 1;
        end;
      end if;

      return Next;
    end;
  end if;

  if State.Overlay = ClientOverlay.InventoryOverlay then
    begin
      if (Key.kind = TuiKeyKind.Escape) or HasCharacter(Key, 'i', 'I') then
        begin
          return CloseOverlay(State);
        end;
      end if;

      if (Key.kind = TuiKeyKind.Up) or HasCharacter(Key, 'w', 'W') then
        begin
          return MoveInventorySelection(State, -1);
        end;
      end if;

      if (Key.kind = TuiKeyKind.Down) or HasCharacter(Key, 's', 'S') then
        begin
          return MoveInventorySelection(State, 1);
        end;
      end if;

      if Key.kind = TuiKeyKind.Enter then
        begin
          case SelectedEquipmentRequest(State) of
            when Some(Request):
              begin
                return QueueCombatAction(State, Request, 'Changing gear...');
              end;
            when None:
              begin
                mutable var Next: ClientModel := State;
                Next.Status := 'That cannot be worn.';
                return Next;
              end;
          end case;
        end;
      end if;

      if HasCharacter(Key, 'd', 'D') then
        begin
          case SelectedDropRequest(State) of
            when Some(Request):
              begin
                return QueueCombatAction(State, Request, 'Dropping...');
              end;
            else
              begin
                return State;
              end;
          end case;
        end;
      end if;

      return State;
    end;
  end if;

  if State.Overlay = ClientOverlay.CharacterSheetOverlay then
    begin
      if (Key.kind = TuiKeyKind.Escape) or HasCharacter(Key, 'c', 'C') then
        begin
          return CloseOverlay(State);
        end;
      end if;

      if HasCharacter(Key, 'i', 'I') then
        begin
          mutable var Next: ClientModel := State;
          Next.Overlay := ClientOverlay.InventoryOverlay;
          return MoveInventorySelection(Next, 0);
        end;
      end if;

      return State;
    end;
  end if;

  if IsCtrlCharacter(Key, 'p', 'P') then
    begin
      if State.Overlay = ClientOverlay.SystemMenuOverlay then
        begin
          return CloseOverlay(State);
        end;
      end if;
      mutable var Next: ClientModel := State;
      Next.Overlay := ClientOverlay.SystemMenuOverlay;
      Next.FocusedControl := ResumeControlId;
      return Next;
    end;
  end if;

  if HasCharacter(Key, 'm', 'M') then
    begin
      if State.Overlay = ClientOverlay.ExplorationMapOverlay then
        begin
          return CloseOverlay(State);
        end;
      end if;

      if State.Overlay = ClientOverlay.NoOverlay then
        begin
          return OpenExplorationMap(State);
        end;
      end if;

      return State;
    end;
  end if;

  if (State.Overlay = ClientOverlay.NoOverlay) and State.HasVisibleState then
    begin
      if HasCharacter(Key, 'i', 'I') then
        begin
          mutable var Next: ClientModel := State;
          Next.Overlay := ClientOverlay.InventoryOverlay;
          Next.FocusedControl := 0;
          return MoveInventorySelection(Next, 0);
        end;
      end if;

      if HasCharacter(Key, 'c', 'C') then
        begin
          mutable var Next: ClientModel := State;
          Next.Overlay := ClientOverlay.CharacterSheetOverlay;
          Next.FocusedControl := 0;
          return Next;
        end;
      end if;
    end;
  end if;

  if State.Overlay = ClientOverlay.ExplorationMapOverlay then
    begin
      if Key.kind = TuiKeyKind.Escape then
        begin
          return CloseOverlay(State);
        end;
      end if;

      if Key.kind = TuiKeyKind.Home then
        begin
          return CenterMap(State);
        end;
      end if;

      if (Key.kind = TuiKeyKind.Left) or HasCharacter(Key, 'a', 'A') then
        begin
          return PanExplorationMap(State, -1, 0);
        end;
      end if;

      if (Key.kind = TuiKeyKind.Right) or HasCharacter(Key, 'd', 'D') then
        begin
          return PanExplorationMap(State, 1, 0);
        end;
      end if;

      if (Key.kind = TuiKeyKind.Up) or HasCharacter(Key, 'w', 'W') then
        begin
          return PanExplorationMap(State, 0, -1);
        end;
      end if;

      if (Key.kind = TuiKeyKind.Down) or HasCharacter(Key, 's', 'S') then
        begin
          return PanExplorationMap(State, 0, 1);
        end;
      end if;

      return State;
    end;
  end if;

  if Key.kind = TuiKeyKind.F2 then
    begin
      return ToggleContext(State);
    end;
  end if;

  if Key.kind = TuiKeyKind.F3 then
    begin
      return ToggleMessages(State);
    end;
  end if;

  if State.Overlay <> ClientOverlay.NoOverlay then
    begin
      return State;
    end;
  end if;

  if Key.kind = TuiKeyKind.Enter then
    begin
      return QueueInteraction(State);
    end;
  end if;

  if HasCharacter(Key, 'a', 'A') then
    begin
      if State.HasVisibleState and (State.View = ViewKind.FirstPerson) then
        begin
          return QueueFirstPersonStep(State, FirstPersonStepDirection.Left);
        end;
      end if;

      return QueueMove(State, -1, 0);
    end;
  end if;

  if HasCharacter(Key, 'd', 'D') then
    begin
      if State.HasVisibleState and (State.View = ViewKind.FirstPerson) then
        begin
          return QueueFirstPersonStep(State, FirstPersonStepDirection.Right);
        end;
      end if;

      return QueueMove(State, 1, 0);
    end;
  end if;

  if HasCharacter(Key, 'w', 'W') then
    begin
      if State.HasVisibleState and (State.View = ViewKind.FirstPerson) then
        begin
          return QueueFirstPersonStep(State, FirstPersonStepDirection.Forward);
        end;
      end if;

      return QueueMove(State, 0, -1);
    end;
  end if;

  if HasCharacter(Key, 's', 'S') then
    begin
      if State.HasVisibleState and (State.View = ViewKind.FirstPerson) then
        begin
          return QueueFirstPersonStep(State, FirstPersonStepDirection.Backward);
        end;
      end if;

      return QueueMove(State, 0, 1);
    end;
  end if;

  if State.HasVisibleState and (State.View = ViewKind.FirstPerson) then
    begin
      if HasCharacter(Key, 'q', 'Q') then
        begin
          return QueueFirstPersonTurn(State, FirstPersonTurnDirection.Left);
        end;
      end if;

      if HasCharacter(Key, 'e', 'E') then
        begin
          return QueueFirstPersonTurn(State, FirstPersonTurnDirection.Right);
        end;
      end if;

      // Terminals report Space as its own key kind, not as a character.
      if Key.kind = TuiKeyKind.Space then
        begin
          return QueueCombatAction(State, ClientMessage.Attack, 'Attacking...');
        end;
      end if;

      if HasCharacter(Key, 'z', 'Z') then
        begin
          return QueueCombatAction(State, ClientMessage.Wait, 'Waiting...');
        end;
      end if;
    end;
  end if;

  return State;
end function;
end unit;
