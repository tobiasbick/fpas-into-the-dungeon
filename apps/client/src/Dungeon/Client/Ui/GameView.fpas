// The game screen: primary map or first-person view, sidebar panels, messages, and status line.
unit Dungeon.Client.Ui.GameView;

uses Dungeon.Client.Ui.Layout as Layout, Dungeon.Client.Ui.MapCells as MapCells, Dungeon.Client.Ui.Playback as Playback, Dungeon.Client.Animation as Animation, Dungeon.Client.Character as Character, Dungeon.Client.Model as Model, Dungeon.Client.Raycast as Raycast, Dungeon.Protocol as Protocol, Std.Conv as Conv, Std.Tui as Tui;

function ViewMap(State: Model.ClientModel): Tui.TuiElement;
begin
  var Elements: array of Tui.TuiElement := [];
  if State.HasVisibleState then
    begin
      Elements.PushInPlace(Tui.TuiElementBuilders.MakeCellGrid(MapCells.MapGrid(State)));
    end;
  else
    begin
      Elements.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Waiting for world...'));
    end;
  end if;

  return Tui.TuiElementBuilders.MakePanel('World', [Tui.TuiElementBuilders.MakeColumn(Elements)]);
end function;

// Tints the outermost ring of the first-person image red after the character was hit.
function WithDamageFrame(Grid: Tui.TuiCellGrid): Tui.TuiCellGrid;
begin
  var Framed: Tui.TuiCellGrid := Grid;
  for Y: integer := 0 to Grid.Height - 1 do
    begin
      for X: integer := 0 to Grid.Width - 1 do
        begin
          if (((X = 0) or (Y = 0)) or (X = Grid.Width - 1)) or (Y = Grid.Height - 1) then
            begin
              Framed.Cells[(Y * Grid.Width) + X] := MapCells.ColoredCell(
                ' ',
                255,
                255,
                255,
                150,
                18,
                18
              );
            end;
          end if;
        end;
      end for;
    end;
  end for;

  return Framed;
end function;

function ViewFirstPerson(State: Model.ClientModel): Tui.TuiElement;
begin
  const Viewport: Layout.WorldViewport := Layout.DesiredWorldViewport(State);
  const Value: Protocol.FirstPersonVisibleState := Playback.FirstPersonFromModel(State);
  const Frame: Animation.AnimationFrame := Animation.AnimationFrameAt(State.Animation);
  var Grid: Tui.TuiCellGrid := Tui.TuiCellGrid.Create(0, 0, []);
  // Animation frames reuse the walls rendered at their start while the size is unchanged.
  if (State.Animation.Active and (State.AnimationScene.Width = Viewport.Width))
    and
    (State.AnimationScene.Height = Viewport.Height)
  then
    begin
      Grid := Raycast.ComposeFirstPersonGrid(Value, State.AnimationScene, Frame.Effect);
    end;
  else
    begin
      Grid := Raycast.ComposeFirstPersonGrid(
        Value,
        Raycast.RenderFirstPersonScene(Value, Viewport.Width, Viewport.Height),
        Frame.Effect
      );
    end;
  end if;

  if State.DamageTaken and Frame.ShowDamageFrame then
    begin
      Grid := WithDamageFrame(Grid);
    end;
  end if;

  Grid := Animation.PaintAnimationText(Grid, Frame);
  // Fallback only: the docked sidebar owns hints while visible.
  if (
    (
      (((Grid.Width > 0) and (Grid.Height > 0)) and (State.PrimaryStatus <> ''))
      and
      not (State.ContextPanelVisible and Layout.ContextCanDock(State))
    ) and (State.Overlay <> Model.ClientOverlay.ContextOverlay)
  )
    and
    (State.PrimaryStatus <> 'Nothing in reach')
  then
    begin
      for X: integer := 0 to Grid.Width - 1 do
        begin
          var Glyph: string := ' ';
          if X < State.PrimaryStatus.Length() then
            begin
              Glyph := State.PrimaryStatus[X];
            end;
          end if;

          Grid.Cells[(Grid.Height - 1) * Grid.Width + X] := MapCells.ColoredCell(
            Glyph,
            255,
            220,
            96,
            18,
            21,
            25
          );
        end;
      end for;
    end;
  end if;

  return Tui.TuiElementBuilders.MakePanel(
    State.PrimaryTitle,
    [Tui.TuiElementBuilders.MakeCellGrid(Grid)]
  );
end function;

function ViewPrimary(State: Model.ClientModel): Tui.TuiElement;
begin
  if State.HasVisibleState and (State.View = Protocol.ViewKind.FirstPerson) then
    begin
      return ViewFirstPerson(State);
    end;
  end if;

  return ViewMap(State);
end function;

function FacingLabel(Value: Protocol.FirstPersonFacing): string;
begin
  case Value of
    when Protocol.FirstPersonFacing.North:
      begin
        return 'north';
      end;
    when Protocol.FirstPersonFacing.East:
      begin
        return 'east';
      end;
    when Protocol.FirstPersonFacing.South:
      begin
        return 'south';
      end;
    when Protocol.FirstPersonFacing.West:
      begin
        return 'west';
      end;
  end case;
end function;

// Health as numbers plus an eight-segment bar that fits the narrowest docked sidebar.
// Any remaining health shows at least one segment; before the first projection it is unknown.
function HealthLabel(State: Model.ClientModel): string;
begin
  if State.MaxHealth <= 0 then
    begin
      return 'Health unknown';
    end;
  end if;
  const Filled: integer := (((State.Health * 8) + State.MaxHealth) - 1) div State.MaxHealth;
  return (
    (((('Health ' + Conv.IntToStr(State.Health)) + '/') + Conv.IntToStr(State.MaxHealth)) + ' ') +
    '█'.RepeatStr(Filled)
  ) +
    '░'.RepeatStr(8 - Filled);
end function;

function ViewContext(State: Model.ClientModel): Tui.TuiElement;
begin
  var Position: string := 'Not available';
  var Location: string := 'Outdoor region';
  if State.HasVisibleState then
    begin
      if State.View = Protocol.ViewKind.Map then
        begin
          Position := (Conv.IntToStr(State.WorldX) + ', ') + Conv.IntToStr(State.WorldY);
        end;
      else
        begin
          Location := State.PrimaryTitle;
          Position := (
            ((Conv.IntToStr(State.PlayerX) + ', ') + Conv.IntToStr(State.PlayerY)) + ' facing '
          ) +
            FacingLabel(State.FirstPersonFacing);
        end;
      end if;
    end;
  end if;
  var Elements: array of Tui.TuiElement := [
    Tui.TuiElementBuilders.MakeLabel('Character'),
    Tui.TuiElementBuilders.MakeLabel(HealthLabel(State)),
    Tui.TuiElementBuilders.MakeLabel(''),
    Tui.TuiElementBuilders.MakeLabel('Location'),
    Tui.TuiElementBuilders.MakeLabel(Location),
    Tui.TuiElementBuilders.MakeLabel('Position: ' + Position),
    Tui.TuiElementBuilders.MakeLabel(''),
    Tui.TuiElementBuilders.MakeLabel('Equipment')
  ];
  // Worn and carried lines together never exceed the item count plus one, which the dock budget covers.
  for Line: string in Character.EquipmentLines(State.Inventory) do
    begin
      Elements.PushInPlace(Tui.TuiElementBuilders.MakeLabel(Line));
    end;
  end for;

  Elements.PushInPlace(Tui.TuiElementBuilders.MakeLabel(''));
  Elements.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Quick inventory'));
  const Carried: array of string := Character.CarriedItemNames(State.Inventory);
  if Carried.Length() = 0 then
    begin
      Elements.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Empty'));
    end;
  else
    begin
      for Name: string in Carried do
        begin
          Elements.PushInPlace(Tui.TuiElementBuilders.MakeLabel(Name));
        end;
      end for;
    end;
  end if;

  return Tui.TuiElementBuilders.MakeColumn(Elements);
end function;

// Renders the message history, newest last, or a placeholder when it is empty.
public function ViewMessages(State: Model.ClientModel): Tui.TuiElement;
begin
  var Elements: array of Tui.TuiElement := [];
  if State.Messages.Length() = 0 then
    begin
      Elements.PushInPlace(Tui.TuiElementBuilders.MakeLabel('No messages'));
    end;
  else
    begin
      for Message: string in State.Messages do
        begin
          Elements.PushInPlace(Tui.TuiElementBuilders.MakeLabel(Message));
        end;
      end for;
    end;
  end if;

  return Tui.TuiElementBuilders.MakeColumn(Elements);
end function;

function ViewDockedMessages(State: Model.ClientModel): Tui.TuiElement;
begin
  var Elements: array of Tui.TuiElement := [];
  if State.Messages.Length() = 0 then
    begin
      Elements.PushInPlace(Tui.TuiElementBuilders.MakeLabel('No messages'));
    end;
  end if;

  if State.Messages.Length() > 0 then
    begin
      var Start: integer := State.Messages.Length() - Layout.DockedMessageLines;
      if Start < 0 then
        begin
          Start := 0;
        end;
      end if;

      for Index: integer := Start to State.Messages.Length() - 1 do
        begin
          Elements.PushInPlace(Tui.TuiElementBuilders.MakeLabel(State.Messages[Index]));
        end;
      end for;
    end;
  end if;

  while Elements.Length() < Layout.DockedMessageLines do
    begin
      Elements.PushInPlace(Tui.TuiElementBuilders.MakeLabel(''));
    end;
  end while;

  return Tui.TuiElementBuilders.MakeColumn(Elements);
end function;

function Expanding(Stretch: integer): Tui.TuiLayoutSettings;
begin
  return Tui.TuiLayoutSettings.Create(
    Tui.TuiMargins.Uniform(0),
    Tui.TuiSizePolicy.Expanding(),
    Tui.TuiAlignment.Fill(),
    Stretch
  );
end function;

// A stable upper panel keeps interaction feedback separate from character data.
// Text remains server-provided; this view never derives item or interaction rules.
public function ViewSidebar(State: Model.ClientModel): Tui.TuiElement;
begin
  var Width: integer := (State.ViewportWidth - Layout.PrimaryTerminalWidth(State)) - 2;
  if not Layout.ContextCanDock(State) then
    begin
      Width := State.ViewportWidth - 8;
    end;
  end if;

  if Width > 64 then
    begin
      Width := 64;
    end;
  end if;
  var Text: string := 'Nothing in reach';
  if (State.HasVisibleState and (State.View = Protocol.ViewKind.FirstPerson))
    and
    (State.PrimaryStatus <> '')
  then
    begin
      Text := State.PrimaryStatus;
    end;
  end if;
  const Lines: array of string := Layout.WrappedLines(Text, Width);
  var Labels: array of Tui.TuiElement := [];
  for I: integer := 0 to Layout.EnvironmentPanelHeight - 3 do
    begin
      var Line: string := '';
      if I < Lines.Length() then
        begin
          Line := Lines[I];
        end;
      end if;

      Labels.PushInPlace(Tui.TuiElementBuilders.MakeLabel(Line));
    end;
  end for;
  const Settings: Tui.TuiLayoutSettings := Tui.TuiLayoutSettings.Create(
    Tui.TuiMargins.Uniform(0),
    Tui.TuiSizePolicy.Create(Tui.TuiSizePolicyKind.Expanding, Tui.TuiSizePolicyKind.Fixed),
    Tui.TuiAlignment.Fill(),
    1
  ).WithFixedHeight(Layout.EnvironmentPanelHeight);
  return Tui.TuiElementBuilders.MakeColumn([
    Tui.TuiElementBuilders.MakeLayout(
      Settings, Tui.TuiElementBuilders.MakePanel(
        'Environment', [
          Tui.TuiElementBuilders.MakeColumn(Labels)
        ]
      )
    ),
    Tui.TuiElementBuilders.MakeLayout(
      Expanding(1), Tui.TuiElementBuilders.MakePanel(
        'Context', [
          ViewContext(State)
        ]
      )
    )
  ]);
end function;

function GameStatusItems(State: Model.ClientModel): array of Tui.TuiStatusItem;
begin
  return [
    Tui.TuiStatusItemBuilders.MakeKeyHint('ctrl-p', '|'),
    Tui.TuiStatusItemBuilders.MakeHint(State.Status)
  ];
end function;

// Renders the game screen: primary view, docked panels, and the status line.
public function ViewGameShell(State: Model.ClientModel): Tui.TuiElement;
begin
  var PrimarySettings: Tui.TuiLayoutSettings := Expanding(2);
  if State.ContextPanelVisible and Layout.ContextCanDock(State) then
    begin
      PrimarySettings := PrimarySettings.WithFixedWidth(Layout.PrimaryTerminalWidth(State));
    end;
  end if;
  const Primary: Tui.TuiElement := Tui.TuiElementBuilders.MakeLayout(
    PrimarySettings,
    ViewPrimary(State)
  );
  var MainRow: Tui.TuiElement := Tui.TuiElementBuilders.MakeRow([Primary]);
  if State.ContextPanelVisible and Layout.ContextCanDock(State) then
    begin
      MainRow := Tui.TuiElementBuilders.MakeRow([
        Primary,
        Tui.TuiElementBuilders.MakeLayout(Expanding(1), ViewSidebar(State))
      ]);
    end;
  end if;
  var Rows: array of Tui.TuiElement := [Tui.TuiElementBuilders.MakeLayout(Expanding(1), MainRow)];
  if State.MessagePanelVisible and Layout.MessagesCanDock(State) then
    begin
      const MessageSettings: Tui.TuiLayoutSettings := Tui.TuiLayoutSettings.Create(
        Tui.TuiMargins.Uniform(0),
        Tui.TuiSizePolicy.Create(Tui.TuiSizePolicyKind.Expanding, Tui.TuiSizePolicyKind.Fixed),
        Tui.TuiAlignment.Fill(),
        1
      ).WithFixedHeight(Layout.MessagePanelHeight);
      Rows.PushInPlace(
        Tui.TuiElementBuilders.MakeLayout(
          MessageSettings, Tui.TuiElementBuilders.MakePanel(
            'Messages', [
              ViewDockedMessages(State)
            ]
          )
        )
      );
    end;
  end if;
  const StatusSettings: Tui.TuiLayoutSettings := Tui.TuiLayoutSettings.Create(
    Tui.TuiMargins.Uniform(0),
    Tui.TuiSizePolicy.Create(Tui.TuiSizePolicyKind.Expanding, Tui.TuiSizePolicyKind.Fixed),
    Tui.TuiAlignment.Fill(),
    1
  ).WithFixedHeight(Layout.StatusPanelHeight);
  Rows.PushInPlace(
    Tui.TuiElementBuilders.MakeLayout(
      StatusSettings, Tui.TuiElementBuilders.MakePanel(
        'Status', [
          Tui.TuiElementBuilders.MakeStatusLine(GameStatusItems(State))
        ]
      )
    )
  );
  return Tui.TuiElementBuilders.MakeColumn(Rows);
end function;
end unit;
