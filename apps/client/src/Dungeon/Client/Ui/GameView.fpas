// The game screen: primary map or first-person view, sidebar panels, messages, and status line.
unit Dungeon.Client.Ui.GameView;

uses
  Dungeon.Client.Ui.Layout, Dungeon.Client.Ui.MapCells, Dungeon.Client.Ui.Playback,
  Dungeon.Client.Animation, Dungeon.Client.Character, Dungeon.Client.Model, Dungeon.Client.Raycast,
  Dungeon.Protocol, Std.Conv, Std.Tui;

function ViewMap(State: ClientModel): TuiElement;
begin
  var Elements: array of TuiElement := [];
  if State.HasVisibleState then
    begin
      Elements.Push(TuiElementBuilders.MakeCellGrid(MapGrid(State)));
    end;
  else
    begin
      Elements.Push(TuiElementBuilders.MakeLabel('Waiting for world...'));
    end;
  end if;

  return TuiElementBuilders.MakePanel('World', [TuiElementBuilders.MakeColumn(Elements)]);
end function;

// Tints the outermost ring of the first-person image red after the character was hit.
function WithDamageFrame(Grid: TuiCellGrid): TuiCellGrid;
begin
  var Framed: TuiCellGrid := Grid;
  for Y: integer := 0 to Grid.Height - 1 do
    begin
      for X: integer := 0 to Grid.Width - 1 do
        begin
          if (((X = 0) or (Y = 0)) or (X = Grid.Width - 1)) or (Y = Grid.Height - 1) then
            begin
              Framed.Cells[(Y * Grid.Width) + X] := ColoredCell(' ', 255, 255, 255, 150, 18, 18);
            end;
          end if;
        end;
      end for;
    end;
  end for;

  return Framed;
end function;

function ViewFirstPerson(State: ClientModel): TuiElement;
begin
  const Viewport: WorldViewport := DesiredWorldViewport(State);
  const Value: FirstPersonVisibleState := FirstPersonFromModel(State);
  const Frame: AnimationFrame := AnimationFrameAt(State.Animation);
  var Grid: TuiCellGrid := TuiCellGrid.Create(0, 0, []);
  // Animation frames reuse the walls rendered at their start while the size is unchanged.
  if (State.Animation.Active and (State.AnimationScene.Width = Viewport.Width)) and
     (State.AnimationScene.Height = Viewport.Height) then
    begin
      Grid := ComposeFirstPersonGrid(Value, State.AnimationScene, Frame.Effect);
    end;
  else
    begin
      Grid := ComposeFirstPersonGrid(Value, RenderFirstPersonScene(Value, Viewport.Width, Viewport.Height), Frame.Effect);
    end;
  end if;

  if State.DamageTaken and Frame.ShowDamageFrame then
    begin
      Grid := WithDamageFrame(Grid);
    end;
  end if;

  Grid := PaintAnimationText(Grid, Frame);
  // Fallback only: the docked sidebar owns hints while visible.
  if (((((Grid.Width > 0) and (Grid.Height > 0)) and (State.PrimaryStatus <> '')) and not (State.ContextPanelVisible and ContextCanDock(State))) and (State.Overlay <> ClientOverlay.ContextOverlay)) and
     (State.PrimaryStatus <> 'Nothing in reach') then
    begin
      for X: integer := 0 to Grid.Width - 1 do
        begin
          var Glyph: string := ' ';
          if X < State.PrimaryStatus.Length() then
            begin
              Glyph := State.PrimaryStatus.CharAt(X);
            end;
          end if;

          Grid.Cells[(Grid.Height - 1) * Grid.Width + X] := ColoredCell(Glyph, 255, 220, 96, 18, 21, 25);
        end;
      end for;
    end;
  end if;

  return TuiElementBuilders.MakePanel(State.PrimaryTitle, [TuiElementBuilders.MakeCellGrid(Grid)]);
end function;

function ViewPrimary(State: ClientModel): TuiElement;
begin
  if State.HasVisibleState and (State.View = ViewKind.FirstPerson) then
    begin
      return ViewFirstPerson(State);
    end;
  end if;

  return ViewMap(State);
end function;

function FacingLabel(Value: FirstPersonFacing): string;
begin
  case Value of
    when FirstPersonFacing.North:
      begin
        return 'north';
      end;
    when FirstPersonFacing.East:
      begin
        return 'east';
      end;
    when FirstPersonFacing.South:
      begin
        return 'south';
      end;
    when FirstPersonFacing.West:
      begin
        return 'west';
      end;
  end case;
end function;

// Health as numbers plus an eight-segment bar that fits the narrowest docked sidebar.
// Any remaining health shows at least one segment; before the first projection it is unknown.
function HealthLabel(State: ClientModel): string;
begin
  if State.MaxHealth <= 0 then
    begin
      return 'Health unknown';
    end;
  end if;
  const Filled: integer := (((State.Health * 8) + State.MaxHealth) - 1) div State.MaxHealth;
  return ((((('Health ' + IntToStr(State.Health)) + '/') + IntToStr(State.MaxHealth)) + ' ') + '█'.RepeatStr(Filled)) +
         '░'.RepeatStr(8 - Filled);
end function;

function ViewContext(State: ClientModel): TuiElement;
begin
  var Position: string := 'Not available';
  var Location: string := 'Outdoor region';
  if State.HasVisibleState then
    begin
      if State.View = ViewKind.Map then
        begin
          Position := (IntToStr(State.WorldX) + ', ') + IntToStr(State.WorldY);
        end;
      else
        begin
          Location := State.PrimaryTitle;
          Position := (((IntToStr(State.PlayerX) + ', ') + IntToStr(State.PlayerY)) + ' facing ') +
                      FacingLabel(State.FirstPersonFacing);
        end;
      end if;
    end;
  end if;
  var Elements: array of TuiElement := [
                                         TuiElementBuilders.MakeLabel('Character'),
                                         TuiElementBuilders.MakeLabel(HealthLabel(State)),
                                         TuiElementBuilders.MakeLabel(''),
                                         TuiElementBuilders.MakeLabel('Location'),
                                         TuiElementBuilders.MakeLabel(Location),
                                         TuiElementBuilders.MakeLabel('Position: ' + Position),
                                         TuiElementBuilders.MakeLabel(''),
                                         TuiElementBuilders.MakeLabel('Equipment')
                                       ];
  // Worn and carried lines together never exceed the item count plus one, which the dock budget covers.
  for Line: string in EquipmentLines(State.Inventory) do
    begin
      Elements.Push(TuiElementBuilders.MakeLabel(Line));
    end;
  end for;

  Elements.Push(TuiElementBuilders.MakeLabel(''));
  Elements.Push(TuiElementBuilders.MakeLabel('Quick inventory'));
  const Carried: array of string := CarriedItemNames(State.Inventory);
  if Carried.Length() = 0 then
    begin
      Elements.Push(TuiElementBuilders.MakeLabel('Empty'));
    end;
  else
    begin
      for Name: string in Carried do
        begin
          Elements.Push(TuiElementBuilders.MakeLabel(Name));
        end;
      end for;
    end;
  end if;

  return TuiElementBuilders.MakeColumn(Elements);
end function;

// Renders the message history, newest last, or a placeholder when it is empty.
public function ViewMessages(State: ClientModel): TuiElement;
begin
  var Elements: array of TuiElement := [];
  if State.Messages.Length() = 0 then
    begin
      Elements.Push(TuiElementBuilders.MakeLabel('No messages'));
    end;
  else
    begin
      for Message: string in State.Messages do
        begin
          Elements.Push(TuiElementBuilders.MakeLabel(Message));
        end;
      end for;
    end;
  end if;

  return TuiElementBuilders.MakeColumn(Elements);
end function;

function ViewDockedMessages(State: ClientModel): TuiElement;
begin
  var Elements: array of TuiElement := [];
  if State.Messages.Length() = 0 then
    begin
      Elements.Push(TuiElementBuilders.MakeLabel('No messages'));
    end;
  end if;

  if State.Messages.Length() > 0 then
    begin
      var Start: integer := State.Messages.Length() - DockedMessageLines;
      if Start < 0 then
        begin
          Start := 0;
        end;
      end if;

      for Index: integer := Start to State.Messages.Length() - 1 do
        begin
          Elements.Push(TuiElementBuilders.MakeLabel(State.Messages[Index]));
        end;
      end for;
    end;
  end if;

  while Elements.Length() < DockedMessageLines do
    begin
      Elements.Push(TuiElementBuilders.MakeLabel(''));
    end;
  end while;

  return TuiElementBuilders.MakeColumn(Elements);
end function;

function Expanding(Stretch: integer): TuiLayoutSettings;
begin
  return TuiLayoutSettings.Create(TuiMargins.Uniform(0), TuiSizePolicy.Expanding(), TuiAlignment.Fill(), Stretch);
end function;

// A stable upper panel keeps interaction feedback separate from character data.
// Text remains server-provided; this view never derives item or interaction rules.
public function ViewSidebar(State: ClientModel): TuiElement;
begin
  var Width: integer := (State.ViewportWidth - PrimaryTerminalWidth(State)) - 2;
  if not ContextCanDock(State) then
    begin
      Width := State.ViewportWidth - 8;
    end;
  end if;

  if Width > 64 then
    begin
      Width := 64;
    end;
  end if;
  var Text: string := 'Nothing in reach';
  if (State.HasVisibleState and (State.View = ViewKind.FirstPerson)) and (State.PrimaryStatus <> '') then
    begin
      Text := State.PrimaryStatus;
    end;
  end if;
  const Lines: array of string := WrappedLines(Text, Width);
  var Labels: array of TuiElement := [];
  for I: integer := 0 to EnvironmentPanelHeight - 3 do
    begin
      var Line: string := '';
      if I < Lines.Length() then
        begin
          Line := Lines[I];
        end;
      end if;

      Labels.Push(TuiElementBuilders.MakeLabel(Line));
    end;
  end for;
  const Settings: TuiLayoutSettings := TuiLayoutSettings.Create(TuiMargins.Uniform(0), TuiSizePolicy.Create(TuiSizePolicyKind.Expanding, TuiSizePolicyKind.Fixed), TuiAlignment.Fill(), 1)
                                         .WithFixedHeight(EnvironmentPanelHeight);
  return TuiElementBuilders.MakeColumn([
                                         TuiElementBuilders.MakeLayout(Settings, TuiElementBuilders.MakePanel('Environment', [
                                                                                                                               TuiElementBuilders.MakeColumn(Labels)
                                                                                                                             ])),
                                         TuiElementBuilders.MakeLayout(Expanding(1), TuiElementBuilders.MakePanel('Context', [
                                                                                                                               ViewContext(State)
                                                                                                                             ]))
                                       ]);
end function;

function GameStatusItems(State: ClientModel): array of TuiStatusItem;
begin
  return [
           TuiStatusItemBuilders.MakeKeyHint('ctrl-p', '|'),
           TuiStatusItemBuilders.MakeHint(State.Status)
         ];
end function;

// Renders the game screen: primary view, docked panels, and the status line.
public function ViewGameShell(State: ClientModel): TuiElement;
begin
  var PrimarySettings: TuiLayoutSettings := Expanding(2);
  if State.ContextPanelVisible and ContextCanDock(State) then
    begin
      PrimarySettings := PrimarySettings.WithFixedWidth(PrimaryTerminalWidth(State));
    end;
  end if;
  const Primary: TuiElement := TuiElementBuilders.MakeLayout(PrimarySettings, ViewPrimary(State));
  var MainRow: TuiElement := TuiElementBuilders.MakeRow([Primary]);
  if State.ContextPanelVisible and ContextCanDock(State) then
    begin
      MainRow := TuiElementBuilders.MakeRow([
                                              Primary,
                                              TuiElementBuilders.MakeLayout(Expanding(1), ViewSidebar(State))
                                            ]);
    end;
  end if;
  var Rows: array of TuiElement := [TuiElementBuilders.MakeLayout(Expanding(1), MainRow)];
  if State.MessagePanelVisible and MessagesCanDock(State) then
    begin
      const MessageSettings: TuiLayoutSettings := TuiLayoutSettings.Create(TuiMargins.Uniform(0), TuiSizePolicy.Create(TuiSizePolicyKind.Expanding, TuiSizePolicyKind.Fixed), TuiAlignment.Fill(), 1)
                                                    .WithFixedHeight(MessagePanelHeight);
      Rows.Push(TuiElementBuilders.MakeLayout(MessageSettings, TuiElementBuilders.MakePanel('Messages', [
                                                                                                          ViewDockedMessages(State)
                                                                                                        ])));
    end;
  end if;
  const StatusSettings: TuiLayoutSettings := TuiLayoutSettings.Create(TuiMargins.Uniform(0), TuiSizePolicy.Create(TuiSizePolicyKind.Expanding, TuiSizePolicyKind.Fixed), TuiAlignment.Fill(), 1)
                                               .WithFixedHeight(StatusPanelHeight);
  Rows.Push(TuiElementBuilders.MakeLayout(StatusSettings, TuiElementBuilders.MakePanel('Status', [
                                                                                                   TuiElementBuilders.MakeStatusLine(GameStatusItems(State))
                                                                                                 ])));
  return TuiElementBuilders.MakeColumn(Rows);
end function;
end unit;
