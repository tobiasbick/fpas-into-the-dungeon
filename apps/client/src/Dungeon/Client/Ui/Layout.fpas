// Terminal layout rules: panel sizes, docking, requested world and map viewports, and text wrapping.
unit Dungeon.Client.Ui.Layout;

uses Dungeon.Client.Model as Model, Dungeon.Protocol as Protocol, Std.Console as Console;

// Smallest terminal width and height that dock the context sidebar and message panel.
public const MinimumDockedContextWidth: integer := 72;
public const MinimumDockedMessagesHeight: integer := 18;
// Entries kept in the message history and lines shown by the docked message panel.
public const MaximumMessages: integer := 8;
public const DockedMessageLines: integer := 4;
// Heights of the docked message panel and the status line, frames included.
public const MessagePanelHeight: integer := 6;
public const StatusPanelHeight: integer := 3;
// Five content rows plus the frame; independent of current interaction text.
public const EnvironmentPanelHeight: integer := 7;
// Context frame, twelve fixed content labels, at most two worn slots, and one quick summary row.
public const MinimumContextPanelHeight: integer := 17;
// Fixed labels in the docked context; the overlay omits one spacer for its Close button.
public const ContextFixedSummaryLines: integer := 12;
// Quick summaries show at most this many rows, including their omitted-item count.
public const MaximumQuickInventoryLines: integer := 4;
// Inventory-specific action threshold and maximum visible item rows; not a whole-game minimum.
public const MinimumInventoryWidth: integer := 32;
public const MinimumInventoryHeight: integer := 8;
public const MaximumInventoryRows: integer := 12;
// Terminals at least this large show the exploration map at MapScaleNumerator / MapScaleDenominator.
public const MinimumScaledMapWidth: integer := 60;
public const MinimumScaledMapHeight: integer := 20;
public const MapScaleNumerator: integer := 4;
public const MapScaleDenominator: integer := 5;

// World or map window size requested from the server, in fields.
public type WorldViewport = record
  public Width: integer;
  public Height: integer;
end record;

// Returns whether the terminal fits the context sidebar beside the primary view.
public function ContextCanDock(State: Model.ClientModel): boolean;
begin
  var AvailableHeight: integer := State.ViewportHeight - StatusPanelHeight;
  if State.MessagePanelVisible and (State.ViewportHeight >= MinimumDockedMessagesHeight) then
    begin
      AvailableHeight := AvailableHeight - MessagePanelHeight;
    end;
  end if;

  // Reserve fixed context labels, the two server-owned equipment slots, and a bounded summary.
  return (State.ViewportWidth >= MinimumDockedContextWidth)
    and
    (AvailableHeight >= EnvironmentPanelHeight + MinimumContextPanelHeight);
end function;

// Returns content rows available inside the docked context frame or the context overlay.
public function ContextContentRows(State: Model.ClientModel): integer;
begin
  // Outer overlay frame, its Close button and the inner Context frame consume five rows.
  var Height := State.ViewportHeight - EnvironmentPanelHeight - 5;
  if ContextCanDock(State) then
    Height := State.ViewportHeight - StatusPanelHeight - EnvironmentPanelHeight - 2;
    if State.MessagePanelVisible and (State.ViewportHeight >= MinimumDockedMessagesHeight) then
      Height := Height - MessagePanelHeight;
    end if;
  end if;

  if Height < 0 then
    Height := 0;
  end if;

  return Height;
end function;

// Requires enough space to display a selected inventory row and all action/close hints.
public function InventoryCanFit(State: Model.ClientModel): boolean;
begin
  return (State.ViewportWidth >= MinimumInventoryWidth)
    and
    (State.ViewportHeight >= MinimumInventoryHeight);
end function;

// Reserves four footer rows, the frame and outer breathing room, retaining at least one item row.
public function InventoryPageRows(State: Model.ClientModel): integer;
begin
  var Rows := State.ViewportHeight - 8;
  if Rows > MaximumInventoryRows then
    Rows := MaximumInventoryRows;
  end if;

  if Rows < 1 then
    Rows := 1;
  end if;

  return Rows;
end function;

// Smallest terminal that shows at least one character sheet body row with all hints.
public const MinimumCharacterSheetWidth: integer := 32;
public const MinimumCharacterSheetHeight: integer := 8;
// Widest character sheet body in terminal cells.
public const MaximumCharacterSheetWidth: integer := 76;

// Requires the minimum character sheet size; smaller terminals show only a resize hint.
public function CharacterSheetCanFit(State: Model.ClientModel): boolean;
begin
  return (State.ViewportWidth >= MinimumCharacterSheetWidth)
    and
    (State.ViewportHeight >= MinimumCharacterSheetHeight);
end function;

// Scrolling body rows: the height minus frame, health, range and two hint rows; at least zero.
public function CharacterSheetBodyRows(State: Model.ClientModel): integer;
begin
  if State.ViewportHeight < 6 then
    return 0;
  end if;

  return State.ViewportHeight - 6;
end function;

// Body width in cells: min(width - 4, 76), never negative.
public function CharacterSheetWidth(State: Model.ClientModel): integer;
begin
  var Width := State.ViewportWidth - 4;
  if Width > MaximumCharacterSheetWidth then
    Width := MaximumCharacterSheetWidth;
  end if;

  if Width < 0 then
    Width := 0;
  end if;

  return Width;
end function;

// Clips presentation text to terminal cells, preserving grapheme clusters and marking omitted text.
// Non-positive width returns empty text; a narrow overflow uses only the dots that fit.
public function FitLine(Text: string; Width: integer): string;
begin
  if Width <= 0 then
    return '';
  end if;

  if Console.DisplayWidth(Text) <= Width then
    return Text;
  end if;

  if Width < 3 then
    return '.'.RepeatStr(Width);
  end if;
  var Prefix := '';
  var Used := 0;
  for Glyph: string in Console.SplitGraphemes(Text) do
    const Cells := Console.GraphemeWidth(Glyph);
    if Used + Cells > Width - 3 then
      break;
    end if;

    Prefix := Prefix + Glyph;
    Used := Used + Cells;
  end for;

  return Prefix + '...';
end function;

// Returns whether the terminal fits the message panel below the primary view.
public function MessagesCanDock(State: Model.ClientModel): boolean;
begin
  return State.ViewportHeight >= MinimumDockedMessagesHeight;
end function;

// Returns the terminal columns available to the primary view.
public function PrimaryTerminalWidth(State: Model.ClientModel): integer;
begin
  if State.ContextPanelVisible and ContextCanDock(State) then
    begin
      return (State.ViewportWidth * 2) div 3;
    end;
  end if;

  return State.ViewportWidth;
end function;

// Returns the world size the primary view can show; map fields take two columns.
public function DesiredWorldViewport(State: Model.ClientModel): WorldViewport;
begin
  const PrimaryWidth: integer := PrimaryTerminalWidth(State);
  var PrimaryHeight: integer := State.ViewportHeight - StatusPanelHeight;
  if State.MessagePanelVisible and MessagesCanDock(State) then
    begin
      PrimaryHeight := PrimaryHeight - MessagePanelHeight;
    end;
  end if;
  var Width: integer := PrimaryWidth - 2;
  if not State.HasVisibleState or (State.View = Protocol.ViewKind.Map) then
    begin
      Width := Width div 2;
    end;
  end if;
  var Height: integer := PrimaryHeight - 2;
  if Width < 1 then
    begin
      Width := 1;
    end;
  end if;

  if Height < 1 then
    begin
      Height := 1;
    end;
  end if;

  return WorldViewport(Width := Width, Height := Height);
end function;

// Returns the exploration-map window size for the terminal, within protocol limits.
public function DesiredMapViewport(State: Model.ClientModel): WorldViewport;
begin
  var Width: integer := State.ViewportWidth - 4;
  var Height: integer := State.ViewportHeight - 6;
  if State.ViewportWidth >= MinimumScaledMapWidth then
    begin
      Width := ((State.ViewportWidth * MapScaleNumerator) div MapScaleDenominator) - 4;
    end;
  end if;

  if State.ViewportHeight >= MinimumScaledMapHeight then
    begin
      Height := ((State.ViewportHeight * MapScaleNumerator) div MapScaleDenominator) - 6;
    end;
  end if;

  if Width < 1 then
    begin
      Width := 1;
    end;
  end if;

  if Height < 1 then
    begin
      Height := 1;
    end;
  end if;

  if Width > Protocol.MaximumExplorationMapWidth then
    begin
      Width := Protocol.MaximumExplorationMapWidth;
    end;
  end if;

  if Height > Protocol.MaximumExplorationMapHeight then
    begin
      Height := Protocol.MaximumExplorationMapHeight;
    end;
  end if;

  return WorldViewport(Width := Width, Height := Height);
end function;

// Wrap presentation text at word boundaries, splitting oversized words as needed.
public function WrappedLines(Text: string; AvailableWidth: integer): array of string;
begin
  var Width: integer := AvailableWidth;
  if Width < 1 then
    begin
      Width := 1;
    end;
  end if;
  var Lines: array of string := [];
  var Remaining: string := Text;
  while Remaining.Length() > 0 do
    begin
      var Count: integer := Remaining.Length();
      if Count > Width then
        begin
          Count := Width;
          var Split: integer := Width;
          while (Split > 0) and (Remaining[Split] <> ' ') do
            begin
              Split := Split - 1;
            end;
          end while;

          if Split > 0 then
            begin
              Count := Split;
            end;
          end if;
        end;
      end if;
      var Line: string := '';
      for I: integer := 0 to Count - 1 do
        begin
          Line := Line + Remaining[I];
        end;
      end for;

      Lines.PushInPlace(Line);
      var Rest: string := '';
      for I: integer := Count to Remaining.Length() - 1 do
        begin
          Rest := Rest + Remaining[I];
        end;
      end for;

      Remaining := Rest.Trim();
    end;
  end while;

  return Lines;
end function;

// Returns the open description wrapped to the description overlay width.
public function DescriptionLines(State: Model.ClientModel): array of string;
begin
  var Width: integer := State.ViewportWidth - 8;
  if Width > 64 then
    begin
      Width := 64;
    end;
  end if;

  return WrappedLines(State.DescriptionText, Width);
end function;

// Returns how many description lines one overlay page shows.
public function DescriptionPageHeight(State: Model.ClientModel): integer;
begin
  var Height: integer := State.ViewportHeight - 8;
  if Height > 12 then
    begin
      Height := 12;
    end;
  end if;

  if Height < 1 then
    begin
      Height := 1;
    end;
  end if;

  return Height;
end function;
end unit;
