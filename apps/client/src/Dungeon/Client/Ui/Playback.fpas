// Starts, advances, and stops the client-only combat animation of a resolved turn.
unit Dungeon.Client.Ui.Playback;

uses Dungeon.Client.Ui.Layout as Layout, Dungeon.Client.Animation as AnimationUnit, Dungeon.Client.Model as Model, Dungeon.Client.Raycast as Raycast, Dungeon.Protocol as Protocol, Std.Tui as Tui;

// Ends a running animation at once; the still frame shows the final state.
// A tick still pending from the host arrives later and is ignored.
public function StopAnimation(State: Model.ClientModel; Cmd: Tui.TuiCmdOutput): Model.ClientModel;
begin
  if not State.Animation.Active then
    begin
      return State;
    end;
  end if;
  var Next: Model.ClientModel := State;
  Next.Animation := AnimationUnit.NoAnimation();
  return Next;
end function;

function WieldsWeapon(Inventory: array of Protocol.VisibleInventoryItem): boolean;
begin
  for Item: Protocol.VisibleInventoryItem in Inventory do
    begin
      if Item.Equipped and (Item.Slot = Protocol.VisibleItemSlot.Weapon) then
        begin
          return true;
        end;
      end if;
    end;
  end for;

  return false;
end function;

// Rebuilds the projected first-person state from the model for rendering.
public function FirstPersonFromModel(State: Model.ClientModel): Protocol.FirstPersonVisibleState;
begin
  return Protocol.FirstPersonVisibleState(
    Title := State.PrimaryTitle,
    Status := State.PrimaryStatus,
    Width := State.Width,
    Height := State.Height,
    Rows := State.Rows,
    KnowledgeRows := State.KnowledgeRows,
    PlayerX := State.PlayerX,
    PlayerY := State.PlayerY,
    Facing := State.FirstPersonFacing,
    Inventory := State.Inventory,
    Health := State.Health,
    MaxHealth := State.MaxHealth,
    Character := State.Character,
    CombatLog := [],
    CombatEvents := []
  );
end function;

// Starts playback of a first-person turn's events, rendering walls and floor once for all frames.
public function StartCombatAnimation(
  State: Model.ClientModel;
  Events: array of Protocol.VisibleCombatEvent;
  Cmd: Tui.TuiCmdOutput
): Model.ClientModel;
begin
  var Next: Model.ClientModel := StopAnimation(State, Cmd);
  const Animation: AnimationUnit.CombatAnimation := AnimationUnit.StartAnimation(
    Events,
    WieldsWeapon(State.Inventory)
  );
  if not Animation.Active then
    begin
      return Next;
    end;
  end if;
  const Viewport: Layout.WorldViewport := Layout.DesiredWorldViewport(Next);
  Next.Animation := Animation;
  Next.AnimationScene := Raycast.RenderFirstPersonScene(
    FirstPersonFromModel(Next),
    Viewport.Width,
    Viewport.Height
  );
  Cmd.RequestTick(AnimationUnit.AnimationFrameMilliseconds);
  return Next;
end function;

// Advances a running animation by the elapsed time of one host tick and requests the next frame.
// Ticks after the animation ended change nothing.
public function AdvanceCombatAnimation(State: Model.ClientModel; Elapsed: integer; Cmd: Tui.TuiCmdOutput): Model.ClientModel;
begin
  if not State.Animation.Active then
    begin
      return State;
    end;
  end if;
  var Next: Model.ClientModel := State;
  Next.Animation := AnimationUnit.AdvanceAnimation(State.Animation, Elapsed);
  if Next.Animation.Active then
    begin
      Cmd.RequestTick(AnimationUnit.AnimationFrameMilliseconds);
    end;
  else
    begin
      Next.Animation := AnimationUnit.NoAnimation();
    end;
  end if;

  return Next;
end function;
end unit;
