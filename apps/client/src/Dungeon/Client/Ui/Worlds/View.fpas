// Presents the world catalog, creation editor and progress-discard confirmation.
unit Dungeon.Client.Ui.Worlds.View;

uses Dungeon.Client.Model as Model, Dungeon.Client.Ui.Controls as Controls, Dungeon.Client.Ui.Dialog as Dialog, Dungeon.Client.Ui.Layout as Layout, Dungeon.Client.Ui.Worlds as Worlds, Dungeon.Ui.Overlay as Overlay, Dungeon.Ui.WorldSeeds as Seeds, Dungeon.Protocol as Protocol, Dungeon.Protocol.Worlds as WorldsUnit, Std.Math as Math, Std.Text.Format as Conv, Std.Ui.Terminal as Tui;

// The catalog shares its available width with the footer and framed list.
function CatalogWidth(State: Model.ClientModel): integer;
begin
  return Dialog.Width(State);
end function;

// Left-aligns Text in a column of Width characters, keeping at least one separating space.
function Column(Text: string; Width: integer): string;
begin
  return Text.PadRight(Width, ' ') + ' ';
end function;

// Player-facing label of a server status code; unknown codes are shown unchanged.
function StatusLabel(Code: string): string;
begin
  case Code of
    when 'ready':
      return 'ready';
    when 'incompatible':
      return 'incompatible';
    when 'storage_error':
      return 'storage error';
    when 'world_data_error':
      return 'level error';
    when 'available':
      return 'saved';
    when 'missing':
      return 'none';
    when 'unknown':
      return '-';
    else
      return Code.Replace('_', ' ');
  end case;
end function;

// One fixed-column table row: world, status, seed, region and save; clipped to the catalog width.
function WorldRow(World: Protocol.WorldSummary; Width: integer): string;
begin
  var Seed := '-';
  var Region := '-';
  if World.Status = 'ready' then
    Seed := Conv.IntToStr(World.Seed);
    Region := Conv.IntToStr(World.RegionChunks);
  end if;

  return Layout.FitLine(
    Column(World.Id, 12) + Column(StatusLabel(World.Status), 13) + Column(Seed, 10) +
    Column(Region, 7) + StatusLabel(World.SaveStatus),
    Width
  );
end function;

// Keeps the catalog, page range and selected reason above two fixed bottom action rows.
public function ViewCatalog(State: Model.ClientModel): Tui.TuiElement;
begin
  if ((State.ViewportWidth > 0) and (State.ViewportWidth < 40))
    or
    ((State.ViewportHeight > 0) and (State.ViewportHeight < 12))
  then
    return Dialog.View(
      State, 'Worlds', [Tui.TuiElementBuilders.MakeLabel('Resize to 40x12')], [
        Dialog.Actions(
          [], [
            Tui.TuiElementBuilders.MakeButtonOfKind(
              Tui.TuiControlId.Create(Controls.StartDisconnectControlId), 'Disconnect',
              Tui.TuiAction.Create(Controls.DisconnectAction), Tui.TuiButtonKind.Cancel
            )
          ]
        ),
        Dialog.Actions(
          [], [
            Tui.TuiElementBuilders.MakeButton(
              Tui.TuiControlId.Create(Controls.StartQuitControlId), 'Quit',
              Tui.TuiAction.Create(Controls.QuitAction)
            )
          ]
        )
      ]
    );
  end if;
  var Items: array of Tui.TuiElement := [
    Tui.TuiElementBuilders.MakeLabel(Layout.FitLine(State.Status, CatalogWidth(State)))
  ];
  var Labels: array of string := [];
  const Width := CatalogWidth(State);
  const Selected := Worlds.ReconcileWorldCursor(State).WorldCursor;
  for Index: integer := 0 to State.Catalog.Worlds.Length() - 1 do
    if Index < Worlds.PageSize(State) then
      Labels.PushInPlace(WorldRow(State.Catalog.Worlds[Index], Width - 4));
    end if;
  end for;
  var Paging: array of Tui.TuiElement := [];
  if State.Catalog.Offset > 0 then
    Paging.PushInPlace(
      Tui.TuiElementBuilders.MakeButton(
        Tui.TuiControlId.Create(Controls.PreviousWorldsControlId), 'Previous',
        Tui.TuiAction.Create(Controls.PreviousWorldsAction)
      )
    );
  end if;

  if State.Catalog.Offset + Worlds.PageSize(State) < State.Catalog.Total then
    Paging.PushInPlace(
      Tui.TuiElementBuilders.MakeButton(
        Tui.TuiControlId.Create(Controls.NextWorldsControlId), 'Next',
        Tui.TuiAction.Create(Controls.NextWorldsAction)
      )
    );
  end if;
  const First := if Labels.IsEmpty() then 0 else State.Catalog.Offset + 1 end if;
  Items.PushInPlace(
    Dialog.Actions(
      [
        Tui.TuiElementBuilders.MakeHeading(
          Conv.IntToStr(First) + '-' +
          Conv.IntToStr(State.Catalog.Offset + Labels.Length()) + ' of ' +
          Conv.IntToStr(State.Catalog.Total)
        )
      ], Paging
    )
  );
  const Fill := Tui.TuiLayoutSettings.Default() with SizePolicy := Tui.TuiSizePolicy.Expanding(); end with;

  Items.PushInPlace(
    Tui.TuiElementBuilders.MakeLayout(
      Fill.WithFixedWidth(Width).WithFixedHeight(Worlds.PageSize(State) + 3),
      Tui.TuiElementBuilders.MakePanel(
        '', [
          Tui.TuiElementBuilders.MakeHeading(
            Layout.FitLine(
              '  ' + Column('World', 12) + Column('Status', 13) + Column('Seed', 10) +
              Column('Region', 7) + 'Save', Width - 2
            )
          ),
          Tui.TuiElementBuilders.MakeList(
            Tui.TuiControlId.Create(Controls.WorldListControlId),
            Labels,
            Selected,
            Tui.TuiAction.Create(Controls.SelectWorldAction)
          )
        ]
      )
    )
  );
  var Detail := State.Catalog.SelectionReason;
  var Secondary: array of Tui.TuiElement := [];
  case WorldsUnit.SelectedWorld(State.Catalog) of
    when Some(const World):
      begin
        // The reason appears once, for the selected world only, wrapped instead of clipped.
        Detail := 'Selected: ' + World.Id;
        if World.Reason <> '' then
          Detail := Detail + ' - ' + World.Reason;
        end if;

        if World.Status = 'ready' then
          Secondary.PushInPlace(
            Tui.TuiElementBuilders.MakeButtonOfKind(
              Tui.TuiControlId.Create(Controls.NewGameControlId),
              if Width < 50 then 'Restart' else 'Start over' end if,
              Tui.TuiAction.Create(Controls.NewGameAction), Tui.TuiButtonKind.Warning
            )
          );
        end if;
      end;
    when None:
      null;
  end case;
  var Details: array of Tui.TuiElement := [];
  for Line: string in Layout.WrappedLines(Detail, Width) do
    Details.PushInPlace(Tui.TuiElementBuilders.MakeLabel(Line));
  end for;

  Items.PushInPlace(
    Tui.TuiElementBuilders.MakeLayout(
      Tui.TuiLayoutSettings.Default().WithFixedHeight(
        Math.Max(1, Dialog.BodyRows(State, 2) - Worlds.PageSize(State) - 5)
      ),
      Tui.TuiElementBuilders.MakeScroll(
        Tui.TuiControlId.Create(Controls.DialogScrollControlId),
        Tui.TuiPoint.Create(0, State.DialogScrollOffset),
        Tui.TuiAction.Create(Controls.DialogScrollAction),
        Tui.TuiElementBuilders.MakeColumn(Details)
      )
    )
  );
  var Primary: array of Tui.TuiElement := [];
  if WorldsUnit.CanContinueWorld(State.Catalog) then
    Primary.PushInPlace(
      Tui.TuiElementBuilders.MakeButtonOfKind(
        Tui.TuiControlId.Create(Controls.LoadGameControlId),
        'Continue',
        Tui.TuiAction.Create(Controls.LoadGameAction), Tui.TuiButtonKind.Primary
      )
    );
  end if;
  var Actions: array of Tui.TuiElement := [];
  Actions.PushInPlace(
    Tui.TuiElementBuilders.MakeButton(
      Tui.TuiControlId.Create(Controls.RefreshWorldsControlId),
      if Width < 50 then 'Refresh' else 'Refresh worlds' end if,
      Tui.TuiAction.Create(Controls.RefreshWorldsAction)
    )
  );
  Actions.PushInPlace(
    Tui.TuiElementBuilders.MakeButton(
      Tui.TuiControlId.Create(Controls.CreateWorldControlId),
      if Width < 50 then 'Create' else 'Create world' end if,
      Tui.TuiAction.Create(Controls.CreateWorldAction)
    )
  );
  Actions := Actions.Concat(Secondary);
  Actions.PushInPlace(
    Tui.TuiElementBuilders.MakeButton(
      Tui.TuiControlId.Create(Controls.StartInformationControlId),
      if Width < 64 then 'Info' else 'Information' end if,
      Tui.TuiAction.Create(Controls.InformationAction)
    )
  );
  Primary := Primary.Concat([
    Tui.TuiElementBuilders.MakeButtonOfKind(
      Tui.TuiControlId.Create(Controls.StartDisconnectControlId),
      'Disconnect', Tui.TuiAction.Create(Controls.DisconnectAction), Tui.TuiButtonKind.Cancel
    ),
    Tui.TuiElementBuilders.MakeButton(
      Tui.TuiControlId.Create(Controls.StartQuitControlId), 'Quit',
      Tui.TuiAction.Create(Controls.QuitAction)
    )
  ]);
  return Dialog.View(
    State,
    'INTO THE DUNGEON',
    Items,
    [Dialog.Actions(Actions, []), Dialog.Actions([], Primary)]
  );
end function;

// Keeps the creation form stable while presets or custom values change, with actions at the bottom.
public function ViewNewWorld(State: Model.ClientModel): Tui.TuiElement;
begin
  const Rule := Dialog.Rule();
  const Size := Dialog.Size(State);
  if ((State.ViewportWidth > 0) and (State.ViewportWidth < 40))
    or
    ((State.ViewportHeight > 0) and (State.ViewportHeight < 12))
  then
    return Dialog.View(
      State,
      'Create world', [
        Tui.TuiElementBuilders.MakeLabel('Need at least 40 x 12')
      ], [
        Dialog.Actions(
          [], [
            Tui.TuiElementBuilders.MakeButtonOfKind(
              Tui.TuiControlId.Create(Controls.OverlayBackControlId), 'Cancel',
              Tui.TuiAction.Create(Controls.BackAction), Tui.TuiButtonKind.Cancel
            )
          ]
        )
      ]
    );
  end if;
  const Width := Math.Max(1, Size.Width - 4);
  const Compact := (Size.Width < 60) or (Size.Height < 17);
  var SeedLabel := 'Seed: ' + Conv.IntToStr(State.Catalog.MinimumSeed) + ' through ' +
    Conv.IntToStr(State.Catalog.MaximumSeed);
  var RegionLabel := 'Entrance region: ' + Conv.IntToStr(State.Catalog.MinimumRegionChunks) +
    ' through ' + Conv.IntToStr(State.Catalog.MaximumRegionChunks) + ' chunks';
  if Compact then
    SeedLabel := 'Seed: signed 32-bit';
    RegionLabel := 'Entrance region: 1-16';
  end if;
  var Items := [
    Tui.TuiElementBuilders.MakeLabel(SeedLabel),
    Tui.TuiElementBuilders.MakeInput(
      Tui.TuiControlId.Create(Controls.SeedControlId), State.SeedText, State.SeedCaret,
      Tui.TuiAction.Create(Controls.SeedChangedAction)
    )
  ];
  if not Compact then
    Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel(Seeds.Description(State.SeedText)));
  end if;

  Items.PushInPlace(Seeds.Choices(State.SeedText, Controls.FirstSeedPresetControlId, Compact));
  if Size.Height >= 17 then
    Items.PushInPlace(Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Fixed(1)));
  end if;

  Items := Items.Concat([
    Tui.TuiElementBuilders.MakeLabel(RegionLabel),
    Tui.TuiElementBuilders.MakeInput(
      Tui.TuiControlId.Create(Controls.RegionControlId), State.RegionText, State.RegionCaret,
      Tui.TuiAction.Create(Controls.RegionChangedAction)
    )
  ]);
  if State.Status <> '' then
    var Messages: array of Tui.TuiElement := [];
    for Line: string in Layout.WrappedLines(State.Status, Width) do
      Messages.PushInPlace(
        Tui.TuiElement.Label(
          Tui.TuiLabel(
            Text := Line,
            Role := if State.Pending then Tui.TuiStyleRole.Normal
              else Tui.TuiStyleRole.Failure
              end if
          )
        )
      );
    end for;

    Items.PushInPlace(
      Tui.TuiElementBuilders.MakeLayout(
        Tui.TuiLayoutSettings.Default().WithFixedHeight(1),
        Tui.TuiElementBuilders.MakeScroll(
          Tui.TuiControlId.Create(Controls.WorldStatusControlId),
          Tui.TuiPoint.Create(0, State.DialogScrollOffset),
          Tui.TuiAction.Create(Controls.WorldStatusScrollAction),
          Tui.TuiElementBuilders.MakeColumn(Messages)
        )
      )
    );
  elsif not Compact then
    Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel('Larger region = fewer dungeon entrances.'));
  end if;

  Items := Items.Concat([
    Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Expanding(1)),
    Tui.TuiElementBuilders.MakeRow([
      Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Expanding(0)),
      Tui.TuiElementBuilders.MakeButtonOfKind(
        Tui.TuiControlId.Create(Controls.SubmitWorldControlId), 'Create',
        Tui.TuiAction.Create(Controls.SubmitWorldAction), Tui.TuiButtonKind.Primary
      ),
      Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Fixed(1)),
      Tui.TuiElementBuilders.MakeButtonOfKind(
        Tui.TuiControlId.Create(Controls.OverlayBackControlId), 'Cancel',
        Tui.TuiAction.Create(Controls.BackAction), Tui.TuiButtonKind.Cancel
      )
    ])
  ]);
  return Overlay.Responsive('Create world', Rule, Items);
end function;

// Discard is explicit; cancellation returns to the still-installed game session.
public function ViewDiscardConfirmation(State: Model.ClientModel): Tui.TuiElement;
begin
  var Body: array of Tui.TuiElement := [];
  for Line: string in Layout.WrappedLines(
    'Unsaved progress will be lost. The last save is kept.',
    Dialog.Width(State)
  ) do
    Body.PushInPlace(Tui.TuiElementBuilders.MakeLabel(Line));
  end for;

  return Dialog.View(
    State,
    'Discard unsaved progress?', Body, [
      Dialog.Actions(
        [], [
          Tui.TuiElementBuilders.MakeButtonOfKind(
            Tui.TuiControlId.Create(Controls.DiscardControlId),
            'Discard and choose world',
            Tui.TuiAction.Create(Controls.ConfirmDiscardAction), Tui.TuiButtonKind.Dangerous
          ),
          Tui.TuiElement.Button(
            Tui.TuiButtonSpec.DefaultButton(
              Tui.TuiControlId.Create(Controls.OverlayBackControlId),
              'Cancel',
              '',
              Tui.TuiAction.Create(Controls.BackAction)
            ) with Kind := Tui.TuiButtonKind.Cancel; end with
          )
        ]
      )
    ]
  );
end function;
end unit;
