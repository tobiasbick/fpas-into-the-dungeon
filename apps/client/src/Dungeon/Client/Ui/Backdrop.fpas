// Responsive colored ASCII backdrop for the client's pre-game screens.
unit Dungeon.Client.Ui.Backdrop;

uses Dungeon.Client.Model as Model, Std.Math as Math, Std.Ui.Terminal as Tui;

function StyledCell(
  Glyph: string;
  ForegroundRed: integer;
  ForegroundGreen: integer;
  ForegroundBlue: integer;
  BackgroundRed: integer;
  BackgroundGreen: integer;
  BackgroundBlue: integer
): Tui.TuiCell;
begin
  return Tui.TuiCell.Styled(
    Glyph,
    Tui.TuiStyle.FromColors(
      Tui.TuiColor.FromRgb(ForegroundRed, ForegroundGreen, ForegroundBlue),
      Tui.TuiColor.FromRgb(BackgroundRed, BackgroundGreen, BackgroundBlue)
    )
  );
end function;

function SkyCell(X: integer; Y: integer): Tui.TuiCell;
begin
  if ((X * 17) + (Y * 31)) mod 97 = 0 then
    begin
      return StyledCell('*', 148, 166, 196, 8, 12, 24);
    end;
  end if;

  if ((X * 29) + (Y * 13)) mod 149 = 0 then
    begin
      return StyledCell('.', 90, 108, 142, 8, 12, 24);
    end;
  end if;

  return StyledCell(' ', 8, 12, 24, 8, 12, 24);
end function;

function MountainSurface(X: integer; Width: integer; Horizon: integer): integer;
begin
  var Surface: integer := Horizon;
  const Height: integer := Math.Max(2, Horizon div 2);
  const LeftDistance: integer := Math.Abs(X - (Width div 5));
  if LeftDistance < Height * 2 then
    begin
      Surface := Math.Min(Surface, Horizon - (Height - (LeftDistance div 2)));
    end;
  end if;
  const RightDistance: integer := Math.Abs(X - ((Width * 4) div 5));
  if RightDistance < Height * 2 then
    begin
      Surface := Math.Min(Surface, Horizon - (Height - (RightDistance div 2)));
    end;
  end if;
  const DistantDistance: integer := Math.Abs(X - (Width div 2));
  const DistantHeight: integer := Math.Max(2, Height div 2);
  if DistantDistance < DistantHeight * 3 then
    begin
      Surface := Math.Min(Surface, Horizon - (DistantHeight - (DistantDistance div 3)));
    end;
  end if;

  return Surface;
end function;

function MountainCell(X: integer; Y: integer; Width: integer; Horizon: integer): Tui.TuiCell;
begin
  const Surface: integer := MountainSurface(X, Width, Horizon);
  if Y = Surface then
    begin
      return StyledCell('^', 48, 57, 72, 14, 19, 31);
    end;
  end if;

  return StyledCell(' ', 31, 38, 49, 14, 19, 31);
end function;

function GroundCell(X: integer; Y: integer): Tui.TuiCell;
begin
  var Glyph: string := ' ';
  if ((X * 11) + (Y * 7)) mod 17 = 0 then
    begin
      Glyph := ',';
    end;
  else
    if ((X * 5) + (Y * 13)) mod 23 = 0 then
      begin
        Glyph := '''';
      end;
    end if;
  end if;

  return StyledCell(Glyph, 49, 77, 50, 13, 23, 17);
end function;

function PathCell(X: integer; Y: integer): Tui.TuiCell;
begin
  var Glyph: string := ' ';
  if ((X * 7) + (Y * 11)) mod 13 = 0 then
    begin
      Glyph := '.';
    end;
  end if;

  return StyledCell(Glyph, 76, 58, 43, 35, 27, 22);
end function;

function GateStoneCell(X: integer; Y: integer): Tui.TuiCell;
begin
  var Glyph: string := '#';
  if ((X + (Y * 3)) mod 5) = 0 then
    begin
      Glyph := ':';
    end;
  end if;

  return StyledCell(Glyph, 105, 107, 112, 29, 30, 35);
end function;

function TreeCell(X: integer; Y: integer; Center: integer; Base: integer; TreeHeight: integer): option of Tui.TuiCell;
begin
  const Top: integer := Base - TreeHeight;
  if (Y >= Top) and (Y < Base - 1) then
    begin
      const HalfWidth: integer := ((Y - Top) div 2) + 1;
      if Math.Abs(X - Center) <= HalfWidth then
        begin
          return Some(StyledCell('^', 38, 70, 42, 10, 21, 15));
        end;
      end if;
    end;
  end if;

  if ((Y >= Base - 1) and (Y <= Base)) and (X = Center) then
    begin
      return Some(StyledCell('|', 75, 58, 40, 13, 23, 17));
    end;
  end if;

  return None;
end function;

function BackdropCell(X: integer; Y: integer; Width: integer; Height: integer): Tui.TuiCell;
begin
  const Center: integer := Width div 2;
  const Horizon: integer := Math.Clamp((Height * 2) div 5, 2, Math.Max(2, Height - 3));
  const GateHalfWidth: integer := Math.Clamp(Width div 7, 10, 22);
  const GateTop: integer := Math.Max(1, Height div 6);
  const GateBottom: integer := Math.Clamp(
    (Height * 4) div 5, GateTop + 4, Math.Max(
      GateTop +
      4, Height -
      2
    )
  );
  const ArchHeight: integer := Math.Max(3, (GateBottom - GateTop) div 3);
  const SideDistance: integer := Math.Abs(X - Center);
  const TorchY: integer := (GateTop + ArchHeight) +
    Math.Max(1, (GateBottom - (GateTop + ArchHeight)) div 3);
  const TorchDistance: integer := GateHalfWidth + 2;
  if (SideDistance = TorchDistance) and ((Y = TorchY - 1) or (Y = TorchY)) then
    begin
      return StyledCell('*', 255, 177, 61, 48, 34, 24);
    end;
  end if;

  if (SideDistance = TorchDistance) and (Y = TorchY + 1) then
    begin
      return StyledCell('|', 139, 91, 47, 29, 30, 35);
    end;
  end if;

  if (Y >= GateTop) and (Y <= GateBottom) then
    begin
      var OpeningHalfWidth: integer := GateHalfWidth;
      if Y < GateTop + ArchHeight then
        begin
          OpeningHalfWidth := (GateHalfWidth * (Y - GateTop)) div ArchHeight;
        end;
      end if;

      if (SideDistance >= OpeningHalfWidth) and (SideDistance <= OpeningHalfWidth + 2) then
        begin
          return GateStoneCell(X, Y);
        end;
      end if;

      if SideDistance < OpeningHalfWidth then
        begin
          return StyledCell(' ', 5, 7, 10, 5, 7, 10);
        end;
      end if;
    end;
  end if;

  if (Width >= 56) and (Height >= 18) then
    begin
      const TreeHeight: integer := Math.Clamp(Height div 3, 5, 10);
      case TreeCell(X, Y, Width div 8, Horizon + 3, TreeHeight) of
        when Some(const Cell):
          begin
            return Cell;
          end;
        when None:
          begin
            null;
          end;
      end case;

      case TreeCell(X, Y, (Width * 7) div 8, Horizon + 3, TreeHeight) of
        when Some(const Cell):
          begin
            return Cell;
          end;
        when None:
          begin
            null;
          end;
      end case;
    end;
  end if;

  if Y >= GateBottom then
    begin
      const RemainingHeight: integer := Math.Max(1, Height - GateBottom);
      const MaximumPathHalfWidth: integer := Math.Max(GateHalfWidth, (Width * 2) div 5);
      const PathHalfWidth: integer := GateHalfWidth +
        (((Y - GateBottom) * (MaximumPathHalfWidth - GateHalfWidth)) div RemainingHeight);
      if SideDistance <= PathHalfWidth then
        begin
          return PathCell(X, Y);
        end;
      end if;
    end;
  end if;

  if Y >= Horizon then
    begin
      return GroundCell(X, Y);
    end;
  end if;

  if Y >= MountainSurface(X, Width, Horizon) then
    begin
      return MountainCell(X, Y, Width, Horizon);
    end;
  end if;

  return SkyCell(X, Y);
end function;

// Builds the full-screen background for the start, connection, and session-selection states.
public function StartBackdropGrid(Width: integer; Height: integer): Tui.TuiCellGrid;
begin
  const SafeWidth: integer := Math.Max(0, Width);
  const SafeHeight: integer := Math.Max(0, Height);
  var Cells: array of Tui.TuiCell := [];
  for Y: integer := 0 to SafeHeight - 1 do
    begin
      for X: integer := 0 to SafeWidth - 1 do
        begin
          Cells.PushInPlace(BackdropCell(X, Y, SafeWidth, SafeHeight));
        end;
      end for;
    end;
  end for;

  return Tui.TuiCellGrid.Create(SafeWidth, SafeHeight, Cells);
end function;

// Prepares size-dependent artwork in the update path; gameplay and unchanged sizes reuse it.
public function PrepareStartBackdrop(State: Model.ClientModel): Model.ClientModel;
begin
  if State.Screen <> Model.ClientScreen.StartScreen then
    return State;
  end if;
  const Width: integer := Math.Max(0, State.ViewportWidth);
  const Height: integer := Math.Max(0, State.ViewportHeight);
  if (State.StartBackdrop.Width = Width) and (State.StartBackdrop.Height = Height) then
    return State;
  end if;

  return State with StartBackdrop := StartBackdropGrid(Width, Height); end with;
end function;

// Wraps cached artwork as a non-interactive layer; standalone unprepared models still render.
public function ViewStartBackdrop(State: Model.ClientModel): Tui.TuiElement;
begin
  const Prepared: Model.ClientModel := PrepareStartBackdrop(State);
  return Tui.TuiElementBuilders.MakeCellGrid(Prepared.StartBackdrop);
end function;
end unit;
