// Responsive colored ASCII backdrop for the client's pre-game screens.
unit Dungeon.Client.Ui.Backdrop;

uses Dungeon.Client.Model, Std.Arrays, Std.Math, Std.Tui;

function StyledCell(
  Glyph: string;
  ForegroundRed: integer;
  ForegroundGreen: integer;
  ForegroundBlue: integer;
  BackgroundRed: integer;
  BackgroundGreen: integer;
  BackgroundBlue: integer
): TuiCell;
begin
  return TuiCell.Styled(Glyph, TuiStyle.FromColors(TuiColor.FromRgb(ForegroundRed, ForegroundGreen, ForegroundBlue), TuiColor.FromRgb(BackgroundRed, BackgroundGreen, BackgroundBlue)));
end function;

function SkyCell(X: integer; Y: integer): TuiCell;
begin
  if ((X * 17) + (Y * 31)) mod 97 = 0 then
    begin
      return StyledCell('*', 148, 166, 196, 8, 12, 24);
    end;
  end if;

  if ((X * 29) + (Y * 13)) mod 149 = 0 then
    begin
      return StyledCell('.', 90, 108, 142, 8, 12, 24);
    end;
  end if;

  return StyledCell(' ', 8, 12, 24, 8, 12, 24);
end function;

function MountainSurface(X: integer; Width: integer; Horizon: integer): integer;
begin
  mutable var Surface: integer := Horizon;
  var Height: integer := Std.Math.Max(2, Horizon div 2);
  var LeftDistance: integer := Std.Math.Abs(X - (Width div 5));
  if LeftDistance < Height * 2 then
    begin
      Surface := Std.Math.Min(Surface, Horizon - (Height - (LeftDistance div 2)));
    end;
  end if;
  var RightDistance: integer := Std.Math.Abs(X - ((Width * 4) div 5));
  if RightDistance < Height * 2 then
    begin
      Surface := Std.Math.Min(Surface, Horizon - (Height - (RightDistance div 2)));
    end;
  end if;
  var DistantDistance: integer := Std.Math.Abs(X - (Width div 2));
  var DistantHeight: integer := Std.Math.Max(2, Height div 2);
  if DistantDistance < DistantHeight * 3 then
    begin
      Surface := Std.Math.Min(Surface, Horizon - (DistantHeight - (DistantDistance div 3)));
    end;
  end if;

  return Surface;
end function;

function MountainCell(X: integer; Y: integer; Width: integer; Horizon: integer): TuiCell;
begin
  var Surface: integer := MountainSurface(X, Width, Horizon);
  if Y = Surface then
    begin
      return StyledCell('^', 48, 57, 72, 14, 19, 31);
    end;
  end if;

  return StyledCell(' ', 31, 38, 49, 14, 19, 31);
end function;

function GroundCell(X: integer; Y: integer): TuiCell;
begin
  mutable var Glyph: string := ' ';
  if ((X * 11) + (Y * 7)) mod 17 = 0 then
    begin
      Glyph := ',';
    end;
  else
    if ((X * 5) + (Y * 13)) mod 23 = 0 then
      begin
        Glyph := '''';
      end;
    end if;
  end if;

  return StyledCell(Glyph, 49, 77, 50, 13, 23, 17);
end function;

function PathCell(X: integer; Y: integer): TuiCell;
begin
  mutable var Glyph: string := ' ';
  if ((X * 7) + (Y * 11)) mod 13 = 0 then
    begin
      Glyph := '.';
    end;
  end if;

  return StyledCell(Glyph, 76, 58, 43, 35, 27, 22);
end function;

function GateStoneCell(X: integer; Y: integer): TuiCell;
begin
  mutable var Glyph: string := '#';
  if ((X + (Y * 3)) mod 5) = 0 then
    begin
      Glyph := ':';
    end;
  end if;

  return StyledCell(Glyph, 105, 107, 112, 29, 30, 35);
end function;

function TreeCell(X: integer; Y: integer; Center: integer; Base: integer; TreeHeight: integer): option of TuiCell;
begin
  var Top: integer := Base - TreeHeight;
  if (Y >= Top) and (Y < Base - 1) then
    begin
      var HalfWidth: integer := ((Y - Top) div 2) + 1;
      if Std.Math.Abs(X - Center) <= HalfWidth then
        begin
          return Some(StyledCell('^', 38, 70, 42, 10, 21, 15));
        end;
      end if;
    end;
  end if;

  if ((Y >= Base - 1) and (Y <= Base)) and (X = Center) then
    begin
      return Some(StyledCell('|', 75, 58, 40, 13, 23, 17));
    end;
  end if;

  return None;
end function;

function BackdropCell(X: integer; Y: integer; Width: integer; Height: integer): TuiCell;
begin
  var Center: integer := Width div 2;
  var Horizon: integer := Std.Math.Clamp((Height * 2) div 5, 2, Std.Math.Max(2, Height - 3));
  var GateHalfWidth: integer := Std.Math.Clamp(Width div 7, 10, 22);
  var GateTop: integer := Std.Math.Max(1, Height div 6);
  var GateBottom: integer := Std.Math.Clamp((Height * 4) div 5, GateTop + 4, Std.Math.Max(GateTop +
                                                                                          4, Height -
                                                                                             2));
  var ArchHeight: integer := Std.Math.Max(3, (GateBottom - GateTop) div 3);
  var SideDistance: integer := Std.Math.Abs(X - Center);
  var TorchY: integer := (GateTop + ArchHeight) +
                         Std.Math.Max(1, (GateBottom - (GateTop + ArchHeight)) div 3);
  var TorchDistance: integer := GateHalfWidth + 2;
  if (SideDistance = TorchDistance) and ((Y = TorchY - 1) or (Y = TorchY)) then
    begin
      return StyledCell('*', 255, 177, 61, 48, 34, 24);
    end;
  end if;

  if (SideDistance = TorchDistance) and (Y = TorchY + 1) then
    begin
      return StyledCell('|', 139, 91, 47, 29, 30, 35);
    end;
  end if;

  if (Y >= GateTop) and (Y <= GateBottom) then
    begin
      mutable var OpeningHalfWidth: integer := GateHalfWidth;
      if Y < GateTop + ArchHeight then
        begin
          OpeningHalfWidth := (GateHalfWidth * (Y - GateTop)) div ArchHeight;
        end;
      end if;

      if (SideDistance >= OpeningHalfWidth) and (SideDistance <= OpeningHalfWidth + 2) then
        begin
          return GateStoneCell(X, Y);
        end;
      end if;

      if SideDistance < OpeningHalfWidth then
        begin
          return StyledCell(' ', 5, 7, 10, 5, 7, 10);
        end;
      end if;
    end;
  end if;

  if (Width >= 56) and (Height >= 18) then
    begin
      var TreeHeight: integer := Std.Math.Clamp(Height div 3, 5, 10);
      case TreeCell(X, Y, Width div 8, Horizon + 3, TreeHeight) of
        when Some(Cell):
          begin
            return Cell;
          end;
        when None:
          begin
            null;
          end;
      end case;

      case TreeCell(X, Y, (Width * 7) div 8, Horizon + 3, TreeHeight) of
        when Some(Cell):
          begin
            return Cell;
          end;
        when None:
          begin
            null;
          end;
      end case;
    end;
  end if;

  if Y >= GateBottom then
    begin
      var RemainingHeight: integer := Std.Math.Max(1, Height - GateBottom);
      var MaximumPathHalfWidth: integer := Std.Math.Max(GateHalfWidth, (Width * 2) div 5);
      var PathHalfWidth: integer := GateHalfWidth +
                                    (((Y - GateBottom) * (MaximumPathHalfWidth - GateHalfWidth)) div RemainingHeight);
      if SideDistance <= PathHalfWidth then
        begin
          return PathCell(X, Y);
        end;
      end if;
    end;
  end if;

  if Y >= Horizon then
    begin
      return GroundCell(X, Y);
    end;
  end if;

  if Y >= MountainSurface(X, Width, Horizon) then
    begin
      return MountainCell(X, Y, Width, Horizon);
    end;
  end if;

  return SkyCell(X, Y);
end function;

// Builds the full-screen background for the start, connection, and session-selection states.
public function StartBackdropGrid(Width: integer; Height: integer): TuiCellGrid;
begin
  var SafeWidth: integer := Std.Math.Max(0, Width);
  var SafeHeight: integer := Std.Math.Max(0, Height);
  mutable var Cells: array of TuiCell := [];
  for Y: integer := 0 to SafeHeight - 1 do
    begin
      for X: integer := 0 to SafeWidth - 1 do
        begin
          Std.Arrays.Push(Cells, BackdropCell(X, Y, SafeWidth, SafeHeight));
        end;
      end for;
    end;
  end for;

  return TuiCellGrid.Create(SafeWidth, SafeHeight, Cells);
end function;

// Prepares size-dependent artwork in the update path; gameplay and unchanged sizes reuse it.
public function PrepareStartBackdrop(State: ClientModel): ClientModel;
begin
  if State.Screen <> ClientScreen.StartScreen then
    return State;
  end if;
  var Width: integer := Std.Math.Max(0, State.ViewportWidth);
  var Height: integer := Std.Math.Max(0, State.ViewportHeight);
  if (State.StartBackdrop.Width = Width) and (State.StartBackdrop.Height = Height) then
    return State;
  end if;

  return State with StartBackdrop := StartBackdropGrid(Width, Height); end with;
end function;

// Wraps cached artwork as a non-interactive layer; standalone unprepared models still render.
public function ViewStartBackdrop(State: ClientModel): TuiElement;
begin
  var Prepared: ClientModel := PrepareStartBackdrop(State);
  return TuiElementBuilders.MakeCellGrid(Prepared.StartBackdrop);
end function;
end unit;
