// TCP session adapter between client intentions and model events.
unit Dungeon.Client.Network;

uses
  Dungeon.Client.Model, Dungeon.Protocol, Dungeon.Protocol.ClientMessages, Dungeon.Protocol.Worlds,
  Dungeon.Protocol.ServerMessages, Dungeon.Protocol.Transport, Std.Net, Std.Options, Std.Tasks;

type
  ServerRead = record
    Message: ServerMessage;
    Reader: LineReader;
  end record;

function Publish(Events: channel of ClientEvent; Value: ClientEvent; Token: CancellationToken): result of boolean, string;
begin
  return SendWithCancellation(Events, Value, Token);
end function;

function ReadServer(Reader: LineReader; Token: CancellationToken): result of ServerRead, string;
begin
  var ReadValue: LineRead := try ReadLine(Reader, Token);
  return Ok(record
    Message := try DecodeServer(ReadValue.Line);
    Reader := ReadValue.Reader;
  end);
end function;

// Returns whether a visible-state projection is a valid response to one request.
function AcceptsState(Request: ClientMessage): boolean;
begin
  case Request of
    when ClientMessage.CreateWorld(Seed, RegionChunks):
      begin
        return true;
      end;
    when ClientMessage.StartNewGame:
      begin
        return true;
      end;
    when ClientMessage.LoadGame:
      begin
        return true;
      end;
    when ClientMessage.Viewport(Width, Height):
      begin
        return true;
      end;
    when ClientMessage.Move(DeltaX, DeltaY):
      begin
        return true;
      end;
    when ClientMessage.StepFirstPerson(Direction):
      begin
        return true;
      end;
    when ClientMessage.TurnFirstPerson(Direction):
      begin
        return true;
      end;
    when ClientMessage.Interact:
      begin
        return true;
      end;
    when ClientMessage.Attack:
      begin
        return true;
      end;
    when ClientMessage.Wait:
      begin
        return true;
      end;
    when ClientMessage.Equip(ItemId):
      begin
        return true;
      end;
    when ClientMessage.Unequip(ItemId):
      begin
        return true;
      end;
    when ClientMessage.DropItem(ItemId):
      begin
        return true;
      end;
    else
      begin
        return false;
      end;
  end case;
end function;

// Returns whether a defeat can answer one request: only turn-consuming intentions end a game.
// Equipment changes and drops consume a turn, so the opponent can strike while the player handles gear.
function AcceptsDefeat(Request: ClientMessage): boolean;
begin
  case Request of
    when ClientMessage.StepFirstPerson(Direction):
      begin
        return true;
      end;
    when ClientMessage.Attack:
      begin
        return true;
      end;
    when ClientMessage.Wait:
      begin
        return true;
      end;
    when ClientMessage.Equip(ItemId):
      begin
        return true;
      end;
    when ClientMessage.Unequip(ItemId):
      begin
        return true;
      end;
    when ClientMessage.DropItem(ItemId):
      begin
        return true;
      end;
    else
      begin
        return false;
      end;
  end case;
end function;

// Maps one server response to its client event; None marks a response the request cannot produce.
function ResponseEvent(Request: ClientMessage; Response: ServerMessage): option of ClientEvent;
begin
  case Response of
    when ServerMessage.Worlds(Catalog):
      begin
        case Request of
          when ClientMessage.ListWorlds(Offset, DiscardProgress):
            begin
              return Some(ClientEvent.Worlds(Catalog));
            end;
          when ClientMessage.SelectWorld(Id):
            begin
              return Some(ClientEvent.Worlds(Catalog));
            end;
          else
            begin
              null;
            end;
        end case;
      end;
    when ServerMessage.State(Value):
      begin
        if AcceptsState(Request) then
          begin
            return Some(ClientEvent.State(Value));
          end;
        end if;
      end;
    when ServerMessage.ExplorationMap(Value):
      begin
        case Request of
          when ClientMessage.ExplorationMap(OriginX, OriginY, Width, Height):
            begin
              return Some(ClientEvent.ExplorationMap(Value));
            end;
          else
            begin
              null;
            end;
        end case;
      end;
    when ServerMessage.Interaction(Title, Message):
      begin
        case Request of
          when ClientMessage.Interact:
            begin
              return Some(ClientEvent.Interaction(Title, Message));
            end;
          else
            begin
              null;
            end;
        end case;
      end;
    when ServerMessage.Defeated(Message):
      begin
        if AcceptsDefeat(Request) then
          begin
            return Some(ClientEvent.Defeated(Message));
          end;
        end if;
      end;
    when ServerMessage.SaveCompleted:
      begin
        case Request of
          when ClientMessage.SaveGame, ClientMessage.OverwriteSaveGame:
            begin
              return Some(ClientEvent.SaveCompleted);
            end;
          else
            begin
              null;
            end;
        end case;
      end;
    when ServerMessage.Rejected(Code, Message):
      begin
        case Request of
          when ClientMessage.ExplorationMap(OriginX, OriginY, Width, Height):
            begin
              return Some(ClientEvent.MapRejected(Code, Message));
            end;
          else
            begin
              return Some(ClientEvent.Rejected(Code, Message));
            end;
        end case;
      end;
    else
      begin
        null;
      end;
  end case;

  return None;
end function;

function RunNetworkSession(
  Host: string;
  Port: integer;
  ViewWidth: integer;
  ViewHeight: integer;
  Requests: channel of ClientMessage;
  Events: channel of ClientEvent;
  Token: CancellationToken
): result of boolean, string;
begin
  var ConnectionValue: Connection := try ConnectWithCancellation(Host, Port, 5000, Token);
  mutable var Reader: LineReader := NewLineReader(ConnectionValue);
  mutable var Catalog: WorldCatalog := EmptyWorldCatalog(12345, 4);
  var HelloSent: boolean := try WriteLine(ConnectionValue, EncodeClient(ClientMessage.Hello(ProtocolVersion, ViewWidth, ViewHeight)), Token);
  case ReadServer(Reader, Token) of
    when Error(Message):
      begin
        var Closed: boolean := try Close(ConnectionValue);
        return Error(Message);
      end;
    when Ok(ReadValue):
      begin
        Reader := ReadValue.Reader;
        case ReadValue.Message of
          when ServerMessage.Welcome(Version, Available):
            begin
              if Version <> ProtocolVersion then
                begin
                  var Closed: boolean := try Close(ConnectionValue);
                  return Error('server selected an unsupported protocol version');
                end;
              else
                begin
                  Catalog := Available;
                end;
              end if;
            end;
          when ServerMessage.Rejected(Code, Message):
            // The server rejects the session before Welcome when world data is unusable, then closes.
            begin
              var Published: boolean := try Publish(Events, ClientEvent.Failed(Message), Token);
              var Closed: boolean := try Close(ConnectionValue);
              return Ok(true);
            end;
          else
            begin
              var Closed: boolean := try Close(ConnectionValue);
              return Error('server did not welcome the client');
            end;
        end case;
      end;
  end case;
  var Published: boolean := try Publish(Events, ClientEvent.Connected(Catalog), Token);
  while not IsCancellationRequested(Token) do
    begin
      case ReceiveWithCancellation(Requests, Token) of
        when Error(Message):
          begin
            var Closed: boolean := try Close(ConnectionValue);
            return Ok(true);
          end;
        when Ok(Request):
          begin
            case Request of
              when ClientMessage.Hello(Version, Width, Height):
                begin
                  var Closed: boolean := try Close(ConnectionValue);
                  return Error('hello can only be sent during connection setup');
                end;
              when ClientMessage.Disconnect:
                begin
                  var Written: boolean := try WriteLine(ConnectionValue, EncodeClient(Request), Token);
                  var Closed: boolean := try Close(ConnectionValue);
                  return Ok(true);
                end;
              else
                begin
                  null;
                end;
            end case;
            var Written: boolean := try WriteLine(ConnectionValue, EncodeClient(Request), Token);
            // Every remaining request receives exactly one server response.
            case ReadServer(Reader, Token) of
              when Error(Message):
                begin
                  var Closed: boolean := try Close(ConnectionValue);
                  return Error(Message);
                end;
              when Ok(ReadValue):
                begin
                  Reader := ReadValue.Reader;
                  case ReadValue.Message of
                    when ServerMessage.ErrorMessage(Code, Message):
                      begin
                        var Sent: boolean := try Publish(Events, ClientEvent.Failed(Message), Token);
                        var Closed: boolean := try Close(ConnectionValue);
                        return Ok(true);
                      end;
                    else
                      begin
                        case ResponseEvent(Request, ReadValue.Message) of
                          when Some(ResponseValue):
                            begin
                              var Sent: boolean := try Publish(Events, ResponseValue, Token);
                            end;
                          when None:
                            begin
                              var Closed: boolean := try Close(ConnectionValue);
                              return Error('unexpected server response');
                            end;
                        end case;
                      end;
                  end case;
                end;
            end case;
          end;
      end case;
    end;
  end while;
  var Closed: boolean := try Close(ConnectionValue);
  return Ok(true);
end function;

// Owns one connection and treats host-requested cancellation as normal shutdown.
public function RunNetwork(
  Host: string;
  Port: integer;
  ViewWidth: integer;
  ViewHeight: integer;
  Requests: channel of ClientMessage;
  Events: channel of ClientEvent;
  Token: CancellationToken
): result of boolean, string;
begin
  case RunNetworkSession(Host, Port, ViewWidth, ViewHeight, Requests, Events, Token) of
    when Ok(Completed):
      begin
        return Ok(Completed);
      end;
    when Error(Message):
      begin
        if IsCancellationRequested(Token) then
          begin
            return Ok(true);
          end;
        end if;

        return Error(Message);
      end;
  end case;
end function;
end unit;
