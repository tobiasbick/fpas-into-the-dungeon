// TCP session adapter between client intentions and model events.
unit Dungeon.Client.Network;

uses Dungeon.Client.Model as Model, Dungeon.Protocol as Protocol, Dungeon.Protocol.ClientMessages as ClientMessages, Dungeon.Protocol.Worlds as WorldsUnit, Dungeon.Protocol.ServerMessages as ServerMessages, Dungeon.Protocol.Transport as Transport, Std.Net as Net, Std.Tasks as Tasks;

// Renders typed library failures at this unit's application-owned text boundary.
function FailureMessage<E: Error>(Cause: E): string;
begin
  return Cause.Message();
end function;

type ServerRead = record
  Message: Protocol.ServerMessage;
  Reader: Transport.LineReader;
end record;

// A published failure must remain the last event of its connection attempt.
type SessionEnd = enum
  Disconnected;
  FailurePublished;
end enum;

// Publishes one session event; an ordinary publication error ends that session.
public type EventPublisher = function(Value: Model.ClientEvent): result of (boolean, string);

function ReadServer(Reader: Transport.LineReader; Token: Tasks.CancellationToken): result of (ServerRead, string);
begin
  const ReadValue: Transport.LineRead := try Transport.ReadLine(Reader, Token);
  return Ok(
    ServerRead(
      Message := try ServerMessages.DecodeServer(ReadValue.Line),
      Reader := ReadValue.Reader
    )
  );
end function;

// Returns whether a visible-state projection is a valid response to one request.
function AcceptsState(Request: Protocol.ClientMessage): boolean;
begin
  case Request of
    when Protocol.ClientMessage.CreateWorld(const Seed, const RegionChunks):
      begin
        return true;
      end;
    when Protocol.ClientMessage.StartNewGame:
      begin
        return true;
      end;
    when Protocol.ClientMessage.LoadGame:
      begin
        return true;
      end;
    when Protocol.ClientMessage.Viewport(const Width, const Height):
      begin
        return true;
      end;
    when Protocol.ClientMessage.Move(const DeltaX, const DeltaY):
      begin
        return true;
      end;
    when Protocol.ClientMessage.StepFirstPerson(const Direction):
      begin
        return true;
      end;
    when Protocol.ClientMessage.TurnFirstPerson(const Direction):
      begin
        return true;
      end;
    when Protocol.ClientMessage.Interact:
      begin
        return true;
      end;
    when Protocol.ClientMessage.Attack:
      begin
        return true;
      end;
    when Protocol.ClientMessage.Wait:
      begin
        return true;
      end;
    when Protocol.ClientMessage.Equip(const ItemId):
      begin
        return true;
      end;
    when Protocol.ClientMessage.Unequip(const ItemId):
      begin
        return true;
      end;
    when Protocol.ClientMessage.UseItem(_):
      return true;
    when Protocol.ClientMessage.DropItem(const ItemId):
      begin
        return true;
      end;
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Disconnect:
      begin
        return false;
      end;
  end case;
end function;

// Returns whether a defeat can answer one request: only turn-consuming intentions end a game.
// Equipment changes and drops consume a turn, so the opponent can strike while the player handles gear.
function AcceptsDefeat(Request: Protocol.ClientMessage): boolean;
begin
  case Request of
    when Protocol.ClientMessage.StepFirstPerson(const Direction):
      begin
        return true;
      end;
    when Protocol.ClientMessage.Attack:
      begin
        return true;
      end;
    when Protocol.ClientMessage.Wait:
      begin
        return true;
      end;
    when Protocol.ClientMessage.Equip(const ItemId):
      begin
        return true;
      end;
    when Protocol.ClientMessage.Unequip(const ItemId):
      begin
        return true;
      end;
    when Protocol.ClientMessage.UseItem(_):
      return true;
    when Protocol.ClientMessage.DropItem(const ItemId):
      begin
        return true;
      end;
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Disconnect:
      begin
        return false;
      end;
  end case;
end function;

// Maps one server response to its client event; None marks a response the request cannot produce.
function ResponseEvent(Request: Protocol.ClientMessage; Response: Protocol.ServerMessage): option of Model.ClientEvent;
begin
  case Response of
    when Protocol.ServerMessage.Dialogue(const Value, const Frame, const Dirty):
      if (Request is Protocol.ClientMessage.Interact)
        or
        (Request is Protocol.ClientMessage.DialogueChoice(_, _))
      then
        return Some(Model.ClientEvent.Dialogue(Value, Frame, Dirty));
      end if;
    when Protocol.ServerMessage.DialogueEnded(const Value, const Dirty):
      if (Request is Protocol.ClientMessage.EndDialogue)
        or
        (Request is Protocol.ClientMessage.DialogueChoice(_, _))
      then
        return Some(Model.ClientEvent.DialogueEnded(Value, Dirty));
      end if;
    when Protocol.ServerMessage.Worlds(const Catalog):
      begin
        case Request of
          when Protocol.ClientMessage.ListWorlds(const Offset, const DiscardProgress):
            begin
              return Some(Model.ClientEvent.Worlds(Catalog));
            end;
          when Protocol.ClientMessage.SelectWorld(const Id):
            begin
              return Some(Model.ClientEvent.Worlds(Catalog));
            end;
          when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
            begin
              null;
            end;
        end case;
      end;
    when Protocol.ServerMessage.State(const Value):
      begin
        if AcceptsState(Request) then
          begin
            if Request is Protocol.ClientMessage.Viewport(_, _) then
              return Some(Model.ClientEvent.ViewportState(Value));
            end if;

            return Some(Model.ClientEvent.State(Value));
          end;
        end if;
      end;
    when Protocol.ServerMessage.ExplorationMap(const Value):
      begin
        case Request of
          when Protocol.ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height):
            return Some(Model.ClientEvent.ExplorationMap(Value));
          when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
            null;
        end case;
      end;
    when Protocol.ServerMessage.Interaction(const Title, const Message):
      begin
        if Request is Protocol.ClientMessage.Interact then
          begin
            return Some(Model.ClientEvent.Interaction(Title, Message));
          end;
        else
          begin
            null;
          end;
        end if;
      end;
    when Protocol.ServerMessage.Defeated(const Message):
      begin
        if AcceptsDefeat(Request) then
          begin
            return Some(Model.ClientEvent.Defeated(Message));
          end;
        end if;
      end;
    when Protocol.ServerMessage.SaveCompleted:
      begin
        case Request of
          when Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame:
            begin
              return Some(Model.ClientEvent.SaveCompleted);
            end;
          when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
            begin
              null;
            end;
        end case;
      end;
    when Protocol.ServerMessage.Rejected(const Code, const Message):
      begin
        case Request of
          when Protocol.ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height):
            return Some(Model.ClientEvent.MapRejected(Code, Message));
          when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
            return Some(Model.ClientEvent.Rejected(Code, Message));
        end case;
      end;
    when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
      begin
        null;
      end;
  end case;

  return None;
end function;

function Exchange(
  ConnectionValue: Net.Connection;
  ViewWidth: integer;
  ViewHeight: integer;
  Requests: channel of Protocol.ClientMessage;
  PublishEvent: EventPublisher;
  Token: Tasks.CancellationToken
): result of (SessionEnd, string);
begin
  var Reader: Transport.LineReader := Transport.NewLineReader(ConnectionValue);
  var Catalog: Protocol.WorldCatalog := WorldsUnit.EmptyWorldCatalog(12345, 4);
  const HelloSent: boolean := try Transport.WriteLine(
    ConnectionValue,
    ClientMessages.EncodeClient(
      Protocol.ClientMessage.Hello(Protocol.ProtocolVersion, ViewWidth, ViewHeight)
    ),
    Token
  );
  case ReadServer(Reader, Token) of
    when Error(const Message):
      begin
        return Error(Message);
      end;
    when Ok(const ReadValue):
      begin
        Reader := ReadValue.Reader;
        case ReadValue.Message of
          when Protocol.ServerMessage.Welcome(const Version, const Available):
            begin
              if Version <> Protocol.ProtocolVersion then
                begin
                  return Error('server selected an unsupported protocol version');
                end;
              else
                begin
                  Catalog := Available;
                end;
              end if;
            end;
          when Protocol.ServerMessage.Rejected(const Code, const Message):
            // The server rejects the session before Welcome when world data is unusable, then closes.
            begin
              const Published: boolean := try PublishEvent(Model.ClientEvent.Failed(Message));

              return Ok(SessionEnd.FailurePublished);
            end;
          when Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
            begin
              return Error('server did not welcome the client');
            end;
        end case;
      end;
  end case;
  const Published: boolean := try PublishEvent(Model.ClientEvent.Connected(Catalog));
  while not Tasks.IsCancellationRequested(Token) do
    begin
      case Tasks.ReceiveWithCancellation(Requests, Token) of
        when Error(const Message):
          begin
            return Ok(SessionEnd.Disconnected);
          end;
        when Ok(const Request):
          begin
            case Request of
              when Protocol.ClientMessage.Hello(const Version, const Width, const Height):
                begin
                  return Error('hello can only be sent during connection setup');
                end;
              when Protocol.ClientMessage.Disconnect:
                begin
                  const Written: boolean := try Transport.WriteLine(
                    ConnectionValue,
                    ClientMessages.EncodeClient(Request),
                    Token
                  );

                  return Ok(SessionEnd.Disconnected);
                end;
              when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_):
                begin
                  null;
                end;
            end case;
            const Written: boolean := try Transport.WriteLine(
              ConnectionValue,
              ClientMessages.EncodeClient(Request),
              Token
            );
            // Every remaining request receives exactly one server response.
            case ReadServer(Reader, Token) of
              when Error(const Message):
                begin
                  return Error(Message);
                end;
              when Ok(const ReadValue):
                begin
                  Reader := ReadValue.Reader;
                  case ReadValue.Message of
                    when Protocol.ServerMessage.ErrorMessage(const Code, const Message):
                      const Sent: boolean := try PublishEvent(Model.ClientEvent.Failed(Message));

                      return Ok(SessionEnd.FailurePublished);
                    when Protocol.ServerMessage.Dialogue(_, _, _), Protocol.ServerMessage.DialogueEnded(_, _), Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _):
                      case ResponseEvent(Request, ReadValue.Message) of
                        when Some(const ResponseValue):
                          begin
                            const Sent: boolean := try PublishEvent(ResponseValue);
                          end;
                        when None:
                          begin
                            return Error('unexpected server response');
                          end;
                      end case;
                  end case;
                end;
            end case;
          end;
      end case;
    end;
  end while;

  return Ok(SessionEnd.Disconnected);
end function;

// Takes ownership of an already connected socket and closes it after every ordinary outcome.
// A session error takes precedence if closing also fails; unexpected diagnostics still propagate.
// Only non-cancelled normal completion publishes Disconnected, after successful closure.
// A prior Failed event remains terminal. The caller relinquishes the handle until return.
public function RunConnection(
  ConnectionValue: Net.Connection;
  ViewWidth: integer;
  ViewHeight: integer;
  Requests: channel of Protocol.ClientMessage;
  PublishEvent: EventPublisher;
  Token: Tasks.CancellationToken
): result of (boolean, string);
begin
  const Outcome := Exchange(ConnectionValue, ViewWidth, ViewHeight, Requests, PublishEvent, Token);
  const Closed := Net.Close(ConnectionValue);
  case Outcome of
    when Error(const Reason):
      return Error(Reason);
    when Ok(const EndReason):
      const Released := try Closed.MapError(FailureMessage);
      if (EndReason = SessionEnd.Disconnected) and not Tasks.IsCancellationRequested(Token) then
        const Published := try PublishEvent(Model.ClientEvent.Disconnected);
      end if;

      return Ok(true);
  end case;
end function;

// Connects one attempt and publishes through its caller-owned sink, with cooperative cancellation.
// The connection owner always closes before cancellation is normalized to successful shutdown.
public function RunNetworkPublishing(
  Host: string;
  Port: integer;
  ViewWidth: integer;
  ViewHeight: integer;
  Requests: channel of Protocol.ClientMessage;
  PublishEvent: EventPublisher;
  Token: Tasks.CancellationToken
): result of (boolean, string);
begin
  case Net.ConnectWithCancellation(Host, Port, 5000, Token) of
    when Error(const Reason):
      if Tasks.IsCancellationRequested(Token) then
        return Ok(true);
      end if;

      return Error(Reason.Message());
    when Ok(const ConnectionValue):
      const Outcome := RunConnection(
        ConnectionValue,
        ViewWidth,
        ViewHeight,
        Requests,
        PublishEvent,
        Token
      );
      if Tasks.IsCancellationRequested(Token) then
        return Ok(true);
      end if;

      return Outcome;
  end case;
end function;

// Runs one caller-orchestrated session with raw events; callers own both channels.
// Treats host cancellation as normal shutdown after the connected socket has closed.
public function RunNetwork(
  Host: string;
  Port: integer;
  ViewWidth: integer;
  ViewHeight: integer;
  Requests: channel of Protocol.ClientMessage;
  Events: channel of Model.ClientEvent;
  Token: Tasks.CancellationToken
): result of (boolean, string);
begin
  return RunNetworkPublishing(
    Host, Port, ViewWidth, ViewHeight, Requests,
    function(Value: Model.ClientEvent): result of (boolean, string) begin
      return Tasks.SendWithCancellation(Events, Value, Token).MapError(FailureMessage);
    end function,
    Token
  );
end function;
end unit;
