// TCP session adapter between client intentions and model events.
unit Dungeon.Client.Network;

uses
  Dungeon.Client.Model, Dungeon.Protocol, Dungeon.Protocol.ClientMessages, Dungeon.Protocol.Worlds,
  Dungeon.Protocol.ServerMessages, Dungeon.Protocol.Transport, Std.Net, Std.Tasks;

type ServerRead = record
  Message: ServerMessage;
  Reader: LineReader;
end record;

function Publish(Events: channel of ClientEvent; Value: ClientEvent; Token: CancellationToken): result of (boolean, string);
begin
  return SendWithCancellation(Events, Value, Token);
end function;

function ReadServer(Reader: LineReader; Token: CancellationToken): result of (ServerRead, string);
begin
  const ReadValue: LineRead := try ReadLine(Reader, Token);
  return Ok(ServerRead(Message := try DecodeServer(ReadValue.Line), Reader := ReadValue.Reader));
end function;

// Returns whether a visible-state projection is a valid response to one request.
function AcceptsState(Request: ClientMessage): boolean;
begin
  case Request of
    when ClientMessage.CreateWorld(const Seed, const RegionChunks):
      begin
        return true;
      end;
    when ClientMessage.StartNewGame:
      begin
        return true;
      end;
    when ClientMessage.LoadGame:
      begin
        return true;
      end;
    when ClientMessage.Viewport(const Width, const Height):
      begin
        return true;
      end;
    when ClientMessage.Move(const DeltaX, const DeltaY):
      begin
        return true;
      end;
    when ClientMessage.StepFirstPerson(const Direction):
      begin
        return true;
      end;
    when ClientMessage.TurnFirstPerson(const Direction):
      begin
        return true;
      end;
    when ClientMessage.Interact:
      begin
        return true;
      end;
    when ClientMessage.Attack:
      begin
        return true;
      end;
    when ClientMessage.Wait:
      begin
        return true;
      end;
    when ClientMessage.Equip(const ItemId):
      begin
        return true;
      end;
    when ClientMessage.Unequip(const ItemId):
      begin
        return true;
      end;
    when ClientMessage.DropItem(const ItemId):
      begin
        return true;
      end;
    when clientmessage.Hello(_, _, _), clientmessage.SaveGame, clientmessage.OverwriteSaveGame, clientmessage.ListWorlds(_, _), clientmessage.SelectWorld(_), clientmessage.ExplorationMap(_, _, _, _), clientmessage.Disconnect:
      begin
        return false;
      end;
  end case;
end function;

// Returns whether a defeat can answer one request: only turn-consuming intentions end a game.
// Equipment changes and drops consume a turn, so the opponent can strike while the player handles gear.
function AcceptsDefeat(Request: ClientMessage): boolean;
begin
  case Request of
    when ClientMessage.StepFirstPerson(const Direction):
      begin
        return true;
      end;
    when ClientMessage.Attack:
      begin
        return true;
      end;
    when ClientMessage.Wait:
      begin
        return true;
      end;
    when ClientMessage.Equip(const ItemId):
      begin
        return true;
      end;
    when ClientMessage.Unequip(const ItemId):
      begin
        return true;
      end;
    when ClientMessage.DropItem(const ItemId):
      begin
        return true;
      end;
    when clientmessage.Hello(_, _, _), clientmessage.StartNewGame, clientmessage.LoadGame, clientmessage.SaveGame, clientmessage.OverwriteSaveGame, clientmessage.ListWorlds(_, _), clientmessage.SelectWorld(_), clientmessage.CreateWorld(_, _), clientmessage.Viewport(_, _), clientmessage.ExplorationMap(_, _, _, _), clientmessage.Move(_, _), clientmessage.TurnFirstPerson(_), clientmessage.Interact, clientmessage.Disconnect:
      begin
        return false;
      end;
  end case;
end function;

// Maps one server response to its client event; None marks a response the request cannot produce.
function ResponseEvent(Request: ClientMessage; Response: ServerMessage): option of ClientEvent;
begin
  case Response of
    when ServerMessage.Worlds(const Catalog):
      begin
        case Request of
          when ClientMessage.ListWorlds(const Offset, const DiscardProgress):
            begin
              return Some(ClientEvent.Worlds(Catalog));
            end;
          when ClientMessage.SelectWorld(const Id):
            begin
              return Some(ClientEvent.Worlds(Catalog));
            end;
          when clientmessage.Hello(_, _, _), clientmessage.StartNewGame, clientmessage.LoadGame, clientmessage.SaveGame, clientmessage.OverwriteSaveGame, clientmessage.CreateWorld(_, _), clientmessage.Viewport(_, _), clientmessage.ExplorationMap(_, _, _, _), clientmessage.Move(_, _), clientmessage.StepFirstPerson(_), clientmessage.TurnFirstPerson(_), clientmessage.Interact, clientmessage.Attack, clientmessage.Wait, clientmessage.Equip(_), clientmessage.Unequip(_), clientmessage.DropItem(_), clientmessage.Disconnect:
            begin
              null;
            end;
        end case;
      end;
    when ServerMessage.State(const Value):
      begin
        if AcceptsState(Request) then
          begin
            return Some(ClientEvent.State(Value));
          end;
        end if;
      end;
    when ServerMessage.ExplorationMap(const Value):
      begin
        if Request is ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height) then
          begin
            return Some(ClientEvent.ExplorationMap(Value));
          end;
        else
          begin
            null;
          end;
        end if;
      end;
    when ServerMessage.Interaction(const Title, const Message):
      begin
        if Request is ClientMessage.Interact then
          begin
            return Some(ClientEvent.Interaction(Title, Message));
          end;
        else
          begin
            null;
          end;
        end if;
      end;
    when ServerMessage.Defeated(const Message):
      begin
        if AcceptsDefeat(Request) then
          begin
            return Some(ClientEvent.Defeated(Message));
          end;
        end if;
      end;
    when ServerMessage.SaveCompleted:
      begin
        case Request of
          when ClientMessage.SaveGame, ClientMessage.OverwriteSaveGame:
            begin
              return Some(ClientEvent.SaveCompleted);
            end;
          when clientmessage.Hello(_, _, _), clientmessage.StartNewGame, clientmessage.LoadGame, clientmessage.ListWorlds(_, _), clientmessage.SelectWorld(_), clientmessage.CreateWorld(_, _), clientmessage.Viewport(_, _), clientmessage.ExplorationMap(_, _, _, _), clientmessage.Move(_, _), clientmessage.StepFirstPerson(_), clientmessage.TurnFirstPerson(_), clientmessage.Interact, clientmessage.Attack, clientmessage.Wait, clientmessage.Equip(_), clientmessage.Unequip(_), clientmessage.DropItem(_), clientmessage.Disconnect:
            begin
              null;
            end;
        end case;
      end;
    when ServerMessage.Rejected(const Code, const Message):
      begin
        if Request is ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height) then
          begin
            return Some(ClientEvent.MapRejected(Code, Message));
          end;
        else
          begin
            return Some(ClientEvent.Rejected(Code, Message));
          end;
        end if;
      end;
    when servermessage.Welcome(_, _), servermessage.ErrorMessage(_, _):
      begin
        null;
      end;
  end case;

  return None;
end function;

function RunNetworkSession(
  Host: string;
  Port: integer;
  ViewWidth: integer;
  ViewHeight: integer;
  Requests: channel of ClientMessage;
  Events: channel of ClientEvent;
  Token: CancellationToken
): result of (boolean, string);
begin
  const ConnectionValue: Connection := try ConnectWithCancellation(Host, Port, 5000, Token);
  var Reader: LineReader := NewLineReader(ConnectionValue);
  var Catalog: WorldCatalog := EmptyWorldCatalog(12345, 4);
  const HelloSent: boolean := try WriteLine(ConnectionValue, EncodeClient(ClientMessage.Hello(ProtocolVersion, ViewWidth, ViewHeight)), Token);
  case ReadServer(Reader, Token) of
    when Error(const Message):
      begin
        const Closed: boolean := try Close(ConnectionValue);
        return Error(Message);
      end;
    when Ok(const ReadValue):
      begin
        Reader := ReadValue.Reader;
        case ReadValue.Message of
          when ServerMessage.Welcome(const Version, const Available):
            begin
              if Version <> ProtocolVersion then
                begin
                  const Closed: boolean := try Close(ConnectionValue);
                  return Error('server selected an unsupported protocol version');
                end;
              else
                begin
                  Catalog := Available;
                end;
              end if;
            end;
          when ServerMessage.Rejected(const Code, const Message):
            // The server rejects the session before Welcome when world data is unusable, then closes.
            begin
              const Published: boolean := try Publish(Events, ClientEvent.Failed(Message), Token);
              const Closed: boolean := try Close(ConnectionValue);
              return Ok(true);
            end;
          when servermessage.Worlds(_), servermessage.State(_), servermessage.ExplorationMap(_), servermessage.Interaction(_, _), servermessage.SaveCompleted, servermessage.Defeated(_), servermessage.ErrorMessage(_, _):
            begin
              const Closed: boolean := try Close(ConnectionValue);
              return Error('server did not welcome the client');
            end;
        end case;
      end;
  end case;
  const Published: boolean := try Publish(Events, ClientEvent.Connected(Catalog), Token);
  while not IsCancellationRequested(Token) do
    begin
      case ReceiveWithCancellation(Requests, Token) of
        when Error(const Message):
          begin
            const Closed: boolean := try Close(ConnectionValue);
            return Ok(true);
          end;
        when Ok(const Request):
          begin
            case Request of
              when ClientMessage.Hello(const Version, const Width, const Height):
                begin
                  const Closed: boolean := try Close(ConnectionValue);
                  return Error('hello can only be sent during connection setup');
                end;
              when ClientMessage.Disconnect:
                begin
                  const Written: boolean := try WriteLine(ConnectionValue, EncodeClient(Request), Token);
                  const Closed: boolean := try Close(ConnectionValue);
                  return Ok(true);
                end;
              when clientmessage.StartNewGame, clientmessage.LoadGame, clientmessage.SaveGame, clientmessage.OverwriteSaveGame, clientmessage.ListWorlds(_, _), clientmessage.SelectWorld(_), clientmessage.CreateWorld(_, _), clientmessage.Viewport(_, _), clientmessage.ExplorationMap(_, _, _, _), clientmessage.Move(_, _), clientmessage.StepFirstPerson(_), clientmessage.TurnFirstPerson(_), clientmessage.Interact, clientmessage.Attack, clientmessage.Wait, clientmessage.Equip(_), clientmessage.Unequip(_), clientmessage.DropItem(_):
                begin
                  null;
                end;
            end case;
            const Written: boolean := try WriteLine(ConnectionValue, EncodeClient(Request), Token);
            // Every remaining request receives exactly one server response.
            case ReadServer(Reader, Token) of
              when Error(const Message):
                begin
                  const Closed: boolean := try Close(ConnectionValue);
                  return Error(Message);
                end;
              when Ok(const ReadValue):
                begin
                  Reader := ReadValue.Reader;
                  if ReadValue.Message is ServerMessage.ErrorMessage(const Code, const Message) then
                    begin
                      const Sent: boolean := try Publish(Events, ClientEvent.Failed(Message), Token);
                      const Closed: boolean := try Close(ConnectionValue);
                      return Ok(true);
                    end;
                  else
                    begin
                      case ResponseEvent(Request, ReadValue.Message) of
                        when Some(const ResponseValue):
                          begin
                            const Sent: boolean := try Publish(Events, ResponseValue, Token);
                          end;
                        when None:
                          begin
                            const Closed: boolean := try Close(ConnectionValue);
                            return Error('unexpected server response');
                          end;
                      end case;
                    end;
                  end if;
                end;
            end case;
          end;
      end case;
    end;
  end while;
  const Closed: boolean := try Close(ConnectionValue);
  return Ok(true);
end function;

// Owns one connection and treats host-requested cancellation as normal shutdown.
public function RunNetwork(
  Host: string;
  Port: integer;
  ViewWidth: integer;
  ViewHeight: integer;
  Requests: channel of ClientMessage;
  Events: channel of ClientEvent;
  Token: CancellationToken
): result of (boolean, string);
begin
  case RunNetworkSession(Host, Port, ViewWidth, ViewHeight, Requests, Events, Token) of
    when Ok(const Completed):
      begin
        return Ok(Completed);
      end;
    when Error(const Message):
      begin
        if IsCancellationRequested(Token) then
          begin
            return Ok(true);
          end;
        end if;

        return Error(Message);
      end;
  end case;
end function;
end unit;
