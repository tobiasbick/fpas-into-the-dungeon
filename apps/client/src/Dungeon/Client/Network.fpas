// TCP session adapter between client intentions and model events.
unit Dungeon.Client.Network;

uses
  Dungeon.Client.Model, Dungeon.Protocol, Dungeon.Protocol.Transport, Std.Net, Std.Options,
  Std.Task;

type
  ServerRead = record
    Message: ServerMessage;
    Reader: LineReader;
  end;

function Publish(Events: channel of ClientEvent; Value: ClientEvent; Token: CancellationToken): result of boolean, string;
begin
  return SendWithCancellation(Events, Value, Token)
end;

function ReadServer(Reader: LineReader; Token: CancellationToken): result of ServerRead, string;
begin
  var ReadValue: LineRead := try ReadLine(Reader, Token);
  return Ok(record
    Message := try DecodeServer(ReadValue.Line);
    Reader := ReadValue.Reader;
  end)
end;

// Returns whether a visible-state projection is a valid response to one request.
function AcceptsState(Request: ClientMessage): boolean;
begin
  case Request of
    ClientMessage.StartNewGame:
    begin
      return true
    end;
    ClientMessage.LoadGame:
    begin
      return true
    end;
    ClientMessage.Viewport(Width, Height):
    begin
      return true
    end;
    ClientMessage.Move(DeltaX, DeltaY):
    begin
      return true
    end;
    ClientMessage.StepFirstPerson(Direction):
    begin
      return true
    end;
    ClientMessage.TurnFirstPerson(Direction):
    begin
      return true
    end;
    ClientMessage.Interact:
    begin
      return true
    end
    else
    begin
      return false
    end
  end
end;

// Returns whether a dialogue frame is a valid response to one request.
function AcceptsDialogue(Request: ClientMessage): boolean;
begin
  case Request of
    ClientMessage.Interact:
    begin
      return true
    end;
    ClientMessage.DialogueChoice(ChoiceId):
    begin
      return true
    end
    else
    begin
      return false
    end
  end
end;

// Returns whether a dialogue-ended acknowledgement is a valid response to one request.
function AcceptsDialogueEnded(Request: ClientMessage): boolean;
begin
  case Request of
    ClientMessage.DialogueChoice(ChoiceId):
    begin
      return true
    end;
    ClientMessage.EndDialogue:
    begin
      return true
    end
    else
    begin
      return false
    end
  end
end;

// Maps one server response to its client event; None marks a response the request cannot produce.
function ResponseEvent(Request: ClientMessage; Response: ServerMessage): option of ClientEvent;
begin
  case Response of
    ServerMessage.State(Value):
    begin
      if AcceptsState(Request) then
      begin
        return Some(ClientEvent.State(Value))
      end
    end;
    ServerMessage.ExplorationMap(Value):
    begin
      case Request of
        ClientMessage.ExplorationMap(OriginX, OriginY, Width, Height):
        begin
          return Some(ClientEvent.ExplorationMap(Value))
        end
        else
        begin
        end
      end
    end;
    ServerMessage.Interaction(Title, Message):
    begin
      case Request of
        ClientMessage.Interact:
        begin
          return Some(ClientEvent.Interaction(Title, Message))
        end
        else
        begin
        end
      end
    end;
    ServerMessage.Dialogue(Value):
    begin
      if AcceptsDialogue(Request) then
      begin
        return Some(ClientEvent.Dialogue(Value))
      end
    end;
    ServerMessage.DialogueEnded:
    begin
      if AcceptsDialogueEnded(Request) then
      begin
        return Some(ClientEvent.DialogueEnded)
      end
    end;
    ServerMessage.SaveCompleted:
    begin
      case Request of
        ClientMessage.SaveGame:
        begin
          return Some(ClientEvent.SaveCompleted)
        end
        else
        begin
        end
      end
    end;
    ServerMessage.Rejected(Code, Message):
    begin
      case Request of
        ClientMessage.ExplorationMap(OriginX, OriginY, Width, Height):
        begin
          return Some(ClientEvent.MapRejected(Code, Message))
        end
        else
        begin
          return Some(ClientEvent.Rejected(Code, Message))
        end
      end
    end
    else
    begin
    end
  end;

  return None
end;

function RunNetworkSession(
  Host: string;
  Port: integer;
  ViewWidth: integer;
  ViewHeight: integer;
  Requests: channel of ClientMessage;
  Events: channel of ClientEvent;
  Token: CancellationToken
): result of boolean, string;
begin
  var ConnectionValue: Connection := try ConnectWithCancellation(Host, Port, 5000, Token);
  mutable var Reader: LineReader := NewLineReader(ConnectionValue);
  mutable var SaveAvailable: boolean := false;
  mutable var InvalidSaveRemoved: boolean := false;
  var HelloSent: boolean := try WriteLine(ConnectionValue, EncodeClient(ClientMessage.Hello(ProtocolVersion, ViewWidth, ViewHeight)), Token);
  case ReadServer(Reader, Token) of
    Error(Message):
    begin
      var Closed: boolean := try Close(ConnectionValue);
      return Error(Message)
    end;
    Ok(ReadValue):
    begin
      Reader := ReadValue.Reader;
      case ReadValue.Message of
        ServerMessage.Welcome(Version, Available, Removed):
        begin
          if Version <> ProtocolVersion then
          begin
            var Closed: boolean := try Close(ConnectionValue);
            return Error('server selected an unsupported protocol version')
          end
          else
          begin
            SaveAvailable := Available;
            InvalidSaveRemoved := Removed
          end
        end
        else
        begin
          var Closed: boolean := try Close(ConnectionValue);
          return Error('server did not welcome the client')
        end
      end
    end
  end;
  var Published: boolean := try Publish(Events, ClientEvent.Connected(SaveAvailable, InvalidSaveRemoved), Token);
  while not IsCancellationRequested(Token) do
  begin
    case ReceiveWithCancellation(Requests, Token) of
      Error(Message):
      begin
        var Closed: boolean := try Close(ConnectionValue);
        return Ok(true)
      end;
      Ok(Request):
      begin
        case Request of
          ClientMessage.Hello(Version, Width, Height):
          begin
            var Closed: boolean := try Close(ConnectionValue);
            return Error('hello can only be sent during connection setup')
          end;
          ClientMessage.Disconnect:
          begin
            var Written: boolean := try WriteLine(ConnectionValue, EncodeClient(Request), Token);
            var Closed: boolean := try Close(ConnectionValue);
            return Ok(true)
          end
          else
          begin
          end
        end;
        var Written: boolean := try WriteLine(ConnectionValue, EncodeClient(Request), Token);
        // Every remaining request receives exactly one server response.
        case ReadServer(Reader, Token) of
          Error(Message):
          begin
            var Closed: boolean := try Close(ConnectionValue);
            return Error(Message)
          end;
          Ok(ReadValue):
          begin
            Reader := ReadValue.Reader;
            case ReadValue.Message of
              ServerMessage.ErrorMessage(Code, Message):
              begin
                var Sent: boolean := try Publish(Events, ClientEvent.Failed(Message), Token);
                var Closed: boolean := try Close(ConnectionValue);
                return Ok(true)
              end
              else
              begin
                case ResponseEvent(Request, ReadValue.Message) of
                  Some(ResponseValue):
                  begin
                    var Sent: boolean := try Publish(Events, ResponseValue, Token)
                  end;
                  None:
                  begin
                    var Closed: boolean := try Close(ConnectionValue);
                    return Error('unexpected server response')
                  end
                end
              end
            end
          end
        end
      end
    end
  end;
  var Closed: boolean := try Close(ConnectionValue);
  return Ok(true)
end;

// Owns one connection and treats host-requested cancellation as normal shutdown.
public function RunNetwork(
  Host: string;
  Port: integer;
  ViewWidth: integer;
  ViewHeight: integer;
  Requests: channel of ClientMessage;
  Events: channel of ClientEvent;
  Token: CancellationToken
): result of boolean, string;
begin
  case RunNetworkSession(Host, Port, ViewWidth, ViewHeight, Requests, Events, Token) of
    Ok(Completed):
    begin
      return Ok(Completed)
    end;
    Error(Message):
    begin
      if IsCancellationRequested(Token) then
      begin
        return Ok(true)
      end;

      return Error(Message)
    end
  end
end;
