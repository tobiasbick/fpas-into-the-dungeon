// TCP session adapter between client intentions and model events.
unit Dungeon.Client.Network;

uses Dungeon.Client.Model as Model, Dungeon.Protocol as Protocol, Dungeon.Protocol.ClientMessages as ClientMessages, Dungeon.Protocol.Worlds as WorldsUnit, Dungeon.Protocol.ServerMessages as ServerMessages, Dungeon.Protocol.Transport as Transport, Std.Net as Net, Std.Tasks as Tasks;

type ServerRead = record
  Message: Protocol.ServerMessage;
  Reader: Transport.LineReader;
end record;

function Publish(Events: channel of Model.ClientEvent; Value: Model.ClientEvent; Token: Tasks.CancellationToken): result of (boolean, string);
begin
  return Tasks.SendWithCancellation(Events, Value, Token);
end function;

function ReadServer(Reader: Transport.LineReader; Token: Tasks.CancellationToken): result of (ServerRead, string);
begin
  const ReadValue: Transport.LineRead := try Transport.ReadLine(Reader, Token);
  return Ok(
    ServerRead(
      Message := try ServerMessages.DecodeServer(ReadValue.Line),
      Reader := ReadValue.Reader
    )
  );
end function;

// Returns whether a visible-state projection is a valid response to one request.
function AcceptsState(Request: Protocol.ClientMessage): boolean;
begin
  case Request of
    when Protocol.ClientMessage.CreateWorld(const Seed, const RegionChunks):
      begin
        return true;
      end;
    when Protocol.ClientMessage.StartNewGame:
      begin
        return true;
      end;
    when Protocol.ClientMessage.LoadGame:
      begin
        return true;
      end;
    when Protocol.ClientMessage.Viewport(const Width, const Height):
      begin
        return true;
      end;
    when Protocol.ClientMessage.Move(const DeltaX, const DeltaY):
      begin
        return true;
      end;
    when Protocol.ClientMessage.StepFirstPerson(const Direction):
      begin
        return true;
      end;
    when Protocol.ClientMessage.TurnFirstPerson(const Direction):
      begin
        return true;
      end;
    when Protocol.ClientMessage.Interact:
      begin
        return true;
      end;
    when Protocol.ClientMessage.Attack:
      begin
        return true;
      end;
    when Protocol.ClientMessage.Wait:
      begin
        return true;
      end;
    when Protocol.ClientMessage.Equip(const ItemId):
      begin
        return true;
      end;
    when Protocol.ClientMessage.Unequip(const ItemId):
      begin
        return true;
      end;
    when Protocol.ClientMessage.UseItem(_):
      return true;
    when Protocol.ClientMessage.DropItem(const ItemId):
      begin
        return true;
      end;
    when Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Disconnect:
      begin
        return false;
      end;
  end case;
end function;

// Returns whether a defeat can answer one request: only turn-consuming intentions end a game.
// Equipment changes and drops consume a turn, so the opponent can strike while the player handles gear.
function AcceptsDefeat(Request: Protocol.ClientMessage): boolean;
begin
  case Request of
    when Protocol.ClientMessage.StepFirstPerson(const Direction):
      begin
        return true;
      end;
    when Protocol.ClientMessage.Attack:
      begin
        return true;
      end;
    when Protocol.ClientMessage.Wait:
      begin
        return true;
      end;
    when Protocol.ClientMessage.Equip(const ItemId):
      begin
        return true;
      end;
    when Protocol.ClientMessage.Unequip(const ItemId):
      begin
        return true;
      end;
    when Protocol.ClientMessage.UseItem(_):
      return true;
    when Protocol.ClientMessage.DropItem(const ItemId):
      begin
        return true;
      end;
    when Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Disconnect:
      begin
        return false;
      end;
  end case;
end function;

// Maps one server response to its client event; None marks a response the request cannot produce.
function ResponseEvent(Request: Protocol.ClientMessage; Response: Protocol.ServerMessage): option of Model.ClientEvent;
begin
  case Response of
    when Protocol.ServerMessage.Worlds(const Catalog):
      begin
        case Request of
          when Protocol.ClientMessage.ListWorlds(const Offset, const DiscardProgress):
            begin
              return Some(Model.ClientEvent.Worlds(Catalog));
            end;
          when Protocol.ClientMessage.SelectWorld(const Id):
            begin
              return Some(Model.ClientEvent.Worlds(Catalog));
            end;
          when Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
            begin
              null;
            end;
        end case;
      end;
    when Protocol.ServerMessage.State(const Value):
      begin
        if AcceptsState(Request) then
          begin
            return Some(Model.ClientEvent.State(Value));
          end;
        end if;
      end;
    when Protocol.ServerMessage.ExplorationMap(const Value):
      begin
        case Request of
          when Protocol.ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height):
            return Some(Model.ClientEvent.ExplorationMap(Value));
          when Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
            null;
        end case;
      end;
    when Protocol.ServerMessage.Interaction(const Title, const Message):
      begin
        if Request is Protocol.ClientMessage.Interact then
          begin
            return Some(Model.ClientEvent.Interaction(Title, Message));
          end;
        else
          begin
            null;
          end;
        end if;
      end;
    when Protocol.ServerMessage.Defeated(const Message):
      begin
        if AcceptsDefeat(Request) then
          begin
            return Some(Model.ClientEvent.Defeated(Message));
          end;
        end if;
      end;
    when Protocol.ServerMessage.SaveCompleted:
      begin
        case Request of
          when Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame:
            begin
              return Some(Model.ClientEvent.SaveCompleted);
            end;
          when Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
            begin
              null;
            end;
        end case;
      end;
    when Protocol.ServerMessage.Rejected(const Code, const Message):
      begin
        case Request of
          when Protocol.ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height):
            return Some(Model.ClientEvent.MapRejected(Code, Message));
          when Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
            return Some(Model.ClientEvent.Rejected(Code, Message));
        end case;
      end;
    when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.ErrorMessage(_, _):
      begin
        null;
      end;
  end case;

  return None;
end function;

function RunNetworkSession(
  Host: string;
  Port: integer;
  ViewWidth: integer;
  ViewHeight: integer;
  Requests: channel of Protocol.ClientMessage;
  Events: channel of Model.ClientEvent;
  Token: Tasks.CancellationToken
): result of (boolean, string);
begin
  const ConnectionValue: Net.Connection := try Net.ConnectWithCancellation(Host, Port, 5000, Token);
  var Reader: Transport.LineReader := Transport.NewLineReader(ConnectionValue);
  var Catalog: Protocol.WorldCatalog := WorldsUnit.EmptyWorldCatalog(12345, 4);
  const HelloSent: boolean := try Transport.WriteLine(
    ConnectionValue,
    ClientMessages.EncodeClient(
      Protocol.ClientMessage.Hello(Protocol.ProtocolVersion, ViewWidth, ViewHeight)
    ),
    Token
  );
  case ReadServer(Reader, Token) of
    when Error(const Message):
      begin
        const Closed: boolean := try Net.Close(ConnectionValue);
        return Error(Message);
      end;
    when Ok(const ReadValue):
      begin
        Reader := ReadValue.Reader;
        case ReadValue.Message of
          when Protocol.ServerMessage.Welcome(const Version, const Available):
            begin
              if Version <> Protocol.ProtocolVersion then
                begin
                  const Closed: boolean := try Net.Close(ConnectionValue);
                  return Error('server selected an unsupported protocol version');
                end;
              else
                begin
                  Catalog := Available;
                end;
              end if;
            end;
          when Protocol.ServerMessage.Rejected(const Code, const Message):
            // The server rejects the session before Welcome when world data is unusable, then closes.
            begin
              const Published: boolean := try Publish(
                Events,
                Model.ClientEvent.Failed(Message),
                Token
              );
              const Closed: boolean := try Net.Close(ConnectionValue);
              return Ok(true);
            end;
          when Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.ErrorMessage(_, _):
            begin
              const Closed: boolean := try Net.Close(ConnectionValue);
              return Error('server did not welcome the client');
            end;
        end case;
      end;
  end case;
  const Published: boolean := try Publish(Events, Model.ClientEvent.Connected(Catalog), Token);
  while not Tasks.IsCancellationRequested(Token) do
    begin
      case Tasks.ReceiveWithCancellation(Requests, Token) of
        when Error(const Message):
          begin
            const Closed: boolean := try Net.Close(ConnectionValue);
            return Ok(true);
          end;
        when Ok(const Request):
          begin
            case Request of
              when Protocol.ClientMessage.Hello(const Version, const Width, const Height):
                begin
                  const Closed: boolean := try Net.Close(ConnectionValue);
                  return Error('hello can only be sent during connection setup');
                end;
              when Protocol.ClientMessage.Disconnect:
                begin
                  const Written: boolean := try Transport.WriteLine(
                    ConnectionValue,
                    ClientMessages.EncodeClient(Request),
                    Token
                  );
                  const Closed: boolean := try Net.Close(ConnectionValue);
                  return Ok(true);
                end;
              when Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_):
                begin
                  null;
                end;
            end case;
            const Written: boolean := try Transport.WriteLine(
              ConnectionValue,
              ClientMessages.EncodeClient(Request),
              Token
            );
            // Every remaining request receives exactly one server response.
            case ReadServer(Reader, Token) of
              when Error(const Message):
                begin
                  const Closed: boolean := try Net.Close(ConnectionValue);
                  return Error(Message);
                end;
              when Ok(const ReadValue):
                begin
                  Reader := ReadValue.Reader;
                  case ReadValue.Message of
                    when Protocol.ServerMessage.ErrorMessage(const Code, const Message):
                      const Sent: boolean := try Publish(
                        Events,
                        Model.ClientEvent.Failed(Message),
                        Token
                      );
                      const Closed: boolean := try Net.Close(ConnectionValue);
                      return Ok(true);
                    when Protocol.ServerMessage.Welcome(_, _), Protocol.ServerMessage.Worlds(_), Protocol.ServerMessage.State(_), Protocol.ServerMessage.ExplorationMap(_), Protocol.ServerMessage.Interaction(_, _), Protocol.ServerMessage.SaveCompleted, Protocol.ServerMessage.Defeated(_), Protocol.ServerMessage.Rejected(_, _):
                      case ResponseEvent(Request, ReadValue.Message) of
                        when Some(const ResponseValue):
                          begin
                            const Sent: boolean := try Publish(Events, ResponseValue, Token);
                          end;
                        when None:
                          begin
                            const Closed: boolean := try Net.Close(ConnectionValue);
                            return Error('unexpected server response');
                          end;
                      end case;
                  end case;
                end;
            end case;
          end;
      end case;
    end;
  end while;
  const Closed: boolean := try Net.Close(ConnectionValue);
  return Ok(true);
end function;

// Owns one connection and treats host-requested cancellation as normal shutdown.
public function RunNetwork(
  Host: string;
  Port: integer;
  ViewWidth: integer;
  ViewHeight: integer;
  Requests: channel of Protocol.ClientMessage;
  Events: channel of Model.ClientEvent;
  Token: Tasks.CancellationToken
): result of (boolean, string);
begin
  case RunNetworkSession(Host, Port, ViewWidth, ViewHeight, Requests, Events, Token) of
    when Ok(const Completed):
      begin
        return Ok(Completed);
      end;
    when Error(const Message):
      begin
        if Tasks.IsCancellationRequested(Token) then
          begin
            return Ok(true);
          end;
        end if;

        return Error(Message);
      end;
  end case;
end function;
end unit;
