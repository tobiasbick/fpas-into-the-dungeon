// Stable client state shared by networking, update, and presentation modules.
unit Dungeon.Client.Model;

uses
  Dungeon.Client.Animation, Dungeon.Client.Raycast, Dungeon.Protocol, Dungeon.Protocol.Worlds,
  Dungeon.RuntimeData, Std.Tasks, Std.Tui;

public type
  // Top-level client screens; network activity begins only from the start screen.
  ClientScreen = enum
    StartScreen;
    GameScreen;
  end enum;
  // Mutually exclusive modal content shown above the current screen.
  ClientOverlay = enum
    NoOverlay;
    InformationOverlay;
    DescriptionOverlay;
    SystemMenuOverlay;
    SaveConfirmationOverlay;
    NewWorldOverlay;
    DiscardConfirmationOverlay;
    SessionCancelConfirmationOverlay;
    ContextOverlay;
    MessageOverlay;
    ExplorationMapOverlay;
    // Shown above the session start screen after the character fell.
    DefeatOverlay;
    // Carried and worn items with a client-owned selection; Enter equips or unequips.
    InventoryOverlay;
    // Server-formatted character values and the worn equipment.
    CharacterSheetOverlay;
  end enum;
  // Connection lifecycle used to gate intentions and derive presentation.
  ClientConnectionPhase = enum
    Offline;
    Connecting;
    AwaitingSession;
    Active;
    Failed;
    Disconnected;
  end enum;
  // Network events, including save inspection, consumed by the synchronous TUI update loop.
  ClientEvent = enum
    Connected(Catalog: WorldCatalog);
    Worlds(Catalog: WorldCatalog);
    State(Value: VisibleState);
    ExplorationMap(Value: ExplorationMapState);
    // Successful read-only interaction text returned by the authoritative server.
    Interaction(Title: string; Message: string);
    SaveCompleted;
    // Rejection of a session intention; never resolves a pending exploration-map request.
    Rejected(Code: string; Message: string);
    // Rejection of the pending exploration-map request; never resolves other pending intentions.
    MapRejected(Code: string; Message: string);
    // The character fell; the server ended the game session but kept the connection.
    Defeated(Message: string);
    Failed(Message: string);
    Disconnected;
  end enum;
  // Complete client-owned state; world facts remain server-provided visible state.
  ClientModel = record
    public Host: string;
    public Port: integer;
    public ClientConfigPath: string;
    public Requests: channel of ClientMessage;
    public Events: channel of ClientEvent;
    public Screen: ClientScreen;
    public Overlay: ClientOverlay;
    public ConnectionPhase: ClientConnectionPhase;
    public FocusedControl: integer;
    public ViewportWidth: integer;
    public ViewportHeight: integer;
    // Immutable pre-game artwork for these grid dimensions; updates rebuild it only on resize.
    public StartBackdrop: TuiCellGrid;
    public RequestedWorldWidth: integer;
    public RequestedWorldHeight: integer;
    public ContextPanelVisible: boolean;
    public MessagePanelVisible: boolean;
    public SaveAvailable: boolean;
    // Last validated server catalog and local editor state; never world authority.
    public Catalog: WorldCatalog;
    // Local list cursor can inspect an incompatible entry without changing server selection.
    public WorldCursor: integer;
    public SeedText: string;
    public SeedCaret: integer;
    public RegionText: string;
    public RegionCaret: integer;
    public Dirty: boolean;
    public PendingChangesProgress: boolean;
    public PendingCreatedWorld: boolean;
    public Pending: boolean;
    public HasVisibleState: boolean;
    public View: ViewKind;
    public OriginX: integer;
    public OriginY: integer;
    public Width: integer;
    public Height: integer;
    public Rows: array of string;
    public KnowledgeRows: array of string;
    public PlayerX: integer;
    public PlayerY: integer;
    public WorldX: integer;
    public WorldY: integer;
    // Client-safe carried-item summary from the latest authoritative projection.
    public Inventory: array of VisibleInventoryItem;
    // Client-owned, non-persistent navigation and latest projection for the map overlay.
    public MapRequestPending: boolean;
    public MapHasState: boolean;
    public MapView: ViewKind;
    public MapLabel: string;
    public MapOriginX: integer;
    public MapOriginY: integer;
    public MapDesiredOriginX: integer;
    public MapDesiredOriginY: integer;
    // Desired request size is independent of the last complete projection.
    public MapDesiredWidth: integer;
    public MapDesiredHeight: integer;
    public MapWidth: integer;
    public MapHeight: integer;
    public MapRows: array of string;
    public MapKnowledgeRows: array of string;
    public MapPlayerWorldX: integer;
    public MapPlayerWorldY: integer;
    public MapPlayerInWindow: boolean;
    // Server-provided first-person geometry and pose used only for presentation.
    public FirstPersonFacing: Dungeon.Protocol.FirstPersonFacing;
    public PrimaryTitle: string;
    public PrimaryStatus: string;
    public Status: string;
    public Messages: array of string;
    // Server-provided inspection content and client-owned scroll position.
    public DescriptionTitle: string;
    public DescriptionText: string;
    public DescriptionOffset: integer;
    // Server-provided character health; zero before the first visible state.
    public Health: integer;
    public MaxHealth: integer;
    // Set when the latest projection lowered health; drives the red damage frame.
    public DamageTaken: boolean;
    // Server-provided summary shown by the defeat overlay.
    public DefeatMessage: string;
    // Server-formatted character sheet lines from the latest projection.
    public Character: array of VisibleCharacterValue;
    // Client-owned selection in the inventory overlay.
    public InventorySelection: integer;
    // Playback of the latest turn's combat events.
    public Animation: CombatAnimation;
    // Walls and floor of the animated state, rendered once when the animation starts.
    public AnimationScene: FirstPersonScene;
  end record;

// Creates an offline start-screen model without assuming server-owned map dimensions.
public function NewClientModel(
  Host: string;
  Port: integer;
  ClientConfigPath: string;
  Preferences: ClientPreferences;
  Requests: channel of ClientMessage;
  Events: channel of ClientEvent
): ClientModel;
begin
  return record
    Host := Host;
    Port := Port;
    ClientConfigPath := ClientConfigPath;
    Requests := Requests;
    Events := Events;
    Screen := ClientScreen.StartScreen;
    Overlay := ClientOverlay.NoOverlay;
    ConnectionPhase := ClientConnectionPhase.Offline;
    FocusedControl := 1;
    ViewportWidth := 0;
    ViewportHeight := 0;
    StartBackdrop := TuiCellGrid.Create(0, 0, []);
    RequestedWorldWidth := 1;
    RequestedWorldHeight := 1;
    ContextPanelVisible := Preferences.ContextPanelVisible;
    MessagePanelVisible := Preferences.MessagePanelVisible;
    SaveAvailable := false;
    Catalog := EmptyWorldCatalog(12345, 4);
    WorldCursor := -1;
    SeedText := '';
    SeedCaret := 0;
    RegionText := '';
    RegionCaret := 0;
    Dirty := false;
    PendingChangesProgress := false;
    PendingCreatedWorld := false;
    Pending := false;
    HasVisibleState := false;
    View := ViewKind.Map;
    OriginX := 0;
    OriginY := 0;
    Width := 0;
    Height := 0;
    Rows := [];
    KnowledgeRows := [];
    PlayerX := 0;
    PlayerY := 0;
    WorldX := 0;
    WorldY := 0;
    Inventory := [];
    MapRequestPending := false;
    MapHasState := false;
    MapView := ViewKind.Map;
    MapLabel := '';
    MapOriginX := 0;
    MapOriginY := 0;
    MapDesiredOriginX := 0;
    MapDesiredOriginY := 0;
    MapDesiredWidth := 1;
    MapDesiredHeight := 1;
    MapWidth := 1;
    MapHeight := 1;
    MapRows := [];
    MapKnowledgeRows := [];
    MapPlayerWorldX := 0;
    MapPlayerWorldY := 0;
    MapPlayerInWindow := false;
    FirstPersonFacing := Dungeon.Protocol.FirstPersonFacing.North;
    PrimaryTitle := '';
    PrimaryStatus := '';
    Status := 'Ready';
    Messages := [];
    DescriptionTitle := '';
    DescriptionText := '';
    DescriptionOffset := 0;
    Health := 0;
    MaxHealth := 0;
    DamageTaken := false;
    DefeatMessage := '';
    Character := [];
    InventorySelection := 0;
    Animation := NoAnimation();
    AnimationScene := record
      Width := 0;
      Height := 0;
      Pixels := [];
      Depths := [];
    end;
  end;
end function;
end unit;
