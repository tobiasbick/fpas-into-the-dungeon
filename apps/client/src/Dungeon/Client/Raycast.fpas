// Pure terminal raycasting for validated first-person protocol states: scenes and composed frames.
unit Dungeon.Client.Raycast;

uses Dungeon.Client.Raycast.Pixels as PixelOps, Dungeon.Client.Raycast.Rays as Rays, Dungeon.Client.Raycast.Sprites as Sprites, Dungeon.Client.Raycast.Textures as Textures, Dungeon.Protocol as Protocol, Std.Conv as Conv, Std.Math as Math, Std.Tui as Tui;

// Walls, floor, and depth buffer of one state at one size; sprites are composed per frame.
public type FirstPersonScene = record
  public Width: integer;
  public Height: integer;
  public Pixels: array of integer;
  public Depths: array of real;
end record;

// Renders the static part of one frame: walls, floor, and the depth buffer.
// One ray per column feeds both the wall slice and the depth buffer used for occlusion.
public function RenderFirstPersonScene(Value: Protocol.FirstPersonVisibleState; Width: integer; Height: integer): FirstPersonScene;
begin
  const SafeWidth: integer := Math.Max(0, Width);
  const SafeHeight: integer := Math.Max(0, Height);
  if (SafeWidth = 0) or (SafeHeight = 0) then
    return FirstPersonScene(Width := SafeWidth, Height := SafeHeight, Pixels := [], Depths := []);
  end if;
  const PixelHeight: integer := SafeHeight * 2;
  const Scale: real := Conv.IntToReal(PixelHeight) * Rays.TerminalAspectCorrection;
  const Camera: Rays.FirstPersonCamera := Rays.FrameCamera(Value);
  var Pixels: array of integer := array.Fill(PixelOps.CeilingPixel, SafeWidth * PixelHeight);
  var Depths: array of real := [];
  for X: integer := 0 to SafeWidth - 1 do
    begin
      var CameraX: real := 0.0;
      if SafeWidth > 1 then
        begin
          CameraX := ((2.0 * Conv.IntToReal(X)) / Conv.IntToReal(SafeWidth - 1)) - 1.0;
        end;
      end if;
      const Hit: Rays.FirstPersonRayHit := Rays.CastFirstPersonRay(Value, CameraX);
      Depths.PushInPlace(Hit.Distance);
      const ProjectedHeight: real := Scale / Hit.Distance;
      const WallHeight: integer := Math.Clamp(Math.Trunc(ProjectedHeight), 1, PixelHeight);
      const WallTop: integer := (PixelHeight - WallHeight) div 2;
      const WallBottom: integer := WallTop + WallHeight;
      // Texture rows follow the unclipped projection so close walls keep a stable pattern.
      const ProjectedTop: real := (Conv.IntToReal(PixelHeight) - ProjectedHeight) / 2.0;
      for Y: integer := 0 to WallTop - 1 do
        begin
          const CeilingDenominator: integer := (PixelHeight - (2 * Y)) - 1;
          if CeilingDenominator > 0 then
            begin
              Pixels[(Y * SafeWidth) + X] := PixelOps.Lit(
                PixelOps.CeilingPixel,
                Scale / Conv.IntToReal(CeilingDenominator)
              );
            end;
          end if;
        end;
      end for;

      for Y: integer := WallTop to WallBottom - 1 do
        begin
          const V: real := ((Conv.IntToReal(Y) + 0.5) - ProjectedTop) / ProjectedHeight;
          Pixels[(Y * SafeWidth) + X] := Textures.WallTexel(Hit, V, WallHeight);
        end;
      end for;

      for Y: integer := WallBottom to PixelHeight - 1 do
        begin
          const Denominator: integer := (2 * Y - PixelHeight) + 1;
          var Floor: integer := PixelOps.Lit(PixelOps.FloorPixel, 1000.0);
          if Denominator > 0 then
            begin
              Floor := Textures.ProjectFloorPixel(
                Value,
                Camera,
                CameraX,
                Scale / Conv.IntToReal(Denominator),
                Hit.Distance
              );
            end;
          end if;

          Pixels[(Y * SafeWidth) + X] := Floor;
        end;
      end for;
    end;
  end for;

  return FirstPersonScene(
    Width := SafeWidth,
    Height := SafeHeight,
    Pixels := Pixels,
    Depths := Depths
  );
end function;

// Draws sprites, the frame's animation effect, and the swing over one scene of the same state.
public function ComposeFirstPersonGrid(
  Value: Protocol.FirstPersonVisibleState;
  Scene: FirstPersonScene;
  Effect: Sprites.FirstPersonEffect
): Tui.TuiCellGrid;
begin
  const SafeWidth: integer := Scene.Width;
  const SafeHeight: integer := Scene.Height;
  if (SafeWidth = 0) or (SafeHeight = 0) then
    return Tui.TuiCellGrid.Create(SafeWidth, SafeHeight, []);
  end if;
  const PixelHeight: integer := SafeHeight * 2;
  const Camera: Rays.FirstPersonCamera := Rays.FrameCamera(Value);
  var Pixels: array of integer := Scene.Pixels;
  const Depths: array of real := Scene.Depths;
  // Stable painter's order: far sprites first, preserving scan order at equal depths.
  var Billboards := Sprites.VisibleSprites(Value);
  if Effect.FallenAhead then
    begin
      Billboards.PushInPlace(
        Sprites.HostileSprite(
          Effect.FallenCode,
          Sprites.FieldAheadX(Value),
          Sprites.FieldAheadY(Value)
        )
      );
    end;
  end if;
  const OrderedSprites := Billboards.SortBy(
    function(Item: Sprites.Sprite): real begin
      return - Sprites.SpriteDepth(Camera, Item);
    end function
  );
  for Item: Sprites.Sprite in OrderedSprites do
    begin
      Pixels := Sprites.DrawSprite(
        Pixels,
        Depths,
        Camera,
        Item,
        SafeWidth,
        PixelHeight,
        Sprites.EffectForSprite(Value, Item, Effect)
      );
    end;
  end for;

  Pixels := Sprites.DrawSwing(Pixels, SafeWidth, PixelHeight, Effect);
  var Cells: array of Tui.TuiCell := [];
  for Y: integer := 0 to SafeHeight - 1 do
    begin
      for X: integer := 0 to SafeWidth - 1 do
        begin
          Cells.PushInPlace(
            PixelOps.HalfBlockCell(
              Pixels[((2 * Y) * SafeWidth) + X], Pixels[
                (((2 * Y) + 1) * SafeWidth) +
                X
              ]
            )
          );
        end;
      end for;
    end;
  end for;

  return Tui.TuiCellGrid.Create(SafeWidth, SafeHeight, Cells);
end function;

// Renders walls, floor, and upright sprites at two pixels per terminal cell.
public function RenderFirstPersonGrid(Value: Protocol.FirstPersonVisibleState; Width: integer; Height: integer): Tui.TuiCellGrid;
begin
  return ComposeFirstPersonGrid(
    Value,
    RenderFirstPersonScene(Value, Width, Height),
    Sprites.NoFirstPersonEffect()
  );
end function;
end unit;
