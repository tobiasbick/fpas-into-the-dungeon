// Pure terminal raycasting for validated first-person protocol states.
unit Dungeon.Client.Raycast;

uses Dungeon.Protocol, Std.Arrays, Std.Conv, Std.Math, Std.Str, Std.Tui;

public type
  // Nearest wall intersection for one camera-plane ray.
  FirstPersonRayHit = record
    // Perpendicular grid distance used for perspective-correct wall height.
    public Distance: real;
    // Client-safe code of the intersected opaque field.
    public FieldCode: string;
    // Whether the ray crossed a vertical wall plane rather than a horizontal one.
    public VerticalSide: boolean;
    // Whether the ray crossed the traversable exit before reaching the wall.
    public SawExit: boolean;
  end;

const
  CameraPlaneScale: real := 0.66;
  MinimumRayDistance: real := 0.0001;
  TerminalAspectCorrection: real := 0.58;
  FrontWallHorizontalInsetDivisor: integer := 8;
  FrontWallVerticalInsetDivisor: integer := 10;

function FieldAt(Value: FirstPersonVisibleState; X: integer; Y: integer): string;
begin
  if ((X < 0) or (X >= Value.Width)) or ((Y < 0) or (Y >= Value.Height)) then
  begin
    return '#'
  end;

  return Std.Str.CharAt(Value.Rows[Y], X)
end;

function IsOpaqueCode(Code: string): boolean;
begin
  return ((Code = '#') or (Code = '?')) or (Code = 't')
end;

function CameraDirection(Value: FirstPersonFacing): array of real;
begin
  case Value of
    FirstPersonFacing.North:
    begin
      return [0.0, -1.0, CameraPlaneScale, 0.0]
    end;
    FirstPersonFacing.East:
    begin
      return [1.0, 0.0, 0.0, CameraPlaneScale]
    end;
    FirstPersonFacing.South:
    begin
      return [0.0, 1.0, - CameraPlaneScale, 0.0]
    end;
    FirstPersonFacing.West:
    begin
      return [-1.0, 0.0, 0.0, - CameraPlaneScale]
    end
  end
end;

function FacingOffsets(Value: FirstPersonFacing): array of integer;
begin
  case Value of
    FirstPersonFacing.North:
    begin
      return [0, -1, -1, 0, 1, 0]
    end;
    FirstPersonFacing.East:
    begin
      return [1, 0, 0, -1, 0, 1]
    end;
    FirstPersonFacing.South:
    begin
      return [0, 1, 1, 0, -1, 0]
    end;
    FirstPersonFacing.West:
    begin
      return [-1, 0, 0, 1, 0, -1]
    end
  end
end;

// Casts one ray through camera-plane coordinate -1 through 1 in a validated state.
public function CastFirstPersonRay(Value: FirstPersonVisibleState; CameraX: real): FirstPersonRayHit;
begin
  var Camera: array of real := CameraDirection(Value.Facing);
  var PositionX: real := IntToReal(Value.PlayerX) + 0.5;
  var PositionY: real := IntToReal(Value.PlayerY) + 0.5;
  var RayDirectionX: real := Camera[0] + (Camera[2] * CameraX);
  var RayDirectionY: real := Camera[1] + (Camera[3] * CameraX);
  mutable var MapX: integer := Value.PlayerX;
  mutable var MapY: integer := Value.PlayerY;
  mutable var DeltaDistanceX: real := 1000000.0;
  mutable var DeltaDistanceY: real := 1000000.0;
  if RayDirectionX <> 0.0 then
  begin
    DeltaDistanceX := Std.Math.Abs(1.0 / RayDirectionX)
  end;

  if RayDirectionY <> 0.0 then
  begin
    DeltaDistanceY := Std.Math.Abs(1.0 / RayDirectionY)
  end;
  mutable var StepX: integer := 1;
  mutable var SideDistanceX: real := (IntToReal(MapX + 1) - PositionX) * DeltaDistanceX;
  if RayDirectionX < 0.0 then
  begin
    StepX := -1;
    SideDistanceX := (PositionX - IntToReal(MapX)) * DeltaDistanceX
  end;
  mutable var StepY: integer := 1;
  mutable var SideDistanceY: real := (IntToReal(MapY + 1) - PositionY) * DeltaDistanceY;
  if RayDirectionY < 0.0 then
  begin
    StepY := -1;
    SideDistanceY := (PositionY - IntToReal(MapY)) * DeltaDistanceY
  end;
  mutable var VerticalSide: boolean := false;
  mutable var Hit: boolean := false;
  mutable var FieldCode: string := '#';
  mutable var SawExit: boolean := false;
  mutable var Iterations: integer := 0;
  while (not Hit) and (Iterations <= (Value.Width * Value.Height) + 1) do
  begin
    if SideDistanceX < SideDistanceY then
    begin
      SideDistanceX := SideDistanceX + DeltaDistanceX;
      MapX := MapX + StepX;
      VerticalSide := true
    end
    else
    begin
      SideDistanceY := SideDistanceY + DeltaDistanceY;
      MapY := MapY + StepY;
      VerticalSide := false
    end;

    FieldCode := FieldAt(Value, MapX, MapY);
    if FieldCode = 'x' then
    begin
      SawExit := true
    end;

    Hit := IsOpaqueCode(FieldCode);
    Iterations := Iterations + 1
  end;
  mutable var Distance: real := SideDistanceY - DeltaDistanceY;
  if VerticalSide then
  begin
    Distance := SideDistanceX - DeltaDistanceX
  end;

  if Distance < MinimumRayDistance then
  begin
    Distance := MinimumRayDistance
  end;

  return record
    Distance := Distance;
    FieldCode := FieldCode;
    VerticalSide := VerticalSide;
    SawExit := SawExit;
  end
end;

function SolidCell(Red: integer; Green: integer; Blue: integer): TuiCell;
begin
  var Color: TuiColor := TuiColor.FromRgb(Red, Green, Blue);
  return TuiCell.Styled(' ', TuiStyle.FromColors(Color, Color))
end;

function WallCell(Hit: FirstPersonRayHit): TuiCell;
begin
  if Hit.FieldCode = '?' then
  begin
    return SolidCell(18, 21, 25)
  end;

  if Hit.FieldCode = 't' then
  begin
    mutable var TabletShade: integer := 188 - Trunc(Hit.Distance * 16.0);
    TabletShade := Std.Math.Clamp(TabletShade, 72, 188);
    if Hit.VerticalSide then
    begin
      TabletShade := (TabletShade * 4) div 5
    end;

    return SolidCell((TabletShade * 3) div 5, (TabletShade * 4) div 5, TabletShade)
  end;
  mutable var Shade: integer := 218 - Trunc(Hit.Distance * 22.0);
  Shade := Std.Math.Clamp(Shade, 48, 218);
  if Hit.VerticalSide then
  begin
    Shade := (Shade * 4) div 5
  end;

  return SolidCell(Shade, (Shade * 9) div 10, (Shade * 4) div 5)
end;

function CeilingCell(): TuiCell;
begin
  return SolidCell(12, 16, 25)
end;

function FloorCell(PlayerOnExit: boolean): TuiCell;
begin
  if PlayerOnExit then
  begin
    return SolidCell(92, 68, 20)
  end;

  return SolidCell(38, 34, 31)
end;

// Projects a floor sample onto the actual field; exits color only their floor.
// Unknown samples and samples behind opaque geometry reveal no material.
function ProjectFloor(
  Value: FirstPersonVisibleState;
  X: integer;
  Y: integer;
  Width: integer;
  Height: integer;
  Scale: real
): TuiCell;
begin
  var Denominator: integer := (2 * Y - Height) + 1;
  if Denominator <= 0 then
  begin
    return FloorCell(false)
  end;
  mutable var CameraX: real := 0.0;
  if Width > 1 then
  begin
    CameraX := ((2.0 * IntToReal(X)) / IntToReal(Width - 1)) - 1.0
  end;
  var Distance: real := Scale / IntToReal(Denominator);
  var Hit: FirstPersonRayHit := CastFirstPersonRay(Value, CameraX);
  if Distance >= Hit.Distance then
  begin
    return FloorCell(false)
  end;
  var Camera: array of real := CameraDirection(Value.Facing);
  var SampleX: integer := Std.Math.Floor((IntToReal(Value.PlayerX) + 0.5) +
                                         Distance * (Camera[0] + Camera[2] * CameraX));
  var SampleY: integer := Std.Math.Floor((IntToReal(Value.PlayerY) + 0.5) +
                                         Distance * (Camera[1] + Camera[3] * CameraX));
  var Code: string := FieldAt(Value, SampleX, SampleY);
  if Code = '?' then
  begin
    return SolidCell(18, 21, 25)
  end;

  return FloorCell(Code = 'x')
end;

// Side lanes retain the forward direction and the front plane's projection scale.
// A continuous wall therefore has identical upper and lower edges across lanes.
function OpenSideCell(
  Hit: FirstPersonRayHit;
  Y: integer;
  Height: integer;
  VerticalInset: integer;
  Floor: TuiCell
): TuiCell;
begin
  mutable var WallHeight: integer := Trunc((IntToReal(Height - 2 * VerticalInset) * 0.5) /
                                           Hit.Distance);
  if WallHeight < 1 then
  begin
    WallHeight := 1
  end;

  if WallHeight > Height - 2 then
  begin
    WallHeight := Height - 2
  end;
  var WallTop: integer := (Height - WallHeight) div 2;
  var WallBottom: integer := WallTop + WallHeight;
  if Y < WallTop then
  begin
    return CeilingCell()
  end;

  if Y < WallBottom then
  begin
    return WallCell(Hit)
  end;

  return Floor
end;

function SideWallCell(Code: string): TuiCell;
begin
  if Code = '?' then
  begin
    return SolidCell(18, 21, 25)
  end;

  if Code = 't' then
  begin
    return SolidCell(90, 120, 150)
  end;

  return SolidCell(142, (142 * 9) div 10, (142 * 4) div 5)
end;

function ClosedSideCell(
  X: integer;
  Y: integer;
  Width: integer;
  Height: integer;
  FrontLeft: integer;
  FrontRight: integer;
  FrontTop: integer;
  FrontBottom: integer;
  SideCode: string;
  Floor: TuiCell
): TuiCell;
begin
  mutable var SideTop: integer := FrontTop;
  mutable var SideBottom: integer := FrontBottom;
  if X < FrontLeft then
  begin
    SideTop := (FrontTop * X) div FrontLeft;
    SideBottom := (Height - 1) - (((Height - 1) - FrontBottom) * X) div FrontLeft
  end
  else
  begin
    var RightWidth: integer := (Width - 1) - FrontRight;
    var DistanceFromFront: integer := X - FrontRight;
    SideTop := FrontTop - ((FrontTop * DistanceFromFront) div RightWidth);
    SideBottom := FrontBottom + ((((Height - 1) - FrontBottom) * DistanceFromFront) div RightWidth)
  end;

  if Y < SideTop then
  begin
    return CeilingCell()
  end;

  if Y > SideBottom then
  begin
    return Floor
  end;

  return SideWallCell(SideCode)
end;

function ImmediateFrontWallCell(
  Hit: FirstPersonRayHit;
  X: integer;
  Y: integer;
  Width: integer;
  Height: integer;
  HorizontalInset: integer;
  VerticalInset: integer;
  LeftIsOpen: boolean;
  RightIsOpen: boolean;
  LeftHit: FirstPersonRayHit;
  RightHit: FirstPersonRayHit;
  LeftCode: string;
  RightCode: string;
  Floor: TuiCell
): TuiCell;
begin
  var FrontLeft: integer := HorizontalInset;
  var FrontRight: integer := (Width - HorizontalInset) - 1;
  var FrontTop: integer := VerticalInset;
  var FrontBottom: integer := (Height - VerticalInset) - 1;
  if (X >= FrontLeft) and (X <= FrontRight) then
  begin
    if Y < FrontTop then
    begin
      return CeilingCell()
    end;

    if Y > FrontBottom then
    begin
      return Floor
    end;

    return WallCell(Hit)
  end;

  if X < FrontLeft then
  begin
    if LeftIsOpen then
    begin
      return OpenSideCell(LeftHit, Y, Height, VerticalInset, Floor)
    end;

    return ClosedSideCell(X, Y, Width, Height, FrontLeft, FrontRight, FrontTop, FrontBottom, LeftCode, Floor)
  end;

  if RightIsOpen then
  begin
    return OpenSideCell(RightHit, Y, Height, VerticalInset, Floor)
  end;

  return ClosedSideCell(X, Y, Width, Height, FrontLeft, FrontRight, FrontTop, FrontBottom, RightCode, Floor)
end;

// Renders a complete ceiling, wall, and floor grid, including inset geometry for an adjacent front wall.
public function RenderFirstPersonGrid(Value: FirstPersonVisibleState; Width: integer; Height: integer): TuiCellGrid;
begin
  mutable var SafeWidth: integer := Width;
  mutable var SafeHeight: integer := Height;
  if SafeWidth < 0 then
  begin
    SafeWidth := 0
  end;

  if SafeHeight < 0 then
  begin
    SafeHeight := 0
  end;
  var Offsets: array of integer := FacingOffsets(Value.Facing);
  var FrontCode: string := FieldAt(Value, Value.PlayerX + Offsets[0], Value.PlayerY + Offsets[1]);
  var LeftCode: string := FieldAt(Value, Value.PlayerX + Offsets[2], Value.PlayerY + Offsets[3]);
  var RightCode: string := FieldAt(Value, Value.PlayerX + Offsets[4], Value.PlayerY + Offsets[5]);
  var FrontIsWall: boolean := IsOpaqueCode(FrontCode);
  var LeftIsOpen: boolean := not IsOpaqueCode(LeftCode);
  var RightIsOpen: boolean := not IsOpaqueCode(RightCode);
  mutable var HorizontalInset: integer := 0;
  if SafeWidth >= 5 then
  begin
    HorizontalInset := SafeWidth div FrontWallHorizontalInsetDivisor;
    if HorizontalInset < 1 then
    begin
      HorizontalInset := 1
    end
  end;
  mutable var VerticalInset: integer := 0;
  if SafeHeight >= 5 then
  begin
    VerticalInset := SafeHeight div FrontWallVerticalInsetDivisor;
    if VerticalInset < 1 then
    begin
      VerticalInset := 1
    end
  end;
  var FrontHit: FirstPersonRayHit := CastFirstPersonRay(Value, 0.0);
  mutable var LeftView: FirstPersonVisibleState := Value;
  LeftView.PlayerX := Value.PlayerX + Offsets[2];
  LeftView.PlayerY := Value.PlayerY + Offsets[3];
  var LeftHit: FirstPersonRayHit := CastFirstPersonRay(LeftView, 0.0);
  mutable var RightView: FirstPersonVisibleState := Value;
  RightView.PlayerX := Value.PlayerX + Offsets[4];
  RightView.PlayerY := Value.PlayerY + Offsets[5];
  var RightHit: FirstPersonRayHit := CastFirstPersonRay(RightView, 0.0);
  mutable var Cells: array of TuiCell := [];
  for Y: integer := 0 to SafeHeight - 1 do
  begin
    for X: integer := 0 to SafeWidth - 1 do
    begin
      if (FrontIsWall and (HorizontalInset > 0)) and (VerticalInset > 0) then
      begin
        var Floor: TuiCell := ProjectFloor(Value, X, Y, SafeWidth, SafeHeight, IntToReal(SafeHeight -
                                                                                         2 * VerticalInset) *
                                                                               0.5);
        Std.Arrays.Push(Cells, ImmediateFrontWallCell(FrontHit, X, Y, SafeWidth, SafeHeight, HorizontalInset, VerticalInset, LeftIsOpen, RightIsOpen, LeftHit, RightHit, LeftCode, RightCode, Floor))
      end
      else
      begin
        mutable var CameraX: real := 0.0;
        if SafeWidth > 1 then
        begin
          CameraX := ((2.0 * IntToReal(X)) / IntToReal(SafeWidth - 1)) - 1.0
        end;
        var Hit: FirstPersonRayHit := CastFirstPersonRay(Value, CameraX);
        mutable var WallHeight: integer := Trunc((IntToReal(SafeHeight) * TerminalAspectCorrection) /
                                                 Hit.Distance);
        if WallHeight < 1 then
        begin
          WallHeight := 1
        end;

        if WallHeight > SafeHeight then
        begin
          WallHeight := SafeHeight
        end;
        var WallTop: integer := (SafeHeight - WallHeight) div 2;
        var WallBottom: integer := WallTop + WallHeight;
        if Y < WallTop then
        begin
          Std.Arrays.Push(Cells, CeilingCell())
        end
        else
        begin
          if Y < WallBottom then
          begin
            Std.Arrays.Push(Cells, WallCell(Hit))
          end
          else
          begin
            Std.Arrays.Push(Cells, ProjectFloor(Value, X, Y, SafeWidth, SafeHeight, IntToReal(SafeHeight) *
                                                                                    TerminalAspectCorrection))
          end
        end
      end
    end
  end;

  return TuiCellGrid.Create(SafeWidth, SafeHeight, Cells)
end;
