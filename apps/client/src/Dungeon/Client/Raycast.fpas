// Pure terminal raycasting for validated first-person protocol states.
unit Dungeon.Client.Raycast;

uses Dungeon.Protocol, Std.Arrays, Std.Conv, Std.Math, Std.Str, Std.Tui;

public type
  // Nearest wall intersection for one camera-plane ray.
  FirstPersonRayHit = record
    // Perpendicular grid distance used for perspective-correct wall height.
    public Distance: real;
    // Client-safe code of the intersected opaque field.
    public FieldCode: string;
    // Whether the ray crossed a vertical wall plane rather than a horizontal one.
    public VerticalSide: boolean;
    // Whether the ray crossed the traversable exit before reaching the wall.
    public SawExit: boolean;
    // Hit position along the wall face, from 0 inclusive to 1 exclusive; drives the wall texture.
    public WallX: real;
    // Grid coordinate of the intersected field; keeps texture variation stable per wall field.
    public MapX: integer;
    public MapY: integer;
  end;

const
  // A 90-degree horizontal projection exposes immediate left/right branches.
  CameraPlaneScale: real := 1.0;
  // Visual eye only: remains inside the occupied field, even with a wall behind.
  CameraBackOffset: real := 0.35;
  MinimumRayDistance: real := 0.0001;
  TerminalAspectCorrection: real := 0.58;

function FieldAt(Value: FirstPersonVisibleState; X: integer; Y: integer): string;
begin
  if ((X < 0) or (X >= Value.Width)) or ((Y < 0) or (Y >= Value.Height)) then
  begin
    return InteriorWallCode
  end;

  // Exploration memory belongs to the map, not current first-person sight.
  // Stop rays and floor samples at the server's visibility boundary, regardless
  // of the geometry or items retained in remembered fields.
  if Std.Str.CharAt(Value.KnowledgeRows[Y], X) <> KnowledgeVisibleCode then
  begin
    return UnknownFieldCode
  end;

  return Std.Str.CharAt(Value.Rows[Y], X)
end;

function IsOpaqueCode(Code: string): boolean;
begin
  return ((Code = InteriorWallCode) or (Code = UnknownFieldCode)) or (Code = InteriorTabletCode)
end;

function CameraDirection(Value: FirstPersonFacing): array of real;
begin
  case Value of
    FirstPersonFacing.North:
    begin
      return [0.0, -1.0, CameraPlaneScale, 0.0]
    end;
    FirstPersonFacing.East:
    begin
      return [1.0, 0.0, 0.0, CameraPlaneScale]
    end;
    FirstPersonFacing.South:
    begin
      return [0.0, 1.0, - CameraPlaneScale, 0.0]
    end;
    FirstPersonFacing.West:
    begin
      return [-1.0, 0.0, 0.0, - CameraPlaneScale]
    end
  end
end;

// Casts one ray through camera-plane coordinate -1 through 1 in a validated state.
// Distance is measured from the rearward rendering eye, not the gameplay field center.
public function CastFirstPersonRay(Value: FirstPersonVisibleState; CameraX: real): FirstPersonRayHit;
begin
  var Camera: array of real := CameraDirection(Value.Facing);
  var PositionX: real := (IntToReal(Value.PlayerX) + 0.5) - Camera[0] * CameraBackOffset;
  var PositionY: real := (IntToReal(Value.PlayerY) + 0.5) - Camera[1] * CameraBackOffset;
  var RayDirectionX: real := Camera[0] + (Camera[2] * CameraX);
  var RayDirectionY: real := Camera[1] + (Camera[3] * CameraX);
  mutable var MapX: integer := Value.PlayerX;
  mutable var MapY: integer := Value.PlayerY;
  mutable var DeltaDistanceX: real := 1000000.0;
  mutable var DeltaDistanceY: real := 1000000.0;
  if RayDirectionX <> 0.0 then
  begin
    DeltaDistanceX := Std.Math.Abs(1.0 / RayDirectionX)
  end;

  if RayDirectionY <> 0.0 then
  begin
    DeltaDistanceY := Std.Math.Abs(1.0 / RayDirectionY)
  end;
  mutable var StepX: integer := 1;
  mutable var SideDistanceX: real := (IntToReal(MapX + 1) - PositionX) * DeltaDistanceX;
  if RayDirectionX < 0.0 then
  begin
    StepX := -1;
    SideDistanceX := (PositionX - IntToReal(MapX)) * DeltaDistanceX
  end;
  mutable var StepY: integer := 1;
  mutable var SideDistanceY: real := (IntToReal(MapY + 1) - PositionY) * DeltaDistanceY;
  if RayDirectionY < 0.0 then
  begin
    StepY := -1;
    SideDistanceY := (PositionY - IntToReal(MapY)) * DeltaDistanceY
  end;
  mutable var VerticalSide: boolean := false;
  mutable var Hit: boolean := false;
  mutable var FieldCode: string := InteriorWallCode;
  mutable var SawExit: boolean := false;
  mutable var Iterations: integer := 0;
  while (not Hit) and (Iterations <= (Value.Width * Value.Height) + 1) do
  begin
    if SideDistanceX < SideDistanceY then
    begin
      SideDistanceX := SideDistanceX + DeltaDistanceX;
      MapX := MapX + StepX;
      VerticalSide := true
    end
    else
    begin
      SideDistanceY := SideDistanceY + DeltaDistanceY;
      MapY := MapY + StepY;
      VerticalSide := false
    end;

    FieldCode := FieldAt(Value, MapX, MapY);
    if FieldCode = InteriorExitCode then
    begin
      SawExit := true
    end;

    Hit := IsOpaqueCode(FieldCode);
    Iterations := Iterations + 1
  end;
  mutable var Distance: real := SideDistanceY - DeltaDistanceY;
  mutable var WallX: real := PositionX + Distance * RayDirectionX;
  if VerticalSide then
  begin
    Distance := SideDistanceX - DeltaDistanceX;
    WallX := PositionY + Distance * RayDirectionY
  end;

  if Distance < MinimumRayDistance then
  begin
    Distance := MinimumRayDistance
  end;

  return record
    Distance := Distance;
    FieldCode := FieldCode;
    VerticalSide := VerticalSide;
    SawExit := SawExit;
    WallX := WallX - IntToReal(Std.Math.Floor(WallX));
    MapX := MapX;
    MapY := MapY;
  end
end;

// Packs one RGB color into a single integer pixel value.
function Rgb(Red: integer; Green: integer; Blue: integer): integer;
begin
  return ((Red * 65536) + (Green * 256)) + Blue
end;

function PixelColor(Pixel: integer): TuiColor;
begin
  return TuiColor.FromRgb(Pixel div 65536, (Pixel div 256) mod 256, Pixel mod 256)
end;

// Scales a packed color toward black; Numerator / Denominator is at most one.
function Darken(Pixel: integer; Numerator: integer; Denominator: integer): integer;
begin
  return Rgb(((Pixel div 65536) * Numerator) div Denominator, (((Pixel div 256) mod 256) * Numerator) div
                                                              Denominator, ((Pixel mod 256) * Numerator) div
                                                                           Denominator)
end;

// Combines two stacked pixels into one terminal cell; equal halves stay a plain space.
function HalfBlockCell(Upper: integer; Lower: integer): TuiCell;
begin
  if Upper = Lower then
  begin
    var Color: TuiColor := PixelColor(Upper);
    return TuiCell.Styled(' ', TuiStyle.FromColors(Color, Color))
  end;

  return TuiCell.Styled('▀', TuiStyle.FromColors(PixelColor(Upper), PixelColor(Lower)))
end;

const
  // Packed RGB values of the fixed ceiling, floor, exit floor, and unknown-space colors.
  CeilingPixel: integer := 790553;
  FloorPixel: integer := 2499103;
  ExitFloorPixel: integer := 6046740;
  UnknownPixel: integer := 1185049;

// Distance- and side-shaded base color of stone walls.
function StonePixel(Hit: FirstPersonRayHit): integer;
begin
  mutable var Shade: integer := 218 - Trunc(Hit.Distance * 22.0);
  Shade := Std.Math.Clamp(Shade, 48, 218);
  if Hit.VerticalSide then
  begin
    Shade := (Shade * 4) div 5
  end;

  return Rgb(Shade, (Shade * 9) div 10, (Shade * 4) div 5)
end;

// Distance- and side-shaded slate color of the inspectable tablet.
function SlatePixel(Hit: FirstPersonRayHit): integer;
begin
  mutable var TabletShade: integer := 188 - Trunc(Hit.Distance * 16.0);
  TabletShade := Std.Math.Clamp(TabletShade, 72, 188);
  if Hit.VerticalSide then
  begin
    TabletShade := (TabletShade * 4) div 5
  end;

  return Rgb((TabletShade * 3) div 5, (TabletShade * 4) div 5, TabletShade)
end;

function Fraction(Value: real): real;
begin
  return Value - IntToReal(Std.Math.Floor(Value))
end;

// Deterministic 0..12 variation per stone so identical wall fields always look the same.
function StoneVariation(Hit: FirstPersonRayHit; Course: integer; Stone: integer): integer;
begin
  mutable var Side: integer := 0;
  if Hit.VerticalSide then
  begin
    Side := 1
  end;
  var Mixed: integer := ((((Hit.MapX * 92821) + (Hit.MapY * 68917)) + (Course * 1193)) + (Stone * 409)) +
                        (Side * 7);
  return ((Mixed mod 13) + 13) mod 13
end;

// Masonry with four staggered courses and two stones per field; V runs 0..1 down the wall.
// Mortar joints appear only while the wall is tall enough to show them without flicker.
function StoneTexel(Hit: FirstPersonRayHit; V: real; WallHeight: integer): integer;
begin
  var Base: integer := StonePixel(Hit);
  var Course: integer := Std.Math.Clamp(Std.Math.Floor(V * 4.0), 0, 3);
  var Along: real := (Hit.WallX * 2.0) + (IntToReal(Course mod 2) * 0.5);
  var Stone: integer := Std.Math.Floor(Along);
  if WallHeight >= 12 then
  begin
    if (Fraction(V * 4.0) < 0.09) or (Fraction(Along) < 0.05) then
    begin
      return Darken(Base, 62, 100)
    end
  end;

  return Darken(Base, 90 + StoneVariation(Hit, Course, Stone), 102)
end;

// Stone wall with an inset, framed slate panel carrying engraved lines.
function TabletTexel(Hit: FirstPersonRayHit; V: real; WallHeight: integer): integer;
begin
  if ((Hit.WallX < 0.2) or (Hit.WallX > 0.8)) or ((V < 0.26) or (V > 0.74)) then
  begin
    return StoneTexel(Hit, V, WallHeight)
  end;
  var Slate: integer := SlatePixel(Hit);
  if ((Hit.WallX < 0.24) or (Hit.WallX > 0.76)) or ((V < 0.3) or (V > 0.7)) then
  begin
    return Darken(Slate, 55, 100)
  end;

  if (WallHeight >= 16) and
     (((Hit.WallX > 0.3) and (Hit.WallX < 0.7)) and (Fraction(V * 10.0) < 0.18)) then
  begin
    return Darken(Slate, 72, 100)
  end;

  return Slate
end;

function WallTexel(Hit: FirstPersonRayHit; V: real; WallHeight: integer): integer;
begin
  if Hit.FieldCode = UnknownFieldCode then
  begin
    return UnknownPixel
  end;

  if Hit.FieldCode = InteriorTabletCode then
  begin
    return TabletTexel(Hit, V, WallHeight)
  end;

  return StoneTexel(Hit, V, WallHeight)
end;

// Torchlight falloff for floor and ceiling: full color near the eye, darker with depth.
function Lit(Pixel: integer; Distance: real): integer;
begin
  if Distance <= 1.5 then
  begin
    return Pixel
  end;
  var Light: integer := Std.Math.Clamp(100 - Trunc((Distance - 1.5) * 11.0), 34, 100);
  return Darken(Pixel, Light, 100)
end;

type
  // Rendering eye and camera shared by walls, floor, and sprites of one frame.
  FirstPersonCamera = record
    EyeX: real;
    EyeY: real;
    DirectionX: real;
    DirectionY: real;
    PlaneX: real;
    PlaneY: real;
  end;
  // One upright billboard: pixel art standing on the floor at a field center.
  Sprite = record
    WorldX: real;
    WorldY: real;
    // Field-relative height of the figure; width follows the art's aspect ratio.
    HeightFraction: real;
    Art: array of string;
  end;

function FrameCamera(Value: FirstPersonVisibleState): FirstPersonCamera;
begin
  var Camera: array of real := CameraDirection(Value.Facing);
  return record
    EyeX := (IntToReal(Value.PlayerX) + 0.5) - Camera[0] * CameraBackOffset;
    EyeY := (IntToReal(Value.PlayerY) + 0.5) - Camera[1] * CameraBackOffset;
    DirectionX := Camera[0];
    DirectionY := Camera[1];
    PlaneX := Camera[2];
    PlaneY := Camera[3];
  end
end;

// Projects one floor pixel onto its field; exits color only their floor.
// Unknown samples and samples behind opaque geometry reveal no material.
function ProjectFloorPixel(
  Value: FirstPersonVisibleState;
  Camera: FirstPersonCamera;
  CameraX: real;
  Distance: real;
  WallDistance: real
): integer;
begin
  if Distance >= WallDistance then
  begin
    return Lit(FloorPixel, Distance)
  end;
  var FloorX: real := Camera.EyeX + Distance * (Camera.DirectionX + Camera.PlaneX * CameraX);
  var FloorY: real := Camera.EyeY + Distance * (Camera.DirectionY + Camera.PlaneY * CameraX);
  var Code: string := FieldAt(Value, Std.Math.Floor(FloorX), Std.Math.Floor(FloorY));
  if Code = UnknownFieldCode then
  begin
    return UnknownPixel
  end;
  mutable var Material: integer := FloorPixel;
  if Code = InteriorExitCode then
  begin
    Material := ExitFloorPixel
  end;

  // One flagstone per field, so joints never run down a corridor's center; they fade
  // out before they would alias with distance.
  if Distance < 3.5 then
  begin
    var JointX: real := Fraction(FloorX);
    var JointY: real := Fraction(FloorY);
    if ((JointX < 0.03) or (JointX > 0.97)) or ((JointY < 0.03) or (JointY > 0.97)) then
    begin
      Material := Darken(Material, 74, 100)
    end
  end;

  return Lit(Material, Distance)
end;

// Old adventurer: hood, face, cloak with rope belt, lantern at her side, and walking staff.
function NpcArt(): array of string;
begin
  return [
           '....hHHh....',
           '...hHHHHh...',
           '..hHHHHHHh..',
           '..hHFFFFHh..',
           '..hFEFFEFh..',
           '..hFFFFFFh..',
           '...hFFFFh...',
           '..cCCCCCCc.S',
           '.cCCCCCCCCcS',
           '.cCCCCCCCCcS',
           '.cCCRRRRCCcS',
           'MCCCCCCCCCcS',
           'LCCCCCCCCCcS',
           'LcCCCCCCCCcS',
           'McCCCCCCCCcS',
           '.cCCCCCCCCcS',
           '.cCCCCCCCCcS',
           '.cCCCCCCCCCS',
           '..cCCCCCCCcS',
           '..BBB..BBB.S'
         ]
end;

// Ancient coin lying on the floor.
function ItemArt(): array of string;
begin
  return ['.oOOo.', 'oOYYOo', '.oOOo.']
end;

// Maps one art character to a packed color; zero marks a transparent pixel.
function ArtPixel(Code: string): integer;
begin
  case Code of
    'h':
    begin
      return Rgb(58, 40, 82)
    end;
    'H':
    begin
      return Rgb(96, 70, 132)
    end;
    'F':
    begin
      return Rgb(214, 170, 130)
    end;
    'E':
    begin
      return Rgb(40, 28, 24)
    end;
    'C':
    begin
      return Rgb(112, 84, 146)
    end;
    'c':
    begin
      return Rgb(72, 52, 100)
    end;
    'R':
    begin
      return Rgb(176, 144, 92)
    end;
    'S':
    begin
      return Rgb(128, 88, 50)
    end;
    'M':
    begin
      return Rgb(96, 86, 74)
    end;
    'L':
    begin
      return Rgb(255, 214, 110)
    end;
    'B':
    begin
      return Rgb(62, 46, 36)
    end;
    'o':
    begin
      return Rgb(150, 110, 30)
    end;
    'O':
    begin
      return Rgb(230, 180, 60)
    end;
    'Y':
    begin
      return Rgb(255, 235, 140)
    end
    else
    begin
      return 0
    end
  end
end;

// Collects visible NPC and item fields as billboards.
function VisibleSprites(Value: FirstPersonVisibleState): array of Sprite;
begin
  mutable var Sprites: array of Sprite := [];
  for Y: integer := 0 to Value.Height - 1 do
  begin
    for X: integer := 0 to Value.Width - 1 do
    begin
      var Code: string := FieldAt(Value, X, Y);
      if Code = InteriorNpcCode then
      begin
        Std.Arrays.Push(Sprites, record
          WorldX := IntToReal(X) + 0.5;
          WorldY := IntToReal(Y) + 0.5;
          HeightFraction := 0.86;
          Art := NpcArt();
        end)
      end;

      if Code = InteriorItemCode then
      begin
        Std.Arrays.Push(Sprites, record
          WorldX := IntToReal(X) + 0.5;
          WorldY := IntToReal(Y) + 0.5;
          HeightFraction := 0.1;
          Art := ItemArt();
        end)
      end
    end
  end;

  return Sprites
end;

// Returns the sprite's depth along the view direction; values near zero are behind the eye.
function SpriteDepth(Camera: FirstPersonCamera; Item: Sprite): real;
begin
  var RelativeX: real := Item.WorldX - Camera.EyeX;
  var RelativeY: real := Item.WorldY - Camera.EyeY;
  var InverseDeterminant: real := 1.0 /
                                  ((Camera.PlaneX * Camera.DirectionY) - (Camera.DirectionX * Camera.PlaneY));
  return InverseDeterminant * ((- Camera.PlaneY * RelativeX) + (Camera.PlaneX * RelativeY))
end;

// Draws one billboard into the pixel buffer, hidden behind nearer walls.
function DrawSprite(
  Pixels: array of integer;
  Depths: array of real;
  Camera: FirstPersonCamera;
  Item: Sprite;
  Width: integer;
  PixelHeight: integer
): array of integer;
begin
  mutable var Drawn: array of integer := Pixels;
  var RelativeX: real := Item.WorldX - Camera.EyeX;
  var RelativeY: real := Item.WorldY - Camera.EyeY;
  var InverseDeterminant: real := 1.0 /
                                  ((Camera.PlaneX * Camera.DirectionY) - (Camera.DirectionX * Camera.PlaneY));
  var Lateral: real := InverseDeterminant *
                       ((Camera.DirectionY * RelativeX) - (Camera.DirectionX * RelativeY));
  var Depth: real := SpriteDepth(Camera, Item);
  if Depth < 0.2 then
  begin
    return Drawn
  end;
  var ArtHeight: integer := Std.Arrays.Length(Item.Art);
  var ArtWidth: integer := Std.Str.Length(Item.Art[0]);
  var FieldHeight: real := (IntToReal(PixelHeight) * TerminalAspectCorrection) / Depth;
  var FloorLine: real := (IntToReal(PixelHeight) + FieldHeight) / 2.0;
  var SpriteHeight: real := FieldHeight * Item.HeightFraction;
  var SpriteWidth: real := (SpriteHeight * IntToReal(ArtWidth)) / IntToReal(ArtHeight);
  var CenterX: real := (IntToReal(Width - 1) / 2.0) * (1.0 + (Lateral / Depth));
  var Left: real := CenterX - (SpriteWidth / 2.0);
  var Top: real := FloorLine - SpriteHeight;
  // Distance darkening matches the wall falloff so figures sit in the same light.
  var Light: integer := Std.Math.Clamp(218 - Trunc(Depth * 22.0), 96, 218);
  var FirstColumn: integer := Std.Math.Max(0, Std.Math.Floor(Left));
  var LastColumn: integer := Std.Math.Min(Width - 1, Std.Math.Floor(Left + SpriteWidth));
  var FirstRow: integer := Std.Math.Max(0, Std.Math.Floor(Top));
  var LastRow: integer := Std.Math.Min(PixelHeight - 1, Std.Math.Floor(FloorLine));
  for Column: integer := FirstColumn to LastColumn do
  begin
    if Depth < Depths[Column] then
    begin
      var ArtX: integer := Trunc((((IntToReal(Column) + 0.5) - Left) * IntToReal(ArtWidth)) /
                                 SpriteWidth);
      if (ArtX >= 0) and (ArtX < ArtWidth) then
      begin
        for Row: integer := FirstRow to LastRow do
        begin
          var ArtY: integer := Trunc((((IntToReal(Row) + 0.5) - Top) * IntToReal(ArtHeight)) /
                                     SpriteHeight);
          if (ArtY >= 0) and (ArtY < ArtHeight) then
          begin
            var Color: integer := ArtPixel(Std.Str.CharAt(Item.Art[ArtY], ArtX));
            if Color <> 0 then
            begin
              Drawn[(Row * Width) + Column] := Darken(Color, Light, 218)
            end
          end
        end
      end
    end
  end;

  return Drawn
end;

// Renders walls, floor, and upright sprites at two pixels per terminal cell.
// One ray per column feeds both the wall slice and the depth buffer used for occlusion.
public function RenderFirstPersonGrid(Value: FirstPersonVisibleState; Width: integer; Height: integer): TuiCellGrid;
begin
  var SafeWidth: integer := Std.Math.Max(0, Width);
  var SafeHeight: integer := Std.Math.Max(0, Height);
  var PixelHeight: integer := SafeHeight * 2;
  var Scale: real := IntToReal(PixelHeight) * TerminalAspectCorrection;
  var Camera: FirstPersonCamera := FrameCamera(Value);
  mutable var Pixels: array of integer := Std.Arrays.Fill(CeilingPixel, SafeWidth * PixelHeight);
  mutable var Depths: array of real := [];
  for X: integer := 0 to SafeWidth - 1 do
  begin
    mutable var CameraX: real := 0.0;
    if SafeWidth > 1 then
    begin
      CameraX := ((2.0 * IntToReal(X)) / IntToReal(SafeWidth - 1)) - 1.0
    end;
    var Hit: FirstPersonRayHit := CastFirstPersonRay(Value, CameraX);
    Std.Arrays.Push(Depths, Hit.Distance);
    var ProjectedHeight: real := Scale / Hit.Distance;
    var WallHeight: integer := Std.Math.Clamp(Trunc(ProjectedHeight), 1, PixelHeight);
    var WallTop: integer := (PixelHeight - WallHeight) div 2;
    var WallBottom: integer := WallTop + WallHeight;
    // Texture rows follow the unclipped projection so close walls keep a stable pattern.
    var ProjectedTop: real := (IntToReal(PixelHeight) - ProjectedHeight) / 2.0;
    for Y: integer := 0 to WallTop - 1 do
    begin
      var CeilingDenominator: integer := (PixelHeight - (2 * Y)) - 1;
      if CeilingDenominator > 0 then
      begin
        Pixels[(Y * SafeWidth) + X] := Lit(CeilingPixel, Scale / IntToReal(CeilingDenominator))
      end
    end;

    for Y: integer := WallTop to WallBottom - 1 do
    begin
      var V: real := ((IntToReal(Y) + 0.5) - ProjectedTop) / ProjectedHeight;
      Pixels[(Y * SafeWidth) + X] := WallTexel(Hit, V, WallHeight)
    end;

    for Y: integer := WallBottom to PixelHeight - 1 do
    begin
      var Denominator: integer := (2 * Y - PixelHeight) + 1;
      mutable var Floor: integer := Lit(FloorPixel, 1000.0);
      if Denominator > 0 then
      begin
        Floor := ProjectFloorPixel(Value, Camera, CameraX, Scale / IntToReal(Denominator), Hit.Distance)
      end;

      Pixels[(Y * SafeWidth) + X] := Floor
    end
  end;
  // Painter's order: far sprites first so nearer figures cover them.
  mutable var Remaining: array of Sprite := VisibleSprites(Value);
  while Std.Arrays.Length(Remaining) > 0 do
  begin
    mutable var Farthest: integer := 0;
    for Index: integer := 1 to Std.Arrays.Length(Remaining) - 1 do
    begin
      if SpriteDepth(Camera, Remaining[Index]) > SpriteDepth(Camera, Remaining[Farthest]) then
      begin
        Farthest := Index
      end
    end;

    Pixels := DrawSprite(Pixels, Depths, Camera, Remaining[Farthest], SafeWidth, PixelHeight);
    Remaining := Std.Arrays.Concat(Std.Arrays.Slice(Remaining, 0, Farthest), Std.Arrays.Slice(Remaining, Farthest +
                                                                                                         1, (Std.Arrays.Length(Remaining) - Farthest) -
                                                                                                            1))
  end;
  mutable var Cells: array of TuiCell := [];
  for Y: integer := 0 to SafeHeight - 1 do
  begin
    for X: integer := 0 to SafeWidth - 1 do
    begin
      Std.Arrays.Push(Cells, HalfBlockCell(Pixels[((2 * Y) * SafeWidth) + X], Pixels[(((2 * Y) + 1) * SafeWidth) +
                                                                                     X]))
    end
  end;

  return TuiCellGrid.Create(SafeWidth, SafeHeight, Cells)
end;
