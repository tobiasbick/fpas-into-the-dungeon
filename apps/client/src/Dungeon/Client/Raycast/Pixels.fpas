// Packed RGB pixels, distance lighting, and half-block terminal cells.
unit Dungeon.Client.Raycast.Pixels;

uses Std.Math as Math, Std.Tui as Tui;

// Packed RGB values of the fixed ceiling, floor, exit floor, and unknown-space colors.
public const CeilingPixel: integer := 790553;
public const FloorPixel: integer := 2499103;
public const ExitFloorPixel: integer := 6046740;
public const UnknownPixel: integer := 1185049;

// Packs one RGB color into a single integer pixel value.
public function Rgb(Red: integer; Green: integer; Blue: integer): integer;
begin
  return ((Red * 65536) + (Green * 256)) + Blue;
end function;

function PixelColor(Pixel: integer): Tui.TuiColor;
begin
  return Tui.TuiColor.FromRgb(Pixel div 65536, (Pixel div 256) mod 256, Pixel mod 256);
end function;

// Scales a packed color toward black; Numerator / Denominator is at most one.
public function Darken(Pixel: integer; Numerator: integer; Denominator: integer): integer;
begin
  return Rgb(
    ((Pixel div 65536) * Numerator) div Denominator, (((Pixel div 256) mod 256) * Numerator) div
    Denominator, ((Pixel mod 256) * Numerator) div
    Denominator
  );
end function;

// Combines two stacked pixels into one terminal cell; equal halves stay a plain space.
public function HalfBlockCell(Upper: integer; Lower: integer): Tui.TuiCell;
begin
  if Upper = Lower then
    begin
      const Color: Tui.TuiColor := PixelColor(Upper);
      return Tui.TuiCell.Styled(' ', Tui.TuiStyle.FromColors(Color, Color));
    end;
  end if;

  return Tui.TuiCell.Styled('▀', Tui.TuiStyle.FromColors(PixelColor(Upper), PixelColor(Lower)));
end function;

// Torchlight falloff for floor and ceiling: full color near the eye, darker with depth.
public function Lit(Pixel: integer; Distance: real): integer;
begin
  if Distance <= 1.5 then
    begin
      return Pixel;
    end;
  end if;
  const Light: integer := Math.Clamp(100 - Math.Trunc((Distance - 1.5) * 11.0), 34, 100);
  return Darken(Pixel, Light, 100);
end function;
end unit;
