// Pixel art of figures and floor items and its color palette.
unit Dungeon.Client.Raycast.Art;

uses Dungeon.Client.Raycast.Pixels;

// Restless skeleton: skull with dark sockets, ribs, a notched blade, and bony legs.
public function HostileArt(): array of string;
begin
  return [
           '...WWWW.....',
           '..WWWWWW....',
           '..WkWWkW....',
           '..WWWWWW....',
           '...WkkW.....',
           '....WW....r.',
           '.WWWWWWWW.r.',
           'W.WkWWkW.Wr.',
           'W.WWWWWW.Wr.',
           'W..WkkW..rrr',
           'W..WWWW...W.',
           '...WkkW.....',
           '...WWWW.....',
           '...W..W.....',
           '..WW..WW....',
           '..W....W....',
           '..W....W....',
           '..W....W....',
           '.WW....WW...',
           'WWW....WWW..'
         ];
end function;

// Ancient coin lying on the floor.
public function ItemArt(): array of string;
begin
  return ['.oOOo.', 'oOYYOo', '.oOOo.'];
end function;

// Rusty short sword lying on the floor: leather grip, crossguard, and a rust-spotted blade.
public function WeaponArt(): array of string;
begin
  return ['..M...........', 'SSMsssussssuss', 'SSMssssssusss.', '..M...........'];
end function;

// Folded leather jerkin lying on the floor.
public function ArmorArt(): array of string;
begin
  return ['.jj....jj.', 'jJJjjjjJJj', 'jJJJddJJJj', '.jJJJJJJj.', '.jjjjjjjj.'];
end function;

// Maps one art character to a packed color; zero marks a transparent pixel.
public function ArtPixel(Code: string): integer;
begin
  case Code of
    when 'S':
      begin
        return Rgb(128, 88, 50);
      end;
    when 'M':
      begin
        return Rgb(96, 86, 74);
      end;
    when 'o':
      begin
        return Rgb(150, 110, 30);
      end;
    when 'O':
      begin
        return Rgb(230, 180, 60);
      end;
    when 'Y':
      begin
        return Rgb(255, 235, 140);
      end;
    when 'W':
      begin
        return Rgb(226, 220, 196);
      end;
    when 'k':
      begin
        return Rgb(34, 26, 24);
      end;
    when 'r':
      begin
        return Rgb(150, 92, 60);
      end;
    when 's':
      begin
        return Rgb(172, 178, 184);
      end;
    when 'u':
      begin
        return Rgb(150, 82, 40);
      end;
    when 'j':
      begin
        return Rgb(110, 72, 40);
      end;
    when 'J':
      begin
        return Rgb(156, 106, 62);
      end;
    when 'd':
      begin
        return Rgb(66, 42, 24);
      end;
    else
      begin
        return 0;
      end;
  end case;
end function;
end unit;
