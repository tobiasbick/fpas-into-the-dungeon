// Camera setup and grid ray casting against the projected first-person rows.
unit Dungeon.Client.Raycast.Rays;

uses Dungeon.Protocol as Protocol, Std.Conv as Conv, Std.Math as Math;

// Nearest wall intersection for one camera-plane ray.
public type FirstPersonRayHit = record
  // Perpendicular grid distance used for perspective-correct wall height.
  public Distance: real;
  // Client-safe code of the intersected opaque field.
  public FieldCode: string;
  // Whether the ray crossed a vertical wall plane rather than a horizontal one.
  public VerticalSide: boolean;
  // Hit position along the wall face, from 0 inclusive to 1 exclusive; drives the wall texture.
  public WallX: real;
  // Grid coordinate of the intersected field; keeps texture variation stable per wall field.
  public MapX: integer;
  public MapY: integer;
end record;

// Rendering eye and camera shared by walls, floor, and sprites of one frame.
public type FirstPersonCamera = record
  public EyeX: real;
  public EyeY: real;
  public DirectionX: real;
  public DirectionY: real;
  public PlaneX: real;
  public PlaneY: real;
end record;

// A 90-degree horizontal projection exposes immediate left/right branches.
public const CameraPlaneScale: real := 1.0;
// Visual eye only: remains inside the occupied field, even with a wall behind.
public const CameraBackOffset: real := 0.35;
// Lower bound of ray distances; avoids division by zero at the eye.
public const MinimumRayDistance: real := 0.0001;
// Terminal cells are taller than wide; scales projected heights to look square.
public const TerminalAspectCorrection: real := 0.58;

// Returns the code of one field; outside the area it is a wall, outside current sight unknown.
public function FieldAt(Value: Protocol.FirstPersonVisibleState; X: integer; Y: integer): string;
begin
  if ((X < 0) or (X >= Value.Width)) or ((Y < 0) or (Y >= Value.Height)) then
    begin
      return Protocol.InteriorWallCode;
    end;
  end if;

  // Exploration memory belongs to the map, not current first-person sight.
  // Stop rays and floor samples at the server's visibility boundary, regardless
  // of the geometry or items retained in remembered fields.
  if Value.KnowledgeRows[Y][X] <> Protocol.KnowledgeVisibleCode then
    begin
      return Protocol.UnknownFieldCode;
    end;
  end if;

  return Value.Rows[Y][X];
end function;

function IsOpaqueCode(Code: string): boolean;
begin
  return (Code = Protocol.InteriorWallCode) or (Code = Protocol.UnknownFieldCode);
end function;

function CameraDirection(Value: Protocol.FirstPersonFacing): array of real;
begin
  case Value of
    when Protocol.FirstPersonFacing.North:
      begin
        return [0.0, -1.0, CameraPlaneScale, 0.0];
      end;
    when Protocol.FirstPersonFacing.East:
      begin
        return [1.0, 0.0, 0.0, CameraPlaneScale];
      end;
    when Protocol.FirstPersonFacing.South:
      begin
        return [0.0, 1.0, - CameraPlaneScale, 0.0];
      end;
    when Protocol.FirstPersonFacing.West:
      begin
        return [-1.0, 0.0, 0.0, - CameraPlaneScale];
      end;
  end case;
end function;

// Casts one ray through camera-plane coordinate -1 through 1 in a validated state.
// Distance is measured from the rearward rendering eye, not the gameplay field center.
public function CastFirstPersonRay(Value: Protocol.FirstPersonVisibleState; CameraX: real): FirstPersonRayHit;
begin
  const Camera: array of real := CameraDirection(Value.Facing);
  const PositionX: real := (Conv.IntToReal(Value.PlayerX) + 0.5) - Camera[0] * CameraBackOffset;
  const PositionY: real := (Conv.IntToReal(Value.PlayerY) + 0.5) - Camera[1] * CameraBackOffset;
  const RayDirectionX: real := Camera[0] + (Camera[2] * CameraX);
  const RayDirectionY: real := Camera[1] + (Camera[3] * CameraX);
  var MapX: integer := Value.PlayerX;
  var MapY: integer := Value.PlayerY;
  var DeltaDistanceX: real := 1000000.0;
  var DeltaDistanceY: real := 1000000.0;
  if RayDirectionX <> 0.0 then
    begin
      DeltaDistanceX := Math.Abs(1.0 / RayDirectionX);
    end;
  end if;

  if RayDirectionY <> 0.0 then
    begin
      DeltaDistanceY := Math.Abs(1.0 / RayDirectionY);
    end;
  end if;
  var StepX: integer := 1;
  var SideDistanceX: real := (Conv.IntToReal(MapX + 1) - PositionX) * DeltaDistanceX;
  if RayDirectionX < 0.0 then
    begin
      StepX := -1;
      SideDistanceX := (PositionX - Conv.IntToReal(MapX)) * DeltaDistanceX;
    end;
  end if;
  var StepY: integer := 1;
  var SideDistanceY: real := (Conv.IntToReal(MapY + 1) - PositionY) * DeltaDistanceY;
  if RayDirectionY < 0.0 then
    begin
      StepY := -1;
      SideDistanceY := (PositionY - Conv.IntToReal(MapY)) * DeltaDistanceY;
    end;
  end if;
  var VerticalSide: boolean := false;
  var Hit: boolean := false;
  var FieldCode: string := Protocol.InteriorWallCode;
  var Iterations: integer := 0;
  while (not Hit) and (Iterations <= (Value.Width * Value.Height) + 1) do
    begin
      if SideDistanceX < SideDistanceY then
        begin
          SideDistanceX := SideDistanceX + DeltaDistanceX;
          MapX := MapX + StepX;
          VerticalSide := true;
        end;
      else
        begin
          SideDistanceY := SideDistanceY + DeltaDistanceY;
          MapY := MapY + StepY;
          VerticalSide := false;
        end;
      end if;

      FieldCode := FieldAt(Value, MapX, MapY);
      Hit := IsOpaqueCode(FieldCode);
      Iterations := Iterations + 1;
    end;
  end while;
  var Distance: real := SideDistanceY - DeltaDistanceY;
  var WallX: real := PositionX + Distance * RayDirectionX;
  if VerticalSide then
    begin
      Distance := SideDistanceX - DeltaDistanceX;
      WallX := PositionY + Distance * RayDirectionY;
    end;
  end if;

  if Distance < MinimumRayDistance then
    begin
      Distance := MinimumRayDistance;
    end;
  end if;

  return FirstPersonRayHit(
    Distance := Distance, FieldCode := FieldCode, VerticalSide := VerticalSide,
    WallX := WallX -
    Conv.IntToReal(Math.Floor(WallX)), MapX := MapX, MapY := MapY
  );
end function;

// Returns the rendering eye and camera plane of one first-person state.
public function FrameCamera(Value: Protocol.FirstPersonVisibleState): FirstPersonCamera;
begin
  const Camera: array of real := CameraDirection(Value.Facing);
  return FirstPersonCamera(
    EyeX := (Conv.IntToReal(Value.PlayerX) + 0.5) - Camera[0] * CameraBackOffset,
    EyeY := (Conv.IntToReal(Value.PlayerY) + 0.5) -
    Camera[1] * CameraBackOffset, DirectionX := Camera[0], DirectionY := Camera[1],
    PlaneX := Camera[2], PlaneY := Camera[3]
  );
end function;
end unit;
