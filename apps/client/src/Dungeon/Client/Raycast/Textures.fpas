// Masonry wall textures and projected floor materials.
unit Dungeon.Client.Raycast.Textures;

uses Dungeon.Client.Raycast.Pixels as PixelOps, Dungeon.Client.Raycast.Rays as Rays, Dungeon.Protocol as Protocol, Std.Math as Math;

// Distance- and side-shaded base color of stone walls.
function StonePixel(Hit: Rays.FirstPersonRayHit): integer;
begin
  var Shade: integer := 218 - Math.Trunc(Hit.Distance * 22.0);
  Shade := Math.Clamp(Shade, 48, 218);
  if Hit.VerticalSide then
    begin
      Shade := (Shade * 4) div 5;
    end;
  end if;

  return PixelOps.Rgb(Shade, (Shade * 9) div 10, (Shade * 4) div 5);
end function;

function Fraction(Value: real): real;
begin
  return Value - Math.IntToReal(Math.Floor(Value));
end function;

// Deterministic 0..12 variation per stone so identical wall fields always look the same.
function StoneVariation(Hit: Rays.FirstPersonRayHit; Course: integer; Stone: integer): integer;
begin
  var Side: integer := 0;
  if Hit.VerticalSide then
    begin
      Side := 1;
    end;
  end if;
  const Mixed: integer := (
    (((Hit.MapX * 92821) + (Hit.MapY * 68917)) + (Course * 1193)) + (Stone * 409)
  ) +
    (Side * 7);
  return ((Mixed mod 13) + 13) mod 13;
end function;

// Masonry with four staggered courses and two stones per field; V runs 0..1 down the wall.
// Mortar joints appear only while the wall is tall enough to show them without flicker.
function StoneTexel(Hit: Rays.FirstPersonRayHit; V: real; WallHeight: integer): integer;
begin
  const Base: integer := StonePixel(Hit);
  const Course: integer := Math.Clamp(Math.Floor(V * 4.0), 0, 3);
  const Along: real := (Hit.WallX * 2.0) + (Math.IntToReal(Course mod 2) * 0.5);
  const Stone: integer := Math.Floor(Along);
  if WallHeight >= 12 then
    begin
      if (Fraction(V * 4.0) < 0.09) or (Fraction(Along) < 0.05) then
        begin
          return PixelOps.Darken(Base, 62, 100);
        end;
      end if;
    end;
  end if;

  return PixelOps.Darken(Base, 90 + StoneVariation(Hit, Course, Stone), 102);
end function;

// Returns the textured wall pixel at height V of one wall slice.
public function WallTexel(Hit: Rays.FirstPersonRayHit; V: real; WallHeight: integer): integer;
begin
  if Hit.FieldCode = Protocol.UnknownFieldCode then
    begin
      return PixelOps.UnknownPixel;
    end;
  end if;

  return StoneTexel(Hit, V, WallHeight);
end function;

// Shades a stairs field as concentric steps: stairs up brighten toward the field center,
// stairs down darken into it, so both directions read apart from the exit and plain floor.
function StairsTexel(Code: string; FloorX: real; FloorY: real): integer;
begin
  const Edge: real := Math.Max(Math.Abs(Fraction(FloorX) - 0.5), Math.Abs(Fraction(FloorY) - 0.5));
  const Ring: integer := Math.Min(3, Math.Floor(Edge * 8.0));
  if Code = Protocol.InteriorStairsUpCode then
    return PixelOps.Darken(PixelOps.StairsUpPixel, 100 - (Ring * 15), 100);
  end if;

  return PixelOps.Darken(PixelOps.StairsDownPixel, 35 + (Ring * 20), 100);
end function;

// Projects one floor pixel onto its field; exits and stairs color only their floor.
// Unknown samples and samples behind opaque geometry reveal no material.
public function ProjectFloorPixel(
  Value: Protocol.FirstPersonVisibleState;
  Camera: Rays.FirstPersonCamera;
  CameraX: real;
  Distance: real;
  WallDistance: real
): integer;
begin
  if Distance >= WallDistance then
    begin
      return PixelOps.Lit(PixelOps.FloorPixel, Distance);
    end;
  end if;
  const FloorX: real := Camera.EyeX + Distance * (Camera.DirectionX + Camera.PlaneX * CameraX);
  const FloorY: real := Camera.EyeY + Distance * (Camera.DirectionY + Camera.PlaneY * CameraX);
  const Code: string := Rays.FieldAt(Value, Math.Floor(FloorX), Math.Floor(FloorY));
  if Code = Protocol.UnknownFieldCode then
    begin
      return PixelOps.UnknownPixel;
    end;
  end if;
  var Material: integer := PixelOps.FloorPixel;
  if Code = Protocol.InteriorExitCode then
    begin
      Material := PixelOps.ExitFloorPixel;
    end;
  end if;

  if (Code = Protocol.InteriorStairsUpCode) or (Code = Protocol.InteriorStairsDownCode) then
    Material := StairsTexel(Code, FloorX, FloorY);
  end if;

  // One flagstone per field, so joints never run down a corridor's center; they fade
  // out before they would alias with distance.
  if Distance < 3.5 then
    begin
      const JointX: real := Fraction(FloorX);
      const JointY: real := Fraction(FloorY);
      if ((JointX < 0.03) or (JointX > 0.97)) or ((JointY < 0.03) or (JointY > 0.97)) then
        begin
          Material := PixelOps.Darken(Material, 74, 100);
        end;
      end if;
    end;
  end if;

  return PixelOps.Lit(Material, Distance);
end function;
end unit;
