// Billboard sprites, animation effects, and the player swing drawn over a scene.
unit Dungeon.Client.Raycast.Sprites;

uses
  Dungeon.Client.Raycast.Art, Dungeon.Client.Raycast.Pixels, Dungeon.Client.Raycast.Rays,
  Dungeon.Protocol, Std.Arrays, Std.Conv, Std.Math, Std.Str;

public type
  // Presentation-only changes for one animation frame; the protocol state stays untouched.
  FirstPersonEffect = record
    // Draws the opponent's figure in a white-hot flash.
    public Flash: boolean;
    // Lateral offset of the opponent's figure in fields; a dodge moves it aside.
    public Shift: real;
    // Height multiplier of the opponent's figure; above one it lunges towards the eye.
    public Scale: real;
    // Fraction of the opponent's figure sunk below the floor, from 0 to 1.
    public Sink: real;
    // Draws the opponent on the field ahead even though the state no longer contains it.
    public FallenAhead: boolean;
    // Progress of the player's swing from 0 to 1; negative values draw no swing.
    public Swing: real;
    // Whether the swing shows a blade instead of a fist.
    public Armed: boolean;
  end record;
  // One upright billboard: pixel art standing on the floor at a field center.
  Sprite = record
    public WorldX: real;
    public WorldY: real;
    // Field-relative height of the figure; width follows the art's aspect ratio.
    public HeightFraction: real;
    public Art: array of string;
    // Opponent figures receive the frame's animation effect.
    public Hostile: boolean;
  end record;

// Collects visible opponent and item fields as billboards.
public function VisibleSprites(Value: FirstPersonVisibleState): array of Sprite;
begin
  mutable var Sprites: array of Sprite := [];
  for Y: integer := 0 to Value.Height - 1 do
    begin
      for X: integer := 0 to Value.Width - 1 do
        begin
          var Code: string := FieldAt(Value, X, Y);
          if Code = InteriorHostileCode then
            begin
              Std.Arrays.Push(Sprites, record
                WorldX := IntToReal(X) + 0.5;
                WorldY := IntToReal(Y) + 0.5;
                HeightFraction := 0.9;
                Art := HostileArt();
                Hostile := true;
              end);
            end;
          end if;

          if Code = InteriorItemCode then
            begin
              Std.Arrays.Push(Sprites, record
                WorldX := IntToReal(X) + 0.5;
                WorldY := IntToReal(Y) + 0.5;
                HeightFraction := 0.1;
                Art := ItemArt();
                Hostile := false;
              end);
            end;
          end if;

          if Code = InteriorWeaponCode then
            begin
              Std.Arrays.Push(Sprites, record
                WorldX := IntToReal(X) + 0.5;
                WorldY := IntToReal(Y) + 0.5;
                HeightFraction := 0.11;
                Art := WeaponArt();
                Hostile := false;
              end);
            end;
          end if;

          if Code = InteriorArmorCode then
            begin
              Std.Arrays.Push(Sprites, record
                WorldX := IntToReal(X) + 0.5;
                WorldY := IntToReal(Y) + 0.5;
                HeightFraction := 0.14;
                Art := ArmorArt();
                Hostile := false;
              end);
            end;
          end if;
        end;
      end for;
    end;
  end for;

  return Sprites;
end function;

// Returns the sprite's depth along the view direction; values near zero are behind the eye.
public function SpriteDepth(Camera: FirstPersonCamera; Item: Sprite): real;
begin
  var RelativeX: real := Item.WorldX - Camera.EyeX;
  var RelativeY: real := Item.WorldY - Camera.EyeY;
  var InverseDeterminant: real := 1.0 /
                                  ((Camera.PlaneX * Camera.DirectionY) - (Camera.DirectionX * Camera.PlaneY));
  return InverseDeterminant * ((- Camera.PlaneY * RelativeX) + (Camera.PlaneX * RelativeY));
end function;

// Draws one billboard into the pixel buffer, hidden behind nearer walls.
public function DrawSprite(
  Pixels: array of integer;
  Depths: array of real;
  Camera: FirstPersonCamera;
  Item: Sprite;
  Width: integer;
  PixelHeight: integer;
  Effect: FirstPersonEffect
): array of integer;
begin
  mutable var Drawn: array of integer := Pixels;
  var RelativeX: real := Item.WorldX - Camera.EyeX;
  var RelativeY: real := Item.WorldY - Camera.EyeY;
  var InverseDeterminant: real := 1.0 /
                                  ((Camera.PlaneX * Camera.DirectionY) - (Camera.DirectionX * Camera.PlaneY));
  mutable var Lateral: real := InverseDeterminant *
                               ((Camera.DirectionY * RelativeX) - (Camera.DirectionX * RelativeY));
  var Depth: real := SpriteDepth(Camera, Item);
  if Depth < 0.2 then
    begin
      return Drawn;
    end;
  end if;
  mutable var HeightFraction: real := Item.HeightFraction;
  if Item.Hostile then
    begin
      Lateral := Lateral + Effect.Shift;
      HeightFraction := HeightFraction * Effect.Scale;
    end;
  end if;
  var ArtHeight: integer := Std.Arrays.Length(Item.Art);
  var ArtWidth: integer := Std.Str.Length(Item.Art[0]);
  var FieldHeight: real := (IntToReal(PixelHeight) * TerminalAspectCorrection) / Depth;
  var FloorLine: real := (IntToReal(PixelHeight) + FieldHeight) / 2.0;
  var SpriteHeight: real := FieldHeight * HeightFraction;
  var SpriteWidth: real := (SpriteHeight * IntToReal(ArtWidth)) / IntToReal(ArtHeight);
  var CenterX: real := (IntToReal(Width - 1) / 2.0) * (1.0 + (Lateral / Depth));
  var Left: real := CenterX - (SpriteWidth / 2.0);
  mutable var Top: real := FloorLine - SpriteHeight;
  if Item.Hostile then
    begin
      // A sinking figure keeps its size and disappears below the floor line.
      Top := Top + (SpriteHeight * Effect.Sink);
    end;
  end if;
  // Distance darkening matches the wall falloff so figures sit in the same light.
  var Light: integer := Std.Math.Clamp(218 - Trunc(Depth * 22.0), 96, 218);
  var FirstColumn: integer := Std.Math.Max(0, Std.Math.Floor(Left));
  var LastColumn: integer := Std.Math.Min(Width - 1, Std.Math.Floor(Left + SpriteWidth));
  var FirstRow: integer := Std.Math.Max(0, Std.Math.Floor(Top));
  var LastRow: integer := Std.Math.Min(PixelHeight - 1, Std.Math.Floor(FloorLine));
  for Column: integer := FirstColumn to LastColumn do
    begin
      if Depth < Depths[Column] then
        begin
          var ArtX: integer := Trunc((((IntToReal(Column) + 0.5) - Left) * IntToReal(ArtWidth)) /
                                     SpriteWidth);
          if (ArtX >= 0) and (ArtX < ArtWidth) then
            begin
              for Row: integer := FirstRow to LastRow do
                begin
                  var ArtY: integer := Trunc((((IntToReal(Row) + 0.5) - Top) * IntToReal(ArtHeight)) /
                                             SpriteHeight);
                  if (ArtY >= 0) and (ArtY < ArtHeight) then
                    begin
                      var Color: integer := ArtPixel(Std.Str.CharAt(Item.Art[ArtY], ArtX));
                      if Color <> 0 then
                        begin
                          if Item.Hostile and Effect.Flash then
                            begin
                              Drawn[(Row * Width) + Column] := Rgb(255, 250, 236);
                            end;
                          else
                            begin
                              Drawn[(Row * Width) + Column] := Darken(Color, Light, 218);
                            end;
                          end if;
                        end;
                      end if;
                    end;
                  end if;
                end;
              end for;
            end;
          end if;
        end;
      end if;
    end;
  end for;

  return Drawn;
end function;

// Returns the effect of a still frame: no flash, shift, lunge, sinking, or swing.
public function NoFirstPersonEffect(): FirstPersonEffect;
begin
  return record
    Flash := false;
    Shift := 0.0;
    Scale := 1.0;
    Sink := 0.0;
    FallenAhead := false;
    Swing := -1.0;
    Armed := false;
  end;
end function;

// Returns the field directly ahead of the player.
public function FieldAheadX(Value: FirstPersonVisibleState): integer;
begin
  case Value.Facing of
    when FirstPersonFacing.East:
      begin
        return Value.PlayerX + 1;
      end;
    when FirstPersonFacing.West:
      begin
        return Value.PlayerX - 1;
      end;
    else
      begin
        return Value.PlayerX;
      end;
  end case;
end function;

// Returns the row of the field directly ahead of the player.
public function FieldAheadY(Value: FirstPersonVisibleState): integer;
begin
  case Value.Facing of
    when FirstPersonFacing.North:
      begin
        return Value.PlayerY - 1;
      end;
    when FirstPersonFacing.South:
      begin
        return Value.PlayerY + 1;
      end;
    else
      begin
        return Value.PlayerY;
      end;
  end case;
end function;

// Draws the player's swing from the lower right corner towards the center of the view.
public function DrawSwing(
  Pixels: array of integer;
  Width: integer;
  PixelHeight: integer;
  Effect: FirstPersonEffect
): array of integer;
begin
  mutable var Drawn: array of integer := Pixels;
  if (Effect.Swing < 0.0) or ((Width < 4) or (PixelHeight < 4)) then
    begin
      return Drawn;
    end;
  end if;
  // The blade sweeps from pointing up-right to pointing up-left.
  var Angle: real := (Std.Math.Pi * (0.3 + (0.45 * Std.Math.Min(1.0, Effect.Swing))));
  var PivotX: real := IntToReal(Width) * 0.78;
  var PivotY: real := IntToReal(PixelHeight) - 1.0;
  mutable var Length: real := IntToReal(PixelHeight) * 0.55;
  mutable var Thickness: integer := Std.Math.Max(1, Width div 60);
  mutable var Color: integer := Rgb(196, 202, 210);
  if not Effect.Armed then
    begin
      Length := IntToReal(PixelHeight) * 0.3;
      Thickness := Std.Math.Max(2, Width div 25);
      Color := Rgb(214, 170, 130);
    end;
  end if;
  var Steps: integer := Trunc(Length);
  for Step: integer := 0 to Steps do
    begin
      var Along: real := IntToReal(Step);
      var X: integer := Trunc(PivotX - (Std.Math.Cos(Angle) * Along));
      var Y: integer := Trunc(PivotY - (Std.Math.Sin(Angle) * Along));
      mutable var Pixel: integer := Color;
      // The lowest part of a blade is its leather grip.
      if Effect.Armed and (Along < Length * 0.18) then
        begin
          Pixel := Rgb(96, 62, 36);
        end;
      end if;

      for Offset: integer := 0 to Thickness - 1 do
        begin
          var Column: integer := X + Offset;
          if ((Column >= 0) and (Column < Width)) and ((Y >= 0) and (Y < PixelHeight)) then
            begin
              Drawn[(Y * Width) + Column] := Pixel;
            end;
          end if;
        end;
      end for;
    end;
  end for;

  return Drawn;
end function;
end unit;
