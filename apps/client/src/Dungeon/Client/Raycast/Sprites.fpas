// Billboard sprites, animation effects, and the player swing drawn over a scene.
unit Dungeon.Client.Raycast.Sprites;

uses Dungeon.Client.Raycast.Art as Art, Dungeon.Client.Raycast.Pixels as PixelOps, Dungeon.Client.Raycast.Rays as Rays, Dungeon.Protocol as Protocol, Std.Conv as Conv, Std.Math as Math;

// Presentation-only changes for one animation frame; the protocol state stays untouched.
public type FirstPersonEffect = record
  // Draws the opponent's figure in a white-hot flash.
  public Flash: boolean;
  // Lateral offset of the opponent's figure in fields; a dodge moves it aside.
  public Shift: real;
  // Height multiplier of the opponent's figure; above one it lunges towards the eye.
  public Scale: real;
  // Fraction of the opponent's figure sunk below the floor, from 0 to 1.
  public Sink: real;
  // Draws the opponent on the field ahead even though the state no longer contains it.
  public FallenAhead: boolean;
  // Progress of the player's swing from 0 to 1; negative values draw no swing.
  public Swing: real;
  // Whether the swing shows a blade instead of a fist.
  public Armed: boolean;
end record;

// One upright billboard: pixel art standing on the floor at a field center.
public type Sprite = record
  public WorldX: real;
  public WorldY: real;
  // Field-relative height of the figure; width follows the art's aspect ratio.
  public HeightFraction: real;
  public Art: array of string;
  // Opponent figures receive the frame's animation effect.
  public Hostile: boolean;
end record;

// Collects visible opponent and item fields as billboards.
public function VisibleSprites(Value: Protocol.FirstPersonVisibleState): array of Sprite;
begin
  var Sprites: array of Sprite := [];
  for Y: integer := 0 to Value.Height - 1 do
    begin
      for X: integer := 0 to Value.Width - 1 do
        begin
          const Code: string := Rays.FieldAt(Value, X, Y);
          if Code = Protocol.InteriorHostileCode then
            begin
              Sprites.PushInPlace(
                Sprite(
                  WorldX := Conv.IntToReal(X) + 0.5,
                  WorldY := Conv.IntToReal(Y) + 0.5,
                  HeightFraction := 0.9,
                  Art := Art.HostileArt(),
                  Hostile := true
                )
              );
            end;
          end if;

          if Code = Protocol.InteriorItemCode then
            begin
              Sprites.PushInPlace(
                Sprite(
                  WorldX := Conv.IntToReal(X) + 0.5,
                  WorldY := Conv.IntToReal(Y) + 0.5,
                  HeightFraction := 0.1,
                  Art := Art.ItemArt(),
                  Hostile := false
                )
              );
            end;
          end if;

          if Code = Protocol.InteriorWeaponCode then
            begin
              Sprites.PushInPlace(
                Sprite(
                  WorldX := Conv.IntToReal(X) + 0.5,
                  WorldY := Conv.IntToReal(Y) + 0.5,
                  HeightFraction := 0.11,
                  Art := Art.WeaponArt(),
                  Hostile := false
                )
              );
            end;
          end if;

          if Code = Protocol.InteriorArmorCode then
            begin
              Sprites.PushInPlace(
                Sprite(
                  WorldX := Conv.IntToReal(X) + 0.5,
                  WorldY := Conv.IntToReal(Y) + 0.5,
                  HeightFraction := 0.14,
                  Art := Art.ArmorArt(),
                  Hostile := false
                )
              );
            end;
          end if;
        end;
      end for;
    end;
  end for;

  return Sprites;
end function;

// Returns the sprite's depth along the view direction; values near zero are behind the eye.
public function SpriteDepth(Camera: Rays.FirstPersonCamera; Item: Sprite): real;
begin
  const RelativeX: real := Item.WorldX - Camera.EyeX;
  const RelativeY: real := Item.WorldY - Camera.EyeY;
  const InverseDeterminant: real := 1.0 /
    ((Camera.PlaneX * Camera.DirectionY) - (Camera.DirectionX * Camera.PlaneY));
  return InverseDeterminant * ((- Camera.PlaneY * RelativeX) + (Camera.PlaneX * RelativeY));
end function;

// Draws one billboard into the pixel buffer, hidden behind nearer walls.
public function DrawSprite(
  Pixels: array of integer;
  Depths: array of real;
  Camera: Rays.FirstPersonCamera;
  Item: Sprite;
  Width: integer;
  PixelHeight: integer;
  Effect: FirstPersonEffect
): array of integer;
begin
  var Drawn: array of integer := Pixels;
  const RelativeX: real := Item.WorldX - Camera.EyeX;
  const RelativeY: real := Item.WorldY - Camera.EyeY;
  const InverseDeterminant: real := 1.0 /
    ((Camera.PlaneX * Camera.DirectionY) - (Camera.DirectionX * Camera.PlaneY));
  var Lateral: real := InverseDeterminant *
    ((Camera.DirectionY * RelativeX) - (Camera.DirectionX * RelativeY));
  const Depth: real := SpriteDepth(Camera, Item);
  if Depth < 0.2 then
    begin
      return Drawn;
    end;
  end if;
  var HeightFraction: real := Item.HeightFraction;
  if Item.Hostile then
    begin
      Lateral := Lateral + Effect.Shift;
      HeightFraction := HeightFraction * Effect.Scale;
    end;
  end if;
  const ArtHeight: integer := Item.Art.Length();
  const ArtWidth: integer := Item.Art[0].Length();
  const FieldHeight: real := (Conv.IntToReal(PixelHeight) * Rays.TerminalAspectCorrection) / Depth;
  const FloorLine: real := (Conv.IntToReal(PixelHeight) + FieldHeight) / 2.0;
  const SpriteHeight: real := FieldHeight * HeightFraction;
  const SpriteWidth: real := (SpriteHeight * Conv.IntToReal(ArtWidth)) / Conv.IntToReal(ArtHeight);
  const CenterX: real := (Conv.IntToReal(Width - 1) / 2.0) * (1.0 + (Lateral / Depth));
  const Left: real := CenterX - (SpriteWidth / 2.0);
  var Top: real := FloorLine - SpriteHeight;
  if Item.Hostile then
    begin
      // A sinking figure keeps its size and disappears below the floor line.
      Top := Top + (SpriteHeight * Effect.Sink);
    end;
  end if;
  // Distance darkening matches the wall falloff so figures sit in the same light.
  const Light: integer := Math.Clamp(218 - Math.Trunc(Depth * 22.0), 96, 218);
  const FirstColumn: integer := Math.Max(0, Math.Floor(Left));
  const LastColumn: integer := Math.Min(Width - 1, Math.Floor(Left + SpriteWidth));
  const FirstRow: integer := Math.Max(0, Math.Floor(Top));
  const LastRow: integer := Math.Min(PixelHeight - 1, Math.Floor(FloorLine));
  for Column: integer := FirstColumn to LastColumn do
    begin
      if Depth < Depths[Column] then
        begin
          const ArtX: integer := Math.Trunc(
            (((Conv.IntToReal(Column) + 0.5) - Left) * Conv.IntToReal(ArtWidth)) /
            SpriteWidth
          );
          if (ArtX >= 0) and (ArtX < ArtWidth) then
            begin
              for Row: integer := FirstRow to LastRow do
                begin
                  const ArtY: integer := Math.Trunc(
                    (((Conv.IntToReal(Row) + 0.5) - Top) * Conv.IntToReal(ArtHeight)) /
                    SpriteHeight
                  );
                  if (ArtY >= 0) and (ArtY < ArtHeight) then
                    begin
                      const Color: integer := Art.ArtPixel(Item.Art[ArtY][ArtX]);
                      if Color <> 0 then
                        begin
                          if Item.Hostile and Effect.Flash then
                            begin
                              Drawn[(Row * Width) + Column] := PixelOps.Rgb(255, 250, 236);
                            end;
                          else
                            begin
                              Drawn[(Row * Width) + Column] := PixelOps.Darken(Color, Light, 218);
                            end;
                          end if;
                        end;
                      end if;
                    end;
                  end if;
                end;
              end for;
            end;
          end if;
        end;
      end if;
    end;
  end for;

  return Drawn;
end function;

// Returns the effect of a still frame: no flash, shift, lunge, sinking, or swing.
public function NoFirstPersonEffect(): FirstPersonEffect;
begin
  return FirstPersonEffect(
    Flash := false,
    Shift := 0.0,
    Scale := 1.0,
    Sink := 0.0,
    FallenAhead := false,
    Swing := -1.0,
    Armed := false
  );
end function;

// Returns the field directly ahead of the player.
public function FieldAheadX(Value: Protocol.FirstPersonVisibleState): integer;
begin
  case Value.Facing of
    when Protocol.FirstPersonFacing.East:
      begin
        return Value.PlayerX + 1;
      end;
    when Protocol.FirstPersonFacing.West:
      begin
        return Value.PlayerX - 1;
      end;
    when Protocol.FirstPersonFacing.North, Protocol.FirstPersonFacing.South:
      begin
        return Value.PlayerX;
      end;
  end case;
end function;

// Returns the row of the field directly ahead of the player.
public function FieldAheadY(Value: Protocol.FirstPersonVisibleState): integer;
begin
  case Value.Facing of
    when Protocol.FirstPersonFacing.North:
      begin
        return Value.PlayerY - 1;
      end;
    when Protocol.FirstPersonFacing.South:
      begin
        return Value.PlayerY + 1;
      end;
    when Protocol.FirstPersonFacing.East, Protocol.FirstPersonFacing.West:
      begin
        return Value.PlayerY;
      end;
  end case;
end function;

// Draws the player's swing from the lower right corner towards the center of the view.
public function DrawSwing(
  Pixels: array of integer;
  Width: integer;
  PixelHeight: integer;
  Effect: FirstPersonEffect
): array of integer;
begin
  var Drawn: array of integer := Pixels;
  if (Effect.Swing < 0.0) or ((Width < 4) or (PixelHeight < 4)) then
    begin
      return Drawn;
    end;
  end if;
  // The blade sweeps from pointing up-right to pointing up-left.
  const Angle: real := (Math.Pi * (0.3 + (0.45 * Math.Min(1.0, Effect.Swing))));
  const PivotX: real := Conv.IntToReal(Width) * 0.78;
  const PivotY: real := Conv.IntToReal(PixelHeight) - 1.0;
  var Length: real := Conv.IntToReal(PixelHeight) * 0.55;
  var Thickness: integer := Math.Max(1, Width div 60);
  var Color: integer := PixelOps.Rgb(196, 202, 210);
  if not Effect.Armed then
    begin
      Length := Conv.IntToReal(PixelHeight) * 0.3;
      Thickness := Math.Max(2, Width div 25);
      Color := PixelOps.Rgb(214, 170, 130);
    end;
  end if;
  const Steps: integer := Math.Trunc(Length);
  for Step: integer := 0 to Steps do
    begin
      const Along: real := Conv.IntToReal(Step);
      const X: integer := Math.Trunc(PivotX - (Math.Cos(Angle) * Along));
      const Y: integer := Math.Trunc(PivotY - (Math.Sin(Angle) * Along));
      var Pixel: integer := Color;
      // The lowest part of a blade is its leather grip.
      if Effect.Armed and (Along < Length * 0.18) then
        begin
          Pixel := PixelOps.Rgb(96, 62, 36);
        end;
      end if;

      for Offset: integer := 0 to Thickness - 1 do
        begin
          const Column: integer := X + Offset;
          if ((Column >= 0) and (Column < Width)) and ((Y >= 0) and (Y < PixelHeight)) then
            begin
              Drawn[(Y * Width) + Column] := Pixel;
            end;
          end if;
        end;
      end for;
    end;
  end for;

  return Drawn;
end function;
end unit;
