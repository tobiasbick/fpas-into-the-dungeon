// Stable facade for the dungeon client's model, network session, and Functional Pascal TUI.
unit Dungeon.Client;

uses Dungeon.Client.Model as Model, Dungeon.Client.Network as Network, Dungeon.Client.Ui as Ui, Dungeon.Client.Ui.Backdrop as BackdropUnit, Dungeon.Client.Ui.Events as EventsUnit, Dungeon.Protocol as Protocol, Dungeon.RuntimeData as RuntimeData, Std.Tasks as Tasks, Std.Tui as Tui;

// Top-level client screens exposed for application-level tests and orchestration.
public type ClientScreen = Model.ClientScreen;

// Modal client content exposed for application-level tests and orchestration.
public type ClientOverlay = Model.ClientOverlay;

// Connection lifecycle exposed for application-level tests and orchestration.
public type ClientConnectionPhase = Model.ClientConnectionPhase;

// Network events applied by the TUI host on its synchronous update loop.
public type ClientEvent = Model.ClientEvent;

// Complete client-owned state accepted by the public update and view interface.
public type ClientModel = Model.ClientModel;

// Runs one network session and publishes its results to the client event channel.
public function RunNetwork(
  Host: string;
  Port: integer;
  ViewWidth: integer;
  ViewHeight: integer;
  Requests: channel of Protocol.ClientMessage;
  Events: channel of ClientEvent;
  Token: Tasks.CancellationToken
): result of (boolean, string);
begin
  return Network.RunNetwork(Host, Port, ViewWidth, ViewHeight, Requests, Events, Token);
end function;

// Creates an offline start-screen model without assuming server-owned map dimensions.
public function NewClientModel(
  Host: string;
  Port: integer;
  ClientConfigPath: string;
  Preferences: RuntimeData.ClientPreferences;
  Requests: channel of Protocol.ClientMessage;
  Events: channel of ClientEvent
): ClientModel;
begin
  return Model.NewClientModel(Host, Port, ClientConfigPath, Preferences, Requests, Events);
end function;

// Applies a framework message and prepares size-dependent start artwork before rendering.
public function UpdateClient(State: ClientModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ClientModel;
begin
  return BackdropUnit.PrepareStartBackdrop(Ui.UpdateClient(State, Msg, Cmd));
end function;

// Applies a network event and prepares start artwork when returning from gameplay.
public function UpdateClientEvent(State: ClientModel; Value: ClientEvent; Cmd: Tui.TuiCmdOutput): ClientModel;
begin
  return BackdropUnit.PrepareStartBackdrop(EventsUnit.UpdateClientEvent(State, Value, Cmd));
end function;

// Renders the start screen or game screen with any active modal overlay.
public function ViewClient(State: ClientModel): Tui.TuiElement;
begin
  return Ui.ViewClient(State);
end function;

// Owns the request channels and TUI lifecycle until the user exits.
public function RunClient(
  Host: string;
  Port: integer;
  ClientConfigPath: string;
  Preferences: RuntimeData.ClientPreferences
): ClientModel;
begin
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(1);
  const Events: channel of ClientEvent := Tasks.CreateChannel(8);
  return Tui.TuiApplication.RunWithBackground(
    NewClientModel(Host, Port, ClientConfigPath, Preferences, Requests, Events),
    Events,
    UpdateClient,
    UpdateClientEvent,
    ViewClient
  );
end function;
end unit;
