// Stable facade for the dungeon client's model, network session, and Functional Pascal TUI.
unit Dungeon.Client;

uses
  Dungeon.Client.Model, Dungeon.Client.Network, Dungeon.Client.Ui, Dungeon.Protocol, Std.Task,
  Std.Tui;

public type
  // Top-level client screens exposed for application-level tests and orchestration.
  ClientScreen = Dungeon.Client.Model.ClientScreen;
  // Modal client content exposed for application-level tests and orchestration.
  ClientOverlay = Dungeon.Client.Model.ClientOverlay;
  // Connection lifecycle exposed for application-level tests and orchestration.
  ClientConnectionPhase = Dungeon.Client.Model.ClientConnectionPhase;
  // Network events applied by the TUI host on its synchronous update loop.
  ClientEvent = Dungeon.Client.Model.ClientEvent;
  // Complete client-owned state accepted by the public update and view interface.
  ClientModel = Dungeon.Client.Model.ClientModel;

// Runs one network session and publishes its results to the client event channel.
public function RunNetwork(
  Host: string;
  Port: integer;
  ViewWidth: integer;
  ViewHeight: integer;
  Requests: channel of ClientMessage;
  Events: channel of ClientEvent;
  Token: CancellationToken
): result of boolean, string;
begin
  return Dungeon.Client.Network.RunNetwork(Host, Port, ViewWidth, ViewHeight, Requests, Events, Token)
end;

// Creates an offline start-screen model without assuming server-owned map dimensions.
public function NewClientModel(
  Host: string;
  Port: integer;
  Requests: channel of ClientMessage;
  Events: channel of ClientEvent
): ClientModel;
begin
  return Dungeon.Client.Model.NewClientModel(Host, Port, Requests, Events)
end;

// Applies one framework message through the complete client UI state machine.
public function UpdateClient(State: ClientModel; Msg: TuiMsg; Cmd: TuiCmdOutput): ClientModel;
begin
  return Dungeon.Client.Ui.UpdateClient(State, Msg, Cmd)
end;

// Applies one network event through the complete client UI state machine.
public function UpdateClientEvent(State: ClientModel; Value: ClientEvent; Cmd: TuiCmdOutput): ClientModel;
begin
  return Dungeon.Client.Ui.UpdateClientEvent(State, Value, Cmd)
end;

// Renders the start screen or game screen with any active modal overlay.
public function ViewClient(State: ClientModel): TuiElement;
begin
  return Dungeon.Client.Ui.ViewClient(State)
end;

// Owns the request channels and TUI lifecycle until the user exits.
public function RunClient(Host: string; Port: integer): ClientModel;
begin
  var Requests: channel of ClientMessage := CreateChannel(1);
  var Events: channel of ClientEvent := CreateChannel(8);
  return TuiApplication.RunWithBackground(NewClientModel(Host, Port, Requests, Events), Events, UpdateClient, UpdateClientEvent, ViewClient)
end;
