// Stable facade for the dungeon client's model, network session, and Functional Pascal TUI.
unit Dungeon.Client;

uses Dungeon.Client.Model as Model, Dungeon.Client.Network as Network, Dungeon.Client.Ui as Ui, Dungeon.Client.Ui.Backdrop as BackdropUnit, Dungeon.Client.Ui.Events as EventsUnit, Dungeon.Protocol as Protocol, Dungeon.RuntimeData as RuntimeData, Dungeon.Ui.Theme as Theme, Std.Tasks as Tasks, Std.Ui.Terminal as Tui;

// Top-level client screens exposed for application-level tests and orchestration.
public type ClientScreen = Model.ClientScreen;

// Modal client content exposed for application-level tests and orchestration.
public type ClientOverlay = Model.ClientOverlay;

// Connection lifecycle exposed for application-level tests and orchestration.
public type ClientConnectionPhase = Model.ClientConnectionPhase;

// Unwrapped network events for explicitly caller-orchestrated sessions.
public type ClientEvent = Model.ClientEvent;

// Host-inbox envelope identifying the network attempt that emitted an event.
public type ConnectionEvent = Model.ConnectionEvent;

// Complete client-owned state accepted by the public update and view interface.
public type ClientModel = Model.ClientModel;

// Runs one caller-orchestrated session and closes its socket before returning.
// The caller owns both raw channels and must isolate separate connection attempts.
public function RunNetwork(
  Host: string;
  Port: integer;
  ViewWidth: integer;
  ViewHeight: integer;
  Requests: channel of Protocol.ClientMessage;
  Events: channel of ClientEvent;
  Token: Tasks.CancellationToken
): result of (boolean, string);
begin
  return Network.RunNetwork(Host, Port, ViewWidth, ViewHeight, Requests, Events, Token);
end function;

// Creates an offline start-screen model without assuming server-owned map dimensions.
public function NewClientModel(
  Host: string;
  Port: integer;
  ClientConfigPath: string;
  Preferences: RuntimeData.ClientPreferences;
  Requests: channel of Protocol.ClientMessage;
  Events: channel of ConnectionEvent
): ClientModel;
ensures (Created): (Created.ConnectionGeneration = 0)
  and
  (Created.ConnectionPhase = ClientConnectionPhase.Offline)
  and
  not Created.HasVisibleState;
begin
  return Model.NewClientModel(Host, Port, ClientConfigPath, Preferences, Requests, Events);
end function;

// Applies a framework message and prepares size-dependent start artwork before rendering.
// Caller-owned state keeps a valid generation and requested viewport; checks stay scalar per event.
public function UpdateClient(State: ClientModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ClientModel;
requires State.ConnectionGeneration >= 0;
requires (State.RequestedWorldWidth > 0) and (State.RequestedWorldHeight > 0);
ensures (Updated): Updated.ConnectionGeneration >= State.ConnectionGeneration;
ensures (Updated): (Updated.RequestedWorldWidth > 0) and (Updated.RequestedWorldHeight > 0);
begin
  return BackdropUnit.PrepareStartBackdrop(Ui.UpdateClient(State, Msg, Cmd));
end function;

// Applies an already scoped raw event and prepares size-dependent start artwork.
// The production host uses UpdateConnectionEvent, which rejects stale attempt events.
public function UpdateClientEvent(State: ClientModel; Value: ClientEvent; Cmd: Tui.TuiCmdOutput): ClientModel;
requires State.ConnectionGeneration >= 0;
ensures (Updated): Updated.ConnectionGeneration = State.ConnectionGeneration;
ensures (Updated): if Value is ClientEvent.SaveCompleted then not Updated.Dirty
  and
  not Updated.Pending
  else true
  end if;
begin
  return BackdropUnit.PrepareStartBackdrop(EventsUnit.UpdateClientEvent(State, Value, Cmd));
end function;

// Applies only events belonging to the current attempt, including after cancellation/reconnect.
public function UpdateConnectionEvent(State: ClientModel; Value: ConnectionEvent; Cmd: Tui.TuiCmdOutput): ClientModel;
requires State.ConnectionGeneration >= 0;
ensures (Updated): Updated.ConnectionGeneration = State.ConnectionGeneration;
ensures (Updated): if (State.ConnectionGeneration = 0)
  or
  (Value.Generation <> State.ConnectionGeneration) then (
    Updated.ConnectionPhase = State.ConnectionPhase
  )
    and
    (Updated.Pending = State.Pending)
    and
    (Updated.HasVisibleState = State.HasVisibleState)
  else true
  end if;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  if (State.ConnectionGeneration = 0) or (Value.Generation <> State.ConnectionGeneration) then
    return State;
  end if;

  return UpdateClientEvent(State, Value.Value, Cmd);
end function;

// Renders the start screen or game screen with any active modal overlay.
public function ViewClient(State: ClientModel): Tui.TuiElement;
begin
  return Ui.ViewClient(State);
end function;

// Renders inside a TUI application, retaining unchanged primary content between frames.
public function ViewClientCached(State: ClientModel): Tui.TuiElement;
begin
  return Ui.ViewClientCached(State);
end function;

// Owns request queues and the TUI lifecycle; the host owns the tagged event inbox until exit.
public function RunClient(
  Host: string;
  Port: integer;
  ClientConfigPath: string;
  Preferences: RuntimeData.ClientPreferences
): ClientModel;
begin
  const Requests: channel of Protocol.ClientMessage := Tasks.CreateChannel(1);
  const Events: channel of ConnectionEvent := Tasks.CreateChannel(8);
  const Final := Tui.TuiApplication.RunWithBackgroundAndPalette(
    NewClientModel(Host, Port, ClientConfigPath, Preferences, Requests, Events),
    Events,
    UpdateClient,
    UpdateConnectionEvent,
    ViewClientCached,
    Theme.Palette()
  );
  discard Tasks.CloseChannel(Final.Requests);
  return Final;
end function;
end unit;
