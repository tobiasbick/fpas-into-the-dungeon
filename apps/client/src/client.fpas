// Starts the terminal client with persistent network configuration.
program DungeonClient;

uses Dungeon.Client as ClientUnit, Dungeon.RuntimeData as RuntimeData, Dungeon.RuntimeData.Startup as Startup, Std.Os.Args as Args, Std.Console as Console;

begin
  var Arguments: array of string := [];
  for Index: integer := 0 to Args.ParamCount() - 1 do
    Arguments.PushInPlace(Args.ParamStr(Index));
  end for;

  case Startup.ParseArguments(Arguments := Arguments, ServerMode := false).Unwrap() of
    when Startup.StartupArguments.Help(const Text):
      Console.WriteText(Text);
    when Startup.StartupArguments.Ready(const Options):
      const Runtime := RuntimeData.LoadClientRuntime(Options.DataRoot).Unwrap();
      const Network := Startup.NetworkWithOverrides(Runtime.Network, Options);
      discard ClientUnit.RunClient(
        Network.Host, Network.Port, Runtime.Paths.ClientConfig, Runtime.Preferences
      );
  end case;
end.
