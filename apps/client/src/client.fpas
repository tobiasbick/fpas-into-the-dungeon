program DungeonClient;

uses Dungeon.Client, Std.Args, Std.Conv;

begin
  mutable var Host: string := '127.0.0.1';
  mutable var Port: integer := 4040;
  if ParamCount() >= 1 then
  begin
    Host := ParamStr(0)
  end;

  if ParamCount() >= 2 then
  begin
    Port := StrToInt(ParamStr(1))
  end;

  if ParamCount() > 2 then
  begin
    panic('usage: dungeon-client [HOST] [PORT]')
  end;

  RunClient(Host, Port)
end.
