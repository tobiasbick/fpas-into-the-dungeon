[project]
name = "dungeon-client-core"
kind = "library"

[dependencies]
workspace = ["dungeon-protocol", "dungeon-runtime-data", "dungeon-ui"]

[exports]
units = ["Dungeon.Client", "Dungeon.Client.Animation", "Dungeon.Client.Raycast", "Dungeon.Client.Raycast.Rays", "Dungeon.Client.Raycast.Sprites"]

[sources]
include = ["src/Dungeon/Client/**/*.fpas"]
