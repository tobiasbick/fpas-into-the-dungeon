// Connection-local dialogue dispatch, authoritative choice validation and atomic state/frame commits.
unit Dungeon.Server.Dialogue;

uses
  Dungeon.GameState as GameState, Dungeon.World.Quests as Quests, Dungeon.Server.Failures as Failures, Dungeon.Dialogue as Rules, Dungeon.Protocol as Protocol, Dungeon.Server.Logging as Logging,
  Dungeon.Server.Replies as Replies, Dungeon.Server.Session as SessionUnit, Std.Net as Net, Std.Tasks as Tasks;

function Rejected(
  Session: SessionUnit.ServerSession; Code: string; Reason: string; Connection: Net.Connection;
  Token: Tasks.CancellationToken; Logs: option of channel of Logging.ServerLogEvent
): result of (SessionUnit.ServerSession, string);
begin
  Logging.LogServer(Logs, 'rejected', Code + ': ' + Reason);
  const Sent := try Replies.Reject(Connection, Code, Reason, Token);
  return Ok(Session);
end function;

function Commit(
  Session: SessionUnit.ServerSession; Outcome: Rules.Outcome; Connection: Net.Connection;
  Token: Tasks.CancellationToken; Logs: option of channel of Logging.ServerLogEvent
): result of (SessionUnit.ServerSession, string);
begin
  var Candidate := Session;
  case Outcome of
    when Rules.Outcome.Continued(const State, const Frame, const ChangesGame):
      Candidate.State := Some(State);
      Candidate.ActiveInteraction := Some(SessionUnit.ActiveInteraction.Dialogue(Frame));
      Candidate.Dirty := Session.Dirty or ChangesGame;
    when Rules.Outcome.Ended(const State):
      Candidate.State := Some(State);
      Candidate.ActiveInteraction := None;
  end case;

  return Replies.CommitInteraction(
    Session,
    Candidate,
    'dialogue_rejected',
    Connection,
    Token,
    Logs
  );
end function;

// Starts the generic Enter conversation after the caller has selected the game-rule NPC target.
// A first meeting marks progress dirty; repeat greetings and text-only choices retain the previous save status.
public function StartConversation(
  Session: SessionUnit.ServerSession; Connection: Net.Connection;
  Token: Tasks.CancellationToken; Logs: option of channel of Logging.ServerLogEvent
): result of (SessionUnit.ServerSession, string);
begin
  const State := try SessionUnit.RequireActiveState(Session.State);
  case Rules.Start(try SessionUnit.SessionAreaView(Session, State), State) of
    when Ok(const Outcome):
      return Commit(Session, Outcome, Connection, Token, Logs);
    when Error(const Reason):
      return Rejected(Session, 'interaction_rejected', Reason, Connection, Token, Logs);
  end case;
end function;

function CheckedChoice(Value: result of (Rules.Outcome, string)): result of (Rules.Outcome, Failures.FailureRejection);
begin
  case Value of
    when Ok(const Outcome):
      return Ok(Outcome);
    when Error(const Reason):
      return Error(Failures.FailureRejection(Code := 'dialogue_rejected', Message := Reason));
  end case;
end function;

function Choose(Session: SessionUnit.ServerSession; View: GameState.AreaView; State: GameState.GameState; Frame: Rules.Frame; Id: string; Logs: option of channel of Logging.ServerLogEvent): result of (Rules.Outcome, Failures.FailureRejection);
begin
  if (Id = 'quest') and Rules.MayOfferCompass(View, State, Frame) then
    case Quests.ProveCompass(Session.World, State) of
      when Ok(const Objective):
        return CheckedChoice(Rules.OfferCompass(View, State, Frame, Objective));
      when Error(const Failure):
        Logging.LogServer(Logs, 'quest_preflight', Failures.AreaFailureReason(Failure));
        return Error(Failures.AreaRejection(Session.World.Metadata.Id, Failure));
    end case;
  end if;

  return CheckedChoice(Rules.Choose(View, State, Frame, Id));
end function;

// Handles dialogue intentions after the active-game prerequisite; returns None for other dispatch owners.
public function HandleMessage(
  Session: SessionUnit.ServerSession; Message: Protocol.ClientMessage; Connection: Net.Connection;
  Token: Tasks.CancellationToken; Logs: option of channel of Logging.ServerLogEvent
): result of (option of SessionUnit.ServerSession, string);
begin
  case Message of
    when Protocol.ClientMessage.DialogueChoice(const NpcId, const ChoiceId):
      case Session.ActiveInteraction of
        when None, Some(SessionUnit.ActiveInteraction.Trade(_)):
          return Ok(
            Some(
              try Rejected(
                Session,
                'dialogue_not_active',
                'No dialogue is active.',
                Connection,
                Token,
                Logs
              )
            )
          );
        when Some(SessionUnit.ActiveInteraction.Dialogue(const Frame)):
          if NpcId <> Frame.NpcId then
            return Ok(
              Some(
                try Rejected(
                  Session,
                  'dialogue_rejected',
                  'Dialogue names an unknown NPC.',
                  Connection,
                  Token,
                  Logs
                )
              )
            );
          end if;
          const State := try SessionUnit.RequireActiveState(Session.State);
          case Choose(
            Session,
            try SessionUnit.SessionAreaView(Session, State),
            State,
            Frame,
            ChoiceId,
            Logs
          ) of
            when Ok(const Outcome):
              return Ok(Some(try Commit(Session, Outcome, Connection, Token, Logs)));
            when Error(const Failure):
              return Ok(
                Some(try Rejected(Session, Failure.Code, Failure.Message, Connection, Token, Logs))
              );
          end case;
      end case;
    when Protocol.ClientMessage.EndDialogue:
      case Session.ActiveInteraction of
        when None, Some(SessionUnit.ActiveInteraction.Trade(_)):
          return Ok(
            Some(
              try Rejected(
                Session,
                'dialogue_not_active',
                'No dialogue is active.',
                Connection,
                Token,
                Logs
              )
            )
          );
        when Some(SessionUnit.ActiveInteraction.Dialogue(const Frame)):
          const State := try SessionUnit.RequireActiveState(Session.State);
          case Rules.EndConversation(try SessionUnit.SessionAreaView(Session, State), State, Frame) of
            when Ok(const Outcome):
              return Ok(Some(try Commit(Session, Outcome, Connection, Token, Logs)));
            when Error(const Reason):
              return Ok(
                Some(try Rejected(Session, 'dialogue_rejected', Reason, Connection, Token, Logs))
              );
          end case;
      end case;
    when Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      return Ok(None);
  end case;
end function;
end unit;
