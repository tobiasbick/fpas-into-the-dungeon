// Conversions from authoritative game enumerations and clock into protocol values.
unit Dungeon.Server.Mapping;

uses Dungeon.Weather as Weather, Dungeon.Time as Clock, Dungeon.Dialogue as DialogueRules, Dungeon.Combat as Combat, Dungeon.Coordinates as Coordinates, Dungeon.Hostiles as HostileRules, Dungeon.Items as ItemRules, Dungeon.Protocol as Protocol;

// Returns the protocol facing of a game facing.
public function ProtocolFacing(Value: Coordinates.FacingDirection): Protocol.FirstPersonFacing;
begin
  case Value of
    when Coordinates.FacingDirection.North:
      begin
        return Protocol.FirstPersonFacing.North;
      end;
    when Coordinates.FacingDirection.East:
      begin
        return Protocol.FirstPersonFacing.East;
      end;
    when Coordinates.FacingDirection.South:
      begin
        return Protocol.FirstPersonFacing.South;
      end;
    when Coordinates.FacingDirection.West:
      begin
        return Protocol.FirstPersonFacing.West;
      end;
  end case;
end function;

// Returns the game step of a protocol step direction.
public function GameStep(Value: Protocol.FirstPersonStepDirection): Coordinates.RelativeStep;
begin
  case Value of
    when Protocol.FirstPersonStepDirection.Forward:
      begin
        return Coordinates.RelativeStep.Forward;
      end;
    when Protocol.FirstPersonStepDirection.Backward:
      begin
        return Coordinates.RelativeStep.Backward;
      end;
    when Protocol.FirstPersonStepDirection.Left:
      begin
        return Coordinates.RelativeStep.Left;
      end;
    when Protocol.FirstPersonStepDirection.Right:
      begin
        return Coordinates.RelativeStep.Right;
      end;
  end case;
end function;

// Returns the game turn of a protocol turn direction.
public function GameTurn(Value: Protocol.FirstPersonTurnDirection): Coordinates.RelativeTurn;
begin
  case Value of
    when Protocol.FirstPersonTurnDirection.Left:
      begin
        return Coordinates.RelativeTurn.TurnLeft;
      end;
    when Protocol.FirstPersonTurnDirection.Right:
      begin
        return Coordinates.RelativeTurn.TurnRight;
      end;
  end case;
end function;

// Returns the protocol slot of a game equipment slot.
public function ProtocolSlot(Value: ItemRules.EquipmentSlot): Protocol.VisibleItemSlot;
begin
  case Value of
    when ItemRules.EquipmentSlot.Weapon:
      begin
        return Protocol.VisibleItemSlot.Weapon;
      end;
    when ItemRules.EquipmentSlot.Body:
      begin
        return Protocol.VisibleItemSlot.Body;
      end;
  end case;
end function;

// Returns the protocol form of one combat event.
public function ProtocolCombatEvent(Value: Combat.CombatEvent): Protocol.VisibleCombatEvent;
begin
  var Kind: Protocol.VisibleCombatEventKind := Protocol.VisibleCombatEventKind.PlayerMiss;
  case Value.Kind of
    when Combat.CombatEventKind.PlayerHit:
      begin
        Kind := Protocol.VisibleCombatEventKind.PlayerHit;
      end;
    when Combat.CombatEventKind.PlayerMiss:
      begin
        Kind := Protocol.VisibleCombatEventKind.PlayerMiss;
      end;
    when Combat.CombatEventKind.HostileHit:
      begin
        Kind := Protocol.VisibleCombatEventKind.HostileHit;
      end;
    when Combat.CombatEventKind.HostileMiss:
      begin
        Kind := Protocol.VisibleCombatEventKind.HostileMiss;
      end;
    when Combat.CombatEventKind.HostileDefeated:
      begin
        Kind := Protocol.VisibleCombatEventKind.HostileDefeated;
      end;
  end case;

  return Protocol.VisibleCombatEvent(
    Kind := Kind,
    Amount := Value.Amount,
    HostileCode := HostileRules.HostileVisibleCode(Value.HostileKind)
  );
end function;

// Converts the authoritative frame without deriving availability, topics or text on the client side.
public function ProtocolDialogue(Value: DialogueRules.Frame): Protocol.DialogueFrame;
begin
  var Choices: array of Protocol.DialogueChoice := [];
  for Choice: DialogueRules.Choice in Value.Choices do
    Choices.PushInPlace(Protocol.DialogueChoice(Id := Choice.Id, Text := Choice.Text));
  end for;

  return Protocol.DialogueFrame(
    NpcId := Value.NpcId,
    Speaker := Value.Speaker,
    Text := Value.Text,
    Choices := Choices
  );
end function;

// Projects current open-air weather, or explicit shelter, without state or file mutations.
public function ProtocolWeather(Seed: integer; Minutes: integer; Area: Coordinates.AreaKind): option of Protocol.WeatherKind;
begin
  if Area = Coordinates.AreaKind.Dungeon then
    return None;
  end if;

  return Some(
    case Weather.At(Seed, Minutes) of
      when Weather.WeatherKind.Clear: Protocol.WeatherKind.Clear;
      when Weather.WeatherKind.Rain: Protocol.WeatherKind.Rain;
    end case
  );
end function;

// Projects the canonical clock without sharing game-time rules with the client.
public function ProtocolTime(Minutes: integer): Protocol.VisibleTime;
begin
  return Protocol.VisibleTime(
    Day := Clock.DayNumber(Minutes), MinuteOfDay := Clock.MinuteOfDay(Minutes),
    Phase := case Clock.Phase(Minutes) of
      when Clock.DayPhase.Day: Protocol.DayPhase.Day;
      when Clock.DayPhase.Night: Protocol.DayPhase.Night;
    end case
  );
end function;
end unit;
