// Conversions between game-rule and protocol enumerations.
unit Dungeon.Server.Mapping;

uses Dungeon.Combat, Dungeon.Coordinates, Dungeon.Items, Dungeon.Protocol;

// Returns the protocol facing of a game facing.
public function ProtocolFacing(Value: FacingDirection): FirstPersonFacing;
begin
  case Value of
    when FacingDirection.North:
      begin
        return FirstPersonFacing.North;
      end;
    when FacingDirection.East:
      begin
        return FirstPersonFacing.East;
      end;
    when FacingDirection.South:
      begin
        return FirstPersonFacing.South;
      end;
    when FacingDirection.West:
      begin
        return FirstPersonFacing.West;
      end;
  end case;
end function;

// Returns the game step of a protocol step direction.
public function GameStep(Value: FirstPersonStepDirection): RelativeStep;
begin
  case Value of
    when FirstPersonStepDirection.Forward:
      begin
        return RelativeStep.Forward;
      end;
    when FirstPersonStepDirection.Backward:
      begin
        return RelativeStep.Backward;
      end;
    when FirstPersonStepDirection.Left:
      begin
        return RelativeStep.Left;
      end;
    when FirstPersonStepDirection.Right:
      begin
        return RelativeStep.Right;
      end;
  end case;
end function;

// Returns the game turn of a protocol turn direction.
public function GameTurn(Value: FirstPersonTurnDirection): RelativeTurn;
begin
  case Value of
    when FirstPersonTurnDirection.Left:
      begin
        return RelativeTurn.TurnLeft;
      end;
    when FirstPersonTurnDirection.Right:
      begin
        return RelativeTurn.TurnRight;
      end;
  end case;
end function;

// Returns the protocol slot of a game equipment slot.
public function ProtocolSlot(Value: EquipmentSlot): VisibleItemSlot;
begin
  case Value of
    when EquipmentSlot.Weapon:
      begin
        return VisibleItemSlot.Weapon;
      end;
    when EquipmentSlot.Body:
      begin
        return VisibleItemSlot.Body;
      end;
  end case;
end function;

// Returns the protocol form of one combat event.
public function ProtocolCombatEvent(Value: CombatEvent): VisibleCombatEvent;
begin
  mutable var Kind: VisibleCombatEventKind := VisibleCombatEventKind.PlayerMiss;
  case Value.Kind of
    when CombatEventKind.PlayerHit:
      begin
        Kind := VisibleCombatEventKind.PlayerHit;
      end;
    when CombatEventKind.PlayerMiss:
      begin
        Kind := VisibleCombatEventKind.PlayerMiss;
      end;
    when CombatEventKind.HostileHit:
      begin
        Kind := VisibleCombatEventKind.HostileHit;
      end;
    when CombatEventKind.HostileMiss:
      begin
        Kind := VisibleCombatEventKind.HostileMiss;
      end;
    when CombatEventKind.HostileDefeated:
      begin
        Kind := VisibleCombatEventKind.HostileDefeated;
      end;
  end case;

  return record
    Kind := Kind;
    Amount := Value.Amount;
  end;
end function;
end unit;
