// Public dashboard facade; the application owns channels, subscriptions and terminal lifetime.
unit Dungeon.Server.Console;

uses
  Dungeon.Server.Config as Config, Dungeon.Server.Console.Application as Application,
  Dungeon.Server.Console.Model as Model, Dungeon.Server.Logging as Logging,
  Std.Tasks as Tasks, Std.Tui as Tui;

// Shared keyboard/modal update for consumers rendering the console model independently.
public function UpdateServerConsole(State: Model.ConsoleModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): Model.ConsoleModel;
begin
  return Application.UpdateServerConsole(State, Msg, Cmd);
end function;

// Listener failures and stops use the same explicit logging path as the interactive host.
public function RunConsoleListener(Host: string; Port: integer; Value: Config.ServerConfig; Token: Tasks.CancellationToken): result of (boolean, string);
begin
  return Application.RunConsoleListener(Host, Port, Value, Token);
end function;

// Applies immutable diagnostic events without starting background work.
public function UpdateServerConsoleEvent(State: Model.ConsoleModel; Value: Logging.ServerLogEvent; Cmd: Tui.TuiCmdOutput): Model.ConsoleModel;
begin
  return Application.UpdateServerConsoleEvent(State, Value, Cmd);
end function;

// Full-window dashboard with isolated settings and world management.
public function ViewServerConsole(State: Model.ConsoleModel): Tui.TuiElement;
begin
  return Application.ViewServerConsole(State);
end function;

// Runs the native terminal host and joins every background operation before returning.
public function RunServerConsole(Host: string; Port: integer; Value: Config.ServerConfig): integer;
begin
  return Application.RunServerConsole(Host, Port, Value);
end function;
end unit;
