// Temporary server-owned initial geometry supplier until dungeon level storage is connected.
unit Dungeon.Server.InitialAreas;

uses
  Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interior, Dungeon.Interior.InitialDungeon,
  Dungeon.Movement;

// Supplies the temporary target map outside game rules after checking transition eligibility.
public function ActivateInitialTransition(View: AreaView; State: GameState): result of AreaTransition, string;
begin
  var Target: string := try AreaTransitionTarget(View, State);
  mutable var Map: option of InteriorMap := None;
  if State.Area = AreaKind.OutdoorRegion then
  begin
    Map := Some(try InitialDungeonMap(View.Metadata))
  end;

  return ActivateAreaTransition(View, State, Map)
end;
