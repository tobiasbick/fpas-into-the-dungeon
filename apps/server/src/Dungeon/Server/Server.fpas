// Authoritative world-backed server for versioned client sessions.
unit Dungeon.Server;

uses
  Dungeon.Combat, Dungeon.Coordinates, Dungeon.Dialogue, Dungeon.Equipment, Dungeon.Exploration,
  Dungeon.Exploration.Model, Dungeon.GameState, Dungeon.Interaction, Dungeon.Interior,
  Dungeon.Interior.InitialDungeon, Dungeon.Items, Dungeon.Movement, Dungeon.Npcs, Dungeon.Protocol,
  Dungeon.Protocol.ClientMessages, Dungeon.Protocol.ServerMessages, Dungeon.Protocol.Transport,
  Dungeon.Terrain, Dungeon.Terrain.Generation, Dungeon.World, Dungeon.World.Savegame, Std.Arrays,
  Std.Console, Std.Conv, Std.Net, Std.Options, Std.Results, Std.Server, Std.Str, Std.Task, Std.Time;

public type
  // Immutable server policy and selected persistent world used by each session.
  ServerConfig = record
    public WorldsRoot: string;
    public WorldId: string;
    public WorldSeed: integer;
    public ChunkCacheLimit: integer;
    public MaximumViewWidth: integer;
    public MaximumViewHeight: integer;
  end;

type
  ViewportSize = record
    Width: integer;
    Height: integer;
  end;
  SessionProjection = record
    World: WorldSession;
    State: VisibleState;
  end;
  MaskedRows = record
    Rows: array of string;
    KnowledgeRows: array of string;
  end;
  // Per-connection state carried between client messages after the handshake.
  ServerSession = record
    World: WorldSession;
    State: option of GameState;
    ActiveDialogueNpcId: option of string;
    Viewport: ViewportSize;
    // Set when the connection must close after the current message.
    Finished: boolean;
  end;

function Send(ConnectionValue: Connection; Message: ServerMessage; Token: CancellationToken): result of boolean, string;
begin
  return WriteLine(ConnectionValue, EncodeServer(Message), Token)
end;

function ResolveViewport(Width: integer; Height: integer; Config: ServerConfig): result of ViewportSize, string;
begin
  if (Width < 1) or (Height < 1) then
  begin
    return Error('viewport dimensions must be positive')
  end;
  mutable var BoundedWidth: integer := Width;
  mutable var BoundedHeight: integer := Height;
  if BoundedWidth > Config.MaximumViewWidth then
  begin
    BoundedWidth := Config.MaximumViewWidth
  end;

  if BoundedHeight > Config.MaximumViewHeight then
  begin
    BoundedHeight := Config.MaximumViewHeight
  end;

  return Ok(record
    Width := BoundedWidth;
    Height := BoundedHeight;
  end)
end;

function MaximumIntersectingChunks(Length: integer): integer;
begin
  if Length = 1 then
  begin
    return 1
  end;

  return ((Length - 2) div WorldChunkSize) + 2
end;

function RequiredCacheCapacity(Config: ServerConfig): integer;
begin
  return (MaximumIntersectingChunks(Config.MaximumViewWidth) + 2) *
         (MaximumIntersectingChunks(Config.MaximumViewHeight) + 2)
end;

function RequiresActiveSession(Message: ClientMessage): boolean;
begin
  case Message of
    ClientMessage.Viewport(Width, Height):
    begin
      return true
    end;
    ClientMessage.ExplorationMap(OriginX, OriginY, Width, Height):
    begin
      return true
    end;
    ClientMessage.Move(DeltaX, DeltaY):
    begin
      return true
    end;
    ClientMessage.StepFirstPerson(Direction):
    begin
      return true
    end;
    ClientMessage.TurnFirstPerson(Direction):
    begin
      return true
    end;
    ClientMessage.Interact:
    begin
      return true
    end;
    ClientMessage.DialogueChoice(ChoiceId):
    begin
      return true
    end;
    ClientMessage.EndDialogue:
    begin
      return true
    end;
    ClientMessage.SaveGame:
    begin
      return true
    end;
    ClientMessage.Attack:
    begin
      return true
    end;
    ClientMessage.Wait:
    begin
      return true
    end;
    ClientMessage.Equip(ItemId):
    begin
      return true
    end;
    ClientMessage.Unequip(ItemId):
    begin
      return true
    end
    else
    begin
      return false
    end
  end
end;

function AllowedWhileDialogueActive(Message: ClientMessage): boolean;
begin
  case Message of
    ClientMessage.DialogueChoice(ChoiceId):
    begin
      return true
    end;
    ClientMessage.EndDialogue:
    begin
      return true
    end;
    ClientMessage.Viewport(Width, Height):
    begin
      return true
    end;
    ClientMessage.Disconnect:
    begin
      return true
    end
    else
    begin
      return false
    end
  end
end;

function RequiresActiveDialogue(Message: ClientMessage): boolean;
begin
  case Message of
    ClientMessage.DialogueChoice(ChoiceId):
    begin
      return true
    end;
    ClientMessage.EndDialogue:
    begin
      return true
    end
    else
    begin
      return false
    end
  end
end;

function RequireActiveState(State: option of GameState): result of GameState, string;
begin
  case State of
    Some(Value):
    begin
      return Ok(Value)
    end;
    None:
    begin
      return Error('server session has no active game state')
    end
  end
end;

function ProtocolFacing(Value: FacingDirection): FirstPersonFacing;
begin
  case Value of
    FacingDirection.North:
    begin
      return FirstPersonFacing.North
    end;
    FacingDirection.East:
    begin
      return FirstPersonFacing.East
    end;
    FacingDirection.South:
    begin
      return FirstPersonFacing.South
    end;
    FacingDirection.West:
    begin
      return FirstPersonFacing.West
    end
  end
end;

function GameStep(Value: FirstPersonStepDirection): RelativeStep;
begin
  case Value of
    FirstPersonStepDirection.Forward:
    begin
      return RelativeStep.Forward
    end;
    FirstPersonStepDirection.Backward:
    begin
      return RelativeStep.Backward
    end;
    FirstPersonStepDirection.Left:
    begin
      return RelativeStep.Left
    end;
    FirstPersonStepDirection.Right:
    begin
      return RelativeStep.Right
    end
  end
end;

function GameTurn(Value: FirstPersonTurnDirection): RelativeTurn;
begin
  case Value of
    FirstPersonTurnDirection.Left:
    begin
      return RelativeTurn.TurnLeft
    end;
    FirstPersonTurnDirection.Right:
    begin
      return RelativeTurn.TurnRight
    end
  end
end;

function ProtocolSlot(Value: EquipmentSlot): VisibleItemSlot;
begin
  case Value of
    EquipmentSlot.Weapon:
    begin
      return VisibleItemSlot.Weapon
    end;
    EquipmentSlot.Body:
    begin
      return VisibleItemSlot.Body
    end
  end
end;

function ProjectInventory(State: GameState): array of VisibleInventoryItem;
begin
  mutable var Values: array of VisibleInventoryItem := [];
  for Item: GameItem in InventoryItems(State) do
  begin
    mutable var Slot: VisibleItemSlot := VisibleItemSlot.NoSlot;
    case ItemSlot(Item.Kind) of
      Some(Fitting):
      begin
        Slot := ProtocolSlot(Fitting)
      end;
      None:
      begin
      end
    end;
    mutable var Equipped: boolean := false;
    case Item.Location of
      ItemLocation.EquippedByPlayer(Worn):
      begin
        Equipped := true
      end
      else
      begin
      end
    end;

    Std.Arrays.Push(Values, record
      Id := Item.Id;
      Name := ItemDisplayName(Item.Kind);
      Slot := Slot;
      Equipped := Equipped;
    end)
  end;

  return Values
end;

function ProjectCharacter(State: GameState): array of VisibleCharacterValue;
begin
  mutable var Values: array of VisibleCharacterValue := [];
  for Line: CharacterValueLine in CharacterValueLines(State) do
  begin
    Std.Arrays.Push(Values, record
      Label := Line.Label;
      Value := Line.Value;
      Source := Line.Source;
    end)
  end;

  return Values
end;

type
  // Messages and structured events of the turn that produced a projected state.
  TurnReport = record
    Log: array of string;
    Events: array of CombatEvent;
  end;

function NoTurnReport(): TurnReport;
begin
  return record
    Log := [];
    Events := [];
  end
end;

function ProtocolCombatEvent(Value: CombatEvent): VisibleCombatEvent;
begin
  mutable var Kind: VisibleCombatEventKind := VisibleCombatEventKind.PlayerMiss;
  case Value.Kind of
    CombatEventKind.PlayerHit:
    begin
      Kind := VisibleCombatEventKind.PlayerHit
    end;
    CombatEventKind.PlayerMiss:
    begin
      Kind := VisibleCombatEventKind.PlayerMiss
    end;
    CombatEventKind.HostileHit:
    begin
      Kind := VisibleCombatEventKind.HostileHit
    end;
    CombatEventKind.HostileMiss:
    begin
      Kind := VisibleCombatEventKind.HostileMiss
    end;
    CombatEventKind.HostileDefeated:
    begin
      Kind := VisibleCombatEventKind.HostileDefeated
    end
  end;

  return record
    Kind := Kind;
    Amount := Value.Amount;
  end
end;

function ProjectDialogue(Value: NpcDialogue): VisibleDialogue;
begin
  mutable var Choices: array of VisibleDialogueChoice := [];
  for Choice: NpcDialogueChoice in Value.Choices do
  begin
    Std.Arrays.Push(Choices, record
      Id := Choice.Id;
      Text := Choice.Text;
    end)
  end;

  return record
    NpcId := Value.NpcId;
    Speaker := Value.Speaker;
    Text := Value.Text;
    Choices := Choices;
  end
end;

function InteriorRows(State: GameState; Map: InteriorMap): result of array of string, string;
begin
  mutable var Rows: array of string := [];
  for Y: integer := 0 to Map.Height - 1 do
  begin
    mutable var Row: string := '';
    for X: integer := 0 to Map.Width - 1 do
    begin
      Row := Row + (try InteriorVisibleCodeForState(Map, State, record
        X := X;
        Y := Y;
      end))
    end;

    Std.Arrays.Push(Rows, Row)
  end;

  return Ok(Rows)
end;

function KnowledgeCode(Value: FieldKnowledge): string;
begin
  case Value of
    FieldKnowledge.Undiscovered:
    begin
      return KnowledgeUndiscoveredCode
    end;
    FieldKnowledge.Remembered:
    begin
      return KnowledgeRememberedCode
    end;
    FieldKnowledge.Visible:
    begin
      return KnowledgeVisibleCode
    end
  end
end;

function MaskOutdoorRows(
  State: GameState;
  TerrainRows: array of string;
  OriginX: integer;
  OriginY: integer;
  Width: integer;
  Height: integer;
  Player: WorldPosition
): MaskedRows;
begin
  var VisibleFields: array of boolean := OutdoorVisibility(OriginX, OriginY, Width, Height, Player);
  mutable var Rows: array of string := [];
  mutable var KnowledgeRows: array of string := [];
  for Y: integer := 0 to Height - 1 do
  begin
    mutable var Row: string := '';
    mutable var KnowledgeRow: string := '';
    for X: integer := 0 to Width - 1 do
    begin
      var WorldX: integer := OriginX + X;
      var WorldY: integer := OriginY + Y;
      var Knowledge: FieldKnowledge := ClassifyField(OutdoorIsDiscovered(State.Exploration, WorldX, WorldY), VisibleFields[(Y * Width) +
                                                                                                                           X]);
      if Knowledge = FieldKnowledge.Undiscovered then
      begin
        Row := Row + UnknownFieldCode
      end
      else
      begin
        Row := Row + Std.Str.CharAt(TerrainRows[Y], X)
      end;

      KnowledgeRow := KnowledgeRow + KnowledgeCode(Knowledge)
    end;

    Std.Arrays.Push(Rows, Row);
    Std.Arrays.Push(KnowledgeRows, KnowledgeRow)
  end;

  return record
    Rows := Rows;
    KnowledgeRows := KnowledgeRows;
  end
end;

function MaskInteriorRows(State: GameState; Map: InteriorMap; Pose: FirstPersonPose): result of MaskedRows, string;
begin
  var TerrainRows: array of string := try InteriorRows(State, Map);
  var VisibleFields: array of boolean := InteriorVisibility(Map, Pose);
  mutable var Rows: array of string := [];
  mutable var KnowledgeRows: array of string := [];
  for Y: integer := 0 to Map.Height - 1 do
  begin
    mutable var Row: string := '';
    mutable var KnowledgeRow: string := '';
    for X: integer := 0 to Map.Width - 1 do
    begin
      var Knowledge: FieldKnowledge := ClassifyField(InteriorIsDiscovered(State.Exploration, State.AreaId, Map.Width, X, Y), VisibleFields[(Y * Map.Width) +
                                                                                                                                           X]);
      if Knowledge = FieldKnowledge.Undiscovered then
      begin
        Row := Row + UnknownFieldCode
      end
      else
      begin
        mutable var Code: string := Std.Str.CharAt(TerrainRows[Y], X);
        if (Knowledge = FieldKnowledge.Remembered) and
           (((Code = InteriorItemCode) or (Code = InteriorNpcCode)) or (Code = InteriorHostileCode)) then
        begin
          Code := try InteriorVisibleCode(Map, record
            X := X;
            Y := Y;
          end)
        end;

        Row := Row + Code
      end;

      KnowledgeRow := KnowledgeRow + KnowledgeCode(Knowledge)
    end;

    Std.Arrays.Push(Rows, Row);
    Std.Arrays.Push(KnowledgeRows, KnowledgeRow)
  end;

  return Ok(record
    Rows := Rows;
    KnowledgeRows := KnowledgeRows;
  end)
end;

function PlayerInWindow(
  PlayerX: integer;
  PlayerY: integer;
  OriginX: integer;
  OriginY: integer;
  Width: integer;
  Height: integer
): boolean;
begin
  return (((PlayerX >= OriginX) and (PlayerX < OriginX + Width)) and (PlayerY >= OriginY)) and
         (PlayerY < OriginY + Height)
end;

function ProjectExplorationMap(
  State: GameState;
  Metadata: WorldMetadata;
  OriginX: integer;
  OriginY: integer;
  Width: integer;
  Height: integer
): result of ExplorationMapState, string;
begin
  mutable var Rows: array of string := [];
  mutable var KnowledgeRows: array of string := [];
  if State.Area = AreaKind.OutdoorRegion then
  begin
    var Player: WorldPosition := try OutdoorPlayerPosition(State);
    var VisibleFields: array of boolean := OutdoorVisibility(OriginX, OriginY, Width, Height, Player);
    for Y: integer := 0 to Height - 1 do
    begin
      mutable var Row: string := '';
      mutable var KnowledgeRow: string := '';
      for X: integer := 0 to Width - 1 do
      begin
        var WorldX: integer := OriginX + X;
        var WorldY: integer := OriginY + Y;
        var Knowledge: FieldKnowledge := ClassifyField(OutdoorIsDiscovered(State.Exploration, WorldX, WorldY), VisibleFields[(Y * Width) +
                                                                                                                             X]);
        if Knowledge = FieldKnowledge.Undiscovered then
        begin
          Row := Row + UnknownFieldCode
        end
        else
        begin
          Row := Row + VisibleCellCode(GenerateWorldCell(Metadata, WorldX, WorldY))
        end;

        KnowledgeRow := KnowledgeRow + KnowledgeCode(Knowledge)
      end;

      Std.Arrays.Push(Rows, Row);
      Std.Arrays.Push(KnowledgeRows, KnowledgeRow)
    end;

    return Ok(record
      View := ViewKind.Map;
      LabelText := Metadata.OutdoorAreaLabel;
      OriginX := OriginX;
      OriginY := OriginY;
      Width := Width;
      Height := Height;
      Rows := Rows;
      KnowledgeRows := KnowledgeRows;
      PlayerWorldX := Player.X;
      PlayerWorldY := Player.Y;
      PlayerInWindow := PlayerInWindow(Player.X, Player.Y, OriginX, OriginY, Width, Height);
    end)
  end;
  var Map: InteriorMap := try InitialDungeonMap();
  var Pose: FirstPersonPose := try FirstPersonPlayerPose(State);
  var VisibleFields: array of boolean := InteriorVisibility(Map, Pose);
  for LocalY: integer := 0 to Height - 1 do
  begin
    mutable var Row: string := '';
    mutable var KnowledgeRow: string := '';
    for LocalX: integer := 0 to Width - 1 do
    begin
      var X: integer := OriginX + LocalX;
      var Y: integer := OriginY + LocalY;
      mutable var Knowledge: FieldKnowledge := FieldKnowledge.Undiscovered;
      if (((X >= 0) and (X < Map.Width)) and (Y >= 0)) and (Y < Map.Height) then
      begin
        Knowledge := ClassifyField(InteriorIsDiscovered(State.Exploration, State.AreaId, Map.Width, X, Y), VisibleFields[(Y * Map.Width) +
                                                                                                                         X])
      end;

      if Knowledge = FieldKnowledge.Undiscovered then
      begin
        Row := Row + UnknownFieldCode
      end
      else
      begin
        mutable var Code: string := try InteriorVisibleCodeForState(Map, State, record
          X := X;
          Y := Y;
        end);
        if (Knowledge = FieldKnowledge.Remembered) and
           (((Code = InteriorItemCode) or (Code = InteriorNpcCode)) or (Code = InteriorHostileCode)) then
        begin
          Code := try InteriorVisibleCode(Map, record
            X := X;
            Y := Y;
          end)
        end;

        Row := Row + Code
      end;

      KnowledgeRow := KnowledgeRow + KnowledgeCode(Knowledge)
    end;

    Std.Arrays.Push(Rows, Row);
    Std.Arrays.Push(KnowledgeRows, KnowledgeRow)
  end;

  return Ok(record
    View := ViewKind.FirstPerson;
    LabelText := Metadata.DungeonAreaLabel;
    OriginX := OriginX;
    OriginY := OriginY;
    Width := Width;
    Height := Height;
    Rows := Rows;
    KnowledgeRows := KnowledgeRows;
    PlayerWorldX := Pose.Position.X;
    PlayerWorldY := Pose.Position.Y;
    PlayerInWindow := PlayerInWindow(Pose.Position.X, Pose.Position.Y, OriginX, OriginY, Width, Height);
  end)
end;

// Projects the current area; Report carries the messages and events of the turn that produced State.
function ProjectSession(
  World: WorldSession;
  State: GameState;
  Viewport: ViewportSize;
  Report: TurnReport
): result of SessionProjection, string;
begin
  if State.Area = AreaKind.Dungeon then
  begin
    var Map: InteriorMap := try InitialDungeonMap();
    var Pose: FirstPersonPose := try FirstPersonPlayerPose(State);
    // Keep the protocol's required status text neutral when no action is available.
    mutable var Status: string := 'Nothing in reach';
    var Hint: string := InteractionHint(State);
    if Hint <> '' then
    begin
      Status := Hint
    end;

    if (Pose.Position.X = Map.Exit.X) and (Pose.Position.Y = Map.Exit.Y) then
    begin
      Status := 'Press Enter to return to the outdoor region.'
    end;
    var Masked: MaskedRows := try MaskInteriorRows(State, Map, Pose);
    var FirstPersonValue: FirstPersonVisibleState := record
      Title := World.Metadata.DungeonAreaLabel;
      Status := Status;
      Width := Map.Width;
      Height := Map.Height;
      Rows := Masked.Rows;
      KnowledgeRows := Masked.KnowledgeRows;
      PlayerX := Pose.Position.X;
      PlayerY := Pose.Position.Y;
      Facing := ProtocolFacing(Pose.Facing);
      Inventory := ProjectInventory(State);
      Health := State.Health;
      MaxHealth := DeriveCharacterValues(State).MaximumHealth;
      Character := ProjectCharacter(State);
      CombatLog := Report.Log;
      CombatEvents := Std.Arrays.Map(Report.Events, ProtocolCombatEvent);
    end;

    return Ok(record
      World := World;
      State := VisibleState.FirstPersonState(FirstPersonValue);
    end)
  end;
  var Loaded: WindowLoad := try LoadVisibleWindow(World, State, Viewport.Width, Viewport.Height);
  var OutdoorPosition: WorldPosition := try OutdoorPlayerPosition(State);
  var Masked: MaskedRows := MaskOutdoorRows(State, Loaded.Window.Rows, Loaded.Window.OriginX, Loaded.Window.OriginY, Loaded.Window.Width, Loaded.Window.Height, OutdoorPosition);
  var MapValue: MapVisibleState := record
    OriginX := Loaded.Window.OriginX;
    OriginY := Loaded.Window.OriginY;
    Width := Loaded.Window.Width;
    Height := Loaded.Window.Height;
    Rows := Masked.Rows;
    KnowledgeRows := Masked.KnowledgeRows;
    PlayerX := Loaded.Window.PlayerX;
    PlayerY := Loaded.Window.PlayerY;
    WorldX := OutdoorPosition.X;
    WorldY := OutdoorPosition.Y;
    Inventory := ProjectInventory(State);
    Health := State.Health;
    MaxHealth := DeriveCharacterValues(State).MaximumHealth;
    Character := ProjectCharacter(State);
  end;

  return Ok(record
    World := Loaded.World;
    State := VisibleState.MapState(MapValue);
  end)
end;

function FinishReadFailure(ConnectionValue: Connection; Message: string; Token: CancellationToken): result of boolean, string;
begin
  if Message = LineTooLongError then
  begin
    var Sent: boolean := try Send(ConnectionValue, ServerMessage.ErrorMessage('line_too_long', Message), Token)
  end;

  return Ok(true)
end;

function SendProjection(
  ConnectionValue: Connection;
  World: WorldSession;
  State: GameState;
  Viewport: ViewportSize;
  Report: TurnReport;
  Token: CancellationToken
): result of WorldSession, string;
begin
  var Projection: SessionProjection := try ProjectSession(World, State, Viewport, Report);
  var Sent: boolean := try Send(ConnectionValue, ServerMessage.State(Projection.State), Token);
  return Ok(Projection.World)
end;

function Reject(
  ConnectionValue: Connection;
  Code: string;
  Message: string;
  Token: CancellationToken
): result of boolean, string;
begin
  return Send(ConnectionValue, ServerMessage.Rejected(Code, Message), Token)
end;

// Reveals the accepted state, makes it current, and sends its projection with the turn's report.
function CommitTurn(
  Session: ServerSession;
  Changed: GameState;
  Report: TurnReport;
  ConnectionValue: Connection;
  Token: CancellationToken
): result of ServerSession, string;
begin
  var Revealed: GameState := try RevealCurrentArea(Session.World.Metadata, Changed);
  mutable var Next: ServerSession := Session;
  Next.State := Some(Revealed);
  Next.World := try SendProjection(ConnectionValue, Session.World, Revealed, Session.Viewport, Report, Token);
  return Ok(Next)
end;

// Reveals the accepted state, makes it current, and sends its projection without combat messages.
function CommitState(
  Session: ServerSession;
  Changed: GameState;
  ConnectionValue: Connection;
  Token: CancellationToken
): result of ServerSession, string;
begin
  return CommitTurn(Session, Changed, NoTurnReport(), ConnectionValue, Token)
end;

// Joins one turn's messages into the bounded defeat summary.
function DefeatSummary(Log: array of string): string;
begin
  mutable var Summary: string := '';
  for Entry: string in Log do
  begin
    if Summary = '' then
    begin
      Summary := Entry
    end
    else
    begin
      Summary := (Summary + ' ') + Entry
    end
  end;

  if Summary = '' then
  begin
    Summary := 'You have fallen.'
  end;

  if Std.Str.Length(Summary) > MaximumCombatLogTextLength then
  begin
    Summary := Std.Str.Substring(Summary, Std.Str.Length(Summary) - MaximumCombatLogTextLength, MaximumCombatLogTextLength)
  end;

  return Summary
end;

// Resolves one time-consuming intention; defeat ends the game session but keeps the connection.
function PlayTurn(
  Session: ServerSession;
  Action: TurnAction;
  RejectionCode: string;
  ConnectionValue: Connection;
  Token: CancellationToken
): result of ServerSession, string;
begin
  case ResolveTurn(Session.World.Metadata, try RequireActiveState(Session.State), Action) of
    Ok(Outcome):
    begin
      case Outcome of
        TurnOutcome.Continued(Changed, Log, Events):
        begin
          return CommitTurn(Session, Changed, record
            Log := Log;
            Events := Events;
          end, ConnectionValue, Token)
        end;
        TurnOutcome.Defeated(Log):
        begin
          var Sent: boolean := try Send(ConnectionValue, ServerMessage.Defeated(DefeatSummary(Log)), Token);
          mutable var Ended: ServerSession := Session;
          Ended.State := None;
          Ended.ActiveDialogueNpcId := None;
          return Ok(Ended)
        end
      end
    end;
    Error(Reason):
    begin
      var Sent: boolean := try Reject(ConnectionValue, RejectionCode, Reason, Token);
      return Ok(Session)
    end
  end
end;

// Applies one decoded client message after the handshake; Finished requests connection close.
function HandleSessionMessage(
  Session: ServerSession;
  Message: ClientMessage;
  ConnectionValue: Connection;
  Config: ServerConfig;
  Token: CancellationToken
): result of ServerSession, string;
begin
  var HasState: boolean := Std.Options.IsSome(Session.State);
  var DialogueActive: boolean := Std.Options.IsSome(Session.ActiveDialogueNpcId);
  if not HasState and RequiresActiveSession(Message) then
  begin
    var Sent: boolean := try Reject(ConnectionValue, 'session_not_started', 'Start or load a game first.', Token);
    return Ok(Session)
  end;

  if DialogueActive and not AllowedWhileDialogueActive(Message) then
  begin
    var Sent: boolean := try Reject(ConnectionValue, 'dialogue_active', 'End the active dialogue before taking another action.', Token);
    return Ok(Session)
  end;

  if not DialogueActive and RequiresActiveDialogue(Message) then
  begin
    var Sent: boolean := try Reject(ConnectionValue, 'dialogue_not_active', 'No dialogue is active.', Token);
    return Ok(Session)
  end;
  mutable var Next: ServerSession := Session;
  case Message of
    ClientMessage.Disconnect:
    begin
      Next.Finished := true
    end;
    ClientMessage.Hello(Version, Width, Height):
    begin
      var Sent: boolean := try Send(ConnectionValue, ServerMessage.ErrorMessage('unexpected_hello', 'The session is already established'), Token);
      Next.Finished := true
    end;
    ClientMessage.StartNewGame:
    begin
      if HasState then
      begin
        var Sent: boolean := try Reject(ConnectionValue, 'session_already_started', 'A game session is already active.', Token)
      end
      else
      begin
        return CommitState(Session, NewGame(Session.World.Metadata), ConnectionValue, Token)
      end
    end;
    ClientMessage.LoadGame:
    begin
      if HasState then
      begin
        var Sent: boolean := try Reject(ConnectionValue, 'session_already_started', 'A game session is already active.', Token)
      end
      else
      begin
        case LoadSaveGame(Session.World) of
          Error(Reason):
          begin
            var Sent: boolean := try Reject(ConnectionValue, 'load_failed', Reason, Token)
          end;
          Ok(LoadedSave):
          begin
            case LoadedSave of
              SaveGameLoad.Missing:
              begin
                var Sent: boolean := try Reject(ConnectionValue, 'save_unavailable', 'No saved game is available for this world.', Token)
              end;
              SaveGameLoad.InvalidRemoved(Reason):
              begin
                var Sent: boolean := try Reject(ConnectionValue, 'save_removed', 'Invalid saved game was removed. Start a new game.', Token)
              end;
              SaveGameLoad.Loaded(SavedState):
              begin
                return CommitState(Session, SavedState, ConnectionValue, Token)
              end
            end
          end
        end
      end
    end;
    ClientMessage.SaveGame:
    begin
      case WriteSaveGame(Session.World, try RequireActiveState(Session.State)) of
        Ok(Written):
        begin
          var Sent: boolean := try Send(ConnectionValue, ServerMessage.SaveCompleted, Token)
        end;
        Error(Reason):
        begin
          var Sent: boolean := try Reject(ConnectionValue, 'save_failed', Reason, Token)
        end
      end
    end;
    ClientMessage.Viewport(Width, Height):
    begin
      case ResolveViewport(Width, Height, Config) of
        Ok(Value):
        begin
          Next.Viewport := Value;
          Next.World := try SendProjection(ConnectionValue, Session.World, try RequireActiveState(Session.State), Value, NoTurnReport(), Token)
        end;
        Error(Reason):
        begin
          var Sent: boolean := try Reject(ConnectionValue, 'invalid_viewport', Reason, Token)
        end
      end
    end;
    ClientMessage.ExplorationMap(OriginX, OriginY, Width, Height):
    begin
      if (Width > Config.MaximumViewWidth) or (Height > Config.MaximumViewHeight) then
      begin
        var Sent: boolean := try Reject(ConnectionValue, 'invalid_map_window', 'Exploration map dimensions exceed server limits.', Token)
      end
      else
      begin
        var MapValue: ExplorationMapState := try ProjectExplorationMap(try RequireActiveState(Session.State), Session.World.Metadata, OriginX, OriginY, Width, Height);
        var Sent: boolean := try Send(ConnectionValue, ServerMessage.ExplorationMap(MapValue), Token)
      end
    end;
    ClientMessage.Move(DeltaX, DeltaY):
    begin
      case MoveInWorld(Session.World, try RequireActiveState(Session.State), DeltaX, DeltaY) of
        Ok(Moved):
        begin
          Next.World := Moved.World;
          return CommitState(Next, Moved.State, ConnectionValue, Token)
        end;
        Error(Reason):
        begin
          var Sent: boolean := try Reject(ConnectionValue, 'movement_rejected', Reason, Token)
        end
      end
    end;
    ClientMessage.StepFirstPerson(Direction):
    begin
      return PlayTurn(Session, TurnAction.Step(GameStep(Direction)), 'movement_rejected', ConnectionValue, Token)
    end;
    ClientMessage.Attack:
    begin
      return PlayTurn(Session, TurnAction.Attack, 'attack_rejected', ConnectionValue, Token)
    end;
    ClientMessage.Wait:
    begin
      return PlayTurn(Session, TurnAction.Wait, 'wait_rejected', ConnectionValue, Token)
    end;
    ClientMessage.Equip(ItemId):
    begin
      return PlayTurn(Session, TurnAction.Equip(ItemId), 'equip_rejected', ConnectionValue, Token)
    end;
    ClientMessage.Unequip(ItemId):
    begin
      return PlayTurn(Session, TurnAction.Unequip(ItemId), 'equip_rejected', ConnectionValue, Token)
    end;
    ClientMessage.TurnFirstPerson(Direction):
    begin
      case Dungeon.Movement.TurnFirstPerson(Session.World.Metadata, try RequireActiveState(Session.State), GameTurn(Direction)) of
        Ok(Turned):
        begin
          return CommitState(Session, Turned, ConnectionValue, Token)
        end;
        Error(Reason):
        begin
          var Sent: boolean := try Reject(ConnectionValue, 'turn_rejected', Reason, Token)
        end
      end
    end;
    ClientMessage.Interact:
    begin
      case Dungeon.Interaction.Interact(Session.World.Metadata, try RequireActiveState(Session.State)) of
        Ok(Outcome):
        begin
          case Outcome of
            InteractionOutcome.Transitioned(Transitioned):
            begin
              return CommitState(Session, Transitioned, ConnectionValue, Token)
            end;
            InteractionOutcome.StateChanged(Changed):
            begin
              return CommitState(Session, Changed, ConnectionValue, Token)
            end;
            InteractionOutcome.Described(Title, Text):
            begin
              var Sent: boolean := try Send(ConnectionValue, ServerMessage.Interaction(Title, Text), Token)
            end;
            InteractionOutcome.DialogueStarted(Changed, Dialogue):
            begin
              Next.State := Some(Changed);
              Next.ActiveDialogueNpcId := Some(Dialogue.NpcId);
              var Sent: boolean := try Send(ConnectionValue, ServerMessage.Dialogue(ProjectDialogue(Dialogue)), Token)
            end
          end
        end;
        Error(Reason):
        begin
          var Sent: boolean := try Reject(ConnectionValue, 'interaction_rejected', Reason, Token)
        end
      end
    end;
    ClientMessage.DialogueChoice(ChoiceId):
    begin
      case Session.ActiveDialogueNpcId of
        Some(NpcId):
        begin
          case ResolveNpcDialogueChoice(Session.World.Metadata, try RequireActiveState(Session.State), NpcId, ChoiceId) of
            Ok(DialogueResult):
            begin
              case DialogueResult of
                DialogueOutcome.Continued(Changed, Dialogue):
                begin
                  Next.State := Some(Changed);
                  var Sent: boolean := try Send(ConnectionValue, ServerMessage.Dialogue(ProjectDialogue(Dialogue)), Token)
                end;
                DialogueOutcome.Ended(Changed):
                begin
                  Next.State := Some(Changed);
                  Next.ActiveDialogueNpcId := None;
                  var Sent: boolean := try Send(ConnectionValue, ServerMessage.DialogueEnded, Token)
                end
              end
            end;
            Error(Reason):
            begin
              var Sent: boolean := try Reject(ConnectionValue, 'dialogue_choice_rejected', Reason, Token)
            end
          end
        end;
        None:
        begin
          var Sent: boolean := try Reject(ConnectionValue, 'dialogue_not_active', 'No dialogue is active.', Token)
        end
      end
    end;
    ClientMessage.EndDialogue:
    begin
      Next.ActiveDialogueNpcId := None;
      var Sent: boolean := try Send(ConnectionValue, ServerMessage.DialogueEnded, Token)
    end
  end;

  return Ok(Next)
end;

// Serves one connected client against the selected world until the session ends.
public function ServeConnection(
  ConnectionValue: Connection;
  Config: ServerConfig;
  Token: CancellationToken
): result of boolean, string;
begin
  mutable var Reader: LineReader := NewLineReader(ConnectionValue);
  mutable var Viewport: ViewportSize := record
    Width := 1;
    Height := 1;
  end;

  case ReadLine(Reader, Token) of
    Error(ReadMessage):
    begin
      return FinishReadFailure(ConnectionValue, ReadMessage, Token)
    end;
    Ok(FirstRead):
    begin
      Reader := FirstRead.Reader;
      case DecodeClient(FirstRead.Line) of
        Ok(FirstMessage):
        begin
          case FirstMessage of
            ClientMessage.Hello(Version, Width, Height):
            begin
              if Version <> ProtocolVersion then
              begin
                var Sent: boolean := try Send(ConnectionValue, ServerMessage.ErrorMessage('unsupported_version', ('Protocol version ' + IntToStr(ProtocolVersion)) +
                                                                                                                 ' is required'), Token);
                return Ok(true)
              end;

              case ResolveViewport(Width, Height, Config) of
                Ok(Value):
                begin
                  Viewport := Value
                end;
                Error(Message):
                begin
                  var Sent: boolean := try Send(ConnectionValue, ServerMessage.ErrorMessage('invalid_viewport', Message), Token);
                  return Ok(true)
                end
              end
            end
            else
            begin
              var Sent: boolean := try Send(ConnectionValue, ServerMessage.ErrorMessage('expected_hello', 'The first message must be hello'), Token);
              return Ok(true)
            end
          end
        end;
        Error(Message):
        begin
          var Sent: boolean := try Send(ConnectionValue, ServerMessage.ErrorMessage('invalid_message', 'The client message is invalid'), Token);
          return Ok(true)
        end
      end
    end
  end;
  var World: WorldSession := try OpenWorld(Config.WorldsRoot, Config.WorldId, Config.WorldSeed, Config.ChunkCacheLimit);
  mutable var SaveAvailable: boolean := false;
  mutable var InvalidSaveRemoved: boolean := false;
  case try LoadSaveGame(World) of
    SaveGameLoad.Missing:
    begin
    end;
    SaveGameLoad.InvalidRemoved(Reason):
    begin
      InvalidSaveRemoved := true
    end;
    SaveGameLoad.Loaded(SavedState):
    begin
      SaveAvailable := true
    end
  end;
  mutable var Session: ServerSession := record
    World := World;
    State := None;
    ActiveDialogueNpcId := None;
    Viewport := Viewport;
    Finished := false;
  end;
  var WelcomeSent: boolean := try Send(ConnectionValue, ServerMessage.Welcome(ProtocolVersion, SaveAvailable, InvalidSaveRemoved), Token);
  while not IsCancellationRequested(Token) do
  begin
    case ReadLine(Reader, Token) of
      Error(ReadMessage):
      begin
        return FinishReadFailure(ConnectionValue, ReadMessage, Token)
      end;
      Ok(ReadValue):
      begin
        Reader := ReadValue.Reader;
        case DecodeClient(ReadValue.Line) of
          Error(DecodeMessage):
          begin
            var Sent: boolean := try Send(ConnectionValue, ServerMessage.ErrorMessage('invalid_message', 'The client message is invalid'), Token);
            return Ok(true)
          end;
          Ok(ClientMessageValue):
          begin
            Session := try HandleSessionMessage(Session, ClientMessageValue, ConnectionValue, Config, Token);
            if Session.Finished then
            begin
              return Ok(true)
            end
          end
        end
      end
    end
  end;

  return Ok(true)
end;

// Runs the signal-aware server with validated world and viewport configuration.
public function RunServer(Host: string; Port: integer; Config: ServerConfig): result of boolean, string;
begin
  if (Config.MaximumViewWidth < 1) or (Config.MaximumViewHeight < 1) then
  begin
    return Error('server maximum viewport dimensions must be positive')
  end;

  if Config.ChunkCacheLimit < RequiredCacheCapacity(Config) then
  begin
    return Error('server chunk cache is too small for the configured maximum viewport and prefetch margin')
  end;
  var ValidatedWorld: WorldSession := try OpenWorld(Config.WorldsRoot, Config.WorldId, Config.WorldSeed, Config.ChunkCacheLimit);
  var ListenerValue: Listener := try Listen(Host, Port);
  var Life: ServerLifetime := try CreateLifetime(2000, false);
  var Owned: boolean := try OwnListener(Life, ListenerValue);
  var Observing: boolean := try ObserveSignals(Life);
  var Workers: TaskGroup := GetWorkGroup(Life);
  StartTaskInGroup(Workers, function(Token: CancellationToken): result of boolean, string begin
    while not IsCancellationRequested(Token) do
    begin
      case AcceptWithCancellation(ListenerValue, Token) of
        Ok(Client):
        begin
          var Outcome: result of boolean, string := ServeConnection(Client, Config, Token);
          var Closed: boolean := try Close(Client);
          case Outcome of
            Error(Message):
            begin
              WriteLn('Client failed: ' + Message)
            end
            else
            begin
            end
          end
        end;
        Error(Message):
        begin
          if IsCancellationRequested(Token) then
          begin
            return Ok(true)
          end;

          return Error(Message)
        end
      end
    end;

    return Ok(true)
  end);
  WriteLn((((('Dungeon server for world ' + Config.WorldId) + ' listening on ') + Host) + ':') +
          Std.Conv.IntToStr(Port));
  while IsReady(Life) do
  begin
    Sleep(20)
  end;

  RequestStop(Life);
  var Failures: array of TaskFailure := try CloseTaskGroupWithTimeout(Workers, RemainingMillis(Life));
  for Failure: TaskFailure in Failures do
  begin
    WriteLn(Failure.Message)
  end;
  var Finished: boolean := try FinishShutdown(Life);
  if Std.Arrays.Length(Failures) <> 0 then
  begin
    return Error('server worker failed')
  end;

  return Ok(true)
end;
