// Authoritative world-backed server for versioned client sessions: handshake, message loop, and listener.
unit Dungeon.Server;

uses
  Dungeon.Server.Config, Dungeon.Server.Worlds, Dungeon.Server.Logging, Dungeon.Server.Failures,
  Dungeon.Server.Handling, Dungeon.Server.Replies, Dungeon.Server.Session, Dungeon.Protocol,
  Dungeon.Protocol.ClientMessages, Dungeon.Protocol.Transport, Dungeon.World, Dungeon.World.Savegame,
  Std.Arrays, Std.Console, Std.Conv, Std.Fs, Std.Net, Std.Server, Std.Tasks, Std.Time;

function FinishReadFailure(
  ConnectionValue: Connection;
  Message: string;
  Config: ServerConfig;
  Token: CancellationToken
): result of boolean, string;
begin
  if Message = LineTooLongError then
    begin
      LogServer(Config.Logs, 'rejected', Message);
      var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('line_too_long', Message), Token);
    end;
  end if;

  return Ok(true);
end function;

// Serves one connected client against the selected world until the session ends.
public function ServeConnection(
  ConnectionValue: Connection;
  Config: ServerConfig;
  Token: CancellationToken
): result of boolean, string;
begin
  mutable var Reader: LineReader := NewLineReader(ConnectionValue);
  mutable var Viewport: ViewportSize := record
    Width := 1;
    Height := 1;
  end;

  case ReadLine(Reader, Token) of
    when Error(ReadMessage):
      begin
        return FinishReadFailure(ConnectionValue, ReadMessage, Config, Token);
      end;
    when Ok(FirstRead):
      begin
        Reader := FirstRead.Reader;
        case DecodeClient(FirstRead.Line) of
          when Ok(FirstMessage):
            begin
              case FirstMessage of
                when ClientMessage.Hello(Version, Width, Height):
                  begin
                    if Version <> ProtocolVersion then
                      begin
                        LogServer(Config.Logs, 'rejected', 'Unsupported client protocol version');
                        var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('unsupported_version', ('Protocol version ' + IntToStr(ProtocolVersion)) +
                                                                                                                                ' is required'), Token);
                        return Ok(true);
                      end;
                    end if;

                    case ResolveViewport(Width, Height, Config) of
                      when Ok(Value):
                        begin
                          Viewport := Value;
                        end;
                      when Error(Message):
                        begin
                          LogServer(Config.Logs, 'rejected', 'Invalid viewport');
                          var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('invalid_viewport', Message), Token);
                          return Ok(true);
                        end;
                    end case;
                  end;
                else
                  begin
                    LogServer(Config.Logs, 'rejected', 'Expected hello');
                    var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('expected_hello', 'The first message must be hello'), Token);
                    return Ok(true);
                  end;
              end case;
            end;
          when Error(Message):
            begin
              LogServer(Config.Logs, 'rejected', 'Invalid client message');
              var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('invalid_message', 'The client message is invalid'), Token);
              return Ok(true);
            end;
        end case;
      end;
  end case;
  mutable var Session: ServerSession := try NewServerSession(Config, Viewport);
  case CatalogFor(Config, Config.WorldId, -1) of
    when Error(Reason):
      begin
        LogServer(Config.Logs, 'error', Reason);
        var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.Rejected('storage_error', 'Cannot list worlds. Check storage and server settings.'), Token);
        return Ok(true);
      end;
    when Ok(Catalog):
      begin
        var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.Welcome(ProtocolVersion, Catalog), Token);
      end;
  end case;

  while not IsCancellationRequested(Token) do
    begin
      case ReadLine(Reader, Token) of
        when Error(ReadMessage):
          begin
            return FinishReadFailure(ConnectionValue, ReadMessage, Config, Token);
          end;
        when Ok(ReadValue):
          begin
            Reader := ReadValue.Reader;
            case DecodeClient(ReadValue.Line) of
              when Error(DecodeMessage):
                begin
                  LogServer(Config.Logs, 'rejected', 'Invalid client message');
                  var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('invalid_message', 'The client message is invalid'), Token);
                  return Ok(true);
                end;
              when Ok(ClientMessageValue):
                begin
                  Session := try HandleSessionMessage(Session, ClientMessageValue, ConnectionValue, Config, Token);
                  if Session.Finished then
                    begin
                      return Ok(true);
                    end;
                  end if;
                end;
            end case;
          end;
      end case;
    end;
  end while;

  return Ok(true);
end function;

// Owns admission and workers; only a standalone headless server takes process signals.
function RunListener(
  Host: string;
  Port: integer;
  Config: ServerConfig;
  StopToken: CancellationToken;
  ProcessSignals: boolean
): result of boolean, string;
begin
  if (Config.MaximumViewWidth < 1) or (Config.MaximumViewHeight < 1) then
    begin
      return Error('server maximum viewport dimensions must be positive');
    end;
  end if;

  if Config.ChunkCacheLimit < RequiredCacheCapacity(Config) then
    begin
      return Error('server chunk cache is too small for the configured maximum viewport and prefetch margin');
    end;
  end if;
  var Defaults: WorldCatalog := try CreationDefaults(Config);
  var RootReady: boolean := try Std.Fs.CreateDirAll(Config.WorldsRoot);
  var ListenerValue: Listener := try Listen(Host, Port);
  var Life: ServerLifetime := try CreateLifetime(2000, false);
  var Owned: boolean := try OwnListener(Life, ListenerValue);
  if ProcessSignals then
    var Observing: boolean := try ObserveSignals(Life);
  end if;
  var Workers: TaskGroup := GetWorkGroup(Life);
  var Admission: channel of boolean := CreateChannel(1);
  discard Send(Admission, true);
  var AcceptTask: task of result of boolean, string := StartTaskInGroup(Workers, function(Token: CancellationToken): result of boolean, string begin
    while not IsCancellationRequested(Token) do
      begin
        case AcceptWithCancellation(ListenerValue, Token) of
          when Ok(Client):
            begin
              case try TryReceive(Admission) of
                when None:
                  begin
                    LogServer(Config.Logs, 'rejected', 'Another player is connected.');
                    discard SendMessage(Client, ServerMessage.Rejected('server_busy', 'Another player is connected.'), Token);
                    discard Close(Client);
                  end;
                when Some(Permit):
                  begin
                    var SessionTask: task of result of boolean, string := StartTaskInGroup(Workers, function(SessionToken: CancellationToken): result of boolean, string begin
                      LogServer(Config.Logs, 'connected', 'Player connected');
                      var Outcome: result of boolean, string := ServeConnection(Client, Config, SessionToken);
                      var Closed: result of boolean, string := Close(Client);
                      discard TrySend(Admission, true);
                      LogServer(Config.Logs, 'disconnected', 'Player disconnected');
                      case Outcome of
                        when Error(Message):
                          begin
                            LogServer(Config.Logs, 'error', 'Client failed: ' + Message);
                          end;
                        else
                          begin
                            null;
                          end;
                      end case;

                      return Closed;
                    end function);
                  end;
              end case;
            end;
          when Error(Message):
            begin
              if IsCancellationRequested(Token) then
                begin
                  return Ok(true);
                end;
              end if;

              LogServer(Config.Logs, 'error', 'Listener failed: ' + Message);
              discard RequestStop(Life);
              return Error(Message);
            end;
        end case;
      end;
    end while;

    return Ok(true);
  end function);
  LogServer(Config.Logs, 'status', 'Listening on port ' + Std.Conv.IntToStr(Port));
  while IsReady(Life) and not IsCancellationRequested(StopToken) do
    begin
      Sleep(20);
    end;
  end while;

  discard RequestStop(Life);
  var Failures: array of TaskFailure := try CloseTaskGroupWithTimeout(Workers, RemainingMillis(Life));
  for Failure: TaskFailure in Failures do
    begin
      LogServer(Config.Logs, 'error', Failure.Message);
    end;
  end for;
  var Finished: boolean := try FinishShutdown(Life);
  if Std.Arrays.Length(Failures) <> 0 then
    begin
      return Error('server worker failed');
    end;
  end if;

  return Ok(true);
end function;

// Runs an embedded listener under caller-owned cancellation without taking process signals.
public function RunServerWithCancellation(
  Host: string;
  Port: integer;
  Config: ServerConfig;
  StopToken: CancellationToken
): result of boolean, string;
begin
  return RunListener(Host, Port, Config, StopToken, false);
end function;

// Runs the headless signal-aware listener; console mode supplies its own cancellation token.
public function RunServer(Host: string; Port: integer; Config: ServerConfig): result of boolean, string;
begin
  var Stop: CancellationSource := CreateCancellationSource();
  return RunListener(Host, Port, Config, GetCancellationToken(Stop), true);
end function;
end unit;
