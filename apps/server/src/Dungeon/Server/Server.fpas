// Authoritative world-backed server for versioned client sessions: handshake, message loop, and listener.
unit Dungeon.Server;

uses
  Dungeon.Server.Config, Dungeon.Server.Worlds, Dungeon.Server.Logging, Dungeon.Server.Failures,
  Dungeon.Server.Handling, Dungeon.Server.Replies, Dungeon.Server.Session, Dungeon.Protocol,
  Dungeon.Protocol.ClientMessages, Dungeon.Protocol.Transport, Dungeon.World, Dungeon.World.Savegame,
  Std.Console, Std.Conv, Std.Fs, Std.Net, Std.Server, Std.Tasks, Std.Time;

function FinishReadFailure(
  ConnectionValue: Connection;
  Message: string;
  Config: ServerConfig;
  Token: CancellationToken
): result of (boolean, string);
begin
  if Message = LineTooLongError then
    begin
      LogServer(Config.Logs, 'rejected', Message);
      const Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('line_too_long', Message), Token);
    end;
  end if;

  return Ok(true);
end function;

// Serves one connected client against the selected world until the session ends.
public function ServeConnection(
  ConnectionValue: Connection;
  Config: ServerConfig;
  Token: CancellationToken
): result of (boolean, string);
begin
  var Reader: LineReader := NewLineReader(ConnectionValue);
  var Viewport: ViewportSize := ViewportSize(Width := 1, Height := 1);
  case ReadLine(Reader, Token) of
    when Error(const ReadMessage):
      begin
        return FinishReadFailure(ConnectionValue, ReadMessage, Config, Token);
      end;
    when Ok(const FirstRead):
      begin
        Reader := FirstRead.Reader;
        case DecodeClient(FirstRead.Line) of
          when Ok(const FirstMessage):
            begin
              if FirstMessage is ClientMessage.Hello(const Version, const Width, const Height) then
                begin
                  if Version <> ProtocolVersion then
                    begin
                      LogServer(Config.Logs, 'rejected', 'Unsupported client protocol version');
                      const Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('unsupported_version', ('Protocol version ' + IntToStr(ProtocolVersion)) +
                                                                                                                                ' is required'), Token);
                      return Ok(true);
                    end;
                  end if;

                  case ResolveViewport(Width, Height, Config) of
                    when Ok(const Value):
                      begin
                        Viewport := Value;
                      end;
                    when Error(const Message):
                      begin
                        LogServer(Config.Logs, 'rejected', 'Invalid viewport');
                        const Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('invalid_viewport', Message), Token);
                        return Ok(true);
                      end;
                  end case;
                end;
              else
                begin
                  LogServer(Config.Logs, 'rejected', 'Expected hello');
                  const Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('expected_hello', 'The first message must be hello'), Token);
                  return Ok(true);
                end;
              end if;
            end;
          when Error(const Message):
            begin
              LogServer(Config.Logs, 'rejected', 'Invalid client message');
              const Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('invalid_message', 'The client message is invalid'), Token);
              return Ok(true);
            end;
        end case;
      end;
  end case;
  var Session: ServerSession := try NewServerSession(Config, Viewport);
  case CatalogFor(Config, Config.WorldId, -1) of
    when Error(const Reason):
      begin
        LogServer(Config.Logs, 'error', Reason);
        const Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.Rejected('storage_error', 'Cannot list worlds. Check storage and server settings.'), Token);
        return Ok(true);
      end;
    when Ok(const Catalog):
      begin
        const Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.Welcome(ProtocolVersion, Catalog), Token);
      end;
  end case;

  while not IsCancellationRequested(Token) do
    begin
      case ReadLine(Reader, Token) of
        when Error(const ReadMessage):
          begin
            return FinishReadFailure(ConnectionValue, ReadMessage, Config, Token);
          end;
        when Ok(const ReadValue):
          begin
            Reader := ReadValue.Reader;
            case DecodeClient(ReadValue.Line) of
              when Error(const DecodeMessage):
                begin
                  LogServer(Config.Logs, 'rejected', 'Invalid client message');
                  const Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('invalid_message', 'The client message is invalid'), Token);
                  return Ok(true);
                end;
              when Ok(const ClientMessageValue):
                begin
                  Session := try HandleSessionMessage(Session, ClientMessageValue, ConnectionValue, Config, Token);
                  if Session.Finished then
                    begin
                      return Ok(true);
                    end;
                  end if;
                end;
            end case;
          end;
      end case;
    end;
  end while;

  return Ok(true);
end function;

// Owns admission and workers; only a standalone headless server takes process signals.
function RunListener(
  Host: string;
  Port: integer;
  Config: ServerConfig;
  StopToken: CancellationToken;
  ProcessSignals: boolean
): result of (boolean, string);
begin
  if (Config.MaximumViewWidth < 1) or (Config.MaximumViewHeight < 1) then
    begin
      return Error('server maximum viewport dimensions must be positive');
    end;
  end if;

  if Config.ChunkCacheLimit < RequiredCacheCapacity(Config) then
    begin
      return Error('server chunk cache is too small for the configured maximum viewport and prefetch margin');
    end;
  end if;
  const Defaults: WorldCatalog := try CreationDefaults(Config);
  const RootReady: boolean := try Std.Fs.CreateDirAll(Config.WorldsRoot);
  const ListenerValue: Listener := try Listen(Host, Port);
  const Life: ServerLifetime := try CreateLifetime(2000, false);
  const Owned: boolean := try OwnListener(Life, ListenerValue);
  if ProcessSignals then
    const Observing: boolean := try ObserveSignals(Life);
  end if;
  const Workers: TaskGroup := GetWorkGroup(Life);
  const Admission: channel of boolean := CreateChannel(1);
  discard Send(Admission, true);
  const AcceptTask: task of result of (boolean, string) := StartTaskInGroup(Workers, function(Token: CancellationToken): result of (boolean, string) begin
    while not IsCancellationRequested(Token) do
      begin
        case AcceptWithCancellation(ListenerValue, Token) of
          when Ok(const Client):
            begin
              case try TryReceive(Admission) of
                when None:
                  begin
                    LogServer(Config.Logs, 'rejected', 'Another player is connected.');
                    discard SendMessage(Client, ServerMessage.Rejected('server_busy', 'Another player is connected.'), Token);
                    discard Close(Client);
                  end;
                when Some(const Permit):
                  begin
                    const SessionTask: task of result of (boolean, string) := StartTaskInGroup(Workers, function(SessionToken: CancellationToken): result of (boolean, string) begin
                      LogServer(Config.Logs, 'connected', 'Player connected');
                      const Outcome: result of (boolean, string) := ServeConnection(Client, Config, SessionToken);
                      const Closed: result of (boolean, string) := Close(Client);
                      discard TrySend(Admission, true);
                      LogServer(Config.Logs, 'disconnected', 'Player disconnected');
                      if Outcome is Error(const Message) then
                        begin
                          LogServer(Config.Logs, 'error', 'Client failed: ' + Message);
                        end;
                      else
                        begin
                          null;
                        end;
                      end if;

                      return Closed;
                    end function);
                  end;
              end case;
            end;
          when Error(const Message):
            begin
              if IsCancellationRequested(Token) then
                begin
                  return Ok(true);
                end;
              end if;

              LogServer(Config.Logs, 'error', 'Listener failed: ' + Message);
              discard RequestStop(Life);
              return Error(Message);
            end;
        end case;
      end;
    end while;

    return Ok(true);
  end function);
  LogServer(Config.Logs, 'status', 'Listening on port ' + Std.Conv.IntToStr(Port));
  while IsReady(Life) and not IsCancellationRequested(StopToken) do
    begin
      Sleep(20);
    end;
  end while;

  discard RequestStop(Life);
  const Failures: array of TaskFailure := try CloseTaskGroupWithTimeout(Workers, RemainingMillis(Life));
  for Failure: TaskFailure in Failures do
    begin
      LogServer(Config.Logs, 'error', Failure.Message);
    end;
  end for;
  const Finished: boolean := try FinishShutdown(Life);
  if Failures.Length() <> 0 then
    begin
      return Error('server worker failed');
    end;
  end if;

  return Ok(true);
end function;

// Runs an embedded listener under caller-owned cancellation without taking process signals.
public function RunServerWithCancellation(
  Host: string;
  Port: integer;
  Config: ServerConfig;
  StopToken: CancellationToken
): result of (boolean, string);
begin
  return RunListener(Host, Port, Config, StopToken, false);
end function;

// Runs the headless signal-aware listener; console mode supplies its own cancellation token.
public function RunServer(Host: string; Port: integer; Config: ServerConfig): result of (boolean, string);
begin
  const Stop: CancellationSource := CreateCancellationSource();
  return RunListener(Host, Port, Config, GetCancellationToken(Stop), true);
end function;
end unit;
