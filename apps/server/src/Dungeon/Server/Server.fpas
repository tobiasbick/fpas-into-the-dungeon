// Authoritative world-backed server for versioned client sessions.
unit Dungeon.Server;

uses
  Dungeon.Exploration, Dungeon.Exploration.Model, Dungeon.Game, Dungeon.Protocol,
  Dungeon.Protocol.Transport, Dungeon.World, Dungeon.World.Savegame, Std.Arrays, Std.Console,
  Std.Conv, Std.Net, Std.Options, Std.Results, Std.Server, Std.Str, Std.Task, Std.Time;

public type
  // Immutable server policy and selected persistent world used by each session.
  ServerConfig = record
    public WorldsRoot: string;
    public WorldId: string;
    public WorldSeed: integer;
    public ChunkCacheLimit: integer;
    public MaximumViewWidth: integer;
    public MaximumViewHeight: integer;
  end;

type
  ViewportSize = record
    Width: integer;
    Height: integer;
  end;
  SessionProjection = record
    World: WorldSession;
    State: VisibleState;
  end;
  MaskedRows = record
    Rows: array of string;
    KnowledgeRows: array of string;
  end;

function Send(ConnectionValue: Connection; Message: ServerMessage; Token: CancellationToken): result of boolean, string;
begin
  return WriteLine(ConnectionValue, EncodeServer(Message), Token)
end;

function ResolveViewport(Width: integer; Height: integer; Config: ServerConfig): result of ViewportSize, string;
begin
  if (Width < 1) or (Height < 1) then
  begin
    return Error('viewport dimensions must be positive')
  end;
  mutable var BoundedWidth: integer := Width;
  mutable var BoundedHeight: integer := Height;
  if BoundedWidth > Config.MaximumViewWidth then
  begin
    BoundedWidth := Config.MaximumViewWidth
  end;

  if BoundedHeight > Config.MaximumViewHeight then
  begin
    BoundedHeight := Config.MaximumViewHeight
  end;

  return Ok(record
    Width := BoundedWidth;
    Height := BoundedHeight;
  end)
end;

function MaximumIntersectingChunks(Length: integer): integer;
begin
  if Length = 1 then
  begin
    return 1
  end;

  return ((Length - 2) div WorldChunkSize) + 2
end;

function RequiredCacheCapacity(Config: ServerConfig): integer;
begin
  return (MaximumIntersectingChunks(Config.MaximumViewWidth) + 2) *
         (MaximumIntersectingChunks(Config.MaximumViewHeight) + 2)
end;

function RequiresActiveSession(Message: ClientMessage): boolean;
begin
  case Message of
    ClientMessage.Viewport(Width, Height):
    begin
      return true
    end;
    ClientMessage.ExplorationMap(OriginX, OriginY, Width, Height):
    begin
      return true
    end;
    ClientMessage.Move(DeltaX, DeltaY):
    begin
      return true
    end;
    ClientMessage.StepFirstPerson(Direction):
    begin
      return true
    end;
    ClientMessage.TurnFirstPerson(Direction):
    begin
      return true
    end;
    ClientMessage.Interact:
    begin
      return true
    end;
    ClientMessage.SaveGame:
    begin
      return true
    end
    else
    begin
      return false
    end
  end
end;

function RequireActiveState(State: option of GameState): result of GameState, string;
begin
  case State of
    Some(Value):
    begin
      return Ok(Value)
    end;
    None:
    begin
      return Error('server session has no active game state')
    end
  end
end;

function ProtocolFacing(Value: FacingDirection): FirstPersonFacing;
begin
  case Value of
    FacingDirection.North:
    begin
      return FirstPersonFacing.North
    end;
    FacingDirection.East:
    begin
      return FirstPersonFacing.East
    end;
    FacingDirection.South:
    begin
      return FirstPersonFacing.South
    end;
    FacingDirection.West:
    begin
      return FirstPersonFacing.West
    end
  end
end;

function GameStep(Value: FirstPersonStepDirection): RelativeStep;
begin
  case Value of
    FirstPersonStepDirection.Forward:
    begin
      return RelativeStep.Forward
    end;
    FirstPersonStepDirection.Backward:
    begin
      return RelativeStep.Backward
    end;
    FirstPersonStepDirection.Left:
    begin
      return RelativeStep.Left
    end;
    FirstPersonStepDirection.Right:
    begin
      return RelativeStep.Right
    end
  end
end;

function GameTurn(Value: FirstPersonTurnDirection): RelativeTurn;
begin
  case Value of
    FirstPersonTurnDirection.Left:
    begin
      return RelativeTurn.TurnLeft
    end;
    FirstPersonTurnDirection.Right:
    begin
      return RelativeTurn.TurnRight
    end
  end
end;

function InteriorRows(Map: InteriorMap): result of array of string, string;
begin
  mutable var Rows: array of string := [];
  for Y: integer := 0 to Map.Height - 1 do
  begin
    mutable var Row: string := '';
    for X: integer := 0 to Map.Width - 1 do
    begin
      Row := Row + (try InteriorVisibleCode(Map, record
        X := X;
        Y := Y;
      end))
    end;

    Std.Arrays.Push(Rows, Row)
  end;

  return Ok(Rows)
end;

function KnowledgeCode(Value: FieldKnowledge): string;
begin
  case Value of
    FieldKnowledge.Undiscovered:
    begin
      return 'u'
    end;
    FieldKnowledge.Remembered:
    begin
      return 'r'
    end;
    FieldKnowledge.Visible:
    begin
      return 'v'
    end
  end
end;

function MaskOutdoorRows(
  State: GameState;
  TerrainRows: array of string;
  OriginX: integer;
  OriginY: integer;
  Width: integer;
  Height: integer;
  Player: WorldPosition
): MaskedRows;
begin
  var VisibleFields: array of boolean := OutdoorVisibility(OriginX, OriginY, Width, Height, Player);
  mutable var Rows: array of string := [];
  mutable var KnowledgeRows: array of string := [];
  for Y: integer := 0 to Height - 1 do
  begin
    mutable var Row: string := '';
    mutable var KnowledgeRow: string := '';
    for X: integer := 0 to Width - 1 do
    begin
      var WorldX: integer := OriginX + X;
      var WorldY: integer := OriginY + Y;
      var Knowledge: FieldKnowledge := ClassifyField(OutdoorIsDiscovered(State.Exploration, WorldX, WorldY), VisibleFields[(Y * Width) +
                                                                                                                           X]);
      if Knowledge = FieldKnowledge.Undiscovered then
      begin
        Row := Row + '?'
      end
      else
      begin
        Row := Row + Std.Str.CharAt(TerrainRows[Y], X)
      end;

      KnowledgeRow := KnowledgeRow + KnowledgeCode(Knowledge)
    end;

    Std.Arrays.Push(Rows, Row);
    Std.Arrays.Push(KnowledgeRows, KnowledgeRow)
  end;

  return record
    Rows := Rows;
    KnowledgeRows := KnowledgeRows;
  end
end;

function MaskInteriorRows(State: GameState; Map: InteriorMap; Pose: FirstPersonPose): result of MaskedRows, string;
begin
  var TerrainRows: array of string := try InteriorRows(Map);
  var VisibleFields: array of boolean := InteriorVisibility(Map, Pose);
  mutable var Rows: array of string := [];
  mutable var KnowledgeRows: array of string := [];
  for Y: integer := 0 to Map.Height - 1 do
  begin
    mutable var Row: string := '';
    mutable var KnowledgeRow: string := '';
    for X: integer := 0 to Map.Width - 1 do
    begin
      var Knowledge: FieldKnowledge := ClassifyField(InteriorIsDiscovered(State.Exploration, State.AreaId, Map.Width, X, Y), VisibleFields[(Y * Map.Width) +
                                                                                                                                           X]);
      if Knowledge = FieldKnowledge.Undiscovered then
      begin
        Row := Row + '?'
      end
      else
      begin
        Row := Row + Std.Str.CharAt(TerrainRows[Y], X)
      end;

      KnowledgeRow := KnowledgeRow + KnowledgeCode(Knowledge)
    end;

    Std.Arrays.Push(Rows, Row);
    Std.Arrays.Push(KnowledgeRows, KnowledgeRow)
  end;

  return Ok(record
    Rows := Rows;
    KnowledgeRows := KnowledgeRows;
  end)
end;

function PlayerInWindow(
  PlayerX: integer;
  PlayerY: integer;
  OriginX: integer;
  OriginY: integer;
  Width: integer;
  Height: integer
): boolean;
begin
  return (((PlayerX >= OriginX) and (PlayerX < OriginX + Width)) and (PlayerY >= OriginY)) and
         (PlayerY < OriginY + Height)
end;

function ProjectExplorationMap(
  State: GameState;
  Metadata: WorldMetadata;
  OriginX: integer;
  OriginY: integer;
  Width: integer;
  Height: integer
): result of ExplorationMapState, string;
begin
  mutable var Rows: array of string := [];
  mutable var KnowledgeRows: array of string := [];
  if State.Area = AreaKind.OutdoorRegion then
  begin
    var Player: WorldPosition := try OutdoorPlayerPosition(State);
    var VisibleFields: array of boolean := OutdoorVisibility(OriginX, OriginY, Width, Height, Player);
    for Y: integer := 0 to Height - 1 do
    begin
      mutable var Row: string := '';
      mutable var KnowledgeRow: string := '';
      for X: integer := 0 to Width - 1 do
      begin
        var WorldX: integer := OriginX + X;
        var WorldY: integer := OriginY + Y;
        var Knowledge: FieldKnowledge := ClassifyField(OutdoorIsDiscovered(State.Exploration, WorldX, WorldY), VisibleFields[(Y * Width) +
                                                                                                                             X]);
        if Knowledge = FieldKnowledge.Undiscovered then
        begin
          Row := Row + '?'
        end
        else
        begin
          Row := Row + VisibleCellCode(GenerateWorldCell(Metadata, WorldX, WorldY))
        end;

        KnowledgeRow := KnowledgeRow + KnowledgeCode(Knowledge)
      end;

      Std.Arrays.Push(Rows, Row);
      Std.Arrays.Push(KnowledgeRows, KnowledgeRow)
    end;

    return Ok(record
      View := ViewKind.Map;
      LabelText := Metadata.OutdoorAreaLabel;
      OriginX := OriginX;
      OriginY := OriginY;
      Width := Width;
      Height := Height;
      Rows := Rows;
      KnowledgeRows := KnowledgeRows;
      PlayerWorldX := Player.X;
      PlayerWorldY := Player.Y;
      PlayerInWindow := PlayerInWindow(Player.X, Player.Y, OriginX, OriginY, Width, Height);
    end)
  end;
  var Map: InteriorMap := try InitialDungeonMap();
  var Pose: FirstPersonPose := try FirstPersonPlayerPose(State);
  var VisibleFields: array of boolean := InteriorVisibility(Map, Pose);
  for LocalY: integer := 0 to Height - 1 do
  begin
    mutable var Row: string := '';
    mutable var KnowledgeRow: string := '';
    for LocalX: integer := 0 to Width - 1 do
    begin
      var X: integer := OriginX + LocalX;
      var Y: integer := OriginY + LocalY;
      mutable var Knowledge: FieldKnowledge := FieldKnowledge.Undiscovered;
      if (((X >= 0) and (X < Map.Width)) and (Y >= 0)) and (Y < Map.Height) then
      begin
        Knowledge := ClassifyField(InteriorIsDiscovered(State.Exploration, State.AreaId, Map.Width, X, Y), VisibleFields[(Y * Map.Width) +
                                                                                                                         X])
      end;

      if Knowledge = FieldKnowledge.Undiscovered then
      begin
        Row := Row + '?'
      end
      else
      begin
        Row := Row + (try InteriorVisibleCode(Map, record
          X := X;
          Y := Y;
        end))
      end;

      KnowledgeRow := KnowledgeRow + KnowledgeCode(Knowledge)
    end;

    Std.Arrays.Push(Rows, Row);
    Std.Arrays.Push(KnowledgeRows, KnowledgeRow)
  end;

  return Ok(record
    View := ViewKind.FirstPerson;
    LabelText := Metadata.DungeonAreaLabel;
    OriginX := OriginX;
    OriginY := OriginY;
    Width := Width;
    Height := Height;
    Rows := Rows;
    KnowledgeRows := KnowledgeRows;
    PlayerWorldX := Pose.Position.X;
    PlayerWorldY := Pose.Position.Y;
    PlayerInWindow := PlayerInWindow(Pose.Position.X, Pose.Position.Y, OriginX, OriginY, Width, Height);
  end)
end;

function ProjectSession(World: WorldSession; State: GameState; Viewport: ViewportSize): result of SessionProjection, string;
begin
  if State.Area = AreaKind.Dungeon then
  begin
    var Map: InteriorMap := try InitialDungeonMap();
    var Pose: FirstPersonPose := try FirstPersonPlayerPose(State);
    mutable var Status: string := 'Find the gold exit field.';
    if (Pose.Position.X = Map.Exit.X) and (Pose.Position.Y = Map.Exit.Y) then
    begin
      Status := 'Press Enter to return to the outdoor region.'
    end;
    var Masked: MaskedRows := try MaskInteriorRows(State, Map, Pose);
    var FirstPersonValue: FirstPersonVisibleState := record
      Title := World.Metadata.DungeonAreaLabel;
      Status := Status;
      Width := Map.Width;
      Height := Map.Height;
      Rows := Masked.Rows;
      KnowledgeRows := Masked.KnowledgeRows;
      PlayerX := Pose.Position.X;
      PlayerY := Pose.Position.Y;
      Facing := ProtocolFacing(Pose.Facing);
    end;

    return Ok(record
      World := World;
      State := VisibleState.FirstPersonState(FirstPersonValue);
    end)
  end;
  var Loaded: WindowLoad := try LoadVisibleWindow(World, State, Viewport.Width, Viewport.Height);
  var OutdoorPosition: WorldPosition := try OutdoorPlayerPosition(State);
  var Masked: MaskedRows := MaskOutdoorRows(State, Loaded.Window.Rows, Loaded.Window.OriginX, Loaded.Window.OriginY, Loaded.Window.Width, Loaded.Window.Height, OutdoorPosition);
  var MapValue: MapVisibleState := record
    OriginX := Loaded.Window.OriginX;
    OriginY := Loaded.Window.OriginY;
    Width := Loaded.Window.Width;
    Height := Loaded.Window.Height;
    Rows := Masked.Rows;
    KnowledgeRows := Masked.KnowledgeRows;
    PlayerX := Loaded.Window.PlayerX;
    PlayerY := Loaded.Window.PlayerY;
    WorldX := OutdoorPosition.X;
    WorldY := OutdoorPosition.Y;
  end;

  return Ok(record
    World := Loaded.World;
    State := VisibleState.MapState(MapValue);
  end)
end;

function FinishReadFailure(ConnectionValue: Connection; Message: string; Token: CancellationToken): result of boolean, string;
begin
  if Message = 'protocol line exceeds 64 KiB' then
  begin
    var Sent: boolean := try Send(ConnectionValue, ServerMessage.ErrorMessage('line_too_long', Message), Token)
  end;

  return Ok(true)
end;

function SendProjection(
  ConnectionValue: Connection;
  World: WorldSession;
  State: GameState;
  Viewport: ViewportSize;
  Token: CancellationToken
): result of WorldSession, string;
begin
  var Projection: SessionProjection := try ProjectSession(World, State, Viewport);
  var Sent: boolean := try Send(ConnectionValue, ServerMessage.State(Projection.State), Token);
  return Ok(Projection.World)
end;

// Serves one connected client against the selected world until the session ends.
public function ServeConnection(
  ConnectionValue: Connection;
  Config: ServerConfig;
  Token: CancellationToken
): result of boolean, string;
begin
  mutable var Reader: LineReader := NewLineReader(ConnectionValue);
  mutable var Viewport: ViewportSize := record
    Width := 1;
    Height := 1;
  end;

  case ReadLine(Reader, Token) of
    Error(ReadMessage):
    begin
      return FinishReadFailure(ConnectionValue, ReadMessage, Token)
    end;
    Ok(FirstRead):
    begin
      Reader := FirstRead.Reader;
      case DecodeClient(FirstRead.Line) of
        Ok(FirstMessage):
        begin
          case FirstMessage of
            ClientMessage.Hello(Version, Width, Height):
            begin
              if Version <> ProtocolVersion then
              begin
                var Sent: boolean := try Send(ConnectionValue, ServerMessage.ErrorMessage('unsupported_version', ('Protocol version ' + IntToStr(ProtocolVersion)) +
                                                                                                                 ' is required'), Token);
                return Ok(true)
              end;

              case ResolveViewport(Width, Height, Config) of
                Ok(Value):
                begin
                  Viewport := Value
                end;
                Error(Message):
                begin
                  var Sent: boolean := try Send(ConnectionValue, ServerMessage.ErrorMessage('invalid_viewport', Message), Token);
                  return Ok(true)
                end
              end
            end
            else
            begin
              var Sent: boolean := try Send(ConnectionValue, ServerMessage.ErrorMessage('expected_hello', 'The first message must be hello'), Token);
              return Ok(true)
            end
          end
        end;
        Error(Message):
        begin
          var Sent: boolean := try Send(ConnectionValue, ServerMessage.ErrorMessage('invalid_message', 'The client message is invalid'), Token);
          return Ok(true)
        end
      end
    end
  end;
  mutable var World: WorldSession := try OpenWorld(Config.WorldsRoot, Config.WorldId, Config.WorldSeed, Config.ChunkCacheLimit);
  mutable var SaveAvailable: boolean := false;
  mutable var InvalidSaveRemoved: boolean := false;
  case try LoadSaveGame(World) of
    SaveGameLoad.Missing:
    begin
    end;
    SaveGameLoad.InvalidRemoved(Reason):
    begin
      InvalidSaveRemoved := true
    end;
    SaveGameLoad.Loaded(SavedState):
    begin
      SaveAvailable := true
    end
  end;
  mutable var State: option of GameState := None;
  var WelcomeSent: boolean := try Send(ConnectionValue, ServerMessage.Welcome(ProtocolVersion, SaveAvailable, InvalidSaveRemoved), Token);
  while not IsCancellationRequested(Token) do
  begin
    case ReadLine(Reader, Token) of
      Error(ReadMessage):
      begin
        return FinishReadFailure(ConnectionValue, ReadMessage, Token)
      end;
      Ok(ReadValue):
      begin
        Reader := ReadValue.Reader;
        case DecodeClient(ReadValue.Line) of
          Error(DecodeMessage):
          begin
            var Sent: boolean := try Send(ConnectionValue, ServerMessage.ErrorMessage('invalid_message', 'The client message is invalid'), Token);
            return Ok(true)
          end;
          Ok(ClientMessageValue):
          begin
            if not Std.Options.IsSome(State) and RequiresActiveSession(ClientMessageValue) then
            begin
              var Sent: boolean := try Send(ConnectionValue, ServerMessage.Rejected('session_not_started', 'Start or load a game first.'), Token)
            end
            else
            begin
              case ClientMessageValue of
                ClientMessage.Disconnect:
                begin
                  return Ok(true)
                end;
                ClientMessage.Hello(Version, Width, Height):
                begin
                  var Sent: boolean := try Send(ConnectionValue, ServerMessage.ErrorMessage('unexpected_hello', 'The session is already established'), Token);
                  return Ok(true)
                end;
                ClientMessage.StartNewGame:
                begin
                  if Std.Options.IsSome(State) then
                  begin
                    var Sent: boolean := try Send(ConnectionValue, ServerMessage.Rejected('session_already_started', 'A game session is already active.'), Token)
                  end
                  else
                  begin
                    var StartedState: GameState := try RevealCurrentArea(World.Metadata, NewGame(World.Metadata));
                    State := Some(StartedState);
                    World := try SendProjection(ConnectionValue, World, StartedState, Viewport, Token)
                  end
                end;
                ClientMessage.LoadGame:
                begin
                  if Std.Options.IsSome(State) then
                  begin
                    var Sent: boolean := try Send(ConnectionValue, ServerMessage.Rejected('session_already_started', 'A game session is already active.'), Token)
                  end
                  else
                  begin
                    case LoadSaveGame(World) of
                      Error(Message):
                      begin
                        var Sent: boolean := try Send(ConnectionValue, ServerMessage.Rejected('load_failed', Message), Token)
                      end;
                      Ok(LoadedSave):
                      begin
                        case LoadedSave of
                          SaveGameLoad.Missing:
                          begin
                            SaveAvailable := false;
                            var Sent: boolean := try Send(ConnectionValue, ServerMessage.Rejected('save_unavailable', 'No saved game is available for this world.'), Token)
                          end;
                          SaveGameLoad.InvalidRemoved(Reason):
                          begin
                            SaveAvailable := false;
                            var Sent: boolean := try Send(ConnectionValue, ServerMessage.Rejected('save_removed', 'Invalid saved game was removed. Start a new game.'), Token)
                          end;
                          SaveGameLoad.Loaded(SavedState):
                          begin
                            var RevealedState: GameState := try RevealCurrentArea(World.Metadata, SavedState);
                            State := Some(RevealedState);
                            World := try SendProjection(ConnectionValue, World, RevealedState, Viewport, Token)
                          end
                        end
                      end
                    end
                  end
                end;
                ClientMessage.SaveGame:
                begin
                  if not Std.Options.IsSome(State) then
                  begin
                    var Sent: boolean := try Send(ConnectionValue, ServerMessage.Rejected('session_not_started', 'Start or load a game before saving.'), Token)
                  end
                  else
                  begin
                    case WriteSaveGame(World, try RequireActiveState(State)) of
                      Ok(Written):
                      begin
                        SaveAvailable := true;
                        var Sent: boolean := try Send(ConnectionValue, ServerMessage.SaveCompleted, Token)
                      end;
                      Error(Message):
                      begin
                        var Sent: boolean := try Send(ConnectionValue, ServerMessage.Rejected('save_failed', Message), Token)
                      end
                    end
                  end
                end;
                ClientMessage.Viewport(Width, Height):
                begin
                  case ResolveViewport(Width, Height, Config) of
                    Ok(Value):
                    begin
                      Viewport := Value;
                      World := try SendProjection(ConnectionValue, World, try RequireActiveState(State), Viewport, Token)
                    end;
                    Error(Message):
                    begin
                      var Sent: boolean := try Send(ConnectionValue, ServerMessage.Rejected('invalid_viewport', Message), Token)
                    end
                  end
                end;
                ClientMessage.ExplorationMap(OriginX, OriginY, Width, Height):
                begin
                  if (Width > Config.MaximumViewWidth) or (Height > Config.MaximumViewHeight) then
                  begin
                    var Sent: boolean := try Send(ConnectionValue, ServerMessage.Rejected('invalid_map_window', 'Exploration map dimensions exceed server limits.'), Token)
                  end
                  else
                  begin
                    var MapValue: ExplorationMapState := try ProjectExplorationMap(try RequireActiveState(State), World.Metadata, OriginX, OriginY, Width, Height);
                    var Sent: boolean := try Send(ConnectionValue, ServerMessage.ExplorationMap(MapValue), Token)
                  end
                end;
                ClientMessage.Move(DeltaX, DeltaY):
                begin
                  case MoveInWorld(World, try RequireActiveState(State), DeltaX, DeltaY) of
                    Ok(Moved):
                    begin
                      World := Moved.World;
                      var RevealedState: GameState := try RevealCurrentArea(World.Metadata, Moved.State);
                      State := Some(RevealedState);
                      World := try SendProjection(ConnectionValue, World, RevealedState, Viewport, Token)
                    end;
                    Error(Reason):
                    begin
                      var Sent: boolean := try Send(ConnectionValue, ServerMessage.Rejected('movement_rejected', Reason), Token)
                    end
                  end
                end;
                ClientMessage.StepFirstPerson(Direction):
                begin
                  case Dungeon.Game.StepFirstPerson(World.Metadata, try RequireActiveState(State), GameStep(Direction)) of
                    Ok(Stepped):
                    begin
                      var RevealedState: GameState := try RevealCurrentArea(World.Metadata, Stepped);
                      State := Some(RevealedState);
                      World := try SendProjection(ConnectionValue, World, RevealedState, Viewport, Token)
                    end;
                    Error(Reason):
                    begin
                      var Sent: boolean := try Send(ConnectionValue, ServerMessage.Rejected('movement_rejected', Reason), Token)
                    end
                  end
                end;
                ClientMessage.TurnFirstPerson(Direction):
                begin
                  case Dungeon.Game.TurnFirstPerson(World.Metadata, try RequireActiveState(State), GameTurn(Direction)) of
                    Ok(Turned):
                    begin
                      var RevealedState: GameState := try RevealCurrentArea(World.Metadata, Turned);
                      State := Some(RevealedState);
                      World := try SendProjection(ConnectionValue, World, RevealedState, Viewport, Token)
                    end;
                    Error(Reason):
                    begin
                      var Sent: boolean := try Send(ConnectionValue, ServerMessage.Rejected('turn_rejected', Reason), Token)
                    end
                  end
                end;
                ClientMessage.Interact:
                begin
                  case Dungeon.Game.Interact(World.Metadata, try RequireActiveState(State)) of
                    Ok(Outcome):
                    begin
                      case Outcome of
                        InteractionOutcome.Transitioned(Transitioned):
                        begin
                          var RevealedState: GameState := try RevealCurrentArea(World.Metadata, Transitioned);
                          State := Some(RevealedState);
                          World := try SendProjection(ConnectionValue, World, RevealedState, Viewport, Token)
                        end;
                        InteractionOutcome.Described(Title, Text):
                        begin
                          var Sent: boolean := try Send(ConnectionValue, ServerMessage.Interaction(Title, Text), Token)
                        end
                      end
                    end;
                    Error(Reason):
                    begin
                      var Sent: boolean := try Send(ConnectionValue, ServerMessage.Rejected('interaction_rejected', Reason), Token)
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end;

  return Ok(true)
end;

// Runs the signal-aware server with validated world and viewport configuration.
public function RunServer(Host: string; Port: integer; Config: ServerConfig): result of boolean, string;
begin
  if (Config.MaximumViewWidth < 1) or (Config.MaximumViewHeight < 1) then
  begin
    return Error('server maximum viewport dimensions must be positive')
  end;

  if Config.ChunkCacheLimit < RequiredCacheCapacity(Config) then
  begin
    return Error('server chunk cache is too small for the configured maximum viewport and prefetch margin')
  end;
  var ValidatedWorld: WorldSession := try OpenWorld(Config.WorldsRoot, Config.WorldId, Config.WorldSeed, Config.ChunkCacheLimit);
  var ListenerValue: Listener := try Listen(Host, Port);
  var Life: ServerLifetime := try CreateLifetime(2000, false);
  var Owned: boolean := try OwnListener(Life, ListenerValue);
  var Observing: boolean := try ObserveSignals(Life);
  var Workers: TaskGroup := GetWorkGroup(Life);
  StartTaskInGroup(Workers, function(Token: CancellationToken): result of boolean, string begin
    while not IsCancellationRequested(Token) do
    begin
      case AcceptWithCancellation(ListenerValue, Token) of
        Ok(Client):
        begin
          var Outcome: result of boolean, string := ServeConnection(Client, Config, Token);
          var Closed: boolean := try Close(Client);
          case Outcome of
            Error(Message):
            begin
              WriteLn('Client failed: ' + Message)
            end
            else
            begin
            end
          end
        end;
        Error(Message):
        begin
          if IsCancellationRequested(Token) then
          begin
            return Ok(true)
          end;

          return Error(Message)
        end
      end
    end;

    return Ok(true)
  end);
  WriteLn((((('Dungeon server for world ' + Config.WorldId) + ' listening on ') + Host) + ':') +
          Std.Conv.IntToStr(Port));
  while IsReady(Life) do
  begin
    Sleep(20)
  end;

  RequestStop(Life);
  var Failures: array of TaskFailure := try CloseTaskGroupWithTimeout(Workers, RemainingMillis(Life));
  for Failure: TaskFailure in Failures do
  begin
    WriteLn(Failure.Message)
  end;
  var Finished: boolean := try FinishShutdown(Life);
  if Std.Arrays.Length(Failures) <> 0 then
  begin
    return Error('server worker failed')
  end;

  return Ok(true)
end;
