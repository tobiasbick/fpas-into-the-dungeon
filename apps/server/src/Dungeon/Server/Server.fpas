// Authoritative world-backed server for versioned client sessions: handshake, message loop, and listener.
unit Dungeon.Server;

uses
  Dungeon.Server.Config, Dungeon.Server.Failures, Dungeon.Server.Handling, Dungeon.Server.Replies,
  Dungeon.Server.Session, Dungeon.Protocol, Dungeon.Protocol.ClientMessages,
  Dungeon.Protocol.Transport, Dungeon.World, Dungeon.World.Savegame, Std.Arrays, Std.Console,
  Std.Conv, Std.Net, Std.Server, Std.Tasks, Std.Time;

function FinishReadFailure(ConnectionValue: Connection; Message: string; Token: CancellationToken): result of boolean, string;
begin
  if Message = LineTooLongError then
    begin
      var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('line_too_long', Message), Token);
    end;
  end if;

  return Ok(true);
end function;

// Serves one connected client against the selected world until the session ends.
public function ServeConnection(
  ConnectionValue: Connection;
  Config: ServerConfig;
  Token: CancellationToken
): result of boolean, string;
begin
  mutable var Reader: LineReader := NewLineReader(ConnectionValue);
  mutable var Viewport: ViewportSize := record
    Width := 1;
    Height := 1;
  end;

  case ReadLine(Reader, Token) of
    when Error(ReadMessage):
      begin
        return FinishReadFailure(ConnectionValue, ReadMessage, Token);
      end;
    when Ok(FirstRead):
      begin
        Reader := FirstRead.Reader;
        case DecodeClient(FirstRead.Line) of
          when Ok(FirstMessage):
            begin
              case FirstMessage of
                when ClientMessage.Hello(Version, Width, Height):
                  begin
                    if Version <> ProtocolVersion then
                      begin
                        var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('unsupported_version', ('Protocol version ' + IntToStr(ProtocolVersion)) +
                                                                                                                                ' is required'), Token);
                        return Ok(true);
                      end;
                    end if;

                    case ResolveViewport(Width, Height, Config) of
                      when Ok(Value):
                        begin
                          Viewport := Value;
                        end;
                      when Error(Message):
                        begin
                          var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('invalid_viewport', Message), Token);
                          return Ok(true);
                        end;
                    end case;
                  end;
                else
                  begin
                    var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('expected_hello', 'The first message must be hello'), Token);
                    return Ok(true);
                  end;
              end case;
            end;
          when Error(Message):
            begin
              var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('invalid_message', 'The client message is invalid'), Token);
              return Ok(true);
            end;
        end case;
      end;
  end case;
  var World: WorldSession := try OpenWorld(Config.WorldsRoot, Config.WorldId, Config.WorldSeed, Config.DungeonRegionChunks, Config.ChunkCacheLimit);
  mutable var SaveAvailable: boolean := false;
  mutable var InvalidSaveRemoved: boolean := false;
  // Inspection reports availability only; an explicit load rereads and validates again.
  case LoadSaveGame(World) of
    when Ok(Inspected):
      begin
        case Inspected of
          when SaveGameLoad.Missing:
            begin
              null;
            end;
          when SaveGameLoad.InvalidRemoved(Reason):
            begin
              InvalidSaveRemoved := true;
            end;
          when SaveGameLoad.Loaded(SavedState, SavedView):
            begin
              SaveAvailable := true;
            end;
        end case;
      end;
    when Error(Failure):
      begin
        // A missing level or storage failure preserves the save and closes before Welcome.
        var Rejection: FailureRejection := PersistenceRejection(World.Metadata.Id, 'load_failed', Failure);
        WriteLn((Rejection.Code + ': ') + PersistenceFailureReason(Failure));
        var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.Rejected(Rejection.Code, Rejection.Message), Token);
        return Ok(true);
      end;
  end case;
  mutable var Session: ServerSession := record
    World := World;
    State := None;
    Interior := None;
    Viewport := Viewport;
    Finished := false;
  end;
  var WelcomeSent: boolean := try SendMessage(ConnectionValue, ServerMessage.Welcome(ProtocolVersion, SaveAvailable, InvalidSaveRemoved), Token);
  while not IsCancellationRequested(Token) do
    begin
      case ReadLine(Reader, Token) of
        when Error(ReadMessage):
          begin
            return FinishReadFailure(ConnectionValue, ReadMessage, Token);
          end;
        when Ok(ReadValue):
          begin
            Reader := ReadValue.Reader;
            case DecodeClient(ReadValue.Line) of
              when Error(DecodeMessage):
                begin
                  var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('invalid_message', 'The client message is invalid'), Token);
                  return Ok(true);
                end;
              when Ok(ClientMessageValue):
                begin
                  Session := try HandleSessionMessage(Session, ClientMessageValue, ConnectionValue, Config, Token);
                  if Session.Finished then
                    begin
                      return Ok(true);
                    end;
                  end if;
                end;
            end case;
          end;
      end case;
    end;
  end while;

  return Ok(true);
end function;

// Runs the signal-aware server with validated world and viewport configuration.
public function RunServer(Host: string; Port: integer; Config: ServerConfig): result of boolean, string;
begin
  if (Config.MaximumViewWidth < 1) or (Config.MaximumViewHeight < 1) then
    begin
      return Error('server maximum viewport dimensions must be positive');
    end;
  end if;

  if Config.ChunkCacheLimit < RequiredCacheCapacity(Config) then
    begin
      return Error('server chunk cache is too small for the configured maximum viewport and prefetch margin');
    end;
  end if;
  var ValidatedWorld: WorldSession := try OpenWorld(Config.WorldsRoot, Config.WorldId, Config.WorldSeed, Config.DungeonRegionChunks, Config.ChunkCacheLimit);
  var ListenerValue: Listener := try Listen(Host, Port);
  var Life: ServerLifetime := try CreateLifetime(2000, false);
  var Owned: boolean := try OwnListener(Life, ListenerValue);
  var Observing: boolean := try ObserveSignals(Life);
  var Workers: TaskGroup := GetWorkGroup(Life);
  var AcceptTask: task of result of boolean, string := StartTaskInGroup(Workers, function(Token: CancellationToken): result of boolean, string begin
    while not IsCancellationRequested(Token) do
      begin
        case AcceptWithCancellation(ListenerValue, Token) of
          when Ok(Client):
            begin
              var Outcome: result of boolean, string := ServeConnection(Client, Config, Token);
              var Closed: boolean := try Close(Client);
              case Outcome of
                when Error(Message):
                  begin
                    WriteLn('Client failed: ' + Message);
                  end;
                else
                  begin
                    null;
                  end;
              end case;
            end;
          when Error(Message):
            begin
              if IsCancellationRequested(Token) then
                begin
                  return Ok(true);
                end;
              end if;

              return Error(Message);
            end;
        end case;
      end;
    end while;

    return Ok(true);
  end function);
  WriteLn((((('Dungeon server for world ' + Config.WorldId) + ' listening on ') + Host) + ':') +
          Std.Conv.IntToStr(Port));
  while IsReady(Life) do
    begin
      Sleep(20);
    end;
  end while;

  discard RequestStop(Life);
  var Failures: array of TaskFailure := try CloseTaskGroupWithTimeout(Workers, RemainingMillis(Life));
  for Failure: TaskFailure in Failures do
    begin
      WriteLn(Failure.Message);
    end;
  end for;
  var Finished: boolean := try FinishShutdown(Life);
  if Std.Arrays.Length(Failures) <> 0 then
    begin
      return Error('server worker failed');
    end;
  end if;

  return Ok(true);
end function;
end unit;
