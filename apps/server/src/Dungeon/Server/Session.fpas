// Per-connection session state and the rules deciding which messages a session accepts.
unit Dungeon.Server.Session;

uses Dungeon.Dialogue as DialogueRules, Dungeon.Areas as Areas, Dungeon.Server.Config as ConfigUnit, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Interior as InteriorUnit, Dungeon.Protocol as Protocol, Dungeon.World as WorldUnit;

// Accepted client viewport in fields, bounded by the server policy.
public type ViewportSize = record
  public Width: integer;
  public Height: integer;
end record;

// Per-connection state carried between client messages after the handshake.
public type ServerSession = record
  public World: WorldUnit.WorldSession;
  // False until valid existing metadata or a newly allocated world has been selected.
  public WorldSelected: boolean;
  // True after unsaved game changes; clearing requires save or explicit discard.
  public Dirty: boolean;
  // Successful explicit save time in this connection; diagnostic only, never serialized.
  public LastSavedAt: integer := 0;
  public State: option of GameState.GameState;
  // Validated finite geometry retained while the player occupies its dungeon or settlement.
  public Interior: option of InteriorUnit.InteriorMap;
  public Viewport: ViewportSize;
  // Set when the connection must close after the current message.
  public Finished: boolean;
  // Connection-local authoritative frame; disconnect and game persistence never retain it.
  public ActiveDialogue: option of DialogueRules.Frame := None;
end record;

// Bounds a requested viewport by the server policy; non-positive sizes are an error.
public function ResolveViewport(Width: integer; Height: integer; Config: ConfigUnit.ServerConfig): result of (ViewportSize, string);
begin
  if (Width < 1) or (Height < 1) then
    begin
      return Error('viewport dimensions must be positive');
    end;
  end if;
  var BoundedWidth: integer := Width;
  var BoundedHeight: integer := Height;
  if BoundedWidth > Config.MaximumViewWidth then
    begin
      BoundedWidth := Config.MaximumViewWidth;
    end;
  end if;

  if BoundedHeight > Config.MaximumViewHeight then
    begin
      BoundedHeight := Config.MaximumViewHeight;
    end;
  end if;

  return Ok(ViewportSize(Width := BoundedWidth, Height := BoundedHeight));
end function;

// Builds the current view from retained session geometry without loading a map.
// State may be the accepted replacement state of the same area before committing it.
public function SessionAreaView(Session: ServerSession; State: GameState.GameState): result of (GameState.AreaView, string);
begin
  return Areas.AreaViewFor(Session.World.Metadata, State, Session.Interior);
end function;

function MaximumIntersectingChunks(Length: integer): integer;
begin
  if Length = 1 then
    begin
      return 1;
    end;
  end if;

  return ((Length - 2) div Coordinates.WorldChunkSize) + 2;
end function;

// Returns the chunk cache size that holds every chunk of the largest allowed viewport.
public function RequiredCacheCapacity(Config: ConfigUnit.ServerConfig): integer;
begin
  return (MaximumIntersectingChunks(Config.MaximumViewWidth) + 2) *
    (MaximumIntersectingChunks(Config.MaximumViewHeight) + 2);
end function;

// Gameplay-dispatch prerequisite; world-lifecycle handlers own their independent guards.
// Save/overwrite are routed before gameplay and must not be classified by this helper.
public function RequiresActiveSession(Message: Protocol.ClientMessage): boolean;
begin
  return case Message of
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_): true;
    when Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _), Protocol.ClientMessage.Disconnect: false;
  end case;
end function;

// Returns the active game state; without a started session it is an error.
public function RequireActiveState(State: option of GameState.GameState): result of (GameState.GameState, string);
begin
  return case State of
    when Some(const Value): Ok(Value);
    when None: Error('server session has no active game state');
  end case;
end function;
end unit;
