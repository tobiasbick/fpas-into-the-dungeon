// Per-connection session state and the rules deciding which messages a session accepts.
unit Dungeon.Server.Session;

uses
  Dungeon.Areas, Dungeon.Server.Config, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interior,
  Dungeon.Protocol, Dungeon.World;

public type
  // Accepted client viewport in fields, bounded by the server policy.
  ViewportSize = record
    public Width: integer;
    public Height: integer;
  end record;
  // Per-connection state carried between client messages after the handshake.
  ServerSession = record
    public World: WorldSession;
    // False until valid existing metadata or a newly allocated world has been selected.
    public WorldSelected: boolean;
    // True after unsaved game changes; clearing requires save or explicit discard.
    public Dirty: boolean;
    public State: option of GameState;
    // Validated geometry retained only while the active player occupies its dungeon.
    public Interior: option of InteriorMap;
    public Viewport: ViewportSize;
    // Set when the connection must close after the current message.
    public Finished: boolean;
  end record;

// Bounds a requested viewport by the server policy; non-positive sizes are an error.
public function ResolveViewport(Width: integer; Height: integer; Config: ServerConfig): result of ViewportSize, string;
begin
  if (Width < 1) or (Height < 1) then
    begin
      return Error('viewport dimensions must be positive');
    end;
  end if;
  mutable var BoundedWidth: integer := Width;
  mutable var BoundedHeight: integer := Height;
  if BoundedWidth > Config.MaximumViewWidth then
    begin
      BoundedWidth := Config.MaximumViewWidth;
    end;
  end if;

  if BoundedHeight > Config.MaximumViewHeight then
    begin
      BoundedHeight := Config.MaximumViewHeight;
    end;
  end if;

  return Ok(record
    Width := BoundedWidth;
    Height := BoundedHeight;
  end);
end function;

// Builds the current view from retained session geometry without loading a map.
// State may be the accepted replacement state of the same area before committing it.
public function SessionAreaView(Session: ServerSession; State: GameState): result of AreaView, string;
begin
  return AreaViewFor(Session.World.Metadata, State, Session.Interior);
end function;

function MaximumIntersectingChunks(Length: integer): integer;
begin
  if Length = 1 then
    begin
      return 1;
    end;
  end if;

  return ((Length - 2) div WorldChunkSize) + 2;
end function;

// Returns the chunk cache size that holds every chunk of the largest allowed viewport.
public function RequiredCacheCapacity(Config: ServerConfig): integer;
begin
  return (MaximumIntersectingChunks(Config.MaximumViewWidth) + 2) *
         (MaximumIntersectingChunks(Config.MaximumViewHeight) + 2);
end function;

// Returns whether a message needs an active game session.
public function RequiresActiveSession(Message: ClientMessage): boolean;
begin
  case Message of
    when ClientMessage.Viewport(Width, Height):
      begin
        return true;
      end;
    when ClientMessage.ExplorationMap(OriginX, OriginY, Width, Height):
      begin
        return true;
      end;
    when ClientMessage.Move(DeltaX, DeltaY):
      begin
        return true;
      end;
    when ClientMessage.StepFirstPerson(Direction):
      begin
        return true;
      end;
    when ClientMessage.TurnFirstPerson(Direction):
      begin
        return true;
      end;
    when ClientMessage.Interact:
      begin
        return true;
      end;
    when ClientMessage.OverwriteSaveGame:
      begin
        return true;
      end;
    when ClientMessage.SaveGame:
      begin
        return true;
      end;
    when ClientMessage.Attack:
      begin
        return true;
      end;
    when ClientMessage.Wait:
      begin
        return true;
      end;
    when ClientMessage.Equip(ItemId):
      begin
        return true;
      end;
    when ClientMessage.Unequip(ItemId):
      begin
        return true;
      end;
    when ClientMessage.DropItem(ItemId):
      begin
        return true;
      end;
    else
      begin
        return false;
      end;
  end case;
end function;

// Returns the active game state; without a started session it is an error.
public function RequireActiveState(State: option of GameState): result of GameState, string;
begin
  case State of
    when Some(Value):
      begin
        return Ok(Value);
      end;
    when None:
      begin
        return Error('server session has no active game state');
      end;
  end case;
end function;
end unit;
