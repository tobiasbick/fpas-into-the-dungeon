// Explicit world creation and fresh starts with idle/selection prerequisites.
unit Dungeon.Server.Worlds.Creation;

uses Dungeon.GameState as GameState, Dungeon.Server.Config as ConfigUnit, Dungeon.Server.Worlds.Catalog as CatalogPages, Dungeon.Server.Logging as Logging, Dungeon.Server.Session as SessionUnit, Dungeon.World.Catalog as CatalogUnit, Std.Net.Sockets as Net, Std.Tasks as Tasks, Dungeon.Server.Worlds.Replies as Lifecycle;

// Requires an idle session and valid defaults, exclusively creates a world and starts unsaved progress.
public function CreateGame(Session: SessionUnit.ServerSession; Seed: integer; RegionChunks: integer; ConnectionValue: Net.Connection; Config: ConfigUnit.ServerConfig; Token: Tasks.CancellationToken): result of (SessionUnit.ServerSession, string);
begin
  const Active: boolean := Session.State is Some(_);
  if Active then
    return Ok(
      try Lifecycle.RejectWorld(
        Session,
        Config,
        ConnectionValue,
        'session_already_started',
        'Return to world selection first.',
        Token
      )
    );
  end if;

  case CatalogPages.CreationDefaults(Config) of
    when Error(const Reason):
      begin
        return Ok(
          try Lifecycle.RejectWorld(
            Session,
            Config,
            ConnectionValue,
            'storage_error',
            'Cannot read server defaults.',
            Token
          )
        );
      end;
    when Ok(const Defaults):
      begin
        null;
      end;
  end case;

  case CatalogUnit.CreateWorld(Config.WorldsRoot, Seed, RegionChunks, Config.ChunkCacheLimit) of
    when Error(const Reason):
      begin
        Logging.LogServer(Config.Logs, 'error', Reason);
        return Ok(
          try Lifecycle.RejectWorld(
            Session,
            Config,
            ConnectionValue,
            'create_failed',
            'Cannot create world. Check parameters and storage access.',
            Token
          )
        );
      end;
    when Ok(const World):
      begin
        Logging.LogServer(Config.Logs, 'world', 'Created world ' + World.Metadata.Id);
        return Ok(
          try Lifecycle.InstallGame(
            Session,
            World,
            GameState.NewGame(World.Metadata),
            None,
            true,
            ConnectionValue,
            Config,
            Token
          )
        );
      end;
  end case;
end function;

// Requires an idle session with a selected world; starts at spawn without replacing an earlier explicit save.
public function StartGame(Session: SessionUnit.ServerSession; ConnectionValue: Net.Connection; Config: ConfigUnit.ServerConfig; Token: Tasks.CancellationToken): result of (SessionUnit.ServerSession, string);
begin
  const Active: boolean := Session.State is Some(_);
  if Active then
    return Ok(
      try Lifecycle.RejectWorld(
        Session,
        Config,
        ConnectionValue,
        'session_already_started',
        'A game session is already active.',
        Token
      )
    );
  end if;

  if not Session.WorldSelected then
    return Ok(
      try Lifecycle.RejectWorld(
        Session,
        Config,
        ConnectionValue,
        'world_unavailable',
        'Select a compatible world first.',
        Token
      )
    );
  end if;

  return Ok(
    try Lifecycle.InstallGame(
      Session,
      Session.World,
      GameState.NewGame(Session.World.Metadata),
      None,
      true,
      ConnectionValue,
      Config,
      Token
    )
  );
end function;
end unit;
