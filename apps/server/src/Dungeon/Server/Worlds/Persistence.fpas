// Explicit save and Continue operations, their prerequisites and server-only persistence diagnostics.
unit Dungeon.Server.Worlds.Persistence;

uses Dungeon.GameState as GameState, Dungeon.Protocol as Protocol, Dungeon.Server.Config as ConfigUnit, Dungeon.Server.Failures as FailuresUnit, Dungeon.Server.Logging as Logging, Dungeon.Server.Replies as Replies, Dungeon.Server.Session as SessionUnit, Dungeon.World.Savegame as SavegameUnit, Std.Io.Fs as Fs, Std.Net.Sockets as Net, Std.Tasks as Tasks, Std.Time as Time, Dungeon.Server.Worlds.Replies as Lifecycle;

// Requires an idle selected world; fully validates its save/levels, or starts unsaved if the save is absent.
public function LoadGame(Session: SessionUnit.ServerSession; ConnectionValue: Net.Connection; Config: ConfigUnit.ServerConfig; Token: Tasks.CancellationToken): result of (SessionUnit.ServerSession, string);
begin
  const Active: boolean := Session.State is Some(_);
  if Active then
    return Ok(
      try Lifecycle.RejectWorld(
        Session,
        Config,
        ConnectionValue,
        'session_already_started',
        'A game session is already active.',
        Token
      )
    );
  end if;

  if not Session.WorldSelected then
    return Ok(
      try Lifecycle.RejectWorld(
        Session,
        Config,
        ConnectionValue,
        'world_unavailable',
        'Select a compatible world first.',
        Token
      )
    );
  end if;

  case SavegameUnit.LoadSaveGame(Session.World) of
    when Error(const Failure):
      begin
        Logging.LogServer(
          Config.Logs, 'error', 'load failed for world ' + Session.World.Metadata.Id + ': ' +
          FailuresUnit.PersistenceFailureReason(Failure)
        );
        const Rejection: FailuresUnit.FailureRejection := FailuresUnit.PersistenceRejection(
          Session.World.Metadata.Id,
          'load_failed',
          Failure
        );
        return Ok(
          try Lifecycle.RejectWorld(
            Session,
            Config,
            ConnectionValue,
            Rejection.Code,
            Rejection.Message,
            Token
          )
        );
      end;
    when Ok(const Loaded):
      begin
        case Loaded of
          when SavegameUnit.SaveGameLoad.Missing:
            begin
              return Ok(
                try Lifecycle.InstallGame(
                  Session,
                  Session.World,
                  GameState.NewGame(Session.World.Metadata),
                  None,
                  true,
                  ConnectionValue,
                  Config,
                  Token
                )
              );
            end;
          when SavegameUnit.SaveGameLoad.Invalid(const Reason):
            begin
              Logging.LogServer(
                Config.Logs, 'error',
                'load failed for world ' + Session.World.Metadata.Id + ': ' + Reason
              );
              return Ok(
                try Lifecycle.RejectWorld(
                  Session,
                  Config,
                  ConnectionValue,
                  'save_incompatible',
                  'Saved game is incompatible and was kept. Start over or recreate it.',
                  Token
                )
              );
            end;
          when SavegameUnit.SaveGameLoad.Loaded(const State, const View):
            begin
              Logging.LogServer(
                Config.Logs,
                'world',
                'Loaded world ' + Session.World.Metadata.Id
              );
              return Ok(
                try Lifecycle.InstallGame(
                  Session,
                  Session.World,
                  State,
                  View.Interior,
                  false,
                  ConnectionValue,
                  Config,
                  Token
                )
              );
            end;
        end case;
      end;
  end case;
end function;

// Requires active state; an existing save needs Overwrite. Storage failures retain previous data.
// A reply failure is fatal and can occur after the save has committed successfully on disk.
public function SaveGame(Session: SessionUnit.ServerSession; Overwrite: boolean; ConnectionValue: Net.Connection; Config: ConfigUnit.ServerConfig; Token: Tasks.CancellationToken): result of (SessionUnit.ServerSession, string);
begin
  const Active: boolean := Session.State is Some(_);
  if not Active then
    return Ok(
      try Lifecycle.RejectWorld(
        Session,
        Config,
        ConnectionValue,
        'session_not_started',
        'Start or continue a game first.',
        Token
      )
    );
  end if;

  if (not Overwrite)
    and
    Fs.Exists(SavegameUnit.SaveGamePath(Session.World))
  then
    return Ok(
      try Lifecycle.RejectWorld(
        Session,
        Config,
        ConnectionValue,
        'overwrite_required',
        'Confirm overwriting the existing save or cancel.',
        Token
      )
    );
  end if;

  case SavegameUnit.WriteSaveGame(
    Session.World,
    try SessionUnit.RequireActiveState(Session.State)
  ) of
    when Error(const Failure):
      begin
        Logging.LogServer(
          Config.Logs, 'error', 'save failed for world ' + Session.World.Metadata.Id + ': ' +
          FailuresUnit.PersistenceFailureReason(Failure)
        );
        const Rejection: FailuresUnit.FailureRejection := FailuresUnit.PersistenceRejection(
          Session.World.Metadata.Id,
          'save_failed',
          Failure
        );
        return Ok(
          try Lifecycle.RejectWorld(
            Session,
            Config,
            ConnectionValue,
            Rejection.Code,
            Rejection.Message,
            Token
          )
        );
      end;
    when Ok(const Written):
      begin
        const Sent: boolean := try Replies.SendMessage(
          ConnectionValue,
          Protocol.ServerMessage.SaveCompleted,
          Token
        );
        Logging.LogServer(Config.Logs, 'world', 'Saved world ' + Session.World.Metadata.Id);
        return Ok(Session with Dirty := false; LastSavedAt := Time.TimestampMillis(); end with);
      end;
  end case;
end function;
end unit;
