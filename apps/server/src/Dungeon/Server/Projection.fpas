// Client-safe projections of the authoritative state: masked rows, inventory, character, and map windows.
unit Dungeon.Server.Projection;

uses Dungeon.Quests.Journal as QuestJournal, Dungeon.Npcs as NpcRules, Std.Math as Math, Dungeon.Server.Mapping as Mapping, Dungeon.Server.Session as SessionUnit, Dungeon.Combat as Combat, Dungeon.Coordinates as Coordinates, Dungeon.Equipment as Equipment, Dungeon.Exploration as Exploration, Dungeon.Exploration.Sight as Sight, Dungeon.Exploration.Model as Model, Dungeon.GameState as GameState, Dungeon.Interaction as Interaction, Dungeon.Interior as InteriorUnit, Dungeon.Items as ItemRules, Dungeon.Protocol as Protocol, Dungeon.Terrain as Terrain, Dungeon.World as WorldUnit;

// Visible state of one projection and the world session whose chunk cache it may have grown.
public type SessionProjection = record
  public World: WorldUnit.WorldSession;
  public State: Protocol.VisibleState;
end record;

// Visible rows with Fog of War applied and their knowledge codes.
public type MaskedRows = record
  public Rows: array of string;
  public KnowledgeRows: array of string;
end record;

// Messages and structured events of the turn that produced a projected state.
public type TurnReport = record
  public Log: array of string;
  public Events: array of Combat.CombatEvent;
end record;

function ProjectInventory(State: GameState.GameState): array of Protocol.VisibleInventoryItem;
begin
  var Values: array of Protocol.VisibleInventoryItem := [];
  for Item: ItemRules.GameItem in GameState.InventoryItems(State) do
    begin
      var Slot: Protocol.VisibleItemSlot := Protocol.VisibleItemSlot.NoSlot;
      case ItemRules.ItemSlot(Item.Kind) of
        when Some(const Fitting):
          begin
            Slot := Mapping.ProtocolSlot(Fitting);
          end;
        when None:
          begin
            null;
          end;
      end case;
      var Equipped: boolean := false;
      case Item.Location of
        when ItemRules.ItemLocation.EquippedByPlayer(const Worn):
          Equipped := true;
        when ItemRules.ItemLocation.InInterior(_, _), ItemRules.ItemLocation.CarriedByPlayer, ItemRules.ItemLocation.HeldByMerchant(_), ItemRules.ItemLocation.Consumed, ItemRules.ItemLocation.ReturnedToMara(_):
          null;
      end case;

      Values.PushInPlace(
        Protocol.VisibleInventoryItem(
          Id := Item.Id,
          Name := ItemRules.ItemDisplayName(Item.Kind),
          Slot := Slot,
          Equipped := Equipped,
          Usable := Item.Kind = ItemRules.ItemKind.HealingPotion
        )
      );
    end;
  end for;

  return Values;
end function;

function ProjectCharacter(State: GameState.GameState): array of Protocol.VisibleCharacterValue;
begin
  var Values: array of Protocol.VisibleCharacterValue := [];
  for Line: Equipment.CharacterValueLine in Equipment.CharacterValueLines(State) do
    begin
      Values.PushInPlace(
        Protocol.VisibleCharacterValue(
          Label := Line.Label,
          Value := Line.Value,
          Source := Line.Source
        )
      );
    end;
  end for;

  return Values;
end function;

// Returns the report of a projection that no turn produced.
public function NoTurnReport(): TurnReport;
begin
  return TurnReport(Log := [], Events := []);
end function;

function KnowledgeCode(Value: Model.FieldKnowledge): string;
begin
  case Value of
    when Model.FieldKnowledge.Undiscovered:
      begin
        return Protocol.KnowledgeUndiscoveredCode;
      end;
    when Model.FieldKnowledge.Remembered:
      begin
        return Protocol.KnowledgeRememberedCode;
      end;
    when Model.FieldKnowledge.Visible:
      begin
        return Protocol.KnowledgeVisibleCode;
      end;
  end case;
end function;

// One field decision shared by first-person rows and exploration windows.
type InteriorField = record
  Code: string;
  Knowledge: string;
end record;

function ProjectInteriorField(State: GameState.GameState; Map: InteriorUnit.InteriorMap; VisibleFields: array of boolean; X: integer; Y: integer): result of (InteriorField, string);
begin
  if (X < 0) or (X >= Map.Width) or (Y < 0) or (Y >= Map.Height) then
    return Ok(
      InteriorField(
        Code := Protocol.UnknownFieldCode,
        Knowledge := Protocol.KnowledgeUndiscoveredCode
      )
    );
  end if;
  const Knowledge := Exploration.ClassifyField(
    Exploration.InteriorIsDiscovered(State.Exploration, State.AreaId, Map.Width, X, Y),
    VisibleFields[(Y * Map.Width) + X]
  );
  const Position := Coordinates.InteriorPosition(X := X, Y := Y);
  var Code := Protocol.UnknownFieldCode;
  case Knowledge of
    when Model.FieldKnowledge.Visible:
      if State.Area = Coordinates.AreaKind.Settlement then
        Code := NpcRules.MapCellCode(
          Map.Npcs,
          State.AreaId,
          Position,
          true,
          try InteriorUnit.InteriorVisibleCode(Map, Position)
        );
      else
        Code := try GameState.InteriorVisibleCodeForState(Map, State, Position);
      end if;
    when Model.FieldKnowledge.Remembered:
      // Memory retains geometry, never the current position of a dynamic entity.
      Code := try InteriorUnit.InteriorVisibleCode(Map, Position);
    when Model.FieldKnowledge.Undiscovered:
      null;
  end case;

  return Ok(InteriorField(Code := Code, Knowledge := KnowledgeCode(Knowledge)));
end function;

function MaskOutdoorRows(
  State: GameState.GameState;
  TerrainRows: array of string;
  OriginX: integer;
  OriginY: integer;
  Width: integer;
  Height: integer;
  Player: Coordinates.WorldPosition
): MaskedRows;
begin
  const VisibleFields: array of boolean := Exploration.OutdoorVisibility(
    OriginX,
    OriginY,
    Width,
    Height,
    Player
  );
  var Rows: array of string := [];
  var KnowledgeRows: array of string := [];
  for Y: integer := 0 to Height - 1 do
    begin
      var Row: string := '';
      var KnowledgeRow: string := '';
      for X: integer := 0 to Width - 1 do
        begin
          const WorldX: integer := OriginX + X;
          const WorldY: integer := OriginY + Y;
          const Knowledge: Model.FieldKnowledge := Exploration.ClassifyField(
            Exploration.OutdoorIsDiscovered(State.Exploration, WorldX, WorldY), VisibleFields[
              (Y * Width) +
              X
            ]
          );
          if Knowledge = Model.FieldKnowledge.Undiscovered then
            begin
              Row := Row + Protocol.UnknownFieldCode;
            end;
          else
            begin
              Row := Row + TerrainRows[Y][X];
            end;
          end if;

          KnowledgeRow := KnowledgeRow + KnowledgeCode(Knowledge);
        end;
      end for;

      Rows.PushInPlace(Row);
      KnowledgeRows.PushInPlace(KnowledgeRow);
    end;
  end for;

  return MaskedRows(Rows := Rows, KnowledgeRows := KnowledgeRows);
end function;

function MaskInteriorRows(State: GameState.GameState; Map: InteriorUnit.InteriorMap; Pose: Coordinates.FirstPersonPose): result of (MaskedRows, string);
begin
  const VisibleFields: array of boolean := Sight.InteriorVisibility(Map, Pose);
  var Rows: array of string := [];
  var KnowledgeRows: array of string := [];
  for Y: integer := 0 to Map.Height - 1 do
    begin
      var Row: string := '';
      var KnowledgeRow: string := '';
      for X: integer := 0 to Map.Width - 1 do
        begin
          const Field := try ProjectInteriorField(State, Map, VisibleFields, X, Y);
          Row := Row + Field.Code;
          KnowledgeRow := KnowledgeRow + Field.Knowledge;
        end;
      end for;

      Rows.PushInPlace(Row);
      KnowledgeRows.PushInPlace(KnowledgeRow);
    end;
  end for;

  return Ok(MaskedRows(Rows := Rows, KnowledgeRows := KnowledgeRows));
end function;

function PlayerInWindow(
  PlayerX: integer;
  PlayerY: integer;
  OriginX: integer;
  OriginY: integer;
  Width: integer;
  Height: integer
): boolean;
begin
  return (((PlayerX >= OriginX) and (PlayerX < OriginX + Width)) and (PlayerY >= OriginY))
    and
    (PlayerY < OriginY + Height);
end function;

// Returns one discovered field's cell from the chunks loaded for an exploration window.
function LoadedCell(Chunks: array of Terrain.WorldChunk; X: integer; Y: integer): result of (Terrain.WorldCell, string);
begin
  const ChunkX: integer := Coordinates.ChunkForCoordinate(X);
  const ChunkY: integer := Coordinates.ChunkForCoordinate(Y);
  for Chunk: Terrain.WorldChunk in Chunks do
    if (Chunk.Coordinate.X = ChunkX) and (Chunk.Coordinate.Y = ChunkY) then
      return Ok(
        Terrain.ChunkCell(
          Chunk,
          Coordinates.LocalForCoordinate(X),
          Coordinates.LocalForCoordinate(Y)
        )
      );
    end if;
  end for;

  return Error('discovered field lies outside the loaded exploration chunks');
end function;

// Outdoor exploration window together with the world session whose chunk cache served it.
public type OutdoorExplorationLoad = record
  public World: WorldUnit.WorldSession;
  public Map: Protocol.ExplorationMapState;
end record;

// Projects one outdoor exploration-map window with Fog of War from the stored chunks. Only
// chunks containing discovered fields or lying within current sight are loaded, from the cache
// or their chunk files; other chunks stay unknown and are neither read nor generated.
public function ProjectOutdoorExplorationMap(
  World: WorldUnit.WorldSession;
  State: GameState.GameState;
  View: GameState.AreaView;
  OriginX: integer;
  OriginY: integer;
  Width: integer;
  Height: integer
): result of (OutdoorExplorationLoad, string);
begin
  const Valid: GameState.GameState := try GameState.ValidateGameState(View, State);
  if State.Area <> Coordinates.AreaKind.OutdoorRegion then
    return Error('outdoor exploration windows require the outdoor area');
  end if;
  const Metadata: Terrain.WorldMetadata := View.Metadata;
  const Range: WorldUnit.ChunkRange := try WorldUnit.ChunkRangeForWindow(
    OriginX,
    OriginY,
    Width,
    Height
  );
  const Player: Coordinates.WorldPosition := try GameState.OutdoorPlayerPosition(State);
  // Chunks within the current sight square may hold visible fields before they are recorded.
  const SightChunks: WorldUnit.ChunkRange := try WorldUnit.ChunkRangeForWindow(
    Player.X - Exploration.OutdoorSightRadius,
    Player.Y - Exploration.OutdoorSightRadius,
    (2 * Exploration.OutdoorSightRadius) + 1,
    (2 * Exploration.OutdoorSightRadius) + 1
  );
  var Current: WorldUnit.WorldSession := World;
  var Chunks: array of Terrain.WorldChunk := [];
  for ChunkY: integer := Range.MinimumY to Range.MaximumY do
    for ChunkX: integer := Range.MinimumX to Range.MaximumX do
      const InSight: boolean := (ChunkX >= SightChunks.MinimumX)
        and
        (ChunkX <= SightChunks.MaximumX)
        and
        (ChunkY >= SightChunks.MinimumY) and (ChunkY <= SightChunks.MaximumY);
      if InSight or Exploration.OutdoorChunkHasDiscovery(State.Exploration, ChunkX, ChunkY) then
        const Loaded: WorldUnit.ChunkLoad := try WorldUnit.LoadWorldChunk(
          Current,
          Coordinates.ChunkCoordinate(X := ChunkX, Y := ChunkY)
        );
        Current := Loaded.World;
        Chunks.PushInPlace(Loaded.Chunk);
      end if;
    end for;
  end for;
  var Rows: array of string := [];
  var KnowledgeRows: array of string := [];
  const VisibleFields: array of boolean := Exploration.OutdoorVisibility(
    OriginX,
    OriginY,
    Width,
    Height,
    Player
  );
  for Y: integer := 0 to Height - 1 do
    begin
      var Row: string := '';
      var KnowledgeRow: string := '';
      for X: integer := 0 to Width - 1 do
        begin
          const WorldX: integer := OriginX + X;
          const WorldY: integer := OriginY + Y;
          const Knowledge: Model.FieldKnowledge := Exploration.ClassifyField(
            Exploration.OutdoorIsDiscovered(State.Exploration, WorldX, WorldY), VisibleFields[
              (Y * Width) +
              X
            ]
          );
          if Knowledge = Model.FieldKnowledge.Undiscovered then
            begin
              Row := Row + Protocol.UnknownFieldCode;
            end;
          else
            begin
              Row := Row + Terrain.VisibleCellCode(try LoadedCell(Chunks, WorldX, WorldY));
            end;
          end if;

          KnowledgeRow := KnowledgeRow + KnowledgeCode(Knowledge);
        end;
      end for;

      Rows.PushInPlace(Row);
      KnowledgeRows.PushInPlace(KnowledgeRow);
    end;
  end for;

  return Ok(
    OutdoorExplorationLoad(
      World := Current, Map := Protocol.ExplorationMapState(
        View := Protocol.ViewKind.Map,
        LabelText := Metadata.OutdoorAreaLabel,
        OriginX := OriginX,
        OriginY := OriginY,
        Width := Width,
        Height := Height,
        Rows := Rows,
        KnowledgeRows := KnowledgeRows,
        PlayerWorldX := Player.X,
        PlayerWorldY := Player.Y,
        PlayerInWindow := PlayerInWindow(Player.X, Player.Y, OriginX, OriginY, Width, Height)
      )
    )
  );
end function;

// Projects one exploration-map window of the current interior or settlement with Fog of War;
// outdoor windows use ProjectOutdoorExplorationMap.
public function ProjectExplorationMap(
  State: GameState.GameState;
  View: GameState.AreaView;
  OriginX: integer;
  OriginY: integer;
  Width: integer;
  Height: integer
): result of (Protocol.ExplorationMapState, string);
begin
  const Valid: GameState.GameState := try GameState.ValidateGameState(View, State);
  var Rows: array of string := [];
  var KnowledgeRows: array of string := [];
  if State.Area = Coordinates.AreaKind.OutdoorRegion then
    return Error('outdoor exploration windows are loaded through the world session');
  end if;
  const Map: InteriorUnit.InteriorMap := try GameState.CurrentInterior(View, State);
  var Player: Coordinates.InteriorPosition := Map.Start;
  var VisibleFields: array of boolean := [];
  if State.Area = Coordinates.AreaKind.Settlement then
    Player := try GameState.SettlementPlayerPosition(State);
    VisibleFields := Exploration.SettlementVisibility(Map, Player);
  else
    const Pose := try GameState.FirstPersonPlayerPose(State);
    Player := Pose.Position;
    VisibleFields := Sight.InteriorVisibility(Map, Pose);
  end if;

  for LocalY: integer := 0 to Height - 1 do
    begin
      var Row: string := '';
      var KnowledgeRow: string := '';
      for LocalX: integer := 0 to Width - 1 do
        begin
          const X: integer := OriginX + LocalX;
          const Y: integer := OriginY + LocalY;
          const Field := try ProjectInteriorField(State, Map, VisibleFields, X, Y);
          Row := Row + Field.Code;
          KnowledgeRow := KnowledgeRow + Field.Knowledge;
        end;
      end for;

      Rows.PushInPlace(Row);
      KnowledgeRows.PushInPlace(KnowledgeRow);
    end;
  end for;

  return Ok(
    Protocol.ExplorationMapState(
      View := if State.Area = Coordinates.AreaKind.Settlement then Protocol.ViewKind.Map
        else Protocol.ViewKind.FirstPerson
        end if,
      LabelText := Map.DisplayName,
      OriginX := OriginX,
      OriginY := OriginY,
      Width := Width,
      Height := Height,
      Rows := Rows,
      KnowledgeRows := KnowledgeRows,
      PlayerWorldX := Player.X,
      PlayerWorldY := Player.Y,
      PlayerInWindow := PlayerInWindow(
        Player.X,
        Player.Y,
        OriginX,
        OriginY,
        Width,
        Height
      )
    )
  );
end function;

// Projects the current area; Report carries the messages and events of the turn that produced State.
public function ProjectSession(
  World: WorldUnit.WorldSession;
  View: GameState.AreaView;
  State: GameState.GameState;
  Viewport: SessionUnit.ViewportSize;
  Report: TurnReport
): result of (SessionProjection, string);
begin
  const Valid: GameState.GameState := try GameState.ValidateGameState(View, State);
  if State.Area = Coordinates.AreaKind.Settlement then
    if (Viewport.Width < 1) or (Viewport.Height < 1) then
      return Error('viewport dimensions must be positive');
    end if;
    const Map := try GameState.CurrentInterior(View, State);
    const Position := try GameState.SettlementPlayerPosition(State);
    const Width := Math.Min(Viewport.Width, Map.Width);
    const Height := Math.Min(Viewport.Height, Map.Height);
    const OriginX := Math.Clamp(Position.X - Width div 2, 0, Map.Width - Width);
    const OriginY := Math.Clamp(Position.Y - Height div 2, 0, Map.Height - Height);
    const Window := try ProjectExplorationMap(State, View, OriginX, OriginY, Width, Height);
    return Ok(
      SessionProjection(
        World := World, State := Protocol.VisibleState.MapState(
          Protocol.MapVisibleState(
            Coins := State.Coins,
            Title := Map.DisplayName, Status := Interaction.MapInteractionHint(View, State),
            OriginX := OriginX, OriginY := OriginY, Width := Width, Height := Height,
            Rows := Window.Rows, KnowledgeRows := Window.KnowledgeRows,
            PlayerX := Position.X - OriginX, PlayerY := Position.Y - OriginY, WorldX := Position.X,
            WorldY := Position.Y,
            Inventory := ProjectInventory(State), Health := State.Health,
            MaxHealth := Equipment.DeriveCharacterValues(State).MaximumHealth,
            Character := ProjectCharacter(State), Journal := QuestJournal.Lines(State)
          )
        )
      )
    );
  end if;

  if State.Area = Coordinates.AreaKind.Dungeon then
    begin
      const Map: InteriorUnit.InteriorMap := try GameState.CurrentInterior(View, State);
      const Pose: Coordinates.FirstPersonPose := try GameState.FirstPersonPlayerPose(State);
      // Keep the protocol's required status text neutral when no action is available.
      var Status: string := 'Nothing in reach';
      const Hint: string := Interaction.InteractionHint(State);
      if Hint <> '' then
        begin
          Status := Hint;
        end;
      end if;
      const TransitionHint: string := Interaction.TransitionHint(Map, Pose.Position);
      if TransitionHint <> '' then
        begin
          Status := TransitionHint;
        end;
      end if;
      const Masked: MaskedRows := try MaskInteriorRows(State, Map, Pose);
      const FirstPersonValue: Protocol.FirstPersonVisibleState := Protocol.FirstPersonVisibleState(
        Coins := State.Coins,
        Title := Interaction.LevelTitle(Map),
        Status := Status,
        Level := Map.Level,
        Depth := Map.Depth,
        Width := Map.Width,
        Height := Map.Height,
        Rows := Masked.Rows,
        KnowledgeRows := Masked.KnowledgeRows,
        PlayerX := Pose.Position.X,
        PlayerY := Pose.Position.Y,
        Facing := Mapping.ProtocolFacing(Pose.Facing),
        Inventory := ProjectInventory(State),
        Health := State.Health,
        MaxHealth := Equipment.DeriveCharacterValues(State).MaximumHealth,
        Character := ProjectCharacter(State),
        CombatLog := Report.Log,
        CombatEvents := Report.Events.Map(Mapping.ProtocolCombatEvent),
        Journal := QuestJournal.Lines(State)
      );
      return Ok(
        SessionProjection(
          World := World,
          State := Protocol.VisibleState.FirstPersonState(FirstPersonValue)
        )
      );
    end;
  end if;
  const Loaded: WorldUnit.WindowLoad := try WorldUnit.LoadVisibleWindow(
    World,
    State,
    Viewport.Width,
    Viewport.Height
  );
  const OutdoorPosition: Coordinates.WorldPosition := try GameState.OutdoorPlayerPosition(State);
  const Masked: MaskedRows := MaskOutdoorRows(
    State,
    Loaded.Window.Rows,
    Loaded.Window.OriginX,
    Loaded.Window.OriginY,
    Loaded.Window.Width,
    Loaded.Window.Height,
    OutdoorPosition
  );
  const MapValue: Protocol.MapVisibleState := Protocol.MapVisibleState(
    Coins := State.Coins,
    Title := View.Metadata.OutdoorAreaLabel, Status := Interaction.MapInteractionHint(View, State),
    OriginX := Loaded.Window.OriginX,
    OriginY := Loaded.Window.OriginY,
    Width := Loaded.Window.Width,
    Height := Loaded.Window.Height,
    Rows := Masked.Rows,
    KnowledgeRows := Masked.KnowledgeRows,
    PlayerX := Loaded.Window.PlayerX,
    PlayerY := Loaded.Window.PlayerY,
    WorldX := OutdoorPosition.X,
    WorldY := OutdoorPosition.Y,
    Inventory := ProjectInventory(State),
    Health := State.Health,
    MaxHealth := Equipment.DeriveCharacterValues(State).MaximumHealth,
    Character := ProjectCharacter(State), Journal := QuestJournal.Lines(State)
  );
  return Ok(
    SessionProjection(World := Loaded.World, State := Protocol.VisibleState.MapState(MapValue))
  );
end function;
end unit;
