// Client-safe projections of the authoritative state: masked rows, inventory, character, and map windows.
unit Dungeon.Server.Projection;

uses
  Dungeon.Server.Mapping, Dungeon.Server.Session, Dungeon.Combat, Dungeon.Coordinates,
  Dungeon.Equipment, Dungeon.Exploration, Dungeon.Exploration.Sight, Dungeon.Exploration.Model,
  Dungeon.GameState, Dungeon.Interaction, Dungeon.Interior, Dungeon.Items, Dungeon.Protocol,
  Dungeon.Areas.Identities, Dungeon.Terrain, Dungeon.Terrain.Chunks, Dungeon.World;

// Visible state of one projection and the world session whose chunk cache it may have grown.
public type SessionProjection = record
  public World: WorldSession;
  public State: VisibleState;
end record;

// Visible rows with Fog of War applied and their knowledge codes.
public type MaskedRows = record
  public Rows: array of string;
  public KnowledgeRows: array of string;
end record;

// Messages and structured events of the turn that produced a projected state.
public type TurnReport = record
  public Log: array of string;
  public Events: array of CombatEvent;
end record;

function ProjectInventory(State: GameState): array of VisibleInventoryItem;
begin
  var Values: array of VisibleInventoryItem := [];
  for Item: GameItem in InventoryItems(State) do
    begin
      var Slot: VisibleItemSlot := VisibleItemSlot.NoSlot;
      case ItemSlot(Item.Kind) of
        when Some(const Fitting):
          begin
            Slot := ProtocolSlot(Fitting);
          end;
        when None:
          begin
            null;
          end;
      end case;
      var Equipped: boolean := false;
      if Item.Location is ItemLocation.EquippedByPlayer(const Worn) then
        begin
          Equipped := true;
        end;
      else
        begin
          null;
        end;
      end if;

      Values.Push(VisibleInventoryItem(Id := Item.Id, Name := ItemDisplayName(Item.Kind), Slot := Slot, Equipped := Equipped));
    end;
  end for;

  return Values;
end function;

function ProjectCharacter(State: GameState): array of VisibleCharacterValue;
begin
  var Values: array of VisibleCharacterValue := [];
  for Line: CharacterValueLine in CharacterValueLines(State) do
    begin
      Values.Push(VisibleCharacterValue(Label := Line.Label, Value := Line.Value, Source := Line.Source));
    end;
  end for;

  return Values;
end function;

// Returns the report of a projection that no turn produced.
public function NoTurnReport(): TurnReport;
begin
  return TurnReport(Log := [], Events := []);
end function;

function InteriorRows(State: GameState; Map: InteriorMap): result of (array of string, string);
begin
  var Rows: array of string := [];
  for Y: integer := 0 to Map.Height - 1 do
    begin
      var Row: string := '';
      for X: integer := 0 to Map.Width - 1 do
        begin
          Row := Row +
                 (try InteriorVisibleCodeForState(Map, State, InteriorPosition(X := X, Y := Y)));
        end;
      end for;

      Rows.Push(Row);
    end;
  end for;

  return Ok(Rows);
end function;

function KnowledgeCode(Value: FieldKnowledge): string;
begin
  case Value of
    when FieldKnowledge.Undiscovered:
      begin
        return KnowledgeUndiscoveredCode;
      end;
    when FieldKnowledge.Remembered:
      begin
        return KnowledgeRememberedCode;
      end;
    when FieldKnowledge.Visible:
      begin
        return KnowledgeVisibleCode;
      end;
  end case;
end function;

function MaskOutdoorRows(
  State: GameState;
  TerrainRows: array of string;
  OriginX: integer;
  OriginY: integer;
  Width: integer;
  Height: integer;
  Player: WorldPosition
): MaskedRows;
begin
  const VisibleFields: array of boolean := OutdoorVisibility(OriginX, OriginY, Width, Height, Player);
  var Rows: array of string := [];
  var KnowledgeRows: array of string := [];
  for Y: integer := 0 to Height - 1 do
    begin
      var Row: string := '';
      var KnowledgeRow: string := '';
      for X: integer := 0 to Width - 1 do
        begin
          const WorldX: integer := OriginX + X;
          const WorldY: integer := OriginY + Y;
          const Knowledge: FieldKnowledge := ClassifyField(OutdoorIsDiscovered(State.Exploration, WorldX, WorldY), VisibleFields[(Y * Width) +
                                                                                                                                 X]);
          if Knowledge = FieldKnowledge.Undiscovered then
            begin
              Row := Row + UnknownFieldCode;
            end;
          else
            begin
              Row := Row + TerrainRows[Y].CharAt(X);
            end;
          end if;

          KnowledgeRow := KnowledgeRow + KnowledgeCode(Knowledge);
        end;
      end for;

      Rows.Push(Row);
      KnowledgeRows.Push(KnowledgeRow);
    end;
  end for;

  return MaskedRows(Rows := Rows, KnowledgeRows := KnowledgeRows);
end function;

function MaskInteriorRows(State: GameState; Map: InteriorMap; Pose: FirstPersonPose): result of (MaskedRows, string);
begin
  const TerrainRows: array of string := try InteriorRows(State, Map);
  const VisibleFields: array of boolean := InteriorVisibility(Map, Pose);
  var Rows: array of string := [];
  var KnowledgeRows: array of string := [];
  for Y: integer := 0 to Map.Height - 1 do
    begin
      var Row: string := '';
      var KnowledgeRow: string := '';
      for X: integer := 0 to Map.Width - 1 do
        begin
          const Knowledge: FieldKnowledge := ClassifyField(InteriorIsDiscovered(State.Exploration, State.AreaId, Map.Width, X, Y), VisibleFields[(Y * Map.Width) +
                                                                                                                                                 X]);
          if Knowledge = FieldKnowledge.Undiscovered then
            begin
              Row := Row + UnknownFieldCode;
            end;
          else
            begin
              var Code: string := TerrainRows[Y].CharAt(X);
              if (Knowledge = FieldKnowledge.Remembered) and
                 ((Code = InteriorItemCode) or (Code = InteriorHostileCode)) then
                begin
                  Code := try InteriorVisibleCode(Map, InteriorPosition(X := X, Y := Y));
                end;
              end if;

              Row := Row + Code;
            end;
          end if;

          KnowledgeRow := KnowledgeRow + KnowledgeCode(Knowledge);
        end;
      end for;

      Rows.Push(Row);
      KnowledgeRows.Push(KnowledgeRow);
    end;
  end for;

  return Ok(MaskedRows(Rows := Rows, KnowledgeRows := KnowledgeRows));
end function;

function PlayerInWindow(
  PlayerX: integer;
  PlayerY: integer;
  OriginX: integer;
  OriginY: integer;
  Width: integer;
  Height: integer
): boolean;
begin
  return (((PlayerX >= OriginX) and (PlayerX < OriginX + Width)) and (PlayerY >= OriginY)) and
         (PlayerY < OriginY + Height);
end function;

// Projects one exploration-map window of the current area with Fog of War.
public function ProjectExplorationMap(
  State: GameState;
  View: AreaView;
  OriginX: integer;
  OriginY: integer;
  Width: integer;
  Height: integer
): result of (ExplorationMapState, string);
begin
  const Valid: GameState := try ValidateGameState(View, State);
  const Metadata: WorldMetadata := View.Metadata;
  var Rows: array of string := [];
  var KnowledgeRows: array of string := [];
  if State.Area = AreaKind.OutdoorRegion then
    begin
      const Player: WorldPosition := try OutdoorPlayerPosition(State);
      const VisibleFields: array of boolean := OutdoorVisibility(OriginX, OriginY, Width, Height, Player);
      for Y: integer := 0 to Height - 1 do
        begin
          var Row: string := '';
          var KnowledgeRow: string := '';
          for X: integer := 0 to Width - 1 do
            begin
              const WorldX: integer := OriginX + X;
              const WorldY: integer := OriginY + Y;
              const Knowledge: FieldKnowledge := ClassifyField(OutdoorIsDiscovered(State.Exploration, WorldX, WorldY), VisibleFields[(Y * Width) +
                                                                                                                                     X]);
              if Knowledge = FieldKnowledge.Undiscovered then
                begin
                  Row := Row + UnknownFieldCode;
                end;
              else
                begin
                  Row := Row + VisibleCellCode(GenerateWorldCell(Metadata, WorldX, WorldY));
                end;
              end if;

              KnowledgeRow := KnowledgeRow + KnowledgeCode(Knowledge);
            end;
          end for;

          Rows.Push(Row);
          KnowledgeRows.Push(KnowledgeRow);
        end;
      end for;

      return Ok(ExplorationMapState(View := ViewKind.Map, LabelText := Metadata.OutdoorAreaLabel, OriginX := OriginX, OriginY := OriginY, Width := Width, Height := Height, Rows := Rows, KnowledgeRows := KnowledgeRows, PlayerWorldX := Player.X, PlayerWorldY := Player.Y, PlayerInWindow := PlayerInWindow(Player.X, Player.Y, OriginX, OriginY, Width, Height)));
    end;
  end if;
  const Map: InteriorMap := try CurrentInterior(View, State);
  const Pose: FirstPersonPose := try FirstPersonPlayerPose(State);
  const VisibleFields: array of boolean := InteriorVisibility(Map, Pose);
  for LocalY: integer := 0 to Height - 1 do
    begin
      var Row: string := '';
      var KnowledgeRow: string := '';
      for LocalX: integer := 0 to Width - 1 do
        begin
          const X: integer := OriginX + LocalX;
          const Y: integer := OriginY + LocalY;
          var Knowledge: FieldKnowledge := FieldKnowledge.Undiscovered;
          if (((X >= 0) and (X < Map.Width)) and (Y >= 0)) and (Y < Map.Height) then
            begin
              Knowledge := ClassifyField(InteriorIsDiscovered(State.Exploration, State.AreaId, Map.Width, X, Y), VisibleFields[(Y * Map.Width) +
                                                                                                                               X]);
            end;
          end if;

          if Knowledge = FieldKnowledge.Undiscovered then
            begin
              Row := Row + UnknownFieldCode;
            end;
          else
            begin
              var Code: string := try InteriorVisibleCodeForState(Map, State, InteriorPosition(X := X, Y := Y));
              if (Knowledge = FieldKnowledge.Remembered) and
                 ((Code = InteriorItemCode) or (Code = InteriorHostileCode)) then
                begin
                  Code := try InteriorVisibleCode(Map, InteriorPosition(X := X, Y := Y));
                end;
              end if;

              Row := Row + Code;
            end;
          end if;

          KnowledgeRow := KnowledgeRow + KnowledgeCode(Knowledge);
        end;
      end for;

      Rows.Push(Row);
      KnowledgeRows.Push(KnowledgeRow);
    end;
  end for;

  return Ok(ExplorationMapState(View := ViewKind.FirstPerson, LabelText := GeneratedDungeonLabel, OriginX := OriginX, OriginY := OriginY, Width := Width, Height := Height, Rows := Rows, KnowledgeRows := KnowledgeRows, PlayerWorldX := Pose.Position.X, PlayerWorldY := Pose.Position.Y, PlayerInWindow := PlayerInWindow(Pose.Position.X, Pose.Position.Y, OriginX, OriginY, Width, Height)));
end function;

// Projects the current area; Report carries the messages and events of the turn that produced State.
public function ProjectSession(
  World: WorldSession;
  View: AreaView;
  State: GameState;
  Viewport: ViewportSize;
  Report: TurnReport
): result of (SessionProjection, string);
begin
  const Valid: GameState := try ValidateGameState(View, State);
  if State.Area = AreaKind.Dungeon then
    begin
      const Map: InteriorMap := try CurrentInterior(View, State);
      const Pose: FirstPersonPose := try FirstPersonPlayerPose(State);
      // Keep the protocol's required status text neutral when no action is available.
      var Status: string := 'Nothing in reach';
      const Hint: string := InteractionHint(State);
      if Hint <> '' then
        begin
          Status := Hint;
        end;
      end if;

      if (Pose.Position.X = Map.Exit.X) and (Pose.Position.Y = Map.Exit.Y) then
        begin
          Status := 'Press Enter to return to the outdoor region.';
        end;
      end if;
      const Masked: MaskedRows := try MaskInteriorRows(State, Map, Pose);
      const FirstPersonValue: FirstPersonVisibleState := FirstPersonVisibleState(Title := GeneratedDungeonLabel, Status := Status, Width := Map.Width, Height := Map.Height, Rows := Masked.Rows, KnowledgeRows := Masked.KnowledgeRows, PlayerX := Pose.Position.X, PlayerY := Pose.Position.Y, Facing := ProtocolFacing(Pose.Facing), Inventory := ProjectInventory(State), Health := State.Health, MaxHealth := DeriveCharacterValues(State)
                                                                                                                                                                                                                                                                                                                                                                                                                     .MaximumHealth, Character := ProjectCharacter(State), CombatLog := Report.Log, CombatEvents := Report.Events.Map(ProtocolCombatEvent));
      return Ok(SessionProjection(World := World, State := VisibleState.FirstPersonState(FirstPersonValue)));
    end;
  end if;
  const Loaded: WindowLoad := try LoadVisibleWindow(World, State, Viewport.Width, Viewport.Height);
  const OutdoorPosition: WorldPosition := try OutdoorPlayerPosition(State);
  const Masked: MaskedRows := MaskOutdoorRows(State, Loaded.Window.Rows, Loaded.Window.OriginX, Loaded.Window.OriginY, Loaded.Window.Width, Loaded.Window.Height, OutdoorPosition);
  const MapValue: MapVisibleState := MapVisibleState(OriginX := Loaded.Window.OriginX, OriginY := Loaded.Window.OriginY, Width := Loaded.Window.Width, Height := Loaded.Window.Height, Rows := Masked.Rows, KnowledgeRows := Masked.KnowledgeRows, PlayerX := Loaded.Window.PlayerX, PlayerY := Loaded.Window.PlayerY, WorldX := OutdoorPosition.X, WorldY := OutdoorPosition.Y, Inventory := ProjectInventory(State), Health := State.Health, MaxHealth := DeriveCharacterValues(State)
                                                                                                                                                                                                                                                                                                                                                                                                                                                              .MaximumHealth, Character := ProjectCharacter(State));
  return Ok(SessionProjection(World := Loaded.World, State := VisibleState.MapState(MapValue)));
end function;
end unit;
