// Maps typed level and persistence failures to stable client rejection codes without host paths.
unit Dungeon.Server.Failures;

uses Dungeon.World.Interiors.Errors as Errors, Dungeon.World.Savegame.Errors as SavegameErrors;

// Stable rejection code and player-facing text; detailed reasons stay in the server log.
public type FailureRejection = record
  public Code: string;
  public Message: string;
end record;

function Rejection(Code: string; Message: string): FailureRejection;
begin
  return FailureRejection(Code := Code, Message := Message);
end function;

// Classifies a level failure: world data, storage, or generation, naming the world and area.
public function LevelRejection(WorldId: string; Failure: Errors.LevelFailure): FailureRejection;
begin
  case Failure of
    when Errors.LevelFailure.Missing(const AreaId):
      begin
        return Rejection(
          'world_data_error', ((('The dungeon level ' + AreaId) + ' of world ') + WorldId) +
          ' is missing.'
        );
      end;
    when Errors.LevelFailure.Invalid(const AreaId, const Reason):
      begin
        return Rejection(
          'world_data_error', ((('The dungeon level ' + AreaId) + ' of world ') + WorldId) +
          ' is invalid.'
        );
      end;
    when Errors.LevelFailure.Io(const Reason):
      begin
        return Rejection(
          'storage_error',
          ('Dungeon level storage of world ' + WorldId) + ' failed.'
        );
      end;
    when Errors.LevelFailure.Generation(const AreaId, const Reason):
      begin
        return Rejection(
          'generation_error', ((('The dungeon ' + AreaId) + ' of world ') + WorldId) +
          ' could not be generated.'
        );
      end;
  end case;
end function;

// Returns the detailed server-side reason of a level failure for logging.
public function LevelFailureReason(Failure: Errors.LevelFailure): string;
begin
  case Failure of
    when Errors.LevelFailure.Missing(const AreaId):
      begin
        return 'level missing: ' + AreaId;
      end;
    when Errors.LevelFailure.Invalid(const AreaId, const Reason):
      begin
        return (('level invalid: ' + AreaId) + ': ') + Reason;
      end;
    when Errors.LevelFailure.Io(const Reason):
      begin
        return 'level storage failed: ' + Reason;
      end;
    when Errors.LevelFailure.Generation(const AreaId, const Reason):
      begin
        return (('level generation failed: ' + AreaId) + ': ') + Reason;
      end;
  end case;
end function;

// Classifies a persistence failure; InvalidState uses the operation's existing code.
public function PersistenceRejection(WorldId: string; InvalidCode: string; Failure: SavegameErrors.PersistenceFailure): FailureRejection;
begin
  case Failure of
    when SavegameErrors.PersistenceFailure.InvalidState(const Reason):
      begin
        return Rejection(InvalidCode, Reason);
      end;
    when SavegameErrors.PersistenceFailure.Level(const LevelValue):
      begin
        return LevelRejection(WorldId, LevelValue);
      end;
    when SavegameErrors.PersistenceFailure.Io(const Reason):
      begin
        return Rejection('storage_error', ('Saved game storage of world ' + WorldId) + ' failed.');
      end;
  end case;
end function;

// Returns the detailed server-side reason of a persistence failure for logging.
public function PersistenceFailureReason(Failure: SavegameErrors.PersistenceFailure): string;
begin
  case Failure of
    when SavegameErrors.PersistenceFailure.InvalidState(const Reason):
      begin
        return 'invalid state: ' + Reason;
      end;
    when SavegameErrors.PersistenceFailure.Level(const LevelValue):
      begin
        return LevelFailureReason(LevelValue);
      end;
    when SavegameErrors.PersistenceFailure.Io(const Reason):
      begin
        return 'savegame storage failed: ' + Reason;
      end;
  end case;
end function;
end unit;
