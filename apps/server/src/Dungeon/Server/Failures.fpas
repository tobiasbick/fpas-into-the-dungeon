// Maps typed level and persistence failures to stable client rejection codes without host paths.
unit Dungeon.Server.Failures;

uses Dungeon.World.Interiors.Errors, Dungeon.World.Savegame.Errors;

public type
  // Stable rejection code and player-facing text; detailed reasons stay in the server log.
  FailureRejection = record
    public Code: string;
    public Message: string;
  end;

function Rejection(Code: string; Message: string): FailureRejection;
begin
  return record
    Code := Code;
    Message := Message;
  end
end;

// Classifies a level failure: world data, storage, or generation, naming the world and area.
public function LevelRejection(WorldId: string; Failure: LevelFailure): FailureRejection;
begin
  case Failure of
    LevelFailure.Missing(AreaId):
    begin
      return Rejection('world_data_error', ((('The dungeon level ' + AreaId) + ' of world ') + WorldId) +
                                           ' is missing.')
    end;
    LevelFailure.Invalid(AreaId, Reason):
    begin
      return Rejection('world_data_error', ((('The dungeon level ' + AreaId) + ' of world ') + WorldId) +
                                           ' is invalid.')
    end;
    LevelFailure.Io(Reason):
    begin
      return Rejection('storage_error', ('Dungeon level storage of world ' + WorldId) + ' failed.')
    end;
    LevelFailure.Generation(AreaId, Reason):
    begin
      return Rejection('generation_error', ((('The dungeon ' + AreaId) + ' of world ') + WorldId) +
                                           ' could not be generated.')
    end
  end
end;

// Returns the detailed server-side reason of a level failure for logging.
public function LevelFailureReason(Failure: LevelFailure): string;
begin
  case Failure of
    LevelFailure.Missing(AreaId):
    begin
      return 'level missing: ' + AreaId
    end;
    LevelFailure.Invalid(AreaId, Reason):
    begin
      return (('level invalid: ' + AreaId) + ': ') + Reason
    end;
    LevelFailure.Io(Reason):
    begin
      return 'level storage failed: ' + Reason
    end;
    LevelFailure.Generation(AreaId, Reason):
    begin
      return (('level generation failed: ' + AreaId) + ': ') + Reason
    end
  end
end;

// Classifies a persistence failure; InvalidState uses the operation's existing code.
public function PersistenceRejection(WorldId: string; InvalidCode: string; Failure: PersistenceFailure): FailureRejection;
begin
  case Failure of
    PersistenceFailure.InvalidState(Reason):
    begin
      return Rejection(InvalidCode, Reason)
    end;
    PersistenceFailure.Level(LevelValue):
    begin
      return LevelRejection(WorldId, LevelValue)
    end;
    PersistenceFailure.Io(Reason):
    begin
      return Rejection('storage_error', ('Saved game storage of world ' + WorldId) + ' failed.')
    end
  end
end;

// Returns the detailed server-side reason of a persistence failure for logging.
public function PersistenceFailureReason(Failure: PersistenceFailure): string;
begin
  case Failure of
    PersistenceFailure.InvalidState(Reason):
    begin
      return 'invalid state: ' + Reason
    end;
    PersistenceFailure.Level(LevelValue):
    begin
      return LevelFailureReason(LevelValue)
    end;
    PersistenceFailure.Io(Reason):
    begin
      return 'savegame storage failed: ' + Reason
    end
  end
end;
