// Maps typed area-data and persistence failures to stable client rejection codes without host paths.
unit Dungeon.Server.Failures;

uses Dungeon.World.Areas.Errors as Errors, Dungeon.World.Savegame.Errors as SavegameErrors;

// Stable rejection code and player-facing text; detailed reasons stay in the server log.
public type FailureRejection = record
  public Code: string;
  public Message: string;
end record;

function Rejection(Code: string; Message: string): FailureRejection;
begin
  return FailureRejection(Code := Code, Message := Message);
end function;

// Classifies an immutable area-data failure: world data, storage, or generation, naming the world and area.
public function AreaRejection(WorldId: string; Failure: Errors.AreaFailure): FailureRejection;
begin
  case Failure of
    when Errors.AreaFailure.Missing(const AreaId):
      begin
        return Rejection(
          'world_data_error',
          (
            (
              (
                (
                  if ':settlement:' in AreaId then 'The settlement '
                    else 'The dungeon level '
                    end if
                ) + AreaId
              ) + ' of world '
            ) + WorldId
          ) +
          ' is missing.'
        );
      end;
    when Errors.AreaFailure.Invalid(const AreaId, const Reason):
      begin
        return Rejection(
          'world_data_error',
          (
            (
              (
                (
                  if ':settlement:' in AreaId then 'The settlement '
                    else 'The dungeon level '
                    end if
                ) + AreaId
              ) + ' of world '
            ) + WorldId
          ) +
          ' is invalid.'
        );
      end;
    when Errors.AreaFailure.Io(const Reason):
      begin
        return Rejection(
          'storage_error',
          ('Area storage of world ' + WorldId) + ' failed.'
        );
      end;
    when Errors.AreaFailure.Generation(const AreaId, const Reason):
      begin
        return Rejection(
          'generation_error',
          (
            (
              (
                (if ':settlement:' in AreaId then 'The settlement ' else 'The dungeon ' end if) +
                AreaId
              ) + ' of world '
            ) + WorldId
          ) +
          ' could not be generated.'
        );
      end;
  end case;
end function;

// Returns the detailed server-side reason of an area-data failure for logging.
public function AreaFailureReason(Failure: Errors.AreaFailure): string;
begin
  case Failure of
    when Errors.AreaFailure.Missing(const AreaId):
      begin
        return 'area missing: ' + AreaId;
      end;
    when Errors.AreaFailure.Invalid(const AreaId, const Reason):
      begin
        return (('area invalid: ' + AreaId) + ': ') + Reason;
      end;
    when Errors.AreaFailure.Io(const Reason):
      begin
        return 'area storage failed: ' + Reason;
      end;
    when Errors.AreaFailure.Generation(const AreaId, const Reason):
      begin
        return (('area generation failed: ' + AreaId) + ': ') + Reason;
      end;
  end case;
end function;

// Classifies a persistence failure; InvalidState uses the operation's existing code.
public function PersistenceRejection(WorldId: string; InvalidCode: string; Failure: SavegameErrors.PersistenceFailure): FailureRejection;
begin
  case Failure of
    when SavegameErrors.PersistenceFailure.InvalidState(const Reason):
      begin
        return Rejection(InvalidCode, Reason);
      end;
    when SavegameErrors.PersistenceFailure.Area(const LevelValue):
      begin
        return AreaRejection(WorldId, LevelValue);
      end;
    when SavegameErrors.PersistenceFailure.Io(const Reason):
      begin
        return Rejection('storage_error', ('Saved game storage of world ' + WorldId) + ' failed.');
      end;
  end case;
end function;

// Returns the detailed server-side reason of a persistence failure for logging.
public function PersistenceFailureReason(Failure: SavegameErrors.PersistenceFailure): string;
begin
  case Failure of
    when SavegameErrors.PersistenceFailure.InvalidState(const Reason):
      begin
        return 'invalid state: ' + Reason;
      end;
    when SavegameErrors.PersistenceFailure.Area(const LevelValue):
      begin
        return AreaFailureReason(LevelValue);
      end;
    when SavegameErrors.PersistenceFailure.Io(const Reason):
      begin
        return 'savegame storage failed: ' + Reason;
      end;
  end case;
end function;
end unit;
