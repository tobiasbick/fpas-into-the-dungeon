// Startup guidance shared by headless and console listeners, without launching an agent.
unit Dungeon.Server.Gamemaster.Status;

uses
  Dungeon.RuntimeData.Gamemaster as Settings, Dungeon.Server.Config as Config,
  Dungeon.Server.Logging as Logging;

// One warning per runtime-backed unconfigured startup; listener admission remains independent.
public procedure PublishStartup(Value: Config.ServerConfig);
begin
  case Value.Gamemaster of
    when None:
      null;
    when Some(const Selection):
      if Selection.Connection = Settings.ConnectionKind.Unconfigured then
        Logging.LogServer(
          Value.Logs, 'warning',
          'Gamemaster is not configured. Configure it in the server console: ' +
          'fpas run apps/server/server.fpasprj -- --console. Reuse --data-dir PATH for this server if set.'
        );
      end if;
  end case;
end procedure;
end unit;
