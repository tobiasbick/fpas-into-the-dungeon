// Immutable requests and results crossing the server console's background boundary.
unit Dungeon.Server.Gamemaster.Model;

uses Dungeon.RuntimeData.Gamemaster as Settings;

// Agent-provided display label and exact opaque model ID.
public type ModelChoice = record
  public Id: string;
  public LabelText: string;
end record;

// One explicit operation; an empty model discovers only and never sends a prompt.
public type Request = record
  public Revision: integer;
  public Selection: Settings.Selection;
  public Probe: boolean := false;
end record;

// Readiness is valid only for the exact acknowledged selection and this server lifetime.
public type Catalog = record
  public Models: array of ModelChoice;
  public Acknowledged: boolean;
  public Probed: boolean := false;
  public ElapsedMillis: integer := 0;
end record;

// Revision and selection prevent late operations from publishing into a changed draft.
public type Completion = record
  public Revision: integer;
  public Selection: Settings.Selection;
  public Outcome: result of (Catalog, string);
end record;
end unit;
