// Sends projections and rejections and commits accepted states and turns.
unit Dungeon.Server.Replies;

uses
  Dungeon.Server.Projection, Dungeon.Server.Session, Dungeon.Server.Logging, Dungeon.Combat,
  Dungeon.Exploration, Dungeon.GameState, Dungeon.Movement, Dungeon.Protocol,
  Dungeon.Protocol.ServerMessages, Dungeon.Protocol.Transport, Dungeon.World, Std.Net, Std.Tasks;

// Encodes and sends one server message.
public function SendMessage(ConnectionValue: Connection; Message: ServerMessage; Token: CancellationToken): result of (boolean, string);
begin
  return WriteLine(ConnectionValue, EncodeServer(Message), Token);
end function;

// Projects the state, sends it, and returns the world session with its possibly grown cache.
public function SendProjection(
  ConnectionValue: Connection;
  World: WorldSession;
  View: AreaView;
  State: GameState;
  Viewport: ViewportSize;
  Report: TurnReport;
  Token: CancellationToken
): result of (WorldSession, string);
begin
  const Projection: SessionProjection := try ProjectSession(World, View, State, Viewport, Report);
  const Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.State(Projection.State), Token);
  return Ok(Projection.World);
end function;

// Sends a rejection with a stable code and a player-facing message.
public function Reject(
  ConnectionValue: Connection;
  Code: string;
  Message: string;
  Token: CancellationToken
): result of (boolean, string);
begin
  return SendMessage(ConnectionValue, ServerMessage.Rejected(Code, Message), Token);
end function;

// Reveals the accepted state, makes it current, and sends its projection with the turn's report.
function CommitTurn(
  Session: ServerSession;
  Changed: GameState;
  Report: TurnReport;
  ConnectionValue: Connection;
  Token: CancellationToken
): result of (ServerSession, string);
begin
  const View: AreaView := try SessionAreaView(Session, Changed);
  const Revealed: GameState := try RevealCurrentArea(View, Changed);
  var Next: ServerSession := Session;
  Next.State := Some(Revealed);
  Next.Dirty := true;
  Next.World := try SendProjection(ConnectionValue, Session.World, View, Revealed, Session.Viewport, Report, Token);
  return Ok(Next);
end function;

// Reveals the accepted state, makes it current, and sends its projection without combat messages.
public function CommitState(
  Session: ServerSession;
  Changed: GameState;
  ConnectionValue: Connection;
  Token: CancellationToken
): result of (ServerSession, string);
begin
  return CommitTurn(Session, Changed, NoTurnReport(), ConnectionValue, Token);
end function;

// Revealed candidate state and its projection, both built before anything is sent.
type PreparedTransition = record
  State: GameState;
  Projection: SessionProjection;
end record;

function PrepareTransition(Session: ServerSession; Transition: AreaTransition): result of (PreparedTransition, string);
begin
  const Revealed: GameState := try RevealCurrentArea(Transition.View, Transition.State);
  const Valid: GameState := try ValidateGameState(Transition.View, Revealed);
  return Ok(PreparedTransition(State := Valid, Projection := try ProjectSession(Session.World, Transition.View, Valid, Session.Viewport, NoTurnReport())));
end function;

// Installs an applied area transition: reveals and validates the candidate and builds its
// projection with the candidate's own map before anything is sent. A failure before sending
// rejects the intention and returns the original session unchanged; state and map change together.
public function CommitTransition(
  Session: ServerSession;
  Transition: AreaTransition;
  ConnectionValue: Connection;
  Token: CancellationToken
): result of (ServerSession, string);
begin
  case PrepareTransition(Session, Transition) of
    when Ok(const Prepared):
      begin
        const Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.State(Prepared.Projection.State), Token);
        var Next: ServerSession := Session;
        Next.State := Some(Prepared.State);
        Next.Dirty := true;
        Next.Interior := Transition.View.Interior;
        Next.World := Prepared.Projection.World;
        return Ok(Next);
      end;
    when Error(const Reason):
      begin
        const Sent: boolean := try Reject(ConnectionValue, 'interaction_rejected', Reason, Token);
        return Ok(Session);
      end;
  end case;
end function;

// Joins one turn's messages into the bounded defeat summary.
function DefeatSummary(Log: array of string): string;
begin
  var Summary: string := '';
  for Entry: string in Log do
    begin
      if Summary = '' then
        begin
          Summary := Entry;
        end;
      else
        begin
          Summary := (Summary + ' ') + Entry;
        end;
      end if;
    end;
  end for;

  if Summary = '' then
    begin
      Summary := 'You have fallen.';
    end;
  end if;

  if Summary.Length() > MaximumCombatLogTextLength then
    begin
      Summary := Summary.Slice(Summary.Length() - MaximumCombatLogTextLength, MaximumCombatLogTextLength);
    end;
  end if;

  return Summary;
end function;

// Resolves one time-consuming intention; defeat ends the game session but keeps the connection.
public function PlayTurn(
  Session: ServerSession;
  Action: TurnAction;
  RejectionCode: string;
  ConnectionValue: Connection;
  Token: CancellationToken;
  Logs: option of channel of ServerLogEvent
): result of (ServerSession, string);
begin
  const State: GameState := try RequireActiveState(Session.State);
  case ResolveTurn(try SessionAreaView(Session, State), State, Action) of
    when Ok(const Outcome):
      begin
        case Outcome of
          when TurnOutcome.Continued(const Changed, const Log, const Events):
            begin
              return CommitTurn(Session, Changed, TurnReport(Log := Log, Events := Events), ConnectionValue, Token);
            end;
          when TurnOutcome.Defeated(const Log):
            begin
              const Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.Defeated(DefeatSummary(Log)), Token);
              var Ended: ServerSession := Session;
              Ended.State := None;
              Ended.Dirty := false;
              Ended.Interior := None;
              return Ok(Ended);
            end;
        end case;
      end;
    when Error(const Reason):
      begin
        LogServer(Logs, 'rejected', (RejectionCode + ': ') + Reason);
        const Sent: boolean := try Reject(ConnectionValue, RejectionCode, Reason, Token);
        return Ok(Session);
      end;
  end case;
end function;
end unit;
