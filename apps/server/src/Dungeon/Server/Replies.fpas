// Sends projections and rejections and commits accepted states and turns.
unit Dungeon.Server.Replies;

uses Dungeon.Server.Mapping as Mapping, Dungeon.Server.Projection as ProjectionUnit, Dungeon.Server.Session as SessionUnit, Dungeon.Server.Logging as Logging, Dungeon.Combat as Combat, Dungeon.Exploration as Exploration, Dungeon.GameState as GameState, Dungeon.Movement as Movement, Dungeon.Protocol as Protocol, Dungeon.Protocol.ServerMessages as ServerMessages, Dungeon.Protocol.Transport as Transport, Std.Net as Net, Std.Net.Utf8 as Utf8, Std.Tasks as Tasks;

// Encodes a complete response and checks its UTF-8 wire size before attempting any write.
public function EncodeMessage(Message: Protocol.ServerMessage): result of (string, string);
begin
  const Line := ServerMessages.EncodeServer(Message);
  if Utf8.Encode(Line).Length() > Protocol.MaximumLineBytes then
    return Error(Transport.LineTooLongError);
  end if;

  return Ok(Line);
end function;

// Encodes and sends one bounded server message; write failures remain fatal to its caller.
public function SendMessage(ConnectionValue: Net.Connection; Message: Protocol.ServerMessage; Token: Tasks.CancellationToken): result of (boolean, string);
begin
  return Transport.WriteLine(ConnectionValue, try EncodeMessage(Message), Token);
end function;

// Sends a rejection with a stable code and a player-facing message.
public function Reject(
  ConnectionValue: Net.Connection;
  Code: string;
  Message: string;
  Token: Tasks.CancellationToken
): result of (boolean, string);
begin
  return SendMessage(ConnectionValue, Protocol.ServerMessage.Rejected(Code, Message), Token);
end function;

// Complete candidate and bounded wire response; neither is installed before sending.
type PreparedReply = record
  Session: SessionUnit.ServerSession;
  Line: string;
end record;

function PrepareProjection(
  Candidate: SessionUnit.ServerSession;
  Report: ProjectionUnit.TurnReport;
  DialogueResponse: boolean
): result of (PreparedReply, string);
begin
  const State := try SessionUnit.RequireActiveState(Candidate.State);
  const View := try SessionUnit.SessionAreaView(Candidate, State);
  const Projection := try ProjectionUnit.ProjectSession(
    Candidate.World, View, State, Candidate.Viewport, Report
  );
  var Message := Protocol.ServerMessage.State(Projection.State);
  if DialogueResponse then
    case Candidate.ActiveDialogue of
      when Some(const Frame):
        Message := Protocol.ServerMessage.Dialogue(
          Projection.State,
          Mapping.ProtocolDialogue(Frame), Candidate.Dirty
        );
      when None:
        Message := Protocol.ServerMessage.DialogueEnded(Projection.State, Candidate.Dirty);
    end case;
  end if;

  return Ok(
    PreparedReply(
      Session := Candidate with World := Projection.World; end with,
      Line := try EncodeMessage(Message)
    )
  );
end function;

function PrepareTurn(
  Candidate: SessionUnit.ServerSession;
  Report: ProjectionUnit.TurnReport
): result of (PreparedReply, string);
begin
  const State := try SessionUnit.RequireActiveState(Candidate.State);
  const View := try SessionUnit.SessionAreaView(Candidate, State);
  const Revealed := try Exploration.RevealCurrentArea(View, State);
  return PrepareProjection(
    Candidate with State := Some(Revealed); Dirty := true; end with, Report, false
  );
end function;

// Preparation failure rejects with the original session; actual write failure remains fatal.
function CommitPreparedReply(
  Session: SessionUnit.ServerSession;
  Preparation: result of (PreparedReply, string);
  RejectionCode: string;
  ConnectionValue: Net.Connection;
  Token: Tasks.CancellationToken;
  Logs: option of channel of Logging.ServerLogEvent
): result of (SessionUnit.ServerSession, string);
begin
  case Preparation of
    when Ok(const Prepared):
      const Sent := try Transport.WriteLine(ConnectionValue, Prepared.Line, Token);
      return Ok(Prepared.Session);
    when Error(const Reason):
      Logging.LogServer(Logs, 'rejected', RejectionCode + ': ' + Reason);
      const Sent := try Reject(ConnectionValue, RejectionCode, Reason, Token);
      return Ok(Session);
  end case;
end function;

// Reveals and projects a candidate without replacing Session until its response is sent.
// Rejecting preparation restores the entire original session, including its cache and save facts.
// Candidate is derived from Session for its current area and may carry an updated world cache.
public function CommitState(
  Session: SessionUnit.ServerSession;
  Candidate: SessionUnit.ServerSession;
  RejectionCode: string;
  ConnectionValue: Net.Connection;
  Token: Tasks.CancellationToken;
  Logs: option of channel of Logging.ServerLogEvent
): result of (SessionUnit.ServerSession, string);
begin
  return CommitPreparedReply(
    Session, PrepareTurn(Candidate, ProjectionUnit.NoTurnReport()), RejectionCode,
    ConnectionValue, Token, Logs
  );
end function;

// Sends an atomic dialogue projection before installing state/frame/dirty changes.
// Speaking does not move or reveal new fields; preparation failure preserves the complete original session.
public function CommitDialogue(
  Session: SessionUnit.ServerSession; Candidate: SessionUnit.ServerSession;
  ConnectionValue: Net.Connection; Token: Tasks.CancellationToken; Logs: option of channel of Logging.ServerLogEvent
): result of (SessionUnit.ServerSession, string);
begin
  return CommitPreparedReply(
    Session, PrepareProjection(Candidate, ProjectionUnit.NoTurnReport(), true),
    'dialogue_rejected', ConnectionValue, Token, Logs
  );
end function;

// Sends a read-only viewport candidate; failed preparation retains even the old viewport/cache.
// Successful resizing changes no game state or dirty/save facts; write errors remain fatal.
// Viewport must already be bounded by Session.ResolveViewport and the server policy.
public function ChangeViewport(
  Session: SessionUnit.ServerSession;
  Viewport: SessionUnit.ViewportSize;
  ConnectionValue: Net.Connection;
  Token: Tasks.CancellationToken;
  Logs: option of channel of Logging.ServerLogEvent
): result of (SessionUnit.ServerSession, string);
ensures (Returned): case Returned of
  when Ok(const Next): (Next.Dirty = Session.Dirty) and (Next.LastSavedAt = Session.LastSavedAt)
    and
    ((Next.Viewport = Viewport) or (Next.Viewport = Session.Viewport));
  when Error(_): true;
end case;
begin
  return CommitPreparedReply(
    Session,
    PrepareProjection(
      Session with Viewport := Viewport; end with,
      ProjectionUnit.NoTurnReport(),
      false
    ),
    'viewport_rejected', ConnectionValue, Token, Logs
  );
end function;

function PrepareTransition(Session: SessionUnit.ServerSession; Transition: Movement.AreaTransition): result of (PreparedReply, string);
begin
  const Revealed: GameState.GameState := try Exploration.RevealCurrentArea(
    Transition.View,
    Transition.State
  );
  const Valid: GameState.GameState := try GameState.ValidateGameState(Transition.View, Revealed);
  return PrepareProjection(
    Session with State := Some(Valid); Interior := Transition.View.Interior; Dirty := true; end with,
    ProjectionUnit.NoTurnReport(), false
  );
end function;

// Installs an applied area transition: reveals and validates the candidate and builds its
// projection with the candidate's own map before anything is sent. A failure before sending
// rejects the intention and returns the original session unchanged; state and map change together.
public function CommitTransition(
  Session: SessionUnit.ServerSession;
  Transition: Movement.AreaTransition;
  ConnectionValue: Net.Connection;
  Token: Tasks.CancellationToken;
  Logs: option of channel of Logging.ServerLogEvent
): result of (SessionUnit.ServerSession, string);
begin
  return CommitPreparedReply(
    Session, PrepareTransition(Session, Transition), 'interaction_rejected',
    ConnectionValue, Token, Logs
  );
end function;

// Joins one turn's messages into the bounded defeat summary.
function DefeatSummary(Log: array of string): string;
begin
  var Summary: string := '';
  for Entry: string in Log do
    begin
      if Summary = '' then
        begin
          Summary := Entry;
        end;
      else
        begin
          Summary := (Summary + ' ') + Entry;
        end;
      end if;
    end;
  end for;

  if Summary = '' then
    begin
      Summary := 'You have fallen.';
    end;
  end if;

  if Summary.Length() > Protocol.MaximumCombatLogTextLength then
    begin
      Summary := Summary.Slice(
        Summary.Length() - Protocol.MaximumCombatLogTextLength,
        Protocol.MaximumCombatLogTextLength
      );
    end;
  end if;

  return Summary;
end function;

// Resolves one time-consuming intention; defeat ends the game session but keeps the connection.
public function PlayTurn(
  Session: SessionUnit.ServerSession;
  Action: Combat.TurnAction;
  RejectionCode: string;
  ConnectionValue: Net.Connection;
  Token: Tasks.CancellationToken;
  Logs: option of channel of Logging.ServerLogEvent
): result of (SessionUnit.ServerSession, string);
begin
  const State: GameState.GameState := try SessionUnit.RequireActiveState(Session.State);
  case Combat.ResolveTurn(try SessionUnit.SessionAreaView(Session, State), State, Action) of
    when Ok(const Outcome):
      begin
        case Outcome of
          when Combat.TurnOutcome.Continued(const Changed, const Log, const Events):
            begin
              return CommitPreparedReply(
                Session,
                PrepareTurn(
                  Session with State := Some(Changed); end with,
                  ProjectionUnit.TurnReport(Log := Log, Events := Events)
                ),
                RejectionCode, ConnectionValue, Token, Logs
              );
            end;
          when Combat.TurnOutcome.Defeated(const Log):
            begin
              const Sent: boolean := try SendMessage(
                ConnectionValue,
                Protocol.ServerMessage.Defeated(DefeatSummary(Log)),
                Token
              );
              var Ended: SessionUnit.ServerSession := Session;
              Ended.State := None;
              Ended.Dirty := false;
              Ended.Interior := None;
              return Ok(Ended);
            end;
        end case;
      end;
    when Error(const Reason):
      begin
        Logging.LogServer(Logs, 'rejected', (RejectionCode + ': ') + Reason);
        const Sent: boolean := try Reject(ConnectionValue, RejectionCode, Reason, Token);
        return Ok(Session);
      end;
  end case;
end function;
end unit;
