// Owns a single-player listener, two persistent workers and their bounded connection handoff.
unit Dungeon.Server.Listener;

uses Dungeon.Server.Config as ConfigUnit, Dungeon.Server.Logging as Logging, Dungeon.Server.Gamemaster.Status as GamemasterStatus, Dungeon.Server.Replies as Replies, Dungeon.Protocol as Protocol, Std.Text.Format as Conv, Std.Net.Sockets as Net, Std.Net.Server as Server, Std.Tasks as Tasks;

// Renders typed library failures at this unit's application-owned text boundary.
function FailureMessage<E: Error>(Cause: E): string;
begin
  return Cause.Message();
end function;

// Borrows a connection for one protocol session; Run owns closure on every returned outcome.
public type ConnectionHandler = function(ConnectionValue: Net.Connection; Config: ConfigUnit.ServerConfig; Token: Tasks.CancellationToken): result of (boolean, string);

// Admission covers both queued and active sessions. Lease retains the owned handle until
// it is closed; the owner can drain it if cancellation wins before the session worker receives it.
type ConnectionInbox = record
  Admission: channel of boolean;
  Pending: channel of Net.Connection;
  Lease: channel of Net.Connection;
end record;

function AcceptConnections(ListenerValue: Net.Listener; Inbox: ConnectionInbox; Config: ConfigUnit.ServerConfig; Token: Tasks.CancellationToken): result of (boolean, string);
begin
  while not Tasks.IsCancellationRequested(Token) do
    case Net.AcceptWithCancellation(ListenerValue, Token) of
      when Error(const Reason):
        if Tasks.IsCancellationRequested(Token) then
          return Ok(true);
        end if;

        return Error('Listener failed: ' + Reason.Message());
      when Ok(const Client):
        case try Tasks.TryReceive(Inbox.Admission).MapError(FailureMessage) of
          when None:
            Logging.LogServer(Config.Logs, 'rejected', 'Server admission is busy.');
            discard Replies.SendMessage(
              Client,
              Protocol.ServerMessage.Rejected('server_busy', 'Server is busy. Try again shortly.'),
              Token
            );
            const Closed := try Net.Close(Client).MapError(FailureMessage);
          when Some(_):
            // One admission permit guarantees both empty slots. Retain ownership before delivery.
            const Retained := try Tasks.Send(Inbox.Lease, Client).MapError(FailureMessage);
            case Tasks.SendWithCancellation(Inbox.Pending, Client, Token) of
              when Ok(_):
                null;
              when Error(const Reason):
                if Tasks.IsCancellationRequested(Token) then
                  return Ok(true);
                end if;

                return Error('Session delivery failed: ' + Reason.Message());
            end case;
        end case;
    end case;
  end while;

  return Ok(true);
end function;

function ServeConnections(Inbox: ConnectionInbox; Config: ConfigUnit.ServerConfig; HandleConnection: ConnectionHandler; Token: Tasks.CancellationToken): result of (boolean, string);
begin
  while not Tasks.IsCancellationRequested(Token) do
    case Tasks.ReceiveWithCancellation(Inbox.Pending, Token) of
      when Error(const Reason):
        if Tasks.IsCancellationRequested(Token) then
          return Ok(true);
        end if;

        return Error('Session receive failed: ' + Reason.Message());
      when Ok(const Client):
        Logging.LogServer(Config.Logs, 'connected', 'Player connected');
        const Outcome := HandleConnection(Client, Config, Token);
        const Closed := Net.Close(Client);
        Logging.LogServer(Config.Logs, 'disconnected', 'Player disconnected');
        case Outcome of
          when Error(const Reason):
            Logging.LogServer(Config.Logs, 'error', 'Client failed: ' + Reason);
          when Ok(_):
            null;
        end case;

        case Closed of
          when Error(const Reason):
            return Error('Session close failed: ' + Reason.Message());
          when Ok(_):
            const Released := try Tasks.TryReceive(Inbox.Lease).MapError(FailureMessage);
        end case;
        // Publish all old-session completion facts before admitting the next connection.
        const Admitted := try Tasks.Send(Inbox.Admission, true).MapError(FailureMessage);
    end case;
  end while;

  return Ok(true);
end function;

function CloseLease(Inbox: ConnectionInbox): result of (boolean, string);
begin
  case try Tasks.TryReceive(Inbox.Lease).MapError(FailureMessage) of
    when Some(const Client):
      return Net.Close(Client).MapError(FailureMessage);
    when None:
      return Ok(true);
  end case;
end function;

// No workers exist yet: finish the empty lifetime without losing the original startup error.
procedure AbortStartup(Life: Server.ServerLifetime);
begin
  discard Server.RequestStop(Life);
  discard Tasks.CloseTaskGroupWithTimeout(Server.GetWorkGroup(Life), Server.RemainingMillis(Life));
  discard Server.FinishShutdown(Life);
end procedure;

// Takes the bound listener immediately, including when lifetime creation itself fails.
function BeginLifetime(ListenerValue: Net.Listener; ProcessSignals: boolean): result of (Server.ServerLifetime, string);
begin
  case Server.CreateLifetime(2000, false) of
    when Error(const Reason):
      discard Net.CloseListener(ListenerValue);
      return Error(Reason.Message());
    when Ok(const Life):
      case Server.OwnListener(Life, ListenerValue) of
        when Error(const Reason):
          discard Net.CloseListener(ListenerValue);
          AbortStartup(Life);
          return Error(Reason.Message());
        when Ok(_):
          null;
      end case;

      if ProcessSignals then
        case Server.ObserveSignals(Life) of
          when Error(const Reason):
            AbortStartup(Life);
            return Error(Reason.Message());
          when Ok(_):
            null;
        end case;
      end if;

      return Ok(Life);
  end case;
end function;

// Takes ownership of a bound listener and uses exactly two group children for its whole lifetime.
// A caller-supplied admission permit is borrowed, never seeded or closed by the listener.
// Cancellation gives both workers one shared grace budget, then closes queued/active connections.
// A timeout is reported while ownership is retained until cooperative work finishes; no forced exit.
// Ordinary worker errors are returned after cleanup; unexpected task diagnostics propagate.
public function Run(
  ListenerValue: Net.Listener;
  Config: ConfigUnit.ServerConfig;
  StopToken: Tasks.CancellationToken;
  ProcessSignals: boolean;
  HandleConnection: ConnectionHandler
): result of (boolean, string);
begin
  const Address := try Net.ListenerLocalAddress(ListenerValue).MapError(FailureMessage);
  const Life := try BeginLifetime(ListenerValue, ProcessSignals);
  const Workers := Server.GetWorkGroup(Life);
  var Admission: channel of boolean := Tasks.CreateChannel(1);
  case Config.AdmissionPermit of
    when Some(const Shared):
      discard Tasks.CloseChannel(Admission);
      Admission := Shared;
    when None:
      discard Tasks.Send(Admission, true);
  end case;
  const Inbox := ConnectionInbox(
    Admission := Admission, Pending := Tasks.CreateChannel(1),
    Lease := Tasks.CreateChannel(1)
  );
  const Outcomes: channel of result of (boolean, string) := Tasks.CreateChannel(2);
  const Acceptor := Tasks.StartTaskInGroup(
    Workers, procedure(Token: Tasks.CancellationToken) begin
      const Outcome := AcceptConnections(ListenerValue, Inbox, Config, Token);
      discard Tasks.Send(Outcomes, Outcome);
    end procedure
  );
  const Sessions := Tasks.StartTaskInGroup(
    Workers, procedure(Token: Tasks.CancellationToken) begin
      const Outcome := ServeConnections(Inbox, Config, HandleConnection, Token);
      discard Tasks.Send(Outcomes, Outcome);
    end procedure
  );
  Logging.LogServer(Config.Logs, 'status', 'Listening on port ' + Conv.IntToStr(Address.Port));
  GamemasterStatus.PublishStartup(Config);
  // Observe termination as well as stop requests; returned Error values travel through Outcomes.
  discard Tasks.Select([
    Tasks.TaskCase(
      Acceptor, procedure() begin
        null;
      end procedure
    ),
    Tasks.TaskCase(
      Sessions, procedure() begin
        null;
      end procedure
    ),
    Tasks.CancellationCase(
      StopToken, procedure() begin
        null;
      end procedure
    ),
    Tasks.CancellationCase(
      Server.GetStopToken(Life), procedure() begin
        null;
      end procedure
    )
  ]);
  discard Server.RequestStop(Life);
  var ShutdownFailure: string := '';
  var Failures: array of Tasks.TaskFailure := [];
  case Tasks.CloseTaskGroupWithTimeout(Workers, Server.RemainingMillis(Life)) of
    when Ok(const Completed):
      Failures := Completed;
    when Error(const Reason):
      ShutdownFailure := Reason.Message();
      Logging.LogServer(Config.Logs, 'error', ShutdownFailure);
      // Timeout retains the cancelled group. Finish ownership before returning its error.
      Failures := Tasks.CloseTaskGroup(Workers);
  end case;
  const LeaseClosed := CloseLease(Inbox);
  if Config.AdmissionPermit is None then
    discard Tasks.CloseChannel(Inbox.Admission);
  end if;

  discard Tasks.CloseChannel(Inbox.Pending);
  discard Tasks.CloseChannel(Inbox.Lease);
  discard Tasks.CloseChannel(Outcomes);
  var FailureReason: string := '';
  for Index: integer := 1 to 2 do
    case Tasks.TryReceive(Outcomes) of
      when Ok(Some(const Outcome)):
        case Outcome of
          when Error(const Reason):
            Logging.LogServer(Config.Logs, 'error', Reason);
            if FailureReason = '' then
              FailureReason := Reason;
            end if;
          when Ok(_):
            null;
        end case;
      when Ok(None), Error(_):
        null;
    end case;
  end for;

  for Failure: Tasks.TaskFailure in Failures do
    Logging.LogServer(Config.Logs, 'error', Failure.Message);
    if FailureReason = '' then
      FailureReason := 'server worker failed: ' + Failure.Message;
    end if;
  end for;

  if FailureReason = '' then
    FailureReason := ShutdownFailure;
  end if;

  case LeaseClosed of
    when Error(const Reason):
      if FailureReason = '' then
        FailureReason := Reason;
      end if;
    when Ok(_):
      null;
  end case;
  const Finished := Server.FinishShutdown(Life);
  if FailureReason <> '' then
    return Error(FailureReason);
  end if;

  return Finished.MapError(FailureMessage);
end function;
end unit;
