// Bounded live server log events shared by headless operation and the optional console.
unit Dungeon.Server.Logging;

uses Std.Console, Std.Tasks;

public type
  // Kind is status, connected, disconnected, world, rejected, or error; text is display-only.
  ServerLogEvent = record
    public Kind: string;
    public Text: string;
  end record;

// Logging never blocks play: retain the newest events if the bounded console queue is full.
public procedure LogServer(Logs: option of channel of ServerLogEvent; Kind: string; Text: string);
begin
  case Logs of
    when None:
      begin
        WriteLn((Kind + ': ') + Text);
      end;
    when Some(Queue):
      begin
        case TrySend(Queue, record
          Kind := Kind;
          Text := Text;
        end) of
          when Ok(Queued):
            begin
              if not Queued then
                discard TryReceive(Queue);
                discard TrySend(Queue, record
                  Kind := Kind;
                  Text := Text;
                end);
              end if;
            end;
          else
            begin
              null;
            end;
        end case;
      end;
  end case;
end procedure;
end unit;
