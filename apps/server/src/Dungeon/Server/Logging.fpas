// Bounded live server log events shared by headless operation and the optional console.
unit Dungeon.Server.Logging;

uses Std.Console as Console, Std.Tasks as Tasks;

// Kind is status, connected, disconnected, world, rejected, or error; text is display-only.
public type ServerLogEvent = record
  public Kind: string;
  public Text: string;
end record;

// Logging never blocks play: retain the newest events if the bounded console queue is full.
public procedure LogServer(Logs: option of channel of ServerLogEvent; Kind: string; Text: string);
begin
  case Logs of
    when None:
      begin
        Console.WriteLn((Kind + ': ') + Text);
      end;
    when Some(const Queue):
      begin
        case Tasks.TrySend(Queue, ServerLogEvent(Kind := Kind, Text := Text)) of
          when Ok(const Queued):
            if not Queued then
              discard Tasks.TryReceive(Queue);
              discard Tasks.TrySend(Queue, ServerLogEvent(Kind := Kind, Text := Text));
            end if;
          when Error(_):
            null;
        end case;
      end;
  end case;
end procedure;
end unit;
