// Applies one decoded client message to a session after the handshake.
unit Dungeon.Server.Handling;

uses Dungeon.Server.Trade as SessionTrade, Dungeon.World.Settlements as Villages, Dungeon.Server.Dialogue as SessionDialogue, Dungeon.Npcs.Interaction as NpcInteraction, Dungeon.Settlements as Settlements, Dungeon.Server.Config as ConfigUnit, Dungeon.Server.Worlds as Worlds, Dungeon.Server.Logging as Logging, Dungeon.Server.Failures as FailuresUnit, Dungeon.Server.Mapping as Mapping, Dungeon.Server.Projection as ProjectionUnit, Dungeon.Server.Replies as Replies, Dungeon.Server.Session as SessionUnit, Dungeon.Combat as Combat, Dungeon.Coordinates as Coordinates, Dungeon.GameState as GameState, Dungeon.Interaction as Interaction, Dungeon.Interior as InteriorUnit, Dungeon.Movement as Movement, Dungeon.Protocol as Protocol, Dungeon.World as WorldUnit, Dungeon.World.Interiors as Interiors, Std.Net as Net, Std.Tasks as Tasks;

function RejectLogged(
  Config: ConfigUnit.ServerConfig;
  ConnectionValue: Net.Connection;
  Code: string;
  Reason: string;
  Token: Tasks.CancellationToken
): result of (boolean, string);
begin
  Logging.LogServer(Config.Logs, 'rejected', (Code + ': ') + Reason);
  return Replies.Reject(ConnectionValue, Code, Reason, Token);
end function;

// Sends a classified rejection for a typed failure and logs its detailed reason on the server.
function RejectFailure(
  ConnectionValue: Net.Connection;
  Rejection: FailuresUnit.FailureRejection;
  Detail: string;
  Config: ConfigUnit.ServerConfig;
  Token: Tasks.CancellationToken
): result of (boolean, string);
begin
  Logging.LogServer(Config.Logs, 'error', (Rejection.Code + ': ') + Detail);
  return RejectLogged(Config, ConnectionValue, Rejection.Code, Rejection.Message, Token);
end function;

// Opens immutable settlement/dungeon facts for entry (none when leaving) and applies the pure transition.
// Storage failures are rejected with their class; the session stays unchanged.
function HandleTransition(
  Session: SessionUnit.ServerSession;
  View: GameState.AreaView;
  State: GameState.GameState;
  TargetAreaId: string;
  Config: ConfigUnit.ServerConfig;
  ConnectionValue: Net.Connection;
  Token: Tasks.CancellationToken
): result of (SessionUnit.ServerSession, string);
begin
  var TargetMap: option of InteriorUnit.InteriorMap := None;
  if (TargetAreaId <> Session.World.Metadata.OutdoorAreaId)
    and
    (TargetAreaId <> Settlements.HomeAreaId(Session.World.Metadata))
  then
    begin
      const Opened := if TargetAreaId.StartsWith(Session.World.Metadata.Id + ':settlement:') then Villages.OpenMapForEntry(
        Session.World,
        View,
        State,
        TargetAreaId
      )
        else Interiors.OpenLevelForEntry(Session.World, View, State, TargetAreaId)
        end if;
      case Opened of
        when Ok(const Map):
          begin
            TargetMap := Some(Map);
          end;
        when Error(const Failure):
          begin
            const Sent: boolean := try RejectFailure(
              ConnectionValue,
              FailuresUnit.AreaRejection(Session.World.Metadata.Id, Failure),
              FailuresUnit.AreaFailureReason(Failure),
              Config,
              Token
            );
            return Ok(Session);
          end;
      end case;
    end;
  end if;

  case Movement.ActivateAreaTransition(View, State, TargetMap) of
    when Ok(const Transition):
      begin
        return Replies.CommitTransition(Session, Transition, ConnectionValue, Token, Config.Logs);
      end;
    when Error(const Reason):
      begin
        const Sent: boolean := try RejectLogged(
          Config,
          ConnectionValue,
          'interaction_rejected',
          Reason,
          Token
        );
        return Ok(Session);
      end;
  end case;
end function;

// Applies one decoded client message after the handshake; Finished requests connection close.
public function HandleSessionMessage(
  Session: SessionUnit.ServerSession;
  Message: Protocol.ClientMessage;
  ConnectionValue: Net.Connection;
  Config: ConfigUnit.ServerConfig;
  Token: Tasks.CancellationToken
): result of (SessionUnit.ServerSession, string);
requires not Session.Finished and (Session.LastTradeRevision >= 0)
  and
  (Session.LastTradeRevision <= Protocol.MaximumTradeRevision);
ensures (Returned): case Returned of
  when Ok(const Next): (Next.LastTradeRevision >= Session.LastTradeRevision)
    and
    (Next.LastTradeRevision <= Protocol.MaximumTradeRevision)
    and
    (
      if (Message is Protocol.ClientMessage.Viewport(_, _))
      or
      (Message is Protocol.ClientMessage.ExplorationMap(_, _, _, _)) then (
        Next.Dirty = Session.Dirty
      ) and (Next.LastSavedAt = Session.LastSavedAt)
      and
      (Next.LastTradeRevision = Session.LastTradeRevision)
        else true
        end if
    );
  when Error(_): true;
end case;
begin
  if (Session.State is None) and SessionUnit.RequiresActiveSession(Message) then
    const Sent := try RejectLogged(
      Config,
      ConnectionValue,
      'session_not_started',
      'Start or load a game first.',
      Token
    );
    return Ok(Session);
  end if;
  const Blocked := SessionUnit.InteractionRejection(Session, Message);
  if Blocked <> '' then
    const Sent := try RejectLogged(
      Config,
      ConnectionValue,
      Blocked,
      if Blocked = 'trade_active' then 'Finish trading first.'
        else 'Finish the conversation first.'
        end if,
      Token
    );
    return Ok(Session);
  end if;

  case try Worlds.HandleWorldMessage(Session, Message, ConnectionValue, Config, Token) of
    when Some(const Handled):
      begin
        return Ok(Handled);
      end;
    when None:
      begin
        null;
      end;
  end case;

  case try SessionTrade.HandleMessage(Session, Message, ConnectionValue, Token, Config.Logs) of
    when Some(const Handled):
      return Ok(Handled);
    when None:
      null;
  end case;

  case try SessionDialogue.HandleMessage(Session, Message, ConnectionValue, Token, Config.Logs) of
    when Some(const Handled):
      return Ok(Handled);
    when None:
      null;
  end case;
  var Next: SessionUnit.ServerSession := Session;
  case Message of
    when Protocol.ClientMessage.Disconnect:
      begin
        Next.Finished := true;
      end;
    when Protocol.ClientMessage.Hello(const Version, const Width, const Height):
      begin
        const Sent: boolean := try Replies.SendMessage(
          ConnectionValue,
          Protocol.ServerMessage.ErrorMessage(
            'unexpected_hello',
            'The session is already established'
          ),
          Token
        );
        Next.Finished := true;
      end;
    when Protocol.ClientMessage.Viewport(const Width, const Height):
      begin
        case SessionUnit.ResolveViewport(Width, Height, Config) of
          when Ok(const Value):
            begin
              return Replies.ChangeViewport(Session, Value, ConnectionValue, Token, Config.Logs);
            end;
          when Error(const Reason):
            begin
              const Sent: boolean := try RejectLogged(
                Config,
                ConnectionValue,
                'invalid_viewport',
                Reason,
                Token
              );
            end;
        end case;
      end;
    when Protocol.ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height):
      begin
        if (Width > Config.MaximumViewWidth) or (Height > Config.MaximumViewHeight) then
          begin
            const Sent: boolean := try RejectLogged(
              Config,
              ConnectionValue,
              'invalid_map_window',
              'Exploration map dimensions exceed server limits.',
              Token
            );
          end;
        else
          begin
            const State: GameState.GameState := try SessionUnit.RequireActiveState(Session.State);
            const View: GameState.AreaView := try SessionUnit.SessionAreaView(Session, State);
            var Candidate := Session;
            var Prepared: result of (Protocol.ExplorationMapState, string) := Error(
              'Cannot prepare exploration map.'
            );
            if State.Area = Coordinates.AreaKind.OutdoorRegion then
              // Prepare the refreshed cache separately; a failed window retains the installed cache.
              case ProjectionUnit.ProjectOutdoorExplorationMap(
                Session.World, State, View, OriginX, OriginY, Width, Height
              ) of
                when Ok(const Loaded):
                  Candidate.World := Loaded.World;
                  Prepared := Ok(Loaded.Map);
                when Error(const Reason):
                  Prepared := Error(Reason);
              end case;
            else
              Prepared := ProjectionUnit.ProjectExplorationMap(
                State, View, OriginX, OriginY, Width, Height
              );
            end if;

            case Prepared of
              when Ok(const MapValue):
                const Sent := try Replies.SendMessage(
                  ConnectionValue, Protocol.ServerMessage.ExplorationMap(MapValue), Token
                );
                return Ok(Candidate);
              when Error(const Reason):
                const Sent := try RejectFailure(
                  ConnectionValue,
                  FailuresUnit.FailureRejection(
                    Code := 'map_rejected',
                    Message := 'Cannot prepare exploration map. Check world storage.'
                  ),
                  Reason, Config, Token
                );
                return Ok(Session);
            end case;
          end;
        end if;
      end;
    when Protocol.ClientMessage.Move(const DeltaX, const DeltaY):
      begin
        const State := try SessionUnit.RequireActiveState(Session.State);
        if State.Area = Coordinates.AreaKind.Settlement then
          case Movement.MoveSettlement(
            try SessionUnit.SessionAreaView(Session, State),
            State,
            DeltaX,
            DeltaY
          ) of
            when Ok(const Moved):
              return Replies.CommitState(
                Session, Session with State := Some(Moved); end with,
                'movement_rejected', ConnectionValue, Token, Config.Logs
              );
            when Error(const Reason):
              const Sent := try RejectLogged(
                Config,
                ConnectionValue,
                'movement_rejected',
                Reason,
                Token
              );
              return Ok(Session);
          end case;
        end if;

        case WorldUnit.MoveInWorld(
          Session.World,
          try SessionUnit.RequireActiveState(Session.State),
          DeltaX,
          DeltaY
        ) of
          when Ok(const Moved):
            begin
              Next.World := Moved.World;
              Next.State := Some(Moved.State);
              return Replies.CommitState(
                Session, Next, 'movement_rejected', ConnectionValue, Token, Config.Logs
              );
            end;
          when Error(const Reason):
            begin
              const Sent: boolean := try RejectLogged(
                Config,
                ConnectionValue,
                'movement_rejected',
                Reason,
                Token
              );
            end;
        end case;
      end;
    when Protocol.ClientMessage.StepFirstPerson(const Direction):
      begin
        return Replies.PlayTurn(
          Session,
          Combat.TurnAction.Step(Mapping.GameStep(Direction)),
          'movement_rejected',
          ConnectionValue,
          Token,
          Config.Logs
        );
      end;
    when Protocol.ClientMessage.Attack:
      begin
        return Replies.PlayTurn(
          Session,
          Combat.TurnAction.Attack,
          'attack_rejected',
          ConnectionValue,
          Token,
          Config.Logs
        );
      end;
    when Protocol.ClientMessage.Wait:
      begin
        return Replies.PlayTurn(
          Session,
          Combat.TurnAction.Wait,
          'wait_rejected',
          ConnectionValue,
          Token,
          Config.Logs
        );
      end;
    when Protocol.ClientMessage.Equip(const ItemId):
      begin
        return Replies.PlayTurn(
          Session,
          Combat.TurnAction.Equip(ItemId),
          'equip_rejected',
          ConnectionValue,
          Token,
          Config.Logs
        );
      end;
    when Protocol.ClientMessage.Unequip(const ItemId):
      begin
        return Replies.PlayTurn(
          Session,
          Combat.TurnAction.Unequip(ItemId),
          'equip_rejected',
          ConnectionValue,
          Token,
          Config.Logs
        );
      end;
    when Protocol.ClientMessage.DropItem(const ItemId):
      begin
        return Replies.PlayTurn(
          Session,
          Combat.TurnAction.Drop(ItemId),
          'drop_rejected',
          ConnectionValue,
          Token,
          Config.Logs
        );
      end;
    when Protocol.ClientMessage.UseItem(const ItemId):
      return Replies.PlayTurn(
        Session, Combat.TurnAction.UseItem(ItemId), 'item_use_rejected',
        ConnectionValue, Token, Config.Logs
      );
    when Protocol.ClientMessage.TurnFirstPerson(const Direction):
      begin
        const State: GameState.GameState := try SessionUnit.RequireActiveState(Session.State);
        case Movement.TurnFirstPerson(
          try SessionUnit.SessionAreaView(Session, State),
          State,
          Mapping.GameTurn(Direction)
        ) of
          when Ok(const Turned):
            begin
              return Replies.CommitState(
                Session, Session with State := Some(Turned); end with,
                'turn_rejected', ConnectionValue, Token, Config.Logs
              );
            end;
          when Error(const Reason):
            begin
              const Sent: boolean := try RejectLogged(
                Config,
                ConnectionValue,
                'turn_rejected',
                Reason,
                Token
              );
            end;
        end case;
      end;
    when Protocol.ClientMessage.Interact:
      begin
        const State: GameState.GameState := try SessionUnit.RequireActiveState(Session.State);
        const View: GameState.AreaView := try SessionUnit.SessionAreaView(Session, State);
        if NpcInteraction.InReach(View, State) is Some(_) then
          return SessionDialogue.StartConversation(Session, ConnectionValue, Token, Config.Logs);
        end if;

        case Interaction.Interact(View, State) of
          when Ok(const Outcome):
            begin
              case Outcome of
                when Interaction.InteractionOutcome.TransitionRequested(const TargetAreaId):
                  begin
                    return HandleTransition(
                      Session,
                      View,
                      State,
                      TargetAreaId,
                      Config,
                      ConnectionValue,
                      Token
                    );
                  end;
                when Interaction.InteractionOutcome.StateChanged(const Changed):
                  begin
                    return Replies.CommitState(
                      Session, Session with State := Some(Changed); end with,
                      'interaction_rejected', ConnectionValue, Token, Config.Logs
                    );
                  end;
                when Interaction.InteractionOutcome.Described(const Title, const Text):
                  begin
                    const Sent: boolean := try Replies.SendMessage(
                      ConnectionValue,
                      Protocol.ServerMessage.Interaction(Title, Text),
                      Token
                    );
                  end;
              end case;
            end;
          when Error(const Reason):
            begin
              const Sent: boolean := try RejectLogged(
                Config,
                ConnectionValue,
                'interaction_rejected',
                Reason,
                Token
              );
            end;
        end case;
      end;
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.StartNewGame, Protocol.ClientMessage.LoadGame, Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame, Protocol.ClientMessage.ListWorlds(_, _), Protocol.ClientMessage.SelectWorld(_), Protocol.ClientMessage.CreateWorld(_, _):
      begin
        null;
      end;
  end case;

  return Ok(Next);
end function;
end unit;
