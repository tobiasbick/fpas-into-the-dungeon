// Applies one decoded client message to a session after the handshake.
unit Dungeon.Server.Handling;

uses
  Dungeon.Server.Config, Dungeon.Server.Failures, Dungeon.Server.Mapping, Dungeon.Server.Projection,
  Dungeon.Server.Replies, Dungeon.Server.Session, Dungeon.Combat, Dungeon.Coordinates,
  Dungeon.GameState, Dungeon.Interaction, Dungeon.Interior, Dungeon.Movement, Dungeon.Protocol,
  Dungeon.World, Dungeon.World.Interiors, Dungeon.World.Savegame, Std.Console, Std.Net, Std.Options,
  Std.Tasks;

// Sends a classified rejection for a typed failure and logs its detailed reason on the server.
function RejectFailure(
  ConnectionValue: Connection;
  Rejection: FailureRejection;
  Detail: string;
  Token: CancellationToken
): result of boolean, string;
begin
  WriteLn((Rejection.Code + ': ') + Detail);
  return Reject(ConnectionValue, Rejection.Code, Rejection.Message, Token);
end function;

// Opens the target level of an entry (or none for an exit) and applies the pure transition.
// Storage failures are rejected with their class; the session stays unchanged.
function HandleTransition(
  Session: ServerSession;
  View: AreaView;
  State: GameState;
  TargetAreaId: string;
  ConnectionValue: Connection;
  Token: CancellationToken
): result of ServerSession, string;
begin
  mutable var TargetMap: option of InteriorMap := None;
  if State.Area = AreaKind.OutdoorRegion then
    begin
      case OpenLevelForEntry(Session.World, State, TargetAreaId) of
        when Ok(Map):
          begin
            TargetMap := Some(Map);
          end;
        when Error(Failure):
          begin
            var Sent: boolean := try RejectFailure(ConnectionValue, LevelRejection(Session.World.Metadata.Id, Failure), LevelFailureReason(Failure), Token);
            return Ok(Session);
          end;
      end case;
    end;
  end if;

  case ActivateAreaTransition(View, State, TargetMap) of
    when Ok(Transition):
      begin
        return CommitTransition(Session, Transition, ConnectionValue, Token);
      end;
    when Error(Reason):
      begin
        var Sent: boolean := try Reject(ConnectionValue, 'interaction_rejected', Reason, Token);
        return Ok(Session);
      end;
  end case;
end function;

// Applies one decoded client message after the handshake; Finished requests connection close.
public function HandleSessionMessage(
  Session: ServerSession;
  Message: ClientMessage;
  ConnectionValue: Connection;
  Config: ServerConfig;
  Token: CancellationToken
): result of ServerSession, string;
begin
  var HasState: boolean := Std.Options.IsSome(Session.State);
  if not HasState and RequiresActiveSession(Message) then
    begin
      var Sent: boolean := try Reject(ConnectionValue, 'session_not_started', 'Start or load a game first.', Token);
      return Ok(Session);
    end;
  end if;
  mutable var Next: ServerSession := Session;
  case Message of
    when ClientMessage.Disconnect:
      begin
        Next.Finished := true;
      end;
    when ClientMessage.Hello(Version, Width, Height):
      begin
        var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('unexpected_hello', 'The session is already established'), Token);
        Next.Finished := true;
      end;
    when ClientMessage.StartNewGame:
      begin
        if HasState then
          begin
            var Sent: boolean := try Reject(ConnectionValue, 'session_already_started', 'A game session is already active.', Token);
          end;
        else
          begin
            Next.Interior := None;
            return CommitState(Next, NewGame(Session.World.Metadata), ConnectionValue, Token);
          end;
        end if;
      end;
    when ClientMessage.LoadGame:
      begin
        if HasState then
          begin
            var Sent: boolean := try Reject(ConnectionValue, 'session_already_started', 'A game session is already active.', Token);
          end;
        else
          begin
            case LoadSaveGame(Session.World) of
              when Error(Failure):
                begin
                  var Sent: boolean := try RejectFailure(ConnectionValue, PersistenceRejection(Session.World.Metadata.Id, 'load_failed', Failure), PersistenceFailureReason(Failure), Token);
                end;
              when Ok(LoadedSave):
                begin
                  case LoadedSave of
                    when SaveGameLoad.Missing:
                      begin
                        var Sent: boolean := try Reject(ConnectionValue, 'save_unavailable', 'No saved game is available for this world.', Token);
                      end;
                    when SaveGameLoad.InvalidRemoved(Reason):
                      begin
                        var Sent: boolean := try Reject(ConnectionValue, 'save_removed', 'Invalid saved game was removed. Start a new game.', Token);
                      end;
                    when SaveGameLoad.Loaded(SavedState, SavedView):
                      begin
                        Next.Interior := SavedView.Interior;
                        return CommitState(Next, SavedState, ConnectionValue, Token);
                      end;
                  end case;
                end;
            end case;
          end;
        end if;
      end;
    when ClientMessage.SaveGame:
      begin
        case WriteSaveGame(Session.World, try RequireActiveState(Session.State)) of
          when Ok(Written):
            begin
              var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.SaveCompleted, Token);
            end;
          when Error(Failure):
            begin
              var Sent: boolean := try RejectFailure(ConnectionValue, PersistenceRejection(Session.World.Metadata.Id, 'save_failed', Failure), PersistenceFailureReason(Failure), Token);
            end;
        end case;
      end;
    when ClientMessage.Viewport(Width, Height):
      begin
        case ResolveViewport(Width, Height, Config) of
          when Ok(Value):
            begin
              Next.Viewport := Value;
              var State: GameState := try RequireActiveState(Session.State);
              Next.World := try SendProjection(ConnectionValue, Session.World, try SessionAreaView(Session, State), State, Value, NoTurnReport(), Token);
            end;
          when Error(Reason):
            begin
              var Sent: boolean := try Reject(ConnectionValue, 'invalid_viewport', Reason, Token);
            end;
        end case;
      end;
    when ClientMessage.ExplorationMap(OriginX, OriginY, Width, Height):
      begin
        if (Width > Config.MaximumViewWidth) or (Height > Config.MaximumViewHeight) then
          begin
            var Sent: boolean := try Reject(ConnectionValue, 'invalid_map_window', 'Exploration map dimensions exceed server limits.', Token);
          end;
        else
          begin
            var State: GameState := try RequireActiveState(Session.State);
            var MapValue: ExplorationMapState := try ProjectExplorationMap(State, try SessionAreaView(Session, State), OriginX, OriginY, Width, Height);
            var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ExplorationMap(MapValue), Token);
          end;
        end if;
      end;
    when ClientMessage.Move(DeltaX, DeltaY):
      begin
        case MoveInWorld(Session.World, try RequireActiveState(Session.State), DeltaX, DeltaY) of
          when Ok(Moved):
            begin
              Next.World := Moved.World;
              return CommitState(Next, Moved.State, ConnectionValue, Token);
            end;
          when Error(Reason):
            begin
              var Sent: boolean := try Reject(ConnectionValue, 'movement_rejected', Reason, Token);
            end;
        end case;
      end;
    when ClientMessage.StepFirstPerson(Direction):
      begin
        return PlayTurn(Session, TurnAction.Step(GameStep(Direction)), 'movement_rejected', ConnectionValue, Token);
      end;
    when ClientMessage.Attack:
      begin
        return PlayTurn(Session, TurnAction.Attack, 'attack_rejected', ConnectionValue, Token);
      end;
    when ClientMessage.Wait:
      begin
        return PlayTurn(Session, TurnAction.Wait, 'wait_rejected', ConnectionValue, Token);
      end;
    when ClientMessage.Equip(ItemId):
      begin
        return PlayTurn(Session, TurnAction.Equip(ItemId), 'equip_rejected', ConnectionValue, Token);
      end;
    when ClientMessage.Unequip(ItemId):
      begin
        return PlayTurn(Session, TurnAction.Unequip(ItemId), 'equip_rejected', ConnectionValue, Token);
      end;
    when ClientMessage.DropItem(ItemId):
      begin
        return PlayTurn(Session, TurnAction.Drop(ItemId), 'drop_rejected', ConnectionValue, Token);
      end;
    when ClientMessage.TurnFirstPerson(Direction):
      begin
        var State: GameState := try RequireActiveState(Session.State);
        case Dungeon.Movement.TurnFirstPerson(try SessionAreaView(Session, State), State, GameTurn(Direction)) of
          when Ok(Turned):
            begin
              return CommitState(Session, Turned, ConnectionValue, Token);
            end;
          when Error(Reason):
            begin
              var Sent: boolean := try Reject(ConnectionValue, 'turn_rejected', Reason, Token);
            end;
        end case;
      end;
    when ClientMessage.Interact:
      begin
        var State: GameState := try RequireActiveState(Session.State);
        var View: AreaView := try SessionAreaView(Session, State);
        case Dungeon.Interaction.Interact(View, State) of
          when Ok(Outcome):
            begin
              case Outcome of
                when InteractionOutcome.TransitionRequested(TargetAreaId):
                  begin
                    return HandleTransition(Session, View, State, TargetAreaId, ConnectionValue, Token);
                  end;
                when InteractionOutcome.StateChanged(Changed):
                  begin
                    return CommitState(Session, Changed, ConnectionValue, Token);
                  end;
                when InteractionOutcome.Described(Title, Text):
                  begin
                    var Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.Interaction(Title, Text), Token);
                  end;
              end case;
            end;
          when Error(Reason):
            begin
              var Sent: boolean := try Reject(ConnectionValue, 'interaction_rejected', Reason, Token);
            end;
        end case;
      end;
  end case;

  return Ok(Next);
end function;
end unit;
