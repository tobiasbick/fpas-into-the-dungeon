// Applies one decoded client message to a session after the handshake.
unit Dungeon.Server.Handling;

uses
  Dungeon.Server.Config, Dungeon.Server.Worlds, Dungeon.Server.Logging, Dungeon.Server.Failures,
  Dungeon.Server.Mapping, Dungeon.Server.Projection, Dungeon.Server.Replies, Dungeon.Server.Session,
  Dungeon.Combat, Dungeon.Coordinates, Dungeon.GameState, Dungeon.Interaction, Dungeon.Interior,
  Dungeon.Movement, Dungeon.Protocol, Dungeon.World, Dungeon.World.Interiors, Dungeon.World.Savegame,
  Std.Console, Std.Net, Std.Tasks;

function RejectLogged(
  Config: ServerConfig;
  ConnectionValue: Connection;
  Code: string;
  Reason: string;
  Token: CancellationToken
): result of (boolean, string);
begin
  LogServer(Config.Logs, 'rejected', (Code + ': ') + Reason);
  return Reject(ConnectionValue, Code, Reason, Token);
end function;

// Sends a classified rejection for a typed failure and logs its detailed reason on the server.
function RejectFailure(
  ConnectionValue: Connection;
  Rejection: FailureRejection;
  Detail: string;
  Config: ServerConfig;
  Token: CancellationToken
): result of (boolean, string);
begin
  LogServer(Config.Logs, 'error', (Rejection.Code + ': ') + Detail);
  return RejectLogged(Config, ConnectionValue, Rejection.Code, Rejection.Message, Token);
end function;

// Opens the target level of an entry (or none for an exit) and applies the pure transition.
// Storage failures are rejected with their class; the session stays unchanged.
function HandleTransition(
  Session: ServerSession;
  View: AreaView;
  State: GameState;
  TargetAreaId: string;
  Config: ServerConfig;
  ConnectionValue: Connection;
  Token: CancellationToken
): result of (ServerSession, string);
begin
  var TargetMap: option of InteriorMap := None;
  if State.Area = AreaKind.OutdoorRegion then
    begin
      case OpenLevelForEntry(Session.World, State, TargetAreaId) of
        when Ok(const Map):
          begin
            TargetMap := Some(Map);
          end;
        when Error(const Failure):
          begin
            const Sent: boolean := try RejectFailure(ConnectionValue, LevelRejection(Session.World.Metadata.Id, Failure), LevelFailureReason(Failure), Config, Token);
            return Ok(Session);
          end;
      end case;
    end;
  end if;

  case ActivateAreaTransition(View, State, TargetMap) of
    when Ok(const Transition):
      begin
        return CommitTransition(Session, Transition, ConnectionValue, Token);
      end;
    when Error(const Reason):
      begin
        const Sent: boolean := try RejectLogged(Config, ConnectionValue, 'interaction_rejected', Reason, Token);
        return Ok(Session);
      end;
  end case;
end function;

// Applies one decoded client message after the handshake; Finished requests connection close.
public function HandleSessionMessage(
  Session: ServerSession;
  Message: ClientMessage;
  ConnectionValue: Connection;
  Config: ServerConfig;
  Token: CancellationToken
): result of (ServerSession, string);
begin
  case try HandleWorldMessage(Session, Message, ConnectionValue, Config, Token) of
    when Some(const Handled):
      begin
        return Ok(Handled);
      end;
    when None:
      begin
        null;
      end;
  end case;
  const HasState: boolean := Session.State.IsSome();
  if not HasState and RequiresActiveSession(Message) then
    begin
      const Sent: boolean := try RejectLogged(Config, ConnectionValue, 'session_not_started', 'Start or load a game first.', Token);
      return Ok(Session);
    end;
  end if;
  var Next: ServerSession := Session;
  case Message of
    when ClientMessage.Disconnect:
      begin
        Next.Finished := true;
      end;
    when ClientMessage.Hello(const Version, const Width, const Height):
      begin
        const Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ErrorMessage('unexpected_hello', 'The session is already established'), Token);
        Next.Finished := true;
      end;
    when ClientMessage.Viewport(const Width, const Height):
      begin
        case ResolveViewport(Width, Height, Config) of
          when Ok(const Value):
            begin
              Next.Viewport := Value;
              const State: GameState := try RequireActiveState(Session.State);
              Next.World := try SendProjection(ConnectionValue, Session.World, try SessionAreaView(Session, State), State, Value, NoTurnReport(), Token);
            end;
          when Error(const Reason):
            begin
              const Sent: boolean := try RejectLogged(Config, ConnectionValue, 'invalid_viewport', Reason, Token);
            end;
        end case;
      end;
    when ClientMessage.ExplorationMap(const OriginX, const OriginY, const Width, const Height):
      begin
        if (Width > Config.MaximumViewWidth) or (Height > Config.MaximumViewHeight) then
          begin
            const Sent: boolean := try RejectLogged(Config, ConnectionValue, 'invalid_map_window', 'Exploration map dimensions exceed server limits.', Token);
          end;
        else
          begin
            const State: GameState := try RequireActiveState(Session.State);
            const MapValue: ExplorationMapState := try ProjectExplorationMap(State, try SessionAreaView(Session, State), OriginX, OriginY, Width, Height);
            const Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.ExplorationMap(MapValue), Token);
          end;
        end if;
      end;
    when ClientMessage.Move(const DeltaX, const DeltaY):
      begin
        case MoveInWorld(Session.World, try RequireActiveState(Session.State), DeltaX, DeltaY) of
          when Ok(const Moved):
            begin
              Next.World := Moved.World;
              return CommitState(Next, Moved.State, ConnectionValue, Token);
            end;
          when Error(const Reason):
            begin
              const Sent: boolean := try RejectLogged(Config, ConnectionValue, 'movement_rejected', Reason, Token);
            end;
        end case;
      end;
    when ClientMessage.StepFirstPerson(const Direction):
      begin
        return PlayTurn(Session, TurnAction.Step(GameStep(Direction)), 'movement_rejected', ConnectionValue, Token, Config.Logs);
      end;
    when ClientMessage.Attack:
      begin
        return PlayTurn(Session, TurnAction.Attack, 'attack_rejected', ConnectionValue, Token, Config.Logs);
      end;
    when ClientMessage.Wait:
      begin
        return PlayTurn(Session, TurnAction.Wait, 'wait_rejected', ConnectionValue, Token, Config.Logs);
      end;
    when ClientMessage.Equip(const ItemId):
      begin
        return PlayTurn(Session, TurnAction.Equip(ItemId), 'equip_rejected', ConnectionValue, Token, Config.Logs);
      end;
    when ClientMessage.Unequip(const ItemId):
      begin
        return PlayTurn(Session, TurnAction.Unequip(ItemId), 'equip_rejected', ConnectionValue, Token, Config.Logs);
      end;
    when ClientMessage.DropItem(const ItemId):
      begin
        return PlayTurn(Session, TurnAction.Drop(ItemId), 'drop_rejected', ConnectionValue, Token, Config.Logs);
      end;
    when ClientMessage.TurnFirstPerson(const Direction):
      begin
        const State: GameState := try RequireActiveState(Session.State);
        case Dungeon.Movement.TurnFirstPerson(try SessionAreaView(Session, State), State, GameTurn(Direction)) of
          when Ok(const Turned):
            begin
              return CommitState(Session, Turned, ConnectionValue, Token);
            end;
          when Error(const Reason):
            begin
              const Sent: boolean := try RejectLogged(Config, ConnectionValue, 'turn_rejected', Reason, Token);
            end;
        end case;
      end;
    when ClientMessage.Interact:
      begin
        const State: GameState := try RequireActiveState(Session.State);
        const View: AreaView := try SessionAreaView(Session, State);
        case Dungeon.Interaction.Interact(View, State) of
          when Ok(const Outcome):
            begin
              case Outcome of
                when InteractionOutcome.TransitionRequested(const TargetAreaId):
                  begin
                    return HandleTransition(Session, View, State, TargetAreaId, Config, ConnectionValue, Token);
                  end;
                when InteractionOutcome.StateChanged(const Changed):
                  begin
                    return CommitState(Session, Changed, ConnectionValue, Token);
                  end;
                when InteractionOutcome.Described(const Title, const Text):
                  begin
                    const Sent: boolean := try SendMessage(ConnectionValue, ServerMessage.Interaction(Title, Text), Token);
                  end;
              end case;
            end;
          when Error(const Reason):
            begin
              const Sent: boolean := try RejectLogged(Config, ConnectionValue, 'interaction_rejected', Reason, Token);
            end;
        end case;
      end;
    when clientmessage.StartNewGame, clientmessage.LoadGame, clientmessage.SaveGame, clientmessage.OverwriteSaveGame, clientmessage.ListWorlds(_, _), clientmessage.SelectWorld(_), clientmessage.CreateWorld(_, _):
      begin
        null;
      end;
  end case;

  return Ok(Next);
end function;
end unit;
