// Immutable server policy and the selected persistent world.
unit Dungeon.Server.Config;

uses Dungeon.Server.Logging;

public type
  // Immutable server policy and selected persistent world used by each session.
  ServerConfig = record
    // Current TOML path; empty for callers supplying an immutable test configuration.
    public ConfigPath: string;
    // Console log channel; None writes headless diagnostics to stdout.
    public Logs: option of channel of ServerLogEvent;
    public WorldsRoot: string;
    public WorldId: string;
    public WorldSeed: integer;
    // Entrance region size used only when the selected world is created.
    public DungeonRegionChunks: integer;
    public ChunkCacheLimit: integer;
    public MaximumViewWidth: integer;
    public MaximumViewHeight: integer;
  end record;
end unit;
