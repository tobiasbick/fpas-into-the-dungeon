// Authoritative world catalog and explicit select/create/continue/start-over/save lifecycle.
unit Dungeon.Server.Worlds;

uses Dungeon.Areas as Areas, Dungeon.Exploration as Exploration, Dungeon.GameState as GameState, Dungeon.Interior as InteriorUnit, Dungeon.Protocol as Protocol, Dungeon.Protocol.Worlds as WorldsUnit, Dungeon.RuntimeData as RuntimeData, Dungeon.Server.Config as ConfigUnit, Dungeon.Server.Failures as FailuresUnit, Dungeon.Server.Logging as Logging, Dungeon.Server.Projection as ProjectionUnit, Dungeon.Server.Replies as Replies, Dungeon.Server.Session as SessionUnit, Dungeon.Terrain.Placement as PlacementRules, Dungeon.World as WorldUnit, Dungeon.World.Catalog as CatalogUnit, Dungeon.World.Savegame as Savegame, Std.Fs as Fs, Std.Net as Net, Std.Tasks as Tasks, Std.Time as Time;

// Reads current creation defaults; selected world parameters remain independent of TOML changes.
public function CreationDefaults(Config: ConfigUnit.ServerConfig): result of (Protocol.WorldCatalog, string);
begin
  const ValidIdentity: string := try WorldsUnit.ValidateWorldIdentity(Config.WorldId);
  if Config.ConfigPath <> '' then
    const Settings: RuntimeData.ServerWorldConfig := try RuntimeData.ReadServerDefaults(
      Config.ConfigPath
    );
    return Ok(WorldsUnit.EmptyWorldCatalog(Settings.Seed, Settings.DungeonRegionChunks));
  end if;
  const Valid: boolean := try RuntimeData.ValidateServerDefaults(
    Config.WorldSeed,
    Config.DungeonRegionChunks
  );
  return Ok(WorldsUnit.EmptyWorldCatalog(Config.WorldSeed, Config.DungeonRegionChunks));
end function;

// Builds one bounded page; -1 chooses the preselected world's page for the handshake.
public function CatalogFor(Config: ConfigUnit.ServerConfig; SelectedId: string; RequestedOffset: integer): result of (Protocol.WorldCatalog, string);
begin
  var Catalog: Protocol.WorldCatalog := try CreationDefaults(Config);
  const Entries: array of CatalogUnit.WorldEntry := try CatalogUnit.ListWorlds(
    Config.WorldsRoot,
    Config.ChunkCacheLimit
  );
  Catalog.Total := Entries.Length();
  Catalog.SelectedId := SelectedId;
  Catalog.SelectionReason := 'Selected world is missing. Create a world or select another.';
  var Offset: integer := RequestedOffset;
  for Index: integer := 0 to Catalog.Total - 1 do
    if Entries[Index].Id = SelectedId then
      Catalog.SelectionReason := Entries[Index].Reason;
      if Offset = -1 then
        Offset := Index;
      end if;
    end if;
  end for;

  if SelectedId = '' then
    Catalog.SelectionReason := '';
  end if;

  if Offset < 0 then
    Offset := 0;
  end if;

  if (Offset >= Catalog.Total) and (Catalog.Total > 0) then
    Offset := ((Catalog.Total - 1) div Protocol.MaximumWorldsPerPage) *
      Protocol.MaximumWorldsPerPage;
  end if;

  if Catalog.Total = 0 then
    Offset := 0;
  end if;

  Catalog.Offset := Offset;
  var Summaries: array of Protocol.WorldSummary := [];
  for Index: integer := Offset to Catalog.Total - 1 do
    if Index < Offset + Protocol.MaximumWorldsPerPage then
      const Entry: CatalogUnit.WorldEntry := Entries[Index];
      var Summary: Protocol.WorldSummary := Protocol.WorldSummary(
        Id := Entry.Id,
        Seed := 0,
        RegionChunks := 0,
        Status := Entry.Status,
        SaveStatus := Entry.SaveStatus,
        Reason := Entry.Reason
      );
      case Entry.Metadata of
        when Some(const Metadata):
          begin
            Summary.Seed := Metadata.Seed;
            Summary.RegionChunks := Metadata.DungeonRegionChunks;
          end;
        when None:
          begin
            null;
          end;
      end case;

      if Summary.Reason.Length() > 96 then
        Summary.Reason := Summary.Reason.Slice(0, 96);
      end if;

      Summaries.PushInPlace(Summary);
    end if;
  end for;

  Catalog.Worlds := Summaries;
  return WorldsUnit.ValidateWorldCatalog(Catalog);
end function;

// Creates an idle transport session. Missing/incompatible preselection does not create a world.
public function NewServerSession(Config: ConfigUnit.ServerConfig; Viewport: SessionUnit.ViewportSize): result of (SessionUnit.ServerSession, string);
begin
  var Session: SessionUnit.ServerSession := SessionUnit.ServerSession(
    World := WorldUnit.WorldSession(
      Directory := '',
      Metadata := try PlacementRules.NewWorldMetadata('unselected', 12345, 4),
      Cache := [],
      Clock := 0,
      CacheLimit := Config.ChunkCacheLimit
    ),
    WorldSelected := false,
    Dirty := false,
    State := None,
    Interior := None,
    Viewport := Viewport,
    Finished := false
  );
  case CatalogUnit.OpenExistingWorld(Config.WorldsRoot, Config.WorldId, Config.ChunkCacheLimit) of
    when Ok(const World):
      begin
        Session.World := World;
        Session.WorldSelected := true;
      end;
    when Error(const Failure):
      begin
        null;
      end;
  end case;

  return Ok(Session);
end function;

function RejectWorld(
  Session: SessionUnit.ServerSession;
  Config: ConfigUnit.ServerConfig;
  ConnectionValue: Net.Connection;
  Code: string;
  Reason: string;
  Token: Tasks.CancellationToken
): result of (SessionUnit.ServerSession, string);
begin
  Logging.LogServer(Config.Logs, 'rejected', (Code + ': ') + Reason);
  const Sent: boolean := try Replies.Reject(ConnectionValue, Code, Reason, Token);
  return Ok(Session);
end function;

// Reveals, validates and projects a candidate before replacing the installed session.
function InstallGame(
  Session: SessionUnit.ServerSession;
  World: WorldUnit.WorldSession;
  State: GameState.GameState;
  Interior: option of InteriorUnit.InteriorMap;
  Dirty: boolean;
  ConnectionValue: Net.Connection;
  Config: ConfigUnit.ServerConfig;
  Token: Tasks.CancellationToken
): result of (SessionUnit.ServerSession, string);
begin
  var Prepared: result of (GameState.GameState, string) := Error('Cannot prepare world');
  var View: GameState.AreaView := GameState.AreaView(Metadata := World.Metadata, Interior := None);
  case Areas.AreaViewFor(World.Metadata, State, Interior) of
    when Error(const Reason):
      begin
        Logging.LogServer(Config.Logs, 'error', Reason);
        return RejectWorld(
          Session,
          Config,
          ConnectionValue,
          'world_data_error',
          'Cannot validate the selected world.',
          Token
        );
      end;
    when Ok(const Value):
      begin
        View := Value;
      end;
  end case;

  case Exploration.RevealCurrentArea(View, State) of
    when Error(const Reason):
      begin
        return RejectWorld(
          Session,
          Config,
          ConnectionValue,
          'world_data_error',
          'Cannot reveal the selected world.',
          Token
        );
      end;
    when Ok(const Revealed):
      begin
        Prepared := GameState.ValidateGameState(View, Revealed);
      end;
  end case;
  var Valid: GameState.GameState := State;
  case Prepared of
    when Error(const Reason):
      begin
        return RejectWorld(
          Session,
          Config,
          ConnectionValue,
          'world_data_error',
          'Cannot validate the selected game.',
          Token
        );
      end;
    when Ok(const Value):
      begin
        Valid := Value;
      end;
  end case;

  case ProjectionUnit.ProjectSession(
    World,
    View,
    Valid,
    Session.Viewport,
    ProjectionUnit.NoTurnReport()
  ) of
    when Error(const Reason):
      begin
        return RejectWorld(
          Session,
          Config,
          ConnectionValue,
          'storage_error',
          'Cannot prepare the selected world. Check storage access.',
          Token
        );
      end;
    when Ok(const Projection):
      begin
        const Sent: boolean := try Replies.SendMessage(
          ConnectionValue,
          Protocol.ServerMessage.State(Projection.State),
          Token
        );
        Logging.LogServer(Config.Logs, 'world', 'Playing world ' + World.Metadata.Id);
        var LastSavedAt: integer := Session.LastSavedAt;
        if not Session.WorldSelected or (Session.World.Metadata.Id <> World.Metadata.Id) then
          LastSavedAt := 0;
        end if;

        return Ok(
          Session with World := Projection.World; WorldSelected := true; State := Some(Valid); Interior := Interior; Dirty := Dirty; LastSavedAt := LastSavedAt; end with
        );
      end;
  end case;
end function;

// Handles lifecycle intentions only; None delegates the message to normal game rules.
public function HandleWorldMessage(
  Session: SessionUnit.ServerSession;
  Message: Protocol.ClientMessage;
  ConnectionValue: Net.Connection;
  Config: ConfigUnit.ServerConfig;
  Token: Tasks.CancellationToken
): result of (option of SessionUnit.ServerSession, string);
begin
  const Active: boolean := (Session.State is Some(_));
  var Next: SessionUnit.ServerSession := Session;
  case Message of
    when Protocol.ClientMessage.ListWorlds(const Offset, const DiscardProgress):
      begin
        if Active and Session.Dirty and not DiscardProgress then
          return Ok(
            Some(
              try RejectWorld(
                Session,
                Config,
                ConnectionValue,
                'discard_required',
                'Confirm discarding unsaved progress or cancel.',
                Token
              )
            )
          );
        end if;
        var Id: string := Config.WorldId;
        if Session.WorldSelected then
          Id := Session.World.Metadata.Id;
        end if;

        case CatalogFor(Config, Id, Offset) of
          when Error(const Reason):
            begin
              return Ok(
                Some(
                  try RejectWorld(
                    Session,
                    Config,
                    ConnectionValue,
                    'storage_error',
                    'Cannot list worlds. Check storage and server settings.',
                    Token
                  )
                )
              );
            end;
          when Ok(const Catalog):
            begin
              const Sent: boolean := try Replies.SendMessage(
                ConnectionValue,
                Protocol.ServerMessage.Worlds(Catalog),
                Token
              );
              Next.State := None;
              Next.Interior := None;
              Next.Dirty := false;
              return Ok(Some(Next));
            end;
        end case;
      end;
    when Protocol.ClientMessage.SelectWorld(const Id):
      begin
        if Active then
          return Ok(
            Some(
              try RejectWorld(
                Session,
                Config,
                ConnectionValue,
                'session_already_started',
                'Return to world selection first.',
                Token
              )
            )
          );
        end if;

        case CatalogUnit.OpenExistingWorld(Config.WorldsRoot, Id, Config.ChunkCacheLimit) of
          when Error(const Failure):
            begin
              var Code: string := 'world_incompatible';
              var Reason: string := 'World is incompatible. Delete or recreate it.';
              case Failure of
                when CatalogUnit.WorldAccessFailure.Missing:
                  begin
                    Code := 'world_missing';
                    Reason := 'World is missing. Create a world or select another.';
                  end;
                when CatalogUnit.WorldAccessFailure.Io(const Detail):
                  begin
                    Code := 'storage_error';
                    Reason := 'World storage access failed.';
                  end;
                when CatalogUnit.WorldAccessFailure.Incompatible(_):
                  begin
                    null;
                  end;
              end case;

              return Ok(
                Some(try RejectWorld(Session, Config, ConnectionValue, Code, Reason, Token))
              );
            end;
          when Ok(const World):
            begin
              case CatalogFor(Config, Id, -1) of
                when Error(const Reason):
                  begin
                    return Ok(
                      Some(
                        try RejectWorld(
                          Session,
                          Config,
                          ConnectionValue,
                          'storage_error',
                          'Cannot prepare world selection.',
                          Token
                        )
                      )
                    );
                  end;
                when Ok(const Catalog):
                  begin
                    const Sent: boolean := try Replies.SendMessage(
                      ConnectionValue,
                      Protocol.ServerMessage.Worlds(Catalog),
                      Token
                    );
                    Logging.LogServer(Config.Logs, 'world', 'Selected world ' + Id);
                    var LastSavedAt: integer := Session.LastSavedAt;
                    if not Session.WorldSelected
                      or
                      (Session.World.Metadata.Id <> World.Metadata.Id)
                    then
                      LastSavedAt := 0;
                    end if;

                    return Ok(
                      Some(
                        Session with World := World; WorldSelected := true; LastSavedAt := LastSavedAt; end with
                      )
                    );
                  end;
              end case;
            end;
        end case;
      end;
    when Protocol.ClientMessage.CreateWorld(const Seed, const RegionChunks):
      begin
        if Active then
          return Ok(
            Some(
              try RejectWorld(
                Session,
                Config,
                ConnectionValue,
                'session_already_started',
                'Return to world selection first.',
                Token
              )
            )
          );
        end if;

        case CreationDefaults(Config) of
          when Error(const Reason):
            begin
              return Ok(
                Some(
                  try RejectWorld(
                    Session,
                    Config,
                    ConnectionValue,
                    'storage_error',
                    'Cannot read server defaults.',
                    Token
                  )
                )
              );
            end;
          when Ok(const Defaults):
            begin
              null;
            end;
        end case;

        case CatalogUnit.CreateWorld(Config.WorldsRoot, Seed, RegionChunks, Config.ChunkCacheLimit) of
          when Error(const Reason):
            begin
              Logging.LogServer(Config.Logs, 'error', Reason);
              return Ok(
                Some(
                  try RejectWorld(
                    Session,
                    Config,
                    ConnectionValue,
                    'create_failed',
                    'Cannot create world. Check parameters and storage access.',
                    Token
                  )
                )
              );
            end;
          when Ok(const World):
            begin
              Logging.LogServer(Config.Logs, 'world', 'Created world ' + World.Metadata.Id);
              return Ok(
                Some(
                  try InstallGame(
                    Session,
                    World,
                    GameState.NewGame(World.Metadata),
                    None,
                    true,
                    ConnectionValue,
                    Config,
                    Token
                  )
                )
              );
            end;
        end case;
      end;
    when Protocol.ClientMessage.StartNewGame:
      begin
        if Active then
          return Ok(
            Some(
              try RejectWorld(
                Session,
                Config,
                ConnectionValue,
                'session_already_started',
                'A game session is already active.',
                Token
              )
            )
          );
        end if;

        if not Session.WorldSelected then
          return Ok(
            Some(
              try RejectWorld(
                Session,
                Config,
                ConnectionValue,
                'world_unavailable',
                'Select a compatible world first.',
                Token
              )
            )
          );
        end if;

        return Ok(
          Some(
            try InstallGame(
              Session,
              Session.World,
              GameState.NewGame(Session.World.Metadata),
              None,
              true,
              ConnectionValue,
              Config,
              Token
            )
          )
        );
      end;
    when Protocol.ClientMessage.LoadGame:
      begin
        if Active then
          return Ok(
            Some(
              try RejectWorld(
                Session,
                Config,
                ConnectionValue,
                'session_already_started',
                'A game session is already active.',
                Token
              )
            )
          );
        end if;

        if not Session.WorldSelected then
          return Ok(
            Some(
              try RejectWorld(
                Session,
                Config,
                ConnectionValue,
                'world_unavailable',
                'Select a compatible world first.',
                Token
              )
            )
          );
        end if;

        case Savegame.LoadSaveGame(Session.World) of
          when Error(const Failure):
            begin
              const Rejection: FailuresUnit.FailureRejection := FailuresUnit.PersistenceRejection(
                Session.World.Metadata.Id,
                'load_failed',
                Failure
              );
              return Ok(
                Some(
                  try RejectWorld(
                    Session,
                    Config,
                    ConnectionValue,
                    Rejection.Code,
                    Rejection.Message,
                    Token
                  )
                )
              );
            end;
          when Ok(const Loaded):
            begin
              case Loaded of
                when Savegame.SaveGameLoad.Missing:
                  begin
                    return Ok(
                      Some(
                        try InstallGame(
                          Session,
                          Session.World,
                          GameState.NewGame(Session.World.Metadata),
                          None,
                          true,
                          ConnectionValue,
                          Config,
                          Token
                        )
                      )
                    );
                  end;
                when Savegame.SaveGameLoad.Invalid(const Reason):
                  begin
                    return Ok(
                      Some(
                        try RejectWorld(
                          Session,
                          Config,
                          ConnectionValue,
                          'save_incompatible',
                          'Saved game is incompatible and was kept. Start over or recreate it.',
                          Token
                        )
                      )
                    );
                  end;
                when Savegame.SaveGameLoad.Loaded(const State, const View):
                  begin
                    Logging.LogServer(
                      Config.Logs,
                      'world',
                      'Loaded world ' + Session.World.Metadata.Id
                    );
                    return Ok(
                      Some(
                        try InstallGame(
                          Session,
                          Session.World,
                          State,
                          View.Interior,
                          false,
                          ConnectionValue,
                          Config,
                          Token
                        )
                      )
                    );
                  end;
              end case;
            end;
        end case;
      end;
    when Protocol.ClientMessage.SaveGame, Protocol.ClientMessage.OverwriteSaveGame:
      begin
        if not Active then
          return Ok(
            Some(
              try RejectWorld(
                Session,
                Config,
                ConnectionValue,
                'session_not_started',
                'Start or continue a game first.',
                Token
              )
            )
          );
        end if;

        if (Message = Protocol.ClientMessage.SaveGame)
          and
          Fs.Exists(Savegame.SaveGamePath(Session.World))
        then
          return Ok(
            Some(
              try RejectWorld(
                Session,
                Config,
                ConnectionValue,
                'overwrite_required',
                'Confirm overwriting the existing save or cancel.',
                Token
              )
            )
          );
        end if;

        case Savegame.WriteSaveGame(
          Session.World,
          try SessionUnit.RequireActiveState(Session.State)
        ) of
          when Error(const Failure):
            begin
              const Rejection: FailuresUnit.FailureRejection := FailuresUnit.PersistenceRejection(
                Session.World.Metadata.Id,
                'save_failed',
                Failure
              );
              return Ok(
                Some(
                  try RejectWorld(
                    Session,
                    Config,
                    ConnectionValue,
                    Rejection.Code,
                    Rejection.Message,
                    Token
                  )
                )
              );
            end;
          when Ok(const Written):
            begin
              const Sent: boolean := try Replies.SendMessage(
                ConnectionValue,
                Protocol.ServerMessage.SaveCompleted,
                Token
              );
              Logging.LogServer(Config.Logs, 'world', 'Saved world ' + Session.World.Metadata.Id);
              return Ok(
                Some(Session with Dirty := false; LastSavedAt := Time.TimestampMillis(); end with)
              );
            end;
        end case;
      end;
    when Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.Disconnect:
      begin
        return Ok(None);
      end;
  end case;
end function;
end unit;
