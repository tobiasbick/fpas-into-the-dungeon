// Stable world-lifecycle facade routing each intention to its concrete prerequisite owner.
unit Dungeon.Server.Worlds;

uses Dungeon.Protocol as Protocol, Dungeon.Server.Config as ConfigUnit, Dungeon.Server.Worlds.Catalog as CatalogPages, Dungeon.Server.Session as SessionUnit, Std.Net as Net, Std.Tasks as Tasks, Dungeon.Server.Worlds.Selection as Selection, Dungeon.Server.Worlds.Creation as Creation, Dungeon.Server.Worlds.Persistence as Persistence;

// Keeps the existing catalog/default seam for the handshake and internal tests.
public function CreationDefaults(Config: ConfigUnit.ServerConfig): result of (Protocol.WorldCatalog, string);
begin
  return CatalogPages.CreationDefaults(Config);
end function;

// Builds the fully inspected page and selected-world facts without modifying storage.
public function CatalogFor(Config: ConfigUnit.ServerConfig; SelectedId: string; RequestedOffset: integer): result of (Protocol.WorldCatalog, string);
begin
  return CatalogPages.CatalogFor(Config, SelectedId, RequestedOffset);
end function;

// Creates an idle session with existing-only preselection; never creates world content.
public function NewServerSession(Config: ConfigUnit.ServerConfig; Viewport: SessionUnit.ViewportSize): result of (SessionUnit.ServerSession, string);
begin
  return Selection.NewServerSession(Config, Viewport);
end function;

// Routes lifecycle messages to concrete owners; None delegates all other messages to gameplay.
public function HandleWorldMessage(Session: SessionUnit.ServerSession; Message: Protocol.ClientMessage; ConnectionValue: Net.Connection; Config: ConfigUnit.ServerConfig; Token: Tasks.CancellationToken): result of (option of SessionUnit.ServerSession, string);
begin
  case Message of
    when Protocol.ClientMessage.ListWorlds(const Offset, const DiscardProgress):
      return Ok(
        Some(
          try Selection.ListCatalog(
            Session,
            Offset,
            DiscardProgress,
            ConnectionValue,
            Config,
            Token
          )
        )
      );
    when Protocol.ClientMessage.SelectWorld(const Id):
      return Ok(Some(try Selection.SelectWorld(Session, Id, ConnectionValue, Config, Token)));
    when Protocol.ClientMessage.CreateWorld(const Seed, const RegionChunks):
      return Ok(
        Some(try Creation.CreateGame(Session, Seed, RegionChunks, ConnectionValue, Config, Token))
      );
    when Protocol.ClientMessage.StartNewGame:
      return Ok(Some(try Creation.StartGame(Session, ConnectionValue, Config, Token)));
    when Protocol.ClientMessage.LoadGame:
      return Ok(Some(try Persistence.LoadGame(Session, ConnectionValue, Config, Token)));
    when Protocol.ClientMessage.SaveGame:
      return Ok(Some(try Persistence.SaveGame(Session, false, ConnectionValue, Config, Token)));
    when Protocol.ClientMessage.OverwriteSaveGame:
      return Ok(Some(try Persistence.SaveGame(Session, true, ConnectionValue, Config, Token)));
    when Protocol.ClientMessage.DialogueChoice(_, _), Protocol.ClientMessage.TradeBuy(_, _, _), Protocol.ClientMessage.TradeSell(_, _, _), Protocol.ClientMessage.TradePage(_, _, _), Protocol.ClientMessage.EndTrade(_), Protocol.ClientMessage.EndDialogue, Protocol.ClientMessage.Hello(_, _, _), Protocol.ClientMessage.Viewport(_, _), Protocol.ClientMessage.ExplorationMap(_, _, _, _), Protocol.ClientMessage.Move(_, _), Protocol.ClientMessage.StepFirstPerson(_), Protocol.ClientMessage.TurnFirstPerson(_), Protocol.ClientMessage.Interact, Protocol.ClientMessage.Attack, Protocol.ClientMessage.Wait, Protocol.ClientMessage.Equip(_), Protocol.ClientMessage.Unequip(_), Protocol.ClientMessage.DropItem(_), Protocol.ClientMessage.UseItem(_), Protocol.ClientMessage.Disconnect:
      begin
        return Ok(None);
      end;
  end case;
end function;
end unit;
