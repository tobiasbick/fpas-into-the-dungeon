// Responsive server-owned connection settings; quota-bearing tests are always explicitly labeled.
unit Dungeon.Server.Console.Gamemaster.View;

uses
  Dungeon.RuntimeData.Gamemaster as Settings, Dungeon.Server.Console.Gamemaster.Model as Model,
  Dungeon.Server.Console.Gamemaster.Input as Input, Dungeon.Server.Console.Log as Log,
  Std.Conv as Conv, Std.Math as Math, Std.Tui as Tui;

function Button(Id: integer; Text: string): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeButton(
    Tui.TuiControlId.Create(Id),
    Text,
    Tui.TuiAction.Create(Id)
  );
end function;

function LabelText(Text: string; Width: integer): Tui.TuiElement;
begin
  const Clean := Log.SingleLine(Text);
  return Tui.TuiElementBuilders.MakeLabel(Clean.Slice(0, Math.Min(Clean.Length(), Width)));
end function;

// Paged native lists fit a slow provider's loading/error state as well as large catalogs.
public function View(State: Model.Draft; Width: integer; Height: integer): Tui.TuiElement;
begin
  const BodyWidth := Math.Clamp(Width - 8, 16, 92);
  const Rows := Input.PageSize(Height);
  const Offset := State.Row div Rows * Rows;
  var Labels: array of string := [];
  for Index: integer := Offset to Math.Min(Offset + Rows, State.Choices.Length()) - 1 do
    const Choice := State.Choices[Index];
    const Text := Choice.LabelText + ' [' + Choice.Id + ']';
    Labels.PushInPlace(Text.Slice(0, Math.Min(Text.Length(), BodyWidth)));
  end for;
  var Selected := -1;
  if Labels.Length() > 0 then
    Selected := State.Row - Offset;
  end if;
  var Save := Tui.TuiElementBuilders.MakeLabel('Save unavailable: apply a model first');
  if not State.Pending
    and
    (State.Acknowledged or (State.Selection.Connection = Settings.ConnectionKind.Unconfigured))
  then
    Save := Button(65, 'Save');
  end if;
  var Items := [
    LabelText('Connection: ' + Settings.ConnectionName(State.Selection.Connection), BodyWidth),
    Tui.TuiElementBuilders.MakeRowSpaced(
      [Button(60, 'Codex'), Button(61, 'Pi'), Button(67, 'Clear')],
      1
    ),
    LabelText(State.Message, BodyWidth),
    Tui.TuiElementBuilders.MakeList(
      Tui.TuiControlId.Create(62),
      Labels,
      Selected,
      Tui.TuiAction.Create(62)
    ),
    LabelText('Model: ' + State.Selection.ModelId, BodyWidth),
    LabelText(
      Conv.IntToStr(State.Choices.Length()) + ' models / arrows browse, Enter applies',
      BodyWidth
    ),
    Tui.TuiElementBuilders.MakeRowSpaced(
      [Button(68, 'Previous'), Button(69, 'Next'), Button(63, 'Refresh models')],
      1
    ),
    LabelText('Model request; may use quota.', BodyWidth),
    Button(64, 'Test connection'),
    Tui.TuiElementBuilders.MakeRowSpaced([Save, Button(66, 'Cancel / Back')], 2)
  ];
  return Tui.TuiElementBuilders.MakeOverlay(
    'Gamemaster / all worlds',
    [Tui.TuiElementBuilders.MakeColumn(Items)]
  );
end function;
end unit;
