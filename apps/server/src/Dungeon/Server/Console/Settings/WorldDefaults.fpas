// Responsive world-default form with shared landscape presets and editable creation parameters.
unit Dungeon.Server.Console.Settings.WorldDefaults;

uses
  Dungeon.Server.Console.Model as Model, Dungeon.Ui.WorldSeeds as Seeds,
  Dungeon.Ui.Text as UiText, Std.Math as Math, Std.Ui.Terminal as Tui;

function Label(Text: string; Width: integer): Tui.TuiElement;
begin
  return Tui.TuiElementBuilders.MakeLabel(
    Text.Slice(0, Math.Min(Text.Length(), Math.Max(1, Width)))
  );
end function;

// Outer overlay dimensions include the frame, shared footer, tab bar and content inset.
public function View(State: Model.ConsoleModel; Width: integer; Height: integer): Tui.TuiElement;
begin
  const BodyWidth := Math.Max(1, Width - 20);
  const Compact := (Width < 60) or (Height < 17);
  var Items: array of Tui.TuiElement := [];
  if Height >= 17 then
    Items := [
      Tui.TuiElementBuilders.MakeHeading('WORLD DEFAULTS'),
      Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Fixed(1))
    ];
  end if;

  Items := Items.Concat([
    Label(
      if Compact then 'Seed: signed 32-bit' else 'Seed: -2147483648 through 2147483647' end if,
      BodyWidth
    ),
    Tui.TuiElementBuilders.MakeInput(
      Tui.TuiControlId.Create(10), State.SeedText, State.SeedCaret, Tui.TuiAction.Create(10)
    )
  ]);
  if not Compact then
    Items.PushInPlace(Label(Seeds.Description(State.SeedText), BodyWidth));
  end if;

  Items.PushInPlace(Seeds.Choices(State.SeedText, 12, Compact));
  if Height >= 17 then
    Items.PushInPlace(Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Fixed(1)));
  end if;

  Items := Items.Concat([
    Label(
      if Compact then 'Region: 1-16' else 'Entrance region: 1 through 16 chunks' end if,
      BodyWidth
    ),
    Tui.TuiElementBuilders.MakeInput(
      Tui.TuiControlId.Create(11), State.RegionText, State.RegionCaret, Tui.TuiAction.Create(11)
    )
  ]);
  if State.SettingsError <> '' then
    for Line: string in UiText.Wrap(State.SettingsError, BodyWidth) do
      Items.PushInPlace(
        Tui.TuiElement.Label(Tui.TuiLabel(Text := Line, Role := Tui.TuiStyleRole.Failure))
      );
    end for;
  elsif not Compact then
    Items.PushInPlace(Label('Larger region = fewer dungeon entrances.', BodyWidth));
  end if;

  return Tui.TuiElementBuilders.MakeColumn(Items);
end function;
end unit;
