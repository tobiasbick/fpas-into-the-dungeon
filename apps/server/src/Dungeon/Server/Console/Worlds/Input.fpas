// Native list, paging and confirmation input for server-side world administration.
unit Dungeon.Server.Console.Worlds.Input;

uses Dungeon.Server.Console.Worlds.Model as Model, Std.Console as Console, Std.Tui as Tui;

// Routes only management controls; confirmation owns input until explicitly cancelled or confirmed.
public function Update(State: Model.WorldManager; Msg: Tui.TuiMsg; Height: integer; Cmd: Tui.TuiCmdOutput): Model.WorldManager;
begin
  case Msg of
    when Tui.TuiMsg.QuitRequested:
      if State.Confirmation is Some(_) then
        return State with Confirmation := None; Focus := 40; Message := ''; end with;
      end if;

      return State with Open := false; end with;
    when Tui.TuiMsg.FocusChanged(_, const Current):
      case Current of
        when Some(const Id):
          if State.Confirmation is Some(_) then
            if (Id.Value = 46) or (Id.Value = 47) then
              return State with Focus := Id.Value; end with;
            end if;
          elsif (Id.Value >= 40) and (Id.Value <= 45) then
            return State with Focus := Id.Value; end with;
          end if;
        when None:
          null;
      end case;
    when Tui.TuiMsg.SelectionChanged(const Source, const Action, const Index):
      if State.Confirmation is None and (Source.Value = 40) and (Action.Value = 40)
        and
        (Index >= 0) and (Index < Model.VisibleCount(State, Height))
      then
        return State with Row := Index; Message := ''; end with;
      end if;
    when Tui.TuiMsg.Action(const Source, const Action):
      if Source.Value <> Action.Value then
        return State;
      end if;

      if State.Confirmation is Some(_) then
        if Action.Value = 46 then
          return Model.ConfirmDeletion(State);
        elsif Action.Value = 47 then
          return State with Confirmation := None; Focus := 40; Message := ''; end with;
        end if;
      else
        case Action.Value of
          when 40, 42:
            return Model.RequestDeletion(State);
          when 41:
            return Model.Refresh(State, State.Catalog.Offset);
          when 43:
            return State with Open := false; end with;
          when 44:
            return Model.Refresh(State, State.Catalog.Offset - Model.PageSize(Height));
          when 45:
            if State.Catalog.Offset + Model.VisibleCount(State, Height) < State.Catalog.Total then
              return Model.Refresh(State, State.Catalog.Offset + Model.VisibleCount(State, Height));
            end if;
          else
            null;
        end case;
      end if;
    when Tui.TuiMsg.Key(const Value):
      const Key: Console.KeyEvent := Value;
      if (Key.alt and ((Key.ch = 'x') or (Key.ch = 'X')))
        or
        (Key.ctrl and ((Key.ch = 'c') or (Key.ch = 'C')))
      then
        Cmd.Set(Tui.TuiCmd.Quit);
        return State;
      end if;

      if Key.kind = Tui.TuiKeyKind.Escape then
        if State.Confirmation is Some(_) then
          return State with Confirmation := None; Focus := 40; Message := ''; end with;
        end if;

        return State with Open := false; end with;
      end if;

      if Key.ctrl or Key.alt or Key.meta then
        return State;
      end if;

      if State.Confirmation is Some(_) then
        if (Key.ch = 'y') or (Key.ch = 'Y') then
          return Model.ConfirmDeletion(State);
        elsif (Key.ch = 'n') or (Key.ch = 'N') then
          return State with Confirmation := None; Focus := 40; Message := ''; end with;
        end if;
      else
        if (Key.ch = 'd') or (Key.ch = 'D') then
          return Model.RequestDeletion(State);
        elsif (Key.ch = 'r') or (Key.ch = 'R') then
          return Model.Refresh(State, State.Catalog.Offset);
        elsif Key.kind = Tui.TuiKeyKind.F4 then
          return State with Open := false; end with;
        end if;
      end if;
    when Tui.TuiMsg.Started, Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _):
      null;
  end case;

  return State;
end function;
end unit;
