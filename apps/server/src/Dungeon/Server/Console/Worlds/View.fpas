// Responsive native world list and identity-bound permanent-deletion confirmation.
unit Dungeon.Server.Console.Worlds.View;

uses Dungeon.Server.Console.Worlds.Model as Model, Dungeon.Server.Console.Layout as Layout, Dungeon.Server.Console.Log as LogUnit, Dungeon.Ui.Overlay as Overlay, Std.Text.Format as Conv, Std.Math as Math, Std.Ui.Terminal as Tui;

function Fit(Text: string; Width: integer): string;
begin
  if Text.Length() <= Width then
    return Text;
  end if;

  return Text.Slice(0, Width);
end function;

function Labels(Text: string; Width: integer; Limit: integer): array of Tui.TuiElement;
begin
  const Clean := LogUnit.SingleLine(Text);
  var Lines: array of Tui.TuiElement := [];
  var Offset := 0;
  while (Offset < Clean.Length()) and (Lines.Length() < Limit) do
    var Take := Math.Min(Width, Clean.Length() - Offset);
    if Offset + Take < Clean.Length() then
      var Split := Take;
      while (Split > 0) and (Clean[Offset + Split] <> ' ') do
        Split := Split - 1;
      end while;

      if Split > 0 then
        Take := Split;
      end if;
    end if;
    var Line := Clean.Slice(Offset, Take);
    Offset := Offset + Take;
    while (Offset < Clean.Length()) and (Clean[Offset] = ' ') do
      Offset := Offset + 1;
    end while;

    if (Lines.Length() + 1 = Limit) and (Offset < Clean.Length()) then
      Line := Line.Slice(0, Math.Min(Line.Length(), Width - 1)) + '…';
    end if;

    Lines.PushInPlace(Tui.TuiElementBuilders.MakeLabel(Line));
  end while;

  return Lines;
end function;

function Button(Id: integer; Text: string): Tui.TuiElement;
begin
  if (Id = 42) or (Id = 46) then
    return Tui.TuiElementBuilders.MakeButtonOfKind(
      Tui.TuiControlId.Create(Id),
      Text,
      Tui.TuiAction.Create(Id),
      Tui.TuiButtonKind.Dangerous
    );
  elsif (Id = 43) or (Id = 47) then
    return Tui.TuiElementBuilders.MakeButtonOfKind(
      Tui.TuiControlId.Create(Id),
      Text,
      Tui.TuiAction.Create(Id),
      Tui.TuiButtonKind.Cancel
    );
  end if;

  return Tui.TuiElementBuilders.MakeButton(
    Tui.TuiControlId.Create(Id),
    Text,
    Tui.TuiAction.Create(Id)
  );
end function;

// Shows incompatible worlds without opening them; Cancel receives initial confirmation focus.
public function View(State: Model.WorldManager; Width: integer; Height: integer): Tui.TuiElement;
begin
  const Size := Layout.WorldsSize(Width, Height);
  const BodyWidth := Math.Max(1, Size.Width - 4);
  const Compact := Size.Height < 17;
  var Items: array of Tui.TuiElement := [];
  case State.Confirmation of
    when Some(const Id):
      Items := Labels('Delete world ' + Id + '?', BodyWidth, 2);
      if not Compact then
        Items.PushInPlace(Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Fixed(1)));
      end if;

      Items := Items.Concat(
        Labels('Permanently removes its save, chunks and dungeon levels.', BodyWidth, 2)
      );
      Items := Items.Concat(Labels(State.Message, BodyWidth, 2));
      Items.PushInPlace(Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Expanding(0)));
      Items.PushInPlace(
        Tui.TuiElementBuilders.MakeRow(
          [
            Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Expanding(0)),
            Button(46, if BodyWidth < 30 then 'Delete' else 'Delete permanently' end if),
            Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Fixed(1)),
            Button(47, 'Cancel')
          ]
        )
      );
      return Overlay.Responsive(
        'Confirm world deletion', Layout.WorldsRule(), Items
      );
    when None:
      null;
  end case;
  var Rows: array of string := [];
  const Count := Model.VisibleCount(State, Height);
  for Index: integer := 0 to Count - 1 do
    const World := State.Catalog.Worlds[Index];
    Rows.PushInPlace(
      Fit(
        Fit(World.Id, 18).PadRight(19, ' ') +
        World.Status.PadRight(14, ' ') + World.SaveStatus, Math.Max(1, BodyWidth - 2)
      )
    );
  end for;
  var SelectedRow := -1;
  if Count > 0 then
    SelectedRow := Math.Clamp(State.Row, 0, Count - 1);
  end if;
  var Range := 'No worlds.';
  if Count > 0 then
    Range := Conv.IntToStr(State.Catalog.Offset + 1) + '-' +
      Conv.IntToStr(State.Catalog.Offset + Count) + ' of ' + Conv.IntToStr(State.Catalog.Total);
  end if;

  Items.PushInPlace(Tui.TuiElementBuilders.MakeLabel(Range));
  const ListSettings := Tui.TuiLayoutSettings.Create(
    Tui.TuiMargins.Uniform(0), Tui.TuiSizePolicy.Expanding(), Tui.TuiAlignment.Fill(), 0
  ).WithFixedWidth(BodyWidth);
  Items.PushInPlace(
    Tui.TuiElementBuilders.MakeLayout(
      ListSettings,
      Tui.TuiElementBuilders.MakePanel(
        '', [
          Tui.TuiElementBuilders.MakeHeading(
            Fit('  World              Status        Save', Math.Max(1, BodyWidth - 2))
          ),
          Tui.TuiElementBuilders.MakeList(
            Tui.TuiControlId.Create(40), Rows, SelectedRow, Tui.TuiAction.Create(40)
          )
        ]
      )
    )
  );
  if not Compact or (State.Message = '') then
    case Model.Selected(State) of
      when Some(const World):
        Items := Items.Concat(
          Labels(
            World.Id + ': ' + World.SaveStatus + ' ' + World.Reason, BodyWidth,
            if Compact or (State.Message <> '') then 1 else 2 end if
          )
        );
      when None:
        null;
    end case;
  end if;

  Items := Items.Concat(Labels(State.Message, BodyWidth, if Compact then 1 else 2 end if));
  Items.PushInPlace(Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Expanding(0)));
  var Pages: array of Tui.TuiElement := [];
  if State.Catalog.Offset > 0 then
    Pages.PushInPlace(Button(44, 'Previous'));
  end if;

  if State.Catalog.Offset + Count < State.Catalog.Total then
    Pages.PushInPlace(Button(45, 'Next'));
  end if;

  Pages.PushInPlace(Button(41, 'Refresh'));
  if BodyWidth >= 58 then
    Pages := Pages.Concat([
      Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Expanding(0)),
      Button(42, 'Delete world'), Button(43, 'Close')
    ]);
    Items.PushInPlace(Tui.TuiElementBuilders.MakeRowSpaced(Pages, 1));
  else
    Items.PushInPlace(Tui.TuiElementBuilders.MakeRowSpaced(Pages, 1));
    Items.PushInPlace(
      Tui.TuiElementBuilders.MakeRow([
        Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Expanding(0)),
        Button(42, if BodyWidth < 24 then 'Delete' else 'Delete world' end if),
        Tui.TuiElementBuilders.MakeSpacer(Tui.TuiSpacer.Fixed(1)), Button(43, 'Close')
      ])
    );
  end if;

  return Overlay.Responsive('Worlds', Layout.WorldsRule(), Items);
end function;
end unit;
