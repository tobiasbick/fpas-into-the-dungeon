// Responsive dashboard geometry retaining the log and shortcut footer at short sizes.
unit Dungeon.Server.Console.Layout;

uses Std.Ui.Terminal as Tui;

// Settings use the shared viewport-relative overlay policy on every tab.
public function SettingsRule(): Tui.TuiOverlaySizeRule;
begin
  return Tui.TuiOverlaySizeRule.Create(Tui.TuiSize.Create(72, 17), 4, 25);
end function;

// Resolves the same outer dimensions used by the TUI for content layout and paging.
public function SettingsSize(Width: integer; Height: integer): Tui.TuiSize;
begin
  return SettingsRule().Resolve(Tui.TuiSize.Create(Width, Height));
end function;

// Wide terminals dock summaries; narrow tall terminals stack, short ones use a compact summary.
public type DashboardLayout = record
  public Width: integer;
  public Height: integer;
  public Wide: boolean;
  public Compact: boolean;
  public SummaryHeight: integer;
  public LogHeight: integer;
  public LogRows: integer;
end record;

// Bounds invalid synthetic extents and computes the exact native scroll viewport height.
public function ResolveLayout(Width: integer; Height: integer): DashboardLayout;
begin
  var W: integer := Width;
  var H: integer := Height;
  if W < 0 then
    W := 0;
  end if;

  if H < 0 then
    H := 0;
  end if;
  const Wide: boolean := W >= 100;
  const Compact: boolean := (H < 18) or (not Wide and (H < 32));
  var Summary: integer := 8;
  if not Wide then
    Summary := 24;
  end if;

  if Compact then
    Summary := 3;
  end if;
  var HeaderHeight := 3;
  if H < 18 then
    HeaderHeight := 0;
  end if;
  var LogHeight: integer := H - Summary - 4 - HeaderHeight;
  if LogHeight < 0 then
    LogHeight := 0;
  end if;
  var Rows: integer := LogHeight - 6;
  if Rows < 1 then
    Rows := 1;
  end if;

  return DashboardLayout(
    Width := W, Height := H, Wide := Wide, Compact := Compact,
    SummaryHeight := Summary, LogHeight := LogHeight, LogRows := Rows
  );
end function;
end unit;
