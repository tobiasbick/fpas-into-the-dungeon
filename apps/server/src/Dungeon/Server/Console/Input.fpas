// Dashboard control validation, log navigation and modal settings/world-management routing.
unit Dungeon.Server.Console.Input;

uses Dungeon.Server.Console.Model as ModelUnit, Dungeon.Server.Console.Gamemaster.Model as GmModel, Dungeon.Server.Console.Gamemaster.Input as GmInput, Dungeon.Server.Console.Log as LogUnit, Dungeon.Server.Console.Layout as LayoutUnit, Dungeon.Server.Console.Worlds.Model as WorldModel, Dungeon.Server.Console.Worlds.Input as WorldInput, Dungeon.Server.Logging as Logging, Std.Console as Console, Std.Text.Format as Conv, Std.Math as Math, Std.Time as Time, Std.Ui.Terminal as Tui;

function OpenSettings(State: ModelUnit.ConsoleModel): ModelUnit.ConsoleModel;
begin
  const Seed := Conv.IntToStr(State.Seed);
  const Region := Conv.IntToStr(State.RegionChunks);
  return State with SettingsOpen := true; SettingsTab := 0; FocusedControl := 70; SettingsError := ''; SeedText := Seed; SeedCaret := Seed.Length(); RegionText := Region; RegionCaret := Region.Length(); end with;
end function;

function CloseSettings(State: ModelUnit.ConsoleModel): ModelUnit.ConsoleModel;
begin
  var Draft := State.Gamemaster;
  if Draft.Open then
    Draft := GmModel.Close(Draft);
  end if;

  return State with SettingsOpen := false; SettingsTab := 0; FocusedControl := 20; Gamemaster := Draft; end with;
end function;

function SelectSettingsTab(State: ModelUnit.ConsoleModel; Selected: integer): ModelUnit.ConsoleModel;
begin
  if not State.SettingsOpen or (Selected < 0) or (Selected > 1) then
    return State;
  end if;
  var Draft := State.Gamemaster;
  if (Selected = 1) and not Draft.Open then
    Draft := GmModel.Open(Draft);
  end if;

  return State with SettingsTab := Selected; FocusedControl := 70; Gamemaster := Draft; end with;
end function;

function OpenWorlds(State: ModelUnit.ConsoleModel): ModelUnit.ConsoleModel;
begin
  const Worlds := WorldModel.Refresh(State.Worlds with Open := true; end with, 0);
  return State with Worlds := Worlds; FocusedControl := Worlds.Focus; end with;
end function;

// Ignores stale/invalid control events and keeps dashboard commands outside the settings modal.
public function UpdateDashboard(State: ModelUnit.ConsoleModel; Msg: Tui.TuiMsg; Cmd: Tui.TuiCmdOutput): ModelUnit.ConsoleModel;
begin
  Cmd.Set(Tui.TuiCmd.NoCommand);
  const TinySettings := State.SettingsOpen and ((State.Width < 40) or (State.Height < 12));
  case Msg of
    when Tui.TuiMsg.SelectionChanged(const Source, const Action, const Selected):
      if TinySettings then
        return State;
      end if;

      if (Source.Value = 70) and (Action.Value = 70) then
        return SelectSettingsTab(State, Selected);
      end if;
    when Tui.TuiMsg.Action(const Source, const Action):
      if TinySettings then
        if (Source.Value = 70) and (Action.Value = 70) then
          return CloseSettings(State);
        end if;

        return State;
      end if;
    when Tui.TuiMsg.Key(const Key):
      if TinySettings then
        if Key.kind = Tui.TuiKeyKind.Escape then
          return CloseSettings(State);
        end if;

        if (Key.kind = Tui.TuiKeyKind.Character)
          and
          (
            (Key.ctrl and ((Key.ch = 'c') or (Key.ch = 'C')))
            or
            (Key.alt and ((Key.ch = 'x') or (Key.ch = 'X')))
          )
        then
          Cmd.Set(Tui.TuiCmd.Quit);
        end if;

        return State;
      end if;
    when Tui.TuiMsg.QuitRequested:
      if TinySettings then
        return CloseSettings(State);
      end if;
    when Tui.TuiMsg.FocusChanged(_, Some(const Id)):
      if State.SettingsOpen and (Id.Value = 70) then
        return State with FocusedControl := 70; end with;
      end if;
    when Tui.TuiMsg.FocusChanged(_, None), Tui.TuiMsg.Started, Tui.TuiMsg.Pointer(_), Tui.TuiMsg.Tick(_), Tui.TuiMsg.Resize(_), Tui.TuiMsg.TextChanged(_, _, _, _), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.ScrollChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _), Tui.TuiMsg.BackgroundFailed(_, _, _, _, _, _):
      null;
  end case;

  if State.Gamemaster.Open and (State.SettingsTab = 1)
    and
    (
      (Msg is Tui.TuiMsg.Key(_)) or (Msg is Tui.TuiMsg.Action(_, _))
      or
      (Msg is Tui.TuiMsg.SelectionChanged(_, _, _)) or (Msg is Tui.TuiMsg.FocusChanged(_, _))
      or
      (Msg is Tui.TuiMsg.QuitRequested)
    )
  then
    const Size := LayoutUnit.SettingsSize(State.Width, State.Height);
    const Draft := GmInput.Update(
      State.Gamemaster,
      Msg,
      State.ConfigPath,
      Size.Width,
      Size.Height,
      Cmd
    );
    if not Draft.Open then
      return State with Gamemaster := Draft; SettingsTab := 0; FocusedControl := 70; end with;
    end if;

    if (State.FocusedControl = 70) and not (Msg is Tui.TuiMsg.FocusChanged(_, Some(_))) then
      return State with Gamemaster := Draft; end with;
    end if;

    return State with Gamemaster := Draft; FocusedControl := Draft.Focus; end with;
  end if;

  if State.Worlds.Open
    and
    (
      (Msg is Tui.TuiMsg.Key(_)) or (Msg is Tui.TuiMsg.Action(_, _))
      or
      (Msg is Tui.TuiMsg.SelectionChanged(_, _, _)) or (Msg is Tui.TuiMsg.FocusChanged(_, _))
      or
      (Msg is Tui.TuiMsg.QuitRequested)
    )
  then
    const Worlds := WorldInput.Update(State.Worlds, Msg, State.Height, Cmd);
    var Focus := Worlds.Focus;
    if not Worlds.Open then
      Focus := 20;
    end if;

    return State with Worlds := Worlds; FocusedControl := Focus; end with;
  end if;
  const Rows := LayoutUnit.ResolveLayout(State.Width, State.Height).LogRows;
  case Msg of
    when Tui.TuiMsg.Started:
      Cmd.RequestTick(1000);
    when Tui.TuiMsg.Tick(const Delta):
      Cmd.RequestTick(1000);
      if (Delta >= 0) and (Delta <= 9223372036854775807 - State.Uptime) then
        return State with Uptime := State.Uptime + Delta; end with;
      end if;
    when Tui.TuiMsg.Resize(const Size):
      const Layout := LayoutUnit.ResolveLayout(Size.Width, Size.Height);
      var Focus := State.FocusedControl;
      if State.SettingsOpen and ((Size.Width < 40) or (Size.Height < 12)) then
        Focus := 70;
      end if;
      var Worlds := State.Worlds;
      Worlds.Row := Math.Clamp(
        Worlds.Row,
        0,
        Math.Max(0, WorldModel.VisibleCount(Worlds, Layout.Height) - 1)
      );

      return State with Worlds := Worlds; Width := Layout.Width; Height := Layout.Height; FocusedControl := Focus; History := LogUnit.ResolveOffset(
        State.History,
        Layout.LogRows
      ); end with;
    when Tui.TuiMsg.FocusChanged(const Previous, const Current):
      case Current of
        when Some(const Id):
          if State.SettingsOpen then
            if (Id.Value = 10) or (Id.Value = 11) or (Id.Value = 2) or (Id.Value = 3)
              or
              (Id.Value = 6)
            then
              return State with FocusedControl := Id.Value; end with;
            end if;
          else
            if (Id.Value = 20) or ((Id.Value >= 30) and (Id.Value <= 33)) or (Id.Value = 1)
              or
              (Id.Value = 4) or (Id.Value = 5)
            then
              return State with FocusedControl := Id.Value; end with;
            end if;
          end if;
        when None:
          null;
      end case;
    when Tui.TuiMsg.Action(const Source, const Action):
      if Source.Value <> Action.Value then
        return State;
      end if;

      if State.SettingsOpen then
        if Action.Value = 2 then
          const Saved := ModelUnit.StoreConsoleSettings(State);
          if not Saved.SettingsOpen then
            return CloseSettings(Saved);
          end if;

          return Saved;
        end if;

        if Action.Value = 3 then
          return CloseSettings(State);
        end if;
      else
        if Action.Value = 1 then
          return OpenSettings(State);
        end if;

        if Action.Value = 5 then
          return OpenWorlds(State);
        end if;

        if Action.Value = 4 then
          Cmd.Set(Tui.TuiCmd.Quit);
        end if;

        if (Action.Value >= 30) and (Action.Value <= 33) then
          var Filter := LogUnit.LogFilter.All;
          if Action.Value = 31 then
            Filter := LogUnit.LogFilter.Info;
          end if;

          if Action.Value = 32 then
            Filter := LogUnit.LogFilter.Warnings;
          end if;

          if Action.Value = 33 then
            Filter := LogUnit.LogFilter.Errors;
          end if;

          return State with History := LogUnit.ChangeFilter(State.History, Filter, Rows); end with;
        end if;
      end if;
    when Tui.TuiMsg.ScrollChanged(const Source, const Action, const Offset):
      if not State.SettingsOpen and (Source.Value = 20) and (Action.Value = 20) and (Offset.X = 0) then
        var History := LogUnit.Scroll(State.History, Offset.Y, Rows);
        const Latest := LogUnit.FollowLatest(History, Rows);
        if History.Offset = Latest.Offset then
          History := Latest;
        end if;

        return State with History := History; end with;
      end if;
    when Tui.TuiMsg.TextChanged(const Source, const Action, const Text, const Caret):
      if not State.SettingsOpen or TinySettings or (State.SettingsTab <> 0) or (Text.Length() > 32)
        or
        (Caret < 0)
        or
        (Caret > Text.Length())
        or
        (Source.Value <> Action.Value)
      then
        return State;
      end if;

      if Source.Value = 10 then
        return State with SeedText := Text; SeedCaret := Caret; end with;
      end if;

      if Source.Value = 11 then
        return State with RegionText := Text; RegionCaret := Caret; end with;
      end if;
    when Tui.TuiMsg.Key(const Key):
      const KeyEvent: Console.KeyEvent := Key;
      if (KeyEvent.kind = Tui.TuiKeyKind.Character)
        and
        (
          (KeyEvent.ctrl and ((KeyEvent.ch = 'c') or (KeyEvent.ch = 'C')))
          or
          (KeyEvent.alt and ((KeyEvent.ch = 'x') or (KeyEvent.ch = 'X')))
        )
      then
        Cmd.Set(Tui.TuiCmd.Quit);
      end if;

      if State.SettingsOpen then
        if KeyEvent.kind = Tui.TuiKeyKind.Escape then
          return CloseSettings(State);
        end if;
      else
        if KeyEvent.kind = Tui.TuiKeyKind.F2 then
          return OpenSettings(State);
        end if;

        if KeyEvent.kind = Tui.TuiKeyKind.F4 then
          return OpenWorlds(State);
        end if;

        if KeyEvent.kind = Tui.TuiKeyKind.F3 then
          return State with History := LogUnit.ChangeFilter(
            State.History,
            LogUnit.NextFilter(State.History.Filter),
            Rows
          ); end with;
        end if;

        if KeyEvent.kind = Tui.TuiKeyKind.EndKey then
          return State with History := LogUnit.FollowLatest(State.History, Rows); end with;
        end if;
      end if;
    when Tui.TuiMsg.BackgroundFailed(const Id, const Kind, const Message, const Code, const Line, const Column):
      if Id = 2 then
        return State with Gamemaster := State.Gamemaster with Pending := false; Message := 'Gamemaster worker failed; refresh models'; end with; end with;
      end if;

      if Id = 1 then
        return ModelUnit.ApplyConsoleLog(
          State with ListenerStatus := 'Stopped'; Status := 'Stopped'; Connected := false; Dashboard := None; end with,
          Logging.ServerLogEvent(
            Kind := 'error',
            Text := Message,
            Timestamp := Time.TimestampMillis()
          )
        );
      end if;
    when Tui.TuiMsg.QuitRequested:
      if State.SettingsOpen then
        return CloseSettings(State);
      end if;

      Cmd.Set(Tui.TuiCmd.Quit);
    when Tui.TuiMsg.Pointer(_), Tui.TuiMsg.TextAreaChanged(_, _, _, _, _), Tui.TuiMsg.CheckChanged(_, _, _), Tui.TuiMsg.SelectionChanged(_, _, _), Tui.TuiMsg.MenuChanged(_, _, _):
      null;
  end case;

  return State;
end function;
end unit;
