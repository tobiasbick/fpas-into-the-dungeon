// Starts the authoritative dungeon server.
program DungeonServer;

uses Dungeon.Server, Std.Args, Std.Conv, Std.Results;

begin
  mutable var Host: string := '127.0.0.1';
  mutable var Port: integer := 4040;
  if ParamCount() > 2 then
  begin
    panic('usage: dungeon-server -- [HOST [PORT]]')
  end;

  if ParamCount() >= 1 then
  begin
    Host := ParamStr(0)
  end;

  if ParamCount() = 2 then
  begin
    Port := StrToInt(ParamStr(1))
  end;

  Unwrap(RunServer(Host, Port))
end.
