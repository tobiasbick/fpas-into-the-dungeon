// Starts the authoritative dungeon server.
program DungeonServer;

uses Dungeon.RuntimeData as RuntimeData, Dungeon.RuntimeData.Startup as Startup, Dungeon.Server as Server, Dungeon.Server.Config as ConfigUnit, Dungeon.Server.Console as ConsoleUnit, Std.Args as Args, Std.Console as Console;

begin
  var Arguments: array of string := [];
  for Index: integer := 0 to Args.ParamCount() - 1 do
    Arguments.PushInPlace(Args.ParamStr(Index));
  end for;

  case Startup.ParseArguments(Arguments := Arguments, ServerMode := true).Unwrap() of
    when Startup.StartupArguments.Help(const Text):
      Console.WriteText(Text);
    when Startup.StartupArguments.Ready(const Options):
      const Runtime := RuntimeData.LoadServerRuntime(Options.DataRoot).Unwrap();
      const Network := Startup.NetworkWithOverrides(Runtime.Network, Options);
      const WorldId := case Options.WorldId of
        when Some(const Id): Id;
        when None: Runtime.World.Id;
      end case;
      const Config := ConfigUnit.ServerConfig(
        ConfigPath := Runtime.Paths.ServerConfig,
        Logs := None,
        WorldsRoot := Runtime.Paths.Worlds,
        WorldId := WorldId,
        WorldSeed := Runtime.World.Seed,
        DungeonRegionChunks := Runtime.World.DungeonRegionChunks,
        ChunkCacheLimit := Runtime.World.ChunkCacheLimit,
        MaximumViewWidth := Runtime.World.MaximumViewWidth,
        MaximumViewHeight := Runtime.World.MaximumViewHeight
      );
      if Options.Console then
        discard ConsoleUnit.RunServerConsole(Network.Host, Network.Port, Config);
      else
        discard Server.RunServer(Network.Host, Network.Port, Config).Unwrap();
      end if;
  end case;
end.
