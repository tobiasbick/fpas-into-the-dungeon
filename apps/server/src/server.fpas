// Starts the authoritative dungeon server.
program DungeonServer;

uses Dungeon.RuntimeData, Dungeon.Server, Std.Args, Std.Conv, Std.Options, Std.Results;

begin
  mutable var DataRootOverride: option of string := None;
  mutable var HostOverride: option of string := None;
  mutable var PortOverride: option of integer := None;
  mutable var Index: integer := 0;
  mutable var Positional: integer := 0;
  while Index < ParamCount() do
  begin
    var Argument: string := ParamStr(Index);
    if Argument = '--data-dir' then
    begin
      if (Index + 1) >= ParamCount() then
      begin
        panic('usage: dungeon-server -- [--data-dir PATH] [HOST [PORT]]')
      end;

      DataRootOverride := Some(ParamStr(Index + 1));
      Index := Index + 2
    end
    else
    begin
      case Positional of
        0:
        begin
          HostOverride := Some(Argument)
        end;
        1:
        begin
          PortOverride := Some(StrToInt(Argument))
        end
        else
        begin
          panic('usage: dungeon-server -- [--data-dir PATH] [HOST [PORT]]')
        end
      end;

      Positional := Positional + 1;
      Index := Index + 1
    end
  end;
  var Runtime: RuntimeSettings := Std.Results.Unwrap(LoadServerRuntime(DataRootOverride));
  mutable var Host: string := Runtime.Network.Host;
  mutable var Port: integer := Runtime.Network.Port;
  case HostOverride of
    Some(Value):
    begin
      Host := Value
    end;
    None:
    begin
    end
  end;

  case PortOverride of
    Some(Value):
    begin
      Port := Value
    end;
    None:
    begin
    end
  end;

  if (Port < 1) or (Port > 65535) then
  begin
    panic('port must be between 1 and 65535')
  end;

  Std.Results.Unwrap(RunServer(Host, Port))
end.
