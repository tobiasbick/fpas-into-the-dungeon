[project]
name = "dungeon-server-core"
kind = "library"

[dependencies]
workspace = ["dungeon-game", "dungeon-protocol", "dungeon-world", "dungeon-runtime-data"]

[exports]
units = ["Dungeon.Server", "Dungeon.Server.Config", "Dungeon.Server.Console", "Dungeon.Server.Console.Model", "Dungeon.Server.Logging"]

[sources]
include = ["src/Dungeon/Server/**/*.fpas"]
