// Defines versioned requests and the server projection used by the terminal.
unit Dungeon.Protocol.Messages;

/// Version exchanged with every request and response.
public const Version: int := 7;

/// A client intention, sent before the client updates its view.
public type Request = record
  /// Version of the wire contract expected by the client.
  public Version: int;
  /// Command name.
  public Action: string;
  /// Seed used for create requests.
  public Seed: int;
  /// Requested map center column, used only for map requests.
  public MapX: int := 0;
  /// Requested map center row, used only for map requests.
  public MapY: int := 0;
  /// Topic selected in a dialogue frame.
  public Topic: string := '';
  /// Revision identifying the frame being answered or closed.
  public FrameId: long := 0L;
  /// Selected item for an inventory action.
  public ItemId: long := 0L;
  /// Shop identified in the current trade quote.
  public MerchantId: long? := null;
  /// Buy or sell side when requesting a new quote page.
  public Side: string := '';
  /// Zero-based trade page to request.
  public Page: int := 0;
end record;

/// Server-derived day, time of day and local conditions.
public type Conditions = record
  /// One-based day number.
  public Day: int;
  /// Minute since midnight.
  public MinuteOfDay: int;
  /// Whether the world is currently in its night phase.
  public Night: bool;
  /// Clear, Rain or Sheltered.
  public Weather: string;
end record;

/// The current area and the bounded, player-safe map projection.
public type View = record
  /// Seed of the active world.
  public Seed: int;
  /// Outdoor or dungeon display name.
  public Area: string;
  /// One-based dungeon floor, or zero outdoors.
  public Level: int;
  /// Number of floors in the dungeon, or zero outdoors.
  public Depth: int;
  /// Column of the player in the current area.
  public X: int;
  /// Row of the player in the current area.
  public Y: int;
  /// Current player health.
  public Health: int;
  /// Number of completed turns.
  public Turn: long;
  /// Column represented by the leftmost projected cell.
  public OriginX: int;
  /// Row represented by the topmost projected cell.
  public OriginY: int;
  /// Glyph rows with unknown cells replaced by a question mark.
  public Rows: array of string;
  /// Knowledge rows using u for unknown, r for remembered and v for visible.
  public Knowledge: array of string;
  /// Current time of day and weather in the active area.
  public Time: Conditions;
end record;

/// One offered choice in the current dialogue.
public type Topic = record
  /// Identifier to return when this topic is selected.
  public Id: string;
  /// Label to show in the choice list.
  public Label: string;
end record;

/// The server's current conversation frame.
public type Dialogue = record
  /// Revision scoped to this connection.
  public Id: long;
  /// Name of the current speaker.
  public Speaker: string;
  /// Greeting or answer from the speaker.
  public Text: string;
  /// Ordered choices that can be selected.
  public Topics: array of Topic;
end record;

/// An item carried or worn by the player.
public type BagEntry = record
  /// Stable server-owned identity.
  public Id: long;
  /// Display name.
  public Name: string;
  /// Inspection text.
  public Description: string;
  /// Offered Enter action, or empty for a display-only item.
  public Action: string;
  /// Whether this item is equipped.
  public Equipped: bool;
end record;

/// Experience and current level of one fighting skill.
public type Skill = record
  /// Current skill level, 1 through 5.
  public Level: int;
  /// Cumulative experience earned in this skill.
  public Experience: int;
  /// Experience needed for the next level, or the cap at mastery.
  public Threshold: int;
end record;

/// Inventory and derived character values in the current game.
public type Inventory = record
  /// Carried and equipped items in stable ID order.
  public Items: array of BagEntry;
  /// Combined inventory limit.
  public Capacity: int;
  /// Current health.
  public Health: int;
  /// Maximum health.
  public MaxHealth: int;
  /// Current attack damage.
  public Damage: int;
  /// Current armor rating.
  public Armor: int;
  /// Contextual hint for an item on the floor, if one is in reach.
  public Hint: string;
  /// Spendable coins.
  public Coins: int;
  /// Unarmed skill and experience.
  public Unarmed: Skill;
  /// Blades skill and experience.
  public Blades: Skill;
  /// Whether Blades rather than Unarmed contributes to the attack.
  public Armed: bool;
end record;

/// A row on one side of a trade quote.
public type TradeRow = record
  /// Exact item ID.
  public Id: long;
  /// Display name.
  public Name: string;
  /// Price in coins, or null when the item cannot be traded.
  public Price: int?;
  /// Empty if this offer can be accepted, otherwise a reason.
  public Refusal: string;
end record;

/// A bounded page on one side of a quote.
public type TradePage = record
  /// Zero-based page index.
  public Index: int;
  /// Number of pages on this side, with one empty page for an empty side.
  public Pages: int;
  /// Total number of items on this side.
  public Total: int;
  /// Items offered on the current page.
  public Rows: array of TradeRow;
end record;

/// The current merchant, wallet and offers from the server.
public type Trade = record
  /// Stable shop identity within the world.
  public MerchantId: long;
  /// Revision scoped to the connection.
  public Revision: long;
  /// Merchant display name.
  public Name: string;
  /// Spendable balance.
  public Coins: int;
  /// Maximum number of items held by the merchant.
  public Capacity: int;
  /// Offers to buy from the merchant.
  public Buy: TradePage;
  /// Offers to sell to the merchant.
  public Sell: TradePage;
end record;

/// A server response to one client request.
public type Reply = record
  /// Version of the wire contract used by the server.
  public Version: int;
  /// Player-facing outcome.
  public Message: string;
  /// Current projection, or null when there is no active world.
  public World: View?;
  /// Active conversation, if any.
  public Conversation: Dialogue? := null;
  /// Current inventory and character values, if a world is active.
  public Bag: Inventory? := null;
  /// Server-authored journal lines, empty before any quest has been accepted.
  public Journal: (array of string)? := null;
  /// Active merchant quote, if the player is trading.
  public Trade: Trade? := null;
end record;
end unit;
