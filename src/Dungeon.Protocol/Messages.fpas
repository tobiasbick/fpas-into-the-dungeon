// Defines versioned requests and the server projection used by the terminal.
unit Dungeon.Protocol.Messages;

/// Version exchanged with every request and response.
public const Version: int := 3;

/// A client intention, sent before the client updates its view.
public type Request = record
  /// Version of the wire contract expected by the client.
  public Version: int;
  /// Command name.
  public Action: string;
  /// Seed used for create requests.
  public Seed: int;
  /// Requested map center column, used only for map requests.
  public MapX: int := 0;
  /// Requested map center row, used only for map requests.
  public MapY: int := 0;
  /// Topic selected in a dialogue frame.
  public Topic: string := '';
  /// Revision identifying the frame being answered or closed.
  public FrameId: long := 0L;
end record;

/// The current area and the bounded, player-safe map projection.
public type View = record
  /// Seed of the active world.
  public Seed: int;
  /// Outdoor or dungeon display name.
  public Area: string;
  /// One-based dungeon floor, or zero outdoors.
  public Level: int;
  /// Number of floors in the dungeon, or zero outdoors.
  public Depth: int;
  /// Column of the player in the current area.
  public X: int;
  /// Row of the player in the current area.
  public Y: int;
  /// Current player health.
  public Health: int;
  /// Number of completed turns.
  public Turn: long;
  /// Column represented by the leftmost projected cell.
  public OriginX: int;
  /// Row represented by the topmost projected cell.
  public OriginY: int;
  /// Glyph rows with unknown cells replaced by a question mark.
  public Rows: array of string;
  /// Knowledge rows using u for unknown, r for remembered and v for visible.
  public Knowledge: array of string;
end record;

/// One offered choice in the current dialogue.
public type Topic = record
  /// Identifier to return when this topic is selected.
  public Id: string;
  /// Label to show in the choice list.
  public Label: string;
end record;

/// The server's current conversation frame.
public type Dialogue = record
  /// Revision scoped to this connection.
  public Id: long;
  /// Name of the current speaker.
  public Speaker: string;
  /// Greeting or answer from the speaker.
  public Text: string;
  /// Ordered choices that can be selected.
  public Topics: array of Topic;
end record;

/// A server response to one client request.
public type Reply = record
  /// Version of the wire contract used by the server.
  public Version: int;
  /// Player-facing outcome.
  public Message: string;
  /// Current projection, or null when there is no active world.
  public World: View?;
  /// Active conversation, if any.
  public Conversation: Dialogue? := null;
end record;
end unit;
