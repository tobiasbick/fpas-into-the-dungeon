// Exchanges one game intention and one server projection on an owned connection.
unit Dungeon.Client.Connection;

uses
  Dungeon.Protocol.Frames as Frames, Dungeon.Protocol.Messages as Wire, System.IO as IO,
  System.Text.Json as Json, System.Threading as Threads, System.Threading.Tasks as Tasks;

/// Sends Request over Stream and returns its reply, with a deadline and caller Cancellation.
/// The caller owns Stream and serializes requests. A failed exchange ends the connection.
public async function Exchange(
  Stream: IO.Stream; Request: Wire.Request; Cancellation: Threads.CancellationToken
): Tasks.Task<Wire.Reply>;
begin
  using const Deadline: Threads.CancellationTokenSource := Threads.CancellationTokenSource.CreateLinkedTokenSource(
    Cancellation
  );
  Deadline.CancelAfter(5000);

  await Frames.Write(Stream, Json.JsonSerializer.Serialize<Wire.Request>(Request), Deadline.Token);
  const Payload: string := await Frames.Read(Stream, Deadline.Token);
  const Reply: Wire.Reply? := Json.JsonSerializer.Deserialize<Wire.Reply>(Payload);
  if Reply = null or Reply.Version <> Wire.Version then
    raise new IO.InvalidDataException('Unsupported server protocol.');
  end if;

  return Reply;
end function;
end unit;
