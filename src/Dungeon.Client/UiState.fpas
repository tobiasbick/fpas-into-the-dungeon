// Shares terminal state between the input loop and rendering.
unit Dungeon.Client.UiState;

uses Dungeon.Protocol.Messages as Wire, Fpas.Tui.Elements as E;

/// Player-owned overlay shown over the game.
public type Sheet = enum: byte
  None;
  Inventory;
  Character;
  Journal;
end enum;

/// Terminal inputs and replies handled by the client loop.
public type Message = union
  Action(Name: string);
  Received(Reply: Wire.Reply; Panning: bool);
  ToggleMap;
  SelectTopic(Id: string);
  MoveTopic(Offset: int);
  DialogueAction(Id: string);
  OpenSheet(Value: Sheet);
  CloseSheet;
  ScrollJournal(Change: E.ScrollChange);
  SelectItem(Id: long);
  MoveItem(Offset: int);
  UseItem(Id: long);
  DropItem;
  TradeSide(Buy: bool);
  TradePage(Offset: int);
  SelectOffer(Id: long);
  Transfer(Id: long);
  CloseTrade;
  Disconnected(Reason: string);
  Quit;
end union;

/// Terminal projection and local UI state.
public type Model = record
  /// Last authoritative view centered on the player.
  public World: Wire.View? := null;
  /// Latest player-facing result.
  public Status: string := 'Create a world or continue a saved game.';
  /// Whether one server request is pending.
  public Busy: bool := false;
  /// Whether the session still owns a connection.
  public Online: bool := true;
  /// Whether the local exploration map is open.
  public MapOpen: bool := false;
  /// Requested map view, if panned.
  public Panned: Wire.View? := null;
  /// Active server-owned dialogue.
  public Conversation: Wire.Dialogue? := null;
  /// Highlighted dialogue topic.
  public SelectedTopic: string := '';
  /// Last authoritative inventory projection.
  public Bag: Wire.Inventory? := null;
  /// Current locally owned overlay.
  public Sheet: Sheet := Sheet.None;
  /// Highlighted inventory item ID.
  public SelectedItem: long := 0L;
  /// Last server-authored journal lines.
  public JournalLines: array of string := [];
  /// Local journal scroll position.
  public JournalPosition: E.ScrollPosition := E.ScrollPosition.Offset(0);
  /// Active server-owned quote.
  public Trade: Wire.Trade? := null;
  /// Whether the purchase side is shown.
  public TradeBuy: bool := true;
  /// Highlighted offer ID.
  public SelectedOffer: long := 0L;
end record;
end unit;
