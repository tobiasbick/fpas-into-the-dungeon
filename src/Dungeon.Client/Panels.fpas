// Composes consistent modal panels whose dimensions stay stable when content changes.
unit Dungeon.Client.Panels;

uses Fpas.Tui.Elements as E, System as Sys;

/// Frames Body and Footer with the supplied title, focus, close action and shortcuts.
public function Modal<TMsg>(
  Id: string; Title: string; Focus: string; Close: TMsg; Body: E.Element<TMsg>; Footer: E.Element<TMsg>;
  Shortcuts: array of E.ShortcutBinding<TMsg>; Columns: int; BodyRows: int
): E.Element<TMsg>;
begin
  const Size: E.Element<TMsg> := E.Column<TMsg>(
    E.Size<TMsg>(E.Text<TMsg>(new string(#32, 64)), new E.Flex(Basis := 0, Maximum := 0)),
    E.Size<TMsg>(Body, new E.Flex(Basis := BodyRows))
  );
  const WidthPercent: int := Sys.Math.Clamp(6800 div Sys.Math.Max(1, Columns), 1, 85);
  const Panel: E.Element<TMsg> := E.Styled<TMsg>(
    E.OverlayPanel<TMsg>(Size, Footer, Title, Padding := 1), new E.Style($E8DFC7, $2B241A)
  );
  return E.Overlay<TMsg>(
    Id, true, Focus, Close, Panel, Shortcuts,
    new E.OverlayLimits(MaxWidthPercent := WidthPercent, MaxHeightPercent := 90)
  );
end function;
end unit;
