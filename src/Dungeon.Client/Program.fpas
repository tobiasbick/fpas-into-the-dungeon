// Connects to the local authoritative game server and opens the terminal.
program DungeonClient;

uses
  Dungeon.Client.Terminal as Terminal, System as Sys, System.Console as Console,
  System.Net as Net, System.Net.Sockets as Sockets, System.Threading as Threads;

procedure Main(Arguments: array of string);
begin
  var Port: int := 4040;
  var Seed: int := 25;
  if Arguments.Length > 3
    or (Arguments.Length > 1 and not int.TryParse(Arguments[1], out Port))
    or (Arguments.Length > 2 and not int.TryParse(
    Arguments[2],
    out Seed
  )) or Port < 1 or Port > 65535
  then
    Console.Error.WriteLine('Usage: Dungeon.Client [port] [seed]');
    Sys.Environment.ExitCode := 2;
    return;
  end if;

  using const Client: Sockets.TcpClient := new Sockets.TcpClient();
  try
    begin
      using const Deadline: Threads.CancellationTokenSource := new Threads.CancellationTokenSource(
        5000
      );
      Client.ConnectAsync(Net.IPAddress.Loopback, Port, Deadline.Token).GetAwaiter().GetResult();
    end;

    Terminal.Run(Client.GetStream(), Seed);
  catch Failure: Sockets.SocketException do
    Console.Error.WriteLine('Could not connect to the local game server.');
    Sys.Environment.ExitCode := 1;
  catch Failure: Sys.OperationCanceledException do
    Console.Error.WriteLine('Connecting to the local game server timed out.');
    Sys.Environment.ExitCode := 1;
  end try;
end procedure;

begin
  Main(Sys.Environment.GetCommandLineArgs());
end;
end program;
