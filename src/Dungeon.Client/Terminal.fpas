// Displays the server projection and turns keyboard input into game intentions.
unit Dungeon.Client.Terminal;

uses
  Dungeon.Client.Connection as Connection, Dungeon.Client.UiState as Ui, Dungeon.Client.Screen as Screen,
  Dungeon.Client.TradePanel as Trades, Dungeon.Client.InventoryPanel as Pack, Dungeon.Protocol.Messages as Wire,
  Fpas.Tui.Application as App, Fpas.Tui.Elements as E,
  System as Sys, System.IO as IO,
  System.Threading as Threads, System.Threading.Tasks as Tasks;

function Failed(Failure: Sys.Exception): Ui.Message;
begin
  if Failure is Sys.OperationCanceledException then
    return Ui.Message.Disconnected('The server did not reply in time.');
  end if;

  if Failure is IO.IOException then
    return Ui.Message.Disconnected('The connection closed.');
  end if;

  return Ui.Message.Disconnected('The server sent an invalid reply.');
end function;

function Pan(State: Ui.Model; Name: string): Wire.Request?;
begin
  const View: Wire.View? := State.Panned ?? State.World;
  if View = null then
    return null;
  end if;

  const X: int := View.OriginX + View.Rows[0].Length div 2;
  const Y: int := View.OriginY + View.Rows.Length div 2;
  case Name of
    when 'north':
      return new Wire.Request(Wire.Version, 'map', View.Seed, X, Y - 3);
    when 'south':
      return new Wire.Request(Wire.Version, 'map', View.Seed, X, Y + 3);
    when 'west':
      return new Wire.Request(Wire.Version, 'map', View.Seed, X - 3, Y);
    when 'east':
      return new Wire.Request(Wire.Version, 'map', View.Seed, X + 3, Y);
    when 'home':
      return new Wire.Request(Wire.Version, 'map', View.Seed, View.X, View.Y);
    else
      return null;
  end case;
end function;

function SendRequest(
  State: Ui.Model; Stream: IO.Stream; Command: Wire.Request; Panning: bool
): App.Transition<Ui.Model, Ui.Message>;
begin
  const Send: App.Command<Ui.Message> := App.StartBackground<Ui.Message>(
    'request',
    async function(Post: function(Ui.Message): Tasks.Task; Cancellation: Threads.CancellationToken): Tasks.Task begin
      try
        const Reply: Wire.Reply := await Connection.Exchange(Stream, Command, Cancellation);
        await Post(Ui.Message.Received(Reply, Panning));
      catch do
        Stream.Dispose();
        raise;
      end try;
    end function,
    Failed
  );
  return new App.Transition<Ui.Model, Ui.Message>(
    State with
      Busy := true;
    end with, [Send]
  );
end function;

function TopicAt(State: Ui.Model; Offset: int): string;
begin
  const Talk: Wire.Dialogue? := State.Conversation;
  if Talk = null then
    return '';
  end if;

  for Index: int := 0 to Talk.Topics.Length - 1 do
    if Talk.Topics[Index].Id = State.SelectedTopic then
      return Talk.Topics[Sys.Math.Clamp(Index + Offset, 0, Talk.Topics.Length - 1)].Id;
    end if;
  end for;

  return State.SelectedTopic;
end function;

function InitialTopic(State: Ui.Model; Talk: Wire.Dialogue?): string;
begin
  if Talk = null or Talk.Topics.Length = 0 then
    return '';
  end if;
  const Previous: Wire.Dialogue? := State.Conversation;
  if Previous <> null and Previous.Id = Talk.Id then
    return State.SelectedTopic;
  end if;

  return Talk.Topics[0].Id;
end function;

function UpdateFor(Stream: IO.Stream; Seed: int): function(Ui.Model, Ui.Message): App.Transition<Ui.Model, Ui.Message>;
  function Update(State: Ui.Model; Event: Ui.Message): App.Transition<Ui.Model, Ui.Message>;
  begin
    case Event of
      when Ui.Message.Action(const Name: string):
        if State.Busy or not State.Online or State.Conversation <> null or State.Trade <> null
          or State.Sheet <>
          Ui.Sheet.None
        then
          return new App.Transition<Ui.Model, Ui.Message>(State, []);
        end if;
        const Panning: bool := State.MapOpen;
        const Command: Wire.Request? := if Panning then Pan(State, Name)
          else if Name = 'home' then null else new Wire.Request(Wire.Version, Name, Seed) end if
          end if;
        if Command = null then
          return new App.Transition<Ui.Model, Ui.Message>(State, []);
        end if;

        return SendRequest(State, Stream, Command, Panning);
      when Ui.Message.Received(const Reply: Wire.Reply, const Panning: bool):
        if Panning then
          const Projection: Wire.View? := if State.MapOpen then Reply.World else null end if;
          return new App.Transition<Ui.Model, Ui.Message>(
            State with
              Busy := false;
              Panned := Projection;
            end with, []
          );
        end if;

        const Buy: bool := State.Trade = null or State.TradeBuy;
        return new App.Transition<Ui.Model, Ui.Message>(
          new Ui.Model(
            World := Reply.World,
            Status := Reply.Message,
            Conversation := Reply.Conversation,
            SelectedTopic := InitialTopic(State, Reply.Conversation),
            Bag := Reply.Bag,
            Sheet := State.Sheet,
            SelectedItem := Pack.Keep(State.Bag, Reply.Bag, State.SelectedItem),
            JournalLines := Reply.Journal ?? Sys.Array.Empty<string>(),
            JournalPosition := State.JournalPosition,
            Trade := Reply.Trade, TradeBuy := Buy,
            SelectedOffer := Trades.Keep(State.Trade, Reply.Trade, Buy, State.SelectedOffer)
          ), []
        );
      when Ui.Message.SelectTopic(const Id: string):
        return new App.Transition<Ui.Model, Ui.Message>(
          State with
            SelectedTopic := Id;
          end with, []
        );
      when Ui.Message.MoveTopic(const Offset: int):
        return new App.Transition<Ui.Model, Ui.Message>(
          State with
            SelectedTopic := TopicAt(State, Offset);
          end with, []
        );
      when Ui.Message.DialogueAction(const Id: string):
        const Talk: Wire.Dialogue? := State.Conversation;
        if Talk = null or State.Busy or not State.Online then
          return new App.Transition<Ui.Model, Ui.Message>(State, []);
        end if;
        const Action: string := if Id = '' then 'end_dialogue' else 'dialogue_choice' end if;
        const Command: Wire.Request := new Wire.Request(
          Wire.Version,
          Action,
          Seed,
          Topic := Id,
          FrameId := Talk.Id
        );
        return SendRequest(State, Stream, Command, false);
      when Ui.Message.ToggleMap:
        if State.World = null or State.Busy or State.Conversation <> null or State.Trade <> null
          or State.Sheet <>
          Ui.Sheet.None
        then
          return new App.Transition<Ui.Model, Ui.Message>(State, []);
        end if;

        return new App.Transition<Ui.Model, Ui.Message>(
          State with
            MapOpen := not State.MapOpen;
            Panned := null;
          end with, []
        );
      when Ui.Message.OpenSheet(const Value: Ui.Sheet):
        if State.Busy or State.MapOpen or State.Conversation <> null or State.Trade <> null then
          return new App.Transition<Ui.Model, Ui.Message>(State, []);
        end if;

        if State.World = null and State.Online and Value = Ui.Sheet.Character then
          return SendRequest(
            State,
            Stream,
            new Wire.Request(Wire.Version, 'continue', Seed),
            false
          );
        end if;

        if State.Bag = null then
          return new App.Transition<Ui.Model, Ui.Message>(State, []);
        end if;

        return new App.Transition<Ui.Model, Ui.Message>(
          State with
            Sheet := Value;
          end with, []
        );
      when Ui.Message.ScrollJournal(const Change: E.ScrollChange):
        return new App.Transition<Ui.Model, Ui.Message>(
          State with
            JournalPosition := Change.Position;
          end with, []
        );
      when Ui.Message.CloseSheet:
        return new App.Transition<Ui.Model, Ui.Message>(
          State with
            Sheet := Ui.Sheet.None;
          end with, []
        );
      when Ui.Message.SelectItem(const Id: long):
        return new App.Transition<Ui.Model, Ui.Message>(
          State with
            SelectedItem := Id;
          end with, []
        );
      when Ui.Message.MoveItem(const Offset: int):
        const Bag: Wire.Inventory? := State.Bag;
        if Bag = null then
          return new App.Transition<Ui.Model, Ui.Message>(State, []);
        end if;
        const Selected: long := Pack.Move(Bag, State.SelectedItem, Offset);
        return new App.Transition<Ui.Model, Ui.Message>(
          State with
            SelectedItem := Selected;
          end with, []
        );
      when Ui.Message.UseItem(const Id: long):
        if State.Busy or not State.Online then
          return new App.Transition<Ui.Model, Ui.Message>(State, []);
        end if;

        return SendRequest(
          State,
          Stream,
          new Wire.Request(Wire.Version, 'item_use', Seed, ItemId := Id),
          false
        );
      when Ui.Message.DropItem:
        if State.Busy or not State.Online or State.SelectedItem = 0L then
          return new App.Transition<Ui.Model, Ui.Message>(State, []);
        end if;

        return SendRequest(
          State,
          Stream,
          new Wire.Request(Wire.Version, 'item_drop', Seed, ItemId := State.SelectedItem),
          false
        );
      when Ui.Message.TradeSide(const Buy: bool):
        if State.Trade = null then
          return new App.Transition<Ui.Model, Ui.Message>(State, []);
        end if;
        const Next: Ui.Model := if State.TradeBuy = Buy then State
          else State with
            TradeBuy := Buy;
            SelectedOffer := Trades.Keep(null, State.Trade, Buy, 0L);
          end with
          end if;
        return new App.Transition<Ui.Model, Ui.Message>(
          Next,
          [App.Focus<Ui.Message>('trade-items')]
        );
      when Ui.Message.SelectOffer(const Id: long):
        return new App.Transition<Ui.Model, Ui.Message>(
          State with
            SelectedOffer := Id;
          end with, []
        );
      when Ui.Message.TradePage(const Offset: int):
        const Quote: Wire.Trade? := State.Trade;
        if Quote = null or State.Busy or not State.Online then
          return new App.Transition<Ui.Model, Ui.Message>(State, []);
        end if;
        const Current: Wire.TradePage := Trades.Side(Quote, State.TradeBuy);
        const Page: int := Current.Index + Offset;
        if Page < 0 or Page >= Current.Pages then
          return new App.Transition<Ui.Model, Ui.Message>(State, []);
        end if;
        const Side: string := if State.TradeBuy then 'buy' else 'sell' end if;
        return SendRequest(
          State, Stream, new Wire.Request(
            Wire.Version,
            'trade_page',
            Seed,
            FrameId := Quote.Revision,
            MerchantId := Quote.MerchantId,
            Side := Side,
            Page := Page
          ), false
        );
      when Ui.Message.Transfer(const Id: long):
        const Quote: Wire.Trade? := State.Trade;
        if Quote = null or State.Busy or not State.Online then
          return new App.Transition<Ui.Model, Ui.Message>(State, []);
        end if;
        const Action: string := if State.TradeBuy then 'trade_buy' else 'trade_sell' end if;
        return SendRequest(
          State, Stream, new Wire.Request(
            Wire.Version,
            Action,
            Seed,
            FrameId := Quote.Revision,
            MerchantId := Quote.MerchantId,
            ItemId := Id
          ), false
        );
      when Ui.Message.CloseTrade:
        const Quote: Wire.Trade? := State.Trade;
        if Quote = null or State.Busy or not State.Online then
          return new App.Transition<Ui.Model, Ui.Message>(State, []);
        end if;

        return SendRequest(
          State, Stream, new Wire.Request(
            Wire.Version,
            'end_trade',
            Seed,
            FrameId := Quote.Revision,
            MerchantId := Quote.MerchantId
          ), false
        );
      when Ui.Message.Disconnected(const Reason: string):
        return new App.Transition<Ui.Model, Ui.Message>(
          State with
            Status := Reason;
            Busy := false;
            Online := false;
            Conversation := null;
            Trade := null;
          end with, []
        );
      when Ui.Message.Quit:
        if State.MapOpen then
          return new App.Transition<Ui.Model, Ui.Message>(
            State with
              MapOpen := false;
              Panned := null;
            end with, []
          );
        end if;

        return new App.Transition<Ui.Model, Ui.Message>(State, [App.Exit<Ui.Message>()]);
    end case;
  end function;
begin
  return Update;
end function;

/// Runs the terminal on Stream, using Seed when creating a world. The caller owns Stream.
public procedure Run(Stream: IO.Stream; Seed: int);
begin
  App.Run<Ui.Model, Ui.Message>(
    new Ui.Model(),
    UpdateFor(Stream, Seed),
    Screen.View,
    Screen.Colors.Theme
  );
end procedure;
end unit;
