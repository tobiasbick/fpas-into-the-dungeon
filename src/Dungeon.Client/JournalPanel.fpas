// Displays the server-authored quest journal with local scrolling.
unit Dungeon.Client.JournalPanel;

uses Dungeon.Client.Panels as Panels, Fpas.Tui.Elements as E, System.Collections.Generic as Generic;

/// Draws Lines at Position and binds local scrolling and closing.
public function Draw<TMsg>(
  Lines: array of string; Position: E.ScrollPosition; Scroll: function(E.ScrollChange): TMsg;
  Close: TMsg; Columns: int
): E.Element<TMsg>;
begin
  const Text: Generic.List<E.Element<TMsg>> := new Generic.List<E.Element<TMsg>>();
  if Lines.Length = 0 then
    Text.Add(E.Text<TMsg>('No accepted quests.'));
  else
    for Line: string in Lines do
      Text.Add(E.Text<TMsg>(Line));
    end for;
  end if;

  const Body: E.Element<TMsg> := E.ScrollView<TMsg>(
    'journal-body', E.Column<TMsg>(Text.ToArray()), Position, Scroll
  );
  const Footer: E.Element<TMsg> := E.Row<TMsg>(
    E.Size<TMsg>(E.Text<TMsg>('Arrows / Page Up / Page Down to scroll'), new E.Flex(Grow := 1)),
    E.Button<TMsg>('journal-close', 'Esc Close', Close, Variant := E.ButtonVariant.Secondary)
  );
  return Panels.Modal<TMsg>(
    'journal', 'Quest journal', 'journal-body', Close, Body, Footer,
    [E.CharacterShortcut<TMsg>('j', Close)], Columns, 8
  );
end function;
end unit;
