// Renders the speaker, answer and offered dialogue choices in a modal panel.
unit Dungeon.Client.DialoguePanel;

uses
  Dungeon.Client.Panels as Panels, Dungeon.Protocol.Messages as Wire,
  Fpas.Tui.Elements as E, System.Collections.Generic as Generic;

/// Draws Talk and binds its selectable topics and close controls.
public function Draw<TMsg>(
  Talk: Wire.Dialogue; Selected: string; Busy: bool; Columns: int; Close: TMsg;
  Select: function(string): TMsg; Choose: function(string): TMsg; Browse: function(int): TMsg
): E.Element<TMsg>;
begin
  const Items: Generic.List<E.SelectionItem> := new Generic.List<E.SelectionItem>(
    Talk.Topics.Length
  );
  for Topic: Wire.Topic in Talk.Topics do
    Items.Add(new E.SelectionItem(Topic.Id, Topic.Label));
  end for;

  const Choices: E.Element<TMsg> := E.SelectionList<TMsg>(
    'dialogue-topics', Items.ToArray(), Selected, Select, Choose
  );
  const Scroll: E.Element<TMsg> := E.ScrollView<TMsg>(
    'dialogue-body', E.Column<TMsg>(new E.Flow(Gap := 1), E.Text<TMsg>(Talk.Text), Choices)
  );
  const Footer: E.Element<TMsg> := E.Row<TMsg>(
    E.Size<TMsg>(
      E.Text<TMsg>(if Busy then 'Waiting for the server…' else '' end if),
      new E.Flex(Grow := 1)
    ),
    E.Button<TMsg>('dialogue-close', 'Esc Close', Close, not Busy, E.ButtonVariant.Secondary)
  );
  return Panels.Modal<TMsg>(
    'dialogue', Talk.Speaker, 'dialogue-topics', Close, Scroll, Footer,
    [E.CharacterShortcut<TMsg>('w', Browse(-1)), E.CharacterShortcut<TMsg>('s', Browse(1))],
    Columns, 8
  );
end function;
end unit;
