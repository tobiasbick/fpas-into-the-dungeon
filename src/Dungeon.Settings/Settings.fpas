// Loads and atomically writes the per-user game settings.
unit Dungeon.Settings;

uses Dungeon.DataFiles as Files, System as Sys, System.IO as IO, System.Text.Json as Json;

// The stable identifiers selected for the game master's ACP session.
public type Choice = record
  // The agent's launcher identifier.
  public Agent: string := 'codex';
  // The ACP model value, or empty when the agent has no model selector.
  public Model: string := '';
  // The ACP thinking value, or empty when it cannot be configured.
  public ThinkingLevel: string := '';
end record;

// Player preferences stored in settings.json. The save slot records only the ACP choice.
public type Preferences = record
  public Agent: string := 'codex';
  public Model: string := '';
  public ThinkingLevel: string := '';
  public GenerateRoomArt: bool := false;

  public function AgentChoice(): Choice;
  begin
    return new Choice(self.Agent, self.Model, self.ThinkingLevel);
  end function;
end record;

// Resolves the settings path even when the application data directory is new.
public function DefaultPath(): string;
begin
  const Root: string := Sys.Environment.GetFolderPath(
    Sys.Environment.SpecialFolder.ApplicationData,
    Sys.Environment.SpecialFolderOption.DoNotVerify
  );
  if not IO.Path.IsPathFullyQualified(Root) then
    raise new IO.IOException('The user configuration directory is unavailable.');
  end if;

  return IO.Path.Combine(Root, 'into-the-dungeon', 'settings.json');
end function;

// Creates the empty settings file, preserving any settings already on disk.
public procedure EnsureExists(Path: string);
begin
  if not IO.Path.IsPathFullyQualified(Path) or not IO.File.Exists(Path) then
    Files.Write(Path, '{}', false);
  end if;
end procedure;

function Required(Root: Json.JsonElement; Key: string): string;
begin
  var Property: Json.JsonElement := new Json.JsonElement();
  if Root.TryGetProperty(Key, out Property) and Property.ValueKind = Json.JsonValueKind.String then
    return Property.GetString() ?? '';
  end if;

  raise new Json.JsonException('Missing settings field: ' + Key);
end function;

// Older settings without the room art preference leave generation disabled.
public function Load(Path: string): Preferences;
begin
  EnsureExists(Path);
  try
    const Root: Json.JsonElement := Json.JsonElement.Parse(IO.File.ReadAllText(Path));
    if Root.ValueKind <> Json.JsonValueKind.Object then
      raise new Json.JsonException('Expected a JSON object.');
    end if;

    if Root.GetPropertyCount() = 0 then
      return new Preferences();
    end if;

    var RoomArt: Json.JsonElement := new Json.JsonElement();
    const GenerateRoomArt: bool := Root.TryGetProperty(
      'generateRoomArt',
      out RoomArt
    ) and RoomArt.GetBoolean();
    return new Preferences(
      Required(Root, 'agent'),
      Required(Root, 'model'),
      Required(Root, 'thinkingLevel'),
      GenerateRoomArt
    );
  catch Failure: Sys.Exception when Failure is Json.JsonException or Failure is
    Sys.InvalidOperationException do
    raise new IO.InvalidDataException(
      'Invalid settings.json. Delete it to recreate the default settings.',
      Failure
    );
  end try;
end function;

// Replaces the file after all preferences have been written.
public procedure Save(Path: string; Selection: Preferences);
begin
  const Options: Json.JsonSerializerOptions := new Json.JsonSerializerOptions();
  Options.PropertyNamingPolicy := Json.JsonNamingPolicy.CamelCase;
  Options.WriteIndented := true;
  Files.Write(Path, Json.JsonSerializer.Serialize<Preferences>(Selection, Options), true);
end procedure;

end unit;
