// Provides atomic writes for per-user game files.
unit Dungeon.DataFiles;

uses System as Sys, System.IO as IO;

public procedure Write(Path: string; Contents: string; Replace: bool);
begin
  if not IO.Path.IsPathFullyQualified(Path) then
    raise new Sys.ArgumentException('The data file path must be absolute.');
  end if;

  discard IO.Directory.CreateDirectory(IO.Path.GetDirectoryName(Path) ?? '');
  const Temporary: string := Path + '.' + Sys.Guid.NewGuid().ToString('N') + '.tmp';
  try
    IO.File.WriteAllText(Temporary, Contents);
    IO.File.Move(Temporary, Path, Replace);
  catch Failure: IO.IOException when not Replace and IO.File.Exists(Path) do
    // Another launch created the file first.
    return;
  finally
    IO.File.Delete(Temporary);
  end try;
end procedure;

end unit;
