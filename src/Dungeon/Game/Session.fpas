// Runs the adventure, ACP session and the single-writer turn loop.
unit Dungeon.Game.Session;

uses
  Dungeon.Acp.Processes as Agents, Dungeon.Acp.Discovery as Acp, Dungeon.Acp.ClientCallbacks as Callbacks,
  Dungeon.Game.Saves as Saves, Dungeon.Game.RoomView as Rooms, Dungeon.Game.World as World, Dungeon.Game.Art as Art,
  Dungeon.Game.TurnTools as Tools, Dungeon.Mcp.Transport as Mcp, Dungeon.Acp.Dialogs as Dialogs, Dungeon.Game.ArtRequests as Draw, Dungeon.Game.Illustrator as Illustrator,
  Dungeon.Settings as Settings, Dungeon.ErrorLog as Errors, dotacp.client as Client, dotacp.@protocol as P, StreamJsonRpc as Rpc,
  System as Sys, System.IO as IO, System.Globalization as Global, System.Text.Json as Json,
  System.Text.Encodings.Web as Encoding,
  System.Collections.Concurrent as Collections, System.Collections.Generic as Lists, System.Text as Buffers,
  System.Threading as Threads, System.Threading.Channels as Channels, System.Threading.Tasks as Tasks;

// A complete frame of player-visible adventure data.
public type Presentation = record
  public History: array of Saves.Turn;
  public RoomId: string;
  public Images: Art.Pair;
end record;

public type Event = variant
  Restored(Value: Presentation);
  Ready(Value: Presentation);
  ArtChanged(RoomId: string; Images: Art.Pair; Finished: bool);
  TurnRejected;
  Failed(Status: string);
end variant;

async function OpenSession(
  Connection: Client.Connection; Directory: string; Choice: Settings.Choice;
  Saved: Saves.Save?; Servers: array of P.McpServer?; Token: Threads.CancellationToken; Log: Errors.Sink
): Tasks.Task<P.SessionId>;
begin
  const Initialized: P.InitializeResponse := await Agents.Initialize(Connection, Token);
  const Caps: P.AgentCapabilities? := Initialized.AgentCapabilities;
  if Saved <> null and Saved.GameMaster.Agent = Choice.Agent and Caps <> null then
    const Id: P.SessionId := new P.SessionId(Saved.SessionId);
    const Sessions: P.SessionCapabilities? := Caps.SessionCapabilities;
    try
      if Caps.LoadSession then
        const Load: P.LoadSessionRequest := new P.LoadSessionRequest();
        Load.SessionId := Id;
        Load.Cwd := Directory;
        Load.McpServers := Servers;
        const Loaded: P.LoadSessionResponse := await Connection.LoadSessionAsync(Load, Token);
        discard await Acp.Configure(Connection, Id, Loaded.ConfigOptions, Choice, true, Token);
        return Id;
      elsif Sessions <> null and Sessions.Resume <> null then
        const Resume: P.ResumeSessionRequest := new P.ResumeSessionRequest();
        Resume.SessionId := Id;
        Resume.Cwd := Directory;
        Resume.McpServers := Servers;
        const Resumed: P.ResumeSessionResponse := await Connection.ResumeSessionAsync(
          Resume,
          Token
        );
        discard await Acp.Configure(Connection, Id, Resumed.ConfigOptions, Choice, true, Token);
        return Id;
      end if;
    catch Failure: Rpc.RemoteInvocationException do
      // The authoritative game state still allows play with a replacement ACP conversation.
      Log.Failure('restore ACP session; opening a new session', Failure);
    end try;
  end if;

  return await Dialogs.NewSession(Connection, Directory, Choice, Servers, Token);
end function;

function PromptJson(): Json.JsonSerializerOptions;
begin
  const Options: Json.JsonSerializerOptions := new Json.JsonSerializerOptions();
  Options.PropertyNamingPolicy := Json.JsonNamingPolicy.CamelCase;
  Options.Encoder := Encoding.JavaScriptEncoder.UnsafeRelaxedJsonEscaping;
  return Options;
end function;

// Builds the authoritative turn prompt sent to the game master for one player command or opening.
public function TurnPrompt(Id: string; Value: Tools.Context; Command: string): string;
begin
  const JsonOptions: Json.JsonSerializerOptions := PromptJson();
  const Language: string := Global.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
  const Message: Buffers.StringBuilder := new Buffers.StringBuilder();
  discard Message.AppendLine(
    'You are the game master of Into the Dungeon. Treat the world state below and the dungeon MCP tools as authoritative.'
  );
  discard Message.AppendLine(
    'If the dungeon MCP tools are hidden, use tool discovery to load them. Use only the dungeon MCP tools for game actions, always passing the supplied turnId.'
  );
  discard Message.AppendLine(
    'The player sees ONLY the reply passed to submit_turn; your normal assistant message is ignored. Call submit_turn exactly once with turnId, action, target, and reply, then end the prompt immediately with minimal or no extra text.'
  );
  discard Message.AppendLine(
    'Style and UI: write in second person in the player language. Supply 1 to 800 characters of plain text without Markdown (no **, *, #, lists, or backticks) and without internal IDs (such as pump-room, brass-key, take_key, or turnId).'
  );
  discard Message.AppendLine(
    'The UI shows only the room name, room art, and narration log (no separate exit list, inventory panel, or action buttons). When arriving in a room or looking around, naturally mention open and blocked exits, present characters, and noticeable cue details so the player knows their options.'
  );
  discard Message.AppendLine(
    'Localization: use each room''s localized name from the JSON and keep character proper names (such as Mara, Iven, Edda, Ada) unchanged. Translate English descriptions, directions, cues, and outcomes naturally and consistently into the player language.'
  );
  discard Message.AppendLine(
    'Scene fields and spoiler rules: cue is visibly noticeable in the room. outcomeOrHint with available=true is the discovery or result—reveal it ONLY when submitting that exact action and target in this turn, never on none or unrelated commands. outcomeOrHint with available=false is a blocking hint—do NOT submit that action; use action "none" with target "" and narrate the hint. When alreadyLearned is true, acknowledge prior knowledge (talk or inspect may still be used if the player asks again, since characters can give updated replies).'
  );
  discard Message.AppendLine(
    'World boundaries: only characters present in the current room may speak; when the player talks to a present character, convey their voice and perspective. Never invent items, exits, characters, or world changes not backed by the scene or committed action, and never narrate an action as succeeded unless you submit it.'
  );
  discard Message.AppendLine(
    'Actions (one per turn): if the player asks for multiple steps at once, execute only the first valid action and do not narrate later steps as done. For movement, first call get_room(turnId, destinationRoomId) for an exit with open=true before describing arrival, then submit action "move" with that roomId. For a local interaction, copy an exact action and target from currentScene.interactions where available=true. For everything else—looking around, blocked attempts, inventory or status questions, giving directions, or impossible commands—use action "none" with target "".'
  );
  discard Message.AppendLine(
    'Final choice: explain the permanent cost before committing, and use resolve ONLY for an explicit player decision. After an ending is chosen, allow further exploration.'
  );
  discard Message.AppendLine(
    'Memory and directions: use get_journal for the latest 20 committed encounters (no pagination), search_memories for older encounters or filtered searches (pass exact internal speaker IDs such as mara or iven for person), get_history for recent turns by room, and find_route for directions to an exact visited room ID, exact English or German room name, or previously met speaker ID (status is here, route, blocked, unknown, or unmapped). If any tool rejects an input or action, correct it and retry.'
  );
  discard Message.AppendLine('Player language: ' + Language);
  discard Message.AppendLine('turnId: ' + Id);
  discard Message.AppendLine('World brief: ' + Value.WorldState.WorldBrief);
  discard Message.AppendLine('Current room ID: ' + Value.WorldState.RoomId);
  discard Message.AppendLine(
    'Recorded discoveries: ' + Json.JsonSerializer.Serialize<array of string>(
      Value.WorldState.Discoveries,
      JsonOptions
    )
  );
  discard Message.AppendLine(
    'Current scene: ' + Json.JsonSerializer.Serialize<Rooms.Scene>(
      Tools.GetRoom(Value, Value.WorldState.RoomId),
      JsonOptions
    )
  );
  if Value.History.Length > 0 then
    discard Message.AppendLine('Recent completed turns:');
    for Index: int := Sys.Math.Max(0, Value.History.Length - 4) to Value.History.Length - 1 do
      discard Message.AppendLine(
        Json.JsonSerializer.Serialize<Saves.Turn>(Value.History[Index], JsonOptions)
      );
    end for;
  end if;

  if Value.Opening then
    discard Message.AppendLine(
      'Describe the opening scene so the player knows where they are, what stands out, and what exits or clues are visible. Use action "none" and target "".'
    );
  else
    discard Message.AppendLine(
      'Player command as JSON: ' + Json.JsonSerializer.Serialize<string>(Command, JsonOptions)
    );
  end if;

  return Message.ToString();
end function;

async function Propose(
  Connection: Client.Connection; Id: P.SessionId; Current: Saves.Save; Path: string; State: World.State;
  Active: Collections.ConcurrentDictionary<string, Tools.Context?>; Command: string; Opening: bool;
  Token: Threads.CancellationToken; Log: Errors.Sink
): Tasks.Task<Tools.Proposal?>;
begin
  const Phase: string := if Opening then
    'opening turn'
  else
    'player turn'
  end if;
  const TurnId: string := Sys.Guid.NewGuid().ToString('N');
  const Submissions: Collections.ConcurrentDictionary<string, Tools.Proposal?> := new Collections.ConcurrentDictionary<string, Tools.Proposal?>();
  const Context: Tools.Context := new Tools.Context(
    Path,
    State,
    Current.History,
    Opening,
    Submissions
  );
  discard Active.TryAdd(TurnId, Context);
  try
    if not await Dialogs.Prompt(
      Connection,
      Id,
      TurnPrompt(TurnId, Context, Command),
      Token,
      Log,
      Phase
    )
    then
      return null;
    end if;

    Token.ThrowIfCancellationRequested();
    var Proposal: Tools.Proposal? := null;
    discard Submissions.TryGetValue('turn', out Proposal);
    if Proposal = null then
      Log.Write(Phase + ': ACP ended without an accepted submit_turn');
    end if;

    return Proposal;
  finally
    var Removed: Tools.Context? := null;
    discard Active.TryRemove(TurnId, out Removed);
  end try;
end function;

function Commit(Path: string; Current: Saves.Save; State: World.State; Command: string; Value: Tools.Proposal): Saves.Save;
begin
  const History: Lists.List<Saves.Turn> := new Lists.List<Saves.Turn>(Current.History);
  History.Add(Saves.Completed(State, Command, Value.Reply, Value.Action, Value.Target));
  const Next: Saves.Save := Current with
    History := History.ToArray();
    WorldState := Value.WorldState;
  end with;
  Saves.Write(Path, Next);
  return Next;
end function;

function Present(Path: string; History: array of Saves.Turn; State: World.State): Presentation;
begin
  return new Presentation(History, State.RoomId, Art.Load(Path, State, State.RoomId));
end function;

procedure RequestArt(Room: World.State; Frame: Presentation; Visits: Channels.Channel<Draw.Visit>?);
begin
  if Visits <> null and not Art.Complete(Frame.Images) then
    const Count: int := Frame.History.Length;
    discard Visits.Writer.TryWrite(
      new Draw.Visit(
        Room, if Count > 0 then
          Frame.History[Count - 1].Reply
        else
          ''
        end if
      )
    );
  end if;
end procedure;

async function Play(
  Connection: Client.Connection; Directory: string; Path: string; Choice: Settings.Choice;
  Saved: Saves.Save?; Initial: World.State; Servers: array of P.McpServer?;
  Active: Collections.ConcurrentDictionary<string, Tools.Context?>; Queue: Channels.Channel<string>; Visits: Channels.Channel<Draw.Visit>?;
  Post: function(Event): Tasks.Task; Token: Threads.CancellationToken; Log: Errors.Sink
): Tasks.Task<bool>;
begin
  using const Deadline: Threads.CancellationTokenSource := Threads.CancellationTokenSource.CreateLinkedTokenSource(
    Token
  );
  Deadline.CancelAfter(Sys.TimeSpan.FromSeconds(30));
  const Id: P.SessionId := await OpenSession(
    Connection,
    Directory,
    Choice,
    Saved,
    Servers,
    Deadline.Token,
    Log
  );
  Deadline.CancelAfter(Threads.Timeout.Infinite);
  var Current: Saves.Save := new Saves.Save(
    Choice, Id.ToString() ?? '', if Saved = null then
      []
    else
      Saved.History
    end if, Initial
  );
  var State: World.State := Initial;
  if Saved = null then
    const Opening: Tools.Proposal? := await Propose(
      Connection,
      Id,
      Current,
      Path,
      State,
      Active,
      '',
      true,
      Token,
      Log
    );
    if Opening = null then
      await Post(Event.Failed('Game.ToolsFailed'));
      return false;
    end if;

    Current := Commit(Path, Current, State, '', Opening);
  elsif Saved.SessionId <> Current.SessionId or Saved.GameMaster <> Current.GameMaster
    or Saved.WorldState = null
  then
    Saves.Write(Path, Current);
  end if;
  var Frame: Presentation := Present(Path, Current.History, State);
  await Post(Event.Ready(Frame));
  RequestArt(State, Frame, Visits);

  while await Queue.Reader.WaitToReadAsync(Token) do
    const Command: string := await Queue.Reader.ReadAsync(Token);
    const Next: Tools.Proposal? := await Propose(
      Connection,
      Id,
      Current,
      Path,
      State,
      Active,
      Command,
      false,
      Token,
      Log
    );
    if Next = null then
      await Post(Event.TurnRejected);
    else
      Current := Commit(Path, Current, State, Command, Next);
      State := Next.WorldState;
      const Entered: bool := Frame.RoomId <> State.RoomId;
      Frame := if Entered then
        Present(Path, Current.History, State)
      else
        Frame with
          History := Current.History;
        end with
      end if;
      await Post(Event.Ready(Frame));
      if Entered then
        RequestArt(State, Frame, Visits);
      end if;
    end if;
  end while;

  Token.ThrowIfCancellationRequested();
  Saves.Write(Path, Current);
  return true;
end function;

// Owns the save slot and the MCP listener for one active adventure.
public async function Run(
  Path: string; Choice: Settings.Choice; ContinueGame: bool; Queue: Channels.Channel<string>;
  Post: function(Event): Tasks.Task; Token: Threads.CancellationToken; GenerateRoomArt: bool := false
): Tasks.Task;
begin
  const Log: Errors.Sink := new Errors.Sink(Path, 'game', Choice.Agent);
  try
    using const Lease: IO.FileStream := new IO.FileStream(
      Path + '.lock', IO.FileMode.OpenOrCreate, IO.FileAccess.ReadWrite, IO.FileShare.None
    );
    const Saved: Saves.Save? := if ContinueGame then
      Saves.Load(Path)
    else
      null
    end if;
    const Initial: World.State := if Saved = null then
      World.NewAdventure()
    else
      Saved.WorldState ?? World.NewAdventure()
    end if;
    if Saved <> null then
      await Post(Event.Restored(Present(Path, Saved.History, Initial)));
    end if;
    const Exe: string := Agents.Resolve(Choice.Agent);
    if Exe = '' then
      Log.Write('ACP launcher missing from PATH');
      await Post(Event.Failed('Settings.AgentMissing'));
      return;
    end if;

    const Directory: string := IO.Directory.CreateDirectory(
      IO.Path.Combine(IO.Path.GetDirectoryName(Path) ?? '', 'game-master')
    ).FullName;
    const Active: Collections.ConcurrentDictionary<string, Tools.Context?> := new Collections.ConcurrentDictionary<string, Tools.Context?>();
    const GamePipe: string := 'dungeon-' + Sys.Guid.NewGuid().ToString('N');
    const ArtPipe: string := 'dungeon-art-' + Sys.Guid.NewGuid().ToString('N');
    const GameServers: array of P.McpServer? := [Mcp.AgentConfig(GamePipe)];
    using const Stop: Threads.CancellationTokenSource := Threads.CancellationTokenSource.CreateLinkedTokenSource(
      Token
    );
    const ArtPrompts: Draw.Registry := new Draw.Registry();
    const Visits: Channels.Channel<Draw.Visit>? := if GenerateRoomArt then
      Channels.Channel.CreateUnbounded<Draw.Visit>()
    else
      null
    end if;
    const ArtLog: Errors.Sink := new Errors.Sink(Path, 'room-art', Choice.Agent);
    const GameListener: Tasks.Task := Mcp.Listen(GamePipe, Tools.Register(Active, Log), Stop.Token);
    const ArtListener: Tasks.Task := if Visits = null then
      Tasks.Task.CompletedTask
    else
      Mcp.Listen(ArtPipe, Tools.RegisterArt(ArtPrompts, ArtLog), Stop.Token)
    end if;
    const Artist: Tasks.Task := if Visits = null then
      Tasks.Task.CompletedTask
    else
      Illustrator.Run(
        Visits.Reader, Path, Choice, Exe, Directory, [Mcp.AgentConfig(ArtPipe)], ArtPrompts,
        function(RoomId: string; Images: Art.Pair; Finished: bool): Tasks.Task => Post(
          Event.ArtChanged(RoomId, Images, Finished)
        ),
        Stop.Token,
        ArtLog
      )
    end if;
    const Peer: Callbacks.Callbacks := new Callbacks.Callbacks(
      procedure(Notification: P.SessionNotification) begin end procedure,
      procedure() begin
        discard Queue.Writer.TryComplete(new IO.IOException('The ACP agent disconnected.'));
      end procedure
    );
    try
      discard await Agents.Run<bool>(
        Choice.Agent, Exe, Directory, Peer,
        function(Connection: Client.Connection): Tasks.Task<bool> => Play(
          Connection,
          Directory,
          Path,
          Choice,
          Saved,
          Initial,
          GameServers,
          Active,
          Queue,
          Visits,
          Post,
          Token,
          Log
        ), Token, Log
      );
    finally
      Stop.Cancel();
      if Visits <> null then
        discard Visits.Writer.TryComplete();
      end if;

      await Tasks.Task.WhenAll([Artist, GameListener, ArtListener]);
    end try;
  catch Failure: Sys.OperationCanceledException when not Token.IsCancellationRequested do
    Log.Write('ACP session or prompt timed out');
    await Post(Event.Failed('Settings.Timeout'));
  catch Failure: Rpc.RemoteInvocationException when Failure.ErrorCode = -32000 do
    Log.Failure('ACP session requires sign-in', Failure);
    await Post(Event.Failed('Settings.SignIn'));
  catch Failure: Sys.Exception when not Token.IsCancellationRequested do
    Log.Failure('adventure', Failure);
    raise;
  finally
    discard Queue.Writer.TryComplete();
  end try;
end function;

end unit;
