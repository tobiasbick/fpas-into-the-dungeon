// Runs one adventure against the configured ACP agent.
unit Dungeon.Game.Session;

uses
  Dungeon.Acp.Processes as Agents, Dungeon.Acp.Discovery as Acp, Dungeon.Acp.ClientCallbacks as Callbacks,
  Dungeon.Game.Saves as Saves, Dungeon.Settings as Settings, dotacp.client as Client,
  dotacp.@protocol as P, StreamJsonRpc as Rpc, System as Sys, System.IO as IO,
  System.Globalization as Global, System.Collections.Concurrent as Collections, System.Collections.Generic as Lists,
  System.Threading as Threads, System.Threading.Channels as Channels, System.Threading.Tasks as Tasks;

// Results delivered from the background adventure to the terminal.
public type Event = variant
  Opened(History: array of Saves.Turn);
  Replied(History: array of Saves.Turn);
  Failed(Status: string);
end variant;

async function Prompt(
  Connection: Client.Connection; Id: P.SessionId; Text: string;
  Chunks: Collections.ConcurrentQueue<string>; Token: Threads.CancellationToken
): Tasks.Task<string>;
begin
  Chunks.Clear();
  const Content: P.TextContent := new P.TextContent();
  Content.Text := Text;
  const Request: P.PromptRequest := new P.PromptRequest();
  Request.SessionId := Id;
  Request.Prompt := [Content];
  using const Deadline: Threads.CancellationTokenSource := Threads.CancellationTokenSource.CreateLinkedTokenSource(
    Token
  );
  Deadline.CancelAfter(Sys.TimeSpan.FromMinutes(3));
  try
    discard await Connection.PromptAsync(Request, Deadline.Token);
  finally
    if Deadline.IsCancellationRequested then
      const Cancel: P.CancelNotification := new P.CancelNotification();
      Cancel.SessionId := Id;
      try
        using const CancelDeadline: Threads.CancellationTokenSource := new Threads.CancellationTokenSource(
          750
        );
        await Connection.CancelAsync(Cancel, CancelDeadline.Token).WaitAsync(CancelDeadline.Token);
      catch Failure: Sys.Exception do
        // Connection disposal closes the transport if the agent no longer responds.
      end try;
    end if;
  end try;
  const Reply: string := string.Concat(Chunks.ToArray()).Trim();
  if Reply = '' then
    raise new IO.InvalidDataException('The game master returned no text.');
  end if;

  return Reply;
end function;

async function OpenSession(
  Connection: Client.Connection; Directory: string; Choice: Settings.Choice;
  Saved: Saves.Save?; Token: Threads.CancellationToken
): Tasks.Task<P.SessionId>;
begin
  const Initialized: P.InitializeResponse := await Agents.Initialize(Connection, Token);
  if Saved = null then
    const Request: P.NewSessionRequest := new P.NewSessionRequest();
    Request.Cwd := Directory;
    Request.McpServers := [];
    const Started: P.NewSessionResponse := await Connection.NewSessionAsync(Request, Token);
    discard await Acp.Configure(
      Connection,
      Started.SessionId,
      Started.ConfigOptions,
      Choice,
      true,
      Token
    );
    return Started.SessionId;
  end if;

  const Id: P.SessionId := new P.SessionId(Saved.SessionId);
  const Caps: P.AgentCapabilities? := Initialized.AgentCapabilities;
  const Sessions: P.SessionCapabilities? := if Caps = null then
    null
  else
    Caps.SessionCapabilities
  end if;
  if Caps <> null and Caps.LoadSession then
    const Load: P.LoadSessionRequest := new P.LoadSessionRequest();
    Load.SessionId := Id;
    Load.Cwd := Directory;
    Load.McpServers := [];
    const Loaded: P.LoadSessionResponse := await Connection.LoadSessionAsync(Load, Token);
    discard await Acp.Configure(Connection, Id, Loaded.ConfigOptions, Choice, true, Token);
  elsif Sessions <> null and Sessions.Resume <> null then
    const Resume: P.ResumeSessionRequest := new P.ResumeSessionRequest();
    Resume.SessionId := Id;
    Resume.Cwd := Directory;
    Resume.McpServers := [];
    const Resumed: P.ResumeSessionResponse := await Connection.ResumeSessionAsync(Resume, Token);
    discard await Acp.Configure(Connection, Id, Resumed.ConfigOptions, Choice, true, Token);
  else
    raise new Sys.NotSupportedException('The selected ACP agent cannot load sessions.');
  end if;

  return Id;
end function;

function OpeningPrompt(): string;
begin
  return 'You are the game master of Into the Dungeon, a small classic text adventure. ' +
    'Open the game with a short description of a mysterious room and something the player can interact with. ' +
    'For each subsequent message, treat it as an in-game action and describe its consequences. ' +
    'Maintain continuity and keep your reply under 70 words in plain text. ' +
    'Play entirely in conversation without tools, files, or terminal commands. ' +
    'Begin in language ' + Global.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName +
    ' and follow the player''s language thereafter.';
end function;

procedure Collect(Notification: P.SessionNotification; Chunks: Collections.ConcurrentQueue<string>);
begin
  const Change: P.SessionUpdate? := Notification.Update;
  if Change <> null and Change is P.SessionUpdateAgentMessageChunk then
    const Update: P.SessionUpdateAgentMessageChunk := cast<P.SessionUpdateAgentMessageChunk>(Change);
    const Content: P.ContentBlock? := Update.Content;
    if Content <> null and Content is P.TextContent then
      Chunks.Enqueue(cast<P.TextContent>(Content).Text ?? '');
    end if;
  end if;
end procedure;

async function Play(
  Connection: Client.Connection; Directory: string; Path: string; Choice: Settings.Choice; Saved: Saves.Save?;
  Queue: Channels.Channel<string>; Chunks: Collections.ConcurrentQueue<string>;
  Post: function(Event): Tasks.Task; Token: Threads.CancellationToken
): Tasks.Task<bool>;
begin
  using const Deadline: Threads.CancellationTokenSource := Threads.CancellationTokenSource.CreateLinkedTokenSource(
    Token
  );
  Deadline.CancelAfter(Sys.TimeSpan.FromSeconds(30));
  const Id: P.SessionId := await OpenSession(Connection, Directory, Choice, Saved, Deadline.Token);
  Deadline.CancelAfter(Threads.Timeout.Infinite);
  const History: Lists.List<Saves.Turn> := new Lists.List<Saves.Turn>();
  if Saved = null then
    const Reply: string := await Prompt(Connection, Id, OpeningPrompt(), Chunks, Token);
    History.Add(new Saves.Turn('', Reply));
    Saves.Write(Path, new Saves.Save(Choice, Id.ToString() ?? '', History.ToArray()));
  else
    History.AddRange(Saved.History);
  end if;

  await Post(Event.Opened(History.ToArray()));

  while true do
    const Command: string := await Queue.Reader.ReadAsync(Token);
    const Reply: string := await Prompt(Connection, Id, Command, Chunks, Token);
    History.Add(new Saves.Turn(Command, Reply));
    const Next: array of Saves.Turn := History.ToArray();
    Saves.Write(Path, new Saves.Save(Choice, Id.ToString() ?? '', Next));
    await Post(Event.Replied(Next));
  end while;
end function;

// Owns the save slot and the agent until the game closes.
public async function Run(
  Path: string; Choice: Settings.Choice; ContinueGame: bool; Queue: Channels.Channel<string>;
  Post: function(Event): Tasks.Task; Token: Threads.CancellationToken
): Tasks.Task;
begin
  try
    using const Lease: IO.FileStream := new IO.FileStream(
      Path + '.lock', IO.FileMode.OpenOrCreate, IO.FileAccess.ReadWrite, IO.FileShare.None
    );
    const Saved: Saves.Save? := if ContinueGame then
      Saves.Load(Path)
    else
      null
    end if;
    const Selected: Settings.Choice := if Saved = null then
      Choice
    else
      Saved.GameMaster
    end if;
    const Exe: string := Agents.Resolve(Selected.Agent);
    if Exe = '' then
      await Post(Event.Failed('Settings.AgentMissing'));
      return;
    end if;

    // A saved ACP session must reopen in the same working directory.
    const Directory: string := IO.Directory.CreateDirectory(
      IO.Path.Combine(IO.Path.GetDirectoryName(Path) ?? '', 'game-master')
    ).FullName;
    const Chunks: Collections.ConcurrentQueue<string> := new Collections.ConcurrentQueue<string>();
    const Peer: Callbacks.Callbacks := new Callbacks.Callbacks(
      procedure(Notification: P.SessionNotification) begin
        Collect(Notification, Chunks);
      end procedure,
      procedure() begin
        discard Queue.Writer.TryComplete();
      end procedure
    );
    discard await Agents.Run<bool>(
      Selected.Agent, Exe, Directory, Peer,
      function(Connection: Client.Connection): Tasks.Task<bool> => Play(
        Connection,
        Directory,
        Path,
        Selected,
        Saved,
        Queue,
        Chunks,
        Post,
        Token
      )
    );
  catch Failure: Sys.OperationCanceledException when not Token.IsCancellationRequested do
    await Post(Event.Failed('Settings.Timeout'));
  catch Failure: Rpc.RemoteInvocationException when Failure.ErrorCode = -32000
    and not ContinueGame do
    await Post(Event.Failed('Settings.SignIn'));
  catch Failure: Sys.NotSupportedException do
    await Post(Event.Failed('Game.ResumeUnsupported'));
  finally
    discard Queue.Writer.TryComplete();
  end try;
end function;

end unit;
