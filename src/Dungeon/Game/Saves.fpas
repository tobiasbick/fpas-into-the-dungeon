// Stores the game's single continue slot next to the player settings.
unit Dungeon.Game.Saves;

uses Dungeon.DataFiles as Files;
uses Dungeon.Game.World as World;
uses Dungeon.Settings as Settings;
uses System as Sys;
uses System.IO as IO;
uses System.Text.Json as Json;

// A completed exchange. The opening scene has an empty command.
public type Turn = record
  public Command: string;
  public Reply: string;
  public RoomId: string := '';
  public Action: string := '';
  public Target: string := '';
  public Fact: string := '';
  public Person: string := '';
end record;

// Identifies the ACP session and its player-visible conversation.
public type Save = record
  // The agent that owns SessionId and the settings used to open it.
  public GameMaster: Settings.Choice;
  public SessionId: string;
  public History: array of Turn;
  // Absent in saves written before the two-room adventure.
  public WorldState: World.State? := null;
end record;

// Freeze the encounter as it was when the command was accepted.
public function Completed(
  Before: World.State;
  Command: string;
  Reply: string;
  Action: string;
  Target: string
): Turn;
begin
  const Note: World.ActionNote := Before.RecordAction(Action, Target);
  return new Turn(Command, Reply, Before.RoomId, Action, Target, Note.Fact, Note.Person);
end function;

// Locates the one resumable adventure.
public function PathFor(SettingsPath: string): string;
begin
  return IO.Path.Combine(IO.Path.GetDirectoryName(SettingsPath) ?? '', 'adventure.json');
end function;

function Options(): Json.JsonSerializerOptions;
begin
  const Value: Json.JsonSerializerOptions := new Json.JsonSerializerOptions();
  Value.PropertyNamingPolicy := Json.JsonNamingPolicy.CamelCase;
  Value.WriteIndented := true;
  return Value;
end function;

function SavedText(Value: string?): string;
begin
  return Value ?? '';
end function;

// Reads the exact ACP session and conversation stored by the client.
public function Load(Path: string): Save;
begin
  const Value: Save? := Json.JsonSerializer.Deserialize of Save(
    IO.File.ReadAllText(Path),
    Options()
  );
  if Value = null or Value.GameMaster = null or Value.GameMaster.Agent = ''
    or Sys.String.IsNullOrWhiteSpace(Value.SessionId) or Value.History = null
  then
    raise new IO.InvalidDataException('Invalid adventure.json.');
  end if;

  for Index: int := 0 to Value.History.Length - 1 do
    const Entry: Turn := Value.History[Index];
    if Entry = null or Entry.Command = null or Entry.Reply = null then
      raise new IO.InvalidDataException('Invalid adventure transcript.');
    end if;

    // JSON from earlier releases can supply null for omitted constructor fields.
    if Entry.RoomId = null or Entry.Action = null or Entry.Target = null or Entry.Fact = null
      or Entry.Person = null
    then
      Value.History[Index] := new Turn(
        Entry.Command, Entry.Reply, SavedText(Entry.RoomId), SavedText(Entry.Action),
        SavedText(Entry.Target), SavedText(Entry.Fact), SavedText(Entry.Person)
      );
    end if;
  end for;
  const State: World.State? := Value.WorldState;
  if State <> null then
    const Restored: World.State := State.Restore();
    if not World.Valid(Restored) then
      raise new IO.InvalidDataException('Invalid saved world.');
    end if;

    return Value with
      WorldState := Restored;
    end with;
  end if;

  return Value;
end function;

// Replaces the slot atomically so a partial write cannot erase saved play.
public procedure Write(Path: string; Value: Save);
begin
  Files.Write(Path, Json.JsonSerializer.Serialize of Save(Value, Options()), true);
end procedure;

end unit;
