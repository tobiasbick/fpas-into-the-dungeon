// Validates, decodes and stores a room's two generated terminal drawings.
unit Dungeon.Game.Art;

uses
  Dungeon.Game.World as World, Dungeon.DataFiles as Files, Fpas.Ui.Widgets.Developer.Terminal as T, Fpas.Ui.Tui.Internal.Rendering.Glyphs as Glyphs,
  System as Sys, System.Collections.Generic as Lists, System.ComponentModel as ComponentModel, System.IO as IO, System.Globalization as Global, System.Text.Json as Json,
  System.Text.Encodings.Web as Encoding;

public const Small: int := 50;
public const Large: int := 65;
public const Keys: string := '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';

public type Tile = record
  [ComponentModel.DescriptionAttribute(
    'One printable, single-cell Unicode glyph such as space, box lines, blocks, or shades.'
  )]
  public Glyph: string;
  [ComponentModel.DescriptionAttribute(
    'Foreground color as #RRGGBB from the active district palette.'
  )]
  public Foreground: string;
  [ComponentModel.DescriptionAttribute(
    'Background color as #RRGGBB from the active district palette.'
  )]
  public Background: string;
end record;

// One palette key represents one terminal cell. Short rows have an implicit tile-zero tail.
public type Drawing = record
  [ComponentModel.DescriptionAttribute('Requested drawing width in columns: 50 or 65.')]
  public Columns: int;
  [ComponentModel.DescriptionAttribute(
    'Zero-based X coordinate of the main landmark inside the drawing (0 to columns - 1).'
  )]
  public FocusX: int;
  [ComponentModel.DescriptionAttribute(
    'Zero-based Y coordinate of the main landmark inside the drawing (0 to rows - 1).'
  )]
  public FocusY: int;
  [ComponentModel.DescriptionAttribute(
    '1 to 36 tiles indexed by 0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ. Tile 0 is the ambient background.'
  )]
  public Palette: array of Tile;
  [ComponentModel.DescriptionAttribute(
    'Exactly 16 rows (for 50 columns) or 21 rows (for 65 columns) of palette-index characters, each at most columns long. Trailing 0 cells may be omitted.'
  )]
  public Rows: array of string;
end record;

public type Picture = record
  public Source: Drawing;
  public Cells: array of T.Cell;
end record;

public type Pair = record
  public Compact: Picture? := null;
  public Full: Picture? := null;
end record;

public function Height(Columns: int): int;
begin
  if Columns = Small then
    return 16;
  elsif Columns = Large then
    return 21;
  end if;

  raise new IO.InvalidDataException('Choose a width of 50 or 65 cells.');
end function;

function Color(Text: string; Allowed: (array of string)?): int;
begin
  var Value: int := 0;
  if Text = null or Text.Length <> 7 or Text[0] <> #35 or not int.TryParse(
    Text.Substring(1),
    Global.NumberStyles.AllowHexSpecifier, Global.CultureInfo.InvariantCulture, out Value
  )
  then
    raise new IO.InvalidDataException('Use #RRGGBB for each foreground and background.');
  end if;

  if Allowed <> null and not Sys.Array.Exists<string>(
    Allowed,
    function(Shade: string): bool => Sys.String.Equals(
      Shade,
      Text,
      Sys.StringComparison.OrdinalIgnoreCase
    )
  )
  then
    raise new IO.InvalidDataException(
      Text + ' is outside the district palette. Use ' + Sys.String.Join(', ', Allowed) + '.'
    );
  end if;

  return Value;
end function;

public function Decode(Value: Drawing; Width: int; Allowed: (array of string)? := null): Picture;
begin
  const Rows: int := Height(Width);
  if Value = null or Value.Columns <> Width or Value.Rows = null or Value.Rows.Length <> Rows then
    raise new IO.InvalidDataException(
      'Expected ' + Width.ToString() + ' columns and ' + Rows.ToString() + ' rows.'
    );
  end if;

  if Value.FocusX < 0 or Value.FocusX >= Width or Value.FocusY < 0 or Value.FocusY >= Rows then
    raise new IO.InvalidDataException('Place the zero-based focus inside the drawing.');
  end if;

  if Value.Palette = null or Value.Palette.Length < 1 or Value.Palette.Length > Keys.Length then
    raise new IO.InvalidDataException('Supply 1 to 36 palette tiles.');
  end if;
  const Palette: Lists.List<T.Cell> := new Lists.List<T.Cell>(Value.Palette.Length);
  for Index: int := 0 to Value.Palette.Length - 1 do
    const Ink: Tile := Value.Palette[Index];
    if Ink = null or Ink.Glyph = null or Ink.Glyph.Length = 0 or Ink.Glyph.Length > 32
      or Global.StringInfo.GetNextTextElement(
      Ink.Glyph
    ) <> Ink.Glyph or Glyphs.Width(Ink.Glyph) <> 1
      or Glyphs.Sanitize(
      Ink.Glyph
    ) <> Ink.Glyph or Ink.Glyph = #8232.ToString() or Ink.Glyph = #8233.ToString()
    then
      raise new IO.InvalidDataException(
        'Use one printable, single-cell Unicode text element per tile.'
      );
    end if;

    Palette.Add(
      new T.Cell(
        Ink.Glyph,
        new T.Style(Color(Ink.Foreground, Allowed), Color(Ink.Background, Allowed))
      )
    );
  end for;
  const Cells: Lists.List<T.Cell> := new Lists.List<T.Cell>(Width * Rows);
  for Y: int := 0 to Rows - 1 do
    const Line: string := Value.Rows[Y];
    if Line = null or Line.Length > Width then
      raise new IO.InvalidDataException(
        'Row ' + Y.ToString() + ' exceeds the requested width or is null.'
      );
    end if;

    for X: int := 0 to Width - 1 do
      const Key: int := if X < Line.Length then
        Keys.IndexOf(Line[X])
      else
        0
      end if;
      if Key < 0 or Key >= Palette.Count then
        raise new IO.InvalidDataException('Unknown palette key in row ' + Y.ToString() + '.');
      end if;

      Cells.Add(Palette[Key]);
    end for;
  end for;

  return new Picture(Value, Cells.ToArray());
end function;

function Options(): Json.JsonSerializerOptions;
begin
  const Result: Json.JsonSerializerOptions := new Json.JsonSerializerOptions();
  Result.RespectRequiredConstructorParameters := true;
  Result.PropertyNamingPolicy := Json.JsonNamingPolicy.CamelCase;
  Result.Encoder := Encoding.JavaScriptEncoder.UnsafeRelaxedJsonEscaping;
  return Result;
end function;

public function Encode(Value: Picture): string;
begin
  return Json.JsonSerializer.Serialize<Drawing>(Value.Source, Options());
end function;

function PathFor(SavePath: string; State: World.State; RoomId: string; Width: int): string;
begin
  if not World.KnownRoom(RoomId) then
    raise new Sys.ArgumentException('Unknown room art ID.');
  end if;

  return IO.Path.Combine(
    IO.Path.GetDirectoryName(SavePath) ?? '', 'art', State.AdventureId,
    RoomId + '-' + Width.ToString() + 'x' + Height(Width).ToString() + '-v1.json'
  );
end function;

function Read(SavePath: string; State: World.State; RoomId: string; Width: int): Picture?;
begin
  const Path: string := PathFor(SavePath, State, RoomId, Width);
  try
    if not IO.File.Exists(Path) then
      return null;
    end if;

    using const Stream: IO.FileStream := IO.File.OpenRead(Path);
    if Stream.Length > 65536 then
      return null;
    end if;
    const Data: Drawing? := Json.JsonSerializer.Deserialize<Drawing>(Stream, Options());
    if Data = null then
      return null;
    end if;

    return Decode(Data, Width);
  catch Failure: Sys.Exception when Failure is IO.IOException or Failure is IO.InvalidDataException
    or Failure is Json.JsonException or Failure is Sys.UnauthorizedAccessException do
    return null;
  end try;
end function;

public function Load(SavePath: string; State: World.State; RoomId: string): Pair;
begin
  return new Pair(Read(SavePath, State, RoomId, Small), Read(SavePath, State, RoomId, Large));
end function;

public function Complete(Value: Pair): bool;
begin
  return Value.Compact <> null and Value.Full <> null;
end function;

// Only the adventure's single art worker publishes. An interrupted write leaves its sibling intact.
public procedure Store(SavePath: string; State: World.State; Image: Picture);
begin
  const Width: int := Image.Source.Columns;
  if Read(SavePath, State, State.RoomId, Width) = null then
    Files.Write(PathFor(SavePath, State, State.RoomId, Width), Encode(Image), true);
  end if;
end procedure;

end unit;
