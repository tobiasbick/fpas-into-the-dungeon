// Scopes the art submission tool to one requested size, room and active prompt.
unit Dungeon.Game.ArtRequests;

uses
  Dungeon.Game.Art as Art, Dungeon.Game.Catalog as Catalog, Dungeon.Game.World as World,
  ModelContextProtocol as Mcp, System as Sys, System.IO as IO,
  System.Collections.Concurrent as Concurrent, System.Threading as Threads, System.Threading.Tasks as Tasks;

public type Request = record
  public Width: int;
  Palette: array of string;
  Result: Tasks.TaskCompletionSource<Art.Picture>;

  public static function Create(Width: int; Palette: array of string): Request;
  begin
    return new Request(Width, Palette, new Tasks.TaskCompletionSource<Art.Picture>());
  end function;

  public function IsCompleted(): bool;
  begin
    return self.Result.Task.IsCompleted;
  end function;

  public function TryAccept(Drawing: Art.Drawing): bool;
  begin
    const Image: Art.Picture := Art.Picture.Decode(Drawing, self.Width, self.Palette);
    return self.Result.TrySetResult(Image) or self.Result.Task.Result.Encode() = Image.Encode();
  end function;

  public function Accepted(): Art.Picture?;
  begin
    if not self.Result.Task.IsCompletedSuccessfully then
      return null;
    end if;

    return self.Result.Task.Result;
  end function;
end record;

public type Registry = Concurrent.ConcurrentDictionary<string, Request?>;

public type Visit = record
  public State: World.State;
  public Narration: string;
end record;

// A retry with the same drawing is safe. A second different drawing cannot replace the first.
public function Submit(Active: Registry; RequestId: string; Drawing: Art.Drawing): string;
begin
  var Pending: Request? := null;
  if not Active.TryGetValue(RequestId, out Pending) or Pending = null then
    raise new Mcp.McpException('Use the requestId from the active illustration prompt.');
  end if;

  try
    if not Pending.TryAccept(Drawing) then
      raise new Mcp.McpException('This request already has a drawing.');
    end if;
  catch Failure: IO.InvalidDataException do
    raise new Mcp.McpException(Failure.Message);
  end try;

  return 'Drawing accepted. End the prompt.';
end function;

function Instructions(Id: string; Place: Catalog.Place; Narration: string; Width: int; Sibling: Art.Picture?): string;
begin
  const Rows: int := Art.Height(Width);
  const SampleColor: string := Place.ArtPalette[0];
  const AccentColor: string := if Place.ArtPalette.Length > 1 then
    Place.ArtPalette[1]
  else
    SampleColor
  end if;
  const Guide: string := if Sibling = null then
    'Choose an original composition for this room.'
  else
    'Match the subject, viewpoint, light and focus of the saved companion drawing. Adapt its detail to this size and choose the closest colors from the district palette. Companion JSON: ' +
    Sibling.Encode()
  end if;
  return 'Illustrate a room for a Unicode terminal adventure. If submit_room_art is hidden, use tool discovery to load it. Call submit_room_art with requestId ' +
    Id +
    '. Only the tool submission is used; end the prompt immediately after acceptance.' + #10 +
    'Draw a landscape of ' + Width.ToString() + ' columns and ' + Rows.ToString() +
    ' rows. Set drawing.columns to ' + Width.ToString() + ' and zero-based focusX (0..' +
    (Width - 1).ToString() + ') and focusY (0..' + (Rows - 1).ToString() +
    ') on the main landmark.' + #10 +
    'Build drawing.palette with 1 to 36 tiles, each having glyph, foreground, and background (#RRGGBB). Use only these district colors for both foreground and background: ' +
    Sys.String.Join(', ', Place.ArtPalette) +
    '. Use single-cell printable Unicode glyphs such as space, box lines, blocks and shades. Make tile 0 the ambient background.' +
    #10 +
    'Provide drawing.rows as an array of exactly ' + Rows.ToString() +
    ' strings (never fewer), each at most ' + Width.ToString() +
    ' characters of palette indexes 0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ, one per cell. Trailing 0 cells may be omitted (an empty string means all tile 0).' +
    #10 +
    'Example drawing JSON shape: {"columns":' + Width.ToString() + ',"focusX":' +
    (Width div 2).ToString() + ',"focusY":' + (Rows div 2).ToString() +
    ',"palette":[{"glyph":" ","foreground":"' + AccentColor + '","background":"' + SampleColor +
    '"},{"glyph":"▒","foreground":"' + AccentColor + '","background":"' + SampleColor +
    '"}],"rows":["0011...", "..."]}.' + #10 +
    'Compose architecture with depth, texture, and a strong silhouette; omit titles and text. ' +
    'Prefer lasting scenery. Correct validation errors and finish after acceptance.' + #10 + Guide +
    #10 +
    'Room: ' + Place.Room.Name + ', ' + Place.DistrictName + '. ' + Place.Room.Description + #10 +
    'Scene narration for visual context: ' + Narration;
end function;

// Check disk again on dequeue. Each accepted variant is published before the next prompt.
public async function Fill(
  Path: string; Room: Visit; Active: Registry;
  Ask: function(string): Tasks.Task<bool>; Updated: function(Art.Pair): Tasks.Task;
  Token: Threads.CancellationToken
): Tasks.Task;
begin
  var Images: Art.Pair := Art.Pair.Load(Path, Room.State, Room.State.RoomId);
  const Place: Catalog.Place := Catalog.At(Room.State.RoomId);
  for Width: int in Images.MissingWidths() do
    Token.ThrowIfCancellationRequested();
    const Id: string := Sys.Guid.NewGuid().ToString('N');
    const Request: Request := Request.Create(Width, Place.ArtPalette);
    if not Active.TryAdd(Id, Request) then
      raise new Sys.InvalidOperationException('Duplicate art request ID.');
    end if;

    try
      const Finished: bool := await Ask(
        Instructions(Id, Place, Room.Narration, Width, Images.Compact ?? Images.Full)
      );
      const Image: Art.Picture? := Request.Accepted();
      if not Finished or Image = null then
        return;
      end if;

      Token.ThrowIfCancellationRequested();
      Image.Store(Path, Room.State);
      Images := Art.Pair.Load(Path, Room.State, Room.State.RoomId);
      await Updated(Images);
    finally
      var Removed: Request? := null;
      discard Active.TryRemove(Id, out Removed);
    end try;
  end for;
end function;

end unit;
