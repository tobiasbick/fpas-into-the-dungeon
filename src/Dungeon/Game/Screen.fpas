// Draws the adventure using FPAS terminal controls.
unit Dungeon.Game.Screen;

uses Fpas.Ui.Elements as E;
uses Fpas.Ui.Graphics as G;
uses Fpas.Ui.Layout as L;
uses Fpas.Ui.Styles as S;
uses Fpas.Ui.TerminalExtensions.CellGrids as Grids;
uses Fpas.Ui.TerminalExtensions.Input as Keys;
uses Fpas.Ui.TerminalExtensions.Views as Views;
uses Fpas.Ui.Tui.Internal.Widgets.Inputs.TextAreaRows as Lines;
uses Fpas.Ui.Widgets.Desktop.StatusBars as Bars;
uses Fpas.Ui.Widgets.Developer.Terminal as T;
uses Fpas.Ui.Widgets.Inputs.TextAreas as Areas;
uses Fpas.Ui.Widgets.Theming.Themes as Themes;

uses Dungeon.Game.Art as Art;
uses Dungeon.Game.ArtCanvas as CanvasArt;
uses Dungeon.Game.Catalog as Catalog;
uses Dungeon.Game.Saves as Saves;
uses Dungeon.Resources.Strings as Strings;
uses Dungeon.StartScreen as Start;
uses System as Sys;
uses System.Collections.Generic as Collections;

public type Input = variant
  Edit(Text: string);
  ArtSize(Width: int; Height: int);
  Scroll(Position: L.ScrollPosition);
  Send;
  Back;
  Exit;
  Ignore;
end variant;

public type Model = record
  public History: array of Saves.Turn := [];
  public Draft: string := '';
  public Pending: string := '';
  public Status: string := 'Game.Opening';
  public Failed: bool := false;
  public Scroll: L.ScrollPosition := L.ScrollPosition.End;
  public RoomId: string := '';
  public Images: Art.Pair := new Art.Pair();
  public ArtWidth: int := 0;
  public ArtHeight: int := 0;
  public ArtUnavailable: bool := false;
  public GenerateRoomArt: bool := false;
  public Closing: bool := false;
end record;

public const CommandId: string := 'game-command';

const Fill: L.Flex := new L.Flex(Basis := L.Extent.Fill, Grow := 1.0F);

function Fixed(Cells: int): L.Flex;
begin
  return new L.Flex(Basis := L.Extent.Fixed(L.Measure.Cells(Cells)));
end function;

function Heading(Text: string): E.Element of Input;
begin
  return E.Styled of Input(E.Text of Input(Text), S.Role.Heading);
end function;

function Divider(Height: int): E.Element of Input;
begin
  const Row: E.Element of Input := Heading('│');
  const Rows: Collections.List of E.Element of Input := new Collections.List of E.Element of Input(
    Height
  );
  for Index: int := 1 to Height do
    Rows.Add(Row);
  end for;

  return E.Column of Input(Rows.ToArray());
end function;

function Log(Value: Model; Width: int): E.Element of Input;
begin
  const Turns: Collections.List of string := new Collections.List of string();
  for Entry: Saves.Turn in Value.History do
    Turns.Add(
      if Entry.Command = '' then
        Entry.Reply
      else
        '> ' + Entry.Command + #10 + Entry.Reply
      end if
    );
  end for;

  if Value.Pending <> '' then
    Turns.Add('> ' + Value.Pending);
  end if;
  const Text: string := string.Join('' + #10 + #10, Turns);
  const Rows: array of E.Element of Input := Sys.Array.ConvertAll of (Lines.Line, E.Element of Input)(
    Lines.Wrap(Text, Sys.Math.Max(1, Width - 1)),
    function(Row: Lines.Line): E.Element of Input => E.Text of Input(
      if Row.Start = Row.Stop then
        ' '
      else
        Text.Substring(Row.Start, Row.Stop - Row.Start)
      end if
    )
  );
  return E.ScrollView of Input(
    'game-log', E.Column of Input(Rows), Value.Scroll,
    function(Change: L.ScrollChange): Input => Input.Scroll(Change.Position)
  );
end function;

function GridEvent(Value: Grids.Event): Input;
begin
  case Value of
    when Grids.Event.Resized(const Width: int, const Height: int):
      return Input.ArtSize(Width, Height);
    else
      return Input.Ignore;
  end case;
end function;

function PlayArea(
  Value: Model;
  Title: string;
  Left: int;
  Right: int;
  ArtRows: int;
  ShowArt: bool
): E.Element of Input;
begin
  if not ShowArt then
    return E.Column of Input(
      Heading(' ' + Title),
      E.Size of Input(Log(Value, Left + Right + 1), Fill)
    );
  end if;
  const Width: int := if Value.ArtWidth > 0 then
    Value.ArtWidth
  else
    Left
  end if;
  const Height: int := if Value.ArtHeight > 0 then
    Value.ArtHeight
  else
    ArtRows
  end if;
  const Image: Art.Picture? := CanvasArt.SelectImage(Value.Images, Width, Height);
  const Illustration: E.Element of Input := if Image = null then
    E.Column of Input(
      new L.Flow(Align := L.Alignment.Center), E.Size of Input(E.Text of Input(' '), Fill),
      E.Text of Input(
        Strings.Get(
          if not Value.GenerateRoomArt then
            'Game.ArtDisabled'
          elsif Value.ArtUnavailable then
            'Game.ArtUnavailable'
          else
            'Game.RoomPlaceholder'
          end if
        )
      ),
      E.Size of Input(E.Text of Input(' '), Fill)
    )
  else
    Grids.CellGrid of Input('game-art', CanvasArt.Render(Image, Width, Height), GridEvent)
  end if;
  const Room: E.Element of Input := E.Column of Input(
    Heading(' ' + Title),
    E.Size of Input(Illustration, Fill)
  );
  return E.Row of Input(
    new L.Flow(Align := L.Alignment.Stretch), E.Size of Input(Room, Fixed(Left)),
    E.Size of Input(Divider(ArtRows + 1), Fixed(1)),
    E.Size of Input(
      E.Column of Input(
        Heading(' ' + Strings.Get('Game.Log')),
        E.Size of Input(Log(Value, Right), Fill)
      ),
      Fill
    )
  );
end function;

function Canvas(Value: Model; Size: T.Viewport): E.Element of Input;
begin
  const Inner: int := Sys.Math.Max(3, Size.Columns - 2);
  const Left: int := (Inner - 1) * 2 div 3;
  const Right: int := Inner - Left - 1;
  const ArtRows: int := Sys.Math.Max(1, Size.Rows - 9);
  const ShowArt: bool := Left >= 24 and ArtRows >= 8;
  const Title: string := if not Catalog.Contains(Value.RoomId) then
    Strings.Get('Game.Room')
  else
    Catalog.DisplayName(Value.RoomId)
  end if;
  const Play: E.Element of Input := PlayArea(Value, Title, Left, Right, ArtRows, ShowArt);
  const Send: string := '─ ' + Strings.Get('Game.Send') + ' ';
  const Line: string := '─';
  const Rule: string := Send + new string(Line[0], Sys.Math.Max(0, Inner - Send.Length));
  const Editor: E.Element of Input := Areas.TextArea of Input(
    CommandId, Value.Draft, Input.Edit, new Areas.Options(Height := 48)
  );
  const Status: string := if Value.Closing then
    Strings.Get('Game.Saving')
  elsif Value.Status = '' then
    ''
  else
    Strings.Get(Value.Status)
  end if;
  const Bar: E.Element of Input := Bars.StatusBar of Input(
    'game-status',
    [
      (Bars.Item of Input).Text(new Bars.Label(Status)),
      (Bars.Item of Input).Spacer,
      (Bars.Item of Input).Text(
        new Bars.Label(Strings.Get('Game.Back') + '  ' + Strings.Get('Game.Exit'))
      )
    ]
  );
  return E.Border of Input(
    E.Column of Input(
      E.Size of Input(Play, Fill),
      E.Size of Input(E.Styled of Input(E.Text of Input(Rule), S.Role.Heading), Fixed(1)),
      Editor,
      Bar
    )
  );
end function;

// Adds terminal shortcuts outside the editor's own navigation and editing keys.
public function View(Value: Model): E.Element of Input;
begin
  return Views.Screen of Input(
    Views.Viewport of Input(
      'game-screen', function(Size: T.Viewport): E.Element of Input => Canvas(Value, Size)
    ), [],
    [
      Keys.Shortcut of Input(Keys.Key.F2, Keys.KeyModifiers.None, Input.Send),
      Keys.Shortcut of Input(Keys.Key.F9, Keys.KeyModifiers.None, Input.Back),
      Keys.Shortcut of Input(Keys.Key.F10, Keys.KeyModifiers.None, Input.Exit),
      Keys.Shortcut of Input(
        Keys.Key.Escape, Keys.KeyModifiers.None, if Value.Failed then
          Input.Back
        else
          Input.Ignore
        end if
      )
    ]
  );
end function;

// Keeps the adventure in the start screen's palette and gives the editor a distinct surface.
public function Theme(): Themes.Theme;
begin
  const Base: Themes.Theme := Start.Theme();
  return Base with
    Colors := Base.Colors with
      Surface := new G.Color(13, 6, 5, 255);
      SurfaceMuted := new G.Color(30, 15, 11, 255);
      BorderSubtle := Base.Colors.Border;
      FocusRing := Base.Colors.Foreground;
    end with;
  end with;
end function;

end unit;
