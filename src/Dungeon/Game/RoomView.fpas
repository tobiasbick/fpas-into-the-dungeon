// Projects only local scenery, travel options and character knowledge for the GM.
unit Dungeon.Game.RoomView;

uses Dungeon.Game.Catalog as Catalog, Dungeon.Game.World as World, System as Sys, System.Collections.Generic as Lists;

public type ExitInfo = record
  public Direction: string;
  public RoomId: string;
  public Name: string;
  public Open: bool;
  public Obstacle: string;
end record;

public type Interaction = record
  public Action: string;
  public Target: string;
  public Cue: string;
  public Available: bool;
  public OutcomeOrHint: string;
  public AlreadyLearned: bool;
end record;

public type Scene = record
  public Id: string;
  public Name: string;
  public District: string;
  public Description: string;
  public Details: array of string;
  public Exits: array of ExitInfo;
  public Interactions: array of Interaction;
  public Inventory: array of string;
  public Lake: string;
  public Ending: string;
  public ImageReady: bool;
end record;

public function Describe(State: World.State; Id: string; HasImage: bool): Scene;
begin
  const Place: Catalog.Place := Catalog.At(Id);
  const Details: Lists.List<string> := new Lists.List<string>();
  for Detail: Catalog.Change in Place.Room.Changes ?? Sys.Array.Empty<Catalog.Change>() do
    if World.Matches(State, Detail.Condition) then
      Details.Add(Detail.Text);
    end if;
  end for;

  const Exits: Lists.List<ExitInfo> := new Lists.List<ExitInfo>();
  for Route: Catalog.Route in Place.Routes do
    const Obstacle: string := World.PassageObstacle(State, Route, true);
    Exits.Add(
      new ExitInfo(
        Route.Direction,
        Route.Destination,
        Catalog.DisplayName(Route.Destination),
        Obstacle = '',
        Obstacle
      )
    );
  end for;

  const Offers: Lists.List<Interaction> := new Lists.List<Interaction>();
  for Entry: Catalog.Encounter in Place.Room.Encounters ?? Sys.Array.Empty<Catalog.Encounter>() do
    if not World.Visible(State, Entry) then
      continue;
    end if;

    if Id <> State.RoomId then
      if Entry.Action = 'talk' then
        Details.Add(Entry.Cue);
      end if;
    else
      const Allowed: bool := World.Available(State, Entry);
      Offers.Add(
        new Interaction(
          Entry.Action, Entry.Target, Entry.Cue, Allowed,
          if Allowed then
            World.Outcome(State, Entry)
          else
            Entry.Hint ?? ''
          end if,
          Entry.Effect = 'remember' and World.Matches(State, Entry.Target)
        )
      );
    end if;
  end for;

  return new Scene(
    Id, Catalog.DisplayName(Id), Place.DistrictName, Place.Room.Description, Details.ToArray(),
    Exits.ToArray(), Offers.ToArray(), if State.HasKey then
      [World.BrassKey]
    else
      []
    end if,
    State.Lake, State.Ending, HasImage
  );
end function;

end unit;
