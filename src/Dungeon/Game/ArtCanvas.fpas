// Places unscaled terminal art inside the room pane and samples its outer haze.
unit Dungeon.Game.ArtCanvas;

uses
  Dungeon.Game.Art as Art, Dungeon.EmberArt as Ember, Fpas.Ui.Widgets.Developer.Terminal as T,
  Fpas.Ui.TerminalExtensions.CellGrids as Grids, System as Sys, System.Collections.Generic as Lists;

public function SelectImage(Images: Art.Pair; Width: int; Height: int): Art.Picture?;
begin
  if Width >= Art.Large and Height >= Art.Height(Art.Large) then
    return Images.Full ?? Images.Compact;
  end if;

  return Images.Compact ?? Images.Full;
end function;

function Offset(Available: int; Size: int; Focus: int): int;
begin
  if Available >= Size then
    return (Available - Size) div 2;
  end if;

  return -Sys.Math.Clamp(Focus - Available div 2, 0, Size - Available);
end function;

function Fog(Edge: T.Cell; X: int; Y: int; Distance: int): T.Cell;
begin
  const Reach: int := Sys.Math.Max(0, 14 - Distance);
  const Tone: int := Ember.Mix(
    Edge.Colors.Background ?? Ember.Background,
    Edge.Colors.Foreground ?? Ember.Background, 1, 3
  );
  const Grain: int := unchecked(((X * 73856093) xor (Y * 19349663)) and 15);
  const Shade: int := Ember.Mix(
    Ember.Background,
    Tone,
    Reach * Reach * (44 + Grain),
    14 * 14 * 100
  );
  return new T.Cell(' ', new T.Style(Background := Shade));
end function;

public function Render(Image: Art.Picture; Width: int; Height: int): Grids.Image;
begin
  const ArtWidth: int := Image.Source.Columns;
  const ArtHeight: int := Image.Source.Rows.Length;
  const Left: int := Offset(Width, ArtWidth, Image.Source.FocusX);
  const Top: int := Offset(Height, ArtHeight, Image.Source.FocusY);
  const Cells: Lists.List<T.Cell> := new Lists.List<T.Cell>(Width * Height);
  for Row: int := 0 to Height - 1 do
    for Column: int := 0 to Width - 1 do
      const X: int := Column - Left;
      const Y: int := Row - Top;
      const NearX: int := Sys.Math.Clamp(X, 0, ArtWidth - 1);
      const NearY: int := Sys.Math.Clamp(Y, 0, ArtHeight - 1);
      const Cell: T.Cell := Image.Cells[NearY * ArtWidth + NearX];
      const Distance: int := Sys.Math.Abs(X - NearX) + 2 * Sys.Math.Abs(Y - NearY);
      Cells.Add(
        if Distance = 0 then
          Cell
        else
          Fog(Cell, X, Y, Distance)
        end if
      );
    end for;
  end for;

  return Grids.Image.Create(Width, Height, Cells.ToArray());
end function;

end unit;
