// Owns campaign progress, passage conditions and the single-action turn rules.
unit Dungeon.Game.World;

uses Dungeon.Game.Catalog as Catalog;
uses System as Sys;
uses System.Collections.Generic as Lists;

public const Entrance: string := 'pump-room';
public const Grotto: string := 'grotto';
public const BrassKey: string := 'brass-key';
public const Brief: string := 'The shift bell under the ember forest rings after forty silent years. Three knocks answer through the grate, the middle one doubled. ' +
  'Find who rang and why. Reveal the history through things the player observes and people they meet. A keeper, a ferryman and a mechanic have different stakes in the water.';

public type Offer = record
  public Available: bool;
  public OutcomeOrHint: string;
  public AlreadyLearned: bool;
end record;

public type ActionNote = record
  public Fact: string;
  public Person: string;
end record;

public type State = record
  public AdventureId: string;
  public RoomId: string;
  public HasKey: bool;
  public GrateOpen: bool;
  public WorldBrief: string;
  public Version: int := 2;
  public Discoveries: array of string := [];
  public Lake: string := 'high';
  public Ending: string := '';

  // Keep both original room IDs, the inventory, the slot and its ACP history.
  public function Restore(): State;
  begin
    if self.Version = 1 and (self.RoomId = Entrance or self.RoomId = Grotto) then
      return new State(self.AdventureId, self.RoomId, self.HasKey, self.GrateOpen, Brief);
    end if;

    return self;
  end function;

  // Directions use only the obstruction. Local inspection can also offer the authored hint.
  public function PassageObstacle(Edge: Catalog.Route; IncludeHint: bool): string;
  begin
    if Matches(self, Edge.Condition) then
      return '';
    end if;

    if self.Ending <> '' and (Edge.Condition = 'high' or Edge.Condition = 'low') then
      return 'The gates are pinned. The lake level permanently closes this passage.';
    end if;
    const Reason: string := Edge.Obstacle ?? 'This passage is closed.';
    if IncludeHint and not Sys.String.IsNullOrEmpty(Edge.Hint) then
      return Reason + ' ' + Edge.Hint;
    end if;

    return Reason;
  end function;

  public function InspectEncounter(Entry: Catalog.Encounter): Offer?;
  begin
    if not Visible(self, Entry) then
      return null;
    end if;

    const Allowed: bool := Available(self, Entry);
    return new Offer(
      Allowed,
      if Allowed then
        Outcome(self, Entry)
      else
        Entry.Hint ?? ''
      end if,
      Entry.Effect = 'remember' and Matches(self, Entry.Target)
    );
  end function;

  public function RecordAction(Action: string; Target: string): ActionNote;
  begin
    const Entry: Catalog.Encounter? := LocalEncounter(self, Action, Target);
    if Entry = null then
      return new ActionNote('', '');
    end if;

    return new ActionNote(
      Outcome(self, Entry),
      if Action = 'talk' then
        Target
      else
        Entry.Person ?? ''
      end if
    );
  end function;
end record;

public function NewAdventure(): State;
begin
  return new State(Sys.Guid.NewGuid().ToString('N'), Entrance, false, false, Brief);
end function;

// Both navigation and narration evaluate the same campaign conditions.
public function Matches(Value: State; Condition: string?): bool;
begin
  if Sys.String.IsNullOrEmpty(Condition) then
    return true;
  end if;
  const Name: string := Condition ?? '';
  if Name.StartsWith('!', Sys.StringComparison.Ordinal) then
    return not Matches(Value, Name.Substring(1));
  end if;

  case Name of
    when 'key':
      return Value.HasKey;
    when 'grate':
      return Value.GrateOpen;
    when 'low', 'high':
      return Value.Lake = Name;
    when 'undecided':
      return Value.Ending = '';
    when 'drawdown', 'seal', 'balance':
      return Value.Ending = Name;
    else
      return Sys.Array.IndexOf of string(Value.Discoveries, Name) >= 0;
  end case;
end function;

function Visible(Value: State; Entry: Catalog.Encounter): bool;
begin
  if Entry.Effect = 'remember' and (Entry.Action = 'operate' or Entry.Action = 'tell')
    and Matches(Value, Entry.Target)
  then
    return false;
  end if;

  return Matches(Value, Entry.Visible);
end function;

function Available(Value: State; Entry: Catalog.Encounter): bool;
begin
  if not Visible(Value, Entry) then
    return false;
  end if;

  for Need: string in Entry.Needs ?? Sys.Array.Empty of string() do
    if not Matches(Value, Need) then
      return false;
    end if;
  end for;

  return true;
end function;

public function CanMove(Value: State; Target: string): bool;
begin
  for Route: Catalog.Route in Catalog.At(Value.RoomId).Routes do
    if Route.Destination = Target and Matches(Value, Route.Condition) then
      return true;
    end if;
  end for;

  return false;
end function;

public function Valid(Value: State): bool;
begin
  var Id: Sys.Guid := Sys.Guid.Empty;
  if not Sys.Guid.TryParseExact(Value.AdventureId, 'N', out Id)
    or Value.Version <> 2 or not Catalog.Contains(Value.RoomId)
    or Sys.String.IsNullOrWhiteSpace(Value.WorldBrief)
    or (Value.GrateOpen and not Value.HasKey)
    or (Value.RoomId <> Entrance and not Value.GrateOpen)
    or Value.Discoveries = null or (Value.Lake <> 'high' and Value.Lake <> 'low')
  then
    return false;
  end if;
  const Seen: Lists.HashSet of string := new Lists.HashSet of string();
  for Fact: string in Value.Discoveries do
    if not Catalog.KnownMemory(Fact) or not Seen.Add(Fact) then
      return false;
    end if;
  end for;

  case Value.Ending of
    when '':
      return true;
    when 'drawdown':
      return Value.Lake = 'low' and Matches(Value, 'pilot-bell') and Matches(Value, 'edda');
    when 'seal':
      return Value.Lake = 'high' and Matches(Value, 'evacuation-roster');
    when 'balance':
      return Value.Lake = 'high' and Matches(
        Value,
        'pilot-bell'
      ) and Matches(Value, 'edda') and Matches(Value, 'return-valve');
    else
      return false;
  end case;
end function;

function Resolve(Value: State; Entry: Catalog.Encounter): State;
begin
  case Entry.Effect ?? '' of
    when 'remember':
      if Matches(Value, Entry.Target) then
        return Value;
      end if;
      const Facts: Lists.List of string := new Lists.List of string(Value.Discoveries);
      Facts.Add(Entry.Target);
      return Value with
        Discoveries := Facts.ToArray();
      end with;
    when 'key':
      return Value with
        HasKey := true;
      end with;
    when 'grate':
      return Value with
        GrateOpen := true;
      end with;
    when 'low', 'high':
      return Value with
        Lake := Entry.Effect ?? '';
      end with;
    when 'drawdown':
      return Value with
        Lake := 'low';
        Ending := 'drawdown';
      end with;
    when 'seal', 'balance':
      return Value with
        Lake := 'high';
        Ending := Entry.Effect ?? '';
      end with;
    else
      raise new Sys.InvalidOperationException('Unknown campaign effect.');
  end case;
end function;

function Outcome(Value: State; Entry: Catalog.Encounter): string;
begin
  return Entry.ReplyFor(function(Condition: string?): bool => Matches(Value, Condition));
end function;

function LocalEncounter(Value: State; Action: string; Target: string): Catalog.Encounter?;
begin
  for Entry: Catalog.Encounter in Catalog.At(Value.RoomId).Encounters() do
    if Entry.Action = Action and Entry.Target = Target and Available(Value, Entry) then
      return Entry;
    end if;
  end for;

  return null;
end function;

// Applies only the actions offered by the current location.
public function Apply(Value: State; Action: string; Target: string): State;
begin
  if Action = 'none' and Target = '' then
    return Value;
  elsif Action = 'move' and CanMove(Value, Target) then
    return Value with
      RoomId := Target;
    end with;
  end if;

  const Entry: Catalog.Encounter? := LocalEncounter(Value, Action, Target);
  if Entry <> null then
    return Resolve(Value, Entry);
  end if;

  raise new Sys.ArgumentException(
    'That action is unavailable here. Read get_room for exits, local actions and obstacles.'
  );
end function;

end unit;
