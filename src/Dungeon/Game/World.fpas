// Owns the fixed two-room map and validates proposed changes.
unit Dungeon.Game.World;

uses System as Sys;

public const Entrance: string := 'pump-room';
public const Grotto: string := 'grotto';
public const BrassKey: string := 'brass-key';
public const Brief: string := 'A flooded ruin in the ember forest. Explore the underground pump room and the grotto. ' +
  'The player can find the brass key, open the north grate, and cross into the grotto. ' +
  'Keep descriptions short, dark, and grounded in the supplied room facts.';

// The complete mutable world for this adventure, plus its pinned brief.
public type State = record
  public AdventureId: string;
  public RoomId: string;
  public HasKey: bool;
  public GrateOpen: bool;
  public WorldBrief: string;
  public Version: int := 1;
end record;

public type Room = record
  public Id: string;
  public Description: string;
  public ExitDirection: string;
  public ExitRoomId: string;
end record;

public function NewAdventure(): State;
begin
  return new State(Sys.Guid.NewGuid().ToString('N'), Entrance, false, false, Brief);
end function;

public function KnownRoom(Id: string): bool;
begin
  return Id = Entrance or Id = Grotto;
end function;

public function Describe(Id: string): Room;
begin
  if Id = Entrance then
    return new Room(
      Entrance,
      'An old iron pump stands in a vaulted stone chamber. Water drips from its pipe. An iron grate stands in the arch to the north.',
      'north',
      Grotto
    );
  elsif Id = Grotto then
    return new Room(
      Grotto,
      'Shallow water covers the floor of a rocky grotto. Amber light glints under a stone arch. The pump room is south.',
      'south',
      Entrance
    );
  end if;

  raise new Sys.ArgumentException('Unknown room. Use a room ID from the map.');
end function;

public function Valid(Value: State): bool;
begin
  var Id: Sys.Guid := Sys.Guid.Empty;
  return Sys.Guid.TryParseExact(Value.AdventureId, 'N', out Id)
    and Value.Version = 1
    and KnownRoom(Value.RoomId)
    and not Sys.String.IsNullOrWhiteSpace(Value.WorldBrief)
    and (not Value.GrateOpen or Value.HasKey)
    and (Value.RoomId <> Grotto or Value.GrateOpen);
end function;

// Applies a single valid action. Invalid actions can be described with "none".
public function Apply(Value: State; Action: string; Target: string): State;
begin
  case Action of
    when 'none':
      if Target = '' then
        return Value;
      end if;
    when 'take_key':
      if Target = BrassKey and Value.RoomId = Entrance and not Value.HasKey then
        return Value with
          HasKey := true;
        end with;
      end if;
    when 'open_grate':
      if Target = 'north-grate' and Value.RoomId = Entrance and Value.HasKey
        and not Value.GrateOpen
      then
        return Value with
          GrateOpen := true;
        end with;
      end if;
    when 'move':
      if Value.GrateOpen and Target = Describe(Value.RoomId).ExitRoomId then
        return Value with
          RoomId := Target;
        end with;
      end if;
    else
  end case;

  raise new Sys.ArgumentException(
    'That action is unavailable in the current world. Read the room and use none to describe a blocked attempt.'
  );
end function;

end unit;
