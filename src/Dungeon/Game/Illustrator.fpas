// Draws visited rooms independently of the live narration using the selected game master.
unit Dungeon.Game.Illustrator;

uses
  Dungeon.Game.Art as Art, Dungeon.Game.ArtRequests as Draw, Dungeon.Settings as Settings, Dungeon.ErrorLog as Errors,
  Dungeon.Acp.Dialogs as Dialogs, Dungeon.Acp.Processes as Agents, Dungeon.Acp.ClientCallbacks as Callbacks,
  dotacp.client as Client, dotacp.@protocol as P, System as Sys,
  System.Threading as Threads, System.Threading.Channels as Channels, System.Threading.Tasks as Tasks;

public async function Run(
  Visits: Channels.ChannelReader<Draw.Visit>; Path: string; Choice: Settings.Choice;
  Exe: string; Directory: string; Servers: array of P.McpServer?; Active: Draw.Registry;
  Report: function(string, Art.Pair, bool): Tasks.Task; Token: Threads.CancellationToken; Log: Errors.Sink
): Tasks.Task;

  async function Paint(Room: Draw.Visit; Connection: Client.Connection): Tasks.Task<bool>;
  begin
    using const Opening: Threads.CancellationTokenSource := Threads.CancellationTokenSource.CreateLinkedTokenSource(
      Token
    );
    Opening.CancelAfter(Sys.TimeSpan.FromSeconds(30));
    discard await Agents.Initialize(Connection, Opening.Token);
    const Id: P.SessionId := await Dialogs.NewSession(
      Connection,
      Directory,
      Choice,
      Servers,
      Opening.Token
    );
    await Draw.Fill(
      Path, Room, Active,
      function(Text: string): Tasks.Task<bool> => Dialogs.Prompt(
        Connection,
        Id,
        Text,
        Token,
        Log,
        'illustration prompt'
      ),
      function(Images: Art.Pair): Tasks.Task => Report(Room.State.RoomId, Images, false), Token
    );
    return true;
  end function;
begin
  try
    while await Visits.WaitToReadAsync(Token) do
      const Room: Draw.Visit := await Visits.ReadAsync(Token);
      if not Art.Pair.Load(Path, Room.State, Room.State.RoomId).Complete() then
        try
          discard await Agents.Run<bool>(
            Choice.Agent,
            Exe,
            Directory,
            Callbacks.SettingsOnly(),
            function(Connection: Client.Connection): Tasks.Task<bool> => Paint(Room, Connection),
            Token, Log
          );
        catch Failure: Sys.Exception do
          Token.ThrowIfCancellationRequested();
          Log.Failure('illustration', Failure);
          // The room remains playable. A later visit can retry any missing size.
        end try;
      end if;

      Token.ThrowIfCancellationRequested();
      const Images: Art.Pair := Art.Pair.Load(Path, Room.State, Room.State.RoomId);
      if not Images.Complete() then
        Log.Write('illustration finished with missing room art');
      end if;

      await Report(Room.State.RoomId, Images, true);
    end while;
  catch Failure: Sys.OperationCanceledException when Token.IsCancellationRequested do
  end try;
end function;

end unit;
