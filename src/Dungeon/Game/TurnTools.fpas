// Gives the game master a read-only snapshot and one validated proposal per turn.
unit Dungeon.Game.TurnTools;

uses
  Dungeon.Game.Catalog as Catalog, Dungeon.Game.Journal as Journal, Dungeon.Game.Navigation as Navigation, Dungeon.Game.World as World, Dungeon.Game.RoomView as Rooms, Dungeon.Game.Saves as Saves, Dungeon.Game.Art as Art, Dungeon.Game.ArtRequests as Draw,
  Dungeon.ErrorLog as Errors,
  ModelContextProtocol as Mcp, ModelContextProtocol.Server as Server, ModelContextProtocol.Protocol as Protocol,
  System as Sys, System.Collections.Concurrent as Concurrent, System.Collections.Generic as Lists,
  System.Text.Json as Json, System.Text.Json.Nodes as Nodes, System.Text.Json.Serialization.Metadata as Metadata;

public type Proposal = record
  public Reply: string;
  public Action: string;
  public Target: string;
  public WorldState: World.State;
end record;

public type Context = record
  public SavePath: string;
  public WorldState: World.State;
  public History: array of Saves.Turn;
  public Opening: bool;
  public Submission: Concurrent.ConcurrentDictionary<string, Proposal?>;
end record;

function Find(Active: Concurrent.ConcurrentDictionary<string, Context?>; TurnId: string): Context;
begin
  var Found: Context? := null;
  discard Active.TryGetValue(TurnId, out Found);
  if Found = null then
    raise new Mcp.McpException('Use the active turnId supplied by the game.');
  end if;

  return Found;
end function;

public function GetRoom(Value: Context; RoomId: string): Rooms.Scene;
begin
  const State: World.State := Value.WorldState;
  if RoomId <> State.RoomId and not World.CanMove(State, RoomId) then
    raise new Mcp.McpException('Read the current room or an open exit from it.');
  end if;

  return Rooms.Describe(State, RoomId);
end function;

function GetHistory(Value: Context; RoomId: string; Limit: int): array of Saves.Turn;
begin
  if (RoomId <> '' and not Catalog.Contains(RoomId)) or Limit < 1 or Limit > 20 then
    raise new Mcp.McpException(
      'Choose a known roomId or an empty roomId, and a limit from 1 to 20.'
    );
  end if;
  const Recent: Lists.List<Saves.Turn> := new Lists.List<Saves.Turn>();
  var Index: int := Value.History.Length - 1;
  while Index >= 0 and Recent.Count < Limit do
    const Entry: Saves.Turn := Value.History[Index];
    if RoomId = '' or RoomId = Entry.RoomId then
      Recent.Add(Entry);
    end if;

    Index := Index - 1;
  end while;

  Recent.Reverse();
  return Recent.ToArray();
end function;

function Search(Value: Context; Query: string; Person: string; RoomId: string; BeforeTurn: int; Limit: int): Journal.Page;
begin
  try
    return Journal.Search(Value.History, Query, Person, RoomId, BeforeTurn, Limit);
  catch Failure: Sys.ArgumentException do
    raise new Mcp.McpException(Failure.Message);
  end try;
end function;

function Route(Value: Context; Destination: string): Navigation.Directions;
begin
  return Navigation.Find(Value.WorldState, Value.History, Destination);
end function;

function Submit(Value: Context; Action: string; Target: string; Reply: string): string;
begin
  const Narration: string := Reply.Trim();
  if Narration = '' or Narration.Length > 800 then
    raise new Mcp.McpException('Supply 1 to 800 characters of player-facing narration.');
  end if;

  if Value.Opening and Action <> 'none' then
    raise new Mcp.McpException('The opening scene uses action none and an empty target.');
  end if;
  var Changed: World.State := Value.WorldState;
  try
    Changed := World.Apply(Value.WorldState, Action, Target);
  catch Failure: Sys.ArgumentException do
    raise new Mcp.McpException(Failure.Message);
  end try;
  const Result: Proposal := new Proposal(Narration, Action, Target, Changed);
  if not Value.Submission.TryAdd('turn', Result) then
    const Previous: Proposal? := Value.Submission['turn'];
    if Previous = null or Previous.Action <> Action or Previous.Target <> Target
      or Previous.Reply <>
      Narration
    then
      raise new Mcp.McpException('This turn already has a proposal.');
    end if;
  end if;

  return 'Staged for this turn. End the prompt now.';
end function;

function ParameterDescription(ToolName: string; ParameterName: string): string;
begin
  case ParameterName of
    when 'turnId':
      return 'Active turnId supplied in the current turn prompt.';
    when 'requestId':
      return 'Active requestId supplied in the current illustration prompt.';
    when 'roomId':
      return case ToolName of
        when 'get_room': 'Current room ID or an open exit roomId from currentScene.exits.';
        else 'Exact room ID to filter by, or an empty string for all rooms.';
      end case;
    when 'query':
      return 'Case-insensitive substring matched against replies, facts, commands, targets, rooms, and speakers. Use an empty string for no text filter.';
    when 'person':
      return 'Exact internal speaker ID such as mara, iven, edda, or ada (case-insensitive). Use an empty string for no person filter.';
    when 'beforeTurn':
      return 'Return turns strictly before this 1-based turn number. Pass 0 for the first page, then pass nextBeforeTurn until 0.';
    when 'limit':
      return 'Maximum number of entries to return, from 1 to 20.';
    when 'destination':
      return 'Exact visited room ID, exact English or German room name, or exact speaker ID of a previously met person (such as mara or iven).';
    when 'action':
      return 'Action to commit: none, move, or an exact action from currentScene.interactions where available is true.';
    when 'target':
      return 'Empty string for none, an open exit roomId for move, or the exact target from currentScene.interactions where available is true.';
    when 'reply':
      return 'Player-facing narration in the player language: 1 to 800 characters of plain text with no Markdown and no internal IDs.';
    when 'drawing':
      return 'Drawing with columns (50 or 65), zero-based focusX/focusY, palette (1 to 36 single-cell tiles using allowed #RRGGBB colors), and rows (exact height count of palette-index strings).';
    else
      return '';
  end case;
end function;

function AnnotateParameters(Name: string; Schema: Json.JsonElement): Json.JsonElement;
begin
  const Root: Nodes.JsonNode? := Nodes.JsonNode.Parse(Schema.GetRawText());
  if Root <> null and Root is Nodes.JsonObject then
    const Document: Nodes.JsonObject := cast<Nodes.JsonObject>(Root);
    const PropertiesNode: Nodes.JsonNode? := Document['properties'];
    if PropertiesNode <> null and PropertiesNode is Nodes.JsonObject then
      const Properties: Nodes.JsonObject := cast<Nodes.JsonObject>(PropertiesNode);
      for Key: string in [
        'turnId', 'requestId', 'roomId', 'query', 'person', 'beforeTurn', 'limit', 'destination',
        'action', 'target', 'reply', 'drawing'
      ] do
        const Entry: Nodes.JsonNode? := Properties[Key];
        const Text: string := ParameterDescription(Name, Key);
        if Text <> '' and Entry <> null and Entry is Nodes.JsonObject then
          cast<Nodes.JsonObject>(Entry)['description'] := Nodes.JsonValue.Create<string>(Text);
        end if;
      end for;
    end if;

    return Json.JsonSerializer.SerializeToElement<Nodes.JsonNode>(Document);
  end if;

  return Schema;
end function;

function Tool(Called: Sys.Delegate; Name: string; Description: string; ReadOnly: bool): Server.McpServerTool;
begin
  const Options: Server.McpServerToolCreateOptions := new Server.McpServerToolCreateOptions();
  Options.Name := Name;
  Options.Description := Description;
  Options.ReadOnly := ReadOnly;
  Options.Destructive := false;
  Options.Idempotent := true;
  Options.OpenWorld := false;
  const Serializer: Json.JsonSerializerOptions := new Json.JsonSerializerOptions();
  Serializer.RespectRequiredConstructorParameters := true;
  Serializer.TypeInfoResolver := new Metadata.DefaultJsonTypeInfoResolver();
  Serializer.PropertyNamingPolicy := Json.JsonNamingPolicy.CamelCase;
  Options.SerializerOptions := Serializer;
  const Created: Server.McpServerTool := Server.McpServerTool.Create(Called, Options);
  Created.ProtocolTool.InputSchema := AnnotateParameters(Name, Created.ProtocolTool.InputSchema);
  return Created;
end function;

function ServerOptions(Tools: Server.McpServerPrimitiveCollection<Server.McpServerTool>): Server.McpServerOptions;
begin
  const Identity: Protocol.Implementation := new Protocol.Implementation();
  Identity.Name := 'into-the-dungeon';
  Identity.Version := '0.1.0';
  const Options: Server.McpServerOptions := new Server.McpServerOptions();
  Options.ServerInfo := Identity;
  Options.ToolCollection := Tools;
  return Options;
end function;

// Registers only the gameplay tools for the game master session.
public function Register(Active: Concurrent.ConcurrentDictionary<string, Context?>; Log: Errors.Sink? := null): Server.McpServerOptions;
begin
  const ReadRoom: Sys.Func<string, string, Rooms.Scene> := function(turnId: string; roomId: string): Rooms.Scene => GetRoom(
    Find(Active, turnId),
    roomId
  );
  const ReadJournal: Sys.Func<string, Journal.Page> := function(turnId: string): Journal.Page => Journal.Search(
    Find(Active, turnId).History,
    '',
    '',
    '',
    0,
    20,
    true
  );
  const SearchMemories: Sys.Func<string, string, string, string, int, int, Journal.Page> := function(turnId: string; query: string; person: string; roomId: string; beforeTurn: int; limit: int): Journal.Page => Search(
    Find(Active, turnId),
    query,
    person,
    roomId,
    beforeTurn,
    limit
  );
  const FindRoute: Sys.Func<string, string, Navigation.Directions> := function(turnId: string; destination: string): Navigation.Directions => Route(
    Find(Active, turnId),
    destination
  );
  const ReadHistory: Sys.Func<string, string, int, array of Saves.Turn> := function(turnId: string; roomId: string; limit: int): array of Saves.Turn => GetHistory(
    Find(Active, turnId),
    roomId,
    limit
  );
  const SubmitTurn: Sys.Func<string, string, string, string, string> := function(turnId: string; action: string; target: string; reply: string): string begin
    try
      return Submit(Find(Active, turnId), action, target, reply);
    catch Failure: Mcp.McpException do
      if Log <> null then
        Log.Write('MCP submit_turn rejected');
      end if;

      raise;
    end try;
  end function;
  const Tools: Server.McpServerPrimitiveCollection<Server.McpServerTool> := new Server.McpServerPrimitiveCollection<Server.McpServerTool>();
  Tools.Add(
    Tool(
      ReadRoom,
      'get_room',
      'Read the current room or an open exit destination before describing arrival, including description, details, exits, obstacles, and local interactions.',
      true
    )
  );
  Tools.Add(
    Tool(
      ReadJournal,
      'get_journal',
      'Read the latest 20 committed encounters (no pagination), including original replies, facts, speakers, places, and turn numbers. Use search_memories for older encounters.',
      true
    )
  );
  Tools.Add(
    Tool(
      SearchMemories,
      'search_memories',
      'Search all completed turns newest first. Pass empty strings to omit query, person, or roomId filters. Use exact internal speaker IDs for person (e.g. mara, iven). Start with beforeTurn 0 and paginate with nextBeforeTurn until 0.',
      true
    )
  );
  Tools.Add(
    Tool(
      FindRoute,
      'find_route',
      'Find directions over previously crossed passages to an exact visited room ID, exact English or German room name, or exact speaker ID of a previously met person. Returns status here, route, blocked (stopping at the first obstacle), unknown, or unmapped.',
      true
    )
  );
  Tools.Add(
    Tool(
      ReadHistory,
      'get_history',
      'Read up to 20 recent completed turns in chronological order. Use an empty roomId for turns across all rooms.',
      true
    )
  );
  Tools.Add(
    Tool(
      SubmitTurn, 'submit_turn',
      'Stage the single player-visible narration (1 to 800 plain-text characters, no Markdown or internal IDs) and one validated action (available local interaction, move to an open exit roomId, or none with empty target). Only reply is shown to the player.',
      false
    )
  );
  return ServerOptions(Tools);
end function;

// Registers only the illustration submission tool for the background room artist.
public function RegisterArt(ArtPrompts: Draw.Registry; Log: Errors.Sink? := null): Server.McpServerOptions;
begin
  const SubmitArt: Sys.Func<string, Art.Drawing, string> := function(requestId: string; drawing: Art.Drawing): string begin
    try
      return Draw.Submit(ArtPrompts, requestId, drawing);
    catch Failure: Mcp.McpException do
      if Log <> null then
        Log.Write('MCP submit_room_art rejected');
      end if;

      raise;
    end try;
  end function;
  const Tools: Server.McpServerPrimitiveCollection<Server.McpServerTool> := new Server.McpServerPrimitiveCollection<Server.McpServerTool>();
  Tools.Add(
    Tool(
      SubmitArt,
      'submit_room_art',
      'Submit a validated room drawing (columns 50 or 65, 1 to 36 single-cell Unicode tiles using allowed #RRGGBB district colors, exact row count, and zero-based focus) for the active illustration requestId.',
      false
    )
  );
  return ServerOptions(Tools);
end function;

end unit;
