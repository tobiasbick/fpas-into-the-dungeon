// Gives the game master a read-only snapshot and one validated proposal per turn.
unit Dungeon.Game.TurnTools;

uses
  Dungeon.Game.World as World, Dungeon.Game.Saves as Saves, Dungeon.Game.Art as Art,
  ModelContextProtocol as Mcp, ModelContextProtocol.Server as Server, ModelContextProtocol.Protocol as Protocol,
  System as Sys, System.Collections.Concurrent as Concurrent, System.Collections.Generic as Lists,
  System.Text.Json as Json, System.Text.Json.Serialization.Metadata as Metadata;

public type Proposal = record
  public Reply: string;
  public Action: string;
  public Target: string;
  public WorldState: World.State;
end record;

public type Context = record
  public SavePath: string;
  public WorldState: World.State;
  public History: array of Saves.Turn;
  public Opening: bool;
  public Submission: Concurrent.ConcurrentDictionary<string, Proposal?>;
end record;

type RoomView = record
  public Room: World.Room;
  public CurrentRoom: string;
  public Inventory: array of string;
  public ItemsHere: array of string;
  public GrateOpen: bool;
  public ImageReady: bool;
end record;

function Find(Active: Concurrent.ConcurrentDictionary<string, Context?>; TurnId: string): Context;
begin
  var Found: Context? := null;
  discard Active.TryGetValue(TurnId, out Found);
  if Found = null then
    raise new Mcp.McpException('Use the active turnId supplied by the game.');
  end if;

  return Found;
end function;

function GetRoom(Value: Context; RoomId: string): RoomView;
begin
  const State: World.State := Value.WorldState;
  if not World.KnownRoom(RoomId) then
    raise new Mcp.McpException('Unknown roomId. Use pump-room or grotto.');
  end if;

  return new RoomView(
    World.Describe(RoomId), State.RoomId,
    if State.HasKey then
      [World.BrassKey]
    else
      []
    end if,
    if RoomId = World.Entrance and not State.HasKey then
      [World.BrassKey]
    else
      []
    end if,
    State.GrateOpen, Art.Exists(Value.SavePath, State, RoomId)
  );
end function;

function GetHistory(Value: Context; RoomId: string; Limit: int): array of Saves.Turn;
begin
  if (RoomId <> '' and not World.KnownRoom(RoomId)) or Limit < 1 or Limit > 20 then
    raise new Mcp.McpException(
      'Choose a known roomId or an empty roomId, and a limit from 1 to 20.'
    );
  end if;
  const Recent: Lists.List<Saves.Turn> := new Lists.List<Saves.Turn>();
  var Index: int := Value.History.Length - 1;
  while Index >= 0 and Recent.Count < Limit do
    const Entry: Saves.Turn := Value.History[Index];
    if RoomId = '' or RoomId = Entry.RoomId then
      Recent.Add(Entry);
    end if;

    Index := Index - 1;
  end while;

  Recent.Reverse();
  return Recent.ToArray();
end function;

function Submit(Value: Context; Action: string; Target: string; Reply: string): string;
begin
  const Narration: string := Reply.Trim();
  if Narration = '' or Narration.Length > 800 then
    raise new Mcp.McpException('Supply 1 to 800 characters of player-facing narration.');
  end if;

  if Value.Opening and Action <> 'none' then
    raise new Mcp.McpException('The opening scene uses action none and an empty target.');
  end if;
  var Changed: World.State := Value.WorldState;
  try
    Changed := World.Apply(Value.WorldState, Action, Target);
  catch Failure: Sys.ArgumentException do
    raise new Mcp.McpException(Failure.Message);
  end try;
  const Result: Proposal := new Proposal(Narration, Action, Target, Changed);
  if not Value.Submission.TryAdd('turn', Result) and not Result.Equals(
    Value.Submission['turn']
  )
  then
    raise new Mcp.McpException('This turn already has a proposal.');
  end if;

  return 'Staged for this turn. End the prompt now.';
end function;

function Tool(Called: Sys.Delegate; Name: string; Description: string; ReadOnly: bool): Server.McpServerTool;
begin
  const Options: Server.McpServerToolCreateOptions := new Server.McpServerToolCreateOptions();
  Options.Name := Name;
  Options.Description := Description;
  Options.ReadOnly := ReadOnly;
  Options.Destructive := false;
  Options.Idempotent := true;
  Options.OpenWorld := false;
  const Serializer: Json.JsonSerializerOptions := new Json.JsonSerializerOptions();
  Serializer.TypeInfoResolver := new Metadata.DefaultJsonTypeInfoResolver();
  Serializer.PropertyNamingPolicy := Json.JsonNamingPolicy.CamelCase;
  Options.SerializerOptions := Serializer;
  return Server.McpServerTool.Create(Called, Options);
end function;

// Registers the tools on the official MCP SDK server.
public function Register(Active: Concurrent.ConcurrentDictionary<string, Context?>): Server.McpServerOptions;
begin
  const ReadRoom: Sys.Func<string, string, RoomView> := function(turnId: string; roomId: string): RoomView => GetRoom(
    Find(Active, turnId),
    roomId
  );
  const ReadHistory: Sys.Func<string, string, int, array of Saves.Turn> := function(turnId: string; roomId: string; limit: int): array of Saves.Turn => GetHistory(
    Find(Active, turnId),
    roomId,
    limit
  );
  const SubmitTurn: Sys.Func<string, string, string, string, string> := function(turnId: string; action: string; target: string; reply: string): string => Submit(
    Find(Active, turnId),
    action,
    target,
    reply
  );
  const Tools: Server.McpServerPrimitiveCollection<Server.McpServerTool> := new Server.McpServerPrimitiveCollection<Server.McpServerTool>();
  Tools.Add(
    Tool(
      ReadRoom,
      'get_room',
      'Read a room by ID, its exit, key and grate state, and whether its saved art exists.',
      true
    )
  );
  Tools.Add(
    Tool(
      ReadHistory,
      'get_history',
      'Read up to 20 completed turns. Use an empty roomId to retrieve turns across rooms.',
      true
    )
  );
  Tools.Add(
    Tool(
      SubmitTurn, 'submit_turn',
      'Stage one turn with narration and one action. Use none with an empty target, take_key with brass-key, ' +
      'open_grate with north-grate, or move with a neighboring room ID. End the prompt after acceptance.',
      false
    )
  );
  const Identity: Protocol.Implementation := new Protocol.Implementation();
  Identity.Name := 'into-the-dungeon';
  Identity.Version := '0.1.0';
  const Options: Server.McpServerOptions := new Server.McpServerOptions();
  Options.ServerInfo := Identity;
  Options.ToolCollection := Tools;
  return Options;
end function;

end unit;
