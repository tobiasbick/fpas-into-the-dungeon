<Project Sdk="Fpas.NET.Sdk/0.1.0-dev">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Dungeon</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Dungeon.Settings/Dungeon.Settings.fpasproj" />
    <PackageReference Include="dotacp.client" Version="2026.7.19" />
    <PackageReference Include="StreamJsonRpc" Version="2.26.150" />
    <PackageReference Include="Fpas.Ui.Tui" Version="0.1.0-dev" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.4.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <EmbeddedResource Include="Start/Artwork/EmberForest-78x46.rgb" LogicalName="Dungeon.EmberForest.Full" />
    <EmbeddedResource Include="Start/Artwork/EmberForest-58x32.rgb" LogicalName="Dungeon.EmberForest.Compact" />
    <EmbeddedResource Include="Game/Artwork/*.png" LogicalName="Dungeon.Rooms.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
