// Resolves UI strings using the current culture and the neutral English catalog.
unit Dungeon.Resources.Strings;

uses System.Reflection as Reflection, System.Resources as Resources;

const Catalog: Resources.ResourceManager := new Resources.ResourceManager(
  'Dungeon.Resources.Strings', Reflection.Assembly.GetExecutingAssembly()
);

// Reads the localized text for a nonempty resource key.
public function Get(Key: string): string;
requires Key <> '';
begin
  return Catalog.GetString(Key) ?? Key;
end function;

end unit;
