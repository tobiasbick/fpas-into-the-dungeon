// Defines the two start menus and handles keyboard selection and activation.
unit Dungeon.StartMenu;

uses Fpas.Ui.Mvu.Application as Mvu, System as Sys;

// Save availability and the current selection in the corresponding menu.
public type Model = record
  // Selects the menu with continue and restart actions.
  public HasSave: bool;
  // Zero-based index of the selected action.
  public Selected: int := 0;
end record;

// Input that can affect the start menu.
public type Message = variant
  // Shifts the selection by one entry, wrapping at the ends.
  Move(Delta: int);
  // Activates the current entry.
  Activate;
  // Selects and activates the clicked entry.
  Click(Index: int);
  // Leaves the menu unchanged.
  Ignore;
end variant;

// Returns resource keys in navigation order. The final entry exits the application.
public function EntryKeys(HasSave: bool): array of string;
begin
  return if HasSave then
    ['Menu.Continue', 'Menu.Restart', 'Menu.Settings', 'Menu.Exit']
  else
    ['Menu.Start', 'Menu.Settings', 'Menu.Exit']
  end if;
end function;

// Updates the selection and emits a host exit for the last entry.
public function Update(State: Model; Input: Message): Mvu.Transition<Model, Message>;
begin
  const Count: int := EntryKeys(State.HasSave).Length;
  var Selected: int := State.Selected;
  var Activate: bool := false;

  case Input of
    when Message.Move(const Delta: int):
      Selected := (Selected + Delta + Count) mod Count;
    when Message.Click(const Index: int):
      Selected := Sys.Math.Clamp(Index, 0, Count - 1);
      Activate := true;
    when Message.Activate:
      Activate := true;
    when Message.Ignore:
      return new Mvu.Transition<Model, Message>(State, []);
  end case;

  const Next: Model := State with
    Selected := Selected;
  end with;

  if Activate and Selected = Count - 1 then
    return new Mvu.Transition<Model, Message>(Next, [Mvu.Exit<Message>()]);
  end if;

  return new Mvu.Transition<Model, Message>(Next, []);
end function;

end unit;
