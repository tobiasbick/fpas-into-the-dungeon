// Provides the console game's entry point.
program Dungeon;

uses Fpas.Ui.Tui.Host as Tui;

uses Dungeon.App as App;
uses Dungeon.ErrorLog as Errors;
uses Dungeon.Mcp.Transport as Mcp;
uses Dungeon.Settings as Settings;
uses System as Sys;

begin
  if not Mcp.RunIfRequested(Sys.Environment.GetCommandLineArgs()) then
    const Path: string := Settings.DefaultPath();
    try
      Tui.Run of (App.Model, App.Message)(App.Open(Path), App.Update, App.View, App.Theme);
    catch Failure: Sys.Exception do
      const Log: Errors.Sink := new Errors.Sink(Path, 'startup', 'game');
      Log.Failure('terminal application', Failure);
      raise;
    end try;
  end if;
end;

end program;
