// Provides the console game's entry point.
program Dungeon;

uses
  Dungeon.App as App, Dungeon.Settings as Settings, Dungeon.Mcp.Transport as Mcp,
  Fpas.Ui.Tui.Application as Tui, System as Sys;

begin
  if not Mcp.RunIfRequested(Sys.Environment.GetCommandLineArgs()) then
    Tui.Run<App.Model, App.Message>(
      App.Open(Settings.DefaultPath()), App.Update, App.View, App.Theme
    );
  end if;
end;

end program;
