// Provides the console game's entry point.
program Dungeon;

uses
  Dungeon.App as App, Dungeon.Settings as Settings, Dungeon.Mcp.Transport as Mcp, Dungeon.ErrorLog as Errors,
  Fpas.Ui.Tui.Application as Tui, System as Sys;

begin
  if not Mcp.RunIfRequested(Sys.Environment.GetCommandLineArgs()) then
    const Path: string := Settings.DefaultPath();
    try
      Tui.Run<App.Model, App.Message>(App.Open(Path), App.Update, App.View, App.Theme);
    catch Failure: Sys.Exception do
      const Log: Errors.Sink := new Errors.Sink(Path, 'startup', 'game');
      Log.Failure('terminal application', Failure);
      raise;
    end try;
  end if;
end;

end program;
