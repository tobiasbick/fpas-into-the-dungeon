// Provides the console game's entry point.
program Dungeon;

uses
  Dungeon.StartMenu as Menu, Dungeon.StartScreen as Screen,
  Fpas.Ui.Tui.Application as Tui;

begin
  Tui.Run<Menu.Model, Menu.Message>(
    new Menu.Model(HasSave := true), Menu.Update, Screen.View, Screen.Theme()
  );
end;

end program;
