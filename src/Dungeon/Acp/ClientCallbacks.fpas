// Handles ACP callbacks without offering access to host tools.
unit Dungeon.Acp.ClientCallbacks;

uses System as Sys;
uses System.Threading as Threads;
uses System.Threading.Tasks as Tasks;
uses dotacp.client as Client;
uses dotacp.@protocol as P;

function Unsupported of T(): Tasks.Task of T;
begin
  return Tasks.Task.FromException of T(
    new Sys.NotSupportedException('This client does not provide ACP host tools.')
  );
end function;

// Implements the SDK callbacks without exposing files, terminals, or permissions.
public type Callbacks = record implements Client.IAcpClient
  public OnUpdate: procedure(P.SessionNotification);
  public OnClose: procedure();

  // Notifies the owner when the agent disconnects.
  public procedure OnDisconnected(Connection: Client.Connection);
  begin
    self.OnClose();
  end procedure;

  // Rejects filesystem reads.
  public function ReadTextFileAsync(
    Request: P.ReadTextFileRequest;
    Token: Threads.CancellationToken
  ): Tasks.Task of P.ReadTextFileResponse;
  begin
    return Unsupported of P.ReadTextFileResponse();
  end function;

  // Rejects filesystem writes.
  public function WriteTextFileAsync(
    Request: P.WriteTextFileRequest;
    Token: Threads.CancellationToken
  ): Tasks.Task of P.WriteTextFileResponse;
  begin
    return Unsupported of P.WriteTextFileResponse();
  end function;

  // Cancels any permission request.
  public function RequestPermissionAsync(
    Request: P.RequestPermissionRequest;
    Token: Threads.CancellationToken
  ): Tasks.Task of P.RequestPermissionResponse;
  begin
    const Result: P.RequestPermissionResponse := new P.RequestPermissionResponse();
    Result.Outcome := new P.RequestPermissionOutcomeCancelled();
    return Tasks.Task.FromResult of P.RequestPermissionResponse(Result);
  end function;

  // Forwards the game session updates when a listener is attached.
  public function SessionUpdateAsync(
    Notification: P.SessionNotification;
    Token: Threads.CancellationToken
  ): Tasks.Task;
  begin
    self.OnUpdate(Notification);
    return Tasks.Task.CompletedTask;
  end function;

  // Rejects terminal creation.
  public function CreateTerminalAsync(
    Request: P.CreateTerminalRequest;
    Token: Threads.CancellationToken
  ): Tasks.Task of P.CreateTerminalResponse;
  begin
    return Unsupported of P.CreateTerminalResponse();
  end function;

  // Rejects terminal kill requests.
  public function KillTerminalAsync(
    Request: P.KillTerminalRequest;
    Token: Threads.CancellationToken
  ): Tasks.Task of P.KillTerminalResponse;
  begin
    return Unsupported of P.KillTerminalResponse();
  end function;

  // Rejects terminal output requests.
  public function TerminalOutputAsync(
    Request: P.TerminalOutputRequest;
    Token: Threads.CancellationToken
  ): Tasks.Task of P.TerminalOutputResponse;
  begin
    return Unsupported of P.TerminalOutputResponse();
  end function;

  // Rejects terminal release requests.
  public function ReleaseTerminalAsync(
    Request: P.ReleaseTerminalRequest;
    Token: Threads.CancellationToken
  ): Tasks.Task of P.ReleaseTerminalResponse;
  begin
    return Unsupported of P.ReleaseTerminalResponse();
  end function;

  // Rejects terminal wait requests.
  public function WaitForTerminalExitAsync(
    Request: P.WaitForTerminalExitRequest;
    Token: Threads.CancellationToken
  ): Tasks.Task of P.WaitForTerminalExitResponse;
  begin
    return Unsupported of P.WaitForTerminalExitResponse();
  end function;

  // Rejects agent-specific calls.
  public function ExtMethodAsync(
    Method: string;
    Request: object;
    Token: Threads.CancellationToken
  ): Tasks.Task of object;
  begin
    return Unsupported of object();
  end function;

  // Discards notifications outside the session configuration response.
  public function ExtNotificationAsync(
    Method: string;
    Notification: object;
    Token: Threads.CancellationToken
  ): Tasks.Task;
  begin
    return Tasks.Task.CompletedTask;
  end function;
end record;

// Keeps settings discovery independent of gameplay notifications.
public function SettingsOnly(): Callbacks;
begin
  return new Callbacks(
    procedure(Notification: P.SessionNotification) begin end procedure,
    procedure() begin end procedure
  );
end function;

end unit;
