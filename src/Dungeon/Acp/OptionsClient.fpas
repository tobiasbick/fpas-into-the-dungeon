// Denies agent-side actions during settings discovery.
unit Dungeon.Acp.OptionsClients;

uses
  dotacp.client as Client, dotacp.@protocol as P, System as Sys,
  System.Threading as Threads, System.Threading.Tasks as Tasks;

function Unsupported<T>(): Tasks.Task<T>;
begin
  return Tasks.Task.FromException<T>(
    new Sys.NotSupportedException('Only ACP settings discovery is available.')
  );
end function;

// Implements the SDK callbacks without exposing files, terminals, or permissions.
public type OptionsClient = record implements Client.IAcpClient
  // No connection state is held by this callback.
  public procedure OnDisconnected(Connection: Client.Connection);
  begin
  end procedure;

  // Rejects filesystem reads.
  public function ReadTextFileAsync(Request: P.ReadTextFileRequest; Token: Threads.CancellationToken): Tasks.Task<P.ReadTextFileResponse>;
  begin
    return Unsupported<P.ReadTextFileResponse>();
  end function;

  // Rejects filesystem writes.
  public function WriteTextFileAsync(Request: P.WriteTextFileRequest; Token: Threads.CancellationToken): Tasks.Task<P.WriteTextFileResponse>;
  begin
    return Unsupported<P.WriteTextFileResponse>();
  end function;

  // Cancels any permission request.
  public function RequestPermissionAsync(Request: P.RequestPermissionRequest; Token: Threads.CancellationToken): Tasks.Task<P.RequestPermissionResponse>;
  begin
    const Result: P.RequestPermissionResponse := new P.RequestPermissionResponse();
    Result.Outcome := new P.RequestPermissionOutcomeCancelled();
    return Tasks.Task.FromResult<P.RequestPermissionResponse>(Result);
  end function;

  // Settings discovery uses the options in the session responses.
  public function SessionUpdateAsync(Notification: P.SessionNotification; Token: Threads.CancellationToken): Tasks.Task;
  begin
    return Tasks.Task.CompletedTask;
  end function;

  // Rejects terminal creation.
  public function CreateTerminalAsync(Request: P.CreateTerminalRequest; Token: Threads.CancellationToken): Tasks.Task<P.CreateTerminalResponse>;
  begin
    return Unsupported<P.CreateTerminalResponse>();
  end function;

  // Rejects terminal kill requests.
  public function KillTerminalAsync(Request: P.KillTerminalRequest; Token: Threads.CancellationToken): Tasks.Task<P.KillTerminalResponse>;
  begin
    return Unsupported<P.KillTerminalResponse>();
  end function;

  // Rejects terminal output requests.
  public function TerminalOutputAsync(Request: P.TerminalOutputRequest; Token: Threads.CancellationToken): Tasks.Task<P.TerminalOutputResponse>;
  begin
    return Unsupported<P.TerminalOutputResponse>();
  end function;

  // Rejects terminal release requests.
  public function ReleaseTerminalAsync(Request: P.ReleaseTerminalRequest; Token: Threads.CancellationToken): Tasks.Task<P.ReleaseTerminalResponse>;
  begin
    return Unsupported<P.ReleaseTerminalResponse>();
  end function;

  // Rejects terminal wait requests.
  public function WaitForTerminalExitAsync(Request: P.WaitForTerminalExitRequest; Token: Threads.CancellationToken): Tasks.Task<P.WaitForTerminalExitResponse>;
  begin
    return Unsupported<P.WaitForTerminalExitResponse>();
  end function;

  // Rejects agent-specific calls.
  public function ExtMethodAsync(Method: string; Request: object; Token: Threads.CancellationToken): Tasks.Task<object>;
  begin
    return Unsupported<object>();
  end function;

  // Discards notifications outside the session configuration response.
  public function ExtNotificationAsync(Method: string; Notification: object; Token: Threads.CancellationToken): Tasks.Task;
  begin
    return Tasks.Task.CompletedTask;
  end function;
end record;

end unit;
