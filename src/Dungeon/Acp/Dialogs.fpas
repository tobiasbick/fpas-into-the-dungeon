// Starts configured ACP conversations and bounds individual prompts.
unit Dungeon.Acp.Dialogs;

uses Dungeon.Acp.Discovery as Acp;
uses Dungeon.ErrorLog as Errors;
uses Dungeon.Settings as Settings;
uses System as Sys;
uses System.Threading as Threads;
uses System.Threading.Tasks as Tasks;
uses dotacp.client as Client;
uses dotacp.@protocol as P;

public async function Prompt(
  Connection: Client.Connection;
  Id: P.SessionId;
  Text: string;
  Token: Threads.CancellationToken;
  Log: Errors.Sink? := null;
  Phase: string := 'prompt'
): Tasks.Task of bool;
begin
  const Content: P.TextContent := new P.TextContent();
  Content.Text := Text;
  const Request: P.PromptRequest := new P.PromptRequest();
  Request.SessionId := Id;
  Request.Prompt := [Content];
  using const Deadline: Threads.CancellationTokenSource := Threads.CancellationTokenSource.CreateLinkedTokenSource(
    Token
  );
  Deadline.CancelAfter(Sys.TimeSpan.FromMinutes(3));
  try
    const Result: P.PromptResponse := await Connection.PromptAsync(Request, Deadline.Token);
    if Log <> null and Result.StopReason <> P.StopReason.EndTurn
      and not Token.IsCancellationRequested
    then
      Log.Write(Phase + ': ACP stopped with ' + Result.StopReason.ToString());
    end if;

    return Result.StopReason = P.StopReason.EndTurn;
  finally
    if Deadline.IsCancellationRequested then
      const Cancel: P.CancelNotification := new P.CancelNotification();
      Cancel.SessionId := Id;
      try
        using const CancelDeadline: Threads.CancellationTokenSource := new Threads.CancellationTokenSource(
          750
        );
        await Connection.CancelAsync(Cancel, CancelDeadline.Token).WaitAsync(CancelDeadline.Token);
      catch Failure: Sys.Exception do
        // Connection disposal closes the transport if the agent no longer responds.
      end try;
    end if;
  end try;
end function;

public async function NewSession(
  Connection: Client.Connection;
  Directory: string;
  Choice: Settings.Choice;
  Servers: array of P.McpServer?;
  Token: Threads.CancellationToken
): Tasks.Task of P.SessionId;
begin
  const Request: P.NewSessionRequest := new P.NewSessionRequest();
  Request.Cwd := Directory;
  Request.McpServers := Servers;
  const Started: P.NewSessionResponse := await Connection.NewSessionAsync(Request, Token);
  discard await Acp.Configure(
    Connection,
    Started.SessionId,
    Started.ConfigOptions,
    Choice,
    true,
    Token
  );
  return Started.SessionId;
end function;

end unit;
