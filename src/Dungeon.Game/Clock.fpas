// Derives time of day and weather from one bounded in-game clock.
unit Dungeon.Game.Clock;

uses Dungeon.Game.Terrain as Land;

/// Day 1 at 08:00, the start of a new game.
public const Start: int := 480;
/// Latest supported minute from the start of day 1.
public const Maximum: int := 1000000000;

/// The displayable conditions at one point in game time.
public type Conditions = record
  /// One-based day number.
  public Day: int;
  /// Minute since midnight.
  public MinuteOfDay: int;
  /// Whether the sun is down.
  public Night: bool;
  /// Clear, Rain or Sheltered.
  public Weather: string;
end record;

/// Returns whether Duration fits after Minutes without exceeding the supported clock.
public function CanAdvance(Minutes: int; Duration: int): bool;
begin
  return Minutes >= 0 and Duration >= 0 and Minutes <= Maximum - Duration;
end function;

/// Derives the conditions for Seed at Minutes, with shelter overriding outdoor weather.
public function At(Seed: int; Minutes: int; Sheltered: bool): Conditions;
requires Minutes >= 0 and Minutes <= 1000000000;
begin
  const DayIndex: int := Minutes div 1440;
  const Minute: int := Minutes mod 1440;
  const RainyWindow: long := Land.CoordinateHash(Seed, DayIndex, 0, 2203) mod 4L;
  const Weather: string := if Sheltered then 'Sheltered'
    else if Minute div 360 = RainyWindow then 'Rain' else 'Clear' end if
    end if;
  return new Conditions(DayIndex + 1, Minute, Minute < 360 or Minute >= 1200, Weather);
end function;
end unit;
