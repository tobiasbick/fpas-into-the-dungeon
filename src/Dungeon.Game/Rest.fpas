// Prices an inn stay and prepares its payment, recovery and clock advance together.
unit Dungeon.Game.Rest;

uses Dungeon.Game.Clock as Clock, Dungeon.Game.World as Game;

/// Cost of one stay, in spendable coins.
public const Price: int := 5;
/// Length of one stay, in game minutes.
public const Duration: int := 480;

/// Explains why World cannot rest, or returns an empty string when a stay is available.
public function Refusal(World: Game.State): string;
begin
  if World.Coins < Price then
    return 'You do not have enough coins.';
  end if;

  if not Clock.CanAdvance(World.Minutes, Duration) then
    return 'The world clock cannot advance that far.';
  end if;

  return '';
end function;

/// Returns the paid and healed world for a confirmed stay, or null when payment or time is unavailable.
public function Pay(World: Game.State): Game.State?;
begin
  if Refusal(World) <> '' then
    return null;
  end if;

  return World with
    Coins := World.Coins - Price;
    Minutes := World.Minutes + Duration;
    Health := Game.MaximumHealth;
  end with;
end function;
end unit;
