// Tracks independent fighting skills and derives their levels from experience.
unit Dungeon.Game.Skills;

uses System as Sys;

/// Cumulative experience in each fighting style.
public type Training = record
  /// Experience from unarmed attacks.
  public Unarmed: int;
  /// Experience from attacks with an equipped sword.
  public Blades: int;
end record;

/// The highest experience value in either skill.
public const Mastery: int := 120;

/// Returns whether both counters in Value can have been earned in play.
public function Valid(Value: Training): bool;
begin
  return Value.Unarmed >= 0 and Value.Unarmed <= Mastery and Value.Blades >= 0 and Value.Blades <=
    Mastery;
end function;

/// Derives the skill level from its cumulative Experience.
public function Level(Experience: int): int;
requires Experience >= 0 and Experience <= 120;
begin
  if Experience >= Mastery then
    return 5;
  end if;

  if Experience >= 72 then
    return 4;
  end if;

  if Experience >= 36 then
    return 3;
  end if;

  if Experience >= 12 then
    return 2;
  end if;

  return 1;
end function;

/// Returns the next cumulative experience threshold for Rank, or mastery at the cap.
public function NextThreshold(Rank: int): int;
requires Rank >= 1 and Rank <= 5;
begin
  return case Rank of
    when 1: 12;
    when 2: 36;
    when 3: 72;
    else Mastery;
  end case;
end function;

/// Derives the extra damage from the active skill's Rank.
public function DamageBonus(Rank: int): int;
requires Rank >= 1 and Rank <= 5;
begin
  return Rank div 2;
end function;

/// Selects experience from the style used when Armed is true or false.
public function Active(Value: Training; Armed: bool): int;
begin
  return if Armed then Value.Blades else Value.Unarmed end if;
end function;

/// Adds RemovedHealth to the active skill in Value, saturating at mastery.
public function Award(Value: Training; Armed: bool; RemovedHealth: int): Training;
requires RemovedHealth >= 0;
begin
  const Previous: int := Active(Value, Armed);
  const Next: int := Previous + Sys.Math.Min(RemovedHealth, Mastery - Previous);
  return if Armed then Value with
      Blades := Next;
    end with
    else Value with
      Unarmed := Next;
    end with
    end if;
end function;
end unit;
