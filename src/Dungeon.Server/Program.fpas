// Starts the authoritative game server on loopback.
program DungeonServer;

uses
  Dungeon.Server.Host as Host, System as Sys, System.Console as Console,
  System.IO as IO, System.Net as Net, System.Net.Sockets as Sockets, System.Threading as Threads;

procedure Main(Arguments: array of string);
begin
  var Port: int := 4040;
  if Arguments.Length > 3
    or (Arguments.Length > 1 and not int.TryParse(
    Arguments[1],
    out Port
  )) or Port < 1 or Port > 65535
  then
    Console.Error.WriteLine('Usage: Dungeon.Server [port] [save-file]');
    Sys.Environment.ExitCode := 2;
    return;
  end if;

  const Path: string := if Arguments.Length > 2 then Arguments[2]
    else IO.Path.Combine(
      '.dungeon',
      'save.json'
    )
    end if;
  using const Stop: Threads.CancellationTokenSource := new Threads.CancellationTokenSource();
  const Cancel: Sys.ConsoleCancelEventHandler := procedure(Sender: object?; Event: Sys.ConsoleCancelEventArgs) begin
    Event.Cancel := true;
    Stop.Cancel();
  end procedure;

  const Listener: Sockets.TcpListener := new Sockets.TcpListener(Net.IPAddress.Loopback, Port);
  subscribe Console.CancelKeyPress with Cancel;
  try
    Listener.Start();
    Console.WriteLine('Into the Dungeon server on ' + Port.ToString());
    Host.Run(Listener, Path, Stop.Token).GetAwaiter().GetResult();
  catch Failure: Sockets.SocketException do
    Console.Error.WriteLine(Failure.Message);
    Sys.Environment.ExitCode := 1;
  finally
    unsubscribe Console.CancelKeyPress with Cancel;
    Listener.Stop();
  end try;
end procedure;

begin
  Main(Sys.Environment.GetCommandLineArgs());
end;
end program;
