// Builds the wire inventory from the server's authoritative item ledger.
unit Dungeon.Server.Inventory;

uses
  Dungeon.Game.World as Game, Dungeon.Game.Items as Loot, Dungeon.Game.Inventory as Bag, Dungeon.Game.Skills as Skills,
  Dungeon.Protocol.Messages as Wire, System.Collections.Generic as Generic;

function Action(Value: Loot.Item): string;
begin
  case Value.Kind of
    when Loot.Kind.Potion:
      return 'Use';
    when Loot.Kind.Sword, Loot.Kind.Jerkin:
      return if Value.Location = Loot.Location.Worn then 'Remove' else 'Wear' end if;
    else
      return '';
  end case;
end function;

function Skill(Experience: int): Wire.Skill;
begin
  const Rank: int := Skills.Level(Experience);
  return new Wire.Skill(Rank, Experience, Skills.NextThreshold(Rank));
end function;

/// Returns the current inventory and character values, or null before a game starts.
public function Project(World: Game.State?): Wire.Inventory?;
begin
  if World = null then
    return null;
  end if;

  const Held: Generic.List<Wire.BagEntry> := new Generic.List<Wire.BagEntry>();
  for Value: Loot.Item in Loot.Inventory(World.Items) do
    Held.Add(
      new Wire.BagEntry(
        Value.Id,
        Loot.Name(Value.Kind),
        Loot.Description(Value.Kind),
        Action(Value),
        Value.Location = Loot.Location.Worn
      )
    );
  end for;

  return new Wire.Inventory(
    Held.ToArray(), Loot.Capacity, World.Health, Game.MaximumHealth,
    Game.Damage(World), Loot.Armor(World.Items), Bag.Hint(World), World.Coins,
    Skill(World.Training.Unarmed), Skill(World.Training.Blades), Game.Armed(World)
  );
end function;
end unit;
